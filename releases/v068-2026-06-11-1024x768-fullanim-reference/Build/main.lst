 131+ E4A2 3E 01       >                LD A, FT_INT_SWAP & 0xFF
 131+ E4A4 11 A8 20    >                LD DE, FT_REG_INT_FLAGS & 0xFFFF
 131+ E4A7 CD 1B 12    >                CALL FT.WriteReg8
