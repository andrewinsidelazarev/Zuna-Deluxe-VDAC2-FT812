2034  3288 C9                           RET
2035  3289              ; ----------------------------------------------------------------------------
2036  3289              ; FormatScore24ToBuf — DrawNumBuf = decimal of VDC_PlayerScore (up to 8 digits,
2037  3289              ; leading zeros blanked to spaces, which render at zero width). Clobbers all.
2038  3289              ; ----------------------------------------------------------------------------
2039  3289              FormatScore24ToBuf:
2040  3289 2A A1 69                     LD   HL, (Core.VDC_PlayerScore)
2041  328C 22 2A 33                     LD   (Score24Work), HL
2042  328F 3A A3 69                     LD   A, (Core.VDC_PlayerScore + 2)
2043  3292 32 2C 33                     LD   (Score24Work + 2), A
2044  3295 DD 21 12 33                  LD   IX, Score24Divs
2045  3299 21 CF 33                     LD   HL, DrawNumBuf
2046  329C 22 2D 33                     LD   (Score24OutPtr), HL
2047  329F 06 08                        LD   B, 8                              ; 8 digit slots
2048  32A1 0E 2F        .fs24_digit:    LD   C, '0' - 1
2049  32A3 0C           .fs24_sub:      INC  C
2050  32A4 3A 2A 33                     LD   A, (Score24Work)
2050  32A7 DD 96 00       SUB (IX+0)
2050  32AA 32 2A 33       LD (Score24Work), A
2051  32AD 3A 2B 33                     LD   A, (Score24Work + 1)
2051  32B0 DD 9E 01       SBC A, (IX+1)
2051  32B3 32 2B 33       LD (Score24Work + 1), A
2052  32B6 3A 2C 33                     LD   A, (Score24Work + 2)
2052  32B9 DD 9E 02       SBC A, (IX+2)
2052  32BC 32 2C 33       LD (Score24Work + 2), A
2053  32BF 30 E2                        JR   NC, .fs24_sub                     ; no borrow -> subtract again
2054  32C1 3A 2A 33                     LD   A, (Score24Work)
2054  32C4 DD 86 00       ADD A, (IX+0)
2054  32C7 32 2A 33       LD (Score24Work), A    ; add divisor back once
2055  32CA 3A 2B 33                     LD   A, (Score24Work + 1)
2055  32CD DD 8E 01       ADC A, (IX+1)
2055  32D0 32 2B 33       LD (Score24Work + 1), A
2056  32D3 3A 2C 33                     LD   A, (Score24Work + 2)
2056  32D6 DD 8E 02       ADC A, (IX+2)
2056  32D9 32 2C 33       LD (Score24Work + 2), A
2057  32DC 79                           LD   A, C
2058  32DD 2A 2D 33                     LD   HL, (Score24OutPtr)
2059  32E0 77                           LD   (HL), A
2060  32E1 23                           INC  HL
2061  32E2 22 2D 33                     LD   (Score24OutPtr), HL
2062  32E5 DD 23                        INC  IX
2062  32E7 DD 23          INC IX
2062  32E9 DD 23          INC IX
2063  32EB 10 B4                        DJNZ .fs24_digit
2064  32ED AF                           XOR  A
2065  32EE 2A 2D 33                     LD   HL, (Score24OutPtr)
2066  32F1 77                           LD   (HL), A                           ; null terminate
2067  32F2                              ; blank leading zeros (all but the last digit) -> space (zero width)
2068  32F2 21 CF 33                     LD   HL, DrawNumBuf
2069  32F5 06 07                        LD   B, 7
2070  32F7 7E           .fs24_strip:    LD   A, (HL)
2071  32F8 FE 30                        CP   '0'
2072  32FA C0                           RET  NZ
2073  32FB 36 20                        LD   (HL), ' '
2074  32FD 23                           INC  HL
2075  32FE 10 F7                        DJNZ .fs24_strip
2076  3300 C9                           RET
