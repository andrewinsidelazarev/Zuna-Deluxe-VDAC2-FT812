1233+ CCD8              .notEoc:       ; adjacent if NextClus == CurClus + 1
1234+ CCD8 21 C9 CE                     LD   HL, RawPak_CurClus
1235+ CCDB 11 CD CE                     LD   DE, RawPak_Tmp
1236+ CCDE CD 05 CE                     CALL RawPak_Copy32
1237+ CCE1 CD ED CD                     CALL RawPak_IncTmp32             ; Tmp = CurClus + 1
1238+ CCE4 21 CD CE                     LD   HL, RawPak_Tmp
1239+ CCE7 11 D5 D0                     LD   DE, RawPak_NextClus
1240+ CCEA CD FB CD                     CALL RawPak_Cmp32
1241+ CCED 20 21                        JR   NZ, .jump
1242+ CCEF                              ; --- sequential: CurClus = NextClus, extend the same run ---
1243+ CCEF 21 D5 D0                     LD   HL, RawPak_NextClus
1244+ CCF2 11 C9 CE                     LD   DE, RawPak_CurClus
1245+ CCF5 CD 05 CE                     CALL RawPak_Copy32
