1390+ CE05              ; (VDC_ReadSampleAtHL moved to loader_resident.asm — it runs per-frame during
1391+ CE05              ;  gameplay when this overlay page is NOT mapped, so it must stay resident.)
1392+ CE05
1393+ CE05              ; Copy 4 bytes: HL=src, DE=dst.
1394+ CE05              RawPak_Copy32:
1395+ CE05 C5                           PUSH BC
