1000+ C65D                              ; HSA < SlotsLen → не спавним (хвост не достиг старта)
1001+ C65D 3A 96 69                     LD   A, (VDC_SlotsLen)
1002+ C660 47                           LD   B, A                              ; B = SlotsLen
1003+ C661 3A 5C D3                     LD   A, (VDC_HSA)
1004+ C664 B8                           CP   B
1005+ C665 D8                           RET  C
1006+ C666
1007+ C666                              ; SlotsLen > 0 AND offsets[tail-1] != 0 → не спавним (хвост ещё двигается).
1008+ C666 78                           LD   A, B
1009+ C667 B7                           OR   A
1010+ C668 28 0C                        JR   Z, .spawn_no_tail_check
1011+ C66A 3D                           DEC  A
1012+ C66B 26 00                        LD   H, 0
1012+ C66D 6F             LD L, A
1013+ C66E ED 5B 3C D6                  LD   DE, (VDC_pOffsets)
1014+ C672 19                           ADD  HL, DE
1015+ C673 7E                           LD   A, (HL)
1016+ C674 B7                           OR   A
