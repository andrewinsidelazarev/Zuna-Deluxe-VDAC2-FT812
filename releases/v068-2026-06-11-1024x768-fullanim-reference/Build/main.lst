1290+ CD5B CD 05 CE                     CALL RawPak_Copy32
1291+ CD5E 06 07                        LD   B, 7
1292+ CD60 CD 1A CE     .shr:          CALL RawPak_ShrTmp1
1293+ CD63 10 FB                        DJNZ .shr
1294+ CD65 21 B9 CE                     LD   HL, RawPak_FatStart
1295+ CD68 11 CD CE                     LD   DE, RawPak_Tmp
1296+ CD6B CD 0D CE                     CALL RawPak_Add32               ; Tmp = (CurClus>>7) + FatStart = FAT sector LBA
1297+ CD6E 21 CD CE                     LD   HL, RawPak_Tmp
1298+ CD71 11 D1 D0                     LD   DE, RawPak_FatBufLba
1299+ CD74 CD FB CD                     CALL RawPak_Cmp32
1300+ CD77 28 14                        JR   Z, .have                    ; already buffered
1301+ CD79 2A CD CE                     LD   HL, (RawPak_Tmp)
1302+ CD7C ED 5B CF CE                  LD   DE, (RawPak_Tmp + 2)
1303+ CD80 CD 50 CC                     CALL RawPak_ReadFatSector
1304+ CD83 D8                           RET  C
1305+ CD84 21 CD CE                     LD   HL, RawPak_Tmp
1306+ CD87 11 D1 D0                     LD   DE, RawPak_FatBufLba
1307+ CD8A CD 05 CE                     CALL RawPak_Copy32
1308+ CD8D 3A C9 CE     .have:         LD   A, (RawPak_CurClus)          ; entry offset = (CurClus & 127) * 4
1309+ CD90 E6 7F                        AND  127
1310+ CD92 6F                           LD   L, A
1311+ CD93 26 00                        LD   H, 0
1312+ CD95 29                           ADD  HL, HL
1313+ CD96 29                           ADD  HL, HL
1314+ CD97 11 D1 CE                     LD   DE, RawPak_FatBuf
