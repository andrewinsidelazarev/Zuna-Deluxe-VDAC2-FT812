 198+ D153
 199+ D153              ; ----------------------------------------------------------------------------
 200+ D153              ; Клавиатурное управление выбором уровня (схема юзера):
 201+ D153              ;   Вверх/Вниз  — сложность ПО ЭКРАНУ. Бейджи идут сверху вниз Sun God(3) / Jaguar(2)
 202+ D153              ;                 / Eagle(1) / Rabbit(0) (Y = 30 / 83 / 131 / 180), поэтому Вверх =
 203+ D153              ;                 к верхнему бейджу (CurrentDifficulty++, clamp 3 = Sun God), Вниз =
 204+ D153              ;                 к нижнему (CurrentDifficulty--, clamp 0 = Rabbit). Иначе стрелки
 205+ D153              ;                 двигали подсветку в противоположную сторону экрана.
 206+ D153              ;   Влево/Вправо — уровень (как кнопки Back/Next: ставит Click-флаги, дальше их
 207+ D153              ;                  обработает LevelSelectApplyLevelClick — там же guard L1 и wrap);
 208+ D153              ;   Огонь — Play;  ESC — выход в главное меню.
 209+ D153              ; Зовётся в LevelSelectUpdateControls ПОСЛЕ сброса Click-флагов и hit-test'ов мыши,
 210+ D153              ; но ДО Apply*-рутин — поэтому выставленные тут флаги и CurrentDifficulty доедут.
 211+ D153              ; ----------------------------------------------------------------------------
 212+ D153              LevelSelectKeyboard:
 213+ D153                              ; Вверх — к верхнему бейджу (Sun God): CurrentDifficulty++, clamp 3
 214+ D153 CD 46 7C                     CALL Input_Up
 215+ D156 21 59 DA                     LD   HL, LevelSelectKbdUpPrev
 216+ D159 CD 9D 7C                     CALL Input_EdgeZ
 217+ D15C 28 0B                        JR   Z, .chk_down
 218+ D15E 3A 8D 69                     LD   A, (CurrentDifficulty)
 219+ D161 FE 03                        CP   3
 220+ D163 30 04                        JR   NC, .chk_down                         ; уже Sun God (3, верх)
 221+ D165 3C                           INC  A
 222+ D166 32 8D 69                     LD   (CurrentDifficulty), A
 223+ D169              .chk_down:      ; Вниз — к нижнему бейджу (Rabbit): CurrentDifficulty--, clamp 0
 224+ D169 CD 55 7C                     CALL Input_Down
 225+ D16C 21 5A DA                     LD   HL, LevelSelectKbdDownPrev
 226+ D16F CD 9D 7C                     CALL Input_EdgeZ
 227+ D172 28 0A                        JR   Z, .chk_left
 228+ D174 3A 8D 69                     LD   A, (CurrentDifficulty)
 229+ D177 B7                           OR   A
 230+ D178 28 04                        JR   Z, .chk_left                          ; уже Rabbit (0, низ)
 231+ D17A 3D                           DEC  A
 232+ D17B 32 8D 69                     LD   (CurrentDifficulty), A
 233+ D17E              .chk_left:      ; Влево — предыдущий уровень (как Back)
 234+ D17E CD 64 7C                     CALL Input_Left
 235+ D181 21 5B DA                     LD   HL, LevelSelectKbdLeftPrev
 236+ D184 CD 9D 7C                     CALL Input_EdgeZ
 237+ D187 28 05                        JR   Z, .chk_right
 238+ D189 3E 01                        LD   A, 1
 239+ D18B 32 4B DA                     LD   (LevelSelectBackClick), A
 240+ D18E              .chk_right:     ; Вправо — следующий уровень (как Next)
 241+ D18E CD 73 7C                     CALL Input_Right
 242+ D191 21 5C DA                     LD   HL, LevelSelectKbdRightPrev
 243+ D194 CD 9D 7C                     CALL Input_EdgeZ
 244+ D197 28 05                        JR   Z, .chk_fire
 245+ D199 3E 01                        LD   A, 1
 246+ D19B 32 4C DA                     LD   (LevelSelectNextClick), A
 247+ D19E              .chk_fire:      ; Огонь — Play
 248+ D19E CD 82 7C                     CALL Input_FireKey
 249+ D1A1 21 5D DA                     LD   HL, LevelSelectKbdFirePrev
 250+ D1A4 CD 9D 7C                     CALL Input_EdgeZ
 251+ D1A7 28 05                        JR   Z, .chk_esc
 252+ D1A9 3E 01                        LD   A, 1
 253+ D1AB 32 4A DA                     LD   (LevelSelectPlayClick), A
 254+ D1AE              .chk_esc:       ; ESC — выход в главное меню
 255+ D1AE CD 41 7C                     CALL Input_Esc
