4495  EE23                              SAVEBIN "Build/ui_ovl.bin",      Core.UiOvl_Start, UiOvl_Size
4496  EE23                              SLOT 3
4496  EE23                PAGE Core.LOADER_OVL_PAGE
4497  EE23                              SAVEBIN "Build/loader_ovl.bin",  Core.LoaderOvl_Start, LoaderOvl_Size
