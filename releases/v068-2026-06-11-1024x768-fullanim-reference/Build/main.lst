3510  6032
3511  6032              ; ============================================================================
3512  6032              ; WIN-аутро (точно по оригиналу Zuma, Game_UpdateOutro/FX.c): эмиттер бежит по
3513  6032              ; треку ОТ головного шара (ближайшего к килл-зоне) ДО конца трека (килл-зоны),
3514  6032              ; скорость WINEXP_MOVE сэмплов/кадр; каждые WINEXP_PAD сэмплов роняет НЕЗАВИСИМУЮ
3515  6032              ; частицу-взрыв (играет кадры 0..16, frame += 0.5/кадр) + 100 очков. Чем дальше
3516  6032              ; голова была от КЗ — тем длиннее путь — тем больше +100 (бонус за дистанцию).
3517  6032              ; ============================================================================
3518  6032              VDC_UpdateWin:
3519  6032 3A BA 69                     LD   A, (VDC_WinOutroActive)
3520  6035 B7                           OR   A
3521  6036 28 0A                        JR   Z, .legacy                          ; нет аутро → fallback-таймер
3522  6038 CD 6D 61                     CALL VDC_WinOutroUpdate                   ; двигать эмиттеры + стареть частицы
3523  603B CD CF 61                     CALL VDC_WinOutroDone
3524  603E B7                           OR   A
3525  603F C8                           RET  Z                                    ; аутро ещё играет → ждём (таймер не нужен)
3526  6040 18 15                        JR   .win_show_done                       ; дорожка доиграла → диалог
3527  6042 3A 69 D3     .legacy:        LD   A, (VDC_PreviewTick)
3528  6045 B7                           OR   A
3529  6046 28 04                        JR   Z, .pv_done
3530  6048 3D                           DEC  A
3531  6049 32 69 D3                     LD   (VDC_PreviewTick), A
3532  604C 3A 6B D3     .pv_done:       LD   A, (VDC_WinTick)
3533  604F B7                           OR   A
3534  6050 28 05                        JR   Z, .win_show_done
3535  6052 3D                           DEC  A
3536  6053 32 6B D3                     LD   (VDC_WinTick), A
3537  6056 C9                           RET
3538  6057              .win_show_done: ; win-анимация закончилась → показать диалог LEVEL DONE (один раз).
3539  6057 3A 9A 69                     LD   A, (VDC_DialogState)
3540  605A FE 05                        CP   DLG_WIN_DONE
3541  605C D0                           RET  NC                                  ; уже win-done/fade → не пере-триггерить
3542  605D 3E 05                        LD   A, DLG_WIN_DONE
3543  605F 32 9A 69                     LD   (VDC_DialogState), A
3544  6062 AF                           XOR  A
3545  6063 32 8C 69                     LD   (FadeAlpha), A
3546  6066 C9                           RET
3547  6067
3548  6067              ; --- VDC_WinOutroInit — на входе в WIN: эмиттеры из head-сэмплов, пул пуст. ---
3549  6067              VDC_WinOutroInit:
3550  6067                              ; Дозалить атлас WIN-взрыва в регион шаров (#050000) — шаров на
3551  6067                              ; экране уже нет (SlotsLen==0, проверено в VDC_CheckWinMaybe), так
3552  6067                              ; что регион свободен. UnpackAndUploadPage резидентна (slot0),
3553  6067                              ; использует slot3 как scratch и восстанавливает его в
3554  6067                              ; CurrentCodePage (#04) — безопасно из gameplay-контекста.
3555  6067 21 00 00                     LD   HL, WINEXP_RAMG_ADDR & #FFFF
3556  606A 22 7D 65                     LD   (BgRamL), HL
3557  606D 3E 05                        LD   A, (WINEXP_RAMG_ADDR >> 16) & #FF
3558  606F 32 7F 65                     LD   (BgRamH), A
3559  6072 3E 28                        LD   A, WINEXP_PAGE
3560  6074 32 7C 65                     LD   (BgPg), A
3561  6077 06 05                        LD   B, WINEXP_PAGE_COUNT
3562  6079 C5           .winexp_up:     PUSH BC
3563  607A 3A 7C 65                     LD   A, (BgPg)
3564  607D CD 21 3C                     CALL UnpackAndUploadPage
3565  6080 C1                           POP  BC
3566  6081 3A 7C 65                     LD   A, (BgPg)
3567  6084 3C                           INC  A
3568  6085 32 7C 65                     LD   (BgPg), A
3569  6088 10 EF                        DJNZ .winexp_up
3570  608A
3571  608A AF                           XOR  A
3572  608B 32 BA 69                     LD   (VDC_WinOutroActive), A
3573  608E                              ; пул частиц → все мёртвые (f2=255 на смещении +4)
3574  608E DD 21 C3 69                  LD   IX, VDC_WinPrtcl
3575  6092 06 20                        LD   B, WIN_PRTCL_MAX
3576  6094 DD 36 04 FF  .oi_clr:        LD   (IX+4), 255
3577  6098 11 05 00                     LD   DE, 5
3577  609B DD 19          ADD IX, DE
3578  609D 10 F5                        DJNZ .oi_clr
3579  609F                              ; chain1 эмиттер из VDC_WinHeadS1
3580  609F 2A B3 69                     LD   HL, (VDC_WinHeadS1)
3581  60A2 7C                           LD   A, H
3581  60A3 A5             AND L
3581  60A4 3C             INC A                ; #FFFF?
3582  60A5 28 13                        JR   Z, .oi_no1
3583  60A7 22 BB 69                     LD   (VDC_WinEmitPos1), HL
3584  60AA 11 1E 00                     LD   DE, WINEXP_PAD
3585  60AD A7                           AND  A
3585  60AE ED 52          SBC HL, DE                      ; spawn = head - PAD (первый спавн сразу)
3586  60B0 22 BD 69                     LD   (VDC_WinEmitSpawn1), HL
3587  60B3 3E 01                        LD   A, 1
3587  60B5 32 BA 69       LD (VDC_WinOutroActive), A
3588  60B8 18 06                        JR   .oi_c2
3589  60BA 21 FF FF     .oi_no1:        LD   HL, #FFFF
3589  60BD 22 BB 69       LD (VDC_WinEmitPos1), HL
3590  60C0 3A 94 D3     .oi_c2:         LD   A, (VDC_HasSecondChain)
3591  60C3 B7                           OR   A
3592  60C4 28 1A                        JR   Z, .oi_no2set
3593  60C6 2A B5 69                     LD   HL, (VDC_WinHeadS2)
3594  60C9 7C                           LD   A, H
3594  60CA A5             AND L
3594  60CB 3C             INC A
3595  60CC 28 12                        JR   Z, .oi_no2
3596  60CE 22 BF 69                     LD   (VDC_WinEmitPos2), HL
3597  60D1 11 1E 00                     LD   DE, WINEXP_PAD
3598  60D4 A7                           AND  A
3598  60D5 ED 52          SBC HL, DE
3599  60D7 22 C1 69                     LD   (VDC_WinEmitSpawn2), HL
3600  60DA 3E 01                        LD   A, 1
3600  60DC 32 BA 69       LD (VDC_WinOutroActive), A
3601  60DF C9                           RET
3602  60E0              .oi_no2:
3603  60E0 21 FF FF     .oi_no2set:     LD   HL, #FFFF
3603  60E3 22 BF 69       LD (VDC_WinEmitPos2), HL
3604  60E6 C9                           RET
3605  60E7
3606  60E7              ; --- VDC_WinSpawnParticle — BC=X, DE=Y: занять мёртвый слот (f2=0). Пул полон → скип. ---
3607  60E7              VDC_WinSpawnParticle:
3608  60E7 ED 43 00 62                  LD   (VDC_WinSpawnX), BC
3609  60EB ED 53 02 62                  LD   (VDC_WinSpawnY), DE
3610  60EF DD 21 C3 69                  LD   IX, VDC_WinPrtcl
3611  60F3 06 20                        LD   B, WIN_PRTCL_MAX
3612  60F5 DD 7E 04     .sp_find:       LD   A, (IX+4)
3613  60F8 FE FF                        CP   255
3614  60FA 28 08                        JR   Z, .sp_use
3615  60FC 11 05 00                     LD   DE, 5
3615  60FF DD 19          ADD IX, DE
3616  6101 10 F2                        DJNZ .sp_find
3617  6103 C9                           RET                                      ; пул полон
3618  6104 2A 00 62     .sp_use:        LD   HL, (VDC_WinSpawnX)
3619  6107 DD 75 00                     LD   (IX+0), L
