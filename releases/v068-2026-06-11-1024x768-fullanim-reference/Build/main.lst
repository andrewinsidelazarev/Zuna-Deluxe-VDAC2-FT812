 161++C3C6 16 0A                        ld      d,10
 162++C3C8 ED 78        .r              in      a,(c)
 162++C3CA CB 7F          bit 7,a
 162++C3CC 28 03          jr z,.done
 163++C3CE 15                           dec     d
 163++C3CF 20 F7          jr nz,.r
 164++C3D1 C1           .done           pop     bc
 164++C3D2 D1             pop de
 165++C3D3 C9                           ret
 166++C3D4
 167++C3D4              ;--- sd_lba_in_range: проверка sd_lba против верхней границы тома sd_lba_max.
 168++C3D4              ;    out: CF=1 — отвергнуть (sd_lba >= sd_lba_max); CF=0 — ок ИЛИ защита выключена.
 169++C3D4              ;    sd_lba_max==0 => защита выключена (до парса BPB, для bootstrap-чтений).
 170++C3D4              ;    Сохраняет HL/DE/BC; клобает A/флаги (результат — в CF).
 171++C3D4              sd_lba_in_range:
 172++C3D4 E5                           push    hl
 172++C3D5 D5             push de
 172++C3D6 C5             push bc
 173++C3D7 3A 0B C4                     ld      a,(sd_lba_max+0)        ; sd_lba_max == 0 ?
 174++C3DA 47                           ld      b,a
 175++C3DB 3A 0C C4                     ld      a,(sd_lba_max+1)
 175++C3DE B0             or b
 175++C3DF 47             ld b,a
 176++C3E0 3A 0D C4                     ld      a,(sd_lba_max+2)
 176++C3E3 B0             or b
 176++C3E4 47             ld b,a
 177++C3E5 3A 0E C4                     ld      a,(sd_lba_max+3)
 177++C3E8 B0             or b
 178++C3E9 28 16                        jr      z,.disabled             ; все нули -> защита выключена
 179++C3EB 21 06 C4                     ld      hl,sd_lba
 180++C3EE 11 0B C4                     ld      de,sd_lba_max
 181++C3F1 B7                           or      a                       ; CF=0 перед многобайтовым вычитанием
 182++C3F2 06 04                        ld      b,4
 183++C3F4 1A           .cmp            ld      a,(de)                  ; sd_lba - sd_lba_max побайтно (LE)
 184++C3F5 4F                           ld      c,a
 185++C3F6 7E                           ld      a,(hl)
 186++C3F7 99                           sbc     a,c
 187++C3F8 23                           inc     hl
 188++C3F9 13                           inc     de
 189++C3FA 10 F8                        djnz    .cmp                    ; INC/DJNZ не трогают CF -> заём проходит насквозь
 190++C3FC 3F                           ccf                             ; заём(CF=1, sd_lba<max)->0 ок ; CF=0(>=max)->1 отвергнуть
 191++C3FD C1                           pop     bc
 191++C3FE D1             pop de
 191++C3FF E1             pop hl
 192++C400 C9                           ret
 193++C401 C1           .disabled       pop     bc
 193++C402 D1             pop de
 193++C403 E1             pop hl
 194++C404 B7                           or      a                       ; CF=0 (в диапазоне)
 195++C405 C9                           ret
