2171  3399 03                           INC  BC
2172  339A 18 F8                        JR   .dt_div2
2173  339C              .dt_minutes_done:
2174  339C 19                           ADD  HL, DE                             ; восстановить HL = remainder = seconds (0..59)
2175  339D                              ; BC = minutes, HL_low = seconds. Format "M:SS"
2176  339D 79                           LD   A, C
2177  339E C6 30                        ADD  A, '0'                             ; minute digit (0..9)
2178  33A0 32 CF 33                     LD   (DrawNumBuf), A
2179  33A3 3E 3A                        LD   A, ':'                             ; cancun8 имеет colon
2180  33A5 32 D0 33                     LD   (DrawNumBuf+1), A
2181  33A8 7D                           LD   A, L                               ; seconds 0..59
2182  33A9 06 2F                        LD   B, '0' - 1
2183  33AB 04           .dt_s10:        INC  B
2184  33AC D6 0A                        SUB  10
2185  33AE 30 FB                        JR   NC, .dt_s10
2186  33B0 C6 0A                        ADD  A, 10
2187  33B2 4F                           LD   C, A                                ; save units
2188  33B3 78                           LD   A, B
2189  33B4 32 D1 33                     LD   (DrawNumBuf+2), A                   ; tens digit
2190  33B7 79                           LD   A, C
2191  33B8 C6 30                        ADD  A, '0'
2192  33BA 32 D2 33                     LD   (DrawNumBuf+3), A                   ; units digit
2193  33BD AF                           XOR  A
2194  33BE 32 D3 33                     LD   (DrawNumBuf+4), A                   ; null terminator
2195  33C1 21 CF 33                     LD   HL, DrawNumBuf
