 261+ E4D0              ; DrawDebugClock — HH:MM:SS в левом нижнем углу над bottom frame.
 262+ E4D0              ; Bottom frame занимает Y=456..479 (24 px). Clock на Y=438 (18 px выше).
 263+ E4D0              ; X=28 — сразу за left frame (24 px) + 4 px отступ.
 264+ E4D0              ; Font 26 = FT812 ROM 8×16, "HH:MM:SS" ≈ 64 px wide.
 265+ E4D0              ; ============================================================================
 266+ E4D0              DrawDebugClock:
 267+ E4D0                              ; Tint white
 268+ E4D0 0E FF                        LD   C, 255
 268+ E4D2 16 FF          LD D, 255
 268+ E4D4 1E FF          LD E, 255
 269+ E4D6 CD 6E 13                     CALL FT.Coprocessor.ColorRGB
 270+ E4D9                              ; Компактно (1024-порт): форматируем "HH:MM:SS" в буфер и рисуем
 271+ E4D9                              ; ОДНИМ CMD_TEXT (глифы ×1.6 масштабирует матрица, оставшаяся от
 272+ E4D9                              ; курсора). Было 3×CMD_NUMBER + 2×CMD_TEXT инлайнами = 465 байт.
 273+ E4D9 21 60 E5                     LD   HL, ZL_ClockBuf
 274+ E4DC 3E 04                        LD   A, 4                             ; RTC 4 = часы (binary)
 275+ E4DE CD 38 C3                     CALL ReadRTCRegister
 276+ E4E1 CD 4E E5                     CALL .two
 277+ E4E4 36 3A                        LD   (HL), ':'
 277+ E4E6 23             INC HL
 278+ E4E7 3E 02                        LD   A, 2                             ; RTC 2 = минуты
 279+ E4E9 CD 38 C3                     CALL ReadRTCRegister
 280+ E4EC CD 4E E5                     CALL .two
 281+ E4EF 36 3A                        LD   (HL), ':'
 281+ E4F1 23             INC HL
 282+ E4F2 AF                           XOR  A                                ; RTC 0 = секунды
