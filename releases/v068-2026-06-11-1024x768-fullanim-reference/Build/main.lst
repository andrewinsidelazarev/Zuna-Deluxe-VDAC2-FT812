1087+ CBA8 D2 2F CC                     JP   NC, .pbDone                ; SD/BPB ошибка → Boot_Found=0
1088+ CBAB 21 C6 C4                     LD   HL, RAWPAK_NAME_BOOT       ; цель = "BOOT.$C"
1089+ CBAE 11 2F CE                     LD   DE, RawPak_TargetName
1090+ CBB1 7E           .pbCpy:         LD   A, (HL)
