1749+ F55E CB 3F          SRL A
1749+ F560 CB 3F          SRL A                  ; A = bucket (0..31)
1750+ F562 5F                           LD   E, A
1750+ F563 16 00          LD D, 0
1751+ F565 21 00 00                     LD   HL, 0
1752+ F568 19                           ADD  HL, DE
1753+ F569 29                           ADD  HL, HL
1753+ F56A 29             ADD HL, HL
1753+ F56B 29             ADD HL, HL   ; ×8
1754+ F56C 44                           LD   B, H
1754+ F56D 4D             LD C, L
1755+ F56E 29                           ADD  HL, HL                             ; ×16
1756+ F56F 09                           ADD  HL, BC                             ; ×24
1757+ F570 11 5A F2                     LD   DE, ZL_ChainMatrixLUT
1758+ F573 19                           ADD  HL, DE
1759+ F574 ED 5B 35 14                  LD   DE, (FT.Coprocessor.BufferPtr)
1760+ F578 01 18 00                     LD   BC, ZL_CHAIN_MATRIX_LUT_STRIDE
1761+ F57B ED B0                        LDIR
1762+ F57D ED 53 35 14                  LD   (FT.Coprocessor.BufferPtr), DE
