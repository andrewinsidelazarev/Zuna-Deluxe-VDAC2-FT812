 827  2278              ; ============================================================================
 828  2278              ; UpdateDialog — диалог game-over обработка click anywhere → restart.
 829  2278              ; Вызывается каждый кадр ДО Frog_Update (чтобы dialog click не триггерил bullet).
 830  2278              ; ============================================================================
 831  2278              UpdateDialog:
 832  2278 3A 9A 69                     LD   A, (Core.VDC_DialogState)
 833  227B B7                           OR   A
 834  227C C8                           RET  Z                                  ; диалог не показан
 835  227D 3E 01                        LD   A, 1
 836  227F 32 9D 69                     LD   (Core.VDC_HudPointerBlock), A      ; dialog consumes LMB for this frame
 837  2282 3A 9A 69                     LD   A, (Core.VDC_DialogState)
 838  2285 FE 03                        CP   3
 839  2287 CA EF 65                     JP   Z, Core.UpdatePauseDialog
 840  228A FE 04                        CP   4
 841  228C CA 90 66                     JP   Z, Core.UpdatePauseFade            ; pause window fade-out -> PLAY
 842  228F FE 06                        CP   Core.DLG_WIN_FADE
 843  2291 CA 05 23                     JP   Z, .udlg_win_fade                  ; LEVEL DONE → OK нажат → fade-out
 844  2294
 845  2294                              ; --- Клавиша огня (Space|Enter|Kempston) — минуя hit-test. ЛКМ ниже. ---
 846  2294 CD 82 7C                     CALL Core.Input_FireKey
 847  2297 20 06                        JR   NZ, .udlg_fire_check_edge         ; нажата
 848  2299                              ; Огонь отпущен — сброс debounce
 849  2299 AF                           XOR  A
 850  229A 32 1D 23                     LD   (DialogFirePrev), A
 851  229D 18 0E                        JR   .udlg_check_lmb
 852  229F              .udlg_fire_check_edge:
 853  229F 3A 1D 23                     LD   A, (DialogFirePrev)
 854  22A2 B7                           OR   A
 855  22A3 20 08                        JR   NZ, .udlg_check_lmb               ; уже было pressed → no edge
 856  22A5 3E 01                        LD   A, 1
 857  22A7 32 1D 23                     LD   (DialogFirePrev), A
 858  22AA C3 EC 22                     JP   .udlg_action                       ; rising edge → trigger
 859  22AD
 860  22AD              .udlg_check_lmb:
 861  22AD                              ; --- Read mouse LMB state, detect falling edge (release = click) ---
 862  22AD CD 95 7C                     CALL Core.Input_MouseLMB                ; Z=released, NZ=pressed
 863  22B0 3E 00                        LD   A, 0
 864  22B2 28 01                        JR   Z, .udlg_lmb_set
 865  22B4 3C                           INC  A
 866  22B5 4F           .udlg_lmb_set:  LD   C, A                               ; C = current LMB (0/1)
 867  22B6 3A 9B 69                     LD   A, (Core.VDC_PrevMouseL)
 868  22B9 47                           LD   B, A                               ; B = previous LMB
 869  22BA 79                           LD   A, C
 870  22BB 32 9B 69                     LD   (Core.VDC_PrevMouseL), A           ; save for next frame
 871  22BE                              ; Falling edge: was pressed (B=1) AND now released (C=0) → CLICK
 872  22BE 78                           LD   A, B
 873  22BF B7                           OR   A
 874  22C0 C8                           RET  Z                                  ; не было pressed → нет клика
 875  22C1 79                           LD   A, C
 876  22C2 B7                           OR   A
 877  22C3 C0                           RET  NZ                                 ; ещё pressed → нет клика
 878  22C4                              ; --- Hit-test: курсор должен быть в bounds OK button ---
 879  22C4 2A 49 16                     LD   HL, (Input.Mouse.PositionX)
 880  22C7 11 10 01                     LD   DE, DLG_OK_X
 881  22CA A7                           AND  A
 882  22CB ED 52                        SBC  HL, DE
 883  22CD D8                           RET  C
 884  22CE 2A 49 16                     LD   HL, (Input.Mouse.PositionX)
 885  22D1 11 F0 02                     LD   DE, DLG_OK_X + DIALOG_OK_DRAW_W
 886  22D4 A7                           AND  A
 887  22D5 ED 52                        SBC  HL, DE
 888  22D7 D0                           RET  NC
 889  22D8 2A 4B 16                     LD   HL, (Input.Mouse.PositionY)
 890  22DB 11 F8 01                     LD   DE, DLG_OK_Y
 891  22DE A7                           AND  A
 892  22DF ED 52                        SBC  HL, DE
 893  22E1 D8                           RET  C
 894  22E2 2A 4B 16                     LD   HL, (Input.Mouse.PositionY)
 895  22E5 11 2E 02                     LD   DE, DLG_OK_Y + DIALOG_OK_DRAW_H
 896  22E8 A7                           AND  A
 897  22E9 ED 52                        SBC  HL, DE
 898  22EB D0                           RET  NC
 899  22EC
 900  22EC              .udlg_action:   ; Mouse click in OK bounds OR Fire key pressed
 901  22EC 3A 9A 69                     LD   A, (Core.VDC_DialogState)
 902  22EF FE 05                        CP   Core.DLG_WIN_DONE
 903  22F1 28 09                        JR   Z, .udlg_winnext                   ; LEVEL DONE → OK → начать fade
 904  22F3 FE 03                        CP   3
 905  22F5 20 0B                        JR   NZ, .udlg_restart
 906  22F7 AF                           XOR  A
 907  22F8 32 9A 69                     LD   (Core.VDC_DialogState), A          ; PAUSE → resume
 908  22FB C9                           RET
 909  22FC 3E 06        .udlg_winnext:  LD   A, Core.DLG_WIN_FADE               ; OK на LEVEL DONE → fade-out фаза
 910  22FE 32 9A 69                     LD   (Core.VDC_DialogState), A
 911  2301 C9                           RET
 912  2302              .udlg_restart:
 913  2302 C3 1F 23                     JP   RestartLevel
 914  2305
 915  2305              ; --- LEVEL DONE fade-out: рампим FadeAlpha до чёрного, потом грузим след. уровень.
 916  2305              ; Сцена (поле + диалог) + DrawFadeOverlay рисуются в ZL_DrawFrame каждый кадр.
 917  2305 3A 8C 69     .udlg_win_fade: LD   A, (FadeAlpha)
 918  2308 FE FF                        CP   255
 919  230A 28 0A                        JR   Z, .uwf_done                       ; полностью чёрный → advance
 920  230C C6 10                        ADD  A, Core.VDC_WIN_FADE_STEP
 921  230E 30 02                        JR   NC, .uwf_store
 922  2310 3E FF                        LD   A, 255                             ; clamp до full black
 923  2312 32 8C 69     .uwf_store:     LD   (FadeAlpha), A
 924  2315 C9                           RET
 925  2316 AF           .uwf_done:      XOR  A
 926  2317 32 9A 69                     LD   (Core.VDC_DialogState), A
 927  231A C3 04 62                     JP   Core.LoadNextLevelWithLoading      ; black screen → LOADING LEVEL N-M... → load assets
 928  231D
 929  231D 00           DialogFirePrev: DEFB 0                                  ; SPACE/Fire debounce для dialog OK
 930  231E 00           DialogFrameLoaded: DEFB 0                               ; 1 если DIALOG_FRAME_RAMG сейчас содержит окно диалога
 931  231F
 932  231F              RestartLevel:
 933  231F AF                           XOR  A
 934  2320 32 9A 69                     LD   (Core.VDC_DialogState), A          ; скрыть диалог
 935  2323                              ; Если lives=0 → reset до 3 (full restart)
 936  2323 3A 99 69                     LD   A, (Core.VDC_Lives)
 937  2326 B7                           OR   A
 938  2327 20 08                        JR   NZ, .rl_keep_lives
 939  2329 3E 03                        LD   A, 3
 940  232B 32 99 69                     LD   (Core.VDC_Lives), A
 941  232E CD 74 32                     CALL Score_Reset                        ; full restart (жизни кончились) → счёт=0, NextLifeScore=50000
 942  2331              .rl_keep_lives:
 943  2331 CD 2E 5F                     CALL Core.SetCurrentTrackPage           ; dialog lazy upload leaves slot 2 on DIALOG_FRAME pages
 944  2334 CD 6E C0                     CALL Core.VDC_Init                      ; chain reset, state=INTRO
