 545+ C7B0 18 DB                        JR   .nextComp
 546+ C7B2 21 C9 CE     .findPakHere:   LD   HL, RawPak_CurClus                  ; CurClus = папка /Games/Zuma Deluxe VDAC2/
 547+ C7B5 11 72 D5                     LD   DE, RawPak_ZumaDirClus              ; запомнить её — там же лежат aud/snd паки
 548+ C7B8 CD 05 CE                     CALL RawPak_Copy32
