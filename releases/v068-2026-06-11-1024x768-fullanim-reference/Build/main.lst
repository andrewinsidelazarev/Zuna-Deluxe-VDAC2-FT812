  46+ C0F0                              ; --- 3. Сброс co-processor буфера ------------------------
  47+ C0F0                              ; FT_CMD_RESET = REG_CPURESET=1, DELAY 5, REG_CMD_READ/WRITE=0,
  48+ C0F0                              ; REG_CPURESET=0. Гарантирует что после старта co-processor
  49+ C0F0                              ; не имеет «висящих» команд из предыдущих сессий.
  50+ C0F0                              FT_CMD_RESET
  50+ C0F0             >                FT_WR_REG8  FT_REG_CPURESET,  1
  50+ C0F0 3E 01       >                LD A, 1 & 0xFF
  50+ C0F2 11 20 20    >                LD DE, FT_REG_CPURESET & 0xFFFF
  50+ C0F5 CD 1B 12    >                CALL FT.WriteReg8
  50+ C0F8             >                FT_DELAY 5
  50+ C0F8 06 05       >                LD B, 5
  50+ C0FA 76          >                HALT
  50+ C0FB 10 FD       >                DJNZ $-1
  50+ C0FD             >                FT_WR_REG32 FT_REG_CMD_READ,  0
  50+ C0FD 11 F8 20    >                LD DE, FT_REG_CMD_READ & 0xFFFF
  50+ C100 21 00 00    >                LD HL, (0 >> 16) & 0xFFFF
  50+ C103 01 00 00    >                LD BC, 0 & 0xFFFF
