  94+ C163              ; ----------------------------------------------------------------------------
  95+ C163              ; Минимальный пустой Display List — три 32-битные команды, всего 12 байт.
  96+ C163              ; Хранится в коде, заливается один раз при init для гарантии чистого экрана
  97+ C163              ; до первого живого DL из MainLoop'а.
  98+ C163              ; ----------------------------------------------------------------------------
  99+ C163              .EmptyDL:       FT_CLEAR_COLOR_RGB 0, 0, 0            ; opcode 0x02 — фон чёрный
  99+ C163 00 00 00 02 >                            DEFD (2 << 24) | (((0) & 255) << 16) | (((0) & 255) << 8) | (((0) & 255) << 0)
 100+ C167                              FT_CLEAR 1, 1, 1                       ; opcode 0x26 — color+stencil+tag
 100+ C167 07 00 00 26 >                            DEFD (38 << 24) | (((1) & 1) <<2 ) | (((1) & 1) << 1) | (((1) & 1) << 0)
 101+ C16B                              FT_DISPLAY                             ; opcode 0x00 — конец DL
 101+ C16B 00 00 00 00 >                            DEFD (0 << 24)
 102+ C16F              .EmptyDL_End:
 103+ C16F              .EmptyDL_Size   EQU .EmptyDL_End - .EmptyDL
