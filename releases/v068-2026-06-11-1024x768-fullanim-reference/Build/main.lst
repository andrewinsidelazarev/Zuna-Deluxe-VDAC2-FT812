 161+ 69B7 00 00        VDC_WinTmpMax:     DEFW 0               ; scratch: макс. сэмпл за проход цепочки
 162+ 69B9 00           VDC_WinTmpFound:   DEFB 0               ; scratch: найден ли видимый шар
