 521+ C6D6
 522+ C6D6              MenuDrawSun:
 523+ C6D6                              ; Солнце и свечение — отдельные спрайты поверх фона. Анимация по фазе
 524+ C6D6                              ; MenuSunPhase: солнце плавно «дышит» масштабом (cmd_scale), свечение —
 525+ C6D6                              ; пульс alpha. Значения считаем В ПАМЯТЬ заранее (макросы FT_Bitmap*
 526+ C6D6                              ; клобают BCDE).
 527+ C6D6                              ; alpha свечения = 150 + sin(GlowPhase)>>2 → 119..181 (своя фаза/скорость)
 528+ C6D6 3A DD CD                     LD   A, (MenuGlowPhase)
 529+ C6D9 06 02                        LD   B, 2
 530+ C6DB CD 69 C8                     CALL MenuSinShiftHL
 531+ C6DE 7D                           LD   A, L
 532+ C6DF C6 96                        ADD  A, 150
 533+ C6E1 32 E2 CD                     LD   (MenuGlowAlpha), A
 534+ C6E4                              ; масштаб солнца 16.16, ТОЛЬКО уменьшение: s = 1.0 + (sin-127)*8/65536
 535+ C6E4                              ;   → s ∈ [0.969 .. 1.0] (±0..3.1%). Только shrink — у спрайта солнца НЕТ
 536+ C6E4                              ;   прозрачных полей (лучи до краёв), при увеличении лучи бы обрезались
 537+ C6E4                              ;   фиксированным BITMAP_SIZE. Уменьшение безопасно (внутри рамки, по краям
 538+ C6E4                              ;   прозрачно). offset = (sin-127)*8 ≤ 0; scale = #00010000 + offset, т.е.
 539+ C6E4                              ;   scaleLo = offset(как есть), scaleHi = 1 только при offset==0 иначе 0.
 540+ C6E4 3A DC CD                     LD   A, (MenuSunPhase)
 541+ C6E7 5F                           LD   E, A
 541+ C6E8 16 00          LD D, 0
 542+ C6EA 21 7A C8                     LD   HL, MenuSunSinTable
 543+ C6ED 19                           ADD  HL, DE
 544+ C6EE 7E                           LD   A, (HL)                            ; A = sin(phase), signed
 545+ C6EF 6F                           LD   L, A
 545+ C6F0 87             ADD A, A
 545+ C6F1 9F             SBC A, A
 545+ C6F2 67             LD H, A   ; HL = sign-extended sin (-128..127)
 546+ C6F3 11 81 FF                     LD   DE, -127
 547+ C6F6 19                           ADD  HL, DE                             ; HL = sin - 127  (-254..0)
 548+ C6F7 29                           ADD  HL, HL
 548+ C6F8 29             ADD HL, HL
 548+ C6F9 29             ADD HL, HL   ; HL = (sin-127)*8  (offset, -2032..0)
 549+ C6FA 22 DE CD                     LD   (MenuSunScaleLo), HL
 550+ C6FD 3E 01                        LD   A, 1
 551+ C6FF CB 7C                        BIT  7, H
 552+ C701 28 01                        JR   Z, .scale_hi                       ; H bit7=0 → offset==0 → Hi=1 (s=1.0)
 553+ C703 3D                           DEC  A                                  ; offset<0 → Hi=0 (s<1.0)
 554+ C704 6F           .scale_hi:      LD   L, A
 554+ C705 26 00          LD H, 0
 555+ C707 22 E0 CD                     LD   (MenuSunScaleHi), HL
