1868+ CB23                              ; Freeze until the first DoGapStep. Explosion finalizes after
1869+ CB23                              ; VDC_EXPLOSION_FRAMES, but GapStepCnt fires at CELL_SIZE.
1870+ CB23                              ; If we unfreeze at frame 15 while the gap marker waits until
1871+ CB23                              ; frame 32, the head segment moves forward across an open gap.
1872+ CB23 3E 20                        LD   A, VDC_GAP_STEP_FRAMES
1873+ CB25 32 5D D3                     LD   (VDC_ChainFreezeCnt), A
