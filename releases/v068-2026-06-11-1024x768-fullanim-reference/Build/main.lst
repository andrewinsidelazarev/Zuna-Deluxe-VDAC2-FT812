 199+ 6A70              ; Overlay trampolines (resident). Each maps LOADER_OVL_PAGE into slot 3, calls
 200+ 6A70              ; the real OVL_* routine in the overlay, then restores PAGE3=#04. Done under DI
 201+ 6A70              ; so an interrupt never sees slot 3 holding the loader page. CF (load result) is
 202+ 6A70              ; preserved across SetPage3 (it only touches HL) and the final EI.
 203+ 6A70              ; ----------------------------------------------------------------------------
 204+ 6A70              LoadGameplayLevelSpecificFromPack:
 205+ 6A70 F3                           DI
 206+ 6A71                              SetPage3 LOADER_OVL_PAGE
 206+ 6A71             >                ifdef MAPPING_REGISTERS
 206+ 6A71 21 13 04    >                LD HL, FMADDR_REGS + HIGH PAGE3
 206+ 6A74 36 40       >                LD (HL), LOADER_OVL_PAGE & 0xFF
 206+ 6A76             >                else
 206+ 6A76 ~           >                LD A, Page? & 0xFF
 206+ 6A76 ~           >                LD (MemoryPages + 3), A
 206+ 6A76 ~           >                LD BC, PAGE3
 206+ 6A76 ~           >                OUT (C), A
 206+ 6A76             >                endif
 207+ 6A76 CD D8 E8                     CALL OVL_LoadGameplayLevelSpecificFromPack
 208+ 6A79 F3                           DI                                     ; overlay (ZiFi_Done) re-enabled IRQs; re-disable to restore slot 3 atomically
 209+ 6A7A                              SetPage3 #04
 209+ 6A7A             >                ifdef MAPPING_REGISTERS
 209+ 6A7A 21 13 04    >                LD HL, FMADDR_REGS + HIGH PAGE3
 209+ 6A7D 36 04       >                LD (HL), #04 & 0xFF
 209+ 6A7F             >                else
 209+ 6A7F ~           >                LD A, Page? & 0xFF
 209+ 6A7F ~           >                LD (MemoryPages + 3), A
 209+ 6A7F ~           >                LD BC, PAGE3
 209+ 6A7F ~           >                OUT (C), A
 209+ 6A7F             >                endif
 210+ 6A7F FB                           EI
 211+ 6A80 C9                           RET
