3460  5FDD              ; VDC_SpeedAdvance — normal-phase chain advance at per-level speed. accum +=
3461  5FDD              ; speed_x100; когда ≥100 → один VDC_MoveChain.
3462  5FDD              ; Core-resident (Main1 почти полон). Clobbers AF, HL.
3463  5FDD              VDC_SpeedAdvance:
3464  5FDD 3A 70 D3                     LD   A, (Core.VDC_SpeedAccum)
3465  5FE0 21 6E D3                     LD   HL, Core.VDC_LevelSpeed
3466  5FE3 86                           ADD  A, (HL)
3467  5FE4 FE 64                        CP   100
3468  5FE6 38 08                        JR   C, .vsa_no
3469  5FE8 D6 64                        SUB  100
3470  5FEA 32 70 D3                     LD   (Core.VDC_SpeedAccum), A
3471  5FED C3 FF C6                     JP   Core.VDC_MoveChain                  ; tail: один advance, RET к caller
3472  5FF0 32 70 D3     .vsa_no:        LD   (Core.VDC_SpeedAccum), A
3473  5FF3 C9                           RET
