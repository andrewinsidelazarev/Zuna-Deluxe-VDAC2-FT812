 194+ C495              ; ---------------------------------------------------------------------
 195+ C495              ; RawPak_* — self-contained FAT32 reader over direct SD CMD18.
 196+ C495              ;
 197+ C495              ; This path intentionally bypasses the bundled WC CORE32 LOAD512 state. It
 198+ C495              ; supports both contiguous and fragmented files by following the FAT chain
 199+ C495              ; between every cluster. Current host image is superfloppy FAT32 with
 200+ C495              ; 512-byte sectors and spc=1; we validate that in RawPak_OpenRoot.
 201+ C495              ;
 202+ C495              ; Directory/file lookup matches by NAME, case-insensitive: it reconstructs the
 203+ C495              ; LONG name (LFN) when present, else the 8.3 short name, and compares to these
 204+ C495              ; targets. This is robust to whatever short alias the injector assigns (the
 205+ C495              ; observed bug was injector writing GAMES~1 while we searched "GAMES      ").
 206+ C495
 207+ C495              RAWPAK_NAME_PAK:
 208+ C495 5A 55 4D 41                  DEFB "ZUMALVL.PAK", 0
 208+ C499 4C 56 4C 2E
 208+ C49D 50 41 4B 00
 209+ C4A1              RAWPAK_NAME_AUDIO:
 210+ C4A1 5A 55 4D 41                  DEFB "ZUMAAUD.PAK", 0
 210+ C4A5 41 55 44 2E
 210+ C4A9 50 41 4B 00
 211+ C4AD              RAWPAK_NAME_SOUND:
 212+ C4AD 5A 55 4D 41                  DEFB "ZUMASND.PAK", 0
 212+ C4B1 53 4E 44 2E
 212+ C4B5 50 41 4B 00
 213+ C4B9              RAWPAK_NAME_MAIN:
 214+ C4B9 5A 55 4D 41                  DEFB "ZUMAMAIN.PAK", 0
 214+ C4BD 4D 41 49 4E
 214+ C4C1 2E 50 41 4B
 214+ C4C5 00
 215+ C4C6              RAWPAK_NAME_BOOT:                               ; HOBETA WC loader в корне SD (для Quit)
 216+ C4C6 42 4F 4F 54                  DEFB "BOOT.$C", 0
 216+ C4CA 2E 24 43 00
 217+ C4CE              RAWPAK_BOOT_SIZE EQU 31761
 218+ C4CE
 219+ C4CE              ; DBG instrumentation (read in F12 dump to bisect a failed open; addresses are
 220+ C4CE              ; resident in loader_resident.asm — ZiFi_DbgGamesA #6432, GpDbgStep #642D):
 221+ C4CE              ;   ZiFi_DbgGamesA = RawPak open granular step:
 222+ C4CE              ;       #20 entry, #21 sector0 read OK, #22 BPB valid, #26 search start, #25 PAK found;
 223+ C4CE              ;       #A1 sector0 CMD err, #A2 BPB invalid (bps!=512 / no FAT32 partition),
 224+ C4CE              ;       #A3 spc=0, #A6 PAK (name+size) not found anywhere, #A7 run-table overflow.
 225+ C4CE              ;   ZiFi_DbgGamesFound = directories visited during the recursive search.
 226+ C4CE              RawPak_OpenRoot:
 227+ C4CE 3E 20                        LD   A, #20
 228+ C4D0 32 68 6A                     LD   (ZiFi_DbgGamesA), A
 229+ C4D3 AF                           XOR  A
 230+ C4D4 32 69 6A                     LD   (ZiFi_DbgGamesFound), A
 231+ C4D7                              ; Invalidate the FAT-sector cache (FatBufLba = #FFFFFFFF). The cache
 232+ C4D7                              ; in RawPak_FatNext skips re-reading a FAT sector already in FatBuf;
 233+ C4D7                              ; the FAT is read-only for us, so it stays valid for the whole session.
 234+ C4D7 21 FF FF                     LD   HL, #FFFF
 235+ C4DA 22 D1 D0                     LD   (RawPak_FatBufLba + 0), HL
 236+ C4DD 22 D3 D0                     LD   (RawPak_FatBufLba + 2), HL
 237+ C4E0                              ; --- Read sector 0 (boot sector OR MBR). LBA 0 is addressing-
 238+ C4E0                              ; agnostic (arg 0 either way), so this read works before we know
 239+ C4E0                              ; block vs byte. Then mirror ChkDsk: scan the MBR partition table;
 240+ C4E0                              ; a real card is MBR-partitioned + SDHC (block-addressed), Unreal is
 241+ C4E0                              ; a superfloppy (no table) + byte-addressed.
 242+ C4E0 21 00 00                     LD   HL, 0
 243+ C4E3 11 00 00                     LD   DE, 0
 244+ C4E6 CD 92 CB                     CALL RawPak_ReadSectorBuffer
 245+ C4E9 DA 6C C6                     JP   C, .ErrBpbRead
 246+ C4EC 3E 21                        LD   A, #21
 247+ C4EE 32 68 6A                     LD   (ZiFi_DbgGamesA), A
 248+ C4F1 AF                           XOR  A                          ; part_lba = 0 (superfloppy: sector 0 is the BPB)
 249+ C4F2 32 B5 CE                     LD   (RawPak_PartLba + 0), A
 250+ C4F5 32 B6 CE                     LD   (RawPak_PartLba + 1), A
 251+ C4F8 32 B7 CE                     LD   (RawPak_PartLba + 2), A
 252+ C4FB 32 B8 CE                     LD   (RawPak_PartLba + 3), A
 253+ C4FE                              ; Is sector 0 itself a FAT32 BPB (bytes/sector == 512)? Then this is
 254+ C4FE                              ; a superfloppy (Unreal) -> use sector 0 as BPB, byte addressing.
 255+ C4FE                              ; Otherwise it is an MBR -> scan the partition table. (Checking the
 256+ C4FE                              ; BPB first avoids false-matching boot-code bytes at offset 446.)
 257+ C4FE DD 21 00 80                  LD   IX, #8000
 258+ C502 DD 7E 0B                     LD   A, (IX + 11)
 259+ C505 B7                           OR   A
 260+ C506 20 07                        JR   NZ, .tryMbr
 261+ C508 DD 7E 0C                     LD   A, (IX + 12)
 262+ C50B FE 02                        CP   2
 263+ C50D 28 3E                        JR   Z, .bpbReady               ; sector 0 is a 512-B/sector BPB -> superfloppy
 264+ C50F DD 21 BE 81  .tryMbr:       LD   IX, #8000 + 446            ; MBR partition table: 4 entries x 16 B
 265+ C513 06 04                        LD   B, 4
 266+ C515 DD 7E 04     .mbrScan:      LD   A, (IX + 4)                 ; partition type
 267+ C518 FE 0B                        CP   #0B                         ; FAT32 (CHS)
 268+ C51A 28 0E                        JR   Z, .havePart
 269+ C51C FE 0C                        CP   #0C                         ; FAT32 (LBA)
 270+ C51E 28 0A                        JR   Z, .havePart
 271+ C520 11 10 00                     LD   DE, 16
 272+ C523 DD 19                        ADD  IX, DE
 273+ C525 10 EE                        DJNZ .mbrScan
 274+ C527 C3 70 C6                     JP   .ErrBps                    ; not a BPB and no FAT32 partition entry
 275+ C52A DD 7E 08     .havePart:     LD   A, (IX + 8)
 275+ C52D 32 B5 CE       LD (RawPak_PartLba + 0), A   ; partition start LBA
 276+ C530 DD 7E 09                     LD   A, (IX + 9)
 276+ C533 32 B6 CE       LD (RawPak_PartLba + 1), A
 277+ C536 DD 7E 0A                     LD   A, (IX + 10)
 277+ C539 32 B7 CE       LD (RawPak_PartLba + 2), A
 278+ C53C DD 7E 0B                     LD   A, (IX + 11)
 278+ C53F 32 B8 CE       LD (RawPak_PartLba + 3), A
 279+ C542                              ; Найден MBR-раздел => это реальная SDHC-карта => блочная адресация
 280+ C542                              ; АВТОРИТЕТНА. НЕ откатываемся на байтовую: байтовый режим на SDHC шлёт
 281+ C542                              ; неверные адреса блоков и может вывести карту из строя (восстановление
 282+ C542                              ; только физическим переткиванием). Откат на byte допустим лишь для
 283+ C542                              ; настоящего superfloppy (там ветка .bpbReady достигается напрямую с
 284+ C542                              ; sd_blkt=0). Раньше тут был откат на byte — он и кирпичил 32 ГБ карту.
 285+ C542 3E 01                        LD   A, 1
 286+ C544 32 0A C4                     LD   (sd_blkt), A
 287+ C547 CD 30 CC                     CALL RawPak_ReadPartBpb
 288+ C54A DA 70 C6                     JP   C, .ErrBps
 289+ C54D DD 21 00 80  .bpbReady:     LD   IX, #8000
 290+ C551                              ; Require 512-byte sectors and a non-zero sectors/cluster value.
 291+ C551 DD 7E 0B                     LD   A, (IX + 11)
 292+ C554 B7                           OR   A
 293+ C555 C2 70 C6                     JP   NZ, .ErrBps
 294+ C558 DD 7E 0C                     LD   A, (IX + 12)
 295+ C55B FE 02                        CP   2
 296+ C55D C2 70 C6                     JP   NZ, .ErrBps
