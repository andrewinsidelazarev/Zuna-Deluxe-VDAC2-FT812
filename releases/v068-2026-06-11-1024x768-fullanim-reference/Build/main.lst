2815  3DA3             >                else
2815  3DA3 ~           >                LD (MemoryPages + 2), A
2815  3DA3 ~           >                LD BC, PAGE2
2815  3DA3 ~           >                OUT (C), A
2815  3DA3             >                endif
2816  3DA3 B7                           OR   A
2817  3DA4 C9                           RET
2818  3DA5 3A AD 3D     .restore_error: LD   A, (.sip2_saved_page2)
2819  3DA8                              SetPage2_A
2819  3DA8             >                ifdef MAPPING_REGISTERS
2819  3DA8 32 12 04    >                LD (FMADDR_REGS + HIGH PAGE2), A
2819  3DAB             >                else
2819  3DAB ~           >                LD (MemoryPages + 2), A
2819  3DAB ~           >                LD BC, PAGE2
2819  3DAB ~           >                OUT (C), A
2819  3DAB             >                endif
2820  3DAB 37                           SCF
2821  3DAC C9                           RET
