 881+ C5F1              ; ============================================================================
 882+ C5F1              ; VDC_SlotT — для A=i считает t = (HSA-i)*64 + HSub + sext(offsets[i]).
 883+ C5F1              ; Out: HL = signed 16-bit t.  AF/DE clobber.
 884+ C5F1              ; ============================================================================
 885+ C5F1              VDC_SlotT:
 886+ C5F1 4F                           LD   C, A                             ; C = i
 887+ C5F2 3A 5C D3                     LD   A, (VDC_HSA)
 888+ C5F5 91                           SUB  C
 889+ C5F6 30 04                        JR   NC, .delta_ok
 890+ C5F8                              ; i > HSA — слот логически до начала цепи. В рабочей Zuma
 891+ C5F8                              ; (BcsPreClassify) это PRESERVE/skip. Возвращаем signed-negative HL
 892+ C5F8                              ; чтобы VDC_SlotPos через `BIT 7, H` сделал SCF/RET (skip render +
 893+ C5F8                              ; skip bullet collision). Раньше тут был `XOR A` → clamp 0 →
 894+ C5F8                              ; шар рисовался у спавна и зацеплялся коллизией («застрявший шар»
 895+ C5F8                              ; после match-3/cascade с HsaDec). Codex 2026-05-14 diagnose, Claude fix.
 896+ C5F8 21 00 80                     LD   HL, #8000
 897+ C5FB C9                           RET
 898+ C5FC              .delta_ok:
 899+ C5FC 26 00                        LD   H, 0
 899+ C5FE 6F             LD L, A                    ; HL = delta
 900+ C5FF                              ; VDC_CELL_SIZE=32: avoid generic ZL_Mul16x8 in the hot
 901+ C5FF                              ; VDC_SlotPos path. This is hit once per rendered/collided ball.
 902+ C5FF 29                           ADD  HL, HL
 903+ C600 29                           ADD  HL, HL
 904+ C601 29                           ADD  HL, HL
 905+ C602 29                           ADD  HL, HL
 906+ C603 29                           ADD  HL, HL                            ; HL = delta * VDC_CELL_SIZE
 907+ C604
 908+ C604                              ; + HSub (0..63 unsigned)
 909+ C604 3A 95 69                     LD   A, (VDC_HSub)
 910+ C607 5F                           LD   E, A
 911+ C608 16 00                        LD   D, 0
 912+ C60A 19                           ADD  HL, DE
 913+ C60B
 914+ C60B                              ; + sext(offsets[i])
 915+ C60B 79                           LD   A, C
 916+ C60C E5                           PUSH HL
 917+ C60D 26 00                        LD   H, 0
 917+ C60F 6F             LD L, A
 918+ C610 ED 5B 3C D6                  LD   DE, (VDC_pOffsets)
 919+ C614 19                           ADD  HL, DE
 920+ C615 7E                           LD   A, (HL)
 921+ C616 5F                           LD   E, A
 922+ C617 16 00                        LD   D, 0
 923+ C619 CB 7F                        BIT  7, A
 924+ C61B 28 01                        JR   Z, .off_pos
 925+ C61D 15                           DEC  D                                ; sign-extend
 926+ C61E              .off_pos:
 927+ C61E E1                           POP  HL
 928+ C61F 19                           ADD  HL, DE
 929+ C620 C9                           RET
