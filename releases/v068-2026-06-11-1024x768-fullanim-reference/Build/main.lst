1018+ C676              .spawn_no_tail_check:
1019+ C676                              ; --- Level RNG:
1020+ C676                              ; RTC seconds seed only at VDC_Init. Runtime uses deterministic LFSR.
1021+ C676                              ; Per level setting: 50% single random color OR 50% same-color
1022+ C676                              ; chain of random color and random length 1..VDC_NUM_COLORS-1.
1023+ C676 3A 61 D3                     LD   A, (VDC_SpawnClusterRem)
1024+ C679 B7                           OR   A
1025+ C67A 28 0A                        JR   Z, .spawn_roll_new
1026+ C67C 3D                           DEC  A
1027+ C67D 32 61 D3                     LD   (VDC_SpawnClusterRem), A
1028+ C680 3A 60 D3                     LD   A, (VDC_SpawnClusterColor)
1029+ C683 47                           LD   B, A
1030+ C684 18 28                        JR   .spawn_color_ready
1031+ C686              .spawn_roll_new:
1032+ C686 CD 69 CF                     CALL VDC_RandomColor                   ; A = gate roll 0..NUM-1
1033+ C689 CB 47                        BIT  0, A                              ; odd/even ≈ 50/50 for NUM=6
1034+ C68B 28 13                        JR   Z, .spawn_single_random           ; 50% single random ball
1035+ C68D                              ; cluster path — reroll color until != предыдущий cluster.
1036+ C68D                              ; (VDC_SpawnClusterColor) = previous color (or sentinel #FF на init).
1037+ C68D              .cluster_color_reroll:
1038+ C68D CD 69 CF                     CALL VDC_RandomColor                   ; chain color candidate
1039+ C690 21 60 D3                     LD   HL, VDC_SpawnClusterColor
1040+ C693 BE                           CP   (HL)                              ; == previous?
1041+ C694 28 F7                        JR   Z, .cluster_color_reroll          ; → reroll
1042+ C696 77                           LD   (HL), A                           ; commit color
1043+ C697 CD 89 CF                     CALL VDC_RandomClusterLength           ; A = total length 1..NUM-1
1044+ C69A                                                                     ; (NB: ZL_Mul16x8 clobs B/C —
1045+ C69A                                                                     ; читаем color из памяти ниже)
1046+ C69A 3D                           DEC  A                                 ; current spawn is first ball
1047+ C69B 32 61 D3                     LD   (VDC_SpawnClusterRem), A
1048+ C69E 18 0E                        JR   .spawn_color_ready
1049+ C6A0              .spawn_single_random:
1050+ C6A0                              ; single path — тоже reroll, чтобы два соседних кластера/single
1051+ C6A0                              ; никогда не были одного цвета.
1052+ C6A0              .single_color_reroll:
1053+ C6A0 CD 69 CF                     CALL VDC_RandomColor
1054+ C6A3 21 60 D3                     LD   HL, VDC_SpawnClusterColor
1055+ C6A6 BE                           CP   (HL)
1056+ C6A7 28 F7                        JR   Z, .single_color_reroll
1057+ C6A9 77                           LD   (HL), A                           ; commit color
1058+ C6AA AF                           XOR  A
1059+ C6AB 32 61 D3                     LD   (VDC_SpawnClusterRem), A
1060+ C6AE              .spawn_color_ready:
1061+ C6AE 3A 60 D3                     LD   A, (VDC_SpawnClusterColor)        ; re-read color from memory
1062+ C6B1                                                                     ; (B клобан RandomColor/Mul16x8)
1063+ C6B1 47                           LD   B, A
1064+ C6B2                              ; B = chosen color. Не режем 3+ одинаковых на spawn: в оригинальной
1065+ C6B2                              ; Zuma цепь может иметь длинные серии, а match запускается только
1066+ C6B2                              ; от выстрела или физического закрытия gap через Shot2/cascade.
1067+ C6B2 78                           LD   A, B
1068+ C6B3 32 60 D3                     LD   (VDC_SpawnClusterColor), A
