1533+ F14B              ; ----------------------------------------------------------------------------
1534+ F14B              ; ZL_FT_CMD_Write_DMA — runtime FT_CMD_Write replacement using TS-Config DMA.
1535+ F14B              ;   Sends CMD_ADDRESS_PTR..BufferPtr to FT_REG_CMDB_WRITE through DMA_RAM_SPI.
1536+ F14B              ;   MainLoop calls this only after previous WaitFlush, so the FT812 command FIFO
1537+ F14B              ;   should have enough free space for the whole frame buffer. Keep the legacy
1538+ F14B              ;   FT_CMD_Write path behind ZL_FT_CMD_DMA_ENABLED for hardware fallback.
1539+ F14B              ; ----------------------------------------------------------------------------
1540+ F14B              ZL_CMD_DMA_PAGE EQU #05
1541+ F14B              ZL_CMD_DMA_ADDR EQU #4CB0 & #3FFF
1542+ F14B
1543+ F14B              ZL_FT_CMD_Write_DMA:
1544+ F14B                              FT_CMD_Count                            ; BC = byte count
1544+ F14B 2A 35 14    >                        LD HL, (FT.Coprocessor.BufferPtr)
1544+ F14E 11 50 B3    >                        LD DE, (-#4CB0) & 0xFFFF
1544+ F151 19          >                        ADD HL, DE
1544+ F152 44          >                        LD B, H
1544+ F153 4D          >                        LD C, L
1545+ F154 78                           LD   A, B
1546+ F155 B1                           OR   C
1547+ F156 C8                           RET  Z
1548+ F157
1549+ F157                              ; Convert byte count to word count for DMA registers.
1550+ F157 CB 38                        SRL  B
1551+ F159 CB 19                        RR   C
1552+ F15B 78                           LD   A, B
1553+ F15C 32 35 F2                     LD   (ZL_CmdDmaWordsHi), A              ; full 512-byte chunks
1554+ F15F 79                           LD   A, C
1555+ F160 32 36 F2                     LD   (ZL_CmdDmaWordsLo), A              ; trailing words
1556+ F163
1557+ F163                              FT_ON
1557+ F163 3E 07       >                LD A, SPI_FT_CS_ON
1557+ F165 D3 77       >                OUT (SPI_CTRL), A
1558+ F167                              ; FT812 SPI memory-write header: 1,0,address[21:0], then payload.
1559+ F167 3E B0                        LD   A, ((FT_REG_CMDB_WRITE >> 16) & #FF) | #80
1560+ F169 D3 57                        OUT  (SPI_DATA), A
1561+ F16B 3E 25                        LD   A, (FT_REG_CMDB_WRITE >> 8) & #FF
1562+ F16D D3 57                        OUT  (SPI_DATA), A
1563+ F16F 3E 78                        LD   A, FT_REG_CMDB_WRITE & #FF
1564+ F171 D3 57                        OUT  (SPI_DATA), A
1565+ F173
1566+ F173                              ; DMA source = CMD buffer in Core page #05, offset #1010.
1567+ F173 3E B0                        LD   A, LOW ZL_CMD_DMA_ADDR
1568+ F175 01 AF 1A                     LD   BC, DMASADDRL
1569+ F178 ED 79                        OUT  (C), A
1570+ F17A 3E 0C                        LD   A, HIGH ZL_CMD_DMA_ADDR
1571+ F17C 01 AF 1B                     LD   BC, DMASADDRH
1572+ F17F ED 79                        OUT  (C), A
1573+ F181 3E 05                        LD   A, ZL_CMD_DMA_PAGE
1574+ F183 01 AF 1C                     LD   BC, DMASADDRX
1575+ F186 ED 79                        OUT  (C), A
1576+ F188
1577+ F188                              ; Full 512-byte chunks: DMALEN=255 words, DMANUM=chunks-1.
1578+ F188 3A 35 F2                     LD   A, (ZL_CmdDmaWordsHi)
1579+ F18B B7                           OR   A
1580+ F18C 28 1D                        JR   Z, .tail
1581+ F18E 3D                           DEC  A
1582+ F18F 01 AF 28                     LD   BC, DMANUM
1583+ F192 ED 79                        OUT  (C), A
1584+ F194 3E FF                        LD   A, #FF
1585+ F196 01 AF 26                     LD   BC, DMALEN
1586+ F199 ED 79                        OUT  (C), A
1587+ F19B 3E 82                        LD   A, DMA_RAM_SPI
1588+ F19D 01 AF 27                     LD   BC, DMACTR
1589+ F1A0 ED 79                        OUT  (C), A
1590+ F1A2 01 AF 27     .wait_full:     LD   BC, DMASTATUS
1591+ F1A5 ED 78                        IN   A, (C)
1592+ F1A7 E6 80                        AND  DMA_WNR
1593+ F1A9 20 F7                        JR   NZ, .wait_full
1594+ F1AB
1595+ F1AB 3A 36 F2     .tail:          LD   A, (ZL_CmdDmaWordsLo)
1596+ F1AE B7                           OR   A
1597+ F1AF 28 1C                        JR   Z, .done
1598+ F1B1 3D                           DEC  A
1599+ F1B2 01 AF 26                     LD   BC, DMALEN
1600+ F1B5 ED 79                        OUT  (C), A
1601+ F1B7 AF                           XOR  A
1602+ F1B8 01 AF 28                     LD   BC, DMANUM
1603+ F1BB ED 79                        OUT  (C), A
1604+ F1BD 3E 82                        LD   A, DMA_RAM_SPI
1605+ F1BF 01 AF 27                     LD   BC, DMACTR
1606+ F1C2 ED 79                        OUT  (C), A
1607+ F1C4 01 AF 27     .wait_tail:     LD   BC, DMASTATUS
1608+ F1C7 ED 78                        IN   A, (C)
1609+ F1C9 E6 80                        AND  DMA_WNR
1610+ F1CB 20 F7                        JR   NZ, .wait_tail
1611+ F1CD
1612+ F1CD              .done:          FT_OFF
