1740+ F55A              ; ----------------------------------------------------------------------------
1741+ F55A              ; ZL_EmitBallMatrixFromBRAD — LDIR matrix block в CMD буфер.
1742+ F55A              ;   In: A = BRAD (0..255), любые битья. Внутри квантуется к 8 BRAD (32 buckets).
1743+ F55A              ;   Out: matrix эмитнут в FT BufferPtr.
1744+ F55A              ;   Clobbers: AF, BC, DE, HL.
1745+ F55A              ; Reusable между chain rendering и FrogBallNow / прочими 32×32 sprites.
1746+ F55A              ; ----------------------------------------------------------------------------
1747+ F55A              ZL_EmitBallMatrixFromBRAD:
1748+ F55A E6 F0                        AND  #F0                                ; quantize to 16 BRAD (uses even entries in 8-BRAD LUT)
