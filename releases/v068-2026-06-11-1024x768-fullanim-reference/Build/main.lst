 558+ C7CF              RawPak_ReadWcPath:
 559+ C7CF 3E F7                        LD   A, WC_RPPG
 560+ C7D1                              SetPage2_A
 560+ C7D1             >                ifdef MAPPING_REGISTERS
 560+ C7D1 32 12 04    >                LD (FMADDR_REGS + HIGH PAGE2), A
 560+ C7D4             >                else
 560+ C7D4 ~           >                LD (MemoryPages + 2), A
 560+ C7D4 ~           >                LD BC, PAGE2
 560+ C7D4 ~           >                OUT (C), A
