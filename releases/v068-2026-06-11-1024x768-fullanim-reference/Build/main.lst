1982  3232              ; ============================================================================
1983  3232              ; 24-bit cumulative score (Core.VDC_PlayerScore, 3-byte LE) + 50000 extra-life.
1984  3232              ; Resident (slot 0), so callable from gameplay (#04) and resident win/HUD code.
1985  3232              ; ----------------------------------------------------------------------------
1986  3232              ; Score_Add24 — VDC_PlayerScore += HL (16-bit delta), then award extra lives.
1987  3232              ;   In: HL = points to add. Clobbers AF, DE, HL (NOT BC).
1988  3232              ; ----------------------------------------------------------------------------
1989  3232              Score_Add24:
1990  3232 ED 5B A1 69                  LD   DE, (Core.VDC_PlayerScore)        ; DE = low 16 bits
1991  3236 19                           ADD  HL, DE                            ; CF = carry out of low 16
1992  3237 22 A1 69                     LD   (Core.VDC_PlayerScore), HL        ; store low 16 (LD keeps CF)
1993  323A 3A A3 69                     LD   A, (Core.VDC_PlayerScore + 2)
1994  323D CE 00                        ADC  A, 0                              ; += carry into byte 2
1995  323F 32 A3 69                     LD   (Core.VDC_PlayerScore + 2), A
1996  3242                              ; fall through to extra-life check
1997  3242              ; ----------------------------------------------------------------------------
1998  3242              ; Score_CheckExtraLife — while score >= NextLifeScore: VDC_Lives++, threshold += 50000.
1999  3242              ; ----------------------------------------------------------------------------
2000  3242              Score_CheckExtraLife:
