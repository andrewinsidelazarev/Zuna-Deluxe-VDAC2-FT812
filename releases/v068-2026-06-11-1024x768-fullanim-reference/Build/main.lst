 159+ 1F91
 160+ 1F91              ; MoreGamesExitPressed — выход из экрана More Games. Возвращает A=1 на ФРОНТЕ
 161+ 1F91              ; нажатия ЛЮБОГО из: огонь-КЛАВИША (Space|Enter|Kempston-Fire, Core.Input_FireKey),
 162+ 1F91              ; ЛКМ (Core.Input_MouseLMB) или ESC (Core.Input_Esc). Иначе A=0.
 163+ 1F91              ; 🔴 ВАЖНО: огонь-клавиша и ЛКМ — ОТДЕЛЬНЫЕ фронт-детекторы (НЕ через Input_Fire,
 164+ 1F91              ; который их ИЛИ-объединяет). Иначе залипшая/фантомно-нажатая ЛКМ (на этом стенде
 165+ 1F91              ; мышиные/Kempston-биты порой читаются «нажато» постоянно — см. Frog.asm) держит
 166+ 1F91              ; объединённый сигнал в NZ → у клавиатурного огня НИКОГДА нет фронта (симптом:
 167+ 1F91              ; «выходит только по ESC»). Раздельно — залипшая ЛКМ не блокирует огонь с клавы.
 168+ 1F91              ; Input_EdgeZ обязан идти СРАЗУ после опроса — промежуточный LD HL,addr флаги не
 169+ 1F91              ; трогает, поэтому Z доходит до EdgeZ целым. *Prev primed=1 гасят перенос из меню.
 170+ 1F91              MoreGamesExitPressed:
 171+ 1F91 CD 82 7C                     CALL Core.Input_FireKey                    ; Space|Enter|Kempston (БЕЗ ЛКМ)
 172+ 1F94 21 B7 1F                     LD   HL, MoreGamesFirePrev
 173+ 1F97 CD 9D 7C                     CALL Core.Input_EdgeZ                      ; NZ=фронт, обновляет (HL)
 174+ 1F9A 20 18                        JR   NZ, .yes
 175+ 1F9C CD 95 7C                     CALL Core.Input_MouseLMB                   ; ЛКМ — изолированный фронт
 176+ 1F9F 21 B8 1F                     LD   HL, MoreGamesLmbPrev
 177+ 1FA2 CD 9D 7C                     CALL Core.Input_EdgeZ
 178+ 1FA5 20 0D                        JR   NZ, .yes
 179+ 1FA7 CD 41 7C                     CALL Core.Input_Esc                        ; ESC
 180+ 1FAA 21 B9 1F                     LD   HL, MoreGamesEscPrev
 181+ 1FAD CD 9D 7C                     CALL Core.Input_EdgeZ
 182+ 1FB0 20 02                        JR   NZ, .yes
 183+ 1FB2 AF                           XOR  A
 184+ 1FB3 C9                           RET
 185+ 1FB4 3E 01        .yes:           LD   A, 1
 186+ 1FB6 C9                           RET
 187+ 1FB7
 188+ 1FB7 00           MoreGamesFirePrev: DEFB 0
 189+ 1FB8 00           MoreGamesLmbPrev:  DEFB 0
 190+ 1FB9 00           MoreGamesEscPrev:  DEFB 0
 191+ 1FBA
# file closed: Source\ASM\MoreGamesSlot0.asm
