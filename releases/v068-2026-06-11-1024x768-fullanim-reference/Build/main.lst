1627+ F1DD              ; ZL_SmoothMouse — exponential low-pass filter (alpha = 1/4, восстановлено
1628+ F1DD              ; 2026-05-17 после жалобы на «желейный» прицел):
1629+ F1DD              ;   new = old + (raw - old) / 4 = old*3/4 + raw/4
1630+ F1DD              ; Latency ~3-4 кадра (~70 ms @57Hz). 1-px jitter Hyper-V подавляется т.к.
1631+ F1DD              ; ±1/4 в integer = 0 → Smooth не дрожит при идле raw=±1 px.
1632+ F1DD              ; ----------------------------------------------------------------------------
1633+ F1DD              ZL_SmoothMouse: ; --- X axis ---
1634+ F1DD 2A 6D 7B                     LD   HL, (ZL_SmoothX)                 ; HL = old
1635+ F1E0 54                           LD   D, H
1635+ F1E1 5D             LD E, L                   ; DE = old
1636+ F1E2 ED 4B 49 16                  LD   BC, (Input.Mouse.PositionX)
1637+ F1E6 A7                           AND  A
1638+ F1E7 ED 42                        SBC  HL, BC                           ; HL = old - raw (signed)
1639+ F1E9 CB 2C                        SRA  H
1639+ F1EB CB 1D          RR L
1640+ F1ED CB 2C                        SRA  H
1640+ F1EF CB 1D          RR L                         ; HL = (old-raw)/4 signed
1641+ F1F1 EB                           EX   DE, HL                           ; HL = old, DE = (old-raw)/4
1642+ F1F2 A7                           AND  A
1643+ F1F3 ED 52                        SBC  HL, DE                           ; HL = old - (old-raw)/4 = new
1644+ F1F5 22 6D 7B                     LD   (ZL_SmoothX), HL
1645+ F1F8
1646+ F1F8                              ; --- Y axis ---
1647+ F1F8 2A 6F 7B                     LD   HL, (ZL_SmoothY)
1648+ F1FB 54                           LD   D, H
1648+ F1FC 5D             LD E, L
1649+ F1FD ED 4B 4B 16                  LD   BC, (Input.Mouse.PositionY)
1650+ F201 A7                           AND  A
1651+ F202 ED 42                        SBC  HL, BC
1652+ F204 CB 2C                        SRA  H
1652+ F206 CB 1D          RR L
1653+ F208 CB 2C                        SRA  H
1653+ F20A CB 1D          RR L
1654+ F20C EB                           EX   DE, HL
1655+ F20D A7                           AND  A
1656+ F20E ED 52                        SBC  HL, DE
1657+ F210 22 6F 7B                     LD   (ZL_SmoothY), HL
1658+ F213 C9                           RET
