 794+ 755D 3E 0C                        LD   A, (CLEAR_RAMG_TAIL_ADDR >> 16) & #FF
 795+ 755F 11 00 80                     LD   DE, CLEAR_RAMG_TAIL_ADDR & #FFFF
 796+ 7562 06 C0                        LD   B, CLEAR_RAMG_CHUNKS
