   1+ 1D77              ; More Games room, menu quit path and system-wide fire input state.
   2+ 1D77              ; Kept in slot 0 because main1_play is close to its 16K page limit.
   3+ 1D77
   4+ 1D77              ; Standalone SPG exit path → грузим Wild Commander сами (boot.$C HOBETA с SD).
   5+ 1D77              ; MEMCONFIG=0+JP#0000 (Service ROM) НЕ грузит boot.$ (даёт пустой ZX-экран), поэтому
   6+ 1D77              ; используем свой HOBETA-загрузчик: найти BOOT.$C → стаб в #4000 (bank5, ниже #6011)
   7+ 1D77              ; → режим WC без LCK128 (MemConfig=#01; slot1=bank5/slot2=bank2/slot3=bank0) → JP
   8+ 1D77              ; #4000 → стаб читает файл в #6000 (file[17]=WC на #6011) → JP #6011.
   9+ 1D77              ; Эталон живого WC со скрина: VConfig=#24, SusConfig=#06, MemConfig=#01, INTMASK=0.
  10+ 1D77              MenuQuitToWC:
  11+ 1D77 F3                           DI
  12+ 1D78 3E 10                        LD   A, #10
  13+ 1D7A 32 40 6C                     LD   (Core.Quit_DbgStage), A
  14+ 1D7D CD 42 6C                     CALL Core.ProbeBootHobeta               ; найти BOOT.$C и первый сектор через старый DFS
  15+ 1D80 3A 11 6C                     LD   A, (Core.Boot_Found)
  16+ 1D83 B7                           OR   A
  17+ 1D84 CA BF 1D                     JP   Z, .qFallback
  18+ 1D87
  19+ 1D87 3E 20                        LD   A, #20
  20+ 1D89 32 40 6C                     LD   (Core.Quit_DbgStage), A
  21+ 1D8C 21 53 6C                     LD   HL, Core.QuitStub_Image            ; стаб уже лежит в Core/page5, копируем ниже BOOT.$C
  22+ 1D8F 11 00 40                     LD   DE, #4000
  23+ 1D92 01 ED 01                     LD   BC, Core.QuitStub_Len
  24+ 1D95 ED B0                        LDIR
  25+ 1D97
  26+ 1D97 3E 30                        LD   A, #30
  27+ 1D99 32 40 6C                     LD   (Core.Quit_DbgStage), A
  28+ 1D9C 2A 3A 6C                     LD   HL, (Core.Boot_StartLba + 0)
  29+ 1D9F 22 E7 41                     LD   (Core.QS_Lba + 0), HL
  30+ 1DA2 2A 3C 6C                     LD   HL, (Core.Boot_StartLba + 2)
  31+ 1DA5 22 E9 41                     LD   (Core.QS_Lba + 2), HL
  32+ 1DA8 3A 3E 6C                     LD   A, (Core.Boot_SecCount)
  33+ 1DAB 32 EB 41                     LD   (Core.QS_Cnt), A
  34+ 1DAE 3A 3F 6C                     LD   A, (Core.Boot_Blkt)
  35+ 1DB1 32 EC 41                     LD   (Core.QS_Blkt), A
  36+ 1DB4
  37+ 1DB4 CD D8 1D                     CALL .qResetHw                          ; сбросить FT812 до ухода из Zuma
  38+ 1DB7 3E 40                        LD   A, #40
  39+ 1DB9 32 40 6C                     LD   (Core.Quit_DbgStage), A
  40+ 1DBC C3 00 40                     JP   #4000                              ; дальше стаб сам выставляет память и читает BOOT.$C
  41+ 1DBF
  42+ 1DBF CD D8 1D     .qFallback:     CALL .qResetHw                          ; BOOT.$C нет → reset HW + вход TR-DOS
  43+ 1DC2 3E F0                        LD   A, #F0
  44+ 1DC4 32 40 6C                     LD   (Core.Quit_DbgStage), A
  45+ 1DC7 01 AF 21                     LD   BC, MEMCONFIG
  46+ 1DCA 3E 01                        LD   A, MEM_ROM128
  47+ 1DCC ED 79                        OUT  (C), A
  48+ 1DCE 01 FD 7F                     LD   BC, #7FFD
  49+ 1DD1 3E 10                        LD   A, #10
  50+ 1DD3 ED 79                        OUT  (C), A
  51+ 1DD5 C3 2F 3D                     JP   #3D2F
  52+ 1DD8
  53+ 1DD8              ; FT812 CORE_RESET (#68) + INTMASK=0 + VCONFIG=0 (вернуть ZX-ULA видео). Остальные
  54+ 1DD8              ; видео-регистры (VPAGE/TSCONFIG/PALSEL/…) НЕ трогаем — там значения WC.
  55+ 1DD8 3E 07        .qResetHw:      LD   A, SPI_FT_CS_ON
  56+ 1DDA D3 77                        OUT  (SPI_CTRL), A
  57+ 1DDC 3E 68                        LD   A, FT_CMD_RST_PULSE
  58+ 1DDE D3 57                        OUT  (SPI_DATA), A
  59+ 1DE0 AF                           XOR  A
  60+ 1DE1 D3 57                        OUT  (SPI_DATA), A
  61+ 1DE3 D3 57                        OUT  (SPI_DATA), A
  62+ 1DE5 3E 03                        LD   A, SPI_FT_CS_OFF
  63+ 1DE7 D3 77                        OUT  (SPI_CTRL), A
  64+ 1DE9 01 AF 2A                     LD   BC, INTMASK
  65+ 1DEC AF                           XOR  A
  66+ 1DED ED 79                        OUT  (C), A
  67+ 1DEF 01 AF 00                     LD   BC, VCONFIG
  68+ 1DF2 ED 79                        OUT  (C), A
  69+ 1DF4 C9                           RET
