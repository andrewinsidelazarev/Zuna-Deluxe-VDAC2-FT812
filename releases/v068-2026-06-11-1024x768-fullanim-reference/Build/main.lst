4437  7B77                              include "Input.asm"                   ; resident global input module (PS/2 keyboard via Mr.Gluk + Kempston + mouse); callable from any scene
# file opened: Source\ASM\Input.asm
   1+ 7B77              ; ============================================================================
   2+ 7B77              ; Input.asm — РЕЗИДЕНТНЫЙ глобальный модуль ВСЕГО управления. Здесь читаются ВСЕ
   3+ 7B77              ; источники ввода, поэтому любая сцена-overlay (геймплей #04, UI #41) может
   4+ 7B77              ; опрашивать ввод без переключения страниц.
   5+ 7B77              ;
   6+ 7B77              ; Источники (всё в одном месте — клавиатура + джойстик + мышь):
   7+ 7B77              ;   * Расширенная PC-клавиатура ZX Evolution через Mr.Gluk Z-контроллер:
   8+ 7B77              ;       OUT #EFF7,#80 = enable; OUT #DFF7,рег = выбор регистра; #BFF7 = данные.
   9+ 7B77              ;       Регистр #F0 = PS/2 FIFO scancode'ов (set-2). Тот же чип, что и RTC
  10+ 7B77              ;       (VDC.ReadRTCSeconds), который ГАСИТ #EFF7 после чтения — поэтому
  11+ 7B77              ;       Input_Scan каждый кадр включает его заново. См. заметку памяти
  12+ 7B77              ;       reference_zuma_vdac2_zxevo_ps2_keyboard.
  13+ 7B77              ;   * Kempston-джойстик (TSLib Input.Kempston). KJoystick=1 направляет PC-стрелки
  14+ 7B77              ;     сюда же.
  15+ 7B77              ;   * Мышь (TSLib Input.Mouse) — позиция + ЛКМ.
  16+ 7B77              ;
  17+ 7B77              ; Схема управления: лягушка = вращение Влево/Вправо (геймплей). Глобальные UI:
  18+ 7B77              ;   Up/Down — навигация меню/выбор сложности; Влево/Вправо — активная кнопка в
  19+ 7B77              ;   диалогах; ESC — меню/назад; Fire = Space | Enter | Kempston-Fire | ЛКМ.
  20+ 7B77              ; Клавиатурные эквиваленты направлений (классическая ZX-раскладка):
  21+ 7B77              ;   Up = ↑ | Q;  Down = ↓ | A;  Влево = ← | O;  Вправо = → | P.
  22+ 7B77              ;
  23+ 7B77              ; Применение: Input_Init один раз на старте; Input_Scan один раз за кадр (в любой
  24+ 7B77              ; сцене — он обновляет и клавиатуру, и мышь); затем опросы Input_Up/Down/Left/
  25+ 7B77              ; Right/Fire/Esc (каждый возвращает NZ = активно). Edge-хелперы — для навигации.
  26+ 7B77              ; ============================================================================
  27+ 7B77
  28+ 7B77              ; Скан-коды PS/2 set-2 (make-коды; стрелки идут с префиксом E0, но их коды
  29+ 7B77              ; уникальны, поэтому при сопоставлении префикс E0 игнорируется).
  30+ 7B77              INP_SC_ESC      EQU #76
  31+ 7B77              INP_SC_UP       EQU #75
  32+ 7B77              INP_SC_DOWN     EQU #72
  33+ 7B77              INP_SC_LEFT     EQU #6B
  34+ 7B77              INP_SC_RIGHT    EQU #74
  35+ 7B77              INP_SC_ENTER    EQU #5A
  36+ 7B77              INP_SC_SPACE    EQU #29
  37+ 7B77              INP_SC_Q        EQU #15
  38+ 7B77              INP_SC_A        EQU #1C
  39+ 7B77              INP_SC_O        EQU #44          ; O = Влево (классическая ZX-раскладка)
  40+ 7B77              INP_SC_P        EQU #4D          ; P = Вправо
  41+ 7B77
  42+ 7B77              ; Флаги «клавиша нажата» (1 = нажата, 0 = отпущена), обновляются Input_Scan.
  43+ 7B77 00           Input_KEsc:     DEFB 0
  44+ 7B78 00           Input_KUp:      DEFB 0
  45+ 7B79 00           Input_KDown:    DEFB 0
  46+ 7B7A 00           Input_KLeft:    DEFB 0
  47+ 7B7B 00           Input_KRight:   DEFB 0
  48+ 7B7C 00           Input_KEnter:   DEFB 0
  49+ 7B7D 00           Input_KSpace:   DEFB 0
  50+ 7B7E 00           Input_KQ:       DEFB 0
  51+ 7B7F 00           Input_KA:       DEFB 0
  52+ 7B80 00           Input_KO:       DEFB 0
  53+ 7B81 00           Input_KP:       DEFB 0
  54+ 7B82 00           Input_PS2Brk:   DEFB 0          ; ожидается префикс отпускания (#F0)
  55+ 7B83 00           Input_DrainCnt: DEFB 0          ; ограничитель дренажа FIFO (макс байт за скан)
