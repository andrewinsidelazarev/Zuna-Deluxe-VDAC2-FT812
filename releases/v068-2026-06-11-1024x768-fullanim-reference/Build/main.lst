  44+ C037 D1          >                POP DE
  44+ C038 FE 7C       >                CP #7C
  44+ C03A 20 F2       >                JR NZ, .WaitIntReady
  44+ C03C             >
  44+ C03C             >.WaitCPU_Reset  ; wait
  44+ C03C             >                FT_RD_REG8 FT_REG_CPURESET
  44+ C03C D5          >                PUSH DE
  44+ C03D 3E 30       >                LD A, (FT_RAM_REG >> 16) & 0xFF
  44+ C03F 11 20 20    >                LD DE, (FT_REG_CPURESET) & 0xFFFF
  44+ C042 CD A5 11    >                CALL FT.Read8
  44+ C045 D1          >                POP DE
  44+ C046 B7          >                OR A
  44+ C047 20 F3       >                JR NZ, .WaitCPU_Reset
  44+ C049             >
  44+ C049             >                FT_WR_REG8 FT_REG_PCLK, 0
  44+ C049 3E 00       >                LD A, 0 & 0xFF
  44+ C04B 11 70 20    >                LD DE, FT_REG_PCLK & 0xFFFF
