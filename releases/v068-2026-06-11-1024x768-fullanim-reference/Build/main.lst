  62+ C134                              ; --- 5. Залить минимальный пустой DL: чёрный экран -------
  63+ C134                              ; До первого FT_CMD_Write из MainLoop'а на экране может быть
  64+ C134                              ; garbage (RAM_DL после reset не определена). Заливаем 12 байт:
  65+ C134                              ; CLEAR_COLOR_RGB(0,0,0); CLEAR(1,1,1); DISPLAY().
  66+ C134 21 63 C1                     LD   HL, .EmptyDL
  67+ C137 01 0C 00                     LD   BC, .EmptyDL_Size
  68+ C13A 11 00 00                     LD   DE, 0                             ; offset 0 от FT_RAM_DL
  69+ C13D CD 9A 12                     CALL FT.WriteDL                        ; HL→RAM_DL+DE, OTIR блок
  70+ C140                              FT_WR_REG8 FT_REG_DLSWAP, FT_DLSWAP_FRAME
  70+ C140 3E 02       >                LD A, FT_DLSWAP_FRAME & 0xFF
  70+ C142 11 54 20    >                LD DE, FT_REG_DLSWAP & 0xFFFF
  70+ C145 CD 1B 12    >                CALL FT.WriteReg8
