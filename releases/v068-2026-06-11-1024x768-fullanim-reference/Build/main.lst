  65+ 6961             >                ifdef MAPPING_REGISTERS
  65+ 6961 32 12 04    >                LD (FMADDR_REGS + HIGH PAGE2), A
  65+ 6964             >                else
  65+ 6964 ~           >                LD (MemoryPages + 2), A
  65+ 6964 ~           >                LD BC, PAGE2
