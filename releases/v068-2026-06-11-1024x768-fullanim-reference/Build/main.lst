 214+ C171              .seed_have_sec:
 215+ C171 57                           LD   D, A
 215+ C172 5F             LD E, A                    ; DE = RTC sec (multiplier)
 216+ C173 2A 8E D3                     LD   HL, (VDC_LfsrSeed)
 217+ C176 7D                           LD   A, L                              ; A = low seed byte
 218+ C177 21 00 00                     LD   HL, 0
 219+ C17A 06 08                        LD   B, 8
 220+ C17C              .seed_mul:
