4436  79CB                              include "shared_render.asm"           ; DL-matrix + frog-render machinery used by gameplay (#04) AND level-select (#41); resident so neither needs to page-swap
# file opened: Source\ASM\shared_render.asm
   1+ 79CB              ; shared_render.asm — DL-matrix + frog-render machinery, HOISTED RESIDENT.
   2+ 79CB              ;
   3+ 79CB              ; These routines/tables/vars are used by BOTH gameplay (overlay #04) AND the
   4+ 79CB              ; level-select preview render (overlay #41). After the main1_play overlay split
   5+ 79CB              ; they MUST be resident (slot 1, always mapped) so either scene can call them
   6+ 79CB              ; without paging gymnastics. Moved verbatim from VDC.asm/Frog.asm/MainLoop.asm;
   7+ 79CB              ; names unchanged (module Core) so all existing references resolve untouched.
   8+ 79CB              ; (User decision 2026-05-27: keep render machinery global, split the rest.)
   9+ 79CB
  10+ 79CB              ; ===================== moved from VDC.asm =====================
  11+ 79CB              VDC_DivHLbyA:
  12+ 79CB 4F                           LD   C, A
  13+ 79CC AF                           XOR  A
  14+ 79CD 06 10                        LD   B, 16
  15+ 79CF              .dv_loop:
  16+ 79CF 29                           ADD  HL, HL
  17+ 79D0 17                           RLA
  18+ 79D1 B9                           CP   C
  19+ 79D2 38 02                        JR   C, .dv_skip
  20+ 79D4 91                           SUB  C
  21+ 79D5 2C                           INC  L                                 ; HL[0] был 0 после ADD, теперь 1
  22+ 79D6              .dv_skip:
  23+ 79D6 10 F7                        DJNZ .dv_loop
  24+ 79D8 C9                           RET
  25+ 79D9
  26+ 79D9              ; ============================================================================
  27+ 79D9              ; VDC_RandomColor — LFSR Galois 16-bit (poly 0xB400). Out: A = 0..NUM_COLORS-1.
  28+ 79D9              ; Распределение: используем (rand8 * NUM_COLORS) >> 8 вместо AND 7 + clamp,
  29+ 79D9              ; иначе в 6-цветовом случае colors 0/1 встречаются 2× чаще остальных
  30+ 79D9              ; (8 mod 6 = 2 → дубли 6→0 и 7→1). Mul/shift даёт ≤1.4% bias.
  31+ 79D9              ; ============================================================================
  32+ 79D9
  33+ 79D9              ; ===================== moved from Frog.asm =====================
  34+ 79D9              Frog_ComputeAngle:
  35+ 79D9                                ; dx = SmoothX - PosStartX
  36+ 79D9 2A 6D 7B                       LD   HL, (ZL_SmoothX)
  37+ 79DC ED 5B 33 7B                    LD   DE, (Frog_PosStartX)
  38+ 79E0 A7                             AND  A
  39+ 79E1 ED 52                          SBC  HL, DE
  40+ 79E3 06 00                          LD   B, 0                            ; flags: b0=dx<0, b1=dy<0, b2=swap
  41+ 79E5 CB 7C                          BIT  7, H
  42+ 79E7 28 09                          JR   Z, .dx_pos
  43+ 79E9 CB C0                          SET  0, B
  44+ 79EB 7C                             LD   A, H
  44+ 79EC 2F             CPL
  44+ 79ED 67             LD H, A
  45+ 79EE 7D                             LD   A, L
  45+ 79EF 2F             CPL
  45+ 79F0 6F             LD L, A
  46+ 79F1 23                             INC  HL
  47+ 79F2              .dx_pos:          ; Clamp |dx| до 255 (если H≠0 значит |dx|>255 → насыщать).  Без clamp
  48+ 79F2                                ; truncate (LD C, L) даёт 0x39=57 для dx=313=0x139, swap-логика
  49+ 79F2                                ; сходит с ума → frog дёргается у краёв экрана.  (Кредит: Gemini.)
  50+ 79F2 7C                             LD   A, H
  51+ 79F3 B7                             OR   A
  52+ 79F4 28 02                          JR   Z, .dx_clamped
  53+ 79F6 2E FF                          LD   L, 255
  54+ 79F8 4D           .dx_clamped:      LD   C, L                            ; C = |dx| (true 8-bit clamp)
  55+ 79F9                                ; dy = SmoothY - PosStartY
  56+ 79F9 2A 6F 7B                       LD   HL, (ZL_SmoothY)
  57+ 79FC ED 5B 35 7B                    LD   DE, (Frog_PosStartY)
  58+ 7A00 A7                             AND  A
  59+ 7A01 ED 52                          SBC  HL, DE
  60+ 7A03 CB 7C                          BIT  7, H
  61+ 7A05 28 09                          JR   Z, .dy_pos
  62+ 7A07 CB C8                          SET  1, B
  63+ 7A09 7C                             LD   A, H
  63+ 7A0A 2F             CPL
  63+ 7A0B 67             LD H, A
  64+ 7A0C 7D                             LD   A, L
  64+ 7A0D 2F             CPL
