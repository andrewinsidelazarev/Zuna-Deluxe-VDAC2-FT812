3422  5FAD FE 07                        CP   Core.VDC_NUM_COLORS + 1
3423  5FAF D8                           RET  C                                  ; 1..NUM_COLORS → ok
3424  5FB0 3E 06        .gcc_def:       LD   A, Core.VDC_NUM_COLORS
3425  5FB2 C9                           RET
