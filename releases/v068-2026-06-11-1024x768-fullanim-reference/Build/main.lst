1351+ CDCE DD 6E 00     .found:        LD   L, (IX + 0)                   ; HL = run.LBA lo16
1352+ CDD1 DD 66 01                     LD   H, (IX + 1)
1353+ CDD4 19                           ADD  HL, DE                        ; + N (offset within run)
1354+ CDD5 EB                           EX   DE, HL                        ; DE = LBA lo16 result
1355+ CDD6 DD 6E 02                     LD   L, (IX + 2)                   ; HL = run.LBA hi16
1356+ CDD9 DD 66 03                     LD   H, (IX + 3)
