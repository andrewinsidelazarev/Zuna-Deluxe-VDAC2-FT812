 184+ C495              ; ---------------------------------------------------------------------
 185+ C495              ; Loader-level helpers.
 186+ C495              ;
 187+ C495              ; ZUMALVL.PAK layout:
 188+ C495              ;   sec 0       header  (magic ZLVP, version, count, sector_size)
 189+ C495              ;   sec 1       TOC[22] × 20 B   (bg/pal/track/title/preview off+size)
 190+ C495              ;   sec 2..N    data blob, per-level: bg → pal → track → title → preview
 191+ C495
 192+ C495              ZIFI_BUFFER_PAGE EQU #03               ; spgbld page reserved for ZiFi 512-B buffer
