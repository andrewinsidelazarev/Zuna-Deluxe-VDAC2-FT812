2370  3ACD              ; Frog_FilteredRandomColor — RandomColor с фильтром цветов цепи.
2371  3ACD              ; Out: A = color (0..3), guaranteed to be present in VDC_Slots if chain non-empty.
2372  3ACD              ; Fallback: unfiltered random AND 3 если chain пуст или все retry'ы промахнулись.
2373  3ACD              ; Preserves: BC, DE, HL (стандартные slot-0 caller-saves).
2374  3ACD              ; ============================================================================
2375  3ACD              Frog_FilteredRandomColor:                              ; in A: 0xFF=force fresh; else=check & keep if in mask
2376  3ACD C5                           PUSH BC
2377  3ACE D5                           PUSH DE
2378  3ACF E5                           PUSH HL
2379  3AD0 47                           LD   B, A                              ; B = input color (0xFF=force fresh)
2380  3AD1                              ; --- Build mask in D from VDC_Slots[0..SlotsLen-1] ---
2381  3AD1 16 00                        LD   D, 0                              ; D = mask (bits 0..VDC_NUM_COLORS-1 = colors present)
2382  3AD3 3A 96 69                     LD   A, (Core.VDC_SlotsLen)
2383  3AD6 B7                           OR   A
2384  3AD7 CA 6D 3B                     JP   Z, .frc_fb_in                     ; empty chain → fallback (JP — JR диапазон превысился после exclude block)
2385  3ADA 4F                           LD   C, A
2386  3ADB 2A 3A D6                     LD   HL, (Core.VDC_pSlots)
2387  3ADE 7E           .frc_ml:        LD   A, (HL)
2388  3ADF 23                           INC  HL
2389  3AE0 FE 06                        CP   Core.VDC_NUM_COLORS
2390  3AE2 30 0C                        JR   NC, .frc_msk_skip                 ; GAP marker (>=NUM_COLORS) → skip
2391  3AE4 5F                           LD   E, A                              ; E = bit index
2392  3AE5 3E 01                        LD   A, 1
2393  3AE7 1C                           INC  E
2394  3AE8 1D           .frc_sh:        DEC  E
2395  3AE9 28 03                        JR   Z, .frc_sh_done
2396  3AEB 87                           ADD  A, A
2397  3AEC 18 FA                        JR   .frc_sh
2398  3AEE B2           .frc_sh_done:   OR   D
2399  3AEF 57                           LD   D, A
2400  3AF0 0D           .frc_msk_skip:  DEC  C
2401  3AF1 20 EB                        JR   NZ, .frc_ml
2402  3AF3                              ; --- Check input color B against mask D (skip if 0xFF) ---
2403  3AF3 78                           LD   A, B
2404  3AF4 FE 06                        CP   Core.VDC_NUM_COLORS
2405  3AF6 30 10                        JR   NC, .frc_pick_new                 ; B >= NUM_COLORS (including 0xFF) → force fresh
2406  3AF8 5F                           LD   E, A                              ; check bit B in mask
2407  3AF9 3E 01                        LD   A, 1
2408  3AFB 1C                           INC  E
2409  3AFC 1D           .frc_chsh:      DEC  E
2410  3AFD 28 03                        JR   Z, .frc_chsh_done
2411  3AFF 87                           ADD  A, A
2412  3B00 18 FA                        JR   .frc_chsh
2413  3B02 A2           .frc_chsh_done: AND  D
2414  3B03 28 03                        JR   Z, .frc_pick_new                  ; B not in mask → fresh
2415  3B05 78                           LD   A, B                              ; keep input color
2416  3B06 18 6D                        JR   .frc_exit
2417  3B08              .frc_pick_new:
2418  3B08                              ; --- Popcount mask D → B (число цветов в цепи) ---
2419  3B08 06 00                        LD   B, 0
2420  3B0A 1E 06                        LD   E, Core.VDC_NUM_COLORS            ; parametric (Gemini fix)
2421  3B0C 7A                           LD   A, D
2422  3B0D 0F           .frc_pc:        RRCA
2423  3B0E 30 01                        JR   NC, .frc_pc_skip
2424  3B10 04                           INC  B
2425  3B11 1D           .frc_pc_skip:   DEC  E
2426  3B12 20 F9                        JR   NZ, .frc_pc
2427  3B14                              ; --- Exclude bit (если popcount >= 3 и FROG_EXCLUDE_COLOR_ADDR valid) ---
2428  3B14 78                           LD   A, B
2429  3B15 FE 03                        CP   3
2430  3B17 38 1F                        JR   C, .frc_no_excl
2431  3B19 3A 8B 4C                     LD   A, (FROG_EXCLUDE_COLOR_ADDR)
2432  3B1C FE 06                        CP   Core.VDC_NUM_COLORS
2433  3B1E 30 13                        JR   NC, .frc_excl_reset               ; #FF / out-of-range → no excl, но reset
2434  3B20 5F                           LD   E, A
2435  3B21 3E 01                        LD   A, 1
2436  3B23 1C                           INC  E
2437  3B24 1D           .frc_xsh:       DEC  E
2438  3B25 28 03                        JR   Z, .frc_xsh_done
2439  3B27 87                           ADD  A, A
2440  3B28 18 FA                        JR   .frc_xsh
2441  3B2A 5F           .frc_xsh_done:  LD   E, A                              ; E = bit mask
2442  3B2B A2                           AND  D
2443  3B2C 28 05                        JR   Z, .frc_excl_reset                ; bit not в mask → skip
2444  3B2E 7B                           LD   A, E
2445  3B2F 2F                           CPL
2446  3B30 A2                           AND  D
2447  3B31 57                           LD   D, A                              ; mask -= bit
2448  3B32 05                           DEC  B                                  ; popcount--
2449  3B33              .frc_excl_reset:
2450  3B33 3E FF                        LD   A, #FF
2451  3B35 32 8B 4C                     LD   (FROG_EXCLUDE_COLOR_ADDR), A      ; consume — RefilterCurrent calls должны не unaffected
2452  3B38              .frc_no_excl:
2453  3B38 78                           LD   A, B
2454  3B39 B7                           OR   A
2455  3B3A 28 36                        JR   Z, .frc_fb                        ; mask empty → fallback
2456  3B3C                              ; --- pick index 0..B-1 via mul-then-shift: (rand8 * B) >> 8.
2457  3B3C                              ; Bias ≤ 1/(256/B) ≤ 1.6%. Старый `AND 3 + mod B` на 4-value
2458  3B3C                              ; источнике давал при popcount=3 LSB-цвету маски 50% vs 25% —
2459  3B3C                              ; визуально «слишком много <цвет-0-маски>» (purple bias).
2460  3B3C D5                           PUSH DE                                ; save D = mask (E irrelevant)
2461  3B3D C5                           PUSH BC                                ; save B = popcount
2462  3B3E CD AB 3B                     CALL VDC_Random8                       ; A = 0..255 uniform LFSR
2463  3B41 57                           LD   D, A                              ; D = rand (preserve)
2464  3B42                              ; --- Optional RTC mix into RAND BYTE (not seed!) every 128th NewNextColor ---
2465  3B42 21 8A 4C                     LD   HL, FROG_RTC_MIX_FLAG_ADDR
2466  3B45 7E                           LD   A, (HL)
2467  3B46 B7                           OR   A
2468  3B47 28 09                        JR   Z, .frc_no_rtc_mix
2469  3B49 36 00                        LD   (HL), 0                           ; consume flag
2470  3B4B D5                           PUSH DE
2471  3B4C CD 05 C3                     CALL Core.ReadRTCSeconds               ; A = 0..59 binary
2472  3B4F D1                           POP  DE                                 ; D = rand
2473  3B50 AA                           XOR  D                                  ; rand XOR RTC
2474  3B51 57                           LD   D, A
2475  3B52              .frc_no_rtc_mix:
2476  3B52 C1                           POP  BC                                 ; restore B = popcount
2477  3B53 58                           LD   E, B                              ; E = popcount
2478  3B54 CD 7C DA                     CALL Core.Frog_Mul8x8u                 ; HL = D*E (clobbers A,B,DE)
2479  3B57 D1                           POP  DE                                 ; restore D = mask
2480  3B58 4C                           LD   C, H                              ; C = (rand*B)>>8 = 0..B-1
2481  3B59                              ; --- Walk mask D LSB→MSB, return color of C-th set bit ---
2482  3B59 1E 00                        LD   E, 0                              ; E = current color index
2483  3B5B 7A           .frc_walk:      LD   A, D
2484  3B5C E6 01                        AND  #01
2485  3B5E 28 05                        JR   Z, .frc_walk_skip
2486  3B60 79                           LD   A, C
2487  3B61 B7                           OR   A
2488  3B62 28 06                        JR   Z, .frc_walk_found
2489  3B64 0D                           DEC  C
2490  3B65 CB 3A        .frc_walk_skip: SRL  D
2491  3B67 1C                           INC  E
2492  3B68 18 F1                        JR   .frc_walk
2493  3B6A              .frc_walk_found:
2494  3B6A 7B                           LD   A, E
2495  3B6B 18 08                        JR   .frc_exit
2496  3B6D              .frc_fb_in:     ; empty chain: keep input B if valid, else random unfiltered
2497  3B6D 78                           LD   A, B
2498  3B6E FE 06                        CP   Core.VDC_NUM_COLORS
2499  3B70 38 03                        JR   C, .frc_exit                      ; B < NUM_COLORS → keep
2500  3B72 CD 69 CF     .frc_fb:        CALL Core.VDC_RandomColor              ; уже выдаёт 0..NUM_COLORS-1
2501  3B75                              ; (убрана hardcoded AND 3 — Gemini fix; VDC_RandomColor сам маскирует)
2502  3B75 E1           .frc_exit:      POP  HL
2503  3B76 D1                           POP  DE
2504  3B77 C1                           POP  BC
2505  3B78 C9                           RET
2506  3B79
2507  3B79              ; Frog_RefilterCurrent — каждый кадр check BallColor/NextBallColor against
2508  3B79              ; chain mask; replace если color удалён cascade match-3.
2509  3B79              Frog_RefilterCurrent:
2510  3B79 3A A9 69                     LD   A, (Core.Frog_BallColor)
2511  3B7C CD CD 3A                     CALL Frog_FilteredRandomColor
2512  3B7F 32 A9 69                     LD   (Core.Frog_BallColor), A
2513  3B82 3A AA 69                     LD   A, (Core.Frog_NextBallColor)
2514  3B85 CD CD 3A                     CALL Frog_FilteredRandomColor
2515  3B88 32 AA 69                     LD   (Core.Frog_NextBallColor), A
2516  3B8B C9                           RET
2517  3B8C
2518  3B8C              ; Frog_NewNextColor — force fresh new NextBallColor (= после promote при start fire).
2519  3B8C              ; Counter mod 128: каждый 128-й вызов взводит FLAG, и следующий pick в
2520  3B8C              ; Frog_FilteredRandomColor XOR'ит RTC seconds в RAND BYTE (выход LFSR, не seed).
2521  3B8C              ; Это сохраняет цикл LFSR неприкосновенным (Gemini совет), но добавляет точечный
2522  3B8C              ; перетряс распределения раз в ~128 выстрелов.
2523  3B8C              Frog_NewNextColor:
2524  3B8C 21 89 4C                     LD   HL, FROG_RTC_MIX_CNT_ADDR
2525  3B8F 7E                           LD   A, (HL)
2526  3B90 3C                           INC  A
2527  3B91 E6 7F                        AND  #7F                              ; counter mod 128
2528  3B93 77                           LD   (HL), A
2529  3B94 B7                           OR   A
2530  3B95 20 05                        JR   NZ, .nnc_no_flag                 ; cnt != 0 → no boundary
2531  3B97 3E 01                        LD   A, 1
2532  3B99 32 8A 4C                     LD   (FROG_RTC_MIX_FLAG_ADDR), A      ; mark for picker to consume
2533  3B9C              .nnc_no_flag:
2534  3B9C                              ; Exclude BallColor from mask если popcount активных цветов >= 3.
2535  3B9C                              ; Юзер: «следующий шар лягушки» не должен совпадать с предыдущим
2536  3B9C                              ; (когда в цепи 3+ цветов; иначе чередование вынужденное).
2537  3B9C 3A A9 69                     LD   A, (Core.Frog_BallColor)
2538  3B9F 32 8B 4C                     LD   (FROG_EXCLUDE_COLOR_ADDR), A
2539  3BA2 3E FF                        LD   A, #FF                            ; sentinel: force fresh
2540  3BA4 CD CD 3A                     CALL Frog_FilteredRandomColor
2541  3BA7 32 AA 69                     LD   (Core.Frog_NextBallColor), A
2542  3BAA C9                           RET
2543  3BAB
2544  3BAB              ; ============================================================================
2545  3BAB              ; VDC_Random8 — LFSR Galois 16-bit (poly 0xB400), 8-bit uniform 0..255.
2546  3BAB              ; Тот же LFSR step что Core.VDC_RandomColor, но без AND-mask. Используется
2547  3BAB              ; Frog_FilteredRandomColor для unbiased mod-B через (rand * B) >> 8 — это
2548  3BAB              ; нужно когда popcount(mask) не степень двойки (B=3 в основном). Старый AND 3
2549  3BAB              ; + mod B давал bias 50%/25%/25% для popcount=3 → видимый перекос колора.
2550  3BAB              ; Разделяет Core.VDC_LfsrSeed с VDC_RandomColor (оба stepper'а двигают одну
2551  3BAB              ; и ту же последовательность атомарно — без корреляции).
2552  3BAB              ; ============================================================================
2553  3BAB              VDC_Random8:
2554  3BAB 2A 8E D3                     LD   HL, (Core.VDC_LfsrSeed)
2555  3BAE 7D                           LD   A, L
2556  3BAF E6 01                        AND  1
2557  3BB1 CB 3C                        SRL  H
2557  3BB3 CB 1D          RR L
2558  3BB5 30 0A                        JR   NC, .r8_no_xor
2559  3BB7 16 B4                        LD   D, #B4
2559  3BB9 1E 00          LD E, 0
2560  3BBB 7C                           LD   A, H
2560  3BBC AA             XOR D
2560  3BBD 67             LD H, A
2561  3BBE 7D                           LD   A, L
2561  3BBF AB             XOR E
2561  3BC0 6F             LD L, A
2562  3BC1              .r8_no_xor:
2563  3BC1 22 8E D3                     LD   (Core.VDC_LfsrSeed), HL
2564  3BC4 7D                           LD   A, L
2565  3BC5 AC                           XOR  H                                 ; 8-bit uniform
2566  3BC6 C9                           RET
2567  3BC7
2568  3BC7              ; ----------------------------------------------------------------------------
2569  3BC7              ; ZX7 Turbo decompressor (Einar Saukas / Urusergi). HL = compressed src,
2570  3BC7              ; DE = destination. Восстановлен из ~/Desktop/Zuma Deluxe (src/ASM,
2571  3BC7              ; zuma_new_spg.asm:4466). Размер ~62 байта. Не корраптит I, IX, IY.
2572  3BC7              ; Используется через UnpackZX7Page wrapper. На входе HL/DE должны указывать
2573  3BC7              ; в WRITABLE области (исходник можно в slot 2 ROM-like, dest в RAM).
2574  3BC7              ; ----------------------------------------------------------------------------
2575  3BC7              Dzx7Turbo:
2576  3BC7 3E 80                        LD   A, #80
2577  3BC9              .zx7_copy_byte_loop:
2578  3BC9 ED A0                        LDI
2579  3BCB              .zx7_main_loop:
2580  3BCB 87                           ADD  A, A
2581  3BCC CC 1C 3C                     CALL Z, .zx7_load_bits
2582  3BCF 30 F8                        JR   NC, .zx7_copy_byte_loop
2583  3BD1 D5                           PUSH DE
2584  3BD2 01 01 00                     LD   BC, 1
2585  3BD5 50                           LD   D, B
2586  3BD6              .zx7_len_size_loop:
2587  3BD6 14                           INC  D
2588  3BD7 87                           ADD  A, A
2589  3BD8 CC 1C 3C                     CALL Z, .zx7_load_bits
2590  3BDB 30 F9                        JR   NC, .zx7_len_size_loop
2591  3BDD C3 EA 3B                     JP   .zx7_len_value_start
2592  3BE0              .zx7_len_value_loop:
2593  3BE0 87                           ADD  A, A
2594  3BE1 CC 1C 3C                     CALL Z, .zx7_load_bits
2595  3BE4 CB 11                        RL   C
2596  3BE6 CB 10                        RL   B
2597  3BE8 38 2D                        JR   C, .zx7_exit
2598  3BEA              .zx7_len_value_start:
2599  3BEA 15                           DEC  D
2600  3BEB 20 F3                        JR   NZ, .zx7_len_value_loop
2601  3BED 03                           INC  BC
2602  3BEE 5E                           LD   E, (HL)
2603  3BEF 23                           INC  HL
2604  3BF0 CB 33                        DB   #CB, #33                          ; SLL E / SLS E (undoc)
2605  3BF2 30 1A                        JR   NC, .zx7_offset_end
2606  3BF4 87                           ADD  A, A
2607  3BF5 CC 1C 3C                     CALL Z, .zx7_load_bits
2608  3BF8 CB 12                        RL   D
2609  3BFA 87                           ADD  A, A
2610  3BFB CC 1C 3C                     CALL Z, .zx7_load_bits
2611  3BFE CB 12                        RL   D
2612  3C00 87                           ADD  A, A
2613  3C01 CC 1C 3C                     CALL Z, .zx7_load_bits
2614  3C04 CB 12                        RL   D
2615  3C06 87                           ADD  A, A
2616  3C07 CC 1C 3C                     CALL Z, .zx7_load_bits
2617  3C0A 3F                           CCF
2618  3C0B 38 01                        JR   C, .zx7_offset_end
2619  3C0D 14                           INC  D
2620  3C0E              .zx7_offset_end:
2621  3C0E CB 1B                        RR   E
2622  3C10 E3                           EX   (SP), HL
2623  3C11 E5                           PUSH HL
2624  3C12 ED 52                        SBC  HL, DE
2625  3C14 D1                           POP  DE
2626  3C15 ED B0                        LDIR
2627  3C17              .zx7_exit:
2628  3C17 E1                           POP  HL
2629  3C18 D2 CB 3B                     JP   NC, .zx7_main_loop
2630  3C1B C9                           RET
2631  3C1C              .zx7_load_bits:
2632  3C1C 7E                           LD   A, (HL)
2633  3C1D 23                           INC  HL
2634  3C1E 17                           RLA
2635  3C1F C9                           RET
2636  3C20
2637  3C20              ; ----------------------------------------------------------------------------
2638  3C20              ; SCRATCH_PAGE — свободная SPG page для decomp output. Используется
2639  3C20              ; UnpackAndUploadPage в Initialize между bg/balls/frog uploads.
2640  3C20              ; Page #01 не задействован ни одним Block в spgbld_vdac2.ini — безопасно.
2641  3C20              ; ----------------------------------------------------------------------------
2642  3C20              SCRATCH_PAGE    EQU #01
2643  3C20
2644  3C20              ; ----------------------------------------------------------------------------
2645  3C20              ; UnpackAndUploadPage: расжать compressed src page A → SCRATCH_PAGE,
2646  3C20              ; залить 16K из SCRATCH_PAGE в FT_RAM_G по адресу (Core.BgRamH:BgRamL),
2647  3C20              ; продвинуть указатель FT_RAM_G на +#4000.
2648  3C20              ;
2649  3C20              ; In:  A = compressed source SPG page; Core.BgRamH/L = FT_RAM_G dest 24-bit
2650  3C20              ; Out: Core.BgRamH/L advanced by 16K
2651  3C20              ; Slots after RET: slot 2 = src (not restored), slot 3 = current scene overlay
2652  3C20              ; (Core.CurrentCodePage). Restoring slot 3 here keeps dumps and any call-side code
2653  3C20              ; from observing the transient scratch page between compressed uploads.
2654  3C20              ; ----------------------------------------------------------------------------
2655  3C20              ; CurrentCodePage tracks which scene overlay is mapped in slot 3: #41 (UI =
2656  3C20              ; menu/level-select) or #04 (gameplay). The shared slot0 decompressors below use
2657  3C20              ; slot 3 as decomp scratch, then restore it to THIS page (not a hard-coded #04),
2658  3C20              ; so they are correct from any scene. Maintained by the resident Fade* transitions;
2659  3C20              ; boot default = UI overlay (first scene is the menu). Resident (slot 0/TSLib region).
2660  3C20 41           CurrentCodePage:  DB UI_OVL_PAGE
2661  3C21              UnpackAndUploadPage:
2662  3C21 F3                           DI
2663  3C22 32 75 3C                     LD   (.uaup_src), A
2664  3C25 ED 73 76 3C                  LD   (.uaup_saved_sp), SP
2665  3C29 31 B8 3C                     LD   SP, .uaup_temp_stack_top
2666  3C2C
2667  3C2C                              ; slot 2 = compressed src
2668  3C2C 3A 75 3C                     LD   A, (.uaup_src)
2668  3C2F 01 AF 12       LD BC, PAGE2
2668  3C32 ED 79          OUT (C), A
2669  3C34                              ; slot 3 = scratch (decomp dest)
2670  3C34 3E 01                        LD   A, SCRATCH_PAGE
2670  3C36 01 AF 13       LD BC, PAGE3
2670  3C39 ED 79          OUT (C), A
2671  3C3B
2672  3C3B                              ; Dzx7Turbo: HL=src, DE=dst
2673  3C3B 21 00 80                     LD   HL, #8000
2674  3C3E 11 00 C0                     LD   DE, #C000
2675  3C41 CD C7 3B                     CALL Dzx7Turbo
2676  3C44
2677  3C44                              ; FT.WriteMem(HL=#C000 in slot 3, BC=16384, A:DE=FT_RAM_G addr)
2678  3C44 21 00 C0                     LD   HL, #C000
2679  3C47 01 00 40                     LD   BC, 16384
2680  3C4A 3A 7F 65                     LD   A, (Core.BgRamH)
2681  3C4D ED 5B 7D 65                  LD   DE, (Core.BgRamL)
2682  3C51 CD 6A 12                     CALL FT.WriteMem
2683  3C54
2684  3C54                              ; Advance Core.BgRamL/H by 16K
2685  3C54 2A 7D 65                     LD   HL, (Core.BgRamL)
2686  3C57 11 00 40                     LD   DE, #4000
2687  3C5A 19                           ADD  HL, DE
2688  3C5B 22 7D 65                     LD   (Core.BgRamL), HL
2689  3C5E 30 07                        JR   NC, .uaup_no_carry
2690  3C60 3A 7F 65                     LD   A, (Core.BgRamH)
2690  3C63 3C             INC A
2690  3C64 32 7F 65       LD (Core.BgRamH), A
2691  3C67              .uaup_no_carry:
2692  3C67 3A 20 3C                     LD   A, (CurrentCodePage)
2692  3C6A 01 AF 13       LD BC, PAGE3
2692  3C6D ED 79          OUT (C), A   ; restore slot 3 = current scene overlay (#41 ui / #04 gameplay)
2693  3C6F ED 7B 76 3C                  LD   SP, (.uaup_saved_sp)
2694  3C73 FB                           EI
2695  3C74 C9                           RET
2696  3C75 00           .uaup_src:        DB 0
2697  3C76 00 00        .uaup_saved_sp:   DW 0
2698  3C78 00 00 00...  .uaup_temp_stack: DEFS 64
2699  3CB8              .uaup_temp_stack_top:
2700  3CB8
2701  3CB8              ; ----------------------------------------------------------------------------
2702  3CB8              ; UnpackZX7Page: расжать compressed page A → dest page B.
2703  3CB8              ; Source = slot 2 (#8000), dest = slot 3 (#C000). После RET слоты восстановлены:
2704  3CB8              ; slot 2 → page 6 (TrackData), slot 3 → page #04 (main1_play).
2705  3CB8              ; Stack пересажен на uzx7_temp_stack чтобы LDIR в slot 3 не зацепил наш стек.
2706  3CB8              ; ----------------------------------------------------------------------------
2707  3CB8              UnpackZX7Page:
2708  3CB8 F3                           DI
2709  3CB9 32 F5 3C                     LD   (.uzx7_src), A
2710  3CBC 78                           LD   A, B
2710  3CBD 32 F6 3C       LD (.uzx7_dst), A
2711  3CC0 ED 73 F7 3C                  LD   (.uzx7_saved_sp), SP
2712  3CC4 31 39 3D                     LD   SP, .uzx7_temp_stack_top
2713  3CC7 3A F5 3C                     LD   A, (.uzx7_src)
2713  3CCA 01 AF 12       LD BC, PAGE2
2713  3CCD ED 79          OUT (C), A
2714  3CCF 3A F6 3C                     LD   A, (.uzx7_dst)
2714  3CD2 01 AF 13       LD BC, PAGE3
2714  3CD5 ED 79          OUT (C), A
2715  3CD7 21 00 80                     LD   HL, #8000
