 495  17AC              ; ============================================================================
 496  17AC              ; DrawKillzoneDual — dual-pass kill-zone draw: hole (cell 0) под skull (cell N).
 497  17AC              ; Перенесён сюда из Core.MainLoop чтобы освободить байты Core (Core был
 498  17AC              ; 8189/8192). Должен вызываться внутри активного FT_Begin FT_BITMAPS блока.
 499  17AC              ;
 500  17AC              ; Координаты центра kill-zone — per-level setting (KZ_DEFAULT_X/Y).  Не из
 501  17AC              ; track end: track[N-1] не обязан попадать в визуальный центр sun-черепа в bg
 502  17AC              ; (cell-grid CELL_SIZE=32 ≠ pixel-aligned bg art).  Для level 1 (Spiral of Doom)
 503  17AC              ; центр bg-bbox золотых пикселей = (208, 217).
 504  17AC              ; ============================================================================
 505  17AC              KZ_DEFAULT_X       EQU 211
 506  17AC              KZ_DEFAULT_Y       EQU 217
 507  17AC              KZ_SPR_W           EQU 88                              ; atlas (layout) — НЕ масштабировать
 508  17AC              KZ_SPR_H           EQU 88
 509  17AC              KZ_SPR_DRAW        EQU 141                             ; 1024×768: экранный размер = round(88×8/5)
 510  17AC              KZ_SPR_HALF        EQU 70                              ; round(141/2) — центр draw-rect'а (scale-about-origin)
 511  17AC              FROG_DEFAULT_X     EQU 327
 512  17AC              FROG_DEFAULT_Y     EQU 231
 513  17AC
 514  17AC              ; Room transitions keep the old DL visible until it is fully covered by a
 515  17AC              ; black overlay. RAM_G can then be reloaded without exposing half-written art.
 516  17AC              FadeMenuToLevelSelect:
 517  17AC 21 94 C4                     LD   HL, Core.MenuBuildFrame
 518  17AF CD 2E 18                     CALL FadeOutRoom
 519  17B2                              ; First time only: the PAK sector map isn't built yet, so the
 520  17B2                              ; upcoming asset load runs the (slow) recursive search. Show
 521  17B2                              ; "LOADING LEVELS..." over the faded-out menu while it works.
 522  17B2                              ; Later transitions reuse the cached map -> near-instant, no message.
 523  17B2 3A 10 6C                     LD   A, (Core.LevelsMapLoaded)
 524  17B5 B7                           OR   A
 525  17B6 20 06                        JR   NZ, .skip_loading
 526  17B8 CD C1 17                     CALL UploadLoadingText                  ; залить баннер в RAM_G #084000 (меню погашено)
 527  17BB CD EA 62                     CALL Core.DrawLoadingLevelsScreen
 528  17BE              .skip_loading:
 529  17BE C3 F2 CD                     JP   Core.LevelSelect
 530  17C1
 531  17C1              ; UploadLoadingText — расжать «LOADING LEVELS...» (nativealien48 48px) в RAM_G
 532  17C1              ; #084000. Зона свободна в профиле level-select (#082658..#098000), поэтому баннер
 533  17C1              ; переживает медленный поиск PAK, пока кадр отрисован. Вызывать ДО DrawLoadingScreen.
 534  17C1              UploadLoadingText:
 535  17C1 21 00 40                     LD   HL, LOADING_TEXT_RAMG & 0xFFFF
 536  17C4 22 7D 65                     LD   (Core.BgRamL), HL
 537  17C7 3E 08                        LD   A, (LOADING_TEXT_RAMG >> 16) & 0xFF
 538  17C9 32 7F 65                     LD   (Core.BgRamH), A
 539  17CC 3E 25                        LD   A, LOADING_TEXT_PAGE_BASE
 540  17CE 06 03                        LD   B, LOADING_TEXT_NUM_PAGES
 541  17D0 C5           .ult_loop:      PUSH BC
 542  17D1 F5                           PUSH AF
 543  17D2 CD 21 3C                     CALL UnpackAndUploadPage                ; advances RAM_G +16K
 544  17D5 F1                           POP  AF
 545  17D6 3C                           INC  A
 546  17D7 C1                           POP  BC
 547  17D8 10 F6                        DJNZ .ult_loop
 548  17DA C9                           RET
