1074+ C6C1 70                           LD   (HL), B
1075+ C6C2
1076+ C6C2                              ; --- offsets[SlotsLen] = (SlotsLen>0) ? offsets[SlotsLen-1] : 0 ---
1077+ C6C2 3A 96 69                     LD   A, (VDC_SlotsLen)
