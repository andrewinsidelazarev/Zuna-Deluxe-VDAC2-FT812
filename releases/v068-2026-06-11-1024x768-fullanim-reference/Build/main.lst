  73+ C2DF                              include "sd_zc.asm"
# file opened: Source\ASM\sd_zc.asm
   1++C2DF              ;//////////////////////////////////////////////////////////////
   2++C2DF              ;//  Self-contained SD (Z-Controller) raw sector read.
   3++C2DF              ;//  Ported from the WC device driver DSDZC.ASM read path
   4++C2DF              ;//  (via Desktop/WC/Chkdsk/src/sd_zc.a80 by the ChkDsk session).
   5++C2DF              ;//  The card is already initialised by WC before the SPG launches
   6++C2DF              ;//  (hardware state persists), so we only issue CMD17 reads.
   7++C2DF              ;//
   8++C2DF              ;//  This BYPASSES the bundled TS-DOS driver, whose FAT chain walk
   9++C2DF              ;//  drifts -128 sectors at the first FAT-sector boundary in our SPG
  10++C2DF              ;//  context. We do our own BPB/FAT walk on top of sd_read_sector.
  11++C2DF              ;//
  12++C2DF              ;//  Unreal/this host uses BYTE addressing (sd_blkt = 0): the CMD17
  13++C2DF              ;//  argument is LBA*512. (Real SDHC would use block addressing.)
  14++C2DF              ;//////////////////////////////////////////////////////////////
  15++C2DF
  16++C2DF              SD_CONF         equ     #77             ; config / chip-select port
  17++C2DF              SD_DATA         equ     #57             ; data port
  18++C2DF              SD_CMD17        equ     %01000000+17    ; single-block read
  19++C2DF              SD_CS1          equ     %00000001       ; chip select, SD1
  20++C2DF
  21++C2DF              ;--- sd_init: byte addressing (Unreal). sd_blkt = 0.
  22++C2DF              sd_init:
  23++C2DF AF                           xor     a
  24++C2E0 32 0A C4                     ld      (sd_blkt),a
  25++C2E3 CD 59 C3                     call    sd_csh
  26++C2E6 CD B6 C3                     call    sd_snb
  27++C2E9 C9                           ret
  28++C2EA
  29++C2EA              ;--- sd_read_sector: read one 512-byte sector
  30++C2EA              ;    in:  HL = LBA (low 16), DE = LBA (high 16)  [LBA is 32-bit]
  31++C2EA              ;         IX = destination buffer (512 bytes)
  32++C2EA              ;    out: CF = 1 on error, CF = 0 on success
  33++C2EA              sd_read_sector:
  34++C2EA 22 06 C4                     ld      (sd_lba+0),hl
  35++C2ED ED 53 08 C4                  ld      (sd_lba+2),de
  36++C2F1 CD D4 C3                     call    sd_lba_in_range         ; защита: не слать CMD17 за пределы тома —
  37++C2F4 38 1E                        jr      c,.range                ; битый LBA иначе кирпичит реальную SDHC до переткивания
  38++C2F6 DD E5                        push    ix
  39++C2F8 E1                           pop     hl                      ; HL = buffer
  40++C2F9 CD 16 C3                     call    sd_cmd17
  41++C2FC 20 11                        jr      nz,.err                 ; R1 must be #00
  42++C2FE CD 98 C3                     call    sd_wait_token
  43++C301 38 0C                        jr      c,.err
  44++C303 CD 4F C3                     call    sd_reads                ; read 512 bytes -> (HL), HL += 512
  45++C306 DB 57                        in      a,(SD_DATA)             ; CRC16 lo (ignored)
  46++C308 DB 57                        in      a,(SD_DATA)             ; CRC16 hi (ignored)
  47++C30A CD 59 C3                     call    sd_csh
  48++C30D B7                           or      a                       ; CF=0
  49++C30E C9                           ret
  50++C30F CD 59 C3     .err            call    sd_csh
  51++C312 37                           scf
  52++C313 C9                           ret
  53++C314 37           .range          scf                             ; LBA вне тома — карту не трогаем вообще
  54++C315 C9                           ret
  55++C316
  56++C316              ;--- CMD17 (single-block read). Address from sd_lba.
  57++C316              ;    byte addressing (sd_blkt==0): argument = LBA*512 (byte offset).
  58++C316              ;    Preserves HL (caller's buffer pointer). Port of DSDZC CMDz.
  59++C316              sd_cmd17:
  60++C316 3E 51                        ld      a,SD_CMD17
  61++C318 CD 59 C3                     call    sd_csh
  62++C31B CD 6C C3                     call    sd_csl
  63++C31E E5                           push    hl                      ; preserve buffer pointer
  64++C31F ED 5B 06 C4                  ld      de,(sd_lba+0)           ; DE = LBA low16
  65++C323 ED 4B 08 C4                  ld      bc,(sd_lba+2)           ; BC = LBA high16
  66++C327 69                           ld      l,c
  67++C328 60                           ld      h,b                     ; HL = high16
  68++C329 4F                           ld      c,a                     ; C = command
  69++C32A 3A 0A C4                     ld      a,(sd_blkt)
  70++C32D B7                           or      a
  71++C32E 20 09                        jr      nz,.send                ; block addressing -> send LBA as-is
  72++C330                              ; byte addressing: [HL:DE] = LBA*512  (x2 then x256 byte-shift)
  73++C330 EB                           ex      de,hl
  73++C331 29             add hl,hl
  74++C332 EB                           ex      de,hl
  74++C333 ED 6A          adc hl,hl
  75++C335 65                           ld      h,l
  75++C336 6A             ld l,d
