 853+ C5D1              ; ============================================================================
 854+ C5D1              ; VDC_UpdateRtcElapsed — real-time game clock from RTC seconds.
 855+ C5D1              ;   Adds delta seconds with 0..59 wrap. Called only during PLAY; pause refreshes
 856+ C5D1              ;   VDC_RtcLastSecond without accumulating, so pause time is not counted.
 857+ C5D1              ; ============================================================================
 858+ C5D1              VDC_UpdateRtcElapsed:
 859+ C5D1                              ; ТОЛЬКО RTC. Если sec не поменялся — RET, ничего не добавляем.
 860+ C5D1                              ; Frame-fallback убран (был для эмуляторов с мёртвым RTC, но
 861+ C5D1                              ; после #EFF7 fix RTC всегда работает).
 862+ C5D1 CD 05 C3                     CALL ReadRTCSeconds                    ; A = current 0..59
 863+ C5D4 47                           LD   B, A                              ; B = current
 864+ C5D5 3A 7E D3                     LD   A, (VDC_RtcLastSecond)            ; A = old
 865+ C5D8 B8                           CP   B
 866+ C5D9 C8                           RET  Z                                 ; не поменялось → выходим
 867+ C5DA 4F                           LD   C, A                              ; C = old
 868+ C5DB 78                           LD   A, B                              ; A = current
 869+ C5DC B9                           CP   C
 870+ C5DD 30 02                        JR   NC, .rte_no_wrap
 871+ C5DF C6 3C                        ADD  A, 60                             ; wrap 59→0
 872+ C5E1 91           .rte_no_wrap:   SUB  C                                 ; A = delta 1..59
 873+ C5E2 5F                           LD   E, A
 873+ C5E3 16 00          LD D, 0
 874+ C5E5 2A A7 69                     LD   HL, (VDC_GameSeconds)
 875+ C5E8 19                           ADD  HL, DE
 876+ C5E9 22 A7 69                     LD   (VDC_GameSeconds), HL
 877+ C5EC 78                           LD   A, B
 878+ C5ED 32 7E D3                     LD   (VDC_RtcLastSecond), A
 879+ C5F0 C9                           RET
