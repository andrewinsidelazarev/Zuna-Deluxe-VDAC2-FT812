  62+ 7B90 ED 79          OUT (C), A
  63+ 7B92 01 F7 BF                     LD   BC, #BFF7
  63+ 7B95 3E 01          LD A, #01
  63+ 7B97 ED 79          OUT (C), A    ; сброс буфера PS/2
  64+ 7B99 01 F7 DF                     LD   BC, #DFF7
  64+ 7B9C 3E F0          LD A, #F0
  64+ 7B9E ED 79          OUT (C), A
  65+ 7BA0 01 F7 BF                     LD   BC, #BFF7
  65+ 7BA3 3E 02          LD A, #02
  65+ 7BA5 ED 79          OUT (C), A    ; PS/2 ON
  66+ 7BA7 C9                           RET
  67+ 7BA8
  68+ 7BA8              ; ----------------------------------------------------------------------------
  69+ 7BA8              ; Input_Scan — опросить ВСЕ источники за кадр: дренаж PS/2 FIFO (флаги клавиш) +
  70+ 7BA8              ; обновление состояния мыши. Вызывать раз за кадр в любой сцене.
  71+ 7BA8              ; Сначала заново включает Mr.Gluk (чтение RTC его гасит). Портит AF, BC, DE, HL.
  72+ 7BA8              ; ----------------------------------------------------------------------------
  73+ 7BA8              Input_Scan:
  74+ 7BA8 CD C7 15                     CALL Input.Mouse.UpdateMouseState          ; мышь — единая точка опроса здесь
  75+ 7BAB 01 F7 EF                     LD   BC, #EFF7
  75+ 7BAE 3E 80          LD A, #80
  75+ 7BB0 ED 79          OUT (C), A    ; заново enable (RTC мог погасить)
  76+ 7BB2 01 F7 DF                     LD   BC, #DFF7
  76+ 7BB5 3E F0          LD A, #F0
  76+ 7BB7 ED 79          OUT (C), A    ; выбрать регистр PS/2 FIFO
  77+ 7BB9 3E 18                        LD   A, 24
  77+ 7BBB 32 83 7B       LD (Input_DrainCnt), A        ; ограничить дренаж (без зависания на мусоре)
  78+ 7BBE 01 F7 BF                     LD   BC, #BFF7                             ; BC = порт данных (держим на весь цикл)
  79+ 7BC1 ED 78        .drain:         IN   A, (C)
  80+ 7BC3 B7                           OR   A
  80+ 7BC4 C8             RET Z                             ; 0 = FIFO пуст -> готово
  81+ 7BC5 FE FF                        CP   #FF
  81+ 7BC7 28 0B          JR Z, .next                     ; маркер переполнения -> пропустить
  82+ 7BC9 FE E0                        CP   #E0
  82+ 7BCB 28 07          JR Z, .next                     ; префикс extended -> игнор (коды уникальны)
  83+ 7BCD FE F0                        CP   #F0
  83+ 7BCF 28 0D          JR Z, .set_brk                  ; префикс break -> следующий код = отпускание
  84+ 7BD1 CD E5 7B                     CALL Input_SetKey
  85+ 7BD4 3A 83 7B     .next:          LD   A, (Input_DrainCnt)
