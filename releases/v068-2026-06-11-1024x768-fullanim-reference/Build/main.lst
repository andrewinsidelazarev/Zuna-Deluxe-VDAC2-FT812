1693+ F234 51           ZL_SpinK:       DEFB ZL_SPIN_K_DEFAULT                ; runtime spin multiplier (per-level)
1694+ F235 00           ZL_CmdDmaWordsHi: DEFB 0
1695+ F236 00           ZL_CmdDmaWordsLo: DEFB 0
1696+ F237 00 00        ZL_CmdBytes:    DEFW 0                                ; last FT812 RAM_CMD byte count before write
