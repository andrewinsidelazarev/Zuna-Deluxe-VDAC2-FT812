 524+ DCF7
 525+ DCF7              ; ----------------------------------------------------------------------------
 526+ DCF7              ; Frog_EmitFrogMatrix — emit T(61) · R(A) · T(-61) → setmatrix.
 527+ DCF7              ;   In: A = raw rotation byte (caller добавил offset под native face direction)
 528+ DCF7              ; Body native = SOUTH (вызывает с Frog_Angle + 192).
 529+ DCF7              ; Tongue native = NORTH (вызывает с Frog_Angle + 64).
 530+ DCF7              ; ----------------------------------------------------------------------------
 531+ DCF7              ; Frog_EmitFrogMatrix — эмитит ЗАПЕЧЁННУЮ BITMAP_TRANSFORM A..F (scale 0.6256
 532+ DCF7              ; + rotate вокруг центра, pivot 61). cmd_scale НЕ компонуется в цепочке
 533+ DCF7              ; translate+scale+rotate (cyan-кайма), поэтому матрицу строим напрямую как ball
 534+ DCF7              ; LUT. Математика валидирована в Source/OTHER/sim_frog_matrix.py (int=float ±0.22px):
 535+ DCF7              ;   A=E=(cos·323)>>8, B=(sin·323)>>8, D=-B  (cos/sin в *127 из Frog_SinTable)
 536+ DCF7              ;   C=15616-(cos+sin)·123, F=15616-(cos-sin)·123   (15616=61·256, 123≈61·256/127)
 537+ DCF7              ;   In: A = angle BRAD (caller добавил face-offset, как для cmd_rotate)
 538+ DCF7              ; ----------------------------------------------------------------------------
 539+ DCF7              Frog_EmitFrogMatrix:
 540+ DCF7 32 4D E0                       LD   (Frog_TmpRotByte), A
 541+ DCFA CD 30 DA                       CALL Frog_LookupSin                  ; sin127 (signed, 256-entry table)
 542+ DCFD 32 4E E0                       LD   (Frog_TmpSin), A
 543+ DD00 3A 4D E0                       LD   A, (Frog_TmpRotByte)
 544+ DD03 C6 40                          ADD  A, 64
 545+ DD05 CD 30 DA                       CALL Frog_LookupSin                  ; cos127 = sin(b+90°)
 546+ DD08 32 4F E0                       LD   (Frog_TmpCos), A
 547+ DD0B                                ; A (op #15) = (cos·323)>>8
 548+ DD0B 3A 4F E0                       LD   A, (Frog_TmpCos)
 549+ DD0E CD 66 DD                       CALL Frog_Mul323Sh8                  ; HL = scaled cos
 550+ DD11 22 51 E0                       LD   (Frog_TmpAE), HL
 551+ DD14 3E 15                          LD   A, #15
 552+ DD16 CD 7A DD                       CALL Frog_EmitX17
 553+ DD19                                ; B (op #16) = (sin·323)>>8
 554+ DD19 3A 4E E0                       LD   A, (Frog_TmpSin)
 555+ DD1C CD 66 DD                       CALL Frog_Mul323Sh8
 556+ DD1F 22 53 E0                       LD   (Frog_TmpB), HL
 557+ DD22 3E 16                          LD   A, #16
 558+ DD24 CD 7A DD                       CALL Frog_EmitX17
 559+ DD27                                ; C (op #17) = 15616 - (cos+sin)·123
 560+ DD27 3A 4E E0                       LD   A, (Frog_TmpSin)
 561+ DD2A CD 39 DA                       CALL Frog_SignExtendA_HL
 562+ DD2D EB                             EX   DE, HL                          ; DE = sin (signed16)
 563+ DD2E 3A 4F E0                       LD   A, (Frog_TmpCos)
 564+ DD31 CD 39 DA                       CALL Frog_SignExtendA_HL             ; HL = cos
 565+ DD34 19                             ADD  HL, DE                          ; HL = cos+sin
 566+ DD35 3E 17                          LD   A, #17
 567+ DD37 CD 87 DD                       CALL Frog_EmitCF
 568+ DD3A                                ; D (op #18) = -B
 569+ DD3A 2A 53 E0                       LD   HL, (Frog_TmpB)
 570+ DD3D 7D                             LD   A, L
 570+ DD3E 2F             CPL
 570+ DD3F 6F             LD L, A
 571+ DD40 7C                             LD   A, H
 571+ DD41 2F             CPL
 571+ DD42 67             LD H, A
 572+ DD43 23                             INC  HL                              ; HL = -B
 573+ DD44 3E 18                          LD   A, #18
 574+ DD46 CD 7A DD                       CALL Frog_EmitX17
 575+ DD49                                ; E (op #19) = A
 576+ DD49 2A 51 E0                       LD   HL, (Frog_TmpAE)
 577+ DD4C 3E 19                          LD   A, #19
 578+ DD4E CD 7A DD                       CALL Frog_EmitX17
 579+ DD51                                ; F (op #1A) = 15616 - (cos-sin)·123
 580+ DD51 3A 4E E0                       LD   A, (Frog_TmpSin)
 581+ DD54 CD 39 DA                       CALL Frog_SignExtendA_HL
 582+ DD57 EB                             EX   DE, HL                          ; DE = sin
 583+ DD58 3A 4F E0                       LD   A, (Frog_TmpCos)
 584+ DD5B CD 39 DA                       CALL Frog_SignExtendA_HL             ; HL = cos
 585+ DD5E A7                             AND  A
 586+ DD5F ED 52                          SBC  HL, DE                          ; HL = cos-sin
 587+ DD61 3E 1A                          LD   A, #1A
 588+ DD63 C3 87 DD                       JP   Frog_EmitCF
 589+ DD66
 590+ DD66              ; Frog_Mul323Sh8 — In A=signed(-127..127), Out HL=signed A·1.25 = A+(A asr 2).
 591+ DD66              ; scale 0.617 (валидировано sim_frog_matrix.py; ~1px по краю атласа, прозрачно).
 592+ DD66 6F           Frog_Mul323Sh8:   LD   L, A
 592+ DD67 26 00          LD H, 0
 593+ DD69 CB 7F                          BIT  7, A
 593+ DD6B 28 01          JR Z, .p
 594+ DD6D 25                             DEC  H                               ; sign-extend (H=0xFF)
 595+ DD6E 54           .p:               LD   D, H
 595+ DD6F 5D             LD E, L                  ; DE = sext(A)
 596+ DD70 CB 2C                          SRA  H
 596+ DD72 CB 1D          RR L
 597+ DD74 CB 2C                          SRA  H
 597+ DD76 CB 1D          RR L                        ; HL = A asr 2
 598+ DD78 19                             ADD  HL, DE                          ; A + A/4 = A·1.25
 599+ DD79 C9                             RET
 600+ DD7A
 601+ DD7A              ; Frog_EmitX17 — In A=opcode, HL=signed value → append (op<<24)|(val&0x1FFFF).
 602+ DD7A 47           Frog_EmitX17:     LD   B, A
 603+ DD7B 0E 00                          LD   C, 0
 604+ DD7D CB 7C                          BIT  7, H
 604+ DD7F 28 02          JR Z, .x17p
 605+ DD81 0E 01                          LD   C, 1                            ; bit16 = sign
 606+ DD83 EB           .x17p:            EX   DE, HL                          ; DE = value low16
 607+ DD84 C3 EB 13                       JP   FT.Coprocessor.Command_BCDE
 608+ DD87
 609+ DD87              ; Frog_EmitCF — In A=opcode, HL=(cos±sin) signed → C24 = 15616 - HL·123, append.
 610+ DD87 32 50 E0     Frog_EmitCF:      LD   (Frog_TmpOp), A
 611+ DD8A CD A3 DD                       CALL Frog_Mul123                     ; HL = HL·123
 612+ DD8D 7C                             LD   A, H
 612+ DD8E 87             ADD A, A
 612+ DD8F 9F             SBC A, A      ; A = sign byte of HL (0x00/0xFF)
 613+ DD90 47                             LD   B, A                            ; B = sext byte
 614+ DD91 AF                             XOR  A
 614+ DD92 95             SUB L
 614+ DD93 5F             LD E, A             ; byte0 = 0-L, CF=borrow0
 615+ DD94 3E 3D                          LD   A, #3D
 615+ DD96 9C             SBC A, H
 615+ DD97 57             LD D, A     ; byte1 = 0x3D - H - borrow0
 616+ DD98 3E 00                          LD   A, #00
 616+ DD9A 98             SBC A, B
 616+ DD9B 4F             LD C, A     ; byte2 = 0 - sext - borrow1
 617+ DD9C 3A 50 E0                       LD   A, (Frog_TmpOp)
 617+ DD9F 47             LD B, A       ; B = opcode
 618+ DDA0 C3 EB 13                       JP   FT.Coprocessor.Command_BCDE     ; word = op<<24 | byte2<<16 | byte1<<8 | byte0
 619+ DDA3
 620+ DDA3              ; Frog_Mul123 — In HL=signed, Out HL=HL·123 (= 128·HL - 5·HL).
 621+ DDA3 54           Frog_Mul123:      LD   D, H
 621+ DDA4 5D             LD E, L                  ; DE = x
 622+ DDA5 29                             ADD  HL, HL
 622+ DDA6 29             ADD HL, HL             ; 4x
 623+ DDA7 19                             ADD  HL, DE                          ; 5x
 624+ DDA8 EB                             EX   DE, HL                          ; DE = 5x, HL = x
 625+ DDA9 29                             ADD  HL, HL
 625+ DDAA 29             ADD HL, HL
 625+ DDAB 29             ADD HL, HL
 626+ DDAC 29                             ADD  HL, HL
 626+ DDAD 29             ADD HL, HL
 626+ DDAE 29             ADD HL, HL
 626+ DDAF 29             ADD HL, HL  ; 128x
 627+ DDB0 A7                             AND  A
 627+ DDB1 ED 52          SBC HL, DE                  ; 128x - 5x = 123x
 628+ DDB3 C9                             RET
 629+ DDB4
 630+ DDB4              ; Frog_EmitUpscale16 — append cmd_scale(1.6, 1.6). Один экземпляр, зовут
 631+ DDB4              ; body/overlay/tongue/plate. C/F пивота в матрице остаются корректны т.к.
 632+ DDB4              ; s·(draw/2) = atlas/2 (см. учебник §15.6).
 633+ DDB4              Frog_EmitUpscale16:
 634+ DDB4 11 28 FF                       LD   DE, FT_CMD_SCALE & #FFFF
 635+ DDB7 01 FF FF                       LD   BC, (FT_CMD_SCALE >> 16) & #FFFF
 636+ DDBA CD EB 13                       CALL FT.Coprocessor.Command_BCDE
 637+ DDBD 11 9A 99                       LD   DE, FROG_UPSCALE & #FFFF
 638+ DDC0 01 01 00                       LD   BC, (FROG_UPSCALE >> 16) & #FFFF
 639+ DDC3 CD EB 13                       CALL FT.Coprocessor.Command_BCDE
 640+ DDC6 11 9A 99                       LD   DE, FROG_UPSCALE & #FFFF
 641+ DDC9 01 01 00                       LD   BC, (FROG_UPSCALE >> 16) & #FFFF
 642+ DDCC C3 EB 13                       JP   FT.Coprocessor.Command_BCDE
 643+ DDCF
 644+ DDCF
 645+ DDCF              ; ----------------------------------------------------------------------------
 646+ DDCF              ; Frog_EmitRotateRaw — append cmd_rotate(A) without face-direction offset.
 647+ DDCF              ; (ZL_EmitRotate в MainLoop делает +192 для chain — нам нужно raw.)
 648+ DDCF              ; ----------------------------------------------------------------------------
 649+ DDCF              ; [Frog_EmitRotateRaw -> moved to shared_render.asm (resident; shared by gameplay #04 + level-select #41)]
 650+ DDCF              Frog_EmitVertex2f_PosCentered:
 651+ DDCF 2A 55 E0                       LD   HL, (Frog_PosX)
 652+ DDD2 11 62 00                       LD   DE, FROG_SPR_SCR_HALF            ; центр draw-rect'а 195px (1024×768)
 653+ DDD5 A7                             AND  A
 654+ DDD6 ED 52                          SBC  HL, DE
 655+ DDD8 29                             ADD  HL, HL
 655+ DDD9 29             ADD HL, HL
 656+ DDDA 29                             ADD  HL, HL
 656+ DDDB 29             ADD HL, HL
 657+ DDDC 44                             LD   B, H
