 177+ 6A63              ; Loader diagnostics — RESIDENT so an F12 dump (which captures slot 1 = Core, not
 178+ 6A63              ; the loader overlay page) shows how far a load got. The overlay loader writes
 179+ 6A63              ; them while slot 1 is mapped. Read these in a dump to bisect a failed load:
 180+ 6A63              ;   ZiFi_GpDbgStep : 0=not started, 1=Init, 2=PakOpen, 3=PakReadToc,
 181+ 6A63              ;                    #34=bg SD done, #35=track SD done, 6=success;
 182+ 6A63              ;                    #FF=Init err, #FE=PakOpen err, #FD=PakReadToc err.
 183+ 6A63              ;   ZiFi_DbgGamesA : RawPak_OpenRoot granular step —
 184+ 6A63              ;                    #20 entry, #21 BPB read OK, #22 BPB valid, #26 search start,
 185+ 6A63              ;                    #25 PAK found; #A1 BPB CMD17 err, #A2 bps!=512, #A3 spc=0,
 186+ 6A63              ;                    #A6 PAK not found anywhere, #A7 run-table overflow.
 187+ 6A63              ;   ZiFi_DbgGamesFound : directories visited during the recursive search.
 188+ 6A63 00           ZiFi_GpDbgStep:     DEFB 0
 189+ 6A64 00 00        ZiFi_GpDbgBgOff:    DEFW 0
 190+ 6A66 00 00        ZiFi_GpDbgBgSize:   DEFW 0
