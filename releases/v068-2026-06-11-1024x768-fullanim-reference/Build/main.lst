  78+ C158                              ; --- 7. Переключить видеовыход TS-Conf → FT812 -----------
  79+ C158                              ; VID_FT812 (#04) = bit 2 FT_EN — выход через VDAC2.
  80+ C158                              ; VID_NOGFX (#20) = bit 5 NO_GFX — отключить TS-Conf gfx
  81+ C158                              ; (освобождает 448 DMA-циклов/строку для FT-передач).
  82+ C158                              Video_Setting VID_FT812 | VID_NOGFX
  82+ C158             >                ifdef MAPPING_REGISTERS
  82+ C158 21 00 04    >                LD HL, FMADDR_REGS + HIGH VCONFIG
  82+ C15B 36 24       >                LD (HL), VID_FT812 | VID_NOGFX & 0xFF
  82+ C15D             >                else
  82+ C15D ~           >                LD A, Value? & 0xFF
  82+ C15D ~           >                LD BC, VCONFIG
  82+ C15D ~           >                OUT (C), A
  82+ C15D             >                endif
  83+ C15D
  84+ C15D                              ; Успех
  85+ C15D AF                           XOR  A                                ; A=0, Z=1
  86+ C15E C9                           RET
  87+ C15F
  88+ C15F              .no_vdac2:      ; VDAC2 не обнаружен. Возвращаем NZ — пусть caller решает
  89+ C15F                              ; (fallback на оригинальный TS-Conf рендер 360×288 или Halt).
  90+ C15F 3E 01                        LD   A, 1
  91+ C161 B7                           OR   A                                ; Z=0
  92+ C162 C9                           RET
