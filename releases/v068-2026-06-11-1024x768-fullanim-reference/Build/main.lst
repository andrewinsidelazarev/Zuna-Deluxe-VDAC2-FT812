1486+ F12B              ; ----------------------------------------------------------------------------
1487+ F12B              ; ZL_Mul16x8 — unsigned 16x8 multiply, low 16 bits of result.
1488+ F12B              ;   In:  HL = multiplicand (unsigned 16-bit), A = multiplier (unsigned 8-bit)
1489+ F12B              ;   Out: HL = (HL_in * A_in) & #FFFF
1490+ F12B              ;   Scratch: BC, A, F. ~14 байт, ~155 t-states avg.
1491+ F12B              ;   Используется для runtime K в spin formula (по 1 вызову на шар цепи).
1492+ F12B              ; ----------------------------------------------------------------------------
1493+ F12B 4D           ZL_Mul16x8:     LD   C, L
1493+ F12C 44             LD B, H                   ; BC = multiplicand
1494+ F12D 21 00 00                     LD   HL, 0                             ; HL = accumulator
1495+ F130 16 08                        LD   D, 8                             ; bit counter
1496+ F132 29           .lp:            ADD  HL, HL                            ; HL <<= 1
1497+ F133 87                           ADD  A, A                             ; CF = top bit of multiplier
1498+ F134 30 01                        JR   NC, .skip
1499+ F136 09                           ADD  HL, BC                            ; if bit set → +BC
1500+ F137 15           .skip:          DEC  D
1501+ F138 20 F8                        JR   NZ, .lp
1502+ F13A C9                           RET
1503+ F13B
1504+ F13B              ; ----------------------------------------------------------------------------
1505+ F13B              ; ZL_SpinPhase — A = ((t * ZL_SPIN_K_DEFAULT) >> 8) & ZL_SPIN_MASK.
1506+ F13B              ;   In: HL = VDC_LastT. Out: A = spin phase. Scratch: BC, DE, HL, AF.
1507+ F13B              ;   Current ARGB4 build has K=81, so avoid the 8-iteration generic multiply in
1508+ F13B              ;   the per-ball render hot path. If compile-time K changes, fall back safely.
1509+ F13B              ; ----------------------------------------------------------------------------
1510+ F13B              ZL_SpinPhase:
1511+ F13B                              if ZL_SPIN_K_DEFAULT = 81
1512+ F13B 54                           LD   D, H
1512+ F13C 5D             LD E, L                    ; DE = t
1513+ F13D 29                           ADD  HL, HL
1514+ F13E 29                           ADD  HL, HL
1515+ F13F 29                           ADD  HL, HL
1516+ F140 29                           ADD  HL, HL                            ; HL = t * 16
1517+ F141 44                           LD   B, H
1517+ F142 4D             LD C, L                    ; BC = t * 16
1518+ F143 29                           ADD  HL, HL
1519+ F144 29                           ADD  HL, HL                            ; HL = t * 64
1520+ F145 09                           ADD  HL, BC                            ; HL = t * 80
1521+ F146 19                           ADD  HL, DE                            ; HL = t * 81
1522+ F147 7C                           LD   A, H
1523+ F148 E6 0F                        AND  ZL_SPIN_MASK
1524+ F14A C9                           RET
1525+ F14B                              else
1526+ F14B ~                            LD   A, (ZL_SpinK)
1527+ F14B ~                            CALL ZL_Mul16x8
1528+ F14B ~                            LD   A, H
1529+ F14B ~                            AND  ZL_SPIN_MASK
1530+ F14B ~                            RET
1531+ F14B                              endif
