 931+ C621              ; ============================================================================
 932+ C621              ; VDC_SlotPos — для A=i возвращает центр шара (X,Y) из TrackData[t].
 933+ C621              ;   Out: BC = X (signed word), DE = Y (signed word), CF = 0 если рисуем,
 934+ C621              ;        CF = 1 если skip (gap или t<0).
 935+ C621              ;   AF, HL clobber.
 936+ C621              ;
 937+ C621              ; VDC_SlotPosAllowGap — тот же расчёт но БЕЗ gap-skip. Используется для
 938+ C621              ; gap-bonus tracking (нужна позиция самой gap-ячейки чтобы померить distance
 939+ C621              ; bullet'а до пустоты в цепи).
 940+ C621              ; ============================================================================
 941+ C621              VDC_SlotPos:
 942+ C621                              ; --- skip if gap ---
 943+ C621 4F                           LD   C, A
 944+ C622 26 00                        LD   H, 0
 944+ C624 6F             LD L, A
 945+ C625 ED 5B 3A D6                  LD   DE, (VDC_pSlots)
 946+ C629 19                           ADD  HL, DE
 947+ C62A 7E                           LD   A, (HL)
 948+ C62B FE 06                        CP   VDC_NUM_COLORS
 949+ C62D 38 02                        JR   C, .not_gap
 950+ C62F 37                           SCF                                    ; CF=1, skip
 951+ C630 C9                           RET
 952+ C631              .not_gap:
 953+ C631 79                           LD   A, C
 954+ C632              VDC_SlotPosAllowGap:
 955+ C632                              ; entry без gap-skip. Caller обязан передать A=i.
 956+ C632 CD F1 C5                     CALL VDC_SlotT                         ; HL = t
 957+ C635                              ; t < 0 → skip
 958+ C635 CB 7C                        BIT  7, H
 959+ C637 28 02                        JR   Z, .t_nonneg
 960+ C639 37                           SCF
 961+ C63A C9                           RET
 962+ C63B              .t_nonneg:
 963+ C63B                              ; t >= NumSamples → clamp to NumSamples-1
 964+ C63B E5                           PUSH HL
 965+ C63C ED 5B 00 80                  LD   DE, (TrackData)                   ; NumSamples
 966+ C640 A7                           AND  A
 967+ C641 ED 52                        SBC  HL, DE
 968+ C643 E1                           POP  HL
 969+ C644 38 04                        JR   C, .t_in
 970+ C646 2A 00 80                     LD   HL, (TrackData)
 971+ C649 2B                           DEC  HL
 972+ C64A              .t_in:          ; HL = t (clamped). Read the sample via a Core-resident helper
 973+ C64A                              ; (2-page track split lives there) so this hot path stays tiny —
 974+ C64A                              ; Main1/slot3 is nearly full. Core is always mapped in slot 1, so
 975+ C64A                              ; the tail-call resolves at runtime. Helper: out BC=X, DE=Y, CF=0,
 976+ C64A                              ; sets VDC_LastT / VDC_LastTangent.
 977+ C64A C3 31 69                     JP   VDC_ReadSampleAtHL
