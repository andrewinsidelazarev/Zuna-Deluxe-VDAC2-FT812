1247+ CCFB E6 7F                        AND  127
1248+ CCFD C2 91 CC                     JP   NZ, .enter                  ; no -> FatPtr already points to the entry
1249+ CD00 DD E5                        PUSH IX                          ; yes -> reload FatPtr for the new FAT sector
1250+ CD02 CD 55 CD                     CALL RawPak_FatEntryPtr
1251+ CD05 DD E1                        POP  IX
1252+ CD07 DA 53 CD                     JP   C, .fail
1253+ CD0A 22 D9 D0                     LD   (RawPak_FatPtr), HL
1254+ CD0D C3 91 CC                     JP   .enter
1255+ CD10              .jump:         ; --- fragmentation: close current run, open a new one at NextClus ---
1256+ CD10 3A DB D0                     LD   A, (RawPak_RunCount)
1257+ CD13 FE 80                        CP   RAWPAK_RUN_MAX
1258+ CD15 D2 53 CD                     JP   NC, .fail                   ; too fragmented -> open fails -> L1 fallback
1259+ CD18 3C                           INC  A
1260+ CD19 32 DB D0                     LD   (RawPak_RunCount), A
1261+ CD1C 11 06 00                     LD   DE, 6
1262+ CD1F DD 19                        ADD  IX, DE
1263+ CD21 21 D5 D0                     LD   HL, RawPak_NextClus
1264+ CD24 11 C9 CE                     LD   DE, RawPak_CurClus
1265+ CD27 CD 05 CE                     CALL RawPak_Copy32               ; CurClus = NextClus
1266+ CD2A CD 2E CB                     CALL RawPak_CurrentLbaRegs       ; LBA of new cluster (CurSecInClus = 0)
1267+ CD2D DD 75 00                     LD   (IX + 0), L
1268+ CD30 DD 74 01                     LD   (IX + 1), H
1269+ CD33 DD 73 02                     LD   (IX + 2), E
1270+ CD36 DD 72 03                     LD   (IX + 3), D
1271+ CD39 DD 36 04 00                  LD   (IX + 4), 0
1272+ CD3D DD 36 05 00                  LD   (IX + 5), 0
1273+ CD41 DD E5                        PUSH IX
1274+ CD43 CD 55 CD                     CALL RawPak_FatEntryPtr
1275+ CD46 DD E1                        POP  IX
1276+ CD48 DA 53 CD                     JP   C, .fail
1277+ CD4B 22 D9 D0                     LD   (RawPak_FatPtr), HL
1278+ CD4E C3 91 CC                     JP   .enter
1279+ CD51 37           .done:         SCF
1280+ CD52 C9                           RET
