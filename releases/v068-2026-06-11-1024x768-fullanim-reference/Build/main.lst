1910+ CB51 CD 6C CC                     CALL VDC_HsaDec                        ; HSA-- если >0
1911+ CB54
1912+ CB54                              ; offsets[0..K-1] = min(off[j]+CS, CS) — head compensation
1913+ CB54 3A 86 D3                     LD   A, (VDC_TmpGapIdx)
