 110+ C43A 32 10 04    >                LD (FMADDR_REGS + HIGH PAGE0), A
 110+ C43D             >                else
 110+ C43D ~           >                LD (MemoryPages + 0), A
 110+ C43D ~           >                LD BC, PAGE0
 110+ C43D ~           >                OUT (C), A
 110+ C43D             >                endif
 111+ C43D FB                           EI
 112+ C43E C9                           RET
