 490+ C742 DD 7E 14                     LD   A, (IX + 20)
 490+ C745 32 CF CE       LD (RawPak_Tmp + 2), A
 491+ C748 DD 7E 15                     LD   A, (IX + 21)
 491+ C74B 32 D0 CE       LD (RawPak_Tmp + 3), A
 492+ C74E 21 CD CE                     LD   HL, RawPak_Tmp
 493+ C751 CD 23 C9                     CALL RawPak_DirStackPush        ; push subdir (silently dropped if stack full)
 494+ C754 AF           .skip:         XOR  A
 495+ C755 32 B4 CE                     LD   (RawPak_HaveLfn), A
 496+ C758 11 20 00     .next:         LD   DE, 32
 497+ C75B DD 19                        ADD  IX, DE
 498+ C75D DD E5                        PUSH IX                          ; sector holds 16 entries (#8000..#81FF)
 499+ C75F E1                           POP  HL
 500+ C760 7C                           LD   A, H
 501+ C761 FE 82                        CP   #82
 502+ C763 DA C2 C6                     JP   C, .entry                  ; still inside this 512-byte sector
 503+ C766 CD 81 CA                     CALL RawPak_AdvanceOne          ; next dir sector; CF=1 = end of chain
 504+ C769 D2 B5 C6                     JP   NC, .sec
 505+ C76C C3 A1 C6                     JP   .popLoop                   ; this directory exhausted -> next dir
 506+ C76F C3 A1 C6     .dirDone:      JP   .popLoop
 507+ C772 CD A9 C9     .lfnFrag:      CALL RawPak_StoreLfn
 508+ C775 18 E1                        JR   .next
 509+ C777 B7           .notFound:     OR   A
 510+ C778 C9                           RET
 511+ C779
 512+ C779              ; Try the active Wild Commander panel path stored in page #F7:
 513+ C779              ;   #F7:#1000 left path, #F7:#2000 right path, #F7:#1FFC active marker.
 514+ C779              ; Path format is "N:\dir\subdir\#FF". We ignore N for raw SD access, but keep it
 515+ C779              ; for diagnostics and validate the prefix before walking the FAT tree.
 516+ C779              ; Out: CF=1 found ZUMALVL.PAK in that directory (RawPak_FileStartClus set).
 517+ C779              ;      CF=0 if WC path is absent/stale or the file is not there.
 518+ C779              RawPak_TryWcPath:
 519+ C779 AF                           XOR  A
