3840  64C4              WinAwardTimeBonus:
3841  64C4 CD F4 5F                     CALL GetCurrentPartime
3842  64C7 47                           LD   B, A                                ; B = par time seconds
3843  64C8 2A A7 69                     LD   HL, (VDC_GameSeconds)
3844  64CB 7C                           LD   A, H
3845  64CC B7                           OR   A
3846  64CD C0                           RET  NZ                                  ; over 255 sec: no byte-sized bonus
3847  64CE 7D                           LD   A, L
3848  64CF B8                           CP   B
3849  64D0 D0                           RET  NC                                  ; elapsed >= par
3850  64D1 78                           LD   A, B
3851  64D2 95                           SUB  L                                   ; remaining seconds
3852  64D3 47                           LD   B, A
3853  64D4 21 00 00                     LD   HL, 0
3854  64D7 11 64 00                     LD   DE, 100
3855  64DA 19           .bonus_loop:    ADD  HL, DE
3856  64DB 10 FD                        DJNZ .bonus_loop
3857  64DD CD 32 32                     CALL Score_Add24                       ; HL=ace-time bonus; 24-bit score += HL + extra-life
3858  64E0 C9                           RET
3859  64E1
3860  64E1              VDC_AwardGapBonusSlot0:
3861  64E1 3A 7A D3                     LD   A, (VDC_BulletGapMinDist)
3862  64E4 FE 19                        CP   VDC_GAP_HIT_THR + 1
3863  64E6 30 5B                        JR   NC, .no_gap                         ; > THR -> matched, but not through a gap
3864  64E8 21 7B D3                     LD   HL, VDC_BulletGapCount
3865  64EB 34                           INC  (HL)
3866  64EC                              ; Ported HD-ref shape:
3867  64EC                              ; points = 500 * (GAP_MAX - distance) / GAP_MAX, clamp >= 10.
3868  64EC                              ; In this port distance is Manhattan distance to the nearest GAP slot.
3869  64EC 47                           LD   B, A                                ; B = distance
3870  64ED 3E 20                        LD   A, VDC_GAP_MAX
3871  64EF 90                           SUB  B                                   ; A = GAP_MAX - distance
3872  64F0 47                           LD   B, A
3873  64F1 21 00 00                     LD   HL, 0
3874  64F4 11 F4 01                     LD   DE, 500
3875  64F7 19           .mul500:        ADD  HL, DE
3876  64F8 10 FD                        DJNZ .mul500
3877  64FA 3E 20                        LD   A, VDC_GAP_MAX
3878  64FC CD CB 79                     CALL VDC_DivHLbyA
3879  64FF 7C                           LD   A, H
3880  6500 B7                           OR   A
3881  6501 20 08                        JR   NZ, .have_bonus
3882  6503 7D                           LD   A, L
3883  6504 FE 0A                        CP   10
3884  6506 30 03                        JR   NC, .have_bonus
3885  6508 21 0A 00                     LD   HL, 10
3886  650B 3A 7B D3     .have_bonus:    LD   A, (VDC_BulletGapCount)
3887  650E FE 02                        CP   2
3888  6510 38 01                        JR   C, .have_final
3889  6512 29                           ADD  HL, HL                              ; consecutive gap bonus x2
3890  6513 E5           .have_final:    PUSH HL
3891  6514 3E 1C                        LD   A, SND_GAPBONUS1
3892  6516 CD 2E 6B                     CALL GS_PlaySfx
3893  6519 E1                           POP  HL
3894  651A E5                           PUSH HL
3895  651B CD 32 32                     CALL Score_Add24                       ; HL=gap bonus; 24-bit score += HL + extra-life
3896  651E E1                           POP  HL
3897  651F ED 5B 9E 69                  LD   DE, (VDC_GaugeScore)
3898  6523 19                           ADD  HL, DE
3899  6524 22 9E 69                     LD   (VDC_GaugeScore), HL
3900  6527 CD 91 5F                     CALL GetCurrentTargetScore             ; DE = per-level target (clobbers HL)
3901  652A 2A 9E 69                     LD   HL, (VDC_GaugeScore)               ; reload score before compare
3902  652D A7                           AND  A
3903  652E ED 52                        SBC  HL, DE
3904  6530 38 10                        JR   C, .done
3905  6532 3A A0 69                     LD   A, (VDC_GaugeFull)
3906  6535 B7                           OR   A
3907  6536 20 05                        JR   NZ, .gap_set_full
3908  6538 3E 15                        LD   A, SND_CHORAL1
3909  653A CD 2E 6B                     CALL GS_PlaySfx
