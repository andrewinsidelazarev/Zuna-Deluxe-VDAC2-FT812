1438  2B3A                              ; Центруем по ширине. 1024: центр 512, глифы рисует активная
1439  2B3A                              ; scale(1.6)-матрица → экранная полуширина = W×1.6/2 = W×4/5.
1440  2B3A                              ; (Мёртвый дубль LD HL,320 удалён.)
1441  2B3A CD 6A 31                     CALL StrWidth                            ; HL ptr → DE = W (атласные px)
1442  2B3D EB                           EX   DE, HL
1443  2B3E 29                           ADD  HL, HL
1443  2B3F 29             ADD HL, HL                 ; 4W
1444  2B40 3E 05                        LD   A, 5
1445  2B42 CD CB 79                     CALL Core.VDC_DivHLbyA                   ; HL = W×4/5
1446  2B45 EB                           EX   DE, HL                              ; DE = экранная полуширина
1447  2B46 21 00 02                     LD   HL, 512
