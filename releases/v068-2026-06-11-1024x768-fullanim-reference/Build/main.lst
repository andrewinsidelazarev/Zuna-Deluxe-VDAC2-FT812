   1+ 6931              ; loader_resident.asm — the parts of the PAK loader that MUST stay resident in
   2+ 6931              ; Core (slot 1), because they are reached while the loader overlay page is NOT
   3+ 6931              ; mapped:
   4+ 6931              ;   * VDC_ReadSampleAtHL — called per-frame from VDC_SlotPos (Main1) during play;
   5+ 6931              ;   * adventure cross-load vars (FadeAlpha / CurrentDifficulty / CurrentLevel),
   6+ 6931              ;     read by gameplay/menu/level-select code at any time;
   7+ 6931              ;   * the overlay trampolines — the named entry points callers use; each maps the
   8+ 6931              ;     loader page into slot 3, calls the real OVL_* routine, then restores #04.
   9+ 6931              ;
  10+ 6931              ; The bulk of the loader (sd_zc + RawPak_* + ZiFi_* + OVL_LoadGameplay... +
  11+ 6931              ; OVL_LoadLevelSelectPreviewAssets) lives in ts-dos.asm, assembled into its own
  12+ 6931              ; SLOT 3 / PAGE #40 overlay region (see main.asm). It is dormant outside loads —
  13+ 6931              ; "load a level, then sleep" — so it no longer costs resident Core space.
  14+ 6931
  15+ 6931              LOADER_OVL_PAGE    EQU #40            ; SPG page holding the loader overlay (mapped into slot 3 during loads)
  16+ 6931              GS_PORT_DATA       EQU #00B3
  17+ 6931              GS_PORT_CMD        EQU #00BB
  18+ 6931              GS_CMD_PLAY_MODULE EQU #31
  19+ 6931              GS_CMD_STOP_MODULE EQU #32
  20+ 6931              GS_CMD_PLAY_FX     EQU #98
  21+ 6931              GS_SFX_NOTE        EQU 53            ; 11025 Hz payload at GS C-2-ish base (#30) needs about +5 semitones.
  22+ 6931              GS_WAIT_TIMEOUT    EQU #FFFF
  23+ 6931                                                    ; UI_OVL_PAGE (#41) is defined globally in main.asm (needed before
  24+ 6931                                                    ; module Core by the Fade* transitions); referenced here for the trampoline.
  25+ 6931
  26+ 6931              ; Track chunkB page: tracks longer than one 16K page (>2730 samples) are split on
  27+ 6931              ; a sample boundary. The active track pages are resident variables because the
  28+ 6931              ; two-curve boards reuse the same reader for the second path.
  29+ 6931              TRACK_PAGE2        EQU #0F
  30+ 6931              TRACK_SPLIT_SAMPLE EQU 2730        ; (16384-2)/6, first sample stored in TRACK_PAGE2
  31+ 6931
  32+ 6931              ; ----------------------------------------------------------------------------
  33+ 6931              ; VDC_ReadSampleAtHL — read track sample [HL] -> BC=X, DE=Y; set VDC_LastT,
  34+ 6931              ; VDC_LastTangent and VDC_LastTrackFlags; CF=0. Core-resident (called as a tail-jump from VDC_SlotPos
  35+ 6931              ; in Main1, which is nearly full). Handles the 2-page track split: samples below
  36+ 6931              ; TRACK_SPLIT_SAMPLE sit on VDC_ActiveTrackPage1 at #8000+2+t*6; samples at/above
  37+ 6931              ; live on VDC_ActiveTrackPage2 at #8000+(t-split)*6 (chunkB has no count header).
  38+ 6931              ; Leaves slot 2 mapped to VDC_ActiveTrackPage1. Clobbers AF, HL.
  39+ 6931              ; ----------------------------------------------------------------------------
  40+ 6931              VDC_ReadSampleAtHL:
  41+ 6931 22 92 D3                     LD   (VDC_LastT), HL                   ; expose t
  42+ 6934 11 AA 0A                     LD   DE, TRACK_SPLIT_SAMPLE
  43+ 6937 A7                           AND  A
  44+ 6938 ED 52                        SBC  HL, DE                            ; HL = t - split; CF=1 if t<split
  45+ 693A 38 2C                        JR   C, .p1
  46+ 693C                              ; --- page2 (#0F): HL = t2 = t - split ---
  47+ 693C 54                           LD   D, H
  47+ 693D 5D             LD E, L
  48+ 693E 29                           ADD  HL, HL                            ; t2*2
  49+ 693F 19                           ADD  HL, DE                            ; t2*3
  50+ 6940 29                           ADD  HL, HL                            ; t2*6
  51+ 6941 11 00 80                     LD   DE, #8000
  52+ 6944 19                           ADD  HL, DE                            ; #8000 + t2*6
  53+ 6945 3A 93 69                     LD   A, (VDC_ActiveTrackPage2)
  54+ 6948                              SetPage2_A                             ; map #0F (clobbers A, BC)
  54+ 6948             >                ifdef MAPPING_REGISTERS
  54+ 6948 32 12 04    >                LD (FMADDR_REGS + HIGH PAGE2), A
  54+ 694B             >                else
  54+ 694B ~           >                LD (MemoryPages + 2), A
  54+ 694B ~           >                LD BC, PAGE2
  54+ 694B ~           >                OUT (C), A
  54+ 694B             >                endif
  55+ 694B 5E                           LD   E, (HL)
  55+ 694C 23             INC HL
  56+ 694D 56                           LD   D, (HL)
  56+ 694E 23             INC HL                  ; DE = X
