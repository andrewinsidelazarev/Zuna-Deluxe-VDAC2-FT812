2293  3A5C              ; VDC_CheckKillzone — proximity-based skull animation.
2294  3A5C              ; Каждый кадр вычисляет remaining_samples = (TrackNumSlots-HSA)*CS + KzEndSub-HSub.
2295  3A5C              ;   rem > 2*CS (=64)  → KzFrame=1 (closed skull, idle)
2296  3A5C              ;   rem in [1..64]    → KzFrame = 2 + ((64-rem) >> 3) ∈ [2..10] (opening)
2297  3A5C              ;   rem <= 0          → trigger absorb (state=1, KzFrame=11)
2298  3A5C              ; Rollback (match-3 cascade двигает HSA назад) → rem растёт → frame уменьшается
2299  3A5C              ; обратно к 1 автоматически. Никаких отдельных rollback hook'ов.
2300  3A5C              ; ============================================================================
2301  3A5C              VDC_CheckKillzone:
2302  3A5C 3A 96 69                     LD   A, (Core.VDC_SlotsLen)
2303  3A5F B7                           OR   A
2304  3A60 C8                           RET  Z
2305  3A61                              ; --- cells_to_go = TrackNumSlots - HSA ---
2306  3A61 2A 65 D3                     LD   HL, (Core.VDC_TrackNumSlots)      ; L = TNS low (TNS≈86 fits)
2307  3A64 7D                           LD   A, L
2308  3A65 21 5C D3                     LD   HL, Core.VDC_HSA
2309  3A68 96                           SUB  (HL)                              ; A = TNS - HSA (signed-ish)
2310  3A69 28 1F                        JR   Z, .ck_eqcell                     ; equal cells
2311  3A6B 38 4C                        JR   C, .ck_trigger                    ; HSA > TNS → past
2312  3A6D                              ; --- HSA < TNS: rem = A*CS + KzEndSub - HSub ---
2313  3A6D 26 00                        LD   H, 0
2314  3A6F 6F                           LD   L, A
2315  3A70 29                           ADD  HL, HL
2315  3A71 29             ADD HL, HL
2315  3A72 29             ADD HL, HL
2316  3A73 29                           ADD  HL, HL
2316  3A74 29             ADD HL, HL               ; HL = A * 32 (CELL_SIZE)
2317  3A75 3A 6C D3                     LD   A, (Core.VDC_KzEndSub)
2318  3A78 57                           LD   D, A
2319  3A79 3A 95 69                     LD   A, (Core.VDC_HSub)
2320  3A7C 5F                           LD   E, A
2321  3A7D 7A                           LD   A, D
2322  3A7E 93                           SUB  E                                 ; A = KzEndSub - HSub (signed)
2323  3A7F 5F                           LD   E, A
2324  3A80 16 00                        LD   D, 0
2325  3A82 CB 7F                        BIT  7, A
2326  3A84 28 01                        JR   Z, .ck_add_delta
2327  3A86 15                           DEC  D                                 ; sign-extend negative
2328  3A87 19           .ck_add_delta:  ADD  HL, DE                            ; HL = remaining samples
2329  3A88 18 10                        JR   .ck_set_frame
2330  3A8A              .ck_eqcell:     ; HSA == TNS: rem = KzEndSub - HSub ∈ [1..CS-1] always opening range
2331  3A8A 3A 6C D3                     LD   A, (Core.VDC_KzEndSub)
2332  3A8D 57                           LD   D, A
2333  3A8E 3A 95 69                     LD   A, (Core.VDC_HSub)
2334  3A91 BA                           CP   D
2335  3A92 30 25                        JR   NC, .ck_trigger                   ; HSub >= KzEndSub → past
2336  3A94 5F                           LD   E, A                              ; HSub
2337  3A95 7A                           LD   A, D
2338  3A96 93                           SUB  E                                 ; A = KzEndSub - HSub (1..CS-1)
2339  3A97 26 00                        LD   H, 0
2340  3A99 6F                           LD   L, A
2341  3A9A              .ck_set_frame:  ; HL = remaining samples (positive)
2342  3A9A 7C                           LD   A, H
2343  3A9B B7                           OR   A
2344  3A9C 20 15                        JR   NZ, .ck_closed                    ; rem > 255 → > 64 → closed
2345  3A9E 7D                           LD   A, L
2346  3A9F FE 41                        CP   65
2347  3AA1 30 10                        JR   NC, .ck_closed
2348  3AA3                              ; rem ∈ [1..64]: KzFrame = 2 + ((64 - rem) >> 3) ∈ [2..10]
2349  3AA3 47                           LD   B, A
2350  3AA4 3E 40                        LD   A, 64
2351  3AA6 90                           SUB  B
