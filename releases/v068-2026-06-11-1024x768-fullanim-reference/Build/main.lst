1319+ CD9D              ; Read file logical sector (RawPak_LogCur) into (IX). Advances RawPak_LogCur.
1320+ CD9D              ; Translates logical sector -> physical LBA through the run table.
1321+ CD9D              ; IX (dest) is preserved across the table walk and across sd_read_sector.
1322+ CD9D              RawPak_ReadOneLogicalIX:
1323+ CD9D DD E5                        PUSH IX                          ; save dest (we reuse IX to walk the table)
1324+ CD9F ED 5B DC D3                  LD   DE, (RawPak_LogCur)          ; DE = N (logical sector within file)
1325+ CDA3 DD 21 DC D0                  LD   IX, RawPak_RunTable
1326+ CDA7 3A DB D0                     LD   A, (RawPak_RunCount)
1327+ CDAA 47                           LD   B, A
1328+ CDAB DD 6E 04     .scan:         LD   L, (IX + 4)
1329+ CDAE DD 66 05                     LD   H, (IX + 5)                  ; HL = run.len (sectors)
1330+ CDB1 7A                           LD   A, D                         ; compare N (DE) < len (HL) ?
1331+ CDB2 BC                           CP   H
1332+ CDB3 38 19                        JR   C, .found
1333+ CDB5 20 04                        JR   NZ, .sub                     ; N hi > len hi -> N >= len
1334+ CDB7 7B                           LD   A, E
1335+ CDB8 BD                           CP   L
1336+ CDB9 38 13                        JR   C, .found
