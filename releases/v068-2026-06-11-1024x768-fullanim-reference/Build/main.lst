1284+ CD55              ; RawPak_FatEntryPtr — ensure the FAT sector holding FAT[CurClus] is in FatBuf
1285+ CD55              ; (read it if the cache misses), and return HL = &FatBuf[(CurClus & 127) * 4].
1286+ CD55              ; Out: CF=0 ok / HL set; CF=1 on SD error. Clobbers AF,BC,DE,HL (and IX via read).
1287+ CD55              RawPak_FatEntryPtr:
1288+ CD55 21 C9 CE                     LD   HL, RawPak_CurClus
