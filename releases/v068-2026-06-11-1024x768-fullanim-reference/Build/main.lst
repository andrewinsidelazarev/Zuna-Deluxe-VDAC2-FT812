2158  338B              ; DrawTimeValue — нарисовать "M:SS" из VDC_GameSeconds (RTC-based).
2159  338B              ;   Раньше делили StatTimeFrames/60, но при 74Hz видеорежиме это давало
2160  338B              ;   неверное время. Теперь берём VDC_GameSeconds (уже в секундах).
2161  338B              ; ============================================================================
2162  338B              DrawTimeValue:
2163  338B                              ; HL = VDC_GameSeconds (total seconds, RTC-based, pause excluded).
2164  338B                              ; Divide by 60: HL → BC=minutes, remainder=seconds.
2165  338B 2A A7 69                     LD   HL, (Core.VDC_GameSeconds)
2166  338E 11 3C 00                     LD   DE, 60
2167  3391 01 00 00                     LD   BC, 0
2168  3394 A7           .dt_div2:       AND  A
2169  3395 ED 52                        SBC  HL, DE
