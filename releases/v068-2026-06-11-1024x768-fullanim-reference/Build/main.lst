 769  21AA                              ; --- кадр черепа цепочки 2 ---
 770  21AA                              ; В PLAY (0) и ABSORB (1) у каждой килл-зоны свой череп: насколько
 771  21AA                              ; близко СВОЯ цепочка — VDC2_KzFrame обновляет CheckKillzone цепочки 2.
 772  21AA                              ; В INTRO/PREVIEW/CLOSING/GAMEOVER/WIN анимация черепа — событие ВСЕЙ
 773  21AA                              ; игры (closing 11→1 и т.п.), но её гоняет только VDC_Update на цепочке 1
 774  21AA                              ; (VDC_KzFrame); VDC2_KzFrame в эти фазы застывает → черепа рассинхрон.
 775  21AA                              ; Поэтому в не-PLAY/ABSORB рисуем оба черепа общим VDC_KzFrame.
 776  21AA 3A 94 69                     LD   A, (Core.VDC_GameState)
 777  21AD FE 03                        CP   3                                    ; <3 = PLAY/ABSORB/GAMEOVER → свой кадр
 778  21AF 3A 17 D6                     LD   A, (Core.VDC2_KzFrame)
 779  21B2 38 03                        JR   C, .ks2_have_frame
 780  21B4 3A 97 69                     LD   A, (Core.VDC_KzFrame)                ; >=2 → общий кадр цепочки 1
