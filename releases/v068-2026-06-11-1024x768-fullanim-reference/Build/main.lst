4446  D8C5                              include "Frog.asm"
# file opened: Source\ASM\Frog.asm
   1+ D8C5              ; ============================================================================
   2+ D8C5              ; Frog.asm — рендер лягушки 1:1 с Zuma-Deluxe-HD/src/zuma/Frog.c.
   3+ D8C5              ;
   4+ D8C5              ; Композиция (Frog_Draw):
   5+ D8C5              ;   • plate (no rotation) под body
   6+ D8C5              ;   • body с rotation matrix вокруг центра, angle = atan2(mouse - frog).
   7+ D8C5              ;     Native sprite face = south (BRAD 64), поэтому ZL_EmitRotate уже делает
   8+ D8C5              ;     ADD A,192 (= -64) — передаём raw FrogAngle.
   9+ D8C5              ;   • tongue с offset (tongueExpand · dir) и той же rotation matrix вокруг
  10+ D8C5              ;     центра sprite. dir = (cos(angle), sin(angle)) (см. SinTable ниже).
  11+ D8C5              ;
  12+ D8C5              ; Recoil/fire (Frog_Update):
  13+ D8C5              ;   ЛКМ rise edge → fireRecoilTick=0, isFire=1, ballExpand=0.
  14+ D8C5              ;   Каждый кадр: tick += 10 BRAD (≈0.245 rad ≈ HD 0.25 rad/frame).
  15+ D8C5              ;   recoil = sin(tick); пока recoil ≥ 0:
  16+ D8C5              ;     tongueExpand = 24 - (recoil * 24) >> 7         ; язык втянут в рот
  17+ D8C5              ;     ballExpand   = min(32, ballExpand + 2)         ; вылет шара
  18+ D8C5              ;     pos.x = posStart.x - (cos(angle) * recoil) / 2048    ; ≈ -dir*recoil*8/128
  19+ D8C5              ;     pos.y = posStart.y - (sin(angle) * recoil) / 2048
  20+ D8C5              ;   recoil < 0 → end: tongueExpand=24, ballExpand=32, pos=posStart, isFire=0.
  21+ D8C5              ;
  22+ D8C5              ; FT812 BITMAP_HANDLE: 2=body, 4=plate, 5=tongue.
  23+ D8C5              ; Frog layer format is selected by FROG_ARGB4_ENABLED in main.asm.
  24+ D8C5              ; ============================================================================
  25+ D8C5
  26+ D8C5              FROG_SPR_W        EQU 122                               ; atlas (layout/UV) — НЕ масштабировать
  27+ D8C5              FROG_SPR_HALF     EQU 61                                ; atlas center = UV pivot
  28+ D8C5              FROG_SPR_HALF_NEG EQU -FROG_SPR_HALF & 0xFFFF          ; -61 в 16-bit two's-comp
  29+ D8C5              ; 1024×768 порт: тело/тарелка/overlay рисуются ×1.6 через cmd_scale + matrix LUT.
  30+ D8C5              FROG_SPR_DRAW     EQU 195                               ; экранный размер = round(122×8/5)
  31+ D8C5              FROG_SPR_SCR_HALF EQU 98                                ; round(195/2) — экранный центр (screen pivot)
  32+ D8C5              FROG_SPR_SCR_HALF_NEG EQU -FROG_SPR_SCR_HALF & 0xFFFF
