2843  5C00                              ; ----- EntryPoint -----
2844  5C00 31 F2 40                     LD   SP, StackTop
2845  5C03                              ; ----- BOOT CANARY -----
2846  5C03                              ; Доказывает, что WC SPG-loader долистал до Core EntryPoint и
2847  5C03                              ; передал управление НАМ — до любого Init. Пишем "BOOT" в
2848  5C03                              ; резидентный RAM (#5044), не трогая стек/страницы. См. дамп 111:
2849  5C03                              ; если этой метки нет в F2-дампе — hang в фазе загрузки WC.
2850  5C03 21 42 4F                     LD   HL, #4F42                          ; 'B','O' (LE → #42 #4F)
2851  5C06 22 44 50                     LD   (BOOT_CANARY_ADDR), HL
2852  5C09 21 4F 54                     LD   HL, #544F                          ; 'O','T' (LE → #4F #54)
2853  5C0C 22 46 50                     LD   (BOOT_CANARY_ADDR + 2), HL
2854  5C0F CD 3B 5C                     CALL Initialize
2855  5C12 CD 51 5C                     CALL UploadBootLoadingAssets
2856  5C15 CD 47 6E                     CALL BootProgressReset
2857  5C18 3E 05                        LD   A, 5
2858  5C1A CD 59 6E                     CALL BootProgressSetA
2859  5C1D                              ; ПОРЯДОК ФИКСИРОВАН (НЕ МЕНЯТЬ):
2860  5C1D                              ;   музыка (если есть GS) -> SFX (если ОЗУ GS >= 2МБ) -> тело игры.
2861  5C1D CD 92 6A                     CALL GS_InitAndStartMenuMusic
2862  5C20 3E 3C                        LD   A, 60
