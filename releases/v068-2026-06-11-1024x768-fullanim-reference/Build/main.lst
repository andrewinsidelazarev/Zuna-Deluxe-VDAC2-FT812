2505+ E7D8
2506+ E7D8              ; Тик прогресс-бара во время стрима MOD->GS. Безопасно: GS на ОТДЕЛЬНОЙ шине
2507+ E7D8              ; (#BB/#B3), а FT-рисование — на SPI (#77/#57); BootBusOwner=0 между секторами
2508+ E7D8              ; (GS_StreamBufferDE отдаёт его в .ok). Каждые 256 секторов двигаем бар на 1px
2509+ E7D8              ; (в рамках бюджета фазы «музыка» 5..60), каждые 32 — перерисовка (анимация жива,
2510+ E7D8              ; экран не «висит» ~3 c стрима). Полностью сохраняет регистры вызывающего.
2511+ E7D8              GS_StreamProgressTick:
2512+ E7D8 E5                           PUSH HL
2513+ E7D9 D5                           PUSH DE
2514+ E7DA C5                           PUSH BC
2515+ E7DB F5                           PUSH AF
2516+ E7DC 3A FD E7                     LD   A, (GS_StreamTick)
2517+ E7DF 3C                           INC  A
2518+ E7E0 32 FD E7                     LD   (GS_StreamTick), A
2519+ E7E3 20 03                        JR   NZ, .noAdv                       ; перенос 255->0 каждые 256 секторов
2520+ E7E5 CD 79 6E                     CALL BootProgressIncNoDraw
2521+ E7E8 3A FD E7     .noAdv:         LD   A, (GS_StreamTick)
2522+ E7EB E6 1F                        AND  #1F
2523+ E7ED 20 09                        JR   NZ, .done                        ; перерисовка каждые 32 сектора
2524+ E7EF CD AB 6E                     CALL BootLoadingTickSafe
2525+ E7F2 3A 7D E8                     LD   A, (GS_AudioStreamPage)          ; восстановить slot2 на текущую стрим-страницу
2526+ E7F5                              SetPage2_A
2526+ E7F5             >                ifdef MAPPING_REGISTERS
2526+ E7F5 32 12 04    >                LD (FMADDR_REGS + HIGH PAGE2), A
2526+ E7F8             >                else
2526+ E7F8 ~           >                LD (MemoryPages + 2), A
2526+ E7F8 ~           >                LD BC, PAGE2
2526+ E7F8 ~           >                OUT (C), A
2526+ E7F8             >                endif
2527+ E7F8 F1           .done:          POP  AF
2528+ E7F9 C1                           POP  BC
2529+ E7FA D1                           POP  DE
2530+ E7FB E1                           POP  HL
2531+ E7FC C9                           RET
2532+ E7FD 00           GS_StreamTick:  DEFB 0
2533+ E7FE
2534+ E7FE              GS_StreamBufferDE:
2535+ E7FE 3E 01                        LD   A, 1
2536+ E800 32 45 6E                     LD   (BootBusOwner), A
2537+ E803 7A                           LD   A, D
2538+ E804 B3                           OR   E
2539+ E805 28 0B                        JR   Z, .ok
2540+ E807 7E           .loop:          LD   A, (HL)
2541+ E808 23                           INC  HL
2542+ E809 CD 2E E8                     CALL GS_SendDataOverlay
2543+ E80C D0                           RET  NC
2544+ E80D 1B                           DEC  DE
2545+ E80E 7A                           LD   A, D
2546+ E80F B3                           OR   E
2547+ E810 20 F5                        JR   NZ, .loop
2548+ E812 AF           .ok:            XOR  A
2549+ E813 32 45 6E                     LD   (BootBusOwner), A
2550+ E816 37                           SCF
2551+ E817 C9                           RET
2552+ E818
2553+ E818              GS_SendCommandOverlay:
2554+ E818 01 BB 00                     LD   BC, GS_PORT_CMD
2555+ E81B ED 79                        OUT  (C), A
2556+ E81D 21 FF FF                     LD   HL, GS_WAIT_TIMEOUT
2557+ E820 ED 78        .wcmd:          IN   A, (C)
2558+ E822 0F                           RRCA
2559+ E823 30 07                        JR   NC, .ok
2560+ E825 2B                           DEC  HL
2561+ E826 7C                           LD   A, H
2562+ E827 B5                           OR   L
2563+ E828 20 F6                        JR   NZ, .wcmd
2564+ E82A B7                           OR   A
2565+ E82B C9                           RET
2566+ E82C 37           .ok:            SCF
2567+ E82D C9                           RET
2568+ E82E
2569+ E82E              ; Отправка байта данных в GS. КАК В WC (gsplayer GSLOAD/TE0): СНАЧАЛА ждём, пока
2570+ E82E              ; в FIFO освободится место (bit7 статуса #BB сброшен), ПОТОМ пишем байт в #B3.
2571+ E82E              ; Раньше было наоборот (писали, потом ждали) — на эмуляторе прокатывало, но на
2572+ E82E              ; реальном MultiSound запись без проверки места переполняет FIFO → байты теряются
2573+ E82E              ; → стрим модуля бьётся и загрузка не завершается. Байт сохраняем в E на время ожидания.
2574+ E82E              GS_SendDataOverlay:
2575+ E82E E5                           PUSH HL
2576+ E82F D5                           PUSH DE
2577+ E830 5F                           LD   E, A                       ; сохранить байт данных
2578+ E831 01 BB 00                     LD   BC, GS_PORT_CMD            ; #BB — статус
2579+ E834 21 FF FF                     LD   HL, GS_WAIT_TIMEOUT
2580+ E837 ED 78        .wdat:          IN   A, (C)
2581+ E839 07                           RLCA                            ; bit7 -> CF (1 = FIFO полон/не готов)
2582+ E83A 30 0D                        JR   NC, .ready                 ; bit7=0 -> есть место
2583+ E83C 2B                           DEC  HL
2584+ E83D 7C                           LD   A, H
2585+ E83E B5                           OR   L
2586+ E83F 20 F6                        JR   NZ, .wdat
2587+ E841 D1                           POP  DE
2588+ E842 E1                           POP  HL
2589+ E843 AF                           XOR  A
2590+ E844 32 45 6E                     LD   (BootBusOwner), A
2591+ E847 B7                           OR   A                          ; таймаут -> CF=0
2592+ E848 C9                           RET
2593+ E849 7B           .ready:         LD   A, E
2594+ E84A 01 B3 00                     LD   BC, GS_PORT_DATA           ; #B3 — данные
2595+ E84D ED 79                        OUT  (C), A                     ; место есть -> пишем
2596+ E84F D1                           POP  DE
2597+ E850 E1                           POP  HL
