 101+ C42A              ; ZiFi_Done — restore TSLib in slot 0, EI.
 102+ C42A              ZiFi_Done:
 103+ C42A 01 77 00                     LD   BC, #0077
 104+ C42D 3E 03                        LD   A, #03
 105+ C42F ED 79                        OUT  (C), A
 106+ C431 01 57 00                     LD   BC, #0057
 107+ C434 3E FF                        LD   A, #FF
 108+ C436 ED 79                        OUT  (C), A
 109+ C438 3E 00                        LD   A,  TSLibPage
 110+ C43A                              SetPage0_A
