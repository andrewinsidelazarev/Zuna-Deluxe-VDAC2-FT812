 173+ 7CA4 C9                           RET
 174+ 7CA5 36 00        .released:      LD   (HL), 0                               ; отпущено -> сброс
 175+ 7CA7 AF                           XOR  A                                     ; Z = фронта нет
 176+ 7CA8 C9                           RET
