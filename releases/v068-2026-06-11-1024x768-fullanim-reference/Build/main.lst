  52+ C122                              ; --- 4. Переключить таймминги на 1024×768 @ 59 Hz --------
  53+ C122                              ; VM_1024_768_59Hz: PCLK 64 МГц (F_MUL=8), H 24/136/160/1024,
  54+ C122                              ;                   V 3/6/29/768 → HCYCLE 1344, VCYCLE 806.
  55+ C122                              ; Это ровно ×1.6 от 640×480 (8:5) — чистый NEAREST-апскейл всех
  56+ C122                              ; слоёв. Per-line бюджет растёт 832→1344 пропорционально ширине,
  57+ C122                              ; число строк 480→768 — общий fill-бюджет масштабируется ~×2.56.
  58+ C122                              ; Макрос пишет HCYCLE, HOFFSET, HSYNC0/1, HSIZE, VCYCLE,
  59+ C122                              ; VOFFSET, VSYNC0/1, VSIZE и REG_PCLK = F_MUL.
  60+ C122                              FT_RESOLUTION VM_1024_768_59Hz, ResolutionWidthPtr
  60+ C122             >                if     VM_1024_768_59Hz == VM_640_480_57Hz
  60+ C122 ~           >                LD HL, 640
  60+ C122 ~           >                LD (ResolutionRef? + 0), HL
  60+ C122 ~           >                LD HL, 480
  60+ C122 ~           >                LD (ResolutionRef? + 2), HL
  60+ C122             >                elseif Resolution? == VM_640_480_74Hz
  60+ C122 ~           >                LD HL, 640
  60+ C122 ~           >                LD (ResolutionRef? + 0), HL
  60+ C122 ~           >                LD HL, 480
  60+ C122 ~           >                LD (ResolutionRef? + 2), HL
  60+ C122             >                elseif Resolution? == VM_640_480_76Hz
  60+ C122 ~           >                LD HL, 640
  60+ C122 ~           >                LD (ResolutionRef? + 0), HL
  60+ C122 ~           >                LD HL, 480
  60+ C122 ~           >                LD (ResolutionRef? + 2), HL
  60+ C122             >                elseif Resolution? == VM_800_600_60Hz
  60+ C122 ~           >                LD HL, 800
  60+ C122 ~           >                LD (ResolutionRef? + 0), HL
  60+ C122 ~           >                LD HL, 600
  60+ C122 ~           >                LD (ResolutionRef? + 2), HL
  60+ C122             >                elseif Resolution? == VM_800_600_69Hz
  60+ C122 ~           >                LD HL, 800
  60+ C122 ~           >                LD (ResolutionRef? + 0), HL
  60+ C122 ~           >                LD HL, 600
  60+ C122 ~           >                LD (ResolutionRef? + 2), HL
  60+ C122             >                elseif Resolution? == VM_800_600_85Hz
  60+ C122 ~           >                LD HL, 800
  60+ C122 ~           >                LD (ResolutionRef? + 0), HL
  60+ C122 ~           >                LD HL, 600
  60+ C122 ~           >                LD (ResolutionRef? + 2), HL
  60+ C122             >                elseif Resolution? == VM_1024_768_59Hz
  60+ C122 21 00 04    >                LD HL, 1024
  60+ C125 22 F3 40    >                LD (ResolutionWidthPtr + 0), HL
  60+ C128 21 00 03    >                LD HL, 768
  60+ C12B 22 F5 40    >                LD (ResolutionWidthPtr + 2), HL
  60+ C12E             >                elseif Resolution? == VM_1024_768_67Hz
  60+ C12E ~           >                LD HL, 1024
  60+ C12E ~           >                LD (ResolutionRef? + 0), HL
  60+ C12E ~           >                LD HL, 768
  60+ C12E ~           >                LD (ResolutionRef? + 2), HL
  60+ C12E             >                elseif Resolution? == VM_1024_768_76Hz
  60+ C12E ~           >                LD HL, 1024
  60+ C12E ~           >                LD (ResolutionRef? + 0), HL
  60+ C12E ~           >                LD HL, 768
  60+ C12E ~           >                LD (ResolutionRef? + 2), HL
  60+ C12E             >                endif
  60+ C12E 21 9E 10    >                LD HL, VM_1024_768_59Hz
  60+ C131 CD DD 10    >                CALL FT.Initialize
