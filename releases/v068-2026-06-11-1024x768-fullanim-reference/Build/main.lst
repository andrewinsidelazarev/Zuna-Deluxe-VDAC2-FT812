 476  1792 7E           .co_loop:       LD   A, (HL)
 477  1793 23                           INC  HL                                ; HL = current offset
 478  1794 4F                           LD   C, A                              ; C = prev
 479  1795 7E                           LD   A, (HL)                           ; A = current
 480  1796 B7                           OR   A
 481  1797 28 0D                        JR   Z, .co_next
 482  1799 FA A6 17                     JP   M, .co_next                       ; only positive current offsets can create backward overlap
 483  179C CB 79                        BIT  7, C
 484  179E 20 05                        JR   NZ, .co_clamp                     ; prev negative, current positive -> inverted
 485  17A0 B9                           CP   C
 486  17A1 38 03                        JR   C, .co_next
 487  17A3 28 01                        JR   Z, .co_next
