2729  3D39              ; ----------------------------------------------------------------------------
2730  3D39              ; SafeInflatePage2: FT812 CMD_INFLATE with compressed source mapped in PAGE2.
2731  3D39              ;
2732  3D39              ; TSLib FT.Coprocessor.Inflate maps source pages into PAGE3/#C000, which is also
2733  3D39              ; our main1_play code slot. Fresh host dumps showed CPU HALT while PAGE3 was a
2734  3D39              ; zlib preview page (#F1). This variant keeps PAGE3 untouched and streams the
2735  3D39              ; source from PAGE2/#8000 instead.
2736  3D39              ;
2737  3D39              ; In: same convention as FT.Coprocessor.Inflate for current callers:
2738  3D39              ;   A:DE = RAM_G destination, BC = compressed byte count, HL = source offset,
2739  3D39              ;   A' = source SPG page. Current assets are all <64K compressed.
2740  3D39              ; Out: CF set only if coprocessor write reports fault.
2741  3D39              ; Slots after RET: PAGE2 restored to previous value; PAGE3 unchanged.
2742  3D39              ; ----------------------------------------------------------------------------
2743  3D39              SafeInflatePage2:
2744  3D39 CD 48 14                     CALL FT.Coprocessor.WaitFlush
2745  3D3C D8                           RET  C
2746  3D3D
2747  3D3D E5                           PUSH HL
2748  3D3E D5                           PUSH DE
2749  3D3F                              FT_WR32_CMD FT_CMD_INFLATE
2749  3D3F 21 FF FF    >                LD HL, (FT_CMD_INFLATE >> 16) & 0xFFFF
2749  3D42 11 22 FF    >                LD DE, FT_CMD_INFLATE & 0xFFFF
2749  3D45 CD F6 12    >                CALL FT.Coprocessor.Write32
2750  3D48 D1                           POP  DE
2751  3D49
2752  3D49 26 00                        LD   H, #00
2753  3D4B 6F                           LD   L, A
2754  3D4C CD F6 12                     CALL FT.Coprocessor.Write32
2755  3D4F D8                           RET  C
2756  3D50
2757  3D50                              GetPage2
2757  3D50             >                ifdef MAPPING_REGISTERS
2757  3D50 3A 12 04    >                LD A, (FMADDR_REGS + HIGH PAGE2)
2757  3D53             >                else
2757  3D53 ~           >                LD A, (MemoryPages + 2)
2757  3D53             >                endif
2758  3D53 32 AD 3D                     LD   (.sip2_saved_page2), A
2759  3D56 E1                           POP  HL
2760  3D57
2761  3D57                              ; Move source address from page-local #0000..#3FFF into slot2
2762  3D57                              ; address space #8000..#BFFF.
2763  3D57 7C                           LD   A, H
2764  3D58 F6 80                        OR   %10000000
2765  3D5A 67                           LD   H, A
2766  3D5B 08                           EX   AF, AF'
2767  3D5C 32 AE 3D                     LD   (.sip2_src_page), A
2768  3D5F 08                           EX   AF, AF'
2769  3D60
2770  3D60 3A AE 3D     .loop:          LD   A, (.sip2_src_page)
