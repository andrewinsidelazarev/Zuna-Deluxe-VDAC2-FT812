2771  3D63             >                ifdef MAPPING_REGISTERS
2771  3D63 32 12 04    >                LD (FMADDR_REGS + HIGH PAGE2), A
2771  3D66             >                else
2771  3D66 ~           >                LD (MemoryPages + 2), A
2771  3D66 ~           >                LD BC, PAGE2
2771  3D66 ~           >                OUT (C), A
2771  3D66             >                endif
2772  3D66
2773  3D66 E5                           PUSH HL                              ; source CPU address
2774  3D67 7C                           LD   A, H
2775  3D68 E6 3F                        AND  %00111111
2776  3D6A 67                           LD   H, A
2777  3D6B EB                           EX   DE, HL                          ; DE = offset in page
2778  3D6C 21 00 40                     LD   HL, #4000
2779  3D6F B7                           OR   A
2780  3D70 ED 52                        SBC  HL, DE
2781  3D72 EB                           EX   DE, HL                          ; DE = bytes to page end
2782  3D73
2783  3D73 60                           LD   H, B
2784  3D74 69                           LD   L, C                            ; HL = remaining total
2785  3D75 B7                           OR   A
2786  3D76 ED 52                        SBC  HL, DE
2787  3D78 30 09                        JR   NC, .page_chunk
2788  3D7A
2789  3D7A 19                           ADD  HL, DE                          ; HL = final chunk bytes
2790  3D7B 44                           LD   B, H
2791  3D7C 4D                           LD   C, L
2792  3D7D 21 00 00                     LD   HL, #0000                       ; no remainder
2793  3D80 37                           SCF                                  ; align final packet
2794  3D81 18 03                        JR   .write_chunk
2795  3D83
2796  3D83 42           .page_chunk:    LD   B, D
2797  3D84 4B                           LD   C, E                            ; BC = chunk bytes
2798  3D85 B7                           OR   A                               ; not final, no align
2799  3D86
2800  3D86 E3           .write_chunk:   EX   (SP), HL                         ; HL=source, stack=remainder
2801  3D87 CD 9E 12                     CALL FT.Coprocessor.Write
2802  3D8A C1                           POP  BC                              ; BC = remaining total
2803  3D8B 38 18                        JR   C, .restore_error
2804  3D8D 78                           LD   A, B
2805  3D8E B1                           OR   C
2806  3D8F 28 0C                        JR   Z, .restore_ok
2807  3D91
2808  3D91 21 00 80                     LD   HL, #8000
2809  3D94 3A AE 3D                     LD   A, (.sip2_src_page)
2810  3D97 3C                           INC  A
2811  3D98 32 AE 3D                     LD   (.sip2_src_page), A
2812  3D9B 18 C3                        JR   .loop
2813  3D9D
