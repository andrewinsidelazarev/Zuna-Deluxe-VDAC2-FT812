1227+ CCB8 22 D9 D0                     LD   (RawPak_FatPtr), HL
1228+ CCBB                              ; end of chain? NextClus >= 0x0FFFFFF8
1229+ CCBB 3A D8 D0                     LD   A, (RawPak_NextClus + 3)
1229+ CCBE FE 0F          CP #0F
1229+ CCC0 20 16          JR NZ, .notEoc
1230+ CCC2 3A D7 D0                     LD   A, (RawPak_NextClus + 2)
1230+ CCC5 FE FF          CP #FF
1230+ CCC7 20 0F          JR NZ, .notEoc
1231+ CCC9 3A D6 D0                     LD   A, (RawPak_NextClus + 1)
1231+ CCCC FE FF          CP #FF
1231+ CCCE 20 08          JR NZ, .notEoc
1232+ CCD0 3A D5 D0                     LD   A, (RawPak_NextClus + 0)
1232+ CCD3 FE F8          CP #F8
