; Shared level-select thumbnail marker geometry and asset locations.
; Marker bitmaps are flattened once and reused over every level preview.

LS_PREVIEW_MARKER_HANDLE     EQU 8
LS_PREVIEW_MARKER_RAMG       EQU #0B0000
LS_PREVIEW_FROG_RAMG         EQU LS_PREVIEW_MARKER_RAMG
LS_PREVIEW_FROG_PAGE         EQU #BA
LS_PREVIEW_FROG_Z_SIZE       EQU 3322
LS_PREVIEW_FROG_W            EQU 54
LS_PREVIEW_FROG_H            EQU 54
LS_PREVIEW_FROG_HALF         EQU LS_PREVIEW_FROG_W / 2
LS_PREVIEW_FROG_BYTES        EQU LS_PREVIEW_FROG_W * LS_PREVIEW_FROG_H * 2

LS_PREVIEW_KZ_RAMG           EQU LS_PREVIEW_MARKER_RAMG + LS_PREVIEW_FROG_BYTES
LS_PREVIEW_KZ_PAGE           EQU #BB
LS_PREVIEW_KZ_Z_SIZE         EQU 1497
LS_PREVIEW_KZ_W              EQU 39
LS_PREVIEW_KZ_H              EQU 39
LS_PREVIEW_KZ_HALF           EQU LS_PREVIEW_KZ_W / 2
LS_PREVIEW_KZ_BYTES          EQU LS_PREVIEW_KZ_W * LS_PREVIEW_KZ_H * 2

LS_PREVIEW_GAME_W            EQU 640
LS_PREVIEW_GAME_H            EQU 480
LS_PREVIEW_FROG_CENTER_X     EQU LS_PREVIEW_BG_X + FROG_DEFAULT_X * LS_PREVIEW_BG_DRAW_W / LS_PREVIEW_GAME_W
LS_PREVIEW_FROG_CENTER_Y     EQU LS_PREVIEW_BG_Y + FROG_DEFAULT_Y * LS_PREVIEW_BG_DRAW_H / LS_PREVIEW_GAME_H
LS_PREVIEW_FROG_X            EQU LS_PREVIEW_FROG_CENTER_X - LS_PREVIEW_FROG_HALF
LS_PREVIEW_FROG_Y            EQU LS_PREVIEW_FROG_CENTER_Y - LS_PREVIEW_FROG_HALF
LS_PREVIEW_KZ_CENTER_X       EQU LS_PREVIEW_BG_X + KZ_DEFAULT_X * LS_PREVIEW_BG_DRAW_W / LS_PREVIEW_GAME_W
LS_PREVIEW_KZ_CENTER_Y       EQU LS_PREVIEW_BG_Y + KZ_DEFAULT_Y * LS_PREVIEW_BG_DRAW_H / LS_PREVIEW_GAME_H
LS_PREVIEW_KZ_X              EQU LS_PREVIEW_KZ_CENTER_X - LS_PREVIEW_KZ_HALF
LS_PREVIEW_KZ_Y              EQU LS_PREVIEW_KZ_CENTER_Y - LS_PREVIEW_KZ_HALF
