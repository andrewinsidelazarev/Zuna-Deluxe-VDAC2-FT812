2029  31F2 21 00 00                     LD   HL, 0
2030  31F5 22 A3 69                     LD   (Core.VDC_PlayerScore), HL
2031  31F8 AF                           XOR  A
2032  31F9 32 A5 69                     LD   (Core.VDC_PlayerScore + 2), A
