1599+ F176 2A 95 7C                     LD   HL, (ZL_SmoothX)                 ; HL = old
1600+ F179 54                           LD   D, H
1600+ F17A 5D             LD E, L                   ; DE = old
1601+ F17B ED 4B 49 16                  LD   BC, (Input.Mouse.PositionX)
1602+ F17F A7                           AND  A
1603+ F180 ED 42                        SBC  HL, BC                           ; HL = old - raw (signed)
1604+ F182 CB 2C                        SRA  H
1604+ F184 CB 1D          RR L
1605+ F186 CB 2C                        SRA  H
1605+ F188 CB 1D          RR L                         ; HL = (old-raw)/4 signed
1606+ F18A EB                           EX   DE, HL                           ; HL = old, DE = (old-raw)/4
1607+ F18B A7                           AND  A
1608+ F18C ED 52                        SBC  HL, DE                           ; HL = old - (old-raw)/4 = new
1609+ F18E 22 95 7C                     LD   (ZL_SmoothX), HL
1610+ F191
1611+ F191                              ; --- Y axis ---
1612+ F191 2A 97 7C                     LD   HL, (ZL_SmoothY)
1613+ F194 54                           LD   D, H
1613+ F195 5D             LD E, L
1614+ F196 ED 4B 4B 16                  LD   BC, (Input.Mouse.PositionY)
1615+ F19A A7                           AND  A
1616+ F19B ED 42                        SBC  HL, BC
1617+ F19D CB 2C                        SRA  H
1617+ F19F CB 1D          RR L
1618+ F1A1 CB 2C                        SRA  H
1618+ F1A3 CB 1D          RR L
1619+ F1A5 EB                           EX   DE, HL
1620+ F1A6 A7                           AND  A
1621+ F1A7 ED 52                        SBC  HL, DE
1622+ F1A9 22 97 7C                     LD   (ZL_SmoothY), HL
1623+ F1AC C9                           RET
