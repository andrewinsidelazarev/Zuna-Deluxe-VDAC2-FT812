 102+ 6996              ; --- Hoisted gameplay/UI state (originally in VDC.asm / Frog.asm) -----------
 103+ 6996              ; Moved to resident Core so the resident transition + HUD/dialog/absorb/win
 104+ 6996              ; logic in main.asm reaches them while slot 3 holds a DIFFERENT scene overlay
 105+ 6996              ; (UI page vs gameplay page) — and so FadeLevelSelectToGameplay can reset the
 106+ 6996              ; score BEFORE the gameplay page is mapped. Names unchanged (module Core) → all
 107+ 6996              ; existing references (qualified Core.X and in-module X) resolve untouched.
 108+ 6996              ; VDC_Init still initialises these by name. See typed-launching-sunset plan.
 109+ 6996 00           VDC_GameState:       DEFB 0   ; 0=play,1=absorb,2=gameover,3=intro,4=preview,5=closing
 110+ 6997 00           VDC_HSub:            DEFB 0   ; head sub-position (absorb physics, resident UpdateAbsorbState)
 111+ 6998 00           VDC_SlotsLen:        DEFB 0   ; chain length (win/absorb logic in resident)
 112+ 6999 00           VDC_KzFrame:         DEFB 0   ; skull-mouth frame (DrawKillzone resident)
 113+ 699A FF           VDC_HeadAbsorbAlpha: DEFB 255 ; head-ball fade alpha during state=1 absorb
 114+ 699B 03           VDC_Lives:           DEFB 3   ; lives (start 3, +1/50k, carried across levels)
 115+ 699C 00           VDC_DialogState:     DEFB 0   ; 0=NONE,1=RETRY,2=GAMEOVER,3=pause,4=pause-fade,5=WIN_DONE,6=WIN_FADE
 116+ 699D 00           VDC_PrevMouseL:      DEFB 0   ; previous LMB state for dialog edge detection
 117+ 699E 00           VDC_HudMenuState:    DEFB 0   ; 0=inactive,1=hover,2=pressed (HUD MENU button)
 118+ 699F 00           VDC_HudPointerBlock: DEFB 0   ; pointer over HUD button: suppress frog fire edge
 119+ 69A0 00 00        VDC_GaugeScore:      DEFW 0   ; Zuma bar score this level (win condition in resident)
 120+ 69A2 00           VDC_GaugeFull:       DEFB 0   ; 0=yellow filling, 1=green full
 121+ 69A3              ; 24-bit cumulative adventure score (3-byte little-endian, max 16,777,215). Was
 122+ 69A3              ; DEFW (16-bit) which overflowed past 65535 — but adventure totals reach hundreds
 123+ 69A3              ; of thousands and the +1-life-per-50000 mechanic needs cumulative beyond 16 bits.
 124+ 69A3              ; NextLifeScore is the next 50000 threshold; Score_Add24 grants a life and advances
 125+ 69A3              ; it by 50000 each time the score crosses it. Both reset by Score_Reset.
 126+ 69A3 00 00 00     VDC_PlayerScore:     DB 0,0,0 ; cumulative adventure score (HUD draw + bonus in resident)
 127+ 69A6 50 C3 00     NextLifeScore:       DB #50,#C3,#00 ; next extra-life threshold = 50000 (0x00C350 LE)
 128+ 69A9 00 00        VDC_GameSeconds:     DEFW 0   ; elapsed gameplay seconds (HUD clock in resident)
 129+ 69AB 00           Frog_BallColor:      DEFB 0   ; current loaded ball color (refiltered on level change, resident)
 130+ 69AC 00           Frog_NextBallColor:  DEFB 0   ; next ball color
 131+ 69AD              ; VDC invariant diagnostics for F12 dumps. First failure is latched until VDC_Init:
 132+ 69AD              ;   code 1: SlotsLen > VDC_MAX_SLOTS
 133+ 69AD              ;   code 2: HSA > TrackNumSlots
 134+ 69AD              ;   code 3: Slots[i] is neither color nor GAP marker
 135+ 69AD              ;   code 4: Offsets[i] outside [-CELL_SIZE..CELL_SIZE]
 136+ 69AD              ;   code 5: ExplodeFrame[i] has invalid ExplodeMarker
 137+ 69AD              ;   code 6: Shot2[i] is not 0/1
 138+ 69AD 00           VDC_AssertCode:      DEFB 0
 139+ 69AE 00           VDC_AssertCtx:       DEFB 0
 140+ 69AF 00           VDC_AssertLen:       DEFB 0
 141+ 69B0 00           VDC_AssertHSA:       DEFB 0
 142+ 69B1 00           VDC_AssertValue:     DEFB 0
 143+ 69B2 00 00        VDC_AssertFrame:     DEFW 0
 144+ 69B4              ; LevelSelectPreviewFrogAngle: written/read by the resident preview-frog renderer
 145+ 69B4              ; (LevelSelectPreviewSlot0). The renderer maps the gameplay overlay (#04) for the
 146+ 69B4              ; frog/DL emit code; this one byte must stay reachable across that swap, so it is
 147+ 69B4              ; resident rather than on the UI overlay (#41) where LevelSelect.asm used to keep it.
 148+ 69B4 40           LevelSelectPreviewFrogAngle: DEFB 64
