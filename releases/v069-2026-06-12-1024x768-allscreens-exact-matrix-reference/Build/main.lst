2513+ E7DE              ; Тик прогресс-бара во время стрима MOD->GS. Безопасно: GS на ОТДЕЛЬНОЙ шине
2514+ E7DE              ; (#BB/#B3), а FT-рисование — на SPI (#77/#57); BootBusOwner=0 между секторами
2515+ E7DE              ; (GS_StreamBufferDE отдаёт его в .ok). Каждые 256 секторов двигаем бар на 1px
2516+ E7DE              ; (в рамках бюджета фазы «музыка» 5..60), каждые 32 — перерисовка (анимация жива,
2517+ E7DE              ; экран не «висит» ~3 c стрима). Полностью сохраняет регистры вызывающего.
2518+ E7DE              GS_StreamProgressTick:
2519+ E7DE E5                           PUSH HL
2520+ E7DF D5                           PUSH DE
2521+ E7E0 C5                           PUSH BC
2522+ E7E1 F5                           PUSH AF
2523+ E7E2 3A 03 E8                     LD   A, (GS_StreamTick)
2524+ E7E5 3C                           INC  A
2525+ E7E6 32 03 E8                     LD   (GS_StreamTick), A
2526+ E7E9 20 03                        JR   NZ, .noAdv                       ; перенос 255->0 каждые 256 секторов
2527+ E7EB CD 7B 6E                     CALL BootProgressIncNoDraw
2528+ E7EE 3A 03 E8     .noAdv:         LD   A, (GS_StreamTick)
2529+ E7F1 E6 1F                        AND  #1F
2530+ E7F3 20 09                        JR   NZ, .done                        ; перерисовка каждые 32 сектора
2531+ E7F5 CD AD 6E                     CALL BootLoadingTickSafe
2532+ E7F8 3A 83 E8                     LD   A, (GS_AudioStreamPage)          ; восстановить slot2 на текущую стрим-страницу
2533+ E7FB                              SetPage2_A
2533+ E7FB             >                ifdef MAPPING_REGISTERS
2533+ E7FB 32 12 04    >                LD (FMADDR_REGS + HIGH PAGE2), A
2533+ E7FE             >                else
2533+ E7FE ~           >                LD (MemoryPages + 2), A
2533+ E7FE ~           >                LD BC, PAGE2
2533+ E7FE ~           >                OUT (C), A
2533+ E7FE             >                endif
2534+ E7FE F1           .done:          POP  AF
