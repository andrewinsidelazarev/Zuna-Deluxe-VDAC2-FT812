4162  6699 32 16 69                     LD   (PauseFadeTimer), A
4163  669C 28 10                        JR   Z, .pf_done
4164  669E                              ; VDC_PauseAlpha = min(255, timer * 4)
4165  669E 6F                           LD   L, A
4166  669F 26 00                        LD   H, 0
4167  66A1 29                           ADD  HL, HL
4168  66A2 29                           ADD  HL, HL                             ; HL = timer*4
4169  66A3 7C                           LD   A, H
4170  66A4 B7                           OR   A
4171  66A5 3E FF                        LD   A, 255
4172  66A7 20 01                        JR   NZ, .pf_set                        ; >=256 -> clamp
4173  66A9 7D                           LD   A, L
