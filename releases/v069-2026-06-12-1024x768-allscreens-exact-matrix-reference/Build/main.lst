1985  31B0              ; ============================================================================
1986  31B0              ; 24-bit cumulative score (Core.VDC_PlayerScore, 3-byte LE) + 50000 extra-life.
1987  31B0              ; Resident (slot 0), so callable from gameplay (#04) and resident win/HUD code.
1988  31B0              ; ----------------------------------------------------------------------------
1989  31B0              ; Score_Add24 — VDC_PlayerScore += HL (16-bit delta), then award extra lives.
1990  31B0              ;   In: HL = points to add. Clobbers AF, DE, HL (NOT BC).
1991  31B0              ; ----------------------------------------------------------------------------
1992  31B0              Score_Add24:
1993  31B0 ED 5B A3 69                  LD   DE, (Core.VDC_PlayerScore)        ; DE = low 16 bits
1994  31B4 19                           ADD  HL, DE                            ; CF = carry out of low 16
1995  31B5 22 A3 69                     LD   (Core.VDC_PlayerScore), HL        ; store low 16 (LD keeps CF)
1996  31B8 3A A5 69                     LD   A, (Core.VDC_PlayerScore + 2)
1997  31BB CE 00                        ADC  A, 0                              ; += carry into byte 2
1998  31BD 32 A5 69                     LD   (Core.VDC_PlayerScore + 2), A
1999  31C0                              ; fall through to extra-life check
2000  31C0              ; ----------------------------------------------------------------------------
2001  31C0              ; Score_CheckExtraLife — while score >= NextLifeScore: VDC_Lives++, threshold += 50000.
2002  31C0              ; ----------------------------------------------------------------------------
2003  31C0              Score_CheckExtraLife:
2004  31C0 2A A3 69     .cel_loop:      LD   HL, (Core.VDC_PlayerScore)        ; low 16 of score
2005  31C3 ED 5B A6 69                  LD   DE, (Core.NextLifeScore)
2006  31C7 A7                           AND  A
2007  31C8 ED 52                        SBC  HL, DE                            ; CF = borrow (low 16)
2008  31CA 3A A5 69                     LD   A, (Core.VDC_PlayerScore + 2)
2009  31CD 21 A8 69                     LD   HL, Core.NextLifeScore + 2
2010  31D0 9E                           SBC  A, (HL)                           ; full 24-bit borrow in CF
2011  31D1 D8                           RET  C                                 ; score < threshold -> done
2012  31D2 3A 9B 69                     LD   A, (Core.VDC_Lives)
2013  31D5 3C                           INC  A
2014  31D6 32 9B 69                     LD   (Core.VDC_Lives), A
2015  31D9 3E 19                        LD   A, Core.SND_EXTRALIFE
2016  31DB CD 30 6B                     CALL Core.GS_PlaySfx
2017  31DE 2A A6 69                     LD   HL, (Core.NextLifeScore)
2018  31E1 11 50 C3                     LD   DE, 50000
2019  31E4 19                           ADD  HL, DE
2020  31E5 22 A6 69                     LD   (Core.NextLifeScore), HL
2021  31E8 3A A8 69                     LD   A, (Core.NextLifeScore + 2)
2022  31EB CE 00                        ADC  A, 0
2023  31ED 32 A8 69                     LD   (Core.NextLifeScore + 2), A
2024  31F0 18 CE                        JR   .cel_loop
