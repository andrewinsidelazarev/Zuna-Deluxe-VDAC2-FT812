2576+ E834              ; Отправка байта данных в GS. КАК В WC (gsplayer GSLOAD/TE0): СНАЧАЛА ждём, пока
2577+ E834              ; в FIFO освободится место (bit7 статуса #BB сброшен), ПОТОМ пишем байт в #B3.
2578+ E834              ; Раньше было наоборот (писали, потом ждали) — на эмуляторе прокатывало, но на
2579+ E834              ; реальном MultiSound запись без проверки места переполняет FIFO → байты теряются
2580+ E834              ; → стрим модуля бьётся и загрузка не завершается. Байт сохраняем в E на время ожидания.
2581+ E834              GS_SendDataOverlay:
2582+ E834 E5                           PUSH HL
2583+ E835 D5                           PUSH DE
2584+ E836 5F                           LD   E, A                       ; сохранить байт данных
2585+ E837 01 BB 00                     LD   BC, GS_PORT_CMD            ; #BB — статус
2586+ E83A 21 FF FF                     LD   HL, GS_WAIT_TIMEOUT
2587+ E83D ED 78        .wdat:          IN   A, (C)
2588+ E83F 07                           RLCA                            ; bit7 -> CF (1 = FIFO полон/не готов)
2589+ E840 30 0D                        JR   NC, .ready                 ; bit7=0 -> есть место
2590+ E842 2B                           DEC  HL
2591+ E843 7C                           LD   A, H
2592+ E844 B5                           OR   L
2593+ E845 20 F6                        JR   NZ, .wdat
2594+ E847 D1                           POP  DE
2595+ E848 E1                           POP  HL
2596+ E849 AF                           XOR  A
2597+ E84A 32 47 6E                     LD   (BootBusOwner), A
2598+ E84D B7                           OR   A                          ; таймаут -> CF=0
2599+ E84E C9                           RET
2600+ E84F 7B           .ready:         LD   A, E
2601+ E850 01 B3 00                     LD   BC, GS_PORT_DATA           ; #B3 — данные
2602+ E853 ED 79                        OUT  (C), A                     ; место есть -> пишем
2603+ E855 D1                           POP  DE
2604+ E856 E1                           POP  HL
2605+ E857 37                           SCF
2606+ E858 C9                           RET
