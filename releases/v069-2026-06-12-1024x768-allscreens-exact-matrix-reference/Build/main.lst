 125+ E479                              ; --- 3. Sync с FT812 swap interrupt, then wait until previous
 126+ E479                              ; DLSWAP request completed.  On real VDAC2, letting the
 127+ E479                              ; coprocessor rebuild RAM_DL during active scanout tears badly.
 128+ E479              .WaitIntSync    FT_RD_REG8 FT_REG_INT_FLAGS
 128+ E479 D5          >                PUSH DE
