   1++C2DF              ;//////////////////////////////////////////////////////////////
   2++C2DF              ;//  Self-contained SD (Z-Controller) raw sector read.
   3++C2DF              ;//  Ported from the WC device driver DSDZC.ASM read path
   4++C2DF              ;//  (via Desktop/WC/Chkdsk/src/sd_zc.a80 by the ChkDsk session).
   5++C2DF              ;//  The card is already initialised by WC before the SPG launches
   6++C2DF              ;//  (hardware state persists), so we only issue CMD17 reads.
   7++C2DF              ;//
   8++C2DF              ;//  This BYPASSES the bundled TS-DOS driver, whose FAT chain walk
   9++C2DF              ;//  drifts -128 sectors at the first FAT-sector boundary in our SPG
  10++C2DF              ;//  context. We do our own BPB/FAT walk on top of sd_read_sector.
  11++C2DF              ;//
  12++C2DF              ;//  Unreal/this host uses BYTE addressing (sd_blkt = 0): the CMD17
  13++C2DF              ;//  argument is LBA*512. (Real SDHC would use block addressing.)
  14++C2DF              ;//////////////////////////////////////////////////////////////
  15++C2DF
  16++C2DF              SD_CONF         equ     #77             ; config / chip-select port
  17++C2DF              SD_DATA         equ     #57             ; data port
  18++C2DF              SD_CMD17        equ     %01000000+17    ; single-block read
  19++C2DF              SD_CS1          equ     %00000001       ; chip select, SD1
  20++C2DF
  21++C2DF              ;--- sd_init: byte addressing (Unreal). sd_blkt = 0.
  22++C2DF              sd_init:
  23++C2DF AF                           xor     a
  24++C2E0 32 0A C4                     ld      (sd_blkt),a
  25++C2E3 CD 59 C3                     call    sd_csh
  26++C2E6 CD B6 C3                     call    sd_snb
  27++C2E9 C9                           ret
  28++C2EA
  29++C2EA              ;--- sd_read_sector: read one 512-byte sector
  30++C2EA              ;    in:  HL = LBA (low 16), DE = LBA (high 16)  [LBA is 32-bit]
  31++C2EA              ;         IX = destination buffer (512 bytes)
  32++C2EA              ;    out: CF = 1 on error, CF = 0 on success
  33++C2EA              sd_read_sector:
  34++C2EA 22 06 C4                     ld      (sd_lba+0),hl
  35++C2ED ED 53 08 C4                  ld      (sd_lba+2),de
  36++C2F1 CD D4 C3                     call    sd_lba_in_range         ; защита: не слать CMD17 за пределы тома —
  37++C2F4 38 1E                        jr      c,.range                ; битый LBA иначе кирпичит реальную SDHC до переткивания
  38++C2F6 DD E5                        push    ix
  39++C2F8 E1                           pop     hl                      ; HL = buffer
  40++C2F9 CD 16 C3                     call    sd_cmd17
  41++C2FC 20 11                        jr      nz,.err                 ; R1 must be #00
  42++C2FE CD 98 C3                     call    sd_wait_token
  43++C301 38 0C                        jr      c,.err
  44++C303 CD 4F C3                     call    sd_reads                ; read 512 bytes -> (HL), HL += 512
  45++C306 DB 57                        in      a,(SD_DATA)             ; CRC16 lo (ignored)
  46++C308 DB 57                        in      a,(SD_DATA)             ; CRC16 hi (ignored)
  47++C30A CD 59 C3                     call    sd_csh
  48++C30D B7                           or      a                       ; CF=0
  49++C30E C9                           ret
  50++C30F CD 59 C3     .err            call    sd_csh
  51++C312 37                           scf
  52++C313 C9                           ret
  53++C314 37           .range          scf                             ; LBA вне тома — карту не трогаем вообще
  54++C315 C9                           ret
  55++C316
  56++C316              ;--- CMD17 (single-block read). Address from sd_lba.
  57++C316              ;    byte addressing (sd_blkt==0): argument = LBA*512 (byte offset).
  58++C316              ;    Preserves HL (caller's buffer pointer). Port of DSDZC CMDz.
  59++C316              sd_cmd17:
  60++C316 3E 51                        ld      a,SD_CMD17
  61++C318 CD 59 C3                     call    sd_csh
  62++C31B CD 6C C3                     call    sd_csl
  63++C31E E5                           push    hl                      ; preserve buffer pointer
  64++C31F ED 5B 06 C4                  ld      de,(sd_lba+0)           ; DE = LBA low16
  65++C323 ED 4B 08 C4                  ld      bc,(sd_lba+2)           ; BC = LBA high16
  66++C327 69                           ld      l,c
  67++C328 60                           ld      h,b                     ; HL = high16
  68++C329 4F                           ld      c,a                     ; C = command
  69++C32A 3A 0A C4                     ld      a,(sd_blkt)
  70++C32D B7                           or      a
  71++C32E 20 09                        jr      nz,.send                ; block addressing -> send LBA as-is
  72++C330                              ; byte addressing: [HL:DE] = LBA*512  (x2 then x256 byte-shift)
  73++C330 EB                           ex      de,hl
  73++C331 29             add hl,hl
  74++C332 EB                           ex      de,hl
  74++C333 ED 6A          adc hl,hl
  75++C335 65                           ld      h,l
  75++C336 6A             ld l,d
  75++C337 53             ld d,e
  75++C338 5F             ld e,a  ; A=sd_blkt=0 here
  76++C339              .send
  77++C339 79                           ld      a,c                     ; A = command
  78++C33A 01 57 00                     ld      bc,SD_DATA
  79++C33D ED 79                        out     (c),a                   ; command byte
  80++C33F ED 61                        out     (c),h
  81++C341 ED 69                        out     (c),l
  82++C343 ED 51                        out     (c),d
  83++C345 ED 59                        out     (c),e
  84++C347 3E FF                        ld      a,#FF
  85++C349 ED 79                        out     (c),a                   ; CRC (ignored)
  86++C34B E1                           pop     hl                      ; restore buffer pointer
  87++C34C C3 C1 C3                     jp      sd_resp
  88++C34F
  89++C34F              ;--- read 512 bytes from data port into (HL); HL advances by 512
  90++C34F              sd_reads:
  91++C34F C5                           push    bc
  92++C350 01 57 00                     ld      bc,SD_DATA              ; B=0 -> 256 per INIR
  93++C353 ED B2                        inir
  94++C355 ED B2                        inir
  95++C357 C1                           pop     bc
  96++C358 C9                           ret
  97++C359
  98++C359              ;--- chip select high (deselect) + clock
  99++C359              sd_csh:
 100++C359 C5                           push    bc
 100++C35A F5             push af
 101++C35B 01 77 00                     ld      bc,SD_CONF
 101++C35E 3E 03          ld a,%00000011
 101++C360 ED 79          out (c),a
 102++C362 01 57 00                     ld      bc,SD_DATA
 102++C365 3E FF          ld a,#FF
 102++C367 ED 79          out (c),a
 103++C369 F1                           pop     af
 103++C36A C1             pop bc
 104++C36B C9                           ret
 105++C36C
 106++C36C              ;--- chip select low (select) + clock, then wait ready
 107++C36C              sd_csl:
 108++C36C C5                           push    bc
 108++C36D F5             push af
 109++C36E 01 77 00                     ld      bc,SD_CONF
 109++C371 3E 01          ld a,SD_CS1
 109++C373 ED 79          out (c),a
 110++C375 01 57 00                     ld      bc,SD_DATA
 110++C378 3E FF          ld a,#FF
 110++C37A ED 79          out (c),a
 111++C37C F1                           pop     af
 111++C37D C1             pop bc
 112++C37E C3 81 C3                     jp      sd_wait
 113++C381
 114++C381              ;--- wait until card returns #FF (ready), BOUNDED. Never spin forever: if the
 115++C381              ;    card stays busy we give up so a read fails cleanly (-> CF=1 -> L1 fallback)
 116++C381              ;    instead of hanging the SD/SPI bus, which would also wedge WC's next SPG load.
 117++C381              sd_wait:
 118++C381 C5                           push    bc
 118++C382 D5             push de
 118++C383 F5             push af
 119++C384 01 57 00                     ld      bc,SD_DATA
 120++C387 11 00 00                     ld      de,0                    ; 65536 polls then give up
 121++C38A ED 78        .w              in      a,(c)
 121++C38C 3C             inc a
 121++C38D 28 05          jr z,.done   ; #FF -> ready
 122++C38F 1B                           dec     de
 122++C390 7A             ld a,d
 122++C391 B3             or e
 122++C392 20 F6          jr nz,.w
 123++C394 F1           .done           pop     af
 123++C395 D1             pop de
 123++C396 C1             pop bc
 124++C397 C9                           ret
 125++C398
 126++C398              ;--- wait for data token #FE with bounded timeout.
 127++C398              ;    out: CF=0 token received, CF=1 timeout/error token.
 128++C398              sd_wait_token:
 129++C398 C5                           push    bc
 130++C399 01 57 00                     ld      bc,SD_DATA
 131++C39C 16 04                        ld      d,4
 132++C39E 1E 00        .outer          ld      e,0
 133++C3A0 ED 78        .inner          in      a,(c)
 134++C3A2 FE FE                        cp      #FE
 135++C3A4 28 0D                        jr      z,.ok
 136++C3A6 CB 7F                        bit     7,a
 137++C3A8 28 06                        jr      z,.err                  ; data error token (0xxxxxxx)
 138++C3AA 1D                           dec     e
 139++C3AB 20 F3                        jr      nz,.inner
 140++C3AD 15                           dec     d
 141++C3AE 20 EE                        jr      nz,.outer
 142++C3B0 C1           .err            pop     bc
 143++C3B1 37                           scf
 144++C3B2 C9                           ret
 145++C3B3 C1           .ok             pop     bc
 146++C3B4 B7                           or      a
 147++C3B5 C9                           ret
 148++C3B6
 149++C3B6              ;--- 16 dummy reads
 150++C3B6              sd_snb:
 151++C3B6 C5                           push    bc
 151++C3B7 F5             push af
 152++C3B8 06 10                        ld      b,16
 153++C3BA DB 57        .s              in      a,(SD_DATA)
 153++C3BC 10 FC          djnz .s
 154++C3BE F1                           pop     af
 154++C3BF C1             pop bc
 155++C3C0 C9                           ret
 156++C3C1
 157++C3C1              ;--- read R1 response (bit7=0), up to 10 tries
 158++C3C1              sd_resp:
 159++C3C1 D5                           push    de
 159++C3C2 C5             push bc
 160++C3C3 01 57 00                     ld      bc,SD_DATA
 161++C3C6 16 0A                        ld      d,10
 162++C3C8 ED 78        .r              in      a,(c)
 162++C3CA CB 7F          bit 7,a
 162++C3CC 28 03          jr z,.done
 163++C3CE 15                           dec     d
 163++C3CF 20 F7          jr nz,.r
 164++C3D1 C1           .done           pop     bc
 164++C3D2 D1             pop de
 165++C3D3 C9                           ret
 166++C3D4
 167++C3D4              ;--- sd_lba_in_range: проверка sd_lba против верхней границы тома sd_lba_max.
 168++C3D4              ;    out: CF=1 — отвергнуть (sd_lba >= sd_lba_max); CF=0 — ок ИЛИ защита выключена.
 169++C3D4              ;    sd_lba_max==0 => защита выключена (до парса BPB, для bootstrap-чтений).
 170++C3D4              ;    Сохраняет HL/DE/BC; клобает A/флаги (результат — в CF).
 171++C3D4              sd_lba_in_range:
 172++C3D4 E5                           push    hl
 172++C3D5 D5             push de
 172++C3D6 C5             push bc
 173++C3D7 3A 0B C4                     ld      a,(sd_lba_max+0)        ; sd_lba_max == 0 ?
 174++C3DA 47                           ld      b,a
 175++C3DB 3A 0C C4                     ld      a,(sd_lba_max+1)
 175++C3DE B0             or b
 175++C3DF 47             ld b,a
 176++C3E0 3A 0D C4                     ld      a,(sd_lba_max+2)
 176++C3E3 B0             or b
 176++C3E4 47             ld b,a
 177++C3E5 3A 0E C4                     ld      a,(sd_lba_max+3)
 177++C3E8 B0             or b
 178++C3E9 28 16                        jr      z,.disabled             ; все нули -> защита выключена
 179++C3EB 21 06 C4                     ld      hl,sd_lba
 180++C3EE 11 0B C4                     ld      de,sd_lba_max
 181++C3F1 B7                           or      a                       ; CF=0 перед многобайтовым вычитанием
 182++C3F2 06 04                        ld      b,4
 183++C3F4 1A           .cmp            ld      a,(de)                  ; sd_lba - sd_lba_max побайтно (LE)
 184++C3F5 4F                           ld      c,a
 185++C3F6 7E                           ld      a,(hl)
 186++C3F7 99                           sbc     a,c
 187++C3F8 23                           inc     hl
 188++C3F9 13                           inc     de
 189++C3FA 10 F8                        djnz    .cmp                    ; INC/DJNZ не трогают CF -> заём проходит насквозь
 190++C3FC 3F                           ccf                             ; заём(CF=1, sd_lba<max)->0 ок ; CF=0(>=max)->1 отвергнуть
 191++C3FD C1                           pop     bc
 191++C3FE D1             pop de
 191++C3FF E1             pop hl
 192++C400 C9                           ret
 193++C401 C1           .disabled       pop     bc
 193++C402 D1             pop de
 193++C403 E1             pop hl
 194++C404 B7                           or      a                       ; CF=0 (в диапазоне)
 195++C405 C9                           ret
