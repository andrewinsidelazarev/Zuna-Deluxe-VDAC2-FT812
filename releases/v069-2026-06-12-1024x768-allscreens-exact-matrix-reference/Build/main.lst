 177+ 6A65              ; Loader diagnostics — RESIDENT so an F12 dump (which captures slot 1 = Core, not
 178+ 6A65              ; the loader overlay page) shows how far a load got. The overlay loader writes
 179+ 6A65              ; them while slot 1 is mapped. Read these in a dump to bisect a failed load:
 180+ 6A65              ;   ZiFi_GpDbgStep : 0=not started, 1=Init, 2=PakOpen, 3=PakReadToc,
 181+ 6A65              ;                    #34=bg SD done, #35=track SD done, 6=success;
 182+ 6A65              ;                    #FF=Init err, #FE=PakOpen err, #FD=PakReadToc err.
 183+ 6A65              ;   ZiFi_DbgGamesA : RawPak_OpenRoot granular step —
 184+ 6A65              ;                    #20 entry, #21 BPB read OK, #22 BPB valid, #26 search start,
 185+ 6A65              ;                    #25 PAK found; #A1 BPB CMD17 err, #A2 bps!=512, #A3 spc=0,
 186+ 6A65              ;                    #A6 PAK not found anywhere, #A7 run-table overflow.
 187+ 6A65              ;   ZiFi_DbgGamesFound : directories visited during the recursive search.
 188+ 6A65 00           ZiFi_GpDbgStep:     DEFB 0
 189+ 6A66 00 00        ZiFi_GpDbgBgOff:    DEFW 0
 190+ 6A68 00 00        ZiFi_GpDbgBgSize:   DEFW 0
 191+ 6A6A 00           ZiFi_DbgGamesA:     DEFB 0
 192+ 6A6B 00           ZiFi_DbgGamesFound: DEFB 0
 193+ 6A6C 00           ZiFi_DbgZumaFound:  DEFB 0
 194+ 6A6D 00           ZiFi_DbgPakFound:   DEFB 0
 195+ 6A6E 00 00        ZiFi_DbgPakSizeL:   DEFW 0
 196+ 6A70 00 00        ZiFi_DbgPakSizeH:   DEFW 0
