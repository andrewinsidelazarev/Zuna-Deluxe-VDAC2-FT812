 303+ C2FE                              macro MenuCheckButton X?, Y?, W?, H?, State?, ClickVar?
 304+ C2FE ~                            ; 1024×768: hit-box ×8/5 (мышь в экранных 1024-координатах)
 305+ C2FE ~                            LD   BC, (X?) * 8 / 5
 306+ C2FE ~                            LD   DE, ((X?) + (W?)) * 8 / 5
 307+ C2FE ~                            LD   IX, (Y?) * 8 / 5
 308+ C2FE ~                            LD   IY, ((Y?) + (H?)) * 8 / 5
 309+ C2FE ~                            CALL MenuPointInside
 310+ C2FE ~                            LD   A, C
 311+ C2FE ~                            OR   A
 312+ C2FE ~                            JR   Z, .outside?
 313+ C2FE ~                            LD   A, (MenuLmbNow)
 314+ C2FE ~                            OR   A
 315+ C2FE ~                            LD   A, 1
 316+ C2FE ~                            JR   Z, .store?
 317+ C2FE ~                            INC  A
 318+ C2FE ~            .store?:        LD   (State?), A
 319+ C2FE ~                            if ClickVar?
 320+ C2FE ~                            CP   1
 321+ C2FE ~                            JR   NZ, .outside?
 322+ C2FE ~                            LD   A, (MenuLmbPrev)
 323+ C2FE ~                            CP   1
 324+ C2FE ~                            JR   NZ, .outside?
 325+ C2FE ~                            LD   A, 1
 326+ C2FE ~                            LD   (ClickVar?), A
 327+ C2FE ~                            LD   A, SND_BUTTON1
 328+ C2FE ~                            CALL GS_PlaySfx
 329+ C2FE ~                            endif
 330+ C2FE ~            .outside?:
 331+ C2FE                              endm
