 499  17AC              ; ============================================================================
 500  17AC              ; DrawKillzoneDual — dual-pass kill-zone draw: hole (cell 0) под skull (cell N).
 501  17AC              ; Перенесён сюда из Core.MainLoop чтобы освободить байты Core (Core был
 502  17AC              ; 8189/8192). Должен вызываться внутри активного FT_Begin FT_BITMAPS блока.
 503  17AC              ;
 504  17AC              ; Координаты центра kill-zone — per-level setting (KZ_DEFAULT_X/Y).  Не из
 505  17AC              ; track end: track[N-1] не обязан попадать в визуальный центр sun-черепа в bg
 506  17AC              ; (cell-grid CELL_SIZE=32 ≠ pixel-aligned bg art).  Для level 1 (Spiral of Doom)
 507  17AC              ; центр bg-bbox золотых пикселей = (208, 217).
 508  17AC              ; ============================================================================
 509  17AC              KZ_DEFAULT_X       EQU 211
 510  17AC              KZ_DEFAULT_Y       EQU 217
 511  17AC              KZ_SPR_W           EQU 88                              ; atlas (layout) — НЕ масштабировать
 512  17AC              KZ_SPR_H           EQU 88
 513  17AC              KZ_SPR_DRAW        EQU 141                             ; 1024×768: экранный размер = round(88×8/5)
 514  17AC              KZ_SPR_HALF        EQU 70                              ; round(141/2) — центр draw-rect'а (scale-about-origin)
 515  17AC              FROG_DEFAULT_X     EQU 327
 516  17AC              FROG_DEFAULT_Y     EQU 231
 517  17AC
 518  17AC              ; Room transitions keep the old DL visible until it is fully covered by a
 519  17AC              ; black overlay. RAM_G can then be reloaded without exposing half-written art.
 520  17AC              FadeMenuToLevelSelect:
 521  17AC 21 94 C4                     LD   HL, Core.MenuBuildFrame
 522  17AF CD 2E 18                     CALL FadeOutRoom
 523  17B2                              ; First time only: the PAK sector map isn't built yet, so the
 524  17B2                              ; upcoming asset load runs the (slow) recursive search. Show
 525  17B2                              ; "LOADING LEVELS..." over the faded-out menu while it works.
 526  17B2                              ; Later transitions reuse the cached map -> near-instant, no message.
 527  17B2 3A 12 6C                     LD   A, (Core.LevelsMapLoaded)
 528  17B5 B7                           OR   A
 529  17B6 20 06                        JR   NZ, .skip_loading
 530  17B8 CD C1 17                     CALL UploadLoadingText                  ; залить баннер в RAM_G #084000 (меню погашено)
 531  17BB CD EA 62                     CALL Core.DrawLoadingLevelsScreen
 532  17BE              .skip_loading:
 533  17BE C3 6F CE                     JP   Core.LevelSelect
 534  17C1
 535  17C1              ; UploadLoadingText — расжать «LOADING LEVELS...» (nativealien48 48px) в RAM_G
 536  17C1              ; #084000. Зона свободна в профиле level-select (#082658..#098000), поэтому баннер
 537  17C1              ; переживает медленный поиск PAK, пока кадр отрисован. Вызывать ДО DrawLoadingScreen.
 538  17C1              UploadLoadingText:
 539  17C1 21 00 40                     LD   HL, LOADING_TEXT_RAMG & 0xFFFF
 540  17C4 22 7D 65                     LD   (Core.BgRamL), HL
 541  17C7 3E 08                        LD   A, (LOADING_TEXT_RAMG >> 16) & 0xFF
 542  17C9 32 7F 65                     LD   (Core.BgRamH), A
 543  17CC 3E 25                        LD   A, LOADING_TEXT_PAGE_BASE
 544  17CE 06 03                        LD   B, LOADING_TEXT_NUM_PAGES
 545  17D0 C5           .ult_loop:      PUSH BC
 546  17D1 F5                           PUSH AF
 547  17D2 CD 9F 3B                     CALL UnpackAndUploadPage                ; advances RAM_G +16K
 548  17D5 F1                           POP  AF
 549  17D6 3C                           INC  A
 550  17D7 C1                           POP  BC
 551  17D8 10 F6                        DJNZ .ult_loop
 552  17DA C9                           RET
