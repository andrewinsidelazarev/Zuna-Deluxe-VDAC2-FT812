  60+ D8C5              ; Frog_Init — обнулить state.  F12-reset не reload'ит RAM, поэтому всё
  61+ D8C5              ; инициализируется явно.
  62+ D8C5              ; ----------------------------------------------------------------------------
  63+ D8C5 AF           Frog_Init:        XOR  A
  64+ D8C6 32 23 7B                       LD   (Frog_Angle), A
  65+ D8C9 32 2B E0                       LD   (Frog_RecoilTick), A
  66+ D8CC 32 2C E0                       LD   (Frog_IsFire), A
  67+ D8CF 32 89 4C                       LD   (FROG_RTC_MIX_CNT_ADDR), A      ; slot 1 free RAM counter — F12 reset не чистит её сам
  68+ D8D2 32 8A 4C                       LD   (FROG_RTC_MIX_FLAG_ADDR), A     ; pending RTC mix flag
  69+ D8D5 3D                             DEC  A                                ; A = #FF (was 0)
  70+ D8D6 32 8B 4C                       LD   (FROG_EXCLUDE_COLOR_ADDR), A    ; exclude-color = 0xFF (none)
  71+ D8D9 AF                             XOR  A                                ; restore A=0 для последующих stores
  72+ D8DA 3E 01                          LD   A, 1                            ; pre-init = pressed → no spurious
  73+ D8DC 32 2D E0                       LD   (Frog_PrevMouseLeft), A         ; edge-rise на первом кадре
  74+ D8DF 32 2E E0                       LD   (Frog_KeySpacePrev), A
  75+ D8E2 AF                             XOR  A
  76+ D8E3 3E 18                          LD   A, 24
  77+ D8E5 32 2F E0                       LD   (Frog_TongueExpand), A
  78+ D8E8 3E 26                          LD   A, FROG_BALL_IDLE
  79+ D8EA 32 30 E0                       LD   (Frog_BallExpand), A
  80+ D8ED CD 4C 5F                       CALL GetCurrentFrogX
  81+ D8F0 22 3A E0                       LD   (Frog_PosX), HL
  82+ D8F3 22 24 7B                       LD   (Frog_PosStartX), HL
  83+ D8F6 CD 58 5F                       CALL GetCurrentFrogY
  84+ D8F9 22 3C E0                       LD   (Frog_PosY), HL
  85+ D8FC 22 26 7B                       LD   (Frog_PosStartY), HL
  86+ D8FF                                ; Initial ball colors via VDC RNG (already seeded by VDC_Init).
  87+ D8FF CD 69 CF                       CALL VDC_RandomColor
  88+ D902 32 AB 69                       LD   (Frog_BallColor), A
  89+ D905 CD 69 CF                       CALL VDC_RandomColor
  90+ D908 32 AC 69                       LD   (Frog_NextBallColor), A
