1746+ F52C A7                           AND  A
1747+ F52D ED 42                        SBC  HL, BC                             ; HL=delta low
1748+ F52F EB                           EX   DE, HL                             ; DE=delta low, HL=end high
1749+ F530 DD E5                        PUSH IX
1750+ F532 C1                           POP  BC                                 ; BC=start high
1751+ F533 ED 42                        SBC  HL, BC                             ; HL=delta high
1752+ F535                              ; Convert 32-bit delta HL:DE to 16-bit delta/1024.
1753+ F535                              ; result bits: low=(D>>2)|(L<<6), high=(L>>2)|((H&3)<<6)
1754+ F535 7A                           LD   A, D
1755+ F536 CB 3F                        SRL  A
1756+ F538 CB 3F                        SRL  A
1757+ F53A 4F                           LD   C, A
1758+ F53B 7D                           LD   A, L
1759+ F53C 87                           ADD  A, A
1760+ F53D 87                           ADD  A, A
1761+ F53E 87                           ADD  A, A
1762+ F53F 87                           ADD  A, A
1763+ F540 87                           ADD  A, A
1764+ F541 87                           ADD  A, A
1765+ F542 B1                           OR   C
1766+ F543 5F                           LD   E, A                               ; result low byte temp
1767+ F544 7D                           LD   A, L
1768+ F545 CB 3F                        SRL  A
1769+ F547 CB 3F                        SRL  A
1770+ F549 47                           LD   B, A
1771+ F54A 7C                           LD   A, H
1772+ F54B E6 03                        AND  3
1773+ F54D 0F                           RRCA
1774+ F54E 0F                           RRCA
1775+ F54F B0                           OR   B
