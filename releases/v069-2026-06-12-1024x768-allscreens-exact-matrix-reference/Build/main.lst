2036  3203 32 A8 69                     LD   (Core.NextLifeScore + 2), A
2037  3206 C9                           RET
2038  3207              ; ----------------------------------------------------------------------------
2039  3207              ; FormatScore24ToBuf — DrawNumBuf = decimal of VDC_PlayerScore (up to 8 digits,
2040  3207              ; leading zeros blanked to spaces, which render at zero width). Clobbers all.
2041  3207              ; ----------------------------------------------------------------------------
2042  3207              FormatScore24ToBuf:
2043  3207 2A A3 69                     LD   HL, (Core.VDC_PlayerScore)
2044  320A 22 A8 32                     LD   (Score24Work), HL
2045  320D 3A A5 69                     LD   A, (Core.VDC_PlayerScore + 2)
2046  3210 32 AA 32                     LD   (Score24Work + 2), A
2047  3213 DD 21 90 32                  LD   IX, Score24Divs
2048  3217 21 4D 33                     LD   HL, DrawNumBuf
2049  321A 22 AB 32                     LD   (Score24OutPtr), HL
2050  321D 06 08                        LD   B, 8                              ; 8 digit slots
2051  321F 0E 2F        .fs24_digit:    LD   C, '0' - 1
2052  3221 0C           .fs24_sub:      INC  C
2053  3222 3A A8 32                     LD   A, (Score24Work)
2053  3225 DD 96 00       SUB (IX+0)
2053  3228 32 A8 32       LD (Score24Work), A
2054  322B 3A A9 32                     LD   A, (Score24Work + 1)
2054  322E DD 9E 01       SBC A, (IX+1)
2054  3231 32 A9 32       LD (Score24Work + 1), A
2055  3234 3A AA 32                     LD   A, (Score24Work + 2)
2055  3237 DD 9E 02       SBC A, (IX+2)
2055  323A 32 AA 32       LD (Score24Work + 2), A
2056  323D 30 E2                        JR   NC, .fs24_sub                     ; no borrow -> subtract again
2057  323F 3A A8 32                     LD   A, (Score24Work)
2057  3242 DD 86 00       ADD A, (IX+0)
2057  3245 32 A8 32       LD (Score24Work), A    ; add divisor back once
2058  3248 3A A9 32                     LD   A, (Score24Work + 1)
2058  324B DD 8E 01       ADC A, (IX+1)
2058  324E 32 A9 32       LD (Score24Work + 1), A
2059  3251 3A AA 32                     LD   A, (Score24Work + 2)
2059  3254 DD 8E 02       ADC A, (IX+2)
2059  3257 32 AA 32       LD (Score24Work + 2), A
2060  325A 79                           LD   A, C
2061  325B 2A AB 32                     LD   HL, (Score24OutPtr)
2062  325E 77                           LD   (HL), A
2063  325F 23                           INC  HL
2064  3260 22 AB 32                     LD   (Score24OutPtr), HL
2065  3263 DD 23                        INC  IX
2065  3265 DD 23          INC IX
2065  3267 DD 23          INC IX
2066  3269 10 B4                        DJNZ .fs24_digit
2067  326B AF                           XOR  A
2068  326C 2A AB 32                     LD   HL, (Score24OutPtr)
2069  326F 77                           LD   (HL), A                           ; null terminate
2070  3270                              ; blank leading zeros (all but the last digit) -> space (zero width)
2071  3270 21 4D 33                     LD   HL, DrawNumBuf
2072  3273 06 07                        LD   B, 7
2073  3275 7E           .fs24_strip:    LD   A, (HL)
2074  3276 FE 30                        CP   '0'
2075  3278 C0                           RET  NZ
2076  3279 36 20                        LD   (HL), ' '
2077  327B 23                           INC  HL
2078  327C 10 F7                        DJNZ .fs24_strip
2079  327E C9                           RET
2080  327F              ; ----------------------------------------------------------------------------
2081  327F              ; DrawScore24 — format + draw VDC_PlayerScore at DrawStr_CurX / DrawStr_Y.
2082  327F              ; ----------------------------------------------------------------------------
2083  327F              DrawScore24:
2084  327F CD 07 32                     CALL FormatScore24ToBuf
2085  3282 21 4D 33                     LD   HL, DrawNumBuf
2086  3285 ED 4B 5B 30                  LD   BC, (DrawStr_CurX)
2087  3289 ED 5B 5D 30                  LD   DE, (DrawStr_Y)
2088  328D C3 A6 2F                     JP   DrawString
2089  3290
2090  3290 80 96 98     Score24Divs:    DB #80,#96,#98     ; 10000000
2091  3293 40 42 0F                     DB #40,#42,#0F     ; 1000000
2092  3296 A0 86 01                     DB #A0,#86,#01     ; 100000
2093  3299 10 27 00                     DB #10,#27,#00     ; 10000
2094  329C E8 03 00                     DB #E8,#03,#00     ; 1000
2095  329F 64 00 00                     DB #64,#00,#00     ; 100
2096  32A2 0A 00 00                     DB #0A,#00,#00     ; 10
2097  32A5 01 00 00                     DB #01,#00,#00     ; 1
2098  32A8 00 00 00     Score24Work:    DB 0,0,0
2099  32AB 00 00        Score24OutPtr:  DW 0
