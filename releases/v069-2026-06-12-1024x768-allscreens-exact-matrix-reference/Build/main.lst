 184+ C495              ; ---------------------------------------------------------------------
 185+ C495              ; Loader-level helpers.
 186+ C495              ;
 187+ C495              ; ZUMALVL.PAK layout:
 188+ C495              ;   sec 0       header  (magic ZLVP, version, count, sector_size)
 189+ C495              ;   sec 1       TOC[22] × 20 B   (bg/pal/track/title/preview off+size)
 190+ C495              ;   sec 2..N    data blob, per-level: bg → pal → track → title → preview
 191+ C495
 192+ C495              ZIFI_BUFFER_PAGE EQU #03               ; spgbld page reserved for ZiFi 512-B buffer
 193+ C495
 194+ C495              ; ---------------------------------------------------------------------
 195+ C495              ; RawPak_* — self-contained FAT32 reader over direct SD CMD18.
 196+ C495              ;
 197+ C495              ; This path intentionally bypasses the bundled WC CORE32 LOAD512 state. It
 198+ C495              ; supports both contiguous and fragmented files by following the FAT chain
 199+ C495              ; between every cluster. Current host image is superfloppy FAT32 with
 200+ C495              ; 512-byte sectors and spc=1; we validate that in RawPak_OpenRoot.
 201+ C495              ;
 202+ C495              ; Directory/file lookup matches by NAME, case-insensitive: it reconstructs the
 203+ C495              ; LONG name (LFN) when present, else the 8.3 short name, and compares to these
 204+ C495              ; targets. This is robust to whatever short alias the injector assigns (the
 205+ C495              ; observed bug was injector writing GAMES~1 while we searched "GAMES      ").
 206+ C495
 207+ C495              RAWPAK_NAME_PAK:
 208+ C495 5A 55 4D 41                  DEFB "ZUMALVL.PAK", 0
 208+ C499 4C 56 4C 2E
 208+ C49D 50 41 4B 00
 209+ C4A1              RAWPAK_NAME_AUDIO:
 210+ C4A1 5A 55 4D 41                  DEFB "ZUMAAUD.PAK", 0
 210+ C4A5 41 55 44 2E
 210+ C4A9 50 41 4B 00
 211+ C4AD              RAWPAK_NAME_SOUND:
 212+ C4AD 5A 55 4D 41                  DEFB "ZUMASND.PAK", 0
 212+ C4B1 53 4E 44 2E
 212+ C4B5 50 41 4B 00
 213+ C4B9              RAWPAK_NAME_MAIN:
 214+ C4B9 5A 55 4D 41                  DEFB "ZUMAMAIN.PAK", 0
 214+ C4BD 4D 41 49 4E
 214+ C4C1 2E 50 41 4B
 214+ C4C5 00
 215+ C4C6              RAWPAK_NAME_BOOT:                               ; HOBETA WC loader в корне SD (для Quit)
 216+ C4C6 42 4F 4F 54                  DEFB "BOOT.$C", 0
 216+ C4CA 2E 24 43 00
 217+ C4CE              RAWPAK_BOOT_SIZE EQU 31761
 218+ C4CE
 219+ C4CE              ; DBG instrumentation (read in F12 dump to bisect a failed open; addresses are
 220+ C4CE              ; resident in loader_resident.asm — ZiFi_DbgGamesA #6432, GpDbgStep #642D):
 221+ C4CE              ;   ZiFi_DbgGamesA = RawPak open granular step:
 222+ C4CE              ;       #20 entry, #21 sector0 read OK, #22 BPB valid, #26 search start, #25 PAK found;
 223+ C4CE              ;       #A1 sector0 CMD err, #A2 BPB invalid (bps!=512 / no FAT32 partition),
 224+ C4CE              ;       #A3 spc=0, #A6 PAK (name+size) not found anywhere, #A7 run-table overflow.
 225+ C4CE              ;   ZiFi_DbgGamesFound = directories visited during the recursive search.
 226+ C4CE              RawPak_OpenRoot:
 227+ C4CE 3E 20                        LD   A, #20
 228+ C4D0 32 6A 6A                     LD   (ZiFi_DbgGamesA), A
 229+ C4D3 AF                           XOR  A
 230+ C4D4 32 6B 6A                     LD   (ZiFi_DbgGamesFound), A
 231+ C4D7                              ; Invalidate the FAT-sector cache (FatBufLba = #FFFFFFFF). The cache
 232+ C4D7                              ; in RawPak_FatNext skips re-reading a FAT sector already in FatBuf;
 233+ C4D7                              ; the FAT is read-only for us, so it stays valid for the whole session.
 234+ C4D7 21 FF FF                     LD   HL, #FFFF
 235+ C4DA 22 D1 D0                     LD   (RawPak_FatBufLba + 0), HL
 236+ C4DD 22 D3 D0                     LD   (RawPak_FatBufLba + 2), HL
 237+ C4E0                              ; --- Read sector 0 (boot sector OR MBR). LBA 0 is addressing-
 238+ C4E0                              ; agnostic (arg 0 either way), so this read works before we know
 239+ C4E0                              ; block vs byte. Then mirror ChkDsk: scan the MBR partition table;
 240+ C4E0                              ; a real card is MBR-partitioned + SDHC (block-addressed), Unreal is
 241+ C4E0                              ; a superfloppy (no table) + byte-addressed.
 242+ C4E0 21 00 00                     LD   HL, 0
 243+ C4E3 11 00 00                     LD   DE, 0
 244+ C4E6 CD 92 CB                     CALL RawPak_ReadSectorBuffer
 245+ C4E9 DA 6C C6                     JP   C, .ErrBpbRead
 246+ C4EC 3E 21                        LD   A, #21
 247+ C4EE 32 6A 6A                     LD   (ZiFi_DbgGamesA), A
 248+ C4F1 AF                           XOR  A                          ; part_lba = 0 (superfloppy: sector 0 is the BPB)
 249+ C4F2 32 B5 CE                     LD   (RawPak_PartLba + 0), A
 250+ C4F5 32 B6 CE                     LD   (RawPak_PartLba + 1), A
 251+ C4F8 32 B7 CE                     LD   (RawPak_PartLba + 2), A
 252+ C4FB 32 B8 CE                     LD   (RawPak_PartLba + 3), A
 253+ C4FE                              ; Is sector 0 itself a FAT32 BPB (bytes/sector == 512)? Then this is
 254+ C4FE                              ; a superfloppy (Unreal) -> use sector 0 as BPB, byte addressing.
 255+ C4FE                              ; Otherwise it is an MBR -> scan the partition table. (Checking the
 256+ C4FE                              ; BPB first avoids false-matching boot-code bytes at offset 446.)
 257+ C4FE DD 21 00 80                  LD   IX, #8000
 258+ C502 DD 7E 0B                     LD   A, (IX + 11)
 259+ C505 B7                           OR   A
 260+ C506 20 07                        JR   NZ, .tryMbr
 261+ C508 DD 7E 0C                     LD   A, (IX + 12)
 262+ C50B FE 02                        CP   2
 263+ C50D 28 3E                        JR   Z, .bpbReady               ; sector 0 is a 512-B/sector BPB -> superfloppy
 264+ C50F DD 21 BE 81  .tryMbr:       LD   IX, #8000 + 446            ; MBR partition table: 4 entries x 16 B
 265+ C513 06 04                        LD   B, 4
 266+ C515 DD 7E 04     .mbrScan:      LD   A, (IX + 4)                 ; partition type
 267+ C518 FE 0B                        CP   #0B                         ; FAT32 (CHS)
 268+ C51A 28 0E                        JR   Z, .havePart
 269+ C51C FE 0C                        CP   #0C                         ; FAT32 (LBA)
 270+ C51E 28 0A                        JR   Z, .havePart
 271+ C520 11 10 00                     LD   DE, 16
 272+ C523 DD 19                        ADD  IX, DE
 273+ C525 10 EE                        DJNZ .mbrScan
 274+ C527 C3 70 C6                     JP   .ErrBps                    ; not a BPB and no FAT32 partition entry
 275+ C52A DD 7E 08     .havePart:     LD   A, (IX + 8)
 275+ C52D 32 B5 CE       LD (RawPak_PartLba + 0), A   ; partition start LBA
 276+ C530 DD 7E 09                     LD   A, (IX + 9)
 276+ C533 32 B6 CE       LD (RawPak_PartLba + 1), A
 277+ C536 DD 7E 0A                     LD   A, (IX + 10)
 277+ C539 32 B7 CE       LD (RawPak_PartLba + 2), A
 278+ C53C DD 7E 0B                     LD   A, (IX + 11)
 278+ C53F 32 B8 CE       LD (RawPak_PartLba + 3), A
 279+ C542                              ; Найден MBR-раздел => это реальная SDHC-карта => блочная адресация
 280+ C542                              ; АВТОРИТЕТНА. НЕ откатываемся на байтовую: байтовый режим на SDHC шлёт
 281+ C542                              ; неверные адреса блоков и может вывести карту из строя (восстановление
 282+ C542                              ; только физическим переткиванием). Откат на byte допустим лишь для
 283+ C542                              ; настоящего superfloppy (там ветка .bpbReady достигается напрямую с
 284+ C542                              ; sd_blkt=0). Раньше тут был откат на byte — он и кирпичил 32 ГБ карту.
 285+ C542 3E 01                        LD   A, 1
 286+ C544 32 0A C4                     LD   (sd_blkt), A
 287+ C547 CD 30 CC                     CALL RawPak_ReadPartBpb
 288+ C54A DA 70 C6                     JP   C, .ErrBps
 289+ C54D DD 21 00 80  .bpbReady:     LD   IX, #8000
 290+ C551                              ; Require 512-byte sectors and a non-zero sectors/cluster value.
 291+ C551 DD 7E 0B                     LD   A, (IX + 11)
 292+ C554 B7                           OR   A
 293+ C555 C2 70 C6                     JP   NZ, .ErrBps
 294+ C558 DD 7E 0C                     LD   A, (IX + 12)
 295+ C55B FE 02                        CP   2
 296+ C55D C2 70 C6                     JP   NZ, .ErrBps
 297+ C560 DD 7E 0D                     LD   A, (IX + 13)
 298+ C563 B7                           OR   A
 299+ C564 CA 74 C6                     JP   Z, .ErrSpc
 300+ C567 32 29 CE                     LD   (RawPak_Spc), A
 301+ C56A 3E 22                        LD   A, #22
 302+ C56C 32 6A 6A                     LD   (ZiFi_DbgGamesA), A
 303+ C56F                              ; fatstart = part_lba + reserved sectors (16-bit in BPB)
 304+ C56F 21 B5 CE                     LD   HL, RawPak_PartLba
 305+ C572 11 B9 CE                     LD   DE, RawPak_FatStart
 306+ C575 CD 05 CE                     CALL RawPak_Copy32
 307+ C578 DD 7E 0E                     LD   A, (IX + 14)
 307+ C57B 32 CD CE       LD (RawPak_Tmp + 0), A
 308+ C57E DD 7E 0F                     LD   A, (IX + 15)
 308+ C581 32 CE CE       LD (RawPak_Tmp + 1), A
 309+ C584 AF                           XOR  A
 309+ C585 32 CF CE       LD (RawPak_Tmp + 2), A
 309+ C588 32 D0 CE       LD (RawPak_Tmp + 3), A
 310+ C58B 21 CD CE                     LD   HL, RawPak_Tmp
 311+ C58E 11 B9 CE                     LD   DE, RawPak_FatStart
 312+ C591 CD 0D CE                     CALL RawPak_Add32
 313+ C594                              ; datastart = fatstart + numFATs * FATSz32
 314+ C594 21 B9 CE                     LD   HL, RawPak_FatStart
 315+ C597 11 BD CE                     LD   DE, RawPak_DataStart
 316+ C59A CD 05 CE                     CALL RawPak_Copy32
 317+ C59D DD 7E 10                     LD   A, (IX + 16)
 318+ C5A0 47                           LD   B, A
 319+ C5A1 C5           .fatLoop:      PUSH BC
 320+ C5A2 DD 7E 24                     LD   A, (IX + 36)
 320+ C5A5 32 CD CE       LD (RawPak_Tmp + 0), A
 321+ C5A8 DD 7E 25                     LD   A, (IX + 37)
 321+ C5AB 32 CE CE       LD (RawPak_Tmp + 1), A
 322+ C5AE DD 7E 26                     LD   A, (IX + 38)
 322+ C5B1 32 CF CE       LD (RawPak_Tmp + 2), A
 323+ C5B4 DD 7E 27                     LD   A, (IX + 39)
 323+ C5B7 32 D0 CE       LD (RawPak_Tmp + 3), A
 324+ C5BA 21 CD CE                     LD   HL, RawPak_Tmp
 325+ C5BD 11 BD CE                     LD   DE, RawPak_DataStart
 326+ C5C0 CD 0D CE                     CALL RawPak_Add32
 327+ C5C3 C1                           POP  BC
 328+ C5C4 10 DB                        DJNZ .fatLoop
 329+ C5C6                              ; root cluster
 330+ C5C6 DD 7E 2C                     LD   A, (IX + 44)
 330+ C5C9 32 C1 CE       LD (RawPak_RootClus + 0), A
 331+ C5CC DD 7E 2D                     LD   A, (IX + 45)
 331+ C5CF 32 C2 CE       LD (RawPak_RootClus + 1), A
 332+ C5D2 DD 7E 2E                     LD   A, (IX + 46)
 332+ C5D5 32 C3 CE       LD (RawPak_RootClus + 2), A
 333+ C5D8 DD 7E 2F                     LD   A, (IX + 47)
 333+ C5DB 32 C4 CE       LD (RawPak_RootClus + 3), A
 334+ C5DE                              ; --- граница тома для защиты SD: sd_lba_max = PartLba + BPB_TotSec32.
 335+ C5DE                              ; Любой LBA >= границы отбивается в sd_read_sector (CF=1), не уходя в
 336+ C5DE                              ; карту как CMD17. 0 = выключено (если TotSec32 почему-то нулевой).
 337+ C5DE AF                           XOR  A
 338+ C5DF 32 0B C4                     LD   (sd_lba_max + 0), A
 339+ C5E2 32 0C C4                     LD   (sd_lba_max + 1), A
 340+ C5E5 32 0D C4                     LD   (sd_lba_max + 2), A
 341+ C5E8 32 0E C4                     LD   (sd_lba_max + 3), A
 342+ C5EB DD 7E 20                     LD   A, (IX + 32)
 342+ C5EE 32 CD CE       LD (RawPak_Tmp + 0), A
 342+ C5F1 4F             LD C, A
 343+ C5F2 DD 7E 21                     LD   A, (IX + 33)
 343+ C5F5 32 CE CE       LD (RawPak_Tmp + 1), A
 343+ C5F8 B1             OR C
 343+ C5F9 4F             LD C, A
 344+ C5FA DD 7E 22                     LD   A, (IX + 34)
 344+ C5FD 32 CF CE       LD (RawPak_Tmp + 2), A
 344+ C600 B1             OR C
 344+ C601 4F             LD C, A
 345+ C602 DD 7E 23                     LD   A, (IX + 35)
 345+ C605 32 D0 CE       LD (RawPak_Tmp + 3), A
 345+ C608 B1             OR C
 346+ C609 28 12                        JR   Z, .noVolGuard                     ; TotSec32==0 -> защиту не включаем
 347+ C60B 21 B5 CE                     LD   HL, RawPak_PartLba
 348+ C60E 11 0B C4                     LD   DE, sd_lba_max
 349+ C611 CD 05 CE                     CALL RawPak_Copy32                      ; sd_lba_max = PartLba
 350+ C614 21 CD CE                     LD   HL, RawPak_Tmp
 351+ C617 11 0B C4                     LD   DE, sd_lba_max
 352+ C61A CD 0D CE                     CALL RawPak_Add32                       ; sd_lba_max += TotSec32
 353+ C61D              .noVolGuard:
 354+ C61D                              ; --- locate ZUMALVL.PAK. Fast path: reuse WC's active-panel
 355+ C61D                              ; path from page #F7, then fall back to a whole-card DFS.
 356+ C61D 3E 26                        LD   A, #26
 357+ C61F 32 6A 6A                     LD   (ZiFi_DbgGamesA), A
 358+ C622 3A 60 D5                     LD   A, (RawPak_CachedValid)   ; reuse the location found earlier this session
 359+ C625 B7                           OR   A
 360+ C626 28 0B                        JR   Z, .search
 361+ C628 21 61 D5                     LD   HL, RawPak_CachedPakClus
 362+ C62B 11 C5 CE                     LD   DE, RawPak_FileStartClus
 363+ C62E CD 05 CE                     CALL RawPak_Copy32
 364+ C631 18 25                        JR   .haveFile
 365+ C633 CD 79 C7     .search:       CALL RawPak_TryWcPath
 366+ C636 38 0F                        JR   C, .cacheFound
 367+ C638                              IF RAWPAK_WC_PATH_ONLY
 368+ C638 ~                            JP   .ErrPak
 369+ C638                              ENDIF
 370+ C638 21 C1 CE                     LD   HL, RawPak_RootClus
 371+ C63B 11 C9 CE                     LD   DE, RawPak_CurClus
 372+ C63E CD 05 CE                     CALL RawPak_Copy32
 373+ C641 CD 7F C6                     CALL RawPak_FindPakRecursive   ; DFS whole tree -> RawPak_FileStartClus
 374+ C644 D2 78 C6                     JP   NC, .ErrPak
 375+ C647              .cacheFound:
 376+ C647 21 C5 CE                     LD   HL, RawPak_FileStartClus  ; cache for subsequent opens this session
 377+ C64A 11 61 D5                     LD   DE, RawPak_CachedPakClus
 378+ C64D CD 05 CE                     CALL RawPak_Copy32
 379+ C650 3E 01                        LD   A, 1
 380+ C652 32 60 D5                     LD   (RawPak_CachedValid), A
 381+ C655 32 12 6C                     LD   (LevelsMapLoaded), A      ; resident flag: skip "LOADING LEVELS..." next time
 382+ C658 3E 25        .haveFile:     LD   A, #25
 383+ C65A 32 6A 6A                     LD   (ZiFi_DbgGamesA), A
 384+ C65D CD 16 CA                     CALL RawPak_Seek0
 385+ C660 CD 57 CC                     CALL RawPak_BuildRunTable      ; build extent (run) table — handles fragmentation
 386+ C663 D2 68 C6                     JP   NC, .ErrRuns              ; table overflow / chain error -> fallback
 387+ C666 37                           SCF
 388+ C667 C9                           RET
 389+ C668 3E A7        .ErrRuns:      LD   A, #A7
 390+ C66A 18 0E                        JR   .ErrSet
 391+ C66C 3E A1        .ErrBpbRead:   LD   A, #A1
 392+ C66E 18 0A                        JR   .ErrSet
 393+ C670 3E A2        .ErrBps:       LD   A, #A2
 394+ C672 18 06                        JR   .ErrSet
 395+ C674 3E A3        .ErrSpc:       LD   A, #A3
 396+ C676 18 02                        JR   .ErrSet
 397+ C678 3E A6        .ErrPak:       LD   A, #A6                     ; ZUMALVL.PAK (name+size) not found anywhere
 398+ C67A 32 6A 6A     .ErrSet:       LD   (ZiFi_DbgGamesA), A
 399+ C67D B7           .Err:          OR   A
 400+ C67E C9                           RET
 401+ C67F
 402+ C67F              ; (RawPak_FindInCurrentDir and the fixed /Games/Zuma Deluxe VDAC2/ path were
 403+ C67F              ;  removed — the loader now finds ZUMALVL.PAK only via RawPak_FindPakRecursive,
 404+ C67F              ;  by name + size in any folder. Single code path.)
 405+ C67F
 406+ C67F              ; ============================================================================
 407+ C67F              ; RawPak_FindPakRecursive — depth-first search of the WHOLE FAT32 tree from the
 408+ C67F              ; root for a file named "ZUMALVL.PAK" whose size == EXPECTED_PAK_SIZE. Lets the
 409+ C67F              ; pack live in any folder (a real card may not use /Games/Zuma Deluxe VDAC2/).
 410+ C67F              ; Out: CF=1 found (RawPak_FileStartClus set); CF=0 not found / SD error.
 411+ C67F              ; Reads EVERY sector of each directory cluster (via AdvanceOne), so it is correct
 412+ C67F              ; for spc>1 cards (the old per-cluster-first-sector scan missed entries at spc=64).
 413+ C67F              ; Result is cached by the caller, so the (potentially slow) walk runs once/session.
 414+ C67F              ; ============================================================================
 415+ C67F              RawPak_FindPakRecursive:
 416+ C67F 21 95 C4                     LD   HL, RAWPAK_NAME_PAK        ; target = "ZUMALVL.PAK" uppercased
 417+ C682 11 2F CE                     LD   DE, RawPak_TargetName
 418+ C685 7E           .cpyt:         LD   A, (HL)
 419+ C686 CD 61 C9                     CALL RawPak_Upcase
 420+ C689 12                           LD   (DE), A
 421+ C68A 23                           INC  HL
 422+ C68B 13                           INC  DE
 423+ C68C B7                           OR   A
 424+ C68D 20 F6                        JR   NZ, .cpyt
 425+ C68F 3E 01                        LD   A, 1
 426+ C691 32 AF CE                     LD   (RawPak_CheckSize), A      ; PAK: совпадение по имени И точному размеру
 427+ C694              ; RawPak_FindByName — DFS дерева FAT по RawPak_TargetName (+опц. размер). Вызывающий
 428+ C694              ; заранее ставит RawPak_TargetName (upcase, zero-term) и RawPak_CheckSize (0=только имя,
 429+ C694              ; 1=имя+EXPECTED_PAK_SIZE). Out: CF=1 найдено (RawPak_FileStartClus + RawPak_FoundSize),
 430+ C694              ; CF=0 нет/ошибка SD.
 431+ C694              RawPak_FindByName:
 432+ C694 AF                           XOR  A
 433+ C695 32 DF D3                     LD   (RawPak_DirStackCnt), A
 434+ C698 32 6B 6A                     LD   (ZiFi_DbgGamesFound), A
 435+ C69B 21 C1 CE                     LD   HL, RawPak_RootClus        ; seed the DFS stack with the root dir
 436+ C69E CD 23 C9                     CALL RawPak_DirStackPush
 437+ C6A1 CD 42 C9     .popLoop:      CALL RawPak_DirStackPop         ; CurClus = next dir; CF=1 if stack empty
 438+ C6A4 DA 77 C7                     JP   C, .notFound
 439+ C6A7 3A 6B 6A                     LD   A, (ZiFi_DbgGamesFound)    ; diag: count dirs visited
 440+ C6AA 3C                           INC  A
 441+ C6AB 32 6B 6A                     LD   (ZiFi_DbgGamesFound), A
 442+ C6AE AF                           XOR  A
 443+ C6AF 32 2A CE                     LD   (RawPak_CurSecInClus), A
 444+ C6B2 32 B4 CE                     LD   (RawPak_HaveLfn), A
 445+ C6B5 CD 2E CB     .sec:          CALL RawPak_CurrentLbaRegs
 446+ C6B8 CD 92 CB                     CALL RawPak_ReadSectorBuffer    ; dir sector -> slot 2 #8000, IX=#8000
 447+ C6BB DA 77 C7                     JP   C, .notFound               ; SD error -> abort the search
 448+ C6BE DD 21 00 80                  LD   IX, #8000
 449+ C6C2 DD 7E 00     .entry:        LD   A, (IX + 0)
 450+ C6C5 B7                           OR   A
 451+ C6C6 CA 6F C7                     JP   Z, .dirDone                ; 0x00 = end of this directory
 452+ C6C9 FE E5                        CP   #E5
 453+ C6CB CA 54 C7                     JP   Z, .skip                   ; deleted entry (JP: цели сдвинулись > ±128)
 454+ C6CE DD 7E 0B                     LD   A, (IX + 11)
 455+ C6D1 FE 0F                        CP   #0F
 456+ C6D3 CA 72 C7                     JP   Z, .lfnFrag                ; LFN fragment -> accumulate
 457+ C6D6 DD 7E 0B                     LD   A, (IX + 11)
 458+ C6D9 E6 08                        AND  #08
 459+ C6DB 20 77                        JR   NZ, .skip                  ; volume label -> skip
 460+ C6DD DD 7E 0B                     LD   A, (IX + 11)
 461+ C6E0 E6 10                        AND  #10
 462+ C6E2 20 4B                        JR   NZ, .isDir                 ; subdirectory
 463+ C6E4                              ; --- regular file: match name, then exact size ---
 464+ C6E4 3A B4 CE                     LD   A, (RawPak_HaveLfn)
 465+ C6E7 B7                           OR   A
 466+ C6E8 20 03                        JR   NZ, .haveName
 467+ C6EA CD 6A C9                     CALL RawPak_Build83
 468+ C6ED CD 9A C9     .haveName:     CALL RawPak_NameMatch           ; Z if name == RawPak_TargetName
 469+ C6F0 20 62                        JR   NZ, .skip
 470+ C6F2 3A AF CE                     LD   A, (RawPak_CheckSize)
 471+ C6F5 B7                           OR   A
 472+ C6F6 28 05                        JR   Z, .sizeOk                 ; CheckSize=0 → совпадение только по имени
 473+ C6F8 CD 0B C9                     CALL RawPak_CheckPakSize        ; Z if file size == EXPECTED_PAK_SIZE
 474+ C6FB 20 57                        JR   NZ, .skip
 475+ C6FD DD 7E 1A     .sizeOk:       LD   A, (IX + 26)
 475+ C700 32 C5 CE       LD (RawPak_FileStartClus + 0), A
 476+ C703 DD 7E 1B                     LD   A, (IX + 27)
 476+ C706 32 C6 CE       LD (RawPak_FileStartClus + 1), A
 477+ C709 DD 7E 14                     LD   A, (IX + 20)
 477+ C70C 32 C7 CE       LD (RawPak_FileStartClus + 2), A
 478+ C70F DD 7E 15                     LD   A, (IX + 21)
 478+ C712 32 C8 CE       LD (RawPak_FileStartClus + 3), A
 479+ C715 DD 7E 1C                     LD   A, (IX + 28)
 479+ C718 32 B0 CE       LD (RawPak_FoundSize + 0), A    ; размер файла (байт, LE)
 480+ C71B DD 7E 1D                     LD   A, (IX + 29)
 480+ C71E 32 B1 CE       LD (RawPak_FoundSize + 1), A
 481+ C721 DD 7E 1E                     LD   A, (IX + 30)
 481+ C724 32 B2 CE       LD (RawPak_FoundSize + 2), A
 482+ C727 DD 7E 1F                     LD   A, (IX + 31)
 482+ C72A 32 B3 CE       LD (RawPak_FoundSize + 3), A
 483+ C72D 37                           SCF
 484+ C72E C9                           RET
 485+ C72F DD 7E 00     .isDir:        LD   A, (IX + 0)                ; skip "." and ".." (and any dot-leading)
 486+ C732 FE 2E                        CP   '.'
 487+ C734 28 1E                        JR   Z, .skip
 488+ C736 DD 7E 1A                     LD   A, (IX + 26)
 488+ C739 32 CD CE       LD (RawPak_Tmp + 0), A
 489+ C73C DD 7E 1B                     LD   A, (IX + 27)
 489+ C73F 32 CE CE       LD (RawPak_Tmp + 1), A
 490+ C742 DD 7E 14                     LD   A, (IX + 20)
 490+ C745 32 CF CE       LD (RawPak_Tmp + 2), A
 491+ C748 DD 7E 15                     LD   A, (IX + 21)
 491+ C74B 32 D0 CE       LD (RawPak_Tmp + 3), A
 492+ C74E 21 CD CE                     LD   HL, RawPak_Tmp
 493+ C751 CD 23 C9                     CALL RawPak_DirStackPush        ; push subdir (silently dropped if stack full)
 494+ C754 AF           .skip:         XOR  A
 495+ C755 32 B4 CE                     LD   (RawPak_HaveLfn), A
 496+ C758 11 20 00     .next:         LD   DE, 32
