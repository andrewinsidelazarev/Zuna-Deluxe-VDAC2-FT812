1171+ CC57              ; --- Sector-run table (handles both contiguous AND fragmented PAK) ----------
1172+ CC57              ; Requirement: read the PAK whether it is one contiguous run or fragmented.
1173+ CC57              ; The old fast path assumed contiguity (LBA = PakLba + N) — true on a freshly
1174+ CC57              ; built image, but a fragmented file would read the wrong sectors on the upper
1175+ CC57              ; levels. Instead we walk the FAT chain once at open time and record the file as
1176+ CC57              ; a list of extents (runs) {LBA, len_sectors}: a contiguous file collapses to a
1177+ CC57              ; single run, a fragmented one to several. RawPak_ReadOneLogicalIX then maps a
1178+ CC57              ; logical sector to a physical LBA via this table — O(runs), no per-read FAT
1179+ CC57              ; walk, so a section still reads in one SD burst (no FT.WriteMem interleaving).
1180+ CC57
1181+ CC57              RAWPAK_RUN_MAX  EQU 128                ; max extents (128 * 6 = 768 B). Overflow -> open fails -> L1 fallback.
1182+ CC57
1183+ CC57              ; RawPak_BuildRunTable — walk the chain from RawPak_FileStartClus, fill
1184+ CC57              ; RawPak_RunTable / RawPak_RunCount. CurSecInClus must be 0 (set by Seek0).
1185+ CC57              ; Out: CF=1 ok; CF=0 on run-table overflow (heavily fragmented) or SD error.
1186+ CC57              ;
1187+ CC57              ; Scans the FAT *directly*, not via RawPak_FatNext: it keeps a pointer into
1188+ CC57              ; RawPak_FatBuf and reads consecutive 4-byte FAT entries, only recomputing the
1189+ CC57              ; FAT-sector LBA (the expensive cluster>>7) when it crosses a 128-entry sector
1190+ CC57              ; boundary or follows a non-sequential link. A contiguous PAK (the common case)
1191+ CC57              ; then costs ~ one FAT-sector read per 128 clusters and a tight inner loop —
1192+ CC57              ; instead of a full cluster>>7 + 32-bit shift chain per cluster.
1193+ CC57              RawPak_BuildRunTable:
1194+ CC57 21 C5 CE                     LD   HL, RawPak_FileStartClus
1195+ CC5A 11 C9 CE                     LD   DE, RawPak_CurClus
1196+ CC5D CD 05 CE                     CALL RawPak_Copy32
1197+ CC60 AF                           XOR  A
1198+ CC61 32 2A CE                     LD   (RawPak_CurSecInClus), A
1199+ CC64                              ; --- first run: LBA = LBA(FileStartClus), len starts at 0 ---
1200+ CC64 DD 21 DC D0                  LD   IX, RawPak_RunTable
1201+ CC68 CD 2E CB                     CALL RawPak_CurrentLbaRegs      ; HL = LBA lo16, DE = LBA hi16
1202+ CC6B DD 75 00                     LD   (IX + 0), L
1203+ CC6E DD 74 01                     LD   (IX + 1), H
1204+ CC71 DD 73 02                     LD   (IX + 2), E
1205+ CC74 DD 72 03                     LD   (IX + 3), D
1206+ CC77 DD 36 04 00                  LD   (IX + 4), 0
1207+ CC7B DD 36 05 00                  LD   (IX + 5), 0
1208+ CC7F 3E 01                        LD   A, 1
1209+ CC81 32 DB D0                     LD   (RawPak_RunCount), A
1210+ CC84 DD E5                        PUSH IX                          ; FatEntryPtr->ReadFatSector clobbers IX
1211+ CC86 CD 55 CD                     CALL RawPak_FatEntryPtr          ; HL -> FAT[CurClus] in FatBuf
