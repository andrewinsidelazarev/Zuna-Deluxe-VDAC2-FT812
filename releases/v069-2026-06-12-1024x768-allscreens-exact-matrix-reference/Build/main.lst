  11  0000
  12  0000                              DEVICE ZXSPECTRUM4096
  13  0000                              define MAPPING_REGISTERS              ; реестры через FMADDR_REGS
  14  0000
  15  0000              ; ----------------------------------------------------------------------------
  16  0000              ; FT command buffer: TSLib дефолтит на #C000 (slot 3). После main0/main1 split
  17  0000              ; main1_play код живёт в slot 3 → буфер перекрывает код → corruption за кадр.
  18  0000              ; Keep it in slot 1 RAM before EntryPoint; #6000 is code now.
  19  0000              ; ----------------------------------------------------------------------------
  20  0000                              ; 1024×768: база сдвинута #5010→#4C90 (ball-cache ужат 240→128 слотов,
  21  0000                              ; GAMELOG переехал). Кадровый CMD-буфер: #4C90..#5C00 = 3952 байта —
  22  0000                              ; полная анимация (worst dual+tunnel замерен 2872б, тест
  23  0000                              ; test_cmd_buffer_budget_z80.py) + запас.
  24  0000                              define CMD_ADDRESS_PTR #4CB0
  25  0000
