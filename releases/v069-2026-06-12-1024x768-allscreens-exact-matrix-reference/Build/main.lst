1031+ C686              .spawn_roll_new:
1032+ C686 CD 69 CF                     CALL VDC_RandomColor                   ; A = gate roll 0..NUM-1
1033+ C689 CB 47                        BIT  0, A                              ; odd/even ≈ 50/50 for NUM=6
1034+ C68B 28 13                        JR   Z, .spawn_single_random           ; 50% single random ball
1035+ C68D                              ; cluster path — reroll color until != предыдущий cluster.
1036+ C68D                              ; (VDC_SpawnClusterColor) = previous color (or sentinel #FF на init).
1037+ C68D              .cluster_color_reroll:
1038+ C68D CD 69 CF                     CALL VDC_RandomColor                   ; chain color candidate
1039+ C690 21 60 D3                     LD   HL, VDC_SpawnClusterColor
