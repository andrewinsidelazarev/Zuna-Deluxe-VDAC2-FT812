 220+ D1DE FE 03                        CP   3
 221+ D1E0 30 04                        JR   NC, .chk_down                         ; уже Sun God (3, верх)
 222+ D1E2 3C                           INC  A
 223+ D1E3 32 8F 69                     LD   (CurrentDifficulty), A
 224+ D1E6              .chk_down:      ; Вниз — к нижнему бейджу (Rabbit): CurrentDifficulty--, clamp 0
 225+ D1E6 CD 7D 7D                     CALL Input_Down
 226+ D1E9 21 FD F2                     LD   HL, LevelSelectKbdDownPrev
 227+ D1EC CD C5 7D                     CALL Input_EdgeZ
