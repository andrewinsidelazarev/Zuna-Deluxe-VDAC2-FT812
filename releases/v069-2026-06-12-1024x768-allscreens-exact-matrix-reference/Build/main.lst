 127+ CFC9                              macro LevelSelectCheckControl X?, Y?, W?, H?, State?, ClickVar?
 128+ CFC9 ~                            ; 1024×768: hit-box ×8/5 (мышь в экранных 1024-координатах)
 129+ CFC9 ~                            LD   BC, X? * 8 / 5
 130+ CFC9 ~                            LD   DE, (X? + W?) * 8 / 5
 131+ CFC9 ~                            LD   IX, Y? * 8 / 5
 132+ CFC9 ~                            LD   IY, (Y? + H?) * 8 / 5
 133+ CFC9 ~                            CALL MenuPointInside
 134+ CFC9 ~                            LD   A, C
 135+ CFC9 ~                            OR   A
 136+ CFC9 ~                            JR   Z, .outside?
 137+ CFC9 ~                            LD   A, (LevelSelectLmbNow)
 138+ CFC9 ~                            OR   A
 139+ CFC9 ~                            LD   A, 1
 140+ CFC9 ~                            JR   Z, .store?
 141+ CFC9 ~                            INC  A
 142+ CFC9 ~            .store?:        LD   (State?), A
 143+ CFC9 ~                            if ClickVar?
 144+ CFC9 ~                            CP   1
 145+ CFC9 ~                            JR   NZ, .outside?
 146+ CFC9 ~                            LD   A, (LevelSelectLmbPrev)
 147+ CFC9 ~                            CP   1
 148+ CFC9 ~                            JR   NZ, .outside?
 149+ CFC9 ~                            LD   A, 1
 150+ CFC9 ~                            LD   (ClickVar?), A
 151+ CFC9 ~                            LD   A, SND_BUTTON1
 152+ CFC9 ~                            CALL GS_PlaySfx
 153+ CFC9 ~                            endif
 154+ CFC9 ~            .outside?:
 155+ CFC9                              endm
