2655+ CF69              ; ============================================================================
2656+ CF69              ; VDC_DivHLbyA — целочисленное деление 16-bit на 8-bit.
2657+ CF69              ;   In:  HL = dividend (unsigned), A = divisor (unsigned, > 0)
2658+ CF69              ;   Out: HL = quotient, A = remainder
2659+ CF69              ;   Clobbers BC.
2660+ CF69              ; Bit-by-bit алгоритм. ~80 t-states, ~16 байт кода.
2661+ CF69              ; ============================================================================
2662+ CF69              ; [VDC_DivHLbyA -> moved to shared_render.asm (resident; shared by gameplay #04 + level-select #41)]
2663+ CF69              VDC_RandomColor:
2664+ CF69                              ; Mul-then-shift: A = ((L XOR H) * NUM_COLORS) >> 8 = 0..NUM-1.
2665+ CF69                              ; Старый AND 7 + reject имел LFSR-bias для poly 0xB400: (L XOR H) & 7
2666+ CF69                              ; почти не выдавал значения 2 и 5 (биты коррелированы) → цвета 2 и 5
2667+ CF69                              ; не появлялись в цепи. Mul-then-shift bias ≤ 1.4% при NUM=6.
2668+ CF69                              ; Fix 2026-05-18.
2669+ CF69 2A 8E D3                     LD   HL, (VDC_LfsrSeed)
2670+ CF6C 7D                           LD   A, L
2671+ CF6D E6 01                        AND  1
2672+ CF6F CB 3C                        SRL  H
2672+ CF71 CB 1D          RR L
2673+ CF73 30 04                        JR   NC, .rc_no_xor
2674+ CF75 7C                           LD   A, H
2674+ CF76 EE B4          XOR #B4
2674+ CF78 67             LD H, A          ; poly #B400 (low=0)
2675+ CF79              .rc_no_xor:
2676+ CF79 22 8E D3                     LD   (VDC_LfsrSeed), HL
2677+ CF7C 7D                           LD   A, L
2678+ CF7D AC                           XOR  H                                 ; A = 8-bit random
2679+ CF7E 6F                           LD   L, A
2680+ CF7F 26 00                        LD   H, 0                              ; HL = rand byte (0..255)
2681+ CF81 3A 6D D3                     LD   A, (VDC_LevelColors)              ; per-level color count (set in VDC_Init)
2682+ CF84 CD 4B F1                     CALL ZL_Mul16x8                        ; HL = rand * N (max 6*255 = 1530)
2683+ CF87 7C                           LD   A, H                              ; A = (rand * N) >> 8 = 0..N-1
2684+ CF88 C9                           RET
