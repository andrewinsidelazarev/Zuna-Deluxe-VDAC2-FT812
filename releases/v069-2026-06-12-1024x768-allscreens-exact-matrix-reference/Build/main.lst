 131+ E487 3E 01       >                LD A, FT_INT_SWAP & 0xFF
 131+ E489 11 A8 20    >                LD DE, FT_REG_INT_FLAGS & 0xFFFF
 131+ E48C CD 1B 12    >                CALL FT.WriteReg8
