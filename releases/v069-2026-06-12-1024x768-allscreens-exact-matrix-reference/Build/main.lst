1530+ F14B              ; ZL_Mul16x8 — unsigned 16x8 multiply, low 16 bits of result.
1531+ F14B              ;   In:  HL = multiplicand (unsigned 16-bit), A = multiplier (unsigned 8-bit)
1532+ F14B              ;   Out: HL = (HL_in * A_in) & #FFFF
1533+ F14B              ;   Scratch: BC, A, F. ~14 байт, ~155 t-states avg.
1534+ F14B              ;   Используется для runtime K в spin formula (по 1 вызову на шар цепи).
1535+ F14B              ; ----------------------------------------------------------------------------
1536+ F14B 4D           ZL_Mul16x8:     LD   C, L
1536+ F14C 44             LD B, H                   ; BC = multiplicand
1537+ F14D 21 00 00                     LD   HL, 0                             ; HL = accumulator
1538+ F150 16 08                        LD   D, 8                             ; bit counter
1539+ F152 29           .lp:            ADD  HL, HL                            ; HL <<= 1
1540+ F153 87                           ADD  A, A                             ; CF = top bit of multiplier
1541+ F154 30 01                        JR   NC, .skip
1542+ F156 09                           ADD  HL, BC                            ; if bit set → +BC
1543+ F157 15           .skip:          DEC  D
1544+ F158 20 F8                        JR   NZ, .lp
