 150+ 69B5              ; ----------------------------------------------------------------------------
 151+ 69B5              ; WIN-взрыв: «бегущая дорожка» взрывов ОТ головного шара (ближайшего к килл-зоне)
 152+ 69B5              ; ДО килл-зоны (конца трека). Чем дальше голова была от КЗ — тем длиннее дорожка
 153+ 69B5              ; (= больше бонус). Снимаем track-сэмпл ГОЛОВНОГО шара (макс. сэмпл = фронт цепи)
 154+ 69B5              ; каждый PLAY-кадр, ДО очистки (keep-last-non-empty: храним последний кадр, где
 155+ 69B5              ; шары были видимы). К WIN цепочка пуста, но трек ещё загружен → дорожку рисуем
 156+ 69B5              ; по live-треку от сохранённого head-сэмпла. #FFFF = нет данных (не рисуем).
 157+ 69B5              ; Резидент Core: пишется кодом VDC (slot1), читается WIN-рендером в оверлее #04.
 158+ 69B5              ; ----------------------------------------------------------------------------
 159+ 69B5 FF FF        VDC_WinHeadS1:     DEFW #FFFF           ; chain1: сэмпл головного шара (фронт)
 160+ 69B7 FF FF        VDC_WinHeadS2:     DEFW #FFFF           ; chain2 (дубль-уровни)
 161+ 69B9 00 00        VDC_WinTmpMax:     DEFW 0               ; scratch: макс. сэмпл за проход цепочки
 162+ 69BB 00           VDC_WinTmpFound:   DEFB 0               ; scratch: найден ли видимый шар
 163+ 69BC
 164+ 69BC              ; --- WIN-аутро «бикфорд» (точно по оригиналу Zuma Game_UpdateOutro/FX.c):
 165+ 69BC              ; эмиттер бежит по треку head→килл-зона, роняя НЕЗАВИСИМЫЕ частицы-взрывы. ---
 166+ 69BC              WIN_PRTCL_MAX      EQU 32
 167+ 69BC              WINEXP_MOVE        EQU 12               ; сэмплов/кадр (скорость бегущей точки)
 168+ 69BC              WINEXP_PAD         EQU 30               ; сэмплов между взрывами (+100 за каждый)
 169+ 69BC              WINEXP_F2_MAX      EQU 32               ; f2 = 2×frame; >32 → частица мертва (frame 0..16)
 170+ 69BC 00           VDC_WinOutroActive: DEFB 0              ; 1 = аутро запущено (есть head-данные)
 171+ 69BD FF FF        VDC_WinEmitPos1:   DEFW #FFFF           ; chain1 эмиттер: текущий сэмпл (#FFFF=дошёл)
 172+ 69BF 00 00        VDC_WinEmitSpawn1: DEFW 0               ; сэмпл последнего спавна chain1
 173+ 69C1 FF FF        VDC_WinEmitPos2:   DEFW #FFFF           ; chain2
 174+ 69C3 00 00        VDC_WinEmitSpawn2: DEFW 0
 175+ 69C5 00 00 00...  VDC_WinPrtcl:      DEFS WIN_PRTCL_MAX * 5  ; на частицу: X(w),Y(w),f2(b); f2=255 мёртвая
