 267  0000              ; --- Frog RTC entropy state (slot 1 free RAM, между GAMELOG и Core @ #6000) ---
 268  0000              ; Каждый 128-й вызов Frog_NewNextColor взводит FLAG; picker (Frog_FilteredRandomColor)
 269  0000              ; XOR'ит RTC seconds в RAND_BYTE (= ВЫХОД LFSR), не трогая seed state — LFSR
 270  0000              ; продолжает свой математически гарантированный цикл, а RTC даёт точечный
 271  0000              ; перетряс распределения раз в ~128 выстрелов (~3-5 минут реальной игры).
 272  0000              ; (Совет Gemini: не XOR'ить в seed — это сбивает цикл LFSR и может создавать
 273  0000              ; короткие повторяющиеся петли.)
 274  0000              FROG_RTC_MIX_CNT_ADDR  EQU #4C89                       ; 1 byte, 0..127 cyclic (сдвиг −#380 с GAMELOG)
 275  0000              FROG_RTC_MIX_FLAG_ADDR EQU #4C8A                       ; 1 byte, 0/1 pending mix
 276  0000              FROG_EXCLUDE_COLOR_ADDR EQU #4C8B                      ; 1 byte; 0xFF=no excl, else=color → drop bit from mask при popcount>=3 (consume-and-reset)
 277  0000
