4455  E042                              include "Bullet.asm"
# file opened: Source\ASM\Bullet.asm
   1+ E042              ; ============================================================================
   2+ E042              ; Bullet.asm — летящий шар (одиночный выстрел из лягушки).
   3+ E042              ;
   4+ E042              ; State: Active flag + позиция (X,Y signed 16-bit) + velocity (VX,VY signed 8-bit)
   5+ E042              ; + color (0..5).  Spawn в start-fire (Frog_HandleMouse / Frog_FireKeyboard).
   6+ E042              ; Update каждый кадр (X += VX, Y += VY).  Out-of-screen → deactivate.
   7+ E042              ; Render — handle 0 chain atlas, тот же что ball-now/next-ball/chain.
   8+ E042              ;
   9+ E042              ; Этап 1 (текущий): только полёт + render. Без collision/insert в chain.
  10+ E042              ; ============================================================================
  11+ E042
  12+ E042              ; 1024×768 порт: пуля летит в 1024-пространстве (трек/шары ×1.6). Скорость,
  13+ E042              ; размер спрайта и пороги коллизии масштабируются ×1.6 (= ×8/5).
  14+ E042              BULLET_SPEED        EQU 19                            ; 12×1.6 — тот же экранный путь/время на бо́льшем экране
  15+ E042              BULLET_SPRITE_HALF  EQU 26                            ; round(51/2) — центр draw-rect'а (ball 51px)
  16+ E042              BULLET_DRAW         EQU 51                            ; экранный размер = round(32×8/5)
  17+ E042              BULLET_DRAW_SCALE   EQU #00019800                     ; 51/32 в f16.16 (cmd_scale: 32px atlas → 51px screen)
  18+ E042              BULLET_HIT_THR      EQU 35                            ; 22×1.6 bbox prefilter: |dx|<THR && |dy|<THR.
  19+ E042              BULLET_HIT_MANHATTAN_THR EQU 54                       ; 34×1.6 reject far bbox corners.
  20+ E042                                                                    ; D=32: 30/46 was too magnetic on curved chain and
  21+ E042                                                                    ; could pick a ball several slots before the aimed one.
  22+ E042                                                                    ; 22/34 keeps a small touch margin without early capture.
  23+ E042              BULLET_TRACKF_TUNNEL EQU #01                          ; track flags bit0: hidden/tunnel, not shootable.
  24+ E042
  25+ E042
  26+ E042              ; ----------------------------------------------------------------------------
  27+ E042              ; Bullet_Init — обнулить state.
  28+ E042              ; ----------------------------------------------------------------------------
  29+ E042 AF           Bullet_Init:        XOR  A
  30+ E043 32 90 E3                         LD   (Bullet_Active), A
  31+ E046 32 98 E3                         LD   (Bullet_TunnelSeen), A
  32+ E049 C9                               RET
  33+ E04A
  34+ E04A
  35+ E04A              ; ----------------------------------------------------------------------------
  36+ E04A              ; Bullet_Spawn — вызывается из Frog start-fire (LMB или SPACE).
  37+ E04A              ; Berёт цвет из Frog_BallColor (= уже промотировано из NextBallColor),
  38+ E04A              ; angle из Frog_Angle, spawn position из Frog_PosStartX/Y (центр лягушки).
  39+ E04A              ; Velocity = BULLET_SPEED * (cos(angle), sin(angle)) / 128.
  40+ E04A              ; ----------------------------------------------------------------------------
  41+ E04A 3A 9C 69     Bullet_Spawn:       LD   A, (VDC_DialogState)
  42+ E04D B7                               OR   A
  43+ E04E 20 0C                            JR   NZ, .bs_block
  44+ E050                                  ; Разрешено стрелять только в PLAY (=0): не во время INTRO/PREVIEW/CLOSING,
  45+ E050                                  ; ABSORB (шары улетают в killzone — стрельба бессмысленна), GAMEOVER.
  46+ E050 3A 96 69                         LD   A, (VDC_GameState)
  47+ E053 B7                               OR   A
  48+ E054 20 06                            JR   NZ, .bs_block
  49+ E056 3A 90 E3                         LD   A, (Bullet_Active)
  50+ E059 B7                               OR   A
  51+ E05A 28 02                            JR   Z, .bs_free
  52+ E05C 37           .bs_block:          SCF
  53+ E05D C9                               RET
  54+ E05E              .bs_free:
  55+ E05E C0                               RET  NZ                           ; уже в полёте — single bullet MVP
  56+ E05F 3E 01                            LD   A, 1
  57+ E061 32 90 E3                         LD   (Bullet_Active), A
  58+ E064 AF                               XOR  A
  59+ E065 32 98 E3                         LD   (Bullet_TunnelSeen), A
  60+ E068 3A AB 69                         LD   A, (Frog_BallColor)
  61+ E06B 32 97 E3                         LD   (Bullet_Color), A
