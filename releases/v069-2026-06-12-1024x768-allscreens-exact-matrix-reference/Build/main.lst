2101  32AD              ; ============================================================================
2102  32AD              ; FormatHudClock — DrawNumBuf = "HH:MM:SS" from RTC-based VDC_GameSeconds.
2103  32AD              ; ============================================================================
2104  32AD              FormatHudClock:
2105  32AD 2A A9 69                     LD   HL, (Core.VDC_GameSeconds)
2106  32B0 06 00                        LD   B, 0                              ; hours
2107  32B2 11 10 0E     .fhc_hour:      LD   DE, 3600
2108  32B5 A7                           AND  A
2109  32B6 ED 52                        SBC  HL, DE
2110  32B8 38 03                        JR   C, .fhc_hour_done
2111  32BA 04                           INC  B
2112  32BB 18 F5                        JR   .fhc_hour
2113  32BD 19           .fhc_hour_done: ADD  HL, DE
2114  32BE 0E 00                        LD   C, 0                              ; minutes
2115  32C0 11 3C 00     .fhc_min:       LD   DE, 60
2116  32C3 A7                           AND  A
2117  32C4 ED 52                        SBC  HL, DE
2118  32C6 38 03                        JR   C, .fhc_min_done
2119  32C8 0C                           INC  C
2120  32C9 18 F5                        JR   .fhc_min
2121  32CB 19           .fhc_min_done:  ADD  HL, DE                            ; L = seconds 0..59
2122  32CC 78                           LD   A, B
2123  32CD 32 06 33                     LD   (HudClockHour), A
2124  32D0 79                           LD   A, C
2125  32D1 32 07 33                     LD   (HudClockMin), A
2126  32D4 7D                           LD   A, L
2127  32D5 32 08 33                     LD   (HudClockSec), A
2128  32D8
2129  32D8 21 4D 33                     LD   HL, DrawNumBuf
2130  32DB 3A 06 33                     LD   A, (HudClockHour)
2131  32DE CD F6 32                     CALL FormatTwoDigits
2132  32E1 36 3A                        LD   (HL), ':'
2133  32E3 23                           INC  HL
2134  32E4 3A 07 33                     LD   A, (HudClockMin)
2135  32E7 CD F6 32                     CALL FormatTwoDigits
2136  32EA 36 3A                        LD   (HL), ':'
2137  32EC 23                           INC  HL
2138  32ED 3A 08 33                     LD   A, (HudClockSec)
2139  32F0 CD F6 32                     CALL FormatTwoDigits
2140  32F3 36 00                        LD   (HL), 0
2141  32F5 C9                           RET
2142  32F6
2143  32F6              FormatTwoDigits:
2144  32F6 06 2F                        LD   B, '0' - 1
2145  32F8 04           .ftd_tens:      INC  B
2146  32F9 D6 0A                        SUB  10
2147  32FB 30 FB                        JR   NC, .ftd_tens
2148  32FD C6 0A                        ADD  A, 10
2149  32FF 70                           LD   (HL), B
2150  3300 23                           INC  HL
2151  3301 C6 30                        ADD  A, '0'
2152  3303 77                           LD   (HL), A
2153  3304 23                           INC  HL
2154  3305 C9                           RET
