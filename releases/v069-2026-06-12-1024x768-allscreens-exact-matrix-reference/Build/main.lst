3842  64C4
3843  64C4              WinAwardTimeBonus:
3844  64C4 CD F4 5F                     CALL GetCurrentPartime
3845  64C7 47                           LD   B, A                                ; B = par time seconds
3846  64C8 2A A9 69                     LD   HL, (VDC_GameSeconds)
3847  64CB 7C                           LD   A, H
3848  64CC B7                           OR   A
3849  64CD C0                           RET  NZ                                  ; over 255 sec: no byte-sized bonus
3850  64CE 7D                           LD   A, L
3851  64CF B8                           CP   B
3852  64D0 D0                           RET  NC                                  ; elapsed >= par
3853  64D1 78                           LD   A, B
3854  64D2 95                           SUB  L                                   ; remaining seconds
3855  64D3 47                           LD   B, A
3856  64D4 21 00 00                     LD   HL, 0
3857  64D7 11 64 00                     LD   DE, 100
