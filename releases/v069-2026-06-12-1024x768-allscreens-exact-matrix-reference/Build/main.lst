 492+ C369              ; ============================================================================
 493+ C369              ; VDC_Update — один шаг физики (вызывать раз в кадр).
 494+ C369              ; Phase 1 (BallsSpawned < LEVEL_START_BALLS): 12× MoveChain + 1× AnimateChain +
 495+ C369              ;   1× TrySpawn (TrySpawn внутри loop'ит). Это «поезд» влёта 35 шаров за ~90 тиков.
 496+ C369              ; Phase 2 (BallsSpawned ≥ LEVEL_START_BALLS): 1× MoveChain каждый кадр (norm-speed
 497+ C369              ;   подобран под VDAC2 CELL_SIZE=42 — без subdivider /2 как у коллеги).
 498+ C369              ; ============================================================================
 499+ C369              VDC_Update:
 500+ C369 CD C2 C5                     CALL VDC_UpdateSfxStopTimer
 501+ C36C 3A 9C 69                     LD   A, (VDC_DialogState)
 502+ C36F FE 03                        CP   3
 503+ C371 38 0B                        JR   C, .upd_not_pause       ; <3 (none/retry/gameover) → normal path
 504+ C373                              ; >=3: pause (3) or pause fade-out (4) — freeze gameplay, refresh
 505+ C373                              ; the RTC baseline so the paused/fading seconds are not counted.
 506+ C373 CD 05 C3                     CALL ReadRTCSeconds
 507+ C376 32 7E D3                     LD   (VDC_RtcLastSecond), A
 508+ C379 AF                           XOR  A
 509+ C37A 32 7F D3                     LD   (VDC_RtcNoTickFrames), A
 510+ C37D C9                           RET
 511+ C37E              .upd_not_pause:
 512+ C37E 3A 96 69                     LD   A, (VDC_GameState)
 513+ C381 FE 03                        CP   VDC_STATE_INTRO
 514+ C383 28 17                        JR   Z, .upd_intro
 515+ C385 FE 04                        CP   VDC_STATE_PREVIEW
 516+ C387 28 2B                        JR   Z, .upd_preview
 517+ C389 FE 05                        CP   VDC_STATE_CLOSING
 518+ C38B 28 3A                        JR   Z, .upd_closing
 519+ C38D FE 01                        CP   VDC_STATE_ABSORB
 520+ C38F CA 57 39                     JP   Z, VDC_UpdateAbsorb
 521+ C392 FE 02                        CP   VDC_STATE_GAMEOVER
 522+ C394 C8                           RET  Z
 523+ C395 FE 06                        CP   VDC_STATE_WIN
 524+ C397 CA 32 60                     JP   Z, VDC_UpdateWin
 525+ C39A 18 65                        JR   .upd_play
 526+ C39C              .upd_intro:     ; tick countdown, на 0 → PREVIEW
 527+ C39C 3A 68 D3                     LD   A, (VDC_IntroTick)
 528+ C39F 3D                           DEC  A
 529+ C3A0 32 68 D3                     LD   (VDC_IntroTick), A
 530+ C3A3 C0                           RET  NZ
 531+ C3A4 3E 0C                        LD   A, SND_CHANT1
 532+ C3A6 CD 30 6B                     CALL GS_PlaySfx
 533+ C3A9 3E 04                        LD   A, VDC_STATE_PREVIEW
 534+ C3AB 32 96 69                     LD   (VDC_GameState), A
 535+ C3AE 3E C1                        LD   A, VDC_PREVIEW_TICKS
 536+ C3B0 32 69 D3                     LD   (VDC_PreviewTick), A
 537+ C3B3 C9                           RET
 538+ C3B4              .upd_preview:   ; tick countdown, на 0 → CLOSING
 539+ C3B4 3A 69 D3                     LD   A, (VDC_PreviewTick)
 540+ C3B7 3D                           DEC  A
 541+ C3B8 32 69 D3                     LD   (VDC_PreviewTick), A
 542+ C3BB C0                           RET  NZ
 543+ C3BC 3E 05                        LD   A, VDC_STATE_CLOSING
 544+ C3BE 32 96 69                     LD   (VDC_GameState), A
 545+ C3C1 3E 16                        LD   A, VDC_CLOSING_TICKS
 546+ C3C3 32 6A D3                     LD   (VDC_KzCloseTick), A
 547+ C3C6 C9                           RET
 548+ C3C7              .upd_closing:   ; анимация KzFrame 11→1 за 22 ticks (2 tick/frame), затем PLAY.
 549+ C3C7 3A 6A D3                     LD   A, (VDC_KzCloseTick)
 550+ C3CA CB 3F                        SRL  A                                ; A = tick / 2 (0..11)
 551+ C3CC 3C                           INC  A                                ; A = 1 + tick/2 (1..12)
 552+ C3CD FE 0C                        CP   12
 553+ C3CF 38 02                        JR   C, .upd_closing_set
 554+ C3D1 3E 0B                        LD   A, 11
 555+ C3D3              .upd_closing_set:
 556+ C3D3 32 99 69                     LD   (VDC_KzFrame), A
 557+ C3D6 3A 6A D3                     LD   A, (VDC_KzCloseTick)
 558+ C3D9 3D                           DEC  A
 559+ C3DA 32 6A D3                     LD   (VDC_KzCloseTick), A
 560+ C3DD C0                           RET  NZ
 561+ C3DE AF                           XOR  A                                ; state = PLAY
 562+ C3DF 32 96 69                     LD   (VDC_GameState), A
 563+ C3E2 3C                           INC  A                                ; KzFrame = 1 (closed default)
 564+ C3E3 32 99 69                     LD   (VDC_KzFrame), A
 565+ C3E6 CD 05 C3                     CALL ReadRTCSeconds
 566+ C3E9 32 7E D3                     LD   (VDC_RtcLastSecond), A
