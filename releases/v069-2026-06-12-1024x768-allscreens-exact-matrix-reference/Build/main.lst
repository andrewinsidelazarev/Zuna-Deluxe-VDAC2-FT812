1429  2AA0                              ; --- Title по VDC_Lives ---
1430  2AA0 3A 9B 69                     LD   A, (Core.VDC_Lives)
1431  2AA3 FE 02                        CP   2
1432  2AA5 28 09                        JR   Z, .dc_title_2
1433  2AA7 FE 01                        CP   1
1434  2AA9 28 0A                        JR   Z, .dc_title_1
1435  2AAB 21 55 2C                     LD   HL, str_game_over
1436  2AAE 18 08                        JR   .dc_title_draw
1437  2AB0 21 5F 2C     .dc_title_2:    LD   HL, str_2_lives
1438  2AB3 18 03                        JR   .dc_title_draw
1439  2AB5 21 6C 2C     .dc_title_1:    LD   HL, str_1_lives
1440  2AB8              .dc_title_draw:
1441  2AB8                              ; Центруем по ширине. 1024: центр 512, глифы рисует активная
1442  2AB8                              ; scale(1.6)-матрица → экранная полуширина = W×1.6/2 = W×4/5.
1443  2AB8                              ; (Мёртвый дубль LD HL,320 удалён.)
1444  2AB8 CD E8 30                     CALL StrWidth                            ; HL ptr → DE = W (атласные px)
1445  2ABB EB                           EX   DE, HL
1446  2ABC 29                           ADD  HL, HL
1446  2ABD 29             ADD HL, HL                 ; 4W
1447  2ABE 3E 05                        LD   A, 5
1448  2AC0 CD BC 79                     CALL Core.VDC_DivHLbyA                   ; HL = W×4/5
1449  2AC3 EB                           EX   DE, HL                              ; DE = экранная полуширина
1450  2AC4 21 00 02                     LD   HL, 512
1451  2AC7 A7                           AND  A
1452  2AC8 ED 52                        SBC  HL, DE
1453  2ACA 29                           ADD  HL, HL
1453  2ACB 29             ADD HL, HL
1453  2ACC 29             ADD HL, HL
1453  2ACD 29             ADD HL, HL  ; x*16
1454  2ACE 44                           LD   B, H
1454  2ACF 4D             LD C, L
1455  2AD0 11 00 10                     LD   DE, DLG_TITLE_Y * 16
1456  2AD3                              ; Reload string ptr (clobbered)
1457  2AD3 3A 9B 69                     LD   A, (Core.VDC_Lives)
1458  2AD6 FE 02                        CP   2
1459  2AD8 28 09                        JR   Z, .dc_title_2b
1460  2ADA FE 01                        CP   1
1461  2ADC 28 0A                        JR   Z, .dc_title_1b
1462  2ADE 21 55 2C                     LD   HL, str_game_over
1463  2AE1 18 08                        JR   .dc_title_draw2
1464  2AE3 21 5F 2C     .dc_title_2b:   LD   HL, str_2_lives
1465  2AE6 18 03                        JR   .dc_title_draw2
1466  2AE8 21 6C 2C     .dc_title_1b:   LD   HL, str_1_lives
1467  2AEB              .dc_title_draw2:
1468  2AEB CD A6 2F                     CALL DrawString
1469  2AEE
1470  2AEE              .dc_stats:      ; --- Stats use a separate cancun10 atlas. Do not touch the
1471  2AEE                              ; pixel-tuned cancun8 menu/HUD font. (Win-диалог прыгает сюда после
1472  2AEE                              ; своего заголовка — те же статы, что в Game Over.)
1473  2AEE CD 3D 2F                     CALL SetFontCancun10Stats
1474  2AF1
