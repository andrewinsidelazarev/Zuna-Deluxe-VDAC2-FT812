 347+ 10DD              ;       * VM_1024_768_76Hz
 348+ 10DD              ; Out :
 349+ 10DD              ; Corrupt :
 350+ 10DD              ;  HL, DE, BC, AF
 351+ 10DD              ; Note:
 352+ 10DD              ; -----------------------------------------
 353+ 10DD              ; select video resolution
 354+ 10DD              FT_RESOLUTION   macro Resolution?, ResolutionRef?
 355+ 10DD ~                            if     Resolution? == VM_640_480_57Hz
 356+ 10DD ~                            LD HL, 640
 357+ 10DD ~                            LD (ResolutionRef? + 0), HL
 358+ 10DD ~                            LD HL, 480
 359+ 10DD ~                            LD (ResolutionRef? + 2), HL
 360+ 10DD ~                            elseif Resolution? == VM_640_480_74Hz
 361+ 10DD ~                            LD HL, 640
 362+ 10DD ~                            LD (ResolutionRef? + 0), HL
 363+ 10DD ~                            LD HL, 480
 364+ 10DD ~                            LD (ResolutionRef? + 2), HL
 365+ 10DD ~                            elseif Resolution? == VM_640_480_76Hz
 366+ 10DD ~                            LD HL, 640
 367+ 10DD ~                            LD (ResolutionRef? + 0), HL
 368+ 10DD ~                            LD HL, 480
 369+ 10DD ~                            LD (ResolutionRef? + 2), HL
 370+ 10DD ~                            elseif Resolution? == VM_800_600_60Hz
 371+ 10DD ~                            LD HL, 800
 372+ 10DD ~                            LD (ResolutionRef? + 0), HL
 373+ 10DD ~                            LD HL, 600
 374+ 10DD ~                            LD (ResolutionRef? + 2), HL
 375+ 10DD ~                            elseif Resolution? == VM_800_600_69Hz
 376+ 10DD ~                            LD HL, 800
 377+ 10DD ~                            LD (ResolutionRef? + 0), HL
 378+ 10DD ~                            LD HL, 600
 379+ 10DD ~                            LD (ResolutionRef? + 2), HL
 380+ 10DD ~                            elseif Resolution? == VM_800_600_85Hz
 381+ 10DD ~                            LD HL, 800
 382+ 10DD ~                            LD (ResolutionRef? + 0), HL
 383+ 10DD ~                            LD HL, 600
 384+ 10DD ~                            LD (ResolutionRef? + 2), HL
 385+ 10DD ~                            elseif Resolution? == VM_1024_768_59Hz
 386+ 10DD ~                            LD HL, 1024
 387+ 10DD ~                            LD (ResolutionRef? + 0), HL
 388+ 10DD ~                            LD HL, 768
 389+ 10DD ~                            LD (ResolutionRef? + 2), HL
 390+ 10DD ~                            elseif Resolution? == VM_1024_768_67Hz
 391+ 10DD ~                            LD HL, 1024
 392+ 10DD ~                            LD (ResolutionRef? + 0), HL
 393+ 10DD ~                            LD HL, 768
 394+ 10DD ~                            LD (ResolutionRef? + 2), HL
 395+ 10DD ~                            elseif Resolution? == VM_1024_768_76Hz
 396+ 10DD ~                            LD HL, 1024
 397+ 10DD ~                            LD (ResolutionRef? + 0), HL
 398+ 10DD ~                            LD HL, 768
 399+ 10DD ~                            LD (ResolutionRef? + 2), HL
 400+ 10DD ~                            endif
 401+ 10DD ~                            LD HL, Resolution?
 402+ 10DD ~                            CALL FT.Initialize
 403+ 10DD                              endm
 404+ 10DD              ; -----------------------------------------
 405+ 10DD              ; write a data to memory area of 'Display List' FT812
 406+ 10DD              ; In :
 407+ 10DD              ;   Address? - lower 16 bits of the FT_RAM_DL address
 408+ 10DD              ;   Offset?  - 16-bit destination offset from RAM_DL FT812
 409+ 10DD              ;   Size?    - number of bytes to copy
 410+ 10DD              ; Out :
 411+ 10DD              ; Corrupt :
 412+ 10DD              ;   HL, BC, AF
 413+ 10DD              ; Note:
 414+ 10DD              ; -----------------------------------------
 415+ 10DD              FT_WR_DL        macro Source?, Offset?, Size?
 416+ 10DD ~                            LD HL, Source? & 0xFFFF
 417+ 10DD ~                            LD A, (FT_RAM_DL >> 16) & 0xFF
 418+ 10DD ~                            LD DE, Offset? & FT_DL_MASK
 419+ 10DD ~                            LD BC, Size? & FT_DL_MASK
 420+ 10DD ~                            CALL FT.WriteMem
 421+ 10DD                              endm
 422+ 10DD              ; -----------------------------------------
 423+ 10DD              ; write a data to the FIFO command i.e. RAM_CMD
 424+ 10DD              ; In :
 425+ 10DD              ;   Address? - lower 16 bits of the FT_RAM_DL address
 426+ 10DD              ;   Size?    - number of bytes to copy
 427+ 10DD              ;   if the C flag is set, it is necessary to align the data with 4 bytes
 428+ 10DD              ; Out :
 429+ 10DD              ; Corrupt :
 430+ 10DD              ;   HL, BC, AF
 431+ 10DD              ; Note:
 432+ 10DD              ; -----------------------------------------
 433+ 10DD              FT_WR_CMD       macro Address?, Size?
 434+ 10DD ~                            LD HL, Address? & 0xFFFF
 435+ 10DD ~                            LD BC, Size? & 0xFFFF
 436+ 10DD ~                            CALL FT.Coprocessor.Write
 437+ 10DD                              endm
 438+ 10DD              ; -----------------------------------------
 439+ 10DD              ; write a 32-bits value to the FIFO command i.e. RAM_CMD
 440+ 10DD              ; In :
 441+ 10DD              ;   Value? - 32-bits value
 442+ 10DD              ; Out :
 443+ 10DD              ;   if the C flag is set, the coprocessor is fault,
 444+ 10DD              ;   otherwise the command or data has successfully append to FIFO
 445+ 10DD              ; Corrupt :
 446+ 10DD              ;   HL, DE, F
 447+ 10DD              ; Note:
 448+ 10DD              ; -----------------------------------------
 449+ 10DD              FT_WR32_CMD     macro Value?
 450+ 10DD ~                            LD HL, (Value? >> 16) & 0xFFFF
 451+ 10DD ~                            LD DE, Value? & 0xFFFF
 452+ 10DD ~                            CALL FT.Coprocessor.Write32
 453+ 10DD                              endm
 454+ 10DD              ; -----------------------------------------
 455+ 10DD              ; write a data to memory FT812 by DMA
 456+ 10DD              ; In :
 457+ 10DD              ;   Source?      - source address (0x0000 - 0x3FFF)
 458+ 10DD              ;   SourcePage?  - source number page
 459+ 10DD              ;   Destination? - 22-bit destination address FT
 460+ 10DD              ;   Size?        - number of bytes to copy
 461+ 10DD              ; Out :
 462+ 10DD              ; Corrupt :
 463+ 10DD              ;  HL, DE, BC, AF
 464+ 10DD              ; Note:
 465+ 10DD              ; -----------------------------------------
 466+ 10DD              FT_WR_DMA       macro Source?, SourcePage?, Destination?, Size?
 467+ 10DD ~                            FT_ON
 468+ 10DD ~
 469+ 10DD ~                            ; for SPI memory write transactions, the host sends a ‘1’ bit and ‘0’ bit, followed by the 22-bit address. This is followed by the write data.
 470+ 10DD ~                            LD A, (Destination? >> 16) & 0xFF
 471+ 10DD ~                            OR #80
 472+ 10DD ~                            OUT (SPI_DATA), A
 473+ 10DD ~                            LD A, (Destination? >> 8) & 0xFF
 474+ 10DD ~                            OUT (SPI_DATA), A
 475+ 10DD ~                            LD A, (Destination? >> 0) & 0xFF
 476+ 10DD ~                            OUT (SPI_DATA), A
 477+ 10DD ~
 478+ 10DD ~                            ; set source address DMA (RAM)
 479+ 10DD ~                            DMA_Src SourcePage? & 0xFF, Source? & 0x3FFF
 480+ 10DD ~
 481+ 10DD ~                            ; DEBC = data length in bytes
 482+ 10DD ~                            LD DE, (Size? >> 17) & 0x0007
 483+ 10DD ~                            LD BC, (Size? >> 1)  & 0xFFFF
 484+ 10DD ~
 485+ 10DD ~                            ;
 486+ 10DD ~                            PUSH BC
 487+ 10DD ~
 488+ 10DD ~                            ;
 489+ 10DD ~                            LD A, E
 490+ 10DD ~                            OR A
 491+ 10DD ~                            JR Z, .Less_128kb
 492+ 10DD ~
 493+ 10DD ~            .Send128kb      DMA_Size 256, 512
 494+ 10DD ~                            DMA_Ctrl DMA_RAM_SPI
 495+ 10DD ~                            DMA_Wait
 496+ 10DD ~                            DEC E
 497+ 10DD ~                            JR NZ, .Send128kb
 498+ 10DD ~
 499+ 10DD ~            .Less_128kb     POP BC
 500+ 10DD ~                            LD A, C
 501+ 10DD ~                            EX AF, AF'
 502+ 10DD ~
 503+ 10DD ~                            ;
 504+ 10DD ~                            LD A, B
 505+ 10DD ~                            OR A
 506+ 10DD ~                            JR Z, .Less512b
 507+ 10DD ~
 508+ 10DD ~                            ;
 509+ 10DD ~                            LD BC, DMANUM
 510+ 10DD ~                            OUT (C), A
 511+ 10DD ~                            LD B, HIGH DMALEN
 512+ 10DD ~                            LD A, #FF
 513+ 10DD ~                            OUT (C), A
 514+ 10DD ~                            DMA_Ctrl DMA_RAM_SPI
 515+ 10DD ~                            DMA_Wait
 516+ 10DD ~
 517+ 10DD ~            .Less512b       EX AF, AF'
 518+ 10DD ~                            OR A
 519+ 10DD ~                            JR Z, .End
 520+ 10DD ~                            EX AF, AF'
 521+ 10DD ~                            XOR A
 522+ 10DD ~                            LD BC, DMANUM
 523+ 10DD ~                            OUT (C), A
 524+ 10DD ~                            LD B, HIGH DMALEN
 525+ 10DD ~                            EX AF, AF'
 526+ 10DD ~                            OUT (C), A
 527+ 10DD ~                            DMA_Ctrl DMA_RAM_SPI
 528+ 10DD ~                            DMA_Wait
 529+ 10DD ~
 530+ 10DD ~            .End            FT_OFF
 531+ 10DD                              endm
 532+ 10DD
 533+ 10DD                              endif ; ~_FT812_MACRO_
