  22+ 1D1B 11 00 40                     LD   DE, #4000
  23+ 1D1E 01 ED 01                     LD   BC, Core.QuitStub_Len
  24+ 1D21 ED B0                        LDIR
  25+ 1D23
  26+ 1D23 3E 30                        LD   A, #30
  27+ 1D25 32 42 6C                     LD   (Core.Quit_DbgStage), A
  28+ 1D28 2A 3C 6C                     LD   HL, (Core.Boot_StartLba + 0)
  29+ 1D2B 22 E7 41                     LD   (Core.QS_Lba + 0), HL
  30+ 1D2E 2A 3E 6C                     LD   HL, (Core.Boot_StartLba + 2)
  31+ 1D31 22 E9 41                     LD   (Core.QS_Lba + 2), HL
  32+ 1D34 3A 40 6C                     LD   A, (Core.Boot_SecCount)
  33+ 1D37 32 EB 41                     LD   (Core.QS_Cnt), A
