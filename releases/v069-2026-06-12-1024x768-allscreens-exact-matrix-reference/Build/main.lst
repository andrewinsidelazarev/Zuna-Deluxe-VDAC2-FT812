 281+ C2DA              MenuAdvanceSky:
 282+ C2DA                              ; pos += шаг (в 1/16 px); если pos >= W*16 — вычесть W*16 (плавный wrap
 283+ C2DA                              ; без потери остатка). Шаг << W*16, поэтому одного вычитания хватает.
 284+ C2DA 2A 57 CE                     LD   HL, (MenuSkyPos)
 285+ C2DD 11 11 00                     LD   DE, MENU_SKY_SCROLL16 * 8 / 5     ; 1024: та же визуальная скорость
 286+ C2E0 19                           ADD  HL, DE
 287+ C2E1 11 00 40                     LD   DE, (MENU_SKY_W * 8 / 5) * 16     ; wrap по экранной ширине (= период копий)
 288+ C2E4 A7                           AND  A
 289+ C2E5 ED 52                        SBC  HL, DE
 290+ C2E7 30 01                        JR   NC, .store                        ; >=0 -> wrapped, оставить остаток
 291+ C2E9 19                           ADD  HL, DE                            ; <0  -> не дошли до края, вернуть
 292+ C2EA 22 57 CE     .store:         LD   (MenuSkyPos), HL
 293+ C2ED                              ; две НЕЗАВИСИМЫЕ фазы с разной скоростью → масштаб солнца и пульс
 294+ C2ED                              ; свечения расходятся (асинхронно): солнце +2 (~2 с), свечение +3 (~1.3 с).
 295+ C2ED 3A 59 CE                     LD   A, (MenuSunPhase)
 296+ C2F0 C6 02                        ADD  A, 2
 297+ C2F2 32 59 CE                     LD   (MenuSunPhase), A
 298+ C2F5 3A 5A CE                     LD   A, (MenuGlowPhase)
 299+ C2F8 C6 03                        ADD  A, 3
 300+ C2FA 32 5A CE                     LD   (MenuGlowPhase), A
 301+ C2FD C9                           RET
