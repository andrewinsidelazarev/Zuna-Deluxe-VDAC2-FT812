 177+ E4B5              ; ----------------------------------------------------------------------------
 178+ E4B5              ZL_BALL_DIAM_PX  EQU 32                               ; atlas cell size (BitmapLayout/stride/offset) — НЕ масштабировать
 179+ E4B5              ZL_BALL_VISIBLE  EQU ZL_BALL_DIAM_PX                  ; visible diameter = atlas cell (без alpha-padding)
 180+ E4B5              ZL_BALL_W        EQU ZL_BALL_DIAM_PX                  ; atlas cell для BitmapLayout
 181+ E4B5              ZL_BALL_H        EQU ZL_BALL_DIAM_PX
 182+ E4B5              ZL_BALL_DRAW     EQU 51                               ; 1024×768: экранный размер = round(32×8/5); BitmapSize
 183+ E4B5              ZL_BALL_HALF     EQU 26                               ; центр draw-rect'а (round(51/2)) для VERTEX2F centering
 184+ E4B5                                                                   ; (вращение/scale запечены в chain_matrix_lut.bin, pivot=16 atlas)
 185+ E4B5              ; --- Spin physics: rolling-without-slip связь между движением t и phase atlas ---
 186+ E4B5              ; t — позиция шара на треке в track samples. Phase меняется ТОЛЬКО когда t движется
 187+ E4B5              ; → автоматически пропорционально скорости шаров (быстрее цепь → быстрее phase).
 188+ E4B5              ;
 189+ E4B5              ; Формула: spin_frame = ((t * K) >> 8) & (ATLAS_PHASES-1), где
 190+ E4B5              ;   K = 256 * ATLAS_PHASES / (π * D_samples)
 191+ E4B5              ; t измеряется в track samples. Физически точное rolling-without-slip для D=VDC_CELL_SIZE
 192+ E4B5              ; даёт K≈41, но при текущей скорости цепи это визуально слишком медленно для Zuma-feel.
 193+ E4B5              ; Поэтому используем визуальный период в 2 раза короче: D_samples = VDC_CELL_SIZE/2.
 194+ E4B5              ; Для CELL_SIZE=32, phases=16:
 195+ E4B5              ;   K = 256*16*113/(355*16) ≈ 81.49 → 81.
 196+ E4B5              ;
 197+ E4B5              ; K держится в RAM (ZL_SpinK) — runtime, можно менять per-level. Default = compile-time.
 198+ E4B5                              if BALLS_ARGB4_ENABLED
 199+ E4B5              ZL_ATLAS_PHASES            EQU 16
 200+ E4B5                              else
 201+ E4B5 ~            ZL_ATLAS_PHASES            EQU 32
 202+ E4B5                              endif
 203+ E4B5              ZL_SPIN_DIAM_SAMPLES       EQU VDC_CELL_SIZE / 2
 204+ E4B5              ZL_SPIN_K_NUM              EQU 256 * ZL_ATLAS_PHASES * 113
 205+ E4B5              ZL_SPIN_K_DEN              EQU 355 * ZL_SPIN_DIAM_SAMPLES
 206+ E4B5              ZL_SPIN_K_DEFAULT          EQU (ZL_SPIN_K_NUM + ZL_SPIN_K_DEN / 2) / ZL_SPIN_K_DEN
 207+ E4B5              ZL_SPIN_MASK               EQU ZL_ATLAS_PHASES - 1
