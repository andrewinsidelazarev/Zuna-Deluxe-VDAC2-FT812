3471  5FE6 38 08                        JR   C, .vsa_no
3472  5FE8 D6 64                        SUB  100
3473  5FEA 32 70 D3                     LD   (Core.VDC_SpeedAccum), A
3474  5FED C3 FF C6                     JP   Core.VDC_MoveChain                  ; tail: один advance, RET к caller
3475  5FF0 32 70 D3     .vsa_no:        LD   (Core.VDC_SpeedAccum), A
3476  5FF3 C9                           RET
