 427+ C305              ; ============================================================================
 428+ C305              ; ReadRTCSeconds — TS-Conf GLUK CMOS RTC, регистр 0 (секунды BCD).
 429+ C305              ; Порты #DFF7 (адрес) / #BFF7 (данные). Out: A = 0..59 binary.
 430+ C305              ; ============================================================================
 431+ C305              ReadRTCSeconds:
 432+ C305                              ; Mr.Gluk activation на порт #EFF7 (за ZiFi/WC: zifi.asm:4207).
 433+ C305                              ; OUT #EFF7, #80 — enable; #00 — disable.
 434+ C305 01 F7 EF                     LD   BC, #EFF7
 435+ C308 3E 80                        LD   A, #80
 436+ C30A ED 79                        OUT  (C), A
 437+ C30C 01 F7 DF                     LD   BC, #DFF7
 438+ C30F AF                           XOR  A
 439+ C310 ED 79                        OUT  (C), A                            ; reg 0 = seconds
 440+ C312 01 F7 BF                     LD   BC, #BFF7
 441+ C315 ED 78                        IN   A, (C)                            ; A = BCD seconds
 442+ C317 32 0E 50                     LD   (#500E), A                        ; DEBUG: raw byte
 443+ C31A F5                           PUSH AF
 444+ C31B 01 F7 EF                     LD   BC, #EFF7
 445+ C31E AF                           XOR  A
 446+ C31F ED 79                        OUT  (C), A                            ; deactivate Mr.Gluk
 447+ C321 F1                           POP  AF
 448+ C322 47                           LD   B, A
 449+ C323 E6 0F                        AND  $0F                               ; low nibble
 450+ C325 4F                           LD   C, A
 451+ C326 78                           LD   A, B
 452+ C327 E6 F0                        AND  $F0
 453+ C329 CB 3F                        SRL  A
 453+ C32B CB 3F          SRL A
 453+ C32D CB 3F          SRL A
 453+ C32F CB 3F          SRL A         ; high nibble (0..5)
 454+ C331 47                           LD   B, A
 455+ C332                              ; A = high*10 + low
 456+ C332 87                           ADD  A, A
 456+ C333 87             ADD A, A
 456+ C334 80             ADD A, B        ; *5
 457+ C335 87                           ADD  A, A                              ; *10
 458+ C336 81                           ADD  A, C
 459+ C337 C9                           RET
 460+ C338
 461+ C338              ; ============================================================================
 462+ C338              ; ReadRTCRegister — generic, A = register index (0=sec, 2=min, 4=hour).
 463+ C338              ; Out: A = BCD-parsed binary value.
 464+ C338              ; ============================================================================
 465+ C338              ReadRTCRegister:
 466+ C338 5F                           LD   E, A                              ; E = reg index
 467+ C339 01 F7 EF                     LD   BC, #EFF7
 468+ C33C 3E 80                        LD   A, #80
 469+ C33E ED 79                        OUT  (C), A                            ; activate Mr.Gluk
 470+ C340 01 F7 DF                     LD   BC, #DFF7
 471+ C343 7B                           LD   A, E
 472+ C344 ED 79                        OUT  (C), A                            ; select register
 473+ C346 01 F7 BF                     LD   BC, #BFF7
 474+ C349 ED 78                        IN   A, (C)                            ; read BCD
 475+ C34B F5                           PUSH AF
 476+ C34C 01 F7 EF                     LD   BC, #EFF7
 477+ C34F AF                           XOR  A
 478+ C350 ED 79                        OUT  (C), A                            ; deactivate
 479+ C352 F1                           POP  AF
 480+ C353 47                           LD   B, A
 481+ C354 E6 0F                        AND  $0F
 482+ C356 4F                           LD   C, A
 483+ C357 78                           LD   A, B
 484+ C358 E6 F0                        AND  $F0
 485+ C35A CB 3F                        SRL  A
 485+ C35C CB 3F          SRL A
 485+ C35E CB 3F          SRL A
 485+ C360 CB 3F          SRL A
 486+ C362 47                           LD   B, A
 487+ C363 87                           ADD  A, A
 487+ C364 87             ADD A, A
 487+ C365 80             ADD A, B        ; *5
 488+ C366 87                           ADD  A, A                              ; *10
 489+ C367 81                           ADD  A, C
 490+ C368 C9                           RET
