 480  1792 7E           .co_loop:       LD   A, (HL)
 481  1793 23                           INC  HL                                ; HL = current offset
 482  1794 4F                           LD   C, A                              ; C = prev
 483  1795 7E                           LD   A, (HL)                           ; A = current
 484  1796 B7                           OR   A
 485  1797 28 0D                        JR   Z, .co_next
 486  1799 FA A6 17                     JP   M, .co_next                       ; only positive current offsets can create backward overlap
 487  179C CB 79                        BIT  7, C
 488  179E 20 05                        JR   NZ, .co_clamp                     ; prev negative, current positive -> inverted
 489  17A0 B9                           CP   C
 490  17A1 38 03                        JR   C, .co_next
 491  17A3 28 01                        JR   Z, .co_next
 492  17A5 71           .co_clamp:      LD   (HL), C
 493  17A6 10 EA        .co_next:       DJNZ .co_loop
 494  17A8 E1           .co_done:       POP  HL
 495  17A9 C1                           POP  BC
 496  17AA F1                           POP  AF
 497  17AB C9                           RET
