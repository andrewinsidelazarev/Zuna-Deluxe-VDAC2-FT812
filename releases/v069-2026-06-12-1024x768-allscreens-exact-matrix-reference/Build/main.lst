 494+ 6E42              BOOT_TS_ANIM_START_DELAY EQU 8                ; DrawLoadingScreen ticks before frame 0 starts advancing
 495+ 6E42              BOOT_TS_ANIM_FRAME_DELAY EQU 5                ; extra DrawLoadingScreen ticks to hold each ZX Evolution frame
 496+ 6E42              BOOT_TS_POST_GS_DELAY EQU 24                  ; ordinary ZX ticks after GS music starts, before fade-out
 497+ 6E42              BOOT_TS_FADE_OUT_DELAY EQU 15                 ; hardware fade-out ticks before SFX authors row
 498+ 6E42              BOOT_SFX_AUTHORS_FRAME_DELAY EQU 90           ; extra DrawLoadingScreen ticks to hold each SFX authors reveal frame
 499+ 6E42              BOOT_GS_LABEL_X EQU 624 * 8 / 5               ; 1024×768: (640−16)×1.6=998, right-aligned
