2160  3309              ; ============================================================================
2161  3309              ; DrawTimeValue — нарисовать "M:SS" из VDC_GameSeconds (RTC-based).
2162  3309              ;   Раньше делили StatTimeFrames/60, но при 74Hz видеорежиме это давало
2163  3309              ;   неверное время. Теперь берём VDC_GameSeconds (уже в секундах).
2164  3309              ; ============================================================================
2165  3309              DrawTimeValue:
2166  3309                              ; HL = VDC_GameSeconds (total seconds, RTC-based, pause excluded).
2167  3309                              ; Divide by 60: HL → BC=minutes, remainder=seconds.
2168  3309 2A A9 69                     LD   HL, (Core.VDC_GameSeconds)
2169  330C 11 3C 00                     LD   DE, 60
2170  330F 01 00 00                     LD   BC, 0
2171  3312 A7           .dt_div2:       AND  A
2172  3313 ED 52                        SBC  HL, DE
2173  3315 38 03                        JR   C, .dt_minutes_done
2174  3317 03                           INC  BC
2175  3318 18 F8                        JR   .dt_div2
2176  331A              .dt_minutes_done:
2177  331A 19                           ADD  HL, DE                             ; восстановить HL = remainder = seconds (0..59)
2178  331B                              ; BC = minutes, HL_low = seconds. Format "M:SS"
2179  331B 79                           LD   A, C
2180  331C C6 30                        ADD  A, '0'                             ; minute digit (0..9)
2181  331E 32 4D 33                     LD   (DrawNumBuf), A
2182  3321 3E 3A                        LD   A, ':'                             ; cancun8 имеет colon
2183  3323 32 4E 33                     LD   (DrawNumBuf+1), A
2184  3326 7D                           LD   A, L                               ; seconds 0..59
2185  3327 06 2F                        LD   B, '0' - 1
2186  3329 04           .dt_s10:        INC  B
2187  332A D6 0A                        SUB  10
2188  332C 30 FB                        JR   NC, .dt_s10
2189  332E C6 0A                        ADD  A, 10
2190  3330 4F                           LD   C, A                                ; save units
2191  3331 78                           LD   A, B
2192  3332 32 4F 33                     LD   (DrawNumBuf+2), A                   ; tens digit
2193  3335 79                           LD   A, C
2194  3336 C6 30                        ADD  A, '0'
2195  3338 32 50 33                     LD   (DrawNumBuf+3), A                   ; units digit
2196  333B AF                           XOR  A
2197  333C 32 51 33                     LD   (DrawNumBuf+4), A                   ; null terminator
2198  333F 21 4D 33                     LD   HL, DrawNumBuf
2199  3342 ED 4B 5B 30                  LD   BC, (DrawStr_CurX)
2200  3346 ED 5B 5D 30                  LD   DE, (DrawStr_Y)
2201  334A C3 A6 2F                     JP   DrawString
