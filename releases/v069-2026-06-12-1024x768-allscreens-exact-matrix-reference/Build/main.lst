 198+ 6A72              ; ----------------------------------------------------------------------------
 199+ 6A72              ; Overlay trampolines (resident). Each maps LOADER_OVL_PAGE into slot 3, calls
 200+ 6A72              ; the real OVL_* routine in the overlay, then restores PAGE3=#04. Done under DI
 201+ 6A72              ; so an interrupt never sees slot 3 holding the loader page. CF (load result) is
 202+ 6A72              ; preserved across SetPage3 (it only touches HL) and the final EI.
 203+ 6A72              ; ----------------------------------------------------------------------------
 204+ 6A72              LoadGameplayLevelSpecificFromPack:
 205+ 6A72 F3                           DI
 206+ 6A73                              SetPage3 LOADER_OVL_PAGE
 206+ 6A73             >                ifdef MAPPING_REGISTERS
 206+ 6A73 21 13 04    >                LD HL, FMADDR_REGS + HIGH PAGE3
 206+ 6A76 36 40       >                LD (HL), LOADER_OVL_PAGE & 0xFF
 206+ 6A78             >                else
 206+ 6A78 ~           >                LD A, Page? & 0xFF
 206+ 6A78 ~           >                LD (MemoryPages + 3), A
 206+ 6A78 ~           >                LD BC, PAGE3
 206+ 6A78 ~           >                OUT (C), A
 206+ 6A78             >                endif
 207+ 6A78 CD DE E8                     CALL OVL_LoadGameplayLevelSpecificFromPack
 208+ 6A7B F3                           DI                                     ; overlay (ZiFi_Done) re-enabled IRQs; re-disable to restore slot 3 atomically
 209+ 6A7C                              SetPage3 #04
 209+ 6A7C             >                ifdef MAPPING_REGISTERS
 209+ 6A7C 21 13 04    >                LD HL, FMADDR_REGS + HIGH PAGE3
 209+ 6A7F 36 04       >                LD (HL), #04 & 0xFF
 209+ 6A81             >                else
 209+ 6A81 ~           >                LD A, Page? & 0xFF
 209+ 6A81 ~           >                LD (MemoryPages + 3), A
 209+ 6A81 ~           >                LD BC, PAGE3
 209+ 6A81 ~           >                OUT (C), A
 209+ 6A81             >                endif
 210+ 6A81 FB                           EI
 211+ 6A82 C9                           RET
 212+ 6A83
 213+ 6A83              ; Called only from level-select (LevelSelect.asm + LevelSelectApplyLevelClick),
 214+ 6A83              ; which runs on the UI overlay (#41) — so restore #41, not #04, else the scene
 215+ 6A83              ; code vanishes from slot 3 on return. (The gameplay trampoline above is only
 216+ 6A83              ; reached from gameplay, so it correctly restores #04.)
 217+ 6A83              LoadLevelSelectPreviewAssets:
 218+ 6A83 F3                           DI
 219+ 6A84                              SetPage3 LOADER_OVL_PAGE
 219+ 6A84             >                ifdef MAPPING_REGISTERS
 219+ 6A84 21 13 04    >                LD HL, FMADDR_REGS + HIGH PAGE3
 219+ 6A87 36 40       >                LD (HL), LOADER_OVL_PAGE & 0xFF
 219+ 6A89             >                else
 219+ 6A89 ~           >                LD A, Page? & 0xFF
 219+ 6A89 ~           >                LD (MemoryPages + 3), A
 219+ 6A89 ~           >                LD BC, PAGE3
 219+ 6A89 ~           >                OUT (C), A
 219+ 6A89             >                endif
 220+ 6A89 CD 82 EA                     CALL OVL_LoadLevelSelectPreviewAssets
 221+ 6A8C F3                           DI
 222+ 6A8D                              SetPage3 UI_OVL_PAGE                    ; restore UI overlay (level-select), not #04
 222+ 6A8D             >                ifdef MAPPING_REGISTERS
 222+ 6A8D 21 13 04    >                LD HL, FMADDR_REGS + HIGH PAGE3
 222+ 6A90 36 41       >                LD (HL), UI_OVL_PAGE & 0xFF
 222+ 6A92             >                else
 222+ 6A92 ~           >                LD A, Page? & 0xFF
 222+ 6A92 ~           >                LD (MemoryPages + 3), A
 222+ 6A92 ~           >                LD BC, PAGE3
 222+ 6A92 ~           >                OUT (C), A
 222+ 6A92             >                endif
 223+ 6A92 FB                           EI
 224+ 6A93 C9                           RET
