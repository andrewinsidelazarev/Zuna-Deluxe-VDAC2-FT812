2400  3A6A 18 FA                        JR   .frc_sh
2401  3A6C B2           .frc_sh_done:   OR   D
2402  3A6D 57                           LD   D, A
2403  3A6E 0D           .frc_msk_skip:  DEC  C
2404  3A6F 20 EB                        JR   NZ, .frc_ml
2405  3A71                              ; --- Check input color B against mask D (skip if 0xFF) ---
2406  3A71 78                           LD   A, B
2407  3A72 FE 06                        CP   Core.VDC_NUM_COLORS
2408  3A74 30 10                        JR   NC, .frc_pick_new                 ; B >= NUM_COLORS (including 0xFF) → force fresh
2409  3A76 5F                           LD   E, A                              ; check bit B in mask
2410  3A77 3E 01                        LD   A, 1
2411  3A79 1C                           INC  E
2412  3A7A 1D           .frc_chsh:      DEC  E
2413  3A7B 28 03                        JR   Z, .frc_chsh_done
2414  3A7D 87                           ADD  A, A
2415  3A7E 18 FA                        JR   .frc_chsh
2416  3A80 A2           .frc_chsh_done: AND  D
2417  3A81 28 03                        JR   Z, .frc_pick_new                  ; B not in mask → fresh
2418  3A83 78                           LD   A, B                              ; keep input color
2419  3A84 18 6D                        JR   .frc_exit
2420  3A86              .frc_pick_new:
2421  3A86                              ; --- Popcount mask D → B (число цветов в цепи) ---
2422  3A86 06 00                        LD   B, 0
2423  3A88 1E 06                        LD   E, Core.VDC_NUM_COLORS            ; parametric (Gemini fix)
2424  3A8A 7A                           LD   A, D
2425  3A8B 0F           .frc_pc:        RRCA
2426  3A8C 30 01                        JR   NC, .frc_pc_skip
2427  3A8E 04                           INC  B
2428  3A8F 1D           .frc_pc_skip:   DEC  E
2429  3A90 20 F9                        JR   NZ, .frc_pc
2430  3A92                              ; --- Exclude bit (если popcount >= 3 и FROG_EXCLUDE_COLOR_ADDR valid) ---
2431  3A92 78                           LD   A, B
2432  3A93 FE 03                        CP   3
2433  3A95 38 1F                        JR   C, .frc_no_excl
2434  3A97 3A 8B 4C                     LD   A, (FROG_EXCLUDE_COLOR_ADDR)
2435  3A9A FE 06                        CP   Core.VDC_NUM_COLORS
2436  3A9C 30 13                        JR   NC, .frc_excl_reset               ; #FF / out-of-range → no excl, но reset
2437  3A9E 5F                           LD   E, A
2438  3A9F 3E 01                        LD   A, 1
2439  3AA1 1C                           INC  E
2440  3AA2 1D           .frc_xsh:       DEC  E
2441  3AA3 28 03                        JR   Z, .frc_xsh_done
2442  3AA5 87                           ADD  A, A
2443  3AA6 18 FA                        JR   .frc_xsh
2444  3AA8 5F           .frc_xsh_done:  LD   E, A                              ; E = bit mask
2445  3AA9 A2                           AND  D
2446  3AAA 28 05                        JR   Z, .frc_excl_reset                ; bit not в mask → skip
2447  3AAC 7B                           LD   A, E
2448  3AAD 2F                           CPL
2449  3AAE A2                           AND  D
2450  3AAF 57                           LD   D, A                              ; mask -= bit
2451  3AB0 05                           DEC  B                                  ; popcount--
2452  3AB1              .frc_excl_reset:
2453  3AB1 3E FF                        LD   A, #FF
2454  3AB3 32 8B 4C                     LD   (FROG_EXCLUDE_COLOR_ADDR), A      ; consume — RefilterCurrent calls должны не unaffected
2455  3AB6              .frc_no_excl:
2456  3AB6 78                           LD   A, B
2457  3AB7 B7                           OR   A
2458  3AB8 28 36                        JR   Z, .frc_fb                        ; mask empty → fallback
2459  3ABA                              ; --- pick index 0..B-1 via mul-then-shift: (rand8 * B) >> 8.
2460  3ABA                              ; Bias ≤ 1/(256/B) ≤ 1.6%. Старый `AND 3 + mod B` на 4-value
2461  3ABA                              ; источнике давал при popcount=3 LSB-цвету маски 50% vs 25% —
2462  3ABA                              ; визуально «слишком много <цвет-0-маски>» (purple bias).
2463  3ABA D5                           PUSH DE                                ; save D = mask (E irrelevant)
2464  3ABB C5                           PUSH BC                                ; save B = popcount
2465  3ABC CD 29 3B                     CALL VDC_Random8                       ; A = 0..255 uniform LFSR
2466  3ABF 57                           LD   D, A                              ; D = rand (preserve)
2467  3AC0                              ; --- Optional RTC mix into RAND BYTE (not seed!) every 128th NewNextColor ---
2468  3AC0 21 8A 4C                     LD   HL, FROG_RTC_MIX_FLAG_ADDR
2469  3AC3 7E                           LD   A, (HL)
2470  3AC4 B7                           OR   A
2471  3AC5 28 09                        JR   Z, .frc_no_rtc_mix
2472  3AC7 36 00                        LD   (HL), 0                           ; consume flag
2473  3AC9 D5                           PUSH DE
2474  3ACA CD 05 C3                     CALL Core.ReadRTCSeconds               ; A = 0..59 binary
2475  3ACD D1                           POP  DE                                 ; D = rand
2476  3ACE AA                           XOR  D                                  ; rand XOR RTC
2477  3ACF 57                           LD   D, A
2478  3AD0              .frc_no_rtc_mix:
2479  3AD0 C1                           POP  BC                                 ; restore B = popcount
2480  3AD1 58                           LD   E, B                              ; E = popcount
2481  3AD2 CD 7C DA                     CALL Core.Frog_Mul8x8u                 ; HL = D*E (clobbers A,B,DE)
2482  3AD5 D1                           POP  DE                                 ; restore D = mask
2483  3AD6 4C                           LD   C, H                              ; C = (rand*B)>>8 = 0..B-1
2484  3AD7                              ; --- Walk mask D LSB→MSB, return color of C-th set bit ---
2485  3AD7 1E 00                        LD   E, 0                              ; E = current color index
2486  3AD9 7A           .frc_walk:      LD   A, D
2487  3ADA E6 01                        AND  #01
2488  3ADC 28 05                        JR   Z, .frc_walk_skip
2489  3ADE 79                           LD   A, C
2490  3ADF B7                           OR   A
2491  3AE0 28 06                        JR   Z, .frc_walk_found
2492  3AE2 0D                           DEC  C
2493  3AE3 CB 3A        .frc_walk_skip: SRL  D
2494  3AE5 1C                           INC  E
2495  3AE6 18 F1                        JR   .frc_walk
2496  3AE8              .frc_walk_found:
2497  3AE8 7B                           LD   A, E
2498  3AE9 18 08                        JR   .frc_exit
2499  3AEB              .frc_fb_in:     ; empty chain: keep input B if valid, else random unfiltered
2500  3AEB 78                           LD   A, B
2501  3AEC FE 06                        CP   Core.VDC_NUM_COLORS
2502  3AEE 38 03                        JR   C, .frc_exit                      ; B < NUM_COLORS → keep
2503  3AF0 CD 69 CF     .frc_fb:        CALL Core.VDC_RandomColor              ; уже выдаёт 0..NUM_COLORS-1
2504  3AF3                              ; (убрана hardcoded AND 3 — Gemini fix; VDC_RandomColor сам маскирует)
2505  3AF3 E1           .frc_exit:      POP  HL
2506  3AF4 D1                           POP  DE
2507  3AF5 C1                           POP  BC
2508  3AF6 C9                           RET
2509  3AF7
2510  3AF7              ; Frog_RefilterCurrent — каждый кадр check BallColor/NextBallColor against
2511  3AF7              ; chain mask; replace если color удалён cascade match-3.
2512  3AF7              Frog_RefilterCurrent:
2513  3AF7 3A AB 69                     LD   A, (Core.Frog_BallColor)
2514  3AFA CD 4B 3A                     CALL Frog_FilteredRandomColor
2515  3AFD 32 AB 69                     LD   (Core.Frog_BallColor), A
2516  3B00 3A AC 69                     LD   A, (Core.Frog_NextBallColor)
2517  3B03 CD 4B 3A                     CALL Frog_FilteredRandomColor
2518  3B06 32 AC 69                     LD   (Core.Frog_NextBallColor), A
2519  3B09 C9                           RET
2520  3B0A
2521  3B0A              ; Frog_NewNextColor — force fresh new NextBallColor (= после promote при start fire).
2522  3B0A              ; Counter mod 128: каждый 128-й вызов взводит FLAG, и следующий pick в
2523  3B0A              ; Frog_FilteredRandomColor XOR'ит RTC seconds в RAND BYTE (выход LFSR, не seed).
2524  3B0A              ; Это сохраняет цикл LFSR неприкосновенным (Gemini совет), но добавляет точечный
2525  3B0A              ; перетряс распределения раз в ~128 выстрелов.
2526  3B0A              Frog_NewNextColor:
2527  3B0A 21 89 4C                     LD   HL, FROG_RTC_MIX_CNT_ADDR
2528  3B0D 7E                           LD   A, (HL)
2529  3B0E 3C                           INC  A
2530  3B0F E6 7F                        AND  #7F                              ; counter mod 128
2531  3B11 77                           LD   (HL), A
2532  3B12 B7                           OR   A
2533  3B13 20 05                        JR   NZ, .nnc_no_flag                 ; cnt != 0 → no boundary
2534  3B15 3E 01                        LD   A, 1
2535  3B17 32 8A 4C                     LD   (FROG_RTC_MIX_FLAG_ADDR), A      ; mark for picker to consume
2536  3B1A              .nnc_no_flag:
2537  3B1A                              ; Exclude BallColor from mask если popcount активных цветов >= 3.
2538  3B1A                              ; Юзер: «следующий шар лягушки» не должен совпадать с предыдущим
2539  3B1A                              ; (когда в цепи 3+ цветов; иначе чередование вынужденное).
2540  3B1A 3A AB 69                     LD   A, (Core.Frog_BallColor)
2541  3B1D 32 8B 4C                     LD   (FROG_EXCLUDE_COLOR_ADDR), A
2542  3B20 3E FF                        LD   A, #FF                            ; sentinel: force fresh
2543  3B22 CD 4B 3A                     CALL Frog_FilteredRandomColor
2544  3B25 32 AC 69                     LD   (Core.Frog_NextBallColor), A
2545  3B28 C9                           RET
2546  3B29
2547  3B29              ; ============================================================================
2548  3B29              ; VDC_Random8 — LFSR Galois 16-bit (poly 0xB400), 8-bit uniform 0..255.
2549  3B29              ; Тот же LFSR step что Core.VDC_RandomColor, но без AND-mask. Используется
2550  3B29              ; Frog_FilteredRandomColor для unbiased mod-B через (rand * B) >> 8 — это
2551  3B29              ; нужно когда popcount(mask) не степень двойки (B=3 в основном). Старый AND 3
2552  3B29              ; + mod B давал bias 50%/25%/25% для popcount=3 → видимый перекос колора.
2553  3B29              ; Разделяет Core.VDC_LfsrSeed с VDC_RandomColor (оба stepper'а двигают одну
2554  3B29              ; и ту же последовательность атомарно — без корреляции).
2555  3B29              ; ============================================================================
2556  3B29              VDC_Random8:
2557  3B29 2A 8E D3                     LD   HL, (Core.VDC_LfsrSeed)
2558  3B2C 7D                           LD   A, L
2559  3B2D E6 01                        AND  1
2560  3B2F CB 3C                        SRL  H
2560  3B31 CB 1D          RR L
2561  3B33 30 0A                        JR   NC, .r8_no_xor
2562  3B35 16 B4                        LD   D, #B4
2562  3B37 1E 00          LD E, 0
2563  3B39 7C                           LD   A, H
2563  3B3A AA             XOR D
2563  3B3B 67             LD H, A
2564  3B3C 7D                           LD   A, L
2564  3B3D AB             XOR E
2564  3B3E 6F             LD L, A
2565  3B3F              .r8_no_xor:
2566  3B3F 22 8E D3                     LD   (Core.VDC_LfsrSeed), HL
2567  3B42 7D                           LD   A, L
2568  3B43 AC                           XOR  H                                 ; 8-bit uniform
2569  3B44 C9                           RET
2570  3B45
2571  3B45              ; ----------------------------------------------------------------------------
2572  3B45              ; ZX7 Turbo decompressor (Einar Saukas / Urusergi). HL = compressed src,
2573  3B45              ; DE = destination. Восстановлен из ~/Desktop/Zuma Deluxe (src/ASM,
2574  3B45              ; zuma_new_spg.asm:4466). Размер ~62 байта. Не корраптит I, IX, IY.
2575  3B45              ; Используется через UnpackZX7Page wrapper. На входе HL/DE должны указывать
2576  3B45              ; в WRITABLE области (исходник можно в slot 2 ROM-like, dest в RAM).
2577  3B45              ; ----------------------------------------------------------------------------
2578  3B45              Dzx7Turbo:
2579  3B45 3E 80                        LD   A, #80
2580  3B47              .zx7_copy_byte_loop:
2581  3B47 ED A0                        LDI
2582  3B49              .zx7_main_loop:
2583  3B49 87                           ADD  A, A
2584  3B4A CC 9A 3B                     CALL Z, .zx7_load_bits
2585  3B4D 30 F8                        JR   NC, .zx7_copy_byte_loop
2586  3B4F D5                           PUSH DE
2587  3B50 01 01 00                     LD   BC, 1
2588  3B53 50                           LD   D, B
2589  3B54              .zx7_len_size_loop:
2590  3B54 14                           INC  D
2591  3B55 87                           ADD  A, A
2592  3B56 CC 9A 3B                     CALL Z, .zx7_load_bits
2593  3B59 30 F9                        JR   NC, .zx7_len_size_loop
2594  3B5B C3 68 3B                     JP   .zx7_len_value_start
2595  3B5E              .zx7_len_value_loop:
2596  3B5E 87                           ADD  A, A
2597  3B5F CC 9A 3B                     CALL Z, .zx7_load_bits
2598  3B62 CB 11                        RL   C
2599  3B64 CB 10                        RL   B
2600  3B66 38 2D                        JR   C, .zx7_exit
2601  3B68              .zx7_len_value_start:
2602  3B68 15                           DEC  D
2603  3B69 20 F3                        JR   NZ, .zx7_len_value_loop
2604  3B6B 03                           INC  BC
2605  3B6C 5E                           LD   E, (HL)
2606  3B6D 23                           INC  HL
2607  3B6E CB 33                        DB   #CB, #33                          ; SLL E / SLS E (undoc)
2608  3B70 30 1A                        JR   NC, .zx7_offset_end
2609  3B72 87                           ADD  A, A
2610  3B73 CC 9A 3B                     CALL Z, .zx7_load_bits
2611  3B76 CB 12                        RL   D
2612  3B78 87                           ADD  A, A
2613  3B79 CC 9A 3B                     CALL Z, .zx7_load_bits
2614  3B7C CB 12                        RL   D
2615  3B7E 87                           ADD  A, A
2616  3B7F CC 9A 3B                     CALL Z, .zx7_load_bits
2617  3B82 CB 12                        RL   D
2618  3B84 87                           ADD  A, A
2619  3B85 CC 9A 3B                     CALL Z, .zx7_load_bits
2620  3B88 3F                           CCF
2621  3B89 38 01                        JR   C, .zx7_offset_end
2622  3B8B 14                           INC  D
2623  3B8C              .zx7_offset_end:
2624  3B8C CB 1B                        RR   E
2625  3B8E E3                           EX   (SP), HL
2626  3B8F E5                           PUSH HL
2627  3B90 ED 52                        SBC  HL, DE
2628  3B92 D1                           POP  DE
2629  3B93 ED B0                        LDIR
2630  3B95              .zx7_exit:
2631  3B95 E1                           POP  HL
2632  3B96 D2 49 3B                     JP   NC, .zx7_main_loop
2633  3B99 C9                           RET
2634  3B9A              .zx7_load_bits:
2635  3B9A 7E                           LD   A, (HL)
2636  3B9B 23                           INC  HL
2637  3B9C 17                           RLA
2638  3B9D C9                           RET
2639  3B9E
2640  3B9E              ; ----------------------------------------------------------------------------
2641  3B9E              ; SCRATCH_PAGE — свободная SPG page для decomp output. Используется
2642  3B9E              ; UnpackAndUploadPage в Initialize между bg/balls/frog uploads.
2643  3B9E              ; Page #01 не задействован ни одним Block в spgbld_vdac2.ini — безопасно.
2644  3B9E              ; ----------------------------------------------------------------------------
2645  3B9E              SCRATCH_PAGE    EQU #01
2646  3B9E
2647  3B9E              ; ----------------------------------------------------------------------------
2648  3B9E              ; UnpackAndUploadPage: расжать compressed src page A → SCRATCH_PAGE,
2649  3B9E              ; залить 16K из SCRATCH_PAGE в FT_RAM_G по адресу (Core.BgRamH:BgRamL),
2650  3B9E              ; продвинуть указатель FT_RAM_G на +#4000.
2651  3B9E              ;
2652  3B9E              ; In:  A = compressed source SPG page; Core.BgRamH/L = FT_RAM_G dest 24-bit
2653  3B9E              ; Out: Core.BgRamH/L advanced by 16K
2654  3B9E              ; Slots after RET: slot 2 = src (not restored), slot 3 = current scene overlay
2655  3B9E              ; (Core.CurrentCodePage). Restoring slot 3 here keeps dumps and any call-side code
2656  3B9E              ; from observing the transient scratch page between compressed uploads.
2657  3B9E              ; ----------------------------------------------------------------------------
2658  3B9E              ; CurrentCodePage tracks which scene overlay is mapped in slot 3: #41 (UI =
2659  3B9E              ; menu/level-select) or #04 (gameplay). The shared slot0 decompressors below use
2660  3B9E              ; slot 3 as decomp scratch, then restore it to THIS page (not a hard-coded #04),
2661  3B9E              ; so they are correct from any scene. Maintained by the resident Fade* transitions;
2662  3B9E              ; boot default = UI overlay (first scene is the menu). Resident (slot 0/TSLib region).
2663  3B9E 41           CurrentCodePage:  DB UI_OVL_PAGE
2664  3B9F              UnpackAndUploadPage:
2665  3B9F F3                           DI
2666  3BA0 32 F3 3B                     LD   (.uaup_src), A
2667  3BA3 ED 73 F4 3B                  LD   (.uaup_saved_sp), SP
2668  3BA7 31 36 3C                     LD   SP, .uaup_temp_stack_top
2669  3BAA
2670  3BAA                              ; slot 2 = compressed src
2671  3BAA 3A F3 3B                     LD   A, (.uaup_src)
2671  3BAD 01 AF 12       LD BC, PAGE2
2671  3BB0 ED 79          OUT (C), A
2672  3BB2                              ; slot 3 = scratch (decomp dest)
2673  3BB2 3E 01                        LD   A, SCRATCH_PAGE
2673  3BB4 01 AF 13       LD BC, PAGE3
2673  3BB7 ED 79          OUT (C), A
2674  3BB9
2675  3BB9                              ; Dzx7Turbo: HL=src, DE=dst
2676  3BB9 21 00 80                     LD   HL, #8000
2677  3BBC 11 00 C0                     LD   DE, #C000
2678  3BBF CD 45 3B                     CALL Dzx7Turbo
2679  3BC2
2680  3BC2                              ; FT.WriteMem(HL=#C000 in slot 3, BC=16384, A:DE=FT_RAM_G addr)
2681  3BC2 21 00 C0                     LD   HL, #C000
2682  3BC5 01 00 40                     LD   BC, 16384
2683  3BC8 3A 7F 65                     LD   A, (Core.BgRamH)
2684  3BCB ED 5B 7D 65                  LD   DE, (Core.BgRamL)
2685  3BCF CD 6A 12                     CALL FT.WriteMem
2686  3BD2
2687  3BD2                              ; Advance Core.BgRamL/H by 16K
2688  3BD2 2A 7D 65                     LD   HL, (Core.BgRamL)
2689  3BD5 11 00 40                     LD   DE, #4000
2690  3BD8 19                           ADD  HL, DE
2691  3BD9 22 7D 65                     LD   (Core.BgRamL), HL
2692  3BDC 30 07                        JR   NC, .uaup_no_carry
2693  3BDE 3A 7F 65                     LD   A, (Core.BgRamH)
2693  3BE1 3C             INC A
2693  3BE2 32 7F 65       LD (Core.BgRamH), A
2694  3BE5              .uaup_no_carry:
2695  3BE5 3A 9E 3B                     LD   A, (CurrentCodePage)
2695  3BE8 01 AF 13       LD BC, PAGE3
2695  3BEB ED 79          OUT (C), A   ; restore slot 3 = current scene overlay (#41 ui / #04 gameplay)
2696  3BED ED 7B F4 3B                  LD   SP, (.uaup_saved_sp)
2697  3BF1 FB                           EI
2698  3BF2 C9                           RET
2699  3BF3 00           .uaup_src:        DB 0
2700  3BF4 00 00        .uaup_saved_sp:   DW 0
2701  3BF6 00 00 00...  .uaup_temp_stack: DEFS 64
2702  3C36              .uaup_temp_stack_top:
2703  3C36
2704  3C36              ; ----------------------------------------------------------------------------
2705  3C36              ; UnpackZX7Page: расжать compressed page A → dest page B.
2706  3C36              ; Source = slot 2 (#8000), dest = slot 3 (#C000). После RET слоты восстановлены:
2707  3C36              ; slot 2 → page 6 (TrackData), slot 3 → page #04 (main1_play).
2708  3C36              ; Stack пересажен на uzx7_temp_stack чтобы LDIR в slot 3 не зацепил наш стек.
2709  3C36              ; ----------------------------------------------------------------------------
2710  3C36              UnpackZX7Page:
2711  3C36 F3                           DI
2712  3C37 32 73 3C                     LD   (.uzx7_src), A
2713  3C3A 78                           LD   A, B
2713  3C3B 32 74 3C       LD (.uzx7_dst), A
2714  3C3E ED 73 75 3C                  LD   (.uzx7_saved_sp), SP
2715  3C42 31 B7 3C                     LD   SP, .uzx7_temp_stack_top
2716  3C45 3A 73 3C                     LD   A, (.uzx7_src)
2716  3C48 01 AF 12       LD BC, PAGE2
2716  3C4B ED 79          OUT (C), A
2717  3C4D 3A 74 3C                     LD   A, (.uzx7_dst)
2717  3C50 01 AF 13       LD BC, PAGE3
2717  3C53 ED 79          OUT (C), A
2718  3C55 21 00 80                     LD   HL, #8000
2719  3C58 11 00 C0                     LD   DE, #C000
2720  3C5B CD 45 3B                     CALL Dzx7Turbo
2721  3C5E 3E 06                        LD   A, 6
2721  3C60 01 AF 12       LD BC, PAGE2
2721  3C63 ED 79          OUT (C), A   ; restore slot 2 = TrackData page
2722  3C65 3A 9E 3B                     LD   A, (CurrentCodePage)
2722  3C68 01 AF 13       LD BC, PAGE3
2722  3C6B ED 79          OUT (C), A   ; restore slot 3 = current scene overlay (#41 ui / #04 gameplay)
2723  3C6D ED 7B 75 3C                  LD   SP, (.uzx7_saved_sp)
2724  3C71 FB                           EI
2725  3C72 C9                           RET
2726  3C73 00           .uzx7_src:        DB 0
2727  3C74 00           .uzx7_dst:        DB 0
2728  3C75 00 00        .uzx7_saved_sp:   DW 0
2729  3C77 00 00 00...  .uzx7_temp_stack: DEFS 64
2730  3CB7              .uzx7_temp_stack_top:
2731  3CB7
2732  3CB7              ; ----------------------------------------------------------------------------
2733  3CB7              ; SafeInflatePage2: FT812 CMD_INFLATE with compressed source mapped in PAGE2.
2734  3CB7              ;
2735  3CB7              ; TSLib FT.Coprocessor.Inflate maps source pages into PAGE3/#C000, which is also
2736  3CB7              ; our main1_play code slot. Fresh host dumps showed CPU HALT while PAGE3 was a
2737  3CB7              ; zlib preview page (#F1). This variant keeps PAGE3 untouched and streams the
2738  3CB7              ; source from PAGE2/#8000 instead.
2739  3CB7              ;
2740  3CB7              ; In: same convention as FT.Coprocessor.Inflate for current callers:
2741  3CB7              ;   A:DE = RAM_G destination, BC = compressed byte count, HL = source offset,
2742  3CB7              ;   A' = source SPG page. Current assets are all <64K compressed.
2743  3CB7              ; Out: CF set only if coprocessor write reports fault.
2744  3CB7              ; Slots after RET: PAGE2 restored to previous value; PAGE3 unchanged.
2745  3CB7              ; ----------------------------------------------------------------------------
