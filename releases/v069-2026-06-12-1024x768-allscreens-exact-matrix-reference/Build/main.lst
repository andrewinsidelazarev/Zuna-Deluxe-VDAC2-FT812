 197++C406              ;--- SD state ---
 198++C406 00 00 00 00  sd_lba          ds      4
 199++C40A 00           sd_blkt         db      0
 200++C40B 00 00 00 00  sd_lba_max      ds      4               ; верхняя граница LBA тома (PartLba+TotSec32); 0=выключено
