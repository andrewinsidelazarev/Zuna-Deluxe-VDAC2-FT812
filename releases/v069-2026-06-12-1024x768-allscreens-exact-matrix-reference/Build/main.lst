 555+ C755              MenuDrawSun:
 556+ C755                              ; Солнце и свечение — отдельные спрайты поверх фона. Анимация по фазе
 557+ C755                              ; MenuSunPhase: солнце плавно «дышит» масштабом (cmd_scale), свечение —
 558+ C755                              ; пульс alpha. Значения считаем В ПАМЯТЬ заранее (макросы FT_Bitmap*
 559+ C755                              ; клобают BCDE).
 560+ C755                              ; alpha свечения = 150 + sin(GlowPhase)>>2 → 119..181 (своя фаза/скорость)
 561+ C755 3A 5A CE                     LD   A, (MenuGlowPhase)
 562+ C758 06 02                        LD   B, 2
 563+ C75A CD E6 C8                     CALL MenuSinShiftHL
 564+ C75D 7D                           LD   A, L
 565+ C75E C6 96                        ADD  A, 150
 566+ C760 32 5F CE                     LD   (MenuGlowAlpha), A
 567+ C763                              ; 1024×768: масштаб солнца 16.16 на базе 1.6, ТОЛЬКО уменьшение:
 568+ C763                              ;   s = 1.6 + (sin-127)*13/65536 → s ∈ [1.550 .. 1.6] (та же глубина
 569+ C763                              ;   дыхания ±3.1%, что и было на базе 1.0: offset ×13 ≈ ×8×1.6).
 570+ C763                              ;   Только shrink — у спрайта солнца НЕТ прозрачных полей (лучи до
 571+ C763                              ;   краёв), при увеличении лучи бы обрезались фиксированным BITMAP_SIZE.
 572+ C763                              ;   offset ∈ [-3302..0] не андерфлоит #999A → ScaleHi = 1 ВСЕГДА.
 573+ C763 3A 59 CE                     LD   A, (MenuSunPhase)
 574+ C766 5F                           LD   E, A
 574+ C767 16 00          LD D, 0
 575+ C769 21 F7 C8                     LD   HL, MenuSunSinTable
 576+ C76C 19                           ADD  HL, DE
 577+ C76D 7E                           LD   A, (HL)                            ; A = sin(phase), signed
 578+ C76E 6F                           LD   L, A
 578+ C76F 87             ADD A, A
 578+ C770 9F             SBC A, A
 578+ C771 67             LD H, A   ; HL = sign-extended sin (-128..127)
 579+ C772 11 81 FF                     LD   DE, -127
