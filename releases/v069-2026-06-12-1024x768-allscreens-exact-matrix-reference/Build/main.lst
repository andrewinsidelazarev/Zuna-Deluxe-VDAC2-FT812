  82+ 7CF1 FE E0                        CP   #E0
  82+ 7CF3 28 07          JR Z, .next                     ; префикс extended -> игнор (коды уникальны)
  83+ 7CF5 FE F0                        CP   #F0
  83+ 7CF7 28 0D          JR Z, .set_brk                  ; префикс break -> следующий код = отпускание
  84+ 7CF9 CD 0D 7D                     CALL Input_SetKey
  85+ 7CFC 3A AB 7C     .next:          LD   A, (Input_DrainCnt)
