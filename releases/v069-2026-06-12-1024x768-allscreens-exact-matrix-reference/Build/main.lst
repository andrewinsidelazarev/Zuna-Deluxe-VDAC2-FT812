4482  C000                              include "ts-dos.asm"
# file opened: Source\ASM\ts-dos.asm
   1+ C000              ; ts-dos.asm — wrappers around the WC TS-DOS / WildDOS FAT32 file-I/O entry
   2+ C000              ; table at #2002 (FENTRY/LOAD512/SEEK0/...). This is the DOS file system, NOT
   3+ C000              ; the ZiFi radio feature (earlier code misnamed it "ZiFi" because the entry
   4+ C000              ; table was first documented from WC's zifi.asm).
   5+ C000              ;
   6+ C000              ; Provided by Wild Commander when SPG is launched via WC. At runtime
   7+ C000              ; page #0F holds the driver; we map it into slot 0 around each
   8+ C000              ; call, then restore TSLib (page #00).
   9+ C000              ;
  10+ C000              ; NOTE: gameplay now streams level assets from ZUMALVL.PAK through a
  11+ C000              ; self-contained reader (RawPak_* below) built on direct SD CMD17 single-sector
  12+ C000              ; reads (sd_zc.asm) plus our own BPB/FAT32 chain walk. This deliberately
  13+ C000              ; BYPASSES the bundled WC TS-DOS driver, whose stateful LOAD512 chain walk
  14+ C000              ; drifted -128 sectors at the first FAT-sector boundary in our SPG context.
  15+ C000              ; Because RawPak computes every FAT sector LBA itself (cluster>>7 + FatStart),
  16+ C000              ; there is no stale mount-state to drift. CMD17 is stable on the Unreal host
  17+ C000              ; (unlike the multi-block CMD18 we abandoned). The bundled-driver entry points
  18+ C000              ; (FENTRY/SETDIR/SETROOT/DOS_SWP/HDD) are no longer called.
  19+ C000              ;
  20+ C000              ; Entry table (from C:\Users\Администратор\Desktop\WC\ZiFi\zifi.asm:4403):
  21+ C000              ;   FENTRY   = #2050    HL = ptr to {flag:1, name:1..255, 0}
  22+ C000              ;                       Z = not found
  23+ C000              ;                       NZ = found, [DE:HL] = file length; SEEK0 auto-called
  24+ C000              ;   LOAD512  = #2017    CHL = dest (C = page, HL = #0000..#3FFF in slot-0 view)
  25+ C000              ;                       B = blocks (× 512 B)
  26+ C000              ;                       on return: CHL advanced, A = #0F if end-of-chain
  27+ C000              ;   LOADNON  = #2056    B = sectors to skip forward (our seek)
  28+ C000              ;   SEEK0    = #2063    rewind file
  29+ C000              ;   SETDIR   = #205D    chdir into directory just found by FENTRY
  30+ C000              ;   SETROOT  = #2060    chdir to /
  31+ C000              ;
  32+ C000              ; Filename format passed to FENTRY:
  33+ C000              ;   DB <flag>, "name", 0
  34+ C000              ;   flag: #00 = file, #10 = directory
  35+ C000              ;
  36+ C000              ; Calling convention (our wrappers):
  37+ C000              ;   - DI on entry (no IRQs during slot-0 swap and SD I/O)
  38+ C000              ;   - Save current slot-0 page (TSLibPage)
  39+ C000              ;   - Map slot 0 = ZIFI_PAGE
  40+ C000              ;   - CALL real entry
  41+ C000              ;   - Restore slot 0 = TSLibPage
  42+ C000              ;   - EI
  43+ C000              ;   - Return result regs (Z/NZ, AF, BC, DE, HL) as documented
  44+ C000
  45+ C000              ZIFI_PAGE       EQU #0F
  46+ C000              ; NOTE: this file is assembled into the SLOT 3 / PAGE #40 loader overlay (see
  47+ C000              ; main.asm). It is mapped in only during a level/preview load. TRACK_PAGE2 /
  48+ C000              ; TRACK_SPLIT_SAMPLE and VDC_ReadSampleAtHL moved to loader_resident.asm (they
  49+ C000              ; must stay resident in Core for per-frame track playback). The named entry
  50+ C000              ; points are reached via the resident trampolines, which call OVL_* below.
  51+ C000              ZIFI_CORE       EQU #2002
  52+ C000              ZIFI_DEV_INI    EQU ZIFI_CORE + 3       ; #2005 — init SD device hardware
  53+ C000              ZIFI_HDD        EQU ZIFI_CORE + 9       ; #200B — init FAT32 layer
  54+ C000              ZIFI_LOAD512    EQU ZIFI_CORE + 21      ; #2017
  55+ C000              ZIFI_DOS_SWP    EQU ZIFI_CORE + 27      ; #201D — toggle DOS swap mode
  56+ C000              ZIFI_FENTRY     EQU ZIFI_CORE + 78      ; #2050
  57+ C000              ZIFI_LOADNON    EQU ZIFI_CORE + 84      ; #2056
  58+ C000              ZIFI_SETDIR     EQU ZIFI_CORE + 93      ; #205D
  59+ C000              ZIFI_SETROOT    EQU ZIFI_CORE + 96      ; #2060
  60+ C000              ZIFI_SEEK0      EQU ZIFI_CORE + 99      ; #2063
  61+ C000
