3953  657C              BG_FIRST_PAGE      EQU 7
3954  657C              BG_PAGE_COUNT      EQU 8                               ; 400×300 PALETTED4444 = 120000 bytes, 8 × 16K pages
3955  657C              BG_RAMG_ADDR       EQU #010000                         ; bg в RAM_G FT812
3956  657C              BG_PALETTE_PAGE    EQU #11      ; moved from #0F: ZiFi SD driver (WDFCVBI2.COD) lives there
3957  657C              BG_PALETTE_RAMG    EQU #02D500                         ; 4-byte aligned, after useful 400×300 bitmap
3958  657C              BALLS_FIRST_PAGE   EQU #2D                             ; balls atlas pages
3959  657C                              if BALLS_ARGB4_ENABLED
