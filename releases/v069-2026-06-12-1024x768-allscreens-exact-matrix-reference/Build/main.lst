1548+ F15B              ; ZL_SpinPhase — A = ((t * ZL_SPIN_K_DEFAULT) >> 8) & ZL_SPIN_MASK.
1549+ F15B              ;   In: HL = VDC_LastT. Out: A = spin phase. Scratch: BC, DE, HL, AF.
1550+ F15B              ;   Current ARGB4 build has K=81, so avoid the 8-iteration generic multiply in
1551+ F15B              ;   the per-ball render hot path. If compile-time K changes, fall back safely.
1552+ F15B              ; ----------------------------------------------------------------------------
1553+ F15B              ZL_SpinPhase:
1554+ F15B                              if ZL_SPIN_K_DEFAULT = 81
1555+ F15B 54                           LD   D, H
