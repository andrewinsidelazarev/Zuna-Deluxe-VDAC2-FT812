1041+ C694 28 F7                        JR   Z, .cluster_color_reroll          ; → reroll
1042+ C696 77                           LD   (HL), A                           ; commit color
1043+ C697 CD 89 CF                     CALL VDC_RandomClusterLength           ; A = total length 1..NUM-1
1044+ C69A                                                                     ; (NB: ZL_Mul16x8 clobs B/C —
1045+ C69A                                                                     ; читаем color из памяти ниже)
1046+ C69A 3D                           DEC  A                                 ; current spawn is first ball
1047+ C69B 32 61 D3                     LD   (VDC_SpawnClusterRem), A
1048+ C69E 18 0E                        JR   .spawn_color_ready
1049+ C6A0              .spawn_single_random:
1050+ C6A0                              ; single path — тоже reroll, чтобы два соседних кластера/single
1051+ C6A0                              ; никогда не были одного цвета.
