  75+ C40F              ; ---------------------------------------------------------------------
  76+ C40F              ; ZiFi_Init — bring up SD driver for a session of file I/O calls.
  77+ C40F              ;   DI, slot 0 = #0F (driver page), DOS_SWP, DEV_INI, HDD, SETROOT.
  78+ C40F              ; After Init, ZiFi entries at #2002..#2070 are directly callable.
  79+ C40F              ;   CF=1 on success, CF=0 on init error. ZiFi_Done must still be called
  80+ C40F              ;   after a successful init.
  81+ C40F              ZiFi_Init:
  82+ C40F F3                           DI
  83+ C410                              ; FT812 и SD на ОДНОЙ SPI-шине Z-Controller (рег #77). Перед началом
  84+ C410                              ; SD-сессии ЯВНО снимаем CS FT812 (#77 = SPI_FT_CS_OFF = #03), иначе,
  85+ C410                              ; если перед этим по шине работал FT812 (boot loading screen), он
  86+ C410                              ; остаётся владельцем шины и первое SD-обращение срывается.
  87+ C410 01 77 00                     LD   BC, #0077
  88+ C413 3E 03                        LD   A, #03
  89+ C415 ED 79                        OUT  (C), A
  90+ C417 01 57 00                     LD   BC, #0057
  91+ C41A 3E FF                        LD   A, #FF
  92+ C41C ED 79                        OUT  (C), A
  93+ C41E 3E 00                        LD   A,  TSLibPage
  94+ C420                              SetPage0_A
  94+ C420             >                ifdef MAPPING_REGISTERS
  94+ C420 32 10 04    >                LD (FMADDR_REGS + HIGH PAGE0), A
  94+ C423             >                else
  94+ C423 ~           >                LD (MemoryPages + 0), A
  94+ C423 ~           >                LD BC, PAGE0
  94+ C423 ~           >                OUT (C), A
  94+ C423             >                endif
  95+ C423 CD DF C2                     CALL sd_init
  96+ C426 37                           SCF
  97+ C427 C9                           RET
  98+ C428 B7           .Err:           OR   A
  99+ C429 C9                           RET
 100+ C42A
 101+ C42A              ; ZiFi_Done — restore TSLib in slot 0, EI.
 102+ C42A              ZiFi_Done:
 103+ C42A 01 77 00                     LD   BC, #0077
 104+ C42D 3E 03                        LD   A, #03
 105+ C42F ED 79                        OUT  (C), A
 106+ C431 01 57 00                     LD   BC, #0057
 107+ C434 3E FF                        LD   A, #FF
 108+ C436 ED 79                        OUT  (C), A
 109+ C438 3E 00                        LD   A,  TSLibPage
 110+ C43A                              SetPage0_A
 110+ C43A             >                ifdef MAPPING_REGISTERS
 110+ C43A 32 10 04    >                LD (FMADDR_REGS + HIGH PAGE0), A
 110+ C43D             >                else
 110+ C43D ~           >                LD (MemoryPages + 0), A
 110+ C43D ~           >                LD BC, PAGE0
 110+ C43D ~           >                OUT (C), A
 110+ C43D             >                endif
 111+ C43D FB                           EI
 112+ C43E C9                           RET
