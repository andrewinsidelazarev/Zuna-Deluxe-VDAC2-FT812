3514  6032              ; ============================================================================
3515  6032              ; WIN-аутро (точно по оригиналу Zuma, Game_UpdateOutro/FX.c): эмиттер бежит по
3516  6032              ; треку ОТ головного шара (ближайшего к килл-зоне) ДО конца трека (килл-зоны),
3517  6032              ; скорость WINEXP_MOVE сэмплов/кадр; каждые WINEXP_PAD сэмплов роняет НЕЗАВИСИМУЮ
3518  6032              ; частицу-взрыв (играет кадры 0..16, frame += 0.5/кадр) + 100 очков. Чем дальше
3519  6032              ; голова была от КЗ — тем длиннее путь — тем больше +100 (бонус за дистанцию).
3520  6032              ; ============================================================================
3521  6032              VDC_UpdateWin:
3522  6032 3A BC 69                     LD   A, (VDC_WinOutroActive)
3523  6035 B7                           OR   A
3524  6036 28 0A                        JR   Z, .legacy                          ; нет аутро → fallback-таймер
3525  6038 CD 6D 61                     CALL VDC_WinOutroUpdate                   ; двигать эмиттеры + стареть частицы
3526  603B CD CF 61                     CALL VDC_WinOutroDone
3527  603E B7                           OR   A
3528  603F C8                           RET  Z                                    ; аутро ещё играет → ждём (таймер не нужен)
3529  6040 18 15                        JR   .win_show_done                       ; дорожка доиграла → диалог
3530  6042 3A 69 D3     .legacy:        LD   A, (VDC_PreviewTick)
3531  6045 B7                           OR   A
3532  6046 28 04                        JR   Z, .pv_done
3533  6048 3D                           DEC  A
3534  6049 32 69 D3                     LD   (VDC_PreviewTick), A
3535  604C 3A 6B D3     .pv_done:       LD   A, (VDC_WinTick)
3536  604F B7                           OR   A
3537  6050 28 05                        JR   Z, .win_show_done
3538  6052 3D                           DEC  A
3539  6053 32 6B D3                     LD   (VDC_WinTick), A
3540  6056 C9                           RET
3541  6057              .win_show_done: ; win-анимация закончилась → показать диалог LEVEL DONE (один раз).
3542  6057 3A 9C 69                     LD   A, (VDC_DialogState)
3543  605A FE 05                        CP   DLG_WIN_DONE
3544  605C D0                           RET  NC                                  ; уже win-done/fade → не пере-триггерить
3545  605D 3E 05                        LD   A, DLG_WIN_DONE
3546  605F 32 9C 69                     LD   (VDC_DialogState), A
3547  6062 AF                           XOR  A
3548  6063 32 8E 69                     LD   (FadeAlpha), A
3549  6066 C9                           RET
3550  6067
3551  6067              ; --- VDC_WinOutroInit — на входе в WIN: эмиттеры из head-сэмплов, пул пуст. ---
3552  6067              VDC_WinOutroInit:
3553  6067                              ; Дозалить атлас WIN-взрыва в регион шаров (#050000) — шаров на
3554  6067                              ; экране уже нет (SlotsLen==0, проверено в VDC_CheckWinMaybe), так
3555  6067                              ; что регион свободен. UnpackAndUploadPage резидентна (slot0),
3556  6067                              ; использует slot3 как scratch и восстанавливает его в
3557  6067                              ; CurrentCodePage (#04) — безопасно из gameplay-контекста.
3558  6067 21 00 00                     LD   HL, WINEXP_RAMG_ADDR & #FFFF
3559  606A 22 7D 65                     LD   (BgRamL), HL
3560  606D 3E 05                        LD   A, (WINEXP_RAMG_ADDR >> 16) & #FF
3561  606F 32 7F 65                     LD   (BgRamH), A
3562  6072 3E 28                        LD   A, WINEXP_PAGE
3563  6074 32 7C 65                     LD   (BgPg), A
3564  6077 06 05                        LD   B, WINEXP_PAGE_COUNT
3565  6079 C5           .winexp_up:     PUSH BC
3566  607A 3A 7C 65                     LD   A, (BgPg)
3567  607D CD 9F 3B                     CALL UnpackAndUploadPage
3568  6080 C1                           POP  BC
3569  6081 3A 7C 65                     LD   A, (BgPg)
3570  6084 3C                           INC  A
3571  6085 32 7C 65                     LD   (BgPg), A
3572  6088 10 EF                        DJNZ .winexp_up
3573  608A
3574  608A AF                           XOR  A
3575  608B 32 BC 69                     LD   (VDC_WinOutroActive), A
3576  608E                              ; пул частиц → все мёртвые (f2=255 на смещении +4)
3577  608E DD 21 C5 69                  LD   IX, VDC_WinPrtcl
3578  6092 06 20                        LD   B, WIN_PRTCL_MAX
3579  6094 DD 36 04 FF  .oi_clr:        LD   (IX+4), 255
3580  6098 11 05 00                     LD   DE, 5
3580  609B DD 19          ADD IX, DE
3581  609D 10 F5                        DJNZ .oi_clr
3582  609F                              ; chain1 эмиттер из VDC_WinHeadS1
3583  609F 2A B5 69                     LD   HL, (VDC_WinHeadS1)
3584  60A2 7C                           LD   A, H
3584  60A3 A5             AND L
3584  60A4 3C             INC A                ; #FFFF?
3585  60A5 28 13                        JR   Z, .oi_no1
3586  60A7 22 BD 69                     LD   (VDC_WinEmitPos1), HL
3587  60AA 11 1E 00                     LD   DE, WINEXP_PAD
3588  60AD A7                           AND  A
3588  60AE ED 52          SBC HL, DE                      ; spawn = head - PAD (первый спавн сразу)
3589  60B0 22 BF 69                     LD   (VDC_WinEmitSpawn1), HL
3590  60B3 3E 01                        LD   A, 1
3590  60B5 32 BC 69       LD (VDC_WinOutroActive), A
3591  60B8 18 06                        JR   .oi_c2
3592  60BA 21 FF FF     .oi_no1:        LD   HL, #FFFF
3592  60BD 22 BD 69       LD (VDC_WinEmitPos1), HL
3593  60C0 3A 94 D3     .oi_c2:         LD   A, (VDC_HasSecondChain)
3594  60C3 B7                           OR   A
3595  60C4 28 1A                        JR   Z, .oi_no2set
3596  60C6 2A B7 69                     LD   HL, (VDC_WinHeadS2)
3597  60C9 7C                           LD   A, H
3597  60CA A5             AND L
3597  60CB 3C             INC A
3598  60CC 28 12                        JR   Z, .oi_no2
3599  60CE 22 C1 69                     LD   (VDC_WinEmitPos2), HL
3600  60D1 11 1E 00                     LD   DE, WINEXP_PAD
3601  60D4 A7                           AND  A
3601  60D5 ED 52          SBC HL, DE
3602  60D7 22 C3 69                     LD   (VDC_WinEmitSpawn2), HL
3603  60DA 3E 01                        LD   A, 1
3603  60DC 32 BC 69       LD (VDC_WinOutroActive), A
3604  60DF C9                           RET
3605  60E0              .oi_no2:
3606  60E0 21 FF FF     .oi_no2set:     LD   HL, #FFFF
3606  60E3 22 C1 69       LD (VDC_WinEmitPos2), HL
3607  60E6 C9                           RET
3608  60E7
3609  60E7              ; --- VDC_WinSpawnParticle — BC=X, DE=Y: занять мёртвый слот (f2=0). Пул полон → скип. ---
3610  60E7              VDC_WinSpawnParticle:
3611  60E7 ED 43 00 62                  LD   (VDC_WinSpawnX), BC
3612  60EB ED 53 02 62                  LD   (VDC_WinSpawnY), DE
3613  60EF DD 21 C5 69                  LD   IX, VDC_WinPrtcl
3614  60F3 06 20                        LD   B, WIN_PRTCL_MAX
3615  60F5 DD 7E 04     .sp_find:       LD   A, (IX+4)
3616  60F8 FE FF                        CP   255
3617  60FA 28 08                        JR   Z, .sp_use
3618  60FC 11 05 00                     LD   DE, 5
3618  60FF DD 19          ADD IX, DE
3619  6101 10 F2                        DJNZ .sp_find
3620  6103 C9                           RET                                      ; пул полон
3621  6104 2A 00 62     .sp_use:        LD   HL, (VDC_WinSpawnX)
3622  6107 DD 75 00                     LD   (IX+0), L
3622  610A DD 74 01       LD (IX+1), H
3623  610D 2A 02 62                     LD   HL, (VDC_WinSpawnY)
3624  6110 DD 75 02                     LD   (IX+2), L
3624  6113 DD 74 03       LD (IX+3), H
3625  6116 DD 36 04 00                  LD   (IX+4), 0
3626  611A C9                           RET
3627  611B
3628  611B              ; --- VDC_WinEmitStep — шаг одного эмиттера. Вход: VDC_WinStepPos/Spawn заданы,
3629  611B              ;     слот2 = трек этой цепочки. Выход: те же vars обновлены (#FFFF=дошёл до КЗ). ---
3630  611B              VDC_WinEmitStep:
3631  611B 2A FC 61                     LD   HL, (VDC_WinStepPos)
3632  611E 7C                           LD   A, H
3632  611F A5             AND L
3632  6120 3C             INC A
3633  6121 C8                           RET  Z                                   ; #FFFF → неактивен
3634  6122                              ; S_kz = NumSamples-1; если pos > S_kz → done
