 120+ C441              ; ---------------------------------------------------------------------
 121+ C441              ; ZiFi_FEntry — search current dir for filename.
 122+ C441              ;   In : HL → {flag, name, 0}
 123+ C441              ;   Out: Z=not found; NZ=found, [DE:HL]=size; SEEK0 auto-called
 124+ C441              ZiFi_FEntry:
 125+ C441 CD 3F C4                     CALL ZiFi_Enter
 126+ C444 CD 50 20                     CALL ZIFI_FENTRY
 127+ C447                              ; preserve result flags + DE/HL across Leave
 128+ C447 F5                           PUSH AF
 129+ C448 E5                           PUSH HL
 130+ C449 D5                           PUSH DE
 131+ C44A CD 40 C4                     CALL ZiFi_Leave
 132+ C44D D1                           POP  DE
 133+ C44E E1                           POP  HL
 134+ C44F F1                           POP  AF
 135+ C450 C9                           RET
