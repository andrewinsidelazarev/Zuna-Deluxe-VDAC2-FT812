   1+ 6933              ; loader_resident.asm — the parts of the PAK loader that MUST stay resident in
   2+ 6933              ; Core (slot 1), because they are reached while the loader overlay page is NOT
   3+ 6933              ; mapped:
   4+ 6933              ;   * VDC_ReadSampleAtHL — called per-frame from VDC_SlotPos (Main1) during play;
   5+ 6933              ;   * adventure cross-load vars (FadeAlpha / CurrentDifficulty / CurrentLevel),
   6+ 6933              ;     read by gameplay/menu/level-select code at any time;
   7+ 6933              ;   * the overlay trampolines — the named entry points callers use; each maps the
   8+ 6933              ;     loader page into slot 3, calls the real OVL_* routine, then restores #04.
   9+ 6933              ;
  10+ 6933              ; The bulk of the loader (sd_zc + RawPak_* + ZiFi_* + OVL_LoadGameplay... +
  11+ 6933              ; OVL_LoadLevelSelectPreviewAssets) lives in ts-dos.asm, assembled into its own
  12+ 6933              ; SLOT 3 / PAGE #40 overlay region (see main.asm). It is dormant outside loads —
  13+ 6933              ; "load a level, then sleep" — so it no longer costs resident Core space.
  14+ 6933
  15+ 6933              LOADER_OVL_PAGE    EQU #40            ; SPG page holding the loader overlay (mapped into slot 3 during loads)
  16+ 6933              GS_PORT_DATA       EQU #00B3
  17+ 6933              GS_PORT_CMD        EQU #00BB
  18+ 6933              GS_CMD_PLAY_MODULE EQU #31
  19+ 6933              GS_CMD_STOP_MODULE EQU #32
  20+ 6933              GS_CMD_PLAY_FX     EQU #98
  21+ 6933              GS_SFX_NOTE        EQU 53            ; 11025 Hz payload at GS C-2-ish base (#30) needs about +5 semitones.
  22+ 6933              GS_WAIT_TIMEOUT    EQU #FFFF
  23+ 6933                                                    ; UI_OVL_PAGE (#41) is defined globally in main.asm (needed before
  24+ 6933                                                    ; module Core by the Fade* transitions); referenced here for the trampoline.
  25+ 6933
  26+ 6933              ; Track chunkB page: tracks longer than one 16K page (>2730 samples) are split on
  27+ 6933              ; a sample boundary. The active track pages are resident variables because the
  28+ 6933              ; two-curve boards reuse the same reader for the second path.
  29+ 6933              TRACK_PAGE2        EQU #0F
  30+ 6933              TRACK_SPLIT_SAMPLE EQU 2730        ; (16384-2)/6, first sample stored in TRACK_PAGE2
  31+ 6933
  32+ 6933              ; ----------------------------------------------------------------------------
  33+ 6933              ; VDC_ReadSampleAtHL — read track sample [HL] -> BC=X, DE=Y; set VDC_LastT,
  34+ 6933              ; VDC_LastTangent and VDC_LastTrackFlags; CF=0. Core-resident (called as a tail-jump from VDC_SlotPos
  35+ 6933              ; in Main1, which is nearly full). Handles the 2-page track split: samples below
  36+ 6933              ; TRACK_SPLIT_SAMPLE sit on VDC_ActiveTrackPage1 at #8000+2+t*6; samples at/above
  37+ 6933              ; live on VDC_ActiveTrackPage2 at #8000+(t-split)*6 (chunkB has no count header).
  38+ 6933              ; Leaves slot 2 mapped to VDC_ActiveTrackPage1. Clobbers AF, HL.
  39+ 6933              ; ----------------------------------------------------------------------------
  40+ 6933              VDC_ReadSampleAtHL:
  41+ 6933 22 92 D3                     LD   (VDC_LastT), HL                   ; expose t
  42+ 6936 11 AA 0A                     LD   DE, TRACK_SPLIT_SAMPLE
  43+ 6939 A7                           AND  A
  44+ 693A ED 52                        SBC  HL, DE                            ; HL = t - split; CF=1 if t<split
  45+ 693C 38 2C                        JR   C, .p1
  46+ 693E                              ; --- page2 (#0F): HL = t2 = t - split ---
  47+ 693E 54                           LD   D, H
  47+ 693F 5D             LD E, L
  48+ 6940 29                           ADD  HL, HL                            ; t2*2
  49+ 6941 19                           ADD  HL, DE                            ; t2*3
  50+ 6942 29                           ADD  HL, HL                            ; t2*6
  51+ 6943 11 00 80                     LD   DE, #8000
  52+ 6946 19                           ADD  HL, DE                            ; #8000 + t2*6
  53+ 6947 3A 95 69                     LD   A, (VDC_ActiveTrackPage2)
  54+ 694A                              SetPage2_A                             ; map #0F (clobbers A, BC)
  54+ 694A             >                ifdef MAPPING_REGISTERS
  54+ 694A 32 12 04    >                LD (FMADDR_REGS + HIGH PAGE2), A
  54+ 694D             >                else
  54+ 694D ~           >                LD (MemoryPages + 2), A
  54+ 694D ~           >                LD BC, PAGE2
  54+ 694D ~           >                OUT (C), A
  54+ 694D             >                endif
  55+ 694D 5E                           LD   E, (HL)
  55+ 694E 23             INC HL
  56+ 694F 56                           LD   D, (HL)
  56+ 6950 23             INC HL                  ; DE = X
  57+ 6951 4E                           LD   C, (HL)
  57+ 6952 23             INC HL
  58+ 6953 46                           LD   B, (HL)
  58+ 6954 23             INC HL                  ; BC = Y
  59+ 6955 7E                           LD   A, (HL)
  60+ 6956 32 90 D3                     LD   (VDC_LastTangent), A
  60+ 6959 23             INC HL
  61+ 695A 7E                           LD   A, (HL)
  62+ 695B 32 91 D3                     LD   (VDC_LastTrackFlags), A
  63+ 695E C5                           PUSH BC
  63+ 695F D5             PUSH DE                      ; save Y, X across page restore
  64+ 6960 3A 94 69                     LD   A, (VDC_ActiveTrackPage1)
  65+ 6963                              SetPage2_A                             ; restore active track page for callers
  65+ 6963             >                ifdef MAPPING_REGISTERS
  65+ 6963 32 12 04    >                LD (FMADDR_REGS + HIGH PAGE2), A
  65+ 6966             >                else
  65+ 6966 ~           >                LD (MemoryPages + 2), A
  65+ 6966 ~           >                LD BC, PAGE2
  65+ 6966 ~           >                OUT (C), A
  65+ 6966             >                endif
  66+ 6966 D1                           POP  DE
  66+ 6967 C1             POP  BC                      ; DE = X, BC = Y
  67+ 6968 18 1D                        JR   .rearr
  68+ 696A              .p1:            ; --- page1 (#06, already mapped): addr = #8000 + 2 + t*6 ---
  69+ 696A 2A 92 D3                     LD   HL, (VDC_LastT)
  70+ 696D 54                           LD   D, H
  70+ 696E 5D             LD E, L
  71+ 696F 29                           ADD  HL, HL                            ; t*2
  72+ 6970 19                           ADD  HL, DE                            ; t*3
  73+ 6971 29                           ADD  HL, HL                            ; t*6
  74+ 6972 11 02 80                     LD   DE, TrackData + 2
  75+ 6975 19                           ADD  HL, DE
  76+ 6976 5E                           LD   E, (HL)
  76+ 6977 23             INC HL
  77+ 6978 56                           LD   D, (HL)
  77+ 6979 23             INC HL                  ; DE = X
  78+ 697A 4E                           LD   C, (HL)
  78+ 697B 23             INC HL
  79+ 697C 46                           LD   B, (HL)
  79+ 697D 23             INC HL                  ; BC = Y
  80+ 697E 7E                           LD   A, (HL)
  81+ 697F 32 90 D3                     LD   (VDC_LastTangent), A
  81+ 6982 23             INC HL
  82+ 6983 7E                           LD   A, (HL)
  83+ 6984 32 91 D3                     LD   (VDC_LastTrackFlags), A
  84+ 6987 EB           .rearr:         EX   DE, HL                            ; HL = X
  85+ 6988 50                           LD   D, B
  85+ 6989 59             LD E, C                    ; DE = Y
  86+ 698A 44                           LD   B, H
  86+ 698B 4D             LD C, L                    ; BC = X
  87+ 698C A7                           AND  A                                 ; CF = 0
  88+ 698D C9                           RET
