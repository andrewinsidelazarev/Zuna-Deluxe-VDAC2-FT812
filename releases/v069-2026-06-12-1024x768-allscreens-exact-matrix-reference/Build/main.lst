2848  5C03                              ; ----- BOOT CANARY -----
2849  5C03                              ; Доказывает, что WC SPG-loader долистал до Core EntryPoint и
2850  5C03                              ; передал управление НАМ — до любого Init. Пишем "BOOT" в
2851  5C03                              ; резидентный RAM (#5044), не трогая стек/страницы. См. дамп 111:
2852  5C03                              ; если этой метки нет в F2-дампе — hang в фазе загрузки WC.
2853  5C03 21 42 4F                     LD   HL, #4F42                          ; 'B','O' (LE → #42 #4F)
2854  5C06 22 44 50                     LD   (BOOT_CANARY_ADDR), HL
