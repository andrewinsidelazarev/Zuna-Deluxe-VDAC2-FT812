3961  657C                              else
3962  657C ~            BALLS_PAGE_COUNT   EQU 12                              ; PALETTED4444: 6×32×32×32 1bpp = 192 KB
3963  657C                              endif
3964  657C              BALLS_RAMG_ADDR    EQU #050000                         ; сразу после bg+padding (#04C000)
3965  657C              BALLS_PALETTE_PAGE EQU #39                             ; palette ARGB4 СТРОГО 512 байт (256 entries × 2 bytes)
3966  657C              BALLS_PALETTE_RAMG EQU #080000                         ; FT_RAM_G — после balls (192K=#080000), 4-byte aligned
3967  657C              FROG_PAGE          EQU #52                             ; body, plate, tongue, overlay pages
3968  657C                              if FROG_ARGB4_ENABLED
3969  657C              FROG_TOTAL_PAGES   EQU 8                               ; 4 × 122×122 ARGB4 blocks, 2 pages each
3970  657C              FROG_RAMG_ADDR     EQU #030000                         ; permanent ARGB4 frog block, before balls
3971  657C              PLATE_RAMG_ADDR    EQU FROG_RAMG_ADDR + #8000
3972  657C              TONGUE_RAMG_ADDR   EQU FROG_RAMG_ADDR + #10000
3973  657C              OVERLAY_RAMG_ADDR  EQU FROG_RAMG_ADDR + #18000
3974  657C                              else
3975  657C ~            FROG_TOTAL_PAGES   EQU 4                               ; 4 × 122×122 PALETTED4444 blocks
3976  657C ~            FROG_RAMG_ADDR     EQU #0B0000                         ; after balls/frame reserved area
3977  657C ~            PLATE_RAMG_ADDR    EQU FROG_RAMG_ADDR + #4000          ; #0B4000
3978  657C ~            TONGUE_RAMG_ADDR   EQU PLATE_RAMG_ADDR + #4000         ; #0B8000
3979  657C ~            OVERLAY_RAMG_ADDR  EQU TONGUE_RAMG_ADDR + #4000        ; #0BC000
3980  657C                              endif
3981  657C              FROG_PALETTE_PAGE  EQU #56                             ; 512-byte ARGB4 palette
3982  657C              FROG_PALETTE_RAMG  EQU #0C0000                         ; 4-byte aligned, before cursor/kz
3983  657C              PLATE_PALETTE_PAGE EQU #57
3984  657C              PLATE_PALETTE_RAMG EQU #0C0200
3985  657C              TONGUE_PALETTE_PAGE EQU #58
3986  657C              TONGUE_PALETTE_RAMG EQU #0C0400
3987  657C              OVERLAY_PALETTE_PAGE EQU #59
3988  657C              OVERLAY_PALETTE_RAMG EQU #0C0600
3989  657C              KZ_PAGE            EQU #16
3990  657C              KZ_PAGE_COUNT      EQU 10                              ; killzone 6 pages + destroy 4 pages
3991  657C              KZ_RAMG_ADDR       EQU #0D4000                         ; after cursor page, below RAM_G 1 MB limit
3992  657C              KZ_PALETTE_RAMG    EQU #0EAB00                         ; after 88×88×12 PALETTED4444 pixels, inside page #1B padding
3993  657C              DESTROY_PAGE       EQU #1C                              ; match-3 серый animBallDestroy, 13 кадров, 4 стр.
3994  657C              DESTROY_RAMG_ADDR  EQU #0EC000                         ; after killzone atlas
3995  657C
3996  657C              ; --- WIN explosion (оранжевый animExplosion, 17 кадров, 5 страниц) ---
3997  657C              ; ВНИМАНИЕ: RAM_G у FT812 = ровно 1 МБ (FT_RAM_G_SIZE = 0x100000). Прошлая
3998  657C              ; сессия ошибочно сочла «4 МБ» (на самом деле это системная RAM ZX Evolution, не
3999  657C              ; графическая RAM_G чипа) и положила атлас на #100000 — это первый байт ЗА
4000  657C              ; границей RAM_G → на железе запись уходит за пределы/аливасится в низ RAM_G и
4001  657C              ; портит фон/текст/спрайты (на EVE-эмуляторе с бОльшим RAM_G не воспроизводилось).
4002  657C              ; ФИКС: к моменту WIN шаров на экране уже нет → переиспользуем регион атласа шаров
4003  657C              ; (#050000, 192 КБ). Атлас НЕ грузится при загрузке уровня, а дозаливается по SPI
4004  657C              ; на входе в WIN (VDC_WinOutroInit). После WIN→след.уровень LoadGameplayAssets
4005  657C              ; заново зальёт шары в #050000.
4006  657C              WINEXP_PAGE        EQU #28                              ; SPG #28..#2C (5 страниц)
4007  657C              WINEXP_PAGE_COUNT  EQU 5
4008  657C              WINEXP_RAMG_ADDR   EQU BALLS_RAMG_ADDR                  ; #050000: 17×48×48×2=78336 (80 КБ) влезает в 192 КБ региона шаров
4009  657C
4010  657C              ; --- Cursor 24×24 ARGB4 (1 page) ---
4011  657C              CURSOR_PAGE        EQU #5A
4012  657C              CURSOR_RAMG_ADDR   EQU #0D0000                         ; after frog overlay area
4013  657C              CURSOR_W           EQU 24                              ; atlas (layout) — матчится с make_cursor.py
4014  657C              CURSOR_H           EQU 24
4015  657C              CURSOR_DRAW        EQU 38                              ; 1024×768: экранный размер = round(24×8/5)
4016  657C              CURSOR_TIP_X       EQU 0                               ; острие sprite-coords (см. make_cursor.py)
4017  657C              CURSOR_TIP_Y       EQU 0
4018  657C
