2336  3A0C 3A 97 69                     LD   A, (Core.VDC_HSub)
2337  3A0F BA                           CP   D
2338  3A10 30 25                        JR   NC, .ck_trigger                   ; HSub >= KzEndSub → past
2339  3A12 5F                           LD   E, A                              ; HSub
2340  3A13 7A                           LD   A, D
2341  3A14 93                           SUB  E                                 ; A = KzEndSub - HSub (1..CS-1)
2342  3A15 26 00                        LD   H, 0
2343  3A17 6F                           LD   L, A
2344  3A18              .ck_set_frame:  ; HL = remaining samples (positive)
2345  3A18 7C                           LD   A, H
2346  3A19 B7                           OR   A
2347  3A1A 20 15                        JR   NZ, .ck_closed                    ; rem > 255 → > 64 → closed
2348  3A1C 7D                           LD   A, L
