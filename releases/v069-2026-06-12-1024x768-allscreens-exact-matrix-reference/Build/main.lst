   1+ C06E
   2+ C06E                              ifndef _ZUMA_VDC_
   3+ C06E                              define _ZUMA_VDC_
   4+ C06E
   5+ C06E              ; ============================================================================
   6+ C06E              ; VDC — Virtual Discrete Chain physics для Zuma VDAC2 (640x480).
   7+ C06E              ; ----------------------------------------------------------------------------
   8+ C06E              ; Порт vdc_visual_emulator.py 1:1. Отличия от 360x288 asm-версии:
   9+ C06E              ;   - CELL_SIZE = 32 (как в 360x288). Track 640x480 = 2774 samples,
  10+ C06E              ;     2774/32 ≈ 87 slots — помещается в byte, но HSA word для запаса.
  11+ C06E              ;   - LastRenderPos НЕ хранится: при t<0 рендер skip. Trade-off: при cascade
  12+ C06E              ;     rollback шары на спавне на 1-2 кадра становятся невидимыми. Можно добавить
  13+ C06E              ;     потом как опциональный массив.
  14+ C06E              ;   - Match-3 has a visual explosion phase. Slots keep their color while
  15+ C06E              ;     VDC_ExplodeFrame > 0; after the timer expires the saved GAP marker is
  16+ C06E              ;     committed and normal VDC gap closing continues.
  17+ C06E              ;
  18+ C06E              ; API:
  19+ C06E              ;   VDC_Init       — обнулить все массивы, Slots[] = GAP_STOP, RNG seed.
  20+ C06E              ;   VDC_Update     — TrySpawn + MoveChain + AnimateChain. Один вызов = один кадр.
  21+ C06E              ;   VDC_SlotPos    — для слота A считает (X,Y) центра шара.
  22+ C06E              ;                    Out: BC=X, DE=Y, CF=1 если skip (gap или t<0).
  23+ C06E              ;   VDC_InsertAt   — A=target_idx, B=color. Вставить шар, проверить match.
  24+ C06E              ;
  25+ C06E              ; Все функции корраптят AF/BC/DE/HL.
  26+ C06E              ; TrackData layout (page 6 в slot 2 #8000):
  27+ C06E              ;   word LE NumSamples, затем NumSamples * (sword X, sword Y, byte tangent, byte flags),
  28+ C06E              ;   stride = 6 bytes per sample. flags: bit0=tunnel/no bullet hit, bit1=draw above top layer.
  29+ C06E              ; ============================================================================
  30+ C06E
  31+ C06E              VDC_LEVEL_START_BALLS  EQU 35                            ; быстрая фаза: 35 шаров «поездом»
  32+ C06E              VDC_FAST_ADVANCE       EQU 12                            ; MoveChain ×12 за tick в fast-фазе
  33+ C06E              VDC_ABSORB_ADVANCE     EQU 8                             ; absorb chain advance: 8 px/tick (32/8=4 ticks/cell)
  34+ C06E              VDC_CELL_SIZE          EQU 32                            ; sample-units на slot.
  35+ C06E              VDC_GLOBAL_SPEED_FACTOR EQU 2                            ; 1=оригинал (0.5 px/frame); 2=вдвое быстрее; масштабирует fast-phase и кол-во SpeedAdvance тиков/кадр
  36+ C06E              VDC_DECAY_NEG          EQU 2                             ; insert head slide (neg→0) быстро.
  37+ C06E              VDC_DECAY_POS          EQU 1                             ; cascade rollback (pos→0) плавно.
  38+ C06E                                                                        ; track chord 1.0815 px/sample: 32×1.08 ≈ 34.6 px
  39+ C06E                                                                        ; centers, ball 32 px → gap ~2.6 px на прямой.
  40+ C06E                                                                        ; Используется в VDC_SlotT через ZL_Mul16x8.
  41+ C06E                                                                       ; track 1.067 px/sample → 42*1.067 ≈ 45 px
  42+ C06E                                                                       ; между центрами при ball=40 → 5 px gap
  43+ C06E                                                                       ; (= touching, как в оригинале Zuma).
  44+ C06E              VDC_MAX_SLOTS          EQU 128                           ; физический максимум цепи = самый длинный
  45+ C06E                                                                       ; трек 2774 samples / 32 = 86 слотов + вставки.
  46+ C06E                                                                       ; Было 240 — избыток; ужатие освобождает RAM
  47+ C06E                                                                       ; под кадровый CMD-буфер (1024×768 полная анимация).
  48+ C06E              VDC_GAP_STOP           EQU #FE
  49+ C06E              VDC_GAP_CASCADE        EQU #FD
  50+ C06E              VDC_NUM_COLORS         EQU 6                             ; 6 colors (atlas already supports 6×32 cells). Pre 2026-05-18: 4.
  51+ C06E              VDC_LEVEL_CHAIN_CHANCE EQU 50                            ; level setting: 50% random single, 50% random same-color chain
  52+ C06E              VDC_GAP_STEP_FRAMES    EQU VDC_CELL_SIZE
  53+ C06E              VDC_DM3_OFFSET_GAP_MAX EQU (VDC_CELL_SIZE / 2) + 2        ; allow fresh insert half-cell overlap, still block full gap
  54+ C06E              VDC_BALLS_TARGET       EQU VDC_MAX_SLOTS                 ; legacy/debug only. Runtime spawn gate is
  55+ C06E                                                                        ; VDC_GaugeFull (level target score) + GameOver.
  56+ C06E              VDC_KZ_FRAMES          EQU 12
  57+ C06E              VDC_EXPLOSION_FRAMES   EQU 15
  58+ C06E              VDC_DUAL_LOSE_MENU_DELAY EQU 12                          ; post-empty frames before dual lose dialog
  59+ C06E
  60+ C06E              ; VDC_GameState values
  61+ C06E              VDC_STATE_PLAY     EQU 0                                  ; обычный gameplay
  62+ C06E              VDC_STATE_ABSORB   EQU 1                                  ; balls движутся в killzone
  63+ C06E              VDC_STATE_GAMEOVER EQU 2                                  ; GAME OVER screen
  64+ C06E              VDC_STATE_INTRO    EQU 3                                  ; level intro (LEVEL 1-1 + dispname)
  65+ C06E              VDC_STATE_PREVIEW  EQU 4                                  ; sparkle wave вдоль track перед спавном
  66+ C06E              VDC_STATE_CLOSING  EQU 5                                  ; череп закрывается (frame 11→1)
  67+ C06E              VDC_STATE_WIN      EQU 6                                  ; level clear: sparkles, bonus, next level
  68+ C06E              VDC_INTRO_TICKS    EQU 240                                ; ~4 сек @ 60Hz
  69+ C06E              ; VDC_DialogState values for the win flow (после win-анимации):
  70+ C06E              DLG_WIN_DONE       EQU 5                                  ; «LEVEL DONE» диалог, ждём OK
  71+ C06E              DLG_WIN_FADE       EQU 6                                  ; OK нажат → fade-out в чёрное, потом AdvanceToNextLevel
  72+ C06E              VDC_WIN_FADE_STEP  EQU 16                                 ; FadeAlpha += step/кадр (255/16 ≈ 16 кадров ≈ 0.2с)
  73+ C06E              VDC_PREVIEW_TICKS  EQU 193                                ; (NumSamples+trail)/SPEED = (2774+112)/15 ≈ 192.4 → закрытие сразу после влёта последней звезды
  74+ C06E              VDC_CLOSING_TICKS  EQU 22                                 ; ~0.37 сек closing anim (2 ticks per frame)
  75+ C06E              VDC_WIN_TICKS      EQU VDC_PREVIEW_TICKS                  ; fallback-таймер (когда нет аутро); при активном аутро конец = VDC_WinOutroDone
  76+ C06E
  77+ C06E              ; ============================================================================
  78+ C06E              ; VDC_Init — обнулить state, Slots[] = GAP_STOP. Должен быть вызван 1 раз
  79+ C06E              ; до любого VDC_Update / VDC_SlotPos / VDC_InsertAt.
  80+ C06E              ; ============================================================================
