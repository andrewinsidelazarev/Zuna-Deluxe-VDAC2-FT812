 367+ E6DC
 368+ E6DC                              ; --- VDC chain rendering: per-ball tangent + grouped matrix emit.
 369+ E6DC                              ; Algorithm:
 370+ E6DC                              ;   Pre-pass: cache stable tangent, cell, Vx, Vy for each ball.
 371+ E6DC                              ;   Draw: quantize tangent to 8 BRAD and emit matrix only when it
 372+ E6DC                              ;   differs from the previous visible ball. This keeps per-slot
 373+ E6DC                              ;   tangent stability without the old bucket segment flicker.
 374+ E6DC 0E FF                        LD   C, 255
 374+ E6DE 16 FF          LD D, 255
 374+ E6E0 1E FF          LD E, 255
 375+ E6E2 CD 6E 13                     CALL FT.Coprocessor.ColorRGB
 376+ E6E5                              ; 1024×768: гейты heavy-dual/top-mask сняты — спин/вращение на всех
 377+ E6E5                              ; уровнях. ZL_HeavyTunnelDual/ZL_HeavyBallCount больше не нужны
 378+ E6E5                              ; (мёртвый код удалён, освобождает Main1). Оставлен только
 379+ E6E5                              ; ZL_HasTopMaskLevel — его читает top-mask рендер тоннельных уровней.
 380+ E6E5 AF                           XOR  A
 381+ E6E6 32 D7 F1                     LD   (ZL_HasTopMaskLevel), A
 382+ E6E9 CD 52 E9                     CALL ZL_GetTopMaskForCurrentLevel
 383+ E6EC 7E                           LD   A, (HL)
 384+ E6ED B7                           OR   A
 385+ E6EE 28 05                        JR   Z, .HeavyTunnelDone
 386+ E6F0 3E 01                        LD   A, 1
 387+ E6F2 32 D7 F1                     LD   (ZL_HasTopMaskLevel), A
 388+ E6F5              .HeavyTunnelDone:
 389+ E6F5 3A 9C 69                     LD   A, (VDC_DialogState)
 390+ E6F8 32 D5 F1                     LD   (ZL_BallRotationDisabled), A
 391+ E6FB CD F6 E8                     CALL ZL_DrawActiveChainForLevel
 392+ E6FE 3A 94 D3                     LD   A, (VDC_HasSecondChain)
 393+ E701 B7                           OR   A
 394+ E702 CA 6E EE                     JP   Z, ZL_AfterChains
 395+ E705 CD 4F C2                     CALL VDC_SwapChains
 396+ E708 CD 40 5F                     CALL SetSecondTrackPage
 397+ E70B 0E FF                        LD   C, 255
 397+ E70D 16 FF          LD D, 255
 397+ E70F 1E FF          LD E, 255
 398+ E711 CD 6E 13                     CALL FT.Coprocessor.ColorRGB
 399+ E714 CD F6 E8                     CALL ZL_DrawActiveChainForLevel
 400+ E717 CD 4F C2                     CALL VDC_SwapChains
 401+ E71A CD 2E 5F                     CALL SetCurrentTrackPage
 402+ E71D AF                           XOR  A
 403+ E71E 32 D5 F1                     LD   (ZL_BallRotationDisabled), A
 404+ E721 C3 6E EE                     JP   ZL_AfterChains
 405+ E724
 406+ E724              ; ----------------------------------------------------------------------------
 407+ E724              ; Space-only procedural starfield. Drawn after the bitmap background, before all
 408+ E724              ; gameplay bitmaps, so stars are above the Space picture but below track/balls.
 409+ E724              ; Uses FT812 POINTS only: no RAM_G, no assets, no persistent star state.
 410+ E724              ; ----------------------------------------------------------------------------
 411+ E724              ZL_DrawSpaceStarsMaybe:
 412+ E724 3A 90 69                     LD   A, (CurrentLevel)
 413+ E727 FE 15                        CP   ZL_SPACE_LEVEL_INDEX
 414+ E729 C0                           RET  NZ
 415+ E72A
 416+ E72A 0E EB                        LD   C, 235
 416+ E72C 16 F0          LD D, 240
 416+ E72E 1E FF          LD E, 255
 417+ E730 CD 6E 13                     CALL FT.Coprocessor.ColorRGB
 418+ E733
 419+ E733                              ; 1024×768: поле на ВЕСЬ экран (было 640×480 — правые 384px и низ
 420+ E733                              ; пустые), wrap по 1024 (= AND, степень двойки), размеры точек ×1.6.
 421+ E733 2A AD F1                     LD   HL, (ZL_FrameCounter)
