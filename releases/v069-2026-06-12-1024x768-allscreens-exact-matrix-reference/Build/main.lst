1213+ CC8B DA 53 CD                     JP   C, .fail
1214+ CC8E 22 D9 D0                     LD   (RawPak_FatPtr), HL
1215+ CC91              .enter:        ; CurClus belongs to the current run -> count it
1216+ CC91 3A 29 CE                     LD   A, (RawPak_Spc)
1217+ CC94 DD 86 04                     ADD  A, (IX + 4)
1218+ CC97 DD 77 04                     LD   (IX + 4), A
1219+ CC9A 30 03                        JR   NC, .noLenCy
1220+ CC9C DD 34 05                     INC  (IX + 5)
