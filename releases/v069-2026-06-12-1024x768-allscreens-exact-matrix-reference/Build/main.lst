 832+ 7543              ; ClearRamGForMenu — явно стереть грязный хвост boot RAM_G перед главным меню.
 833+ 7543              ;   Вызывается в начале MenuMain (на КАЖДОМ входе в меню — после загрузки и при
 834+ 7543              ;   возврате из игры/level-select/more-games), ДО заливки ассетов меню.
 835+ 7543              ;   Зачем: реальный FT812 показал, что CMD_MEMZERO не является надёжным барьером
 836+ 7543              ;   для этого перехода. Поэтому для A/B-теста не используем копроцессор вообще:
 837+ 7543              ;   прямой SPI-записью затираем область boot progress/logo #0C8000..#0F8000.
 838+ 7543              ; ----------------------------------------------------------------------------
 839+ 7543              CLEAR_RAMG_TAIL_ADDR   EQU #0C8000
 840+ 7543              CLEAR_RAMG_TAIL_SIZE   EQU #030000
 841+ 7543              CLEAR_RAMG_CHUNK_SIZE  EQU #000400
 842+ 7543              CLEAR_RAMG_CHUNKS      EQU CLEAR_RAMG_TAIL_SIZE / CLEAR_RAMG_CHUNK_SIZE
 843+ 7543
 844+ 7543              ClearRamGForMenu:
 845+ 7543 3E 0C                        LD   A, (CLEAR_RAMG_TAIL_ADDR >> 16) & #FF
 846+ 7545 11 00 80                     LD   DE, CLEAR_RAMG_TAIL_ADDR & #FFFF
 847+ 7548 06 C0                        LD   B, CLEAR_RAMG_CHUNKS
 848+ 754A C5           .wipe_loop:    PUSH BC
 849+ 754B 21 58 75                     LD   HL, ClearRamGZeroBuf
 850+ 754E 01 00 04                     LD   BC, CLEAR_RAMG_CHUNK_SIZE
 851+ 7551 CD 6A 12                     CALL FT.WriteMem                         ; advances A:DE by BC
 852+ 7554 C1                           POP  BC
 853+ 7555 10 F3                        DJNZ .wipe_loop
 854+ 7557 C9                           RET
 855+ 7558
 856+ 7558              ClearRamGZeroBuf:
 857+ 7558 00 00 00...                  DEFS CLEAR_RAMG_CHUNK_SIZE
