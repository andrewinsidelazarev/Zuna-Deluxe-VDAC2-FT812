4444  79BC                              include "shared_render.asm"           ; DL-matrix + frog-render machinery used by gameplay (#04) AND level-select (#41); resident so neither needs to page-swap
# file opened: Source\ASM\shared_render.asm
   1+ 79BC              ; shared_render.asm — DL-matrix + frog-render machinery, HOISTED RESIDENT.
   2+ 79BC              ;
   3+ 79BC              ; These routines/tables/vars are used by BOTH gameplay (overlay #04) AND the
   4+ 79BC              ; level-select preview render (overlay #41). After the main1_play overlay split
   5+ 79BC              ; they MUST be resident (slot 1, always mapped) so either scene can call them
   6+ 79BC              ; without paging gymnastics. Moved verbatim from VDC.asm/Frog.asm/MainLoop.asm;
   7+ 79BC              ; names unchanged (module Core) so all existing references resolve untouched.
   8+ 79BC              ; (User decision 2026-05-27: keep render machinery global, split the rest.)
   9+ 79BC
  10+ 79BC              ; ===================== moved from VDC.asm =====================
  11+ 79BC              VDC_DivHLbyA:
  12+ 79BC 4F                           LD   C, A
  13+ 79BD AF                           XOR  A
  14+ 79BE 06 10                        LD   B, 16
