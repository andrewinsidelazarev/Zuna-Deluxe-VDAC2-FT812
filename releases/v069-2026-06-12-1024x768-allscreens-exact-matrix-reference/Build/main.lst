4485  EE2D
4486  EE2D              Main0_Size       EQU Core.Main0_End - Core.Start
4487  EE2D              Main1_Size       EQU Core.Main1_End - Core.Main1_Start
4488  EE2D              UiOvl_Size       EQU Core.UiOvl_End - Core.UiOvl_Start
4489  EE2D              LoaderOvl_Size   EQU Core.LoaderOvl_End - Core.LoaderOvl_Start
4490  EE2D                              display "Main0:    \t", /A, Core.Start,        " size=", /D, Main0_Size,     " bytes (slot 1 page 5)"
4491  EE2D                              display "Main1:    \t", /A, Core.Main1_Start,  " size=", /D, Main1_Size,     " bytes (slot 3 page #04, gameplay)"
4492  EE2D                              display "UiOvl:    \t", /A, Core.UiOvl_Start,  " size=", /D, UiOvl_Size,     " bytes (slot 3 page #41, ui)"
4493  EE2D                              display "LoaderOvl:\t", /A, Core.LoaderOvl_Start, " size=", /D, LoaderOvl_Size, " bytes (slot 3 page #40)"
4494  EE2D                              ; main1_play (#04), the UI overlay (#41) and the loader overlay (#40)
4495  EE2D                              ; all assemble at logical #C000 on different physical pages. Map the
4496  EE2D                              ; right page into the slot before EACH SAVEBIN, else SAVEBIN dumps
4497  EE2D                              ; whichever page was mapped last into the wrong .bin — corrupting it.
4498  EE2D                              SLOT 1
4498  EE2D                PAGE #05
4499  EE2D                              SAVEBIN "Build/Core.bin",        Core.Start,       Main0_Size
4500  EE2D                              SLOT 3
4500  EE2D                PAGE #04
4501  EE2D                              SAVEBIN "Build/main1_play.bin",  Core.Main1_Start, Main1_Size
4502  EE2D                              SLOT 3
4502  EE2D                PAGE UI_OVL_PAGE
4503  EE2D                              SAVEBIN "Build/ui_ovl.bin",      Core.UiOvl_Start, UiOvl_Size
4504  EE2D                              SLOT 3
4504  EE2D                PAGE Core.LOADER_OVL_PAGE
4505  EE2D                              SAVEBIN "Build/loader_ovl.bin",  Core.LoaderOvl_Start, LoaderOvl_Size
4506  EE2D
4507  EE2D                              END EntryPoint
