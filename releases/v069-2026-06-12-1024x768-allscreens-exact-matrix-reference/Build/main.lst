2295  39DA              ; ============================================================================
2296  39DA              ; VDC_CheckKillzone — proximity-based skull animation.
2297  39DA              ; Каждый кадр вычисляет remaining_samples = (TrackNumSlots-HSA)*CS + KzEndSub-HSub.
2298  39DA              ;   rem > 2*CS (=64)  → KzFrame=1 (closed skull, idle)
2299  39DA              ;   rem in [1..64]    → KzFrame = 2 + ((64-rem) >> 3) ∈ [2..10] (opening)
2300  39DA              ;   rem <= 0          → trigger absorb (state=1, KzFrame=11)
2301  39DA              ; Rollback (match-3 cascade двигает HSA назад) → rem растёт → frame уменьшается
2302  39DA              ; обратно к 1 автоматически. Никаких отдельных rollback hook'ов.
2303  39DA              ; ============================================================================
2304  39DA              VDC_CheckKillzone:
2305  39DA 3A 98 69                     LD   A, (Core.VDC_SlotsLen)
2306  39DD B7                           OR   A
2307  39DE C8                           RET  Z
2308  39DF                              ; --- cells_to_go = TrackNumSlots - HSA ---
2309  39DF 2A 65 D3                     LD   HL, (Core.VDC_TrackNumSlots)      ; L = TNS low (TNS≈86 fits)
2310  39E2 7D                           LD   A, L
2311  39E3 21 5C D3                     LD   HL, Core.VDC_HSA
2312  39E6 96                           SUB  (HL)                              ; A = TNS - HSA (signed-ish)
2313  39E7 28 1F                        JR   Z, .ck_eqcell                     ; equal cells
2314  39E9 38 4C                        JR   C, .ck_trigger                    ; HSA > TNS → past
2315  39EB                              ; --- HSA < TNS: rem = A*CS + KzEndSub - HSub ---
2316  39EB 26 00                        LD   H, 0
2317  39ED 6F                           LD   L, A
2318  39EE 29                           ADD  HL, HL
2318  39EF 29             ADD HL, HL
2318  39F0 29             ADD HL, HL
2319  39F1 29                           ADD  HL, HL
2319  39F2 29             ADD HL, HL               ; HL = A * 32 (CELL_SIZE)
2320  39F3 3A 6C D3                     LD   A, (Core.VDC_KzEndSub)
2321  39F6 57                           LD   D, A
2322  39F7 3A 97 69                     LD   A, (Core.VDC_HSub)
2323  39FA 5F                           LD   E, A
2324  39FB 7A                           LD   A, D
2325  39FC 93                           SUB  E                                 ; A = KzEndSub - HSub (signed)
2326  39FD 5F                           LD   E, A
2327  39FE 16 00                        LD   D, 0
2328  3A00 CB 7F                        BIT  7, A
2329  3A02 28 01                        JR   Z, .ck_add_delta
2330  3A04 15                           DEC  D                                 ; sign-extend negative
2331  3A05 19           .ck_add_delta:  ADD  HL, DE                            ; HL = remaining samples
2332  3A06 18 10                        JR   .ck_set_frame
2333  3A08              .ck_eqcell:     ; HSA == TNS: rem = KzEndSub - HSub ∈ [1..CS-1] always opening range
2334  3A08 3A 6C D3                     LD   A, (Core.VDC_KzEndSub)
