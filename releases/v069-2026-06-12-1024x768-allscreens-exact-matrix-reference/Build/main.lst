 828  21FA              ; ============================================================================
 829  21FA              ; UpdateDialog — диалог game-over обработка click anywhere → restart.
 830  21FA              ; Вызывается каждый кадр ДО Frog_Update (чтобы dialog click не триггерил bullet).
 831  21FA              ; ============================================================================
 832  21FA              UpdateDialog:
 833  21FA 3A 9C 69                     LD   A, (Core.VDC_DialogState)
 834  21FD B7                           OR   A
 835  21FE C8                           RET  Z                                  ; диалог не показан
 836  21FF 3E 01                        LD   A, 1
 837  2201 32 9F 69                     LD   (Core.VDC_HudPointerBlock), A      ; dialog consumes LMB for this frame
 838  2204 3A 9C 69                     LD   A, (Core.VDC_DialogState)
 839  2207 FE 03                        CP   3
 840  2209 CA EF 65                     JP   Z, Core.UpdatePauseDialog
 841  220C FE 04                        CP   4
 842  220E CA 90 66                     JP   Z, Core.UpdatePauseFade            ; pause window fade-out -> PLAY
 843  2211 FE 06                        CP   Core.DLG_WIN_FADE
 844  2213 CA 87 22                     JP   Z, .udlg_win_fade                  ; LEVEL DONE → OK нажат → fade-out
 845  2216
 846  2216                              ; --- Клавиша огня (Space|Enter|Kempston) — минуя hit-test. ЛКМ ниже. ---
 847  2216 CD AA 7D                     CALL Core.Input_FireKey
 848  2219 20 06                        JR   NZ, .udlg_fire_check_edge         ; нажата
 849  221B                              ; Огонь отпущен — сброс debounce
 850  221B AF                           XOR  A
 851  221C 32 9F 22                     LD   (DialogFirePrev), A
 852  221F 18 0E                        JR   .udlg_check_lmb
 853  2221              .udlg_fire_check_edge:
 854  2221 3A 9F 22                     LD   A, (DialogFirePrev)
 855  2224 B7                           OR   A
 856  2225 20 08                        JR   NZ, .udlg_check_lmb               ; уже было pressed → no edge
 857  2227 3E 01                        LD   A, 1
 858  2229 32 9F 22                     LD   (DialogFirePrev), A
 859  222C C3 6E 22                     JP   .udlg_action                       ; rising edge → trigger
 860  222F
 861  222F              .udlg_check_lmb:
 862  222F                              ; --- Read mouse LMB state, detect falling edge (release = click) ---
 863  222F CD BD 7D                     CALL Core.Input_MouseLMB                ; Z=released, NZ=pressed
 864  2232 3E 00                        LD   A, 0
 865  2234 28 01                        JR   Z, .udlg_lmb_set
 866  2236 3C                           INC  A
 867  2237 4F           .udlg_lmb_set:  LD   C, A                               ; C = current LMB (0/1)
 868  2238 3A 9D 69                     LD   A, (Core.VDC_PrevMouseL)
 869  223B 47                           LD   B, A                               ; B = previous LMB
 870  223C 79                           LD   A, C
 871  223D 32 9D 69                     LD   (Core.VDC_PrevMouseL), A           ; save for next frame
 872  2240                              ; Falling edge: was pressed (B=1) AND now released (C=0) → CLICK
 873  2240 78                           LD   A, B
 874  2241 B7                           OR   A
 875  2242 C8                           RET  Z                                  ; не было pressed → нет клика
 876  2243 79                           LD   A, C
 877  2244 B7                           OR   A
 878  2245 C0                           RET  NZ                                 ; ещё pressed → нет клика
 879  2246                              ; --- Hit-test: курсор должен быть в bounds OK button ---
 880  2246 2A 49 16                     LD   HL, (Input.Mouse.PositionX)
 881  2249 11 10 01                     LD   DE, DLG_OK_X
 882  224C A7                           AND  A
 883  224D ED 52                        SBC  HL, DE
 884  224F D8                           RET  C
 885  2250 2A 49 16                     LD   HL, (Input.Mouse.PositionX)
 886  2253 11 F0 02                     LD   DE, DLG_OK_X + DIALOG_OK_DRAW_W
 887  2256 A7                           AND  A
 888  2257 ED 52                        SBC  HL, DE
 889  2259 D0                           RET  NC
 890  225A 2A 4B 16                     LD   HL, (Input.Mouse.PositionY)
 891  225D 11 F8 01                     LD   DE, DLG_OK_Y
 892  2260 A7                           AND  A
 893  2261 ED 52                        SBC  HL, DE
 894  2263 D8                           RET  C
 895  2264 2A 4B 16                     LD   HL, (Input.Mouse.PositionY)
 896  2267 11 2E 02                     LD   DE, DLG_OK_Y + DIALOG_OK_DRAW_H
 897  226A A7                           AND  A
 898  226B ED 52                        SBC  HL, DE
 899  226D D0                           RET  NC
 900  226E
 901  226E              .udlg_action:   ; Mouse click in OK bounds OR Fire key pressed
 902  226E 3A 9C 69                     LD   A, (Core.VDC_DialogState)
 903  2271 FE 05                        CP   Core.DLG_WIN_DONE
 904  2273 28 09                        JR   Z, .udlg_winnext                   ; LEVEL DONE → OK → начать fade
 905  2275 FE 03                        CP   3
 906  2277 20 0B                        JR   NZ, .udlg_restart
 907  2279 AF                           XOR  A
 908  227A 32 9C 69                     LD   (Core.VDC_DialogState), A          ; PAUSE → resume
 909  227D C9                           RET
 910  227E 3E 06        .udlg_winnext:  LD   A, Core.DLG_WIN_FADE               ; OK на LEVEL DONE → fade-out фаза
 911  2280 32 9C 69                     LD   (Core.VDC_DialogState), A
 912  2283 C9                           RET
 913  2284              .udlg_restart:
 914  2284 C3 A1 22                     JP   RestartLevel
 915  2287
 916  2287              ; --- LEVEL DONE fade-out: рампим FadeAlpha до чёрного, потом грузим след. уровень.
 917  2287              ; Сцена (поле + диалог) + DrawFadeOverlay рисуются в ZL_DrawFrame каждый кадр.
 918  2287 3A 8E 69     .udlg_win_fade: LD   A, (FadeAlpha)
 919  228A FE FF                        CP   255
 920  228C 28 0A                        JR   Z, .uwf_done                       ; полностью чёрный → advance
 921  228E C6 10                        ADD  A, Core.VDC_WIN_FADE_STEP
 922  2290 30 02                        JR   NC, .uwf_store
 923  2292 3E FF                        LD   A, 255                             ; clamp до full black
 924  2294 32 8E 69     .uwf_store:     LD   (FadeAlpha), A
 925  2297 C9                           RET
 926  2298 AF           .uwf_done:      XOR  A
 927  2299 32 9C 69                     LD   (Core.VDC_DialogState), A
 928  229C C3 04 62                     JP   Core.LoadNextLevelWithLoading      ; black screen → LOADING LEVEL N-M... → load assets
 929  229F
 930  229F 00           DialogFirePrev: DEFB 0                                  ; SPACE/Fire debounce для dialog OK
 931  22A0 00           DialogFrameLoaded: DEFB 0                               ; 1 если DIALOG_FRAME_RAMG сейчас содержит окно диалога
 932  22A1
 933  22A1              RestartLevel:
 934  22A1 AF                           XOR  A
 935  22A2 32 9C 69                     LD   (Core.VDC_DialogState), A          ; скрыть диалог
 936  22A5                              ; Если lives=0 → reset до 3 (full restart)
 937  22A5 3A 9B 69                     LD   A, (Core.VDC_Lives)
 938  22A8 B7                           OR   A
 939  22A9 20 08                        JR   NZ, .rl_keep_lives
