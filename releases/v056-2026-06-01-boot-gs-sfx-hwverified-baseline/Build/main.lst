 111+ CE9A              LS_SKY_SCROLL16 EQU 11                                 ; 1/16 px/кадр (≈2/3), субпиксельно — без джиттера
 112+ CE9A              LevelSelectAdvanceSky:
 113+ CE9A                              ; pos += шаг (1/16 px); wrap вычитанием W*16 без потери остатка.
 114+ CE9A 2A A9 D9                     LD   HL, (LevelSelectSkyPos)
 115+ CE9D 11 0B 00                     LD   DE, LS_SKY_SCROLL16
 116+ CEA0 19                           ADD  HL, DE
 117+ CEA1 11 00 28                     LD   DE, LS_SKY_W * 16
 118+ CEA4 A7                           AND  A
 119+ CEA5 ED 52                        SBC  HL, DE
 120+ CEA7 30 01                        JR   NC, .store                        ; >=0 -> wrapped
 121+ CEA9 19                           ADD  HL, DE                            ; <0  -> вернуть
 122+ CEAA 22 A9 D9     .store:         LD   (LevelSelectSkyPos), HL
 123+ CEAD C9                           RET
