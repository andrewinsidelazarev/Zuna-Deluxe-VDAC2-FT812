 119+ E8E8 11 54 20    >                LD DE, (FT_REG_DLSWAP) & 0xFFFF
 119+ E8EB CD A5 11    >                CALL FT.Read8
 119+ E8EE D1          >                POP DE
 120+ E8EF E6 03                        AND  3
