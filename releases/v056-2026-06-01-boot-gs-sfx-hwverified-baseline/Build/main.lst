1057+ CB0D              ; ============================================================================
1058+ CB0D              ; OVL_ProbeBoot (Этап 1 загрузчика Quit) — найти BOOT.$C в корне SD, прочитать
1059+ CB0D              ; 1-й сектор, сложить результат в РЕЗИДЕНТНЫЕ Core-переменные для проверки по F12-
1060+ CB0D              ; дампу. НИЧЕГО не запускает (это де-риск проба). Вызывается через резидентный
1061+ CB0D              ; трамплин ProbeBootHobeta (slot3 = LOADER_OVL_PAGE уже выставлен).
1062+ CB0D              ;   Boot_Found = 1 если найден и прочитан, иначе 0.
1063+ CB0D              ;   Boot_Clus  = стартовый кластер (4 байта), Boot_Size = размер в байтах (4),
1064+ CB0D              ;   Boot_Hdr   = первые 32 байта файла (HOBETA-заголовок).
1065+ CB0D              ; ============================================================================
1066+ CB0D              OVL_ProbeBoot:
1067+ CB0D AF                           XOR  A
1068+ CB0E 32 18 6D                     LD   (Boot_Found), A
1069+ CB11 CD 9A C3                     CALL ZiFi_Init                  ; SD init (always CF=1)
1070+ CB14 CD 3D C4                     CALL RawPak_OpenRoot            ; разобрать BPB/MBR (+найти PAK, игнор)
1071+ CB17 D2 9E CB                     JP   NC, .pbDone                ; SD/BPB ошибка → Boot_Found=0
1072+ CB1A 21 35 C4                     LD   HL, RAWPAK_NAME_BOOT       ; цель = "BOOT.$C"
1073+ CB1D 11 9E CD                     LD   DE, RawPak_TargetName
1074+ CB20 7E           .pbCpy:         LD   A, (HL)
1075+ CB21 CD D0 C8                     CALL RawPak_Upcase
1076+ CB24 12                           LD   (DE), A
1077+ CB25 23                           INC  HL
1077+ CB26 13             INC DE
1078+ CB27 B7                           OR   A
1079+ CB28 20 F6                        JR   NZ, .pbCpy
1080+ CB2A AF                           XOR  A
1081+ CB2B 32 1E CE                     LD   (RawPak_CheckSize), A      ; сначала найти по имени, затем проверить размер BOOT
1082+ CB2E CD 03 C6                     CALL RawPak_FindByName          ; CF=1 найден → FileStartClus + FoundSize
1083+ CB31 D2 9E CB                     JP   NC, .pbDone
1084+ CB34 2A 1F CE                     LD   HL, (RawPak_FoundSize + 0)
1085+ CB37 11 11 7C                     LD   DE, RAWPAK_BOOT_SIZE
1086+ CB3A B7                           OR   A
1087+ CB3B ED 52                        SBC  HL, DE
1088+ CB3D C2 9E CB                     JP   NZ, .pbDone
1089+ CB40 2A 21 CE                     LD   HL, (RawPak_FoundSize + 2)
1090+ CB43 11 00 00                     LD   DE, 0
1091+ CB46 B7                           OR   A
1092+ CB47 ED 52                        SBC  HL, DE
1093+ CB49 C2 9E CB                     JP   NZ, .pbDone
1094+ CB4C 21 34 CE                     LD   HL, RawPak_FileStartClus
1095+ CB4F 11 19 6D                     LD   DE, Boot_Clus
1096+ CB52 CD 74 CD                     CALL RawPak_Copy32
1097+ CB55 21 1F CE                     LD   HL, RawPak_FoundSize
1098+ CB58 11 1D 6D                     LD   DE, Boot_Size
1099+ CB5B CD 74 CD                     CALL RawPak_Copy32
1100+ CB5E                              ; --- прочитать 1-й сектор файла → Boot_Hdr (32 байта) ---
1101+ CB5E 21 34 CE                     LD   HL, RawPak_FileStartClus
1102+ CB61 11 38 CE                     LD   DE, RawPak_CurClus
1103+ CB64 CD 74 CD                     CALL RawPak_Copy32
1104+ CB67 AF                           XOR  A
1105+ CB68 32 99 CD                     LD   (RawPak_CurSecInClus), A
1106+ CB6B CD 9D CA                     CALL RawPak_CurrentLbaRegs      ; HL:DE = абсолютный LBA первого сектора
1107+ CB6E 22 41 6D                     LD   (Boot_StartLba + 0), HL
1108+ CB71 ED 53 43 6D                  LD   (Boot_StartLba + 2), DE
1109+ CB75 CD 01 CB                     CALL RawPak_ReadSectorBuffer    ; → #8000 (slot2), IX=#8000 (клобает HL:DE)
1110+ CB78 DA 9E CB                     JP   C, .pbDone
