1072+ F25D              ; ----------------------------------------------------------------------------
1073+ F25D              ; ZL_FT_CMD_Write_DMA — runtime FT_CMD_Write replacement using TS-Config DMA.
1074+ F25D              ;   Sends CMD_ADDRESS_PTR..BufferPtr to FT_REG_CMDB_WRITE through DMA_RAM_SPI.
1075+ F25D              ;   MainLoop calls this only after previous WaitFlush, so the FT812 command FIFO
1076+ F25D              ;   should have enough free space for the whole frame buffer. Keep the legacy
1077+ F25D              ;   FT_CMD_Write path behind ZL_FT_CMD_DMA_ENABLED for hardware fallback.
1078+ F25D              ; ----------------------------------------------------------------------------
1079+ F25D              ZL_CMD_DMA_PAGE EQU #05
1080+ F25D              ZL_CMD_DMA_ADDR EQU #5010 & #3FFF
1081+ F25D
1082+ F25D              ZL_FT_CMD_Write_DMA:
1083+ F25D                              FT_CMD_Count                            ; BC = byte count
1083+ F25D 2A 35 14    >                        LD HL, (FT.Coprocessor.BufferPtr)
1083+ F260 11 F0 AF    >                        LD DE, (-#5010) & 0xFFFF
1083+ F263 19          >                        ADD HL, DE
1083+ F264 44          >                        LD B, H
1083+ F265 4D          >                        LD C, L
1084+ F266 78                           LD   A, B
1085+ F267 B1                           OR   C
1086+ F268 C8                           RET  Z
1087+ F269
1088+ F269                              ; Convert byte count to word count for DMA registers.
1089+ F269 CB 38                        SRL  B
1090+ F26B CB 19                        RR   C
1091+ F26D 78                           LD   A, B
1092+ F26E 32 3A F3                     LD   (ZL_CmdDmaWordsHi), A              ; full 512-byte chunks
1093+ F271 79                           LD   A, C
1094+ F272 32 3B F3                     LD   (ZL_CmdDmaWordsLo), A              ; trailing words
1095+ F275
1096+ F275                              FT_ON
1096+ F275 3E 07       >                LD A, SPI_FT_CS_ON
1096+ F277 D3 77       >                OUT (SPI_CTRL), A
1097+ F279                              ; FT812 SPI memory-write header: 1,0,address[21:0], then payload.
1098+ F279 3E B0                        LD   A, ((FT_REG_CMDB_WRITE >> 16) & #FF) | #80
1099+ F27B D3 57                        OUT  (SPI_DATA), A
1100+ F27D 3E 25                        LD   A, (FT_REG_CMDB_WRITE >> 8) & #FF
1101+ F27F D3 57                        OUT  (SPI_DATA), A
1102+ F281 3E 78                        LD   A, FT_REG_CMDB_WRITE & #FF
1103+ F283 D3 57                        OUT  (SPI_DATA), A
1104+ F285
1105+ F285                              ; DMA source = CMD buffer in Core page #05, offset #1010.
1106+ F285 3E 10                        LD   A, LOW ZL_CMD_DMA_ADDR
1107+ F287 01 AF 1A                     LD   BC, DMASADDRL
1108+ F28A ED 79                        OUT  (C), A
1109+ F28C 3E 10                        LD   A, HIGH ZL_CMD_DMA_ADDR
1110+ F28E 01 AF 1B                     LD   BC, DMASADDRH
1111+ F291 ED 79                        OUT  (C), A
1112+ F293 3E 05                        LD   A, ZL_CMD_DMA_PAGE
1113+ F295 01 AF 1C                     LD   BC, DMASADDRX
1114+ F298 ED 79                        OUT  (C), A
1115+ F29A
1116+ F29A                              ; Full 512-byte chunks: DMALEN=255 words, DMANUM=chunks-1.
1117+ F29A 3A 3A F3                     LD   A, (ZL_CmdDmaWordsHi)
1118+ F29D B7                           OR   A
1119+ F29E 28 1D                        JR   Z, .tail
1120+ F2A0 3D                           DEC  A
1121+ F2A1 01 AF 28                     LD   BC, DMANUM
1122+ F2A4 ED 79                        OUT  (C), A
1123+ F2A6 3E FF                        LD   A, #FF
1124+ F2A8 01 AF 26                     LD   BC, DMALEN
1125+ F2AB ED 79                        OUT  (C), A
1126+ F2AD 3E 82                        LD   A, DMA_RAM_SPI
1127+ F2AF 01 AF 27                     LD   BC, DMACTR
1128+ F2B2 ED 79                        OUT  (C), A
1129+ F2B4 01 AF 27     .wait_full:     LD   BC, DMASTATUS
1130+ F2B7 ED 78                        IN   A, (C)
1131+ F2B9 E6 80                        AND  DMA_WNR
1132+ F2BB 20 F7                        JR   NZ, .wait_full
1133+ F2BD
1134+ F2BD 3A 3B F3     .tail:          LD   A, (ZL_CmdDmaWordsLo)
1135+ F2C0 B7                           OR   A
1136+ F2C1 28 1C                        JR   Z, .done
1137+ F2C3 3D                           DEC  A
1138+ F2C4 01 AF 26                     LD   BC, DMALEN
1139+ F2C7 ED 79                        OUT  (C), A
1140+ F2C9 AF                           XOR  A
1141+ F2CA 01 AF 28                     LD   BC, DMANUM
1142+ F2CD ED 79                        OUT  (C), A
1143+ F2CF 3E 82                        LD   A, DMA_RAM_SPI
1144+ F2D1 01 AF 27                     LD   BC, DMACTR
1145+ F2D4 ED 79                        OUT  (C), A
1146+ F2D6 01 AF 27     .wait_tail:     LD   BC, DMASTATUS
1147+ F2D9 ED 78                        IN   A, (C)
1148+ F2DB E6 80                        AND  DMA_WNR
1149+ F2DD 20 F7                        JR   NZ, .wait_tail
1150+ F2DF
1151+ F2DF              .done:          FT_OFF
