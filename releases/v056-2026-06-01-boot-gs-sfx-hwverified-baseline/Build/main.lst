   1++C26A              ;//////////////////////////////////////////////////////////////
   2++C26A              ;//  Self-contained SD (Z-Controller) raw sector read.
   3++C26A              ;//  Ported from the WC device driver DSDZC.ASM read path
   4++C26A              ;//  (via Desktop/WC/Chkdsk/src/sd_zc.a80 by the ChkDsk session).
   5++C26A              ;//  The card is already initialised by WC before the SPG launches
   6++C26A              ;//  (hardware state persists), so we only issue CMD17 reads.
   7++C26A              ;//
   8++C26A              ;//  This BYPASSES the bundled TS-DOS driver, whose FAT chain walk
   9++C26A              ;//  drifts -128 sectors at the first FAT-sector boundary in our SPG
  10++C26A              ;//  context. We do our own BPB/FAT walk on top of sd_read_sector.
  11++C26A              ;//
  12++C26A              ;//  Unreal/this host uses BYTE addressing (sd_blkt = 0): the CMD17
  13++C26A              ;//  argument is LBA*512. (Real SDHC would use block addressing.)
  14++C26A              ;//////////////////////////////////////////////////////////////
  15++C26A
  16++C26A              SD_CONF         equ     #77             ; config / chip-select port
  17++C26A              SD_DATA         equ     #57             ; data port
  18++C26A              SD_CMD17        equ     %01000000+17    ; single-block read
  19++C26A              SD_CS1          equ     %00000001       ; chip select, SD1
  20++C26A
  21++C26A              ;--- sd_init: byte addressing (Unreal). sd_blkt = 0.
  22++C26A              sd_init:
  23++C26A AF                           xor     a
  24++C26B 32 95 C3                     ld      (sd_blkt),a
  25++C26E CD E4 C2                     call    sd_csh
  26++C271 CD 41 C3                     call    sd_snb
  27++C274 C9                           ret
  28++C275
  29++C275              ;--- sd_read_sector: read one 512-byte sector
  30++C275              ;    in:  HL = LBA (low 16), DE = LBA (high 16)  [LBA is 32-bit]
  31++C275              ;         IX = destination buffer (512 bytes)
  32++C275              ;    out: CF = 1 on error, CF = 0 on success
  33++C275              sd_read_sector:
  34++C275 22 91 C3                     ld      (sd_lba+0),hl
  35++C278 ED 53 93 C3                  ld      (sd_lba+2),de
  36++C27C CD 5F C3                     call    sd_lba_in_range         ; защита: не слать CMD17 за пределы тома —
  37++C27F 38 1E                        jr      c,.range                ; битый LBA иначе кирпичит реальную SDHC до переткивания
  38++C281 DD E5                        push    ix
  39++C283 E1                           pop     hl                      ; HL = buffer
  40++C284 CD A1 C2                     call    sd_cmd17
  41++C287 20 11                        jr      nz,.err                 ; R1 must be #00
  42++C289 CD 23 C3                     call    sd_wait_token
  43++C28C 38 0C                        jr      c,.err
  44++C28E CD DA C2                     call    sd_reads                ; read 512 bytes -> (HL), HL += 512
  45++C291 DB 57                        in      a,(SD_DATA)             ; CRC16 lo (ignored)
  46++C293 DB 57                        in      a,(SD_DATA)             ; CRC16 hi (ignored)
  47++C295 CD E4 C2                     call    sd_csh
  48++C298 B7                           or      a                       ; CF=0
  49++C299 C9                           ret
  50++C29A CD E4 C2     .err            call    sd_csh
  51++C29D 37                           scf
  52++C29E C9                           ret
  53++C29F 37           .range          scf                             ; LBA вне тома — карту не трогаем вообще
  54++C2A0 C9                           ret
  55++C2A1
  56++C2A1              ;--- CMD17 (single-block read). Address from sd_lba.
  57++C2A1              ;    byte addressing (sd_blkt==0): argument = LBA*512 (byte offset).
  58++C2A1              ;    Preserves HL (caller's buffer pointer). Port of DSDZC CMDz.
  59++C2A1              sd_cmd17:
  60++C2A1 3E 51                        ld      a,SD_CMD17
  61++C2A3 CD E4 C2                     call    sd_csh
  62++C2A6 CD F7 C2                     call    sd_csl
  63++C2A9 E5                           push    hl                      ; preserve buffer pointer
  64++C2AA ED 5B 91 C3                  ld      de,(sd_lba+0)           ; DE = LBA low16
  65++C2AE ED 4B 93 C3                  ld      bc,(sd_lba+2)           ; BC = LBA high16
  66++C2B2 69                           ld      l,c
  67++C2B3 60                           ld      h,b                     ; HL = high16
  68++C2B4 4F                           ld      c,a                     ; C = command
  69++C2B5 3A 95 C3                     ld      a,(sd_blkt)
  70++C2B8 B7                           or      a
  71++C2B9 20 09                        jr      nz,.send                ; block addressing -> send LBA as-is
  72++C2BB                              ; byte addressing: [HL:DE] = LBA*512  (x2 then x256 byte-shift)
  73++C2BB EB                           ex      de,hl
  73++C2BC 29             add hl,hl
  74++C2BD EB                           ex      de,hl
  74++C2BE ED 6A          adc hl,hl
  75++C2C0 65                           ld      h,l
  75++C2C1 6A             ld l,d
  75++C2C2 53             ld d,e
  75++C2C3 5F             ld e,a  ; A=sd_blkt=0 here
  76++C2C4              .send
  77++C2C4 79                           ld      a,c                     ; A = command
  78++C2C5 01 57 00                     ld      bc,SD_DATA
  79++C2C8 ED 79                        out     (c),a                   ; command byte
  80++C2CA ED 61                        out     (c),h
  81++C2CC ED 69                        out     (c),l
  82++C2CE ED 51                        out     (c),d
  83++C2D0 ED 59                        out     (c),e
  84++C2D2 3E FF                        ld      a,#FF
  85++C2D4 ED 79                        out     (c),a                   ; CRC (ignored)
  86++C2D6 E1                           pop     hl                      ; restore buffer pointer
  87++C2D7 C3 4C C3                     jp      sd_resp
  88++C2DA
  89++C2DA              ;--- read 512 bytes from data port into (HL); HL advances by 512
  90++C2DA              sd_reads:
  91++C2DA C5                           push    bc
  92++C2DB 01 57 00                     ld      bc,SD_DATA              ; B=0 -> 256 per INIR
  93++C2DE ED B2                        inir
  94++C2E0 ED B2                        inir
  95++C2E2 C1                           pop     bc
  96++C2E3 C9                           ret
  97++C2E4
  98++C2E4              ;--- chip select high (deselect) + clock
  99++C2E4              sd_csh:
 100++C2E4 C5                           push    bc
 100++C2E5 F5             push af
 101++C2E6 01 77 00                     ld      bc,SD_CONF
 101++C2E9 3E 03          ld a,%00000011
 101++C2EB ED 79          out (c),a
 102++C2ED 01 57 00                     ld      bc,SD_DATA
 102++C2F0 3E FF          ld a,#FF
 102++C2F2 ED 79          out (c),a
 103++C2F4 F1                           pop     af
 103++C2F5 C1             pop bc
 104++C2F6 C9                           ret
 105++C2F7
 106++C2F7              ;--- chip select low (select) + clock, then wait ready
 107++C2F7              sd_csl:
 108++C2F7 C5                           push    bc
 108++C2F8 F5             push af
 109++C2F9 01 77 00                     ld      bc,SD_CONF
 109++C2FC 3E 01          ld a,SD_CS1
 109++C2FE ED 79          out (c),a
 110++C300 01 57 00                     ld      bc,SD_DATA
 110++C303 3E FF          ld a,#FF
 110++C305 ED 79          out (c),a
 111++C307 F1                           pop     af
 111++C308 C1             pop bc
 112++C309 C3 0C C3                     jp      sd_wait
 113++C30C
 114++C30C              ;--- wait until card returns #FF (ready), BOUNDED. Never spin forever: if the
 115++C30C              ;    card stays busy we give up so a read fails cleanly (-> CF=1 -> L1 fallback)
 116++C30C              ;    instead of hanging the SD/SPI bus, which would also wedge WC's next SPG load.
 117++C30C              sd_wait:
 118++C30C C5                           push    bc
 118++C30D D5             push de
 118++C30E F5             push af
 119++C30F 01 57 00                     ld      bc,SD_DATA
 120++C312 11 00 00                     ld      de,0                    ; 65536 polls then give up
 121++C315 ED 78        .w              in      a,(c)
 121++C317 3C             inc a
 121++C318 28 05          jr z,.done   ; #FF -> ready
 122++C31A 1B                           dec     de
 122++C31B 7A             ld a,d
 122++C31C B3             or e
 122++C31D 20 F6          jr nz,.w
 123++C31F F1           .done           pop     af
 123++C320 D1             pop de
 123++C321 C1             pop bc
 124++C322 C9                           ret
 125++C323
 126++C323              ;--- wait for data token #FE with bounded timeout.
 127++C323              ;    out: CF=0 token received, CF=1 timeout/error token.
 128++C323              sd_wait_token:
 129++C323 C5                           push    bc
 130++C324 01 57 00                     ld      bc,SD_DATA
 131++C327 16 04                        ld      d,4
 132++C329 1E 00        .outer          ld      e,0
 133++C32B ED 78        .inner          in      a,(c)
 134++C32D FE FE                        cp      #FE
 135++C32F 28 0D                        jr      z,.ok
 136++C331 CB 7F                        bit     7,a
 137++C333 28 06                        jr      z,.err                  ; data error token (0xxxxxxx)
 138++C335 1D                           dec     e
 139++C336 20 F3                        jr      nz,.inner
 140++C338 15                           dec     d
 141++C339 20 EE                        jr      nz,.outer
 142++C33B C1           .err            pop     bc
 143++C33C 37                           scf
 144++C33D C9                           ret
 145++C33E C1           .ok             pop     bc
 146++C33F B7                           or      a
 147++C340 C9                           ret
 148++C341
 149++C341              ;--- 16 dummy reads
 150++C341              sd_snb:
 151++C341 C5                           push    bc
 151++C342 F5             push af
 152++C343 06 10                        ld      b,16
 153++C345 DB 57        .s              in      a,(SD_DATA)
 153++C347 10 FC          djnz .s
 154++C349 F1                           pop     af
 154++C34A C1             pop bc
 155++C34B C9                           ret
 156++C34C
 157++C34C              ;--- read R1 response (bit7=0), up to 10 tries
 158++C34C              sd_resp:
 159++C34C D5                           push    de
 159++C34D C5             push bc
 160++C34E 01 57 00                     ld      bc,SD_DATA
 161++C351 16 0A                        ld      d,10
 162++C353 ED 78        .r              in      a,(c)
 162++C355 CB 7F          bit 7,a
 162++C357 28 03          jr z,.done
 163++C359 15                           dec     d
 163++C35A 20 F7          jr nz,.r
 164++C35C C1           .done           pop     bc
 164++C35D D1             pop de
 165++C35E C9                           ret
 166++C35F
 167++C35F              ;--- sd_lba_in_range: проверка sd_lba против верхней границы тома sd_lba_max.
 168++C35F              ;    out: CF=1 — отвергнуть (sd_lba >= sd_lba_max); CF=0 — ок ИЛИ защита выключена.
 169++C35F              ;    sd_lba_max==0 => защита выключена (до парса BPB, для bootstrap-чтений).
 170++C35F              ;    Сохраняет HL/DE/BC; клобает A/флаги (результат — в CF).
 171++C35F              sd_lba_in_range:
 172++C35F E5                           push    hl
 172++C360 D5             push de
 172++C361 C5             push bc
 173++C362 3A 96 C3                     ld      a,(sd_lba_max+0)        ; sd_lba_max == 0 ?
 174++C365 47                           ld      b,a
 175++C366 3A 97 C3                     ld      a,(sd_lba_max+1)
 175++C369 B0             or b
 175++C36A 47             ld b,a
 176++C36B 3A 98 C3                     ld      a,(sd_lba_max+2)
 176++C36E B0             or b
 176++C36F 47             ld b,a
 177++C370 3A 99 C3                     ld      a,(sd_lba_max+3)
 177++C373 B0             or b
 178++C374 28 16                        jr      z,.disabled             ; все нули -> защита выключена
 179++C376 21 91 C3                     ld      hl,sd_lba
 180++C379 11 96 C3                     ld      de,sd_lba_max
 181++C37C B7                           or      a                       ; CF=0 перед многобайтовым вычитанием
 182++C37D 06 04                        ld      b,4
 183++C37F 1A           .cmp            ld      a,(de)                  ; sd_lba - sd_lba_max побайтно (LE)
 184++C380 4F                           ld      c,a
 185++C381 7E                           ld      a,(hl)
 186++C382 99                           sbc     a,c
 187++C383 23                           inc     hl
 188++C384 13                           inc     de
 189++C385 10 F8                        djnz    .cmp                    ; INC/DJNZ не трогают CF -> заём проходит насквозь
 190++C387 3F                           ccf                             ; заём(CF=1, sd_lba<max)->0 ок ; CF=0(>=max)->1 отвергнуть
 191++C388 C1                           pop     bc
 191++C389 D1             pop de
 191++C38A E1             pop hl
 192++C38B C9                           ret
 193++C38C C1           .disabled       pop     bc
 193++C38D D1             pop de
 193++C38E E1             pop hl
 194++C38F B7                           or      a                       ; CF=0 (в диапазоне)
 195++C390 C9                           ret
