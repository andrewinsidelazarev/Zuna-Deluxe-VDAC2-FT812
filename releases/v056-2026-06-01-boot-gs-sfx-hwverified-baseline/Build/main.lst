 199+ C0F2                              ; LFSR seed: базовый #ACE1, scramble через RTC секунды (low_byte ×
 200+ C0F2                              ; RTC_sec) — каждый запуск получает разную starting sequence, как
 201+ C0F2                              ; у коллеги в TS-Conf версии (RandomChainColor scramble).
 202+ C0F2 21 E1 AC                     LD   HL, #ACE1
 203+ C0F5 22 75 D4                     LD   (VDC_LfsrSeed), HL
 204+ C0F8 CD 94 C2                     CALL ReadRTCSeconds                    ; A = 0..59
 205+ C0FB B7                           OR   A
 206+ C0FC 20 02                        JR   NZ, .seed_have_sec
 207+ C0FE 3E 11                        LD   A, 17                             ; защита если RTC = 0
 208+ C100              .seed_have_sec:
 209+ C100 57                           LD   D, A
 209+ C101 5F             LD E, A                    ; DE = RTC sec (multiplier)
 210+ C102 2A 75 D4                     LD   HL, (VDC_LfsrSeed)
 211+ C105 7D                           LD   A, L                              ; A = low seed byte
 212+ C106 21 00 00                     LD   HL, 0
 213+ C109 06 08                        LD   B, 8
 214+ C10B              .seed_mul:
 215+ C10B 29                           ADD  HL, HL
 216+ C10C CB 27                        SLA  A
