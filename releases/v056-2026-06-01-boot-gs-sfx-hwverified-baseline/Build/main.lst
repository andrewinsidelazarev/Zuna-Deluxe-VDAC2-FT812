 233+ C122 AC                           XOR  H
 234+ C123 67                           LD   H, A
 235+ C124 ED 5F                        LD   A, R                              ; 7-bit refresh counter
 236+ C126 AD                           XOR  L
 237+ C127 6F                           LD   L, A
 238+ C128 22 75 D4                     LD   (VDC_LfsrSeed), HL
 239+ C12B                              ; --- DEBUG snapshot (для F12-dump диагностики) ---
 240+ C12B                              ; #5008..#500E: RAW значения трёх entropy-источников.
 241+ C12B CD 94 C2                     CALL ReadRTCSeconds
 242+ C12E 32 08 50                     LD   (#5008), A                        ; #5008 = raw RTC sec
 243+ C131 ED 5F                        LD   A, R
