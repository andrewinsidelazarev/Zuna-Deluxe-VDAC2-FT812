   2+ DE0A              ; Frog.asm — рендер лягушки 1:1 с Zuma-Deluxe-HD/src/zuma/Frog.c.
   3+ DE0A              ;
   4+ DE0A              ; Композиция (Frog_Draw):
   5+ DE0A              ;   • plate (no rotation) под body
   6+ DE0A              ;   • body с rotation matrix вокруг центра, angle = atan2(mouse - frog).
   7+ DE0A              ;     Native sprite face = south (BRAD 64), поэтому ZL_EmitRotate уже делает
   8+ DE0A              ;     ADD A,192 (= -64) — передаём raw FrogAngle.
   9+ DE0A              ;   • tongue с offset (tongueExpand · dir) и той же rotation matrix вокруг
  10+ DE0A              ;     центра sprite. dir = (cos(angle), sin(angle)) (см. SinTable ниже).
  11+ DE0A              ;
  12+ DE0A              ; Recoil/fire (Frog_Update):
  13+ DE0A              ;   ЛКМ rise edge → fireRecoilTick=0, isFire=1, ballExpand=0.
  14+ DE0A              ;   Каждый кадр: tick += 10 BRAD (≈0.245 rad ≈ HD 0.25 rad/frame).
  15+ DE0A              ;   recoil = sin(tick); пока recoil ≥ 0:
  16+ DE0A              ;     tongueExpand = 24 - (recoil * 24) >> 7         ; язык втянут в рот
  17+ DE0A              ;     ballExpand   = min(32, ballExpand + 2)         ; вылет шара
  18+ DE0A              ;     pos.x = posStart.x - (cos(angle) * recoil) / 2048    ; ≈ -dir*recoil*8/128
  19+ DE0A              ;     pos.y = posStart.y - (sin(angle) * recoil) / 2048
  20+ DE0A              ;   recoil < 0 → end: tongueExpand=24, ballExpand=32, pos=posStart, isFire=0.
  21+ DE0A              ;
  22+ DE0A              ; FT812 BITMAP_HANDLE: 2=body, 4=plate, 5=tongue.
  23+ DE0A              ; Frog layer format is selected by FROG_ARGB4_ENABLED in main.asm.
  24+ DE0A              ; ============================================================================
  25+ DE0A
  26+ DE0A              FROG_SPR_W        EQU 122
  27+ DE0A              FROG_SPR_HALF     EQU 61
  28+ DE0A              FROG_SPR_HALF_NEG EQU -FROG_SPR_HALF & 0xFFFF          ; -61 в 16-bit two's-comp
  29+ DE0A
  30+ DE0A              ; Tongue full 122×122 ARGB4 — точный 1:1 перенос из Python visual_emulator.py.
  31+ DE0A              ; Pivot UV (61, 61) = sprite centre = HD anchor (native sprite centre 81, 81 в
  32+ DE0A              ; 162×162, после resize 162→122).  Screen rect совпадает со sprite size, sprite
  33+ DE0A              ; circular fits в square rect при любом угле rotation, без clipping.
  34+ DE0A              FROG_TONGUE_W     EQU 122                               ; sprite W в RAM_G
  35+ DE0A              FROG_TONGUE_H     EQU 122                               ; sprite H в RAM_G
  36+ DE0A              FROG_TONGUE_UV_HW EQU 61                                ; UV pivot = sprite centre
  37+ DE0A              FROG_TONGUE_UV_HH EQU 61
  38+ DE0A              FROG_TONGUE_SCR_W EQU 122
  39+ DE0A              FROG_TONGUE_SCR_H EQU 122
  40+ DE0A              FROG_TONGUE_SCR_HALF EQU 61
  41+ DE0A              FROG_TONGUE_SCR_HALF_NEG EQU -FROG_TONGUE_SCR_HALF & 0xFFFF
  42+ DE0A
  43+ DE0A              ; Overlay 122×122 (= same size как body — features alignment ✓).
  44+ DE0A
  45+ DE0A              FROG_RECOIL_STEP  EQU 10                                ; BRAD/frame; π/0.25 ≈ 12.6 кадров полу-периода
  46+ DE0A
  47+ DE0A              FROG_BALL_IDLE    EQU 24                                ; HD: ballExpand idle 24 (= точное Python значение)
  48+ DE0A              FROG_NEXT_OFFSET  EQU 28                                ; HD next-ball orbit (= точное Python значение)
  49+ DE0A              FROG_BALL_W       EQU 32                                ; ball atlas cell native classic 32×32
  50+ DE0A              FROG_BALL_DST_W   EQU 32                                ; screen size = native
  51+ DE0A              FROG_BALL_DST_HALF EQU 16
