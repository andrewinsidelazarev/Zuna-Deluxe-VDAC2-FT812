1146+ CBBE C9                           RET
1147+ CBBF
1148+ CBBF              ; Read a FAT sector into RawPak_FatBuf (resident in Core / slot 1). Keeps the
1149+ CBBF              ; FAT-chain walk from clobbering the slot-2 data buffer (#8000) that callers
1150+ CBBF              ; fill with directory/file sectors. HL:DE = LBA on entry.
1151+ CBBF              RawPak_ReadFatSector:
1152+ CBBF DD 21 40 CE                  LD   IX, RawPak_FatBuf
1153+ CBC3 C3 75 C2                     JP   sd_read_sector
1154+ CBC6
1155+ CBC6              ; --- Sector-run table (handles both contiguous AND fragmented PAK) ----------
1156+ CBC6              ; Requirement: read the PAK whether it is one contiguous run or fragmented.
1157+ CBC6              ; The old fast path assumed contiguity (LBA = PakLba + N) — true on a freshly
1158+ CBC6              ; built image, but a fragmented file would read the wrong sectors on the upper
1159+ CBC6              ; levels. Instead we walk the FAT chain once at open time and record the file as
1160+ CBC6              ; a list of extents (runs) {LBA, len_sectors}: a contiguous file collapses to a
1161+ CBC6              ; single run, a fragmented one to several. RawPak_ReadOneLogicalIX then maps a
1162+ CBC6              ; logical sector to a physical LBA via this table — O(runs), no per-read FAT
1163+ CBC6              ; walk, so a section still reads in one SD burst (no FT.WriteMem interleaving).
1164+ CBC6
1165+ CBC6              RAWPAK_RUN_MAX  EQU 128                ; max extents (128 * 6 = 768 B). Overflow -> open fails -> L1 fallback.
1166+ CBC6
1167+ CBC6              ; RawPak_BuildRunTable — walk the chain from RawPak_FileStartClus, fill
1168+ CBC6              ; RawPak_RunTable / RawPak_RunCount. CurSecInClus must be 0 (set by Seek0).
1169+ CBC6              ; Out: CF=1 ok; CF=0 on run-table overflow (heavily fragmented) or SD error.
1170+ CBC6              ;
1171+ CBC6              ; Scans the FAT *directly*, not via RawPak_FatNext: it keeps a pointer into
1172+ CBC6              ; RawPak_FatBuf and reads consecutive 4-byte FAT entries, only recomputing the
1173+ CBC6              ; FAT-sector LBA (the expensive cluster>>7) when it crosses a 128-entry sector
1174+ CBC6              ; boundary or follows a non-sequential link. A contiguous PAK (the common case)
1175+ CBC6              ; then costs ~ one FAT-sector read per 128 clusters and a tight inner loop —
1176+ CBC6              ; instead of a full cluster>>7 + 32-bit shift chain per cluster.
1177+ CBC6              RawPak_BuildRunTable:
1178+ CBC6 21 34 CE                     LD   HL, RawPak_FileStartClus
1179+ CBC9 11 38 CE                     LD   DE, RawPak_CurClus
1180+ CBCC CD 74 CD                     CALL RawPak_Copy32
1181+ CBCF AF                           XOR  A
1182+ CBD0 32 99 CD                     LD   (RawPak_CurSecInClus), A
1183+ CBD3                              ; --- first run: LBA = LBA(FileStartClus), len starts at 0 ---
1184+ CBD3 DD 21 4B D0                  LD   IX, RawPak_RunTable
1185+ CBD7 CD 9D CA                     CALL RawPak_CurrentLbaRegs      ; HL = LBA lo16, DE = LBA hi16
1186+ CBDA DD 75 00                     LD   (IX + 0), L
1187+ CBDD DD 74 01                     LD   (IX + 1), H
1188+ CBE0 DD 73 02                     LD   (IX + 2), E
1189+ CBE3 DD 72 03                     LD   (IX + 3), D
1190+ CBE6 DD 36 04 00                  LD   (IX + 4), 0
1191+ CBEA DD 36 05 00                  LD   (IX + 5), 0
1192+ CBEE 3E 01                        LD   A, 1
1193+ CBF0 32 4A D0                     LD   (RawPak_RunCount), A
1194+ CBF3 DD E5                        PUSH IX                          ; FatEntryPtr->ReadFatSector clobbers IX
1195+ CBF5 CD C4 CC                     CALL RawPak_FatEntryPtr          ; HL -> FAT[CurClus] in FatBuf
1196+ CBF8 DD E1                        POP  IX
1197+ CBFA DA C2 CC                     JP   C, .fail
1198+ CBFD 22 48 D0                     LD   (RawPak_FatPtr), HL
1199+ CC00              .enter:        ; CurClus belongs to the current run -> count it
1200+ CC00 3A 98 CD                     LD   A, (RawPak_Spc)
1201+ CC03 DD 86 04                     ADD  A, (IX + 4)
1202+ CC06 DD 77 04                     LD   (IX + 4), A
1203+ CC09 30 03                        JR   NC, .noLenCy
1204+ CC0B DD 34 05                     INC  (IX + 5)
1205+ CC0E              .noLenCy:      ; NextClus = masked FAT entry at FatPtr; advance FatPtr by 4
1206+ CC0E 2A 48 D0                     LD   HL, (RawPak_FatPtr)
1207+ CC11 7E                           LD   A, (HL)
1207+ CC12 32 44 D0       LD (RawPak_NextClus + 0), A
1207+ CC15 23             INC HL
1208+ CC16 7E                           LD   A, (HL)
1208+ CC17 32 45 D0       LD (RawPak_NextClus + 1), A
1208+ CC1A 23             INC HL
1209+ CC1B 7E                           LD   A, (HL)
1209+ CC1C 32 46 D0       LD (RawPak_NextClus + 2), A
1209+ CC1F 23             INC HL
1210+ CC20 7E                           LD   A, (HL)
1210+ CC21 E6 0F          AND #0F
1210+ CC23 32 47 D0       LD (RawPak_NextClus + 3), A
1210+ CC26 23             INC HL
1211+ CC27 22 48 D0                     LD   (RawPak_FatPtr), HL
1212+ CC2A                              ; end of chain? NextClus >= 0x0FFFFFF8
1213+ CC2A 3A 47 D0                     LD   A, (RawPak_NextClus + 3)
1213+ CC2D FE 0F          CP #0F
1213+ CC2F 20 16          JR NZ, .notEoc
1214+ CC31 3A 46 D0                     LD   A, (RawPak_NextClus + 2)
1214+ CC34 FE FF          CP #FF
1214+ CC36 20 0F          JR NZ, .notEoc
1215+ CC38 3A 45 D0                     LD   A, (RawPak_NextClus + 1)
