2168+ DA69 21 FF FF                     LD   HL, GS_WAIT_TIMEOUT
2169+ DA6C ED 78        .wdat:          IN   A, (C)
2170+ DA6E 07                           RLCA                            ; bit7 -> CF (1 = FIFO полон/не готов)
2171+ DA6F 30 0D                        JR   NC, .ready                 ; bit7=0 -> есть место
2172+ DA71 2B                           DEC  HL
2173+ DA72 7C                           LD   A, H
2174+ DA73 B5                           OR   L
2175+ DA74 20 F6                        JR   NZ, .wdat
2176+ DA76 D1                           POP  DE
