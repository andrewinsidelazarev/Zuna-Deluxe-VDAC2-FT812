 112+ E8CF                              ; --- 3. Sync с FT812 swap interrupt, then wait until previous
 113+ E8CF                              ; DLSWAP request completed.  On real VDAC2, letting the
 114+ E8CF                              ; coprocessor rebuild RAM_DL during active scanout tears badly.
 115+ E8CF              .WaitIntSync    FT_RD_REG8 FT_REG_INT_FLAGS
 115+ E8CF D5          >                PUSH DE
 115+ E8D0 3E 30       >                LD A, (FT_RAM_REG >> 16) & 0xFF
