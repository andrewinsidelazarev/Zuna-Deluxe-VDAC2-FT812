2181+ DA7D C9                           RET
2182+ DA7E 7B           .ready:         LD   A, E
2183+ DA7F 01 B3 00                     LD   BC, GS_PORT_DATA           ; #B3 — данные
2184+ DA82 ED 79                        OUT  (C), A                     ; место есть -> пишем
2185+ DA84 D1                           POP  DE
2186+ DA85 E1                           POP  HL
2187+ DA86 37                           SCF
