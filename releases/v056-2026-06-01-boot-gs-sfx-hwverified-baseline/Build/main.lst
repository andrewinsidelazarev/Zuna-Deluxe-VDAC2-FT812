 168+ 6B9F              ; Loader diagnostics — RESIDENT so an F12 dump (which captures slot 1 = Core, not
 169+ 6B9F              ; the loader overlay page) shows how far a load got. The overlay loader writes
 170+ 6B9F              ; them while slot 1 is mapped. Read these in a dump to bisect a failed load:
 171+ 6B9F              ;   ZiFi_GpDbgStep : 0=not started, 1=Init, 2=PakOpen, 3=PakReadToc,
 172+ 6B9F              ;                    #34=bg SD done, #35=track SD done, 6=success;
 173+ 6B9F              ;                    #FF=Init err, #FE=PakOpen err, #FD=PakReadToc err.
 174+ 6B9F              ;   ZiFi_DbgGamesA : RawPak_OpenRoot granular step —
 175+ 6B9F              ;                    #20 entry, #21 BPB read OK, #22 BPB valid, #26 search start,
 176+ 6B9F              ;                    #25 PAK found; #A1 BPB CMD17 err, #A2 bps!=512, #A3 spc=0,
 177+ 6B9F              ;                    #A6 PAK not found anywhere, #A7 run-table overflow.
 178+ 6B9F              ;   ZiFi_DbgGamesFound : directories visited during the recursive search.
 179+ 6B9F 00           ZiFi_GpDbgStep:     DEFB 0
 180+ 6BA0 00 00        ZiFi_GpDbgBgOff:    DEFW 0
 181+ 6BA2 00 00        ZiFi_GpDbgBgSize:   DEFW 0
 182+ 6BA4 00           ZiFi_DbgGamesA:     DEFB 0
 183+ 6BA5 00           ZiFi_DbgGamesFound: DEFB 0
 184+ 6BA6 00           ZiFi_DbgZumaFound:  DEFB 0
 185+ 6BA7 00           ZiFi_DbgPakFound:   DEFB 0
 186+ 6BA8 00 00        ZiFi_DbgPakSizeL:   DEFW 0
 187+ 6BAA 00 00        ZiFi_DbgPakSizeH:   DEFW 0
