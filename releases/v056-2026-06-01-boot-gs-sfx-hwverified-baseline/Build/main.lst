  74+ C39A
  75+ C39A              ; ---------------------------------------------------------------------
  76+ C39A              ; ZiFi_Init — bring up SD driver for a session of file I/O calls.
  77+ C39A              ;   DI, slot 0 = #0F (driver page), DOS_SWP, DEV_INI, HDD, SETROOT.
  78+ C39A              ; After Init, ZiFi entries at #2002..#2070 are directly callable.
  79+ C39A              ;   CF=1 on success, CF=0 on init error. ZiFi_Done must still be called
  80+ C39A              ;   after a successful init.
  81+ C39A              ZiFi_Init:
  82+ C39A F3                           DI
  83+ C39B 3E 00                        LD   A,  TSLibPage
  84+ C39D                              SetPage0_A
  84+ C39D             >                ifdef MAPPING_REGISTERS
  84+ C39D 32 10 04    >                LD (FMADDR_REGS + HIGH PAGE0), A
  84+ C3A0             >                else
  84+ C3A0 ~           >                LD (MemoryPages + 0), A
  84+ C3A0 ~           >                LD BC, PAGE0
  84+ C3A0 ~           >                OUT (C), A
  84+ C3A0             >                endif
  85+ C3A0 CD 6A C2                     CALL sd_init
  86+ C3A3 37                           SCF
  87+ C3A4 C9                           RET
  88+ C3A5 B7           .Err:           OR   A
  89+ C3A6 C9                           RET
  90+ C3A7
  91+ C3A7              ; ZiFi_Done — restore TSLib in slot 0, EI.
  92+ C3A7              ZiFi_Done:
  93+ C3A7 3E 00                        LD   A,  TSLibPage
  94+ C3A9                              SetPage0_A
  94+ C3A9             >                ifdef MAPPING_REGISTERS
  94+ C3A9 32 10 04    >                LD (FMADDR_REGS + HIGH PAGE0), A
  94+ C3AC             >                else
  94+ C3AC ~           >                LD (MemoryPages + 0), A
  94+ C3AC ~           >                LD BC, PAGE0
  94+ C3AC ~           >                OUT (C), A
  94+ C3AC             >                endif
  95+ C3AC FB                           EI
  96+ C3AD C9                           RET
  97+ C3AE
  98+ C3AE              ; Backwards-compat aliases (older wrappers below assume per-call swap).
  99+ C3AE              ; Now that we call ZiFi_Init/ZiFi_Done at session boundary, these can
 100+ C3AE              ; just RET — the slot-0 mapping is already #0F.
 101+ C3AE C9           ZiFi_Enter:     RET
 102+ C3AF C9           ZiFi_Leave:     RET
 103+ C3B0
 104+ C3B0              ; ---------------------------------------------------------------------
 105+ C3B0              ; ZiFi_FEntry — search current dir for filename.
 106+ C3B0              ;   In : HL → {flag, name, 0}
 107+ C3B0              ;   Out: Z=not found; NZ=found, [DE:HL]=size; SEEK0 auto-called
 108+ C3B0              ZiFi_FEntry:
 109+ C3B0 CD AE C3                     CALL ZiFi_Enter
 110+ C3B3 CD 50 20                     CALL ZIFI_FENTRY
 111+ C3B6                              ; preserve result flags + DE/HL across Leave
 112+ C3B6 F5                           PUSH AF
 113+ C3B7 E5                           PUSH HL
 114+ C3B8 D5                           PUSH DE
 115+ C3B9 CD AF C3                     CALL ZiFi_Leave
 116+ C3BC D1                           POP  DE
 117+ C3BD E1                           POP  HL
 118+ C3BE F1                           POP  AF
 119+ C3BF C9                           RET
 120+ C3C0
 121+ C3C0              ; ZiFi_Load512 — read B 512-byte blocks from current file into (C:HL).
 122+ C3C0              ;   In : C=dest page, HL=offset (#0000..#3FFF slot-0 view), B=blocks
 123+ C3C0              ;   Out: CHL advanced; A=#0F if end-of-chain
 124+ C3C0              ZiFi_Load512:
 125+ C3C0 C3 9D C9                     JP   RawPak_ReadSectors
 126+ C3C3
 127+ C3C3              ; ZiFi_LoadNon — skip B sectors (seek forward).
 128+ C3C3              ;   In : B=sectors
 129+ C3C3              ZiFi_LoadNon:
 130+ C3C3 C3 93 C9                     JP   RawPak_SkipB
 131+ C3C6
 132+ C3C6              ; ZiFi_Seek0 — rewind current file to offset 0.
 133+ C3C6              ZiFi_Seek0:
 134+ C3C6 C3 85 C9                     JP   RawPak_Seek0
 135+ C3C9
 136+ C3C9              ; ZiFi_SetDir — chdir into directory found by previous FEntry.
 137+ C3C9              ZiFi_SetDir:
 138+ C3C9 CD AE C3                     CALL ZiFi_Enter
 139+ C3CC CD 5F 20                     CALL ZIFI_SETDIR
 140+ C3CF CD AF C3                     CALL ZiFi_Leave
 141+ C3D2 C9                           RET
 142+ C3D3
 143+ C3D3              ; ZiFi_SetRoot — chdir to /.
 144+ C3D3              ZiFi_SetRoot:
 145+ C3D3 CD AE C3                     CALL ZiFi_Enter
 146+ C3D6 CD 62 20                     CALL ZIFI_SETROOT
 147+ C3D9 CD AF C3                     CALL ZiFi_Leave
 148+ C3DC C9                           RET
 149+ C3DD
 150+ C3DD              ; ---------------------------------------------------------------------
 151+ C3DD              ; Filename strings for our package layout in WC: /Games/Zuma Deluxe VDAC2/ZUMALVL.PAK
 152+ C3DD              ; flag #10 = directory, #00 = file.
 153+ C3DD
 154+ C3DD 10           ZiFi_DirGames:   DEFB #10
 155+ C3DE 47 61 6D 65                   DEFB "Games", 0
 155+ C3E2 73 00
 156+ C3E4
 157+ C3E4 10           ZiFi_DirZuma:    DEFB #10
 158+ C3E5 5A 75 6D 61                   DEFB "Zuma Deluxe VDAC2", 0
 158+ C3E9 20 44 65 6C
 158+ C3ED 75 78 65 20
 158+ C3F1 56 44 41 43
 158+ C3F5 32 00
 159+ C3F7
 160+ C3F7 00           ZiFi_FileLvlPak: DEFB #00
 161+ C3F8 5A 55 4D 41                   DEFB "ZUMALVL.PAK", 0
 161+ C3FC 4C 56 4C 2E
 161+ C400 50 41 4B 00
 162+ C404
 163+ C404              ; (Diagnostic vars ZiFi_GpDbgStep / ZiFi_DbgGamesA / ... moved to
 164+ C404              ;  loader_resident.asm so an F12 dump — which sees slot 1 / Core, not this
 165+ C404              ;  overlay page — can read how far the load got. The overlay writes them while
 166+ C404              ;  slot 1 is mapped, so the writes still land.)
 167+ C404
 168+ C404              ; ---------------------------------------------------------------------
 169+ C404              ; Loader-level helpers.
 170+ C404              ;
 171+ C404              ; ZUMALVL.PAK layout:
 172+ C404              ;   sec 0       header  (magic ZLVP, version, count, sector_size)
 173+ C404              ;   sec 1       TOC[22] × 20 B   (bg/pal/track/title/preview off+size)
 174+ C404              ;   sec 2..N    data blob, per-level: bg → pal → track → title → preview
 175+ C404
 176+ C404              ZIFI_BUFFER_PAGE EQU #03               ; spgbld page reserved for ZiFi 512-B buffer
 177+ C404
 178+ C404              ; ---------------------------------------------------------------------
 179+ C404              ; RawPak_* — self-contained FAT32 reader over direct SD CMD18.
 180+ C404              ;
 181+ C404              ; This path intentionally bypasses the bundled WC CORE32 LOAD512 state. It
 182+ C404              ; supports both contiguous and fragmented files by following the FAT chain
 183+ C404              ; between every cluster. Current host image is superfloppy FAT32 with
 184+ C404              ; 512-byte sectors and spc=1; we validate that in RawPak_OpenRoot.
 185+ C404              ;
 186+ C404              ; Directory/file lookup matches by NAME, case-insensitive: it reconstructs the
 187+ C404              ; LONG name (LFN) when present, else the 8.3 short name, and compares to these
 188+ C404              ; targets. This is robust to whatever short alias the injector assigns (the
 189+ C404              ; observed bug was injector writing GAMES~1 while we searched "GAMES      ").
 190+ C404
 191+ C404              RAWPAK_NAME_PAK:
 192+ C404 5A 55 4D 41                  DEFB "ZUMALVL.PAK", 0
 192+ C408 4C 56 4C 2E
 192+ C40C 50 41 4B 00
 193+ C410              RAWPAK_NAME_AUDIO:
 194+ C410 5A 55 4D 41                  DEFB "ZUMAAUD.PAK", 0
 194+ C414 41 55 44 2E
 194+ C418 50 41 4B 00
 195+ C41C              RAWPAK_NAME_SOUND:
 196+ C41C 5A 55 4D 41                  DEFB "ZUMASND.PAK", 0
 196+ C420 53 4E 44 2E
 196+ C424 50 41 4B 00
 197+ C428              RAWPAK_NAME_MAIN:
 198+ C428 5A 55 4D 41                  DEFB "ZUMAMAIN.PAK", 0
 198+ C42C 4D 41 49 4E
 198+ C430 2E 50 41 4B
 198+ C434 00
 199+ C435              RAWPAK_NAME_BOOT:                               ; HOBETA WC loader в корне SD (для Quit)
 200+ C435 42 4F 4F 54                  DEFB "BOOT.$C", 0
 200+ C439 2E 24 43 00
 201+ C43D              RAWPAK_BOOT_SIZE EQU 31761
 202+ C43D
 203+ C43D              ; DBG instrumentation (read in F12 dump to bisect a failed open; addresses are
 204+ C43D              ; resident in loader_resident.asm — ZiFi_DbgGamesA #6432, GpDbgStep #642D):
 205+ C43D              ;   ZiFi_DbgGamesA = RawPak open granular step:
 206+ C43D              ;       #20 entry, #21 sector0 read OK, #22 BPB valid, #26 search start, #25 PAK found;
 207+ C43D              ;       #A1 sector0 CMD err, #A2 BPB invalid (bps!=512 / no FAT32 partition),
 208+ C43D              ;       #A3 spc=0, #A6 PAK (name+size) not found anywhere, #A7 run-table overflow.
 209+ C43D              ;   ZiFi_DbgGamesFound = directories visited during the recursive search.
 210+ C43D              RawPak_OpenRoot:
 211+ C43D 3E 20                        LD   A, #20
 212+ C43F 32 A4 6B                     LD   (ZiFi_DbgGamesA), A
 213+ C442 AF                           XOR  A
 214+ C443 32 A5 6B                     LD   (ZiFi_DbgGamesFound), A
 215+ C446                              ; Invalidate the FAT-sector cache (FatBufLba = #FFFFFFFF). The cache
 216+ C446                              ; in RawPak_FatNext skips re-reading a FAT sector already in FatBuf;
 217+ C446                              ; the FAT is read-only for us, so it stays valid for the whole session.
 218+ C446 21 FF FF                     LD   HL, #FFFF
 219+ C449 22 40 D0                     LD   (RawPak_FatBufLba + 0), HL
 220+ C44C 22 42 D0                     LD   (RawPak_FatBufLba + 2), HL
 221+ C44F                              ; --- Read sector 0 (boot sector OR MBR). LBA 0 is addressing-
 222+ C44F                              ; agnostic (arg 0 either way), so this read works before we know
 223+ C44F                              ; block vs byte. Then mirror ChkDsk: scan the MBR partition table;
 224+ C44F                              ; a real card is MBR-partitioned + SDHC (block-addressed), Unreal is
 225+ C44F                              ; a superfloppy (no table) + byte-addressed.
 226+ C44F 21 00 00                     LD   HL, 0
 227+ C452 11 00 00                     LD   DE, 0
 228+ C455 CD 01 CB                     CALL RawPak_ReadSectorBuffer
 229+ C458 DA DB C5                     JP   C, .ErrBpbRead
 230+ C45B 3E 21                        LD   A, #21
 231+ C45D 32 A4 6B                     LD   (ZiFi_DbgGamesA), A
 232+ C460 AF                           XOR  A                          ; part_lba = 0 (superfloppy: sector 0 is the BPB)
 233+ C461 32 24 CE                     LD   (RawPak_PartLba + 0), A
 234+ C464 32 25 CE                     LD   (RawPak_PartLba + 1), A
 235+ C467 32 26 CE                     LD   (RawPak_PartLba + 2), A
 236+ C46A 32 27 CE                     LD   (RawPak_PartLba + 3), A
 237+ C46D                              ; Is sector 0 itself a FAT32 BPB (bytes/sector == 512)? Then this is
 238+ C46D                              ; a superfloppy (Unreal) -> use sector 0 as BPB, byte addressing.
 239+ C46D                              ; Otherwise it is an MBR -> scan the partition table. (Checking the
 240+ C46D                              ; BPB first avoids false-matching boot-code bytes at offset 446.)
 241+ C46D DD 21 00 80                  LD   IX, #8000
 242+ C471 DD 7E 0B                     LD   A, (IX + 11)
 243+ C474 B7                           OR   A
 244+ C475 20 07                        JR   NZ, .tryMbr
 245+ C477 DD 7E 0C                     LD   A, (IX + 12)
 246+ C47A FE 02                        CP   2
 247+ C47C 28 3E                        JR   Z, .bpbReady               ; sector 0 is a 512-B/sector BPB -> superfloppy
 248+ C47E DD 21 BE 81  .tryMbr:       LD   IX, #8000 + 446            ; MBR partition table: 4 entries x 16 B
 249+ C482 06 04                        LD   B, 4
 250+ C484 DD 7E 04     .mbrScan:      LD   A, (IX + 4)                 ; partition type
 251+ C487 FE 0B                        CP   #0B                         ; FAT32 (CHS)
 252+ C489 28 0E                        JR   Z, .havePart
 253+ C48B FE 0C                        CP   #0C                         ; FAT32 (LBA)
 254+ C48D 28 0A                        JR   Z, .havePart
 255+ C48F 11 10 00                     LD   DE, 16
 256+ C492 DD 19                        ADD  IX, DE
 257+ C494 10 EE                        DJNZ .mbrScan
 258+ C496 C3 DF C5                     JP   .ErrBps                    ; not a BPB and no FAT32 partition entry
 259+ C499 DD 7E 08     .havePart:     LD   A, (IX + 8)
 259+ C49C 32 24 CE       LD (RawPak_PartLba + 0), A   ; partition start LBA
 260+ C49F DD 7E 09                     LD   A, (IX + 9)
 260+ C4A2 32 25 CE       LD (RawPak_PartLba + 1), A
 261+ C4A5 DD 7E 0A                     LD   A, (IX + 10)
 261+ C4A8 32 26 CE       LD (RawPak_PartLba + 2), A
 262+ C4AB DD 7E 0B                     LD   A, (IX + 11)
 262+ C4AE 32 27 CE       LD (RawPak_PartLba + 3), A
 263+ C4B1                              ; Найден MBR-раздел => это реальная SDHC-карта => блочная адресация
 264+ C4B1                              ; АВТОРИТЕТНА. НЕ откатываемся на байтовую: байтовый режим на SDHC шлёт
 265+ C4B1                              ; неверные адреса блоков и может вывести карту из строя (восстановление
 266+ C4B1                              ; только физическим переткиванием). Откат на byte допустим лишь для
 267+ C4B1                              ; настоящего superfloppy (там ветка .bpbReady достигается напрямую с
 268+ C4B1                              ; sd_blkt=0). Раньше тут был откат на byte — он и кирпичил 32 ГБ карту.
 269+ C4B1 3E 01                        LD   A, 1
 270+ C4B3 32 95 C3                     LD   (sd_blkt), A
 271+ C4B6 CD 9F CB                     CALL RawPak_ReadPartBpb
 272+ C4B9 DA DF C5                     JP   C, .ErrBps
 273+ C4BC DD 21 00 80  .bpbReady:     LD   IX, #8000
 274+ C4C0                              ; Require 512-byte sectors and a non-zero sectors/cluster value.
 275+ C4C0 DD 7E 0B                     LD   A, (IX + 11)
 276+ C4C3 B7                           OR   A
 277+ C4C4 C2 DF C5                     JP   NZ, .ErrBps
 278+ C4C7 DD 7E 0C                     LD   A, (IX + 12)
 279+ C4CA FE 02                        CP   2
 280+ C4CC C2 DF C5                     JP   NZ, .ErrBps
 281+ C4CF DD 7E 0D                     LD   A, (IX + 13)
 282+ C4D2 B7                           OR   A
 283+ C4D3 CA E3 C5                     JP   Z, .ErrSpc
 284+ C4D6 32 98 CD                     LD   (RawPak_Spc), A
 285+ C4D9 3E 22                        LD   A, #22
 286+ C4DB 32 A4 6B                     LD   (ZiFi_DbgGamesA), A
 287+ C4DE                              ; fatstart = part_lba + reserved sectors (16-bit in BPB)
 288+ C4DE 21 24 CE                     LD   HL, RawPak_PartLba
 289+ C4E1 11 28 CE                     LD   DE, RawPak_FatStart
 290+ C4E4 CD 74 CD                     CALL RawPak_Copy32
 291+ C4E7 DD 7E 0E                     LD   A, (IX + 14)
 291+ C4EA 32 3C CE       LD (RawPak_Tmp + 0), A
 292+ C4ED DD 7E 0F                     LD   A, (IX + 15)
 292+ C4F0 32 3D CE       LD (RawPak_Tmp + 1), A
 293+ C4F3 AF                           XOR  A
 293+ C4F4 32 3E CE       LD (RawPak_Tmp + 2), A
 293+ C4F7 32 3F CE       LD (RawPak_Tmp + 3), A
 294+ C4FA 21 3C CE                     LD   HL, RawPak_Tmp
 295+ C4FD 11 28 CE                     LD   DE, RawPak_FatStart
 296+ C500 CD 7C CD                     CALL RawPak_Add32
 297+ C503                              ; datastart = fatstart + numFATs * FATSz32
 298+ C503 21 28 CE                     LD   HL, RawPak_FatStart
 299+ C506 11 2C CE                     LD   DE, RawPak_DataStart
 300+ C509 CD 74 CD                     CALL RawPak_Copy32
 301+ C50C DD 7E 10                     LD   A, (IX + 16)
 302+ C50F 47                           LD   B, A
 303+ C510 C5           .fatLoop:      PUSH BC
 304+ C511 DD 7E 24                     LD   A, (IX + 36)
 304+ C514 32 3C CE       LD (RawPak_Tmp + 0), A
 305+ C517 DD 7E 25                     LD   A, (IX + 37)
 305+ C51A 32 3D CE       LD (RawPak_Tmp + 1), A
 306+ C51D DD 7E 26                     LD   A, (IX + 38)
 306+ C520 32 3E CE       LD (RawPak_Tmp + 2), A
 307+ C523 DD 7E 27                     LD   A, (IX + 39)
 307+ C526 32 3F CE       LD (RawPak_Tmp + 3), A
 308+ C529 21 3C CE                     LD   HL, RawPak_Tmp
 309+ C52C 11 2C CE                     LD   DE, RawPak_DataStart
 310+ C52F CD 7C CD                     CALL RawPak_Add32
 311+ C532 C1                           POP  BC
 312+ C533 10 DB                        DJNZ .fatLoop
 313+ C535                              ; root cluster
 314+ C535 DD 7E 2C                     LD   A, (IX + 44)
 314+ C538 32 30 CE       LD (RawPak_RootClus + 0), A
 315+ C53B DD 7E 2D                     LD   A, (IX + 45)
 315+ C53E 32 31 CE       LD (RawPak_RootClus + 1), A
 316+ C541 DD 7E 2E                     LD   A, (IX + 46)
 316+ C544 32 32 CE       LD (RawPak_RootClus + 2), A
 317+ C547 DD 7E 2F                     LD   A, (IX + 47)
 317+ C54A 32 33 CE       LD (RawPak_RootClus + 3), A
 318+ C54D                              ; --- граница тома для защиты SD: sd_lba_max = PartLba + BPB_TotSec32.
 319+ C54D                              ; Любой LBA >= границы отбивается в sd_read_sector (CF=1), не уходя в
 320+ C54D                              ; карту как CMD17. 0 = выключено (если TotSec32 почему-то нулевой).
 321+ C54D AF                           XOR  A
 322+ C54E 32 96 C3                     LD   (sd_lba_max + 0), A
 323+ C551 32 97 C3                     LD   (sd_lba_max + 1), A
 324+ C554 32 98 C3                     LD   (sd_lba_max + 2), A
 325+ C557 32 99 C3                     LD   (sd_lba_max + 3), A
 326+ C55A DD 7E 20                     LD   A, (IX + 32)
 326+ C55D 32 3C CE       LD (RawPak_Tmp + 0), A
 326+ C560 4F             LD C, A
 327+ C561 DD 7E 21                     LD   A, (IX + 33)
 327+ C564 32 3D CE       LD (RawPak_Tmp + 1), A
 327+ C567 B1             OR C
 327+ C568 4F             LD C, A
 328+ C569 DD 7E 22                     LD   A, (IX + 34)
 328+ C56C 32 3E CE       LD (RawPak_Tmp + 2), A
 328+ C56F B1             OR C
 328+ C570 4F             LD C, A
 329+ C571 DD 7E 23                     LD   A, (IX + 35)
 329+ C574 32 3F CE       LD (RawPak_Tmp + 3), A
 329+ C577 B1             OR C
 330+ C578 28 12                        JR   Z, .noVolGuard                     ; TotSec32==0 -> защиту не включаем
 331+ C57A 21 24 CE                     LD   HL, RawPak_PartLba
 332+ C57D 11 96 C3                     LD   DE, sd_lba_max
 333+ C580 CD 74 CD                     CALL RawPak_Copy32                      ; sd_lba_max = PartLba
 334+ C583 21 3C CE                     LD   HL, RawPak_Tmp
 335+ C586 11 96 C3                     LD   DE, sd_lba_max
 336+ C589 CD 7C CD                     CALL RawPak_Add32                       ; sd_lba_max += TotSec32
 337+ C58C              .noVolGuard:
 338+ C58C                              ; --- locate ZUMALVL.PAK. Fast path: reuse WC's active-panel
 339+ C58C                              ; path from page #F7, then fall back to a whole-card DFS.
 340+ C58C 3E 26                        LD   A, #26
 341+ C58E 32 A4 6B                     LD   (ZiFi_DbgGamesA), A
 342+ C591 3A CF D4                     LD   A, (RawPak_CachedValid)   ; reuse the location found earlier this session
 343+ C594 B7                           OR   A
 344+ C595 28 0B                        JR   Z, .search
 345+ C597 21 D0 D4                     LD   HL, RawPak_CachedPakClus
 346+ C59A 11 34 CE                     LD   DE, RawPak_FileStartClus
 347+ C59D CD 74 CD                     CALL RawPak_Copy32
 348+ C5A0 18 25                        JR   .haveFile
 349+ C5A2 CD E8 C6     .search:       CALL RawPak_TryWcPath
 350+ C5A5 38 0F                        JR   C, .cacheFound
 351+ C5A7                              IF RAWPAK_WC_PATH_ONLY
 352+ C5A7 ~                            JP   .ErrPak
 353+ C5A7                              ENDIF
 354+ C5A7 21 30 CE                     LD   HL, RawPak_RootClus
 355+ C5AA 11 38 CE                     LD   DE, RawPak_CurClus
 356+ C5AD CD 74 CD                     CALL RawPak_Copy32
 357+ C5B0 CD EE C5                     CALL RawPak_FindPakRecursive   ; DFS whole tree -> RawPak_FileStartClus
 358+ C5B3 D2 E7 C5                     JP   NC, .ErrPak
 359+ C5B6              .cacheFound:
 360+ C5B6 21 34 CE                     LD   HL, RawPak_FileStartClus  ; cache for subsequent opens this session
 361+ C5B9 11 D0 D4                     LD   DE, RawPak_CachedPakClus
 362+ C5BC CD 74 CD                     CALL RawPak_Copy32
 363+ C5BF 3E 01                        LD   A, 1
 364+ C5C1 32 CF D4                     LD   (RawPak_CachedValid), A
 365+ C5C4 32 17 6D                     LD   (LevelsMapLoaded), A      ; resident flag: skip "LOADING LEVELS..." next time
 366+ C5C7 3E 25        .haveFile:     LD   A, #25
 367+ C5C9 32 A4 6B                     LD   (ZiFi_DbgGamesA), A
 368+ C5CC CD 85 C9                     CALL RawPak_Seek0
 369+ C5CF CD C6 CB                     CALL RawPak_BuildRunTable      ; build extent (run) table — handles fragmentation
 370+ C5D2 D2 D7 C5                     JP   NC, .ErrRuns              ; table overflow / chain error -> fallback
 371+ C5D5 37                           SCF
 372+ C5D6 C9                           RET
 373+ C5D7 3E A7        .ErrRuns:      LD   A, #A7
 374+ C5D9 18 0E                        JR   .ErrSet
 375+ C5DB 3E A1        .ErrBpbRead:   LD   A, #A1
 376+ C5DD 18 0A                        JR   .ErrSet
 377+ C5DF 3E A2        .ErrBps:       LD   A, #A2
 378+ C5E1 18 06                        JR   .ErrSet
 379+ C5E3 3E A3        .ErrSpc:       LD   A, #A3
 380+ C5E5 18 02                        JR   .ErrSet
 381+ C5E7 3E A6        .ErrPak:       LD   A, #A6                     ; ZUMALVL.PAK (name+size) not found anywhere
 382+ C5E9 32 A4 6B     .ErrSet:       LD   (ZiFi_DbgGamesA), A
 383+ C5EC B7           .Err:          OR   A
 384+ C5ED C9                           RET
 385+ C5EE
 386+ C5EE              ; (RawPak_FindInCurrentDir and the fixed /Games/Zuma Deluxe VDAC2/ path were
 387+ C5EE              ;  removed — the loader now finds ZUMALVL.PAK only via RawPak_FindPakRecursive,
 388+ C5EE              ;  by name + size in any folder. Single code path.)
 389+ C5EE
 390+ C5EE              ; ============================================================================
 391+ C5EE              ; RawPak_FindPakRecursive — depth-first search of the WHOLE FAT32 tree from the
 392+ C5EE              ; root for a file named "ZUMALVL.PAK" whose size == EXPECTED_PAK_SIZE. Lets the
 393+ C5EE              ; pack live in any folder (a real card may not use /Games/Zuma Deluxe VDAC2/).
 394+ C5EE              ; Out: CF=1 found (RawPak_FileStartClus set); CF=0 not found / SD error.
 395+ C5EE              ; Reads EVERY sector of each directory cluster (via AdvanceOne), so it is correct
 396+ C5EE              ; for spc>1 cards (the old per-cluster-first-sector scan missed entries at spc=64).
 397+ C5EE              ; Result is cached by the caller, so the (potentially slow) walk runs once/session.
 398+ C5EE              ; ============================================================================
 399+ C5EE              RawPak_FindPakRecursive:
 400+ C5EE 21 04 C4                     LD   HL, RAWPAK_NAME_PAK        ; target = "ZUMALVL.PAK" uppercased
 401+ C5F1 11 9E CD                     LD   DE, RawPak_TargetName
 402+ C5F4 7E           .cpyt:         LD   A, (HL)
 403+ C5F5 CD D0 C8                     CALL RawPak_Upcase
 404+ C5F8 12                           LD   (DE), A
 405+ C5F9 23                           INC  HL
 406+ C5FA 13                           INC  DE
 407+ C5FB B7                           OR   A
 408+ C5FC 20 F6                        JR   NZ, .cpyt
 409+ C5FE 3E 01                        LD   A, 1
 410+ C600 32 1E CE                     LD   (RawPak_CheckSize), A      ; PAK: совпадение по имени И точному размеру
 411+ C603              ; RawPak_FindByName — DFS дерева FAT по RawPak_TargetName (+опц. размер). Вызывающий
 412+ C603              ; заранее ставит RawPak_TargetName (upcase, zero-term) и RawPak_CheckSize (0=только имя,
 413+ C603              ; 1=имя+EXPECTED_PAK_SIZE). Out: CF=1 найдено (RawPak_FileStartClus + RawPak_FoundSize),
 414+ C603              ; CF=0 нет/ошибка SD.
 415+ C603              RawPak_FindByName:
 416+ C603 AF                           XOR  A
 417+ C604 32 4E D3                     LD   (RawPak_DirStackCnt), A
 418+ C607 32 A5 6B                     LD   (ZiFi_DbgGamesFound), A
 419+ C60A 21 30 CE                     LD   HL, RawPak_RootClus        ; seed the DFS stack with the root dir
 420+ C60D CD 92 C8                     CALL RawPak_DirStackPush
 421+ C610 CD B1 C8     .popLoop:      CALL RawPak_DirStackPop         ; CurClus = next dir; CF=1 if stack empty
 422+ C613 DA E6 C6                     JP   C, .notFound
 423+ C616 3A A5 6B                     LD   A, (ZiFi_DbgGamesFound)    ; diag: count dirs visited
 424+ C619 3C                           INC  A
 425+ C61A 32 A5 6B                     LD   (ZiFi_DbgGamesFound), A
 426+ C61D AF                           XOR  A
 427+ C61E 32 99 CD                     LD   (RawPak_CurSecInClus), A
 428+ C621 32 23 CE                     LD   (RawPak_HaveLfn), A
 429+ C624 CD 9D CA     .sec:          CALL RawPak_CurrentLbaRegs
 430+ C627 CD 01 CB                     CALL RawPak_ReadSectorBuffer    ; dir sector -> slot 2 #8000, IX=#8000
 431+ C62A DA E6 C6                     JP   C, .notFound               ; SD error -> abort the search
 432+ C62D DD 21 00 80                  LD   IX, #8000
 433+ C631 DD 7E 00     .entry:        LD   A, (IX + 0)
 434+ C634 B7                           OR   A
 435+ C635 CA DE C6                     JP   Z, .dirDone                ; 0x00 = end of this directory
 436+ C638 FE E5                        CP   #E5
 437+ C63A CA C3 C6                     JP   Z, .skip                   ; deleted entry (JP: цели сдвинулись > ±128)
 438+ C63D DD 7E 0B                     LD   A, (IX + 11)
 439+ C640 FE 0F                        CP   #0F
 440+ C642 CA E1 C6                     JP   Z, .lfnFrag                ; LFN fragment -> accumulate
 441+ C645 DD 7E 0B                     LD   A, (IX + 11)
 442+ C648 E6 08                        AND  #08
 443+ C64A 20 77                        JR   NZ, .skip                  ; volume label -> skip
 444+ C64C DD 7E 0B                     LD   A, (IX + 11)
 445+ C64F E6 10                        AND  #10
 446+ C651 20 4B                        JR   NZ, .isDir                 ; subdirectory
 447+ C653                              ; --- regular file: match name, then exact size ---
 448+ C653 3A 23 CE                     LD   A, (RawPak_HaveLfn)
 449+ C656 B7                           OR   A
 450+ C657 20 03                        JR   NZ, .haveName
 451+ C659 CD D9 C8                     CALL RawPak_Build83
 452+ C65C CD 09 C9     .haveName:     CALL RawPak_NameMatch           ; Z if name == RawPak_TargetName
 453+ C65F 20 62                        JR   NZ, .skip
 454+ C661 3A 1E CE                     LD   A, (RawPak_CheckSize)
 455+ C664 B7                           OR   A
 456+ C665 28 05                        JR   Z, .sizeOk                 ; CheckSize=0 → совпадение только по имени
 457+ C667 CD 7A C8                     CALL RawPak_CheckPakSize        ; Z if file size == EXPECTED_PAK_SIZE
 458+ C66A 20 57                        JR   NZ, .skip
 459+ C66C DD 7E 1A     .sizeOk:       LD   A, (IX + 26)
 459+ C66F 32 34 CE       LD (RawPak_FileStartClus + 0), A
 460+ C672 DD 7E 1B                     LD   A, (IX + 27)
 460+ C675 32 35 CE       LD (RawPak_FileStartClus + 1), A
 461+ C678 DD 7E 14                     LD   A, (IX + 20)
 461+ C67B 32 36 CE       LD (RawPak_FileStartClus + 2), A
 462+ C67E DD 7E 15                     LD   A, (IX + 21)
 462+ C681 32 37 CE       LD (RawPak_FileStartClus + 3), A
 463+ C684 DD 7E 1C                     LD   A, (IX + 28)
 463+ C687 32 1F CE       LD (RawPak_FoundSize + 0), A    ; размер файла (байт, LE)
