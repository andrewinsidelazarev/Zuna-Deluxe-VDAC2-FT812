 189+ 6BAC              ; ----------------------------------------------------------------------------
 190+ 6BAC              ; Overlay trampolines (resident). Each maps LOADER_OVL_PAGE into slot 3, calls
 191+ 6BAC              ; the real OVL_* routine in the overlay, then restores PAGE3=#04. Done under DI
 192+ 6BAC              ; so an interrupt never sees slot 3 holding the loader page. CF (load result) is
 193+ 6BAC              ; preserved across SetPage3 (it only touches HL) and the final EI.
 194+ 6BAC              ; ----------------------------------------------------------------------------
 195+ 6BAC              LoadGameplayLevelSpecificFromPack:
 196+ 6BAC F3                           DI
 197+ 6BAD                              SetPage3 LOADER_OVL_PAGE
 197+ 6BAD             >                ifdef MAPPING_REGISTERS
 197+ 6BAD 21 13 04    >                LD HL, FMADDR_REGS + HIGH PAGE3
 197+ 6BB0 36 40       >                LD (HL), LOADER_OVL_PAGE & 0xFF
 197+ 6BB2             >                else
 197+ 6BB2 ~           >                LD A, Page? & 0xFF
 197+ 6BB2 ~           >                LD (MemoryPages + 3), A
 197+ 6BB2 ~           >                LD BC, PAGE3
 197+ 6BB2 ~           >                OUT (C), A
 197+ 6BB2             >                endif
 198+ 6BB2 CD AE DA                     CALL OVL_LoadGameplayLevelSpecificFromPack
 199+ 6BB5 F3                           DI                                     ; overlay (ZiFi_Done) re-enabled IRQs; re-disable to restore slot 3 atomically
 200+ 6BB6                              SetPage3 #04
 200+ 6BB6             >                ifdef MAPPING_REGISTERS
 200+ 6BB6 21 13 04    >                LD HL, FMADDR_REGS + HIGH PAGE3
 200+ 6BB9 36 04       >                LD (HL), #04 & 0xFF
 200+ 6BBB             >                else
 200+ 6BBB ~           >                LD A, Page? & 0xFF
 200+ 6BBB ~           >                LD (MemoryPages + 3), A
 200+ 6BBB ~           >                LD BC, PAGE3
 200+ 6BBB ~           >                OUT (C), A
 200+ 6BBB             >                endif
 201+ 6BBB FB                           EI
 202+ 6BBC C9                           RET
 203+ 6BBD
 204+ 6BBD              ; Called only from level-select (LevelSelect.asm + LevelSelectApplyLevelClick),
 205+ 6BBD              ; which runs on the UI overlay (#41) — so restore #41, not #04, else the scene
 206+ 6BBD              ; code vanishes from slot 3 on return. (The gameplay trampoline above is only
 207+ 6BBD              ; reached from gameplay, so it correctly restores #04.)
 208+ 6BBD              LoadLevelSelectPreviewAssets:
 209+ 6BBD F3                           DI
 210+ 6BBE                              SetPage3 LOADER_OVL_PAGE
 210+ 6BBE             >                ifdef MAPPING_REGISTERS
 210+ 6BBE 21 13 04    >                LD HL, FMADDR_REGS + HIGH PAGE3
 210+ 6BC1 36 40       >                LD (HL), LOADER_OVL_PAGE & 0xFF
 210+ 6BC3             >                else
 210+ 6BC3 ~           >                LD A, Page? & 0xFF
 210+ 6BC3 ~           >                LD (MemoryPages + 3), A
 210+ 6BC3 ~           >                LD BC, PAGE3
 210+ 6BC3 ~           >                OUT (C), A
 210+ 6BC3             >                endif
 211+ 6BC3 CD 52 DC                     CALL OVL_LoadLevelSelectPreviewAssets
 212+ 6BC6 F3                           DI
 213+ 6BC7                              SetPage3 UI_OVL_PAGE                    ; restore UI overlay (level-select), not #04
 213+ 6BC7             >                ifdef MAPPING_REGISTERS
 213+ 6BC7 21 13 04    >                LD HL, FMADDR_REGS + HIGH PAGE3
 213+ 6BCA 36 41       >                LD (HL), UI_OVL_PAGE & 0xFF
 213+ 6BCC             >                else
 213+ 6BCC ~           >                LD A, Page? & 0xFF
 213+ 6BCC ~           >                LD (MemoryPages + 3), A
 213+ 6BCC ~           >                LD BC, PAGE3
 213+ 6BCC ~           >                OUT (C), A
 213+ 6BCC             >                endif
 214+ 6BCC FB                           EI
 215+ 6BCD C9                           RET
