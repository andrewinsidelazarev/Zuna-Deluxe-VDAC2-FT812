1641  303E              ; ============================================================================
1642  303E              ; DrawString — glyph-blit zero-terminated string в TEKUЩЕМ шрифте.
1643  303E              ;   In:  HL = string ptr, BC = start x*16, DE = y*16. Font state из FontPtr*.
1644  303E              ;   Out: (DrawStr_CurX) = end x*16
1645  303E              ;   Clobbers all.
1646  303E              ; ============================================================================
1647  303E              DrawString:
1648  303E 22 EC 30                     LD   (DrawStr_Ptr), HL
1649  3041 ED 43 EE 30                  LD   (DrawStr_CurX), BC
1650  3045 ED 53 F0 30                  LD   (DrawStr_Y), DE
1651  3049 2A EC 30     .ds_loop:       LD   HL, (DrawStr_Ptr)
1652  304C 7E                           LD   A, (HL)
1653  304D 23                           INC  HL
1654  304E 22 EC 30                     LD   (DrawStr_Ptr), HL
1655  3051 B7                           OR   A
1656  3052 C8                           RET  Z                                  ; конец строки
1657  3053 FE 80                        CP   128
1658  3055 30 F2                        JR   NC, .ds_loop                       ; non-ASCII skip
1659  3057
1660  3057                              ; --- Lookup glyph metadata: BC = char index (0..127) ---
1661  3057 4F                           LD   C, A
1662  3058 06 00                        LD   B, 0
1663  305A
1664  305A                              ; advance := (FontPtrAdvance)[A]
1665  305A 2A 38 30                     LD   HL, (FontPtrAdvance)
1666  305D 09                           ADD  HL, BC
1667  305E 7E                           LD   A, (HL)
1668  305F B7                           OR   A
1669  3060 28 E7                        JR   Z, .ds_loop                        ; advance=0 → неизвестный char, skip
1670  3062 32 F2 30                     LD   (DrawStr_Adv), A
1671  3065
1672  3065                              ; glyph_w := (FontPtrGlyphW)[A]
1673  3065 2A 36 30                     LD   HL, (FontPtrGlyphW)
1674  3068 09                           ADD  HL, BC
1675  3069 7E                           LD   A, (HL)
1676  306A B7                           OR   A
1677  306B 28 62                        JR   Z, .ds_advance_only                ; w=0 (space) → только advance
1678  306D
1679  306D                              ; --- Emit BITMAP_SIZE (NEAREST/BORDER, w*scale, FontHeight*scale) ---
1680  306D 26 00                        LD   H, 0
1681  306F 6F                           LD   L, A                               ; HL = w
1682  3070 3A F3 30                     LD   A, (DrawStr_Scale)
1683  3073 FE 02                        CP   2
1684  3075 38 01                        JR   C, .ds_sz_w1
1685  3077 29                           ADD  HL, HL                             ; w *= 2 (scale=2)
1686  3078 29           .ds_sz_w1:      ADD  HL, HL
1686  3079 29             ADD HL, HL
1686  307A 29             ADD HL, HL   ; <<3
1687  307B 29                           ADD  HL, HL
1687  307C 29             ADD HL, HL
1687  307D 29             ADD HL, HL   ; <<6
1688  307E 29                           ADD  HL, HL
1688  307F 29             ADD HL, HL
1688  3080 29             ADD HL, HL   ; <<9 (w << 9)
1689  3081 3A 3D 30                     LD   A, (FontHeight)
1690  3084 47                           LD   B, A
1691  3085 3A F3 30                     LD   A, (DrawStr_Scale)
1692  3088 FE 02                        CP   2
1693  308A 38 02                        JR   C, .ds_sz_h1
1694  308C CB 20                        SLA  B                                  ; FontHeight *= 2 (scale=2)
1695  308E 58           .ds_sz_h1:      LD   E, B
1695  308F 16 00          LD D, 0
1696  3091 19                           ADD  HL, DE                             ; HL = (w<<9)|H
1697  3092 06 08                        LD   B, #08
1698  3094 0E 00                        LD   C, 0
1699  3096 54                           LD   D, H
1699  3097 5D             LD E, L
1700  3098 CD EB 13                     CALL FT.Coprocessor.Command_BCDE
1701  309B
1702  309B                              ; --- Emit BITMAP_SOURCE = atlas_base + glyph_x * 2 ---
1703  309B 2A EC 30                     LD   HL, (DrawStr_Ptr)
1704  309E 2B                           DEC  HL                                  ; back to current char
1705  309F 7E                           LD   A, (HL)
1706  30A0 4F                           LD   C, A
1706  30A1 06 00          LD B, 0
1707  30A3 2A 34 30                     LD   HL, (FontPtrGlyphX)
1708  30A6 09                           ADD  HL, BC
1708  30A7 09             ADD HL, BC                ; *2 (word table)
1709  30A8 5E                           LD   E, (HL)
1709  30A9 23             INC HL
1710  30AA 56                           LD   D, (HL)                             ; DE = glyph_x (pixels)
1711  30AB EB                           EX   DE, HL
1712  30AC 29                           ADD  HL, HL                              ; HL = glyph_x_bytes
1713  30AD ED 5B 3A 30                  LD   DE, (FontAtlasLo)
1714  30B1 19                           ADD  HL, DE                              ; HL = low 16 of full addr
1715  30B2 3A 3C 30                     LD   A, (FontAtlasHi)
1716  30B5 30 01                        JR   NC, .ds_no_carry
1717  30B7 3C                           INC  A
1718  30B8              .ds_no_carry:
1719  30B8 06 01                        LD   B, #01
1720  30BA 4F                           LD   C, A
1721  30BB 54                           LD   D, H
1721  30BC 5D             LD E, L
1722  30BD CD EB 13                     CALL FT.Coprocessor.Command_BCDE
1723  30C0
1724  30C0                              ; --- Emit Cell 0 + Vertex2f(CurX, Y) ---
1725  30C0 AF                           XOR  A
1725  30C1 CD CA 13       CALL FT.Coprocessor.Cell
1726  30C4 ED 4B EE 30                  LD   BC, (DrawStr_CurX)
1727  30C8 ED 5B F0 30                  LD   DE, (DrawStr_Y)
1728  30CC CD 7B 13                     CALL FT.Coprocessor.Vertex2f
1729  30CF
1730  30CF              .ds_advance_only:
1731  30CF                              ; CurX += advance * scale * 16
1732  30CF 3A F2 30                     LD   A, (DrawStr_Adv)
1733  30D2 26 00                        LD   H, 0
1733  30D4 6F             LD L, A
1734  30D5 3A F3 30                     LD   A, (DrawStr_Scale)
1735  30D8 FE 02                        CP   2
1736  30DA 38 01                        JR   C, .ds_adv1
1737  30DC 29                           ADD  HL, HL                             ; advance *= 2 (scale=2)
1738  30DD 29           .ds_adv1:       ADD  HL, HL
1738  30DE 29             ADD HL, HL
