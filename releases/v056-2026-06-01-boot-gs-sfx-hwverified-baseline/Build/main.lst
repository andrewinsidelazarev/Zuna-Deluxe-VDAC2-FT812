1293+ F683              ; ----------------------------------------------------------------------------
1294+ F683              ; FT812 frame profiler (diagnostic overlay).
1295+ F683              ; B/W/I are REG_CLOCK delta / 1024. At 60 MHz FT812 clock:
1296+ F683              ;   74 Hz frame ~= 792, 57 Hz frame ~= 1028.
1297+ F683              ; If B+W approaches frame budget and I is near zero, Z80/SPI path misses vblank.
1298+ F683              ; ----------------------------------------------------------------------------
1299+ F683              ZL_ProfileReadClock:
1300+ F683                              FT_RD_REG32 FT_REG_CLOCK                ; BCDE = 32-bit little-endian value
1300+ F683 3E 30       >                LD A, (FT_RAM_REG >> 16) & 0xFF
1300+ F685 11 08 20    >                LD DE, (FT_REG_CLOCK) & 0xFFFF
1300+ F688 CD D9 11    >                CALL FT.Read32
1301+ F68B 60                           LD   H, B
1302+ F68C 69                           LD   L, C
1303+ F68D C9                           RET                                     ; HLDE = clock
1304+ F68E
1305+ F68E              ; In: HLDE=end clock, IXBC=start clock. Out: HL=(delta >> 10), DE=end lo, IX=end hi.
1306+ F68E              ZL_ProfileDeltaK:
1307+ F68E ED 53 57 F3                  LD   (ZL_ProfileDeltaEndLo), DE
1308+ F692 22 59 F3                     LD   (ZL_ProfileDeltaEndHi), HL
1309+ F695 EB                           EX   DE, HL                             ; HL=end low, DE=end high
1310+ F696 A7                           AND  A
1311+ F697 ED 42                        SBC  HL, BC                             ; HL=delta low
1312+ F699 EB                           EX   DE, HL                             ; DE=delta low, HL=end high
1313+ F69A DD E5                        PUSH IX
1314+ F69C C1                           POP  BC                                 ; BC=start high
1315+ F69D ED 42                        SBC  HL, BC                             ; HL=delta high
1316+ F69F                              ; Convert 32-bit delta HL:DE to 16-bit delta/1024.
1317+ F69F                              ; result bits: low=(D>>2)|(L<<6), high=(L>>2)|((H&3)<<6)
