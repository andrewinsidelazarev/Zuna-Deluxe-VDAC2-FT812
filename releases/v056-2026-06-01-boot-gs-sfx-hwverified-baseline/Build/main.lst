1165+ F2EF              ; ----------------------------------------------------------------------------
1166+ F2EF              ; ZL_SmoothMouse — exponential low-pass filter (alpha = 1/4, восстановлено
1167+ F2EF              ; 2026-05-17 после жалобы на «желейный» прицел):
1168+ F2EF              ;   new = old + (raw - old) / 4 = old*3/4 + raw/4
1169+ F2EF              ; Latency ~3-4 кадра (~70 ms @57Hz). 1-px jitter Hyper-V подавляется т.к.
1170+ F2EF              ; ±1/4 в integer = 0 → Smooth не дрожит при идле raw=±1 px.
1171+ F2EF              ; ----------------------------------------------------------------------------
1172+ F2EF              ZL_SmoothMouse: ; --- X axis ---
1173+ F2EF 2A 5E 75                     LD   HL, (ZL_SmoothX)                 ; HL = old
1174+ F2F2 54                           LD   D, H
1174+ F2F3 5D             LD E, L                   ; DE = old
1175+ F2F4 ED 4B 39 16                  LD   BC, (Input.Mouse.PositionX)
1176+ F2F8 A7                           AND  A
1177+ F2F9 ED 42                        SBC  HL, BC                           ; HL = old - raw (signed)
1178+ F2FB CB 2C                        SRA  H
1178+ F2FD CB 1D          RR L
1179+ F2FF CB 2C                        SRA  H
1179+ F301 CB 1D          RR L                         ; HL = (old-raw)/4 signed
1180+ F303 EB                           EX   DE, HL                           ; HL = old, DE = (old-raw)/4
1181+ F304 A7                           AND  A
1182+ F305 ED 52                        SBC  HL, DE                           ; HL = old - (old-raw)/4 = new
1183+ F307 22 5E 75                     LD   (ZL_SmoothX), HL
1184+ F30A
1185+ F30A                              ; --- Y axis ---
1186+ F30A 2A 60 75                     LD   HL, (ZL_SmoothY)
1187+ F30D 54                           LD   D, H
1187+ F30E 5D             LD E, L
1188+ F30F ED 4B 3B 16                  LD   BC, (Input.Mouse.PositionY)
1189+ F313 A7                           AND  A
1190+ F314 ED 42                        SBC  HL, BC
1191+ F316 CB 2C                        SRA  H
1191+ F318 CB 1D          RR L
1192+ F31A CB 2C                        SRA  H
1192+ F31C CB 1D          RR L
1193+ F31E EB                           EX   DE, HL
1194+ F31F A7                           AND  A
1195+ F320 ED 52                        SBC  HL, DE
1196+ F322 22 60 75                     LD   (ZL_SmoothY), HL
1197+ F325 C9                           RET
