 430  1773              ClampOffsetOrder:                                      ; Prevent positive tail offsets from inverting visual slot order.
 431  1773 F5                           PUSH AF
 432  1774 C5                           PUSH BC
 433  1775 E5                           PUSH HL
 434  1776 3A D2 6A                     LD   A, (Core.VDC_SlotsLen)
 435  1779 FE 02                        CP   2
 436  177B 38 1B                        JR   C, .co_done
 437  177D 3D                           DEC  A
 438  177E 47                           LD   B, A                              ; pairs len-1
 439  177F 21 83 D0                     LD   HL, Core.VDC_Offsets              ; HL = prev offset
 440  1782 7E           .co_loop:       LD   A, (HL)
 441  1783 23                           INC  HL                                ; HL = current offset
 442  1784 4F                           LD   C, A                              ; C = prev
 443  1785 7E                           LD   A, (HL)                           ; A = current
 444  1786 B7                           OR   A
 445  1787 28 0D                        JR   Z, .co_next
 446  1789 FA 96 17                     JP   M, .co_next                       ; only positive current offsets can create backward overlap
 447  178C CB 79                        BIT  7, C
 448  178E 20 05                        JR   NZ, .co_clamp                     ; prev negative, current positive -> inverted
 449  1790 B9                           CP   C
 450  1791 38 03                        JR   C, .co_next
 451  1793 28 01                        JR   Z, .co_next
 452  1795 71           .co_clamp:      LD   (HL), C
 453  1796 10 EA        .co_next:       DJNZ .co_loop
 454  1798 E1           .co_done:       POP  HL
 455  1799 C1                           POP  BC
 456  179A F1                           POP  AF
 457  179B C9                           RET
 458  179C
 459  179C              ; ============================================================================
 460  179C              ; DrawKillzoneDual — dual-pass kill-zone draw: hole (cell 0) под skull (cell N).
 461  179C              ; Перенесён сюда из Core.MainLoop чтобы освободить байты Core (Core был
 462  179C              ; 8189/8192). Должен вызываться внутри активного FT_Begin FT_BITMAPS блока.
 463  179C              ;
 464  179C              ; Координаты центра kill-zone — per-level setting (KZ_DEFAULT_X/Y).  Не из
 465  179C              ; track end: track[N-1] не обязан попадать в визуальный центр sun-черепа в bg
 466  179C              ; (cell-grid CELL_SIZE=32 ≠ pixel-aligned bg art).  Для level 1 (Spiral of Doom)
 467  179C              ; центр bg-bbox золотых пикселей = (208, 217).
 468  179C              ; ============================================================================
 469  179C              KZ_DEFAULT_X       EQU 211
 470  179C              KZ_DEFAULT_Y       EQU 217
 471  179C              KZ_SPR_W           EQU 88
 472  179C              KZ_SPR_H           EQU 88
 473  179C              KZ_SPR_HALF        EQU 44
 474  179C              FROG_DEFAULT_X     EQU 327
 475  179C              FROG_DEFAULT_Y     EQU 231
 476  179C
 477  179C              ; Room transitions keep the old DL visible until it is fully covered by a
 478  179C              ; black overlay. RAM_G can then be reloaded without exposing half-written art.
 479  179C              FadeMenuToLevelSelect:
 480  179C 21 FC C3                     LD   HL, Core.MenuBuildFrame
 481  179F CD 1E 18                     CALL FadeOutRoom
 482  17A2                              ; First time only: the PAK sector map isn't built yet, so the
 483  17A2                              ; upcoming asset load runs the (slow) recursive search. Show
 484  17A2                              ; "LOADING LEVELS..." over the faded-out menu while it works.
 485  17A2                              ; Later transitions reuse the cached map -> near-instant, no message.
 486  17A2 3A 17 6D                     LD   A, (Core.LevelsMapLoaded)
 487  17A5 B7                           OR   A
 488  17A6 20 06                        JR   NZ, .skip_loading
 489  17A8 CD B1 17                     CALL UploadLoadingText                  ; залить баннер в RAM_G #084000 (меню погашено)
 490  17AB CD ED 6F                     CALL Core.DrawLoadingScreen
 491  17AE              .skip_loading:
 492  17AE C3 59 CD                     JP   Core.LevelSelect
 493  17B1
 494  17B1              ; UploadLoadingText — расжать «LOADING LEVELS...» (nativealien48 48px) в RAM_G
 495  17B1              ; #084000. Зона свободна в профиле level-select (#082658..#098000), поэтому баннер
 496  17B1              ; переживает медленный поиск PAK, пока кадр отрисован. Вызывать ДО DrawLoadingScreen.
 497  17B1              UploadLoadingText:
 498  17B1 21 00 40                     LD   HL, LOADING_TEXT_RAMG & 0xFFFF
 499  17B4 22 C2 66                     LD   (Core.BgRamL), HL
 500  17B7 3E 08                        LD   A, (LOADING_TEXT_RAMG >> 16) & 0xFF
 501  17B9 32 C4 66                     LD   (Core.BgRamH), A
 502  17BC 3E 25                        LD   A, LOADING_TEXT_PAGE_BASE
 503  17BE 06 03                        LD   B, LOADING_TEXT_NUM_PAGES
 504  17C0 C5           .ult_loop:      PUSH BC
 505  17C1 F5                           PUSH AF
 506  17C2 CD 1F 3C                     CALL UnpackAndUploadPage                ; advances RAM_G +16K
 507  17C5 F1                           POP  AF
 508  17C6 3C                           INC  A
 509  17C7 C1                           POP  BC
 510  17C8 10 F6                        DJNZ .ult_loop
 511  17CA C9                           RET
 512  17CB
