 131+ CEAE ~                            LD   A, C
 132+ CEAE ~                            OR   A
 133+ CEAE ~                            JR   Z, .outside?
 134+ CEAE ~                            LD   A, (LevelSelectLmbNow)
 135+ CEAE ~                            OR   A
 136+ CEAE ~                            LD   A, 1
 137+ CEAE ~                            JR   Z, .store?
 138+ CEAE ~                            INC  A
 139+ CEAE ~            .store?:        LD   (State?), A
 140+ CEAE ~                            if ClickVar?
 141+ CEAE ~                            CP   1
 142+ CEAE ~                            JR   NZ, .outside?
 143+ CEAE ~                            LD   A, (LevelSelectLmbPrev)
 144+ CEAE ~                            CP   1
 145+ CEAE ~                            JR   NZ, .outside?
 146+ CEAE ~                            LD   A, 1
 147+ CEAE ~                            LD   (ClickVar?), A
 148+ CEAE ~                            LD   A, SND_BUTTON1
 149+ CEAE ~                            CALL GS_PlaySfx
 150+ CEAE ~                            endif
 151+ CEAE ~            .outside?:
 152+ CEAE                              endm
