2578+ CE5A 47                           LD   B, A                              ; B = loop count
2579+ CE5B 0E 00                        LD   C, 0                              ; C = i
2580+ CE5D C5           .ugt_loop:      PUSH BC
2581+ CE5E                              ; Slots[i] >= NUM_COLORS → gap, иначе non-gap пропускаем
2582+ CE5E 79                           LD   A, C
2583+ CE5F 26 00                        LD   H, 0
2583+ CE61 6F             LD L, A
2584+ CE62 ED 5B 4F D9                  LD   DE, (VDC_pSlots)
2585+ CE66 19                           ADD  HL, DE
2586+ CE67 7E                           LD   A, (HL)
2587+ CE68 FE 06                        CP   VDC_NUM_COLORS
2588+ CE6A 38 3B                        JR   C, .ugt_skip                      ; non-gap → пропустить
2589+ CE6C                              ; Также skip если ExplodeFrame > 0 (gap ещё не "финализирован",
2590+ CE6C                              ; это не пустая ячейка а взрывающийся шар)
2591+ CE6C 79                           LD   A, C
2592+ CE6D 26 00                        LD   H, 0
2592+ CE6F 6F             LD L, A
2593+ CE70 ED 5B 55 D9                  LD   DE, (VDC_pExplodeFrame)
2594+ CE74 19                           ADD  HL, DE
2595+ CE75 7E                           LD   A, (HL)
2596+ CE76 B7                           OR   A
2597+ CE77 20 2E                        JR   NZ, .ugt_skip
2598+ CE79                              ; Compute slot position (allow gap)
2599+ CE79 79                           LD   A, C
2600+ CE7A CD F4 C4                     CALL VDC_SlotPosAllowGap               ; BC=X, DE=Y, CF=1 если t<0
2601+ CE7D 38 28                        JR   C, .ugt_skip
2602+ CE7F                              ; Manhattan distance = |bullet_X - X| + |bullet_Y - Y|, clamp 255
2603+ CE7F 2A EE E7                     LD   HL, (Bullet_X)
2604+ CE82 A7                           AND  A
2605+ CE83 ED 42                        SBC  HL, BC
2606+ CE85 CD E4 F2                     CALL ZL_AbsHL
2607+ CE88 7C                           LD   A, H
2608+ CE89 B7                           OR   A
2609+ CE8A 20 1B                        JR   NZ, .ugt_skip                     ; |dx| > 255 → дальше 255
2610+ CE8C F5                           PUSH AF                                ; save dummy
2611+ CE8D 45                           LD   B, L                              ; B = |dx|
2612+ CE8E 2A F0 E7                     LD   HL, (Bullet_Y)
2613+ CE91 A7                           AND  A
2614+ CE92 ED 52                        SBC  HL, DE
2615+ CE94 CD E4 F2                     CALL ZL_AbsHL
2616+ CE97 7C                           LD   A, H
2617+ CE98 B7                           OR   A
2618+ CE99 20 0B                        JR   NZ, .ugt_skip_pop
2619+ CE9B 78                           LD   A, B
2620+ CE9C 85                           ADD  A, L                              ; A = |dx| + |dy|
2621+ CE9D 38 07                        JR   C, .ugt_skip_pop                  ; overflow 255 → пропуск
2622+ CE9F                              ; Compare с текущим минимумом
2623+ CE9F 21 61 D4                     LD   HL, VDC_BulletGapMinDist
2624+ CEA2 BE                           CP   (HL)
2625+ CEA3 30 01                        JR   NC, .ugt_skip_pop
2626+ CEA5 77                           LD   (HL), A
2627+ CEA6 F1           .ugt_skip_pop:  POP  AF                                ; balance PUSH AF выше
2628+ CEA7 C1           .ugt_skip:      POP  BC
2629+ CEA8 0C                           INC  C
2630+ CEA9 10 B2                        DJNZ .ugt_loop
2631+ CEAB C9                           RET
