 117+ E8DB 28 F2                        JR   Z, .WaitIntSync
 118+ E8DD                              FT_WR_REG8 FT_REG_INT_FLAGS, FT_INT_SWAP   ; Clear flag
 118+ E8DD 3E 01       >                LD A, FT_INT_SWAP & 0xFF
 118+ E8DF 11 A8 20    >                LD DE, FT_REG_INT_FLAGS & 0xFFFF
 118+ E8E2 CD 1B 12    >                CALL FT.WriteReg8
