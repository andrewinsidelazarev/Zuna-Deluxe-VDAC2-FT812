 468+ C63E              MenuDrawSun:
 469+ C63E                              ; Солнце и свечение — отдельные спрайты поверх фона. Анимация по фазе
 470+ C63E                              ; MenuSunPhase: солнце плавно «дышит» масштабом (cmd_scale), свечение —
 471+ C63E                              ; пульс alpha. Значения считаем В ПАМЯТЬ заранее (макросы FT_Bitmap*
 472+ C63E                              ; клобают BCDE).
 473+ C63E                              ; alpha свечения = 150 + sin(GlowPhase)>>2 → 119..181 (своя фаза/скорость)
 474+ C63E 3A 45 CD                     LD   A, (MenuGlowPhase)
 475+ C641 06 02                        LD   B, 2
 476+ C643 CD D1 C7                     CALL MenuSinShiftHL
 477+ C646 7D                           LD   A, L
 478+ C647 C6 96                        ADD  A, 150
 479+ C649 32 4A CD                     LD   (MenuGlowAlpha), A
 480+ C64C                              ; масштаб солнца 16.16, ТОЛЬКО уменьшение: s = 1.0 + (sin-127)*8/65536
 481+ C64C                              ;   → s ∈ [0.969 .. 1.0] (±0..3.1%). Только shrink — у спрайта солнца НЕТ
 482+ C64C                              ;   прозрачных полей (лучи до краёв), при увеличении лучи бы обрезались
 483+ C64C                              ;   фиксированным BITMAP_SIZE. Уменьшение безопасно (внутри рамки, по краям
 484+ C64C                              ;   прозрачно). offset = (sin-127)*8 ≤ 0; scale = #00010000 + offset, т.е.
 485+ C64C                              ;   scaleLo = offset(как есть), scaleHi = 1 только при offset==0 иначе 0.
 486+ C64C 3A 44 CD                     LD   A, (MenuSunPhase)
 487+ C64F 5F                           LD   E, A
 487+ C650 16 00          LD D, 0
 488+ C652 21 E2 C7                     LD   HL, MenuSunSinTable
 489+ C655 19                           ADD  HL, DE
 490+ C656 7E                           LD   A, (HL)                            ; A = sin(phase), signed
 491+ C657 6F                           LD   L, A
 491+ C658 87             ADD A, A
 491+ C659 9F             SBC A, A
 491+ C65A 67             LD H, A   ; HL = sign-extended sin (-128..127)
 492+ C65B 11 81 FF                     LD   DE, -127
 493+ C65E 19                           ADD  HL, DE                             ; HL = sin - 127  (-254..0)
 494+ C65F 29                           ADD  HL, HL
 494+ C660 29             ADD HL, HL
 494+ C661 29             ADD HL, HL   ; HL = (sin-127)*8  (offset, -2032..0)
 495+ C662 22 46 CD                     LD   (MenuSunScaleLo), HL
 496+ C665 3E 01                        LD   A, 1
 497+ C667 CB 7C                        BIT  7, H
 498+ C669 28 01                        JR   Z, .scale_hi                       ; H bit7=0 → offset==0 → Hi=1 (s=1.0)
 499+ C66B 3D                           DEC  A                                  ; offset<0 → Hi=0 (s<1.0)
 500+ C66C 6F           .scale_hi:      LD   L, A
 500+ C66D 26 00          LD H, 0
 501+ C66F 22 48 CD                     LD   (MenuSunScaleHi), HL
 502+ C672
 503+ C672                              ; --- матрица масштаба для солнца (cmd_loadidentity; cmd_scale sx,sy; cmd_setmatrix) ---
 504+ C672 CD 28 75                     CALL Core.ZL_EmitLoadId
 505+ C675 01 FF FF                     LD   BC, FT_CMD_SCALE >> 16
 506+ C678 11 28 FF                     LD   DE, FT_CMD_SCALE & #FFFF
 507+ C67B CD EB 13                     CALL FT.Coprocessor.Command_BCDE
 508+ C67E ED 4B 48 CD                  LD   BC, (MenuSunScaleHi)
 509+ C682 ED 5B 46 CD                  LD   DE, (MenuSunScaleLo)
 510+ C686 CD EB 13                     CALL FT.Coprocessor.Command_BCDE        ; sx
 511+ C689 ED 4B 48 CD                  LD   BC, (MenuSunScaleHi)
 512+ C68D ED 5B 46 CD                  LD   DE, (MenuSunScaleLo)
 513+ C691 CD EB 13                     CALL FT.Coprocessor.Command_BCDE        ; sy
 514+ C694 CD 55 75                     CALL Core.ZL_EmitSetMatrix
