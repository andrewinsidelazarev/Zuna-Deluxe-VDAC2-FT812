  93+ 6AD0              ; --- Hoisted gameplay/UI state (originally in VDC.asm / Frog.asm) -----------
  94+ 6AD0              ; Moved to resident Core so the resident transition + HUD/dialog/absorb/win
  95+ 6AD0              ; logic in main.asm reaches them while slot 3 holds a DIFFERENT scene overlay
  96+ 6AD0              ; (UI page vs gameplay page) — and so FadeLevelSelectToGameplay can reset the
  97+ 6AD0              ; score BEFORE the gameplay page is mapped. Names unchanged (module Core) → all
  98+ 6AD0              ; existing references (qualified Core.X and in-module X) resolve untouched.
  99+ 6AD0              ; VDC_Init still initialises these by name. See typed-launching-sunset plan.
 100+ 6AD0 00           VDC_GameState:       DEFB 0   ; 0=play,1=absorb,2=gameover,3=intro,4=preview,5=closing
 101+ 6AD1 00           VDC_HSub:            DEFB 0   ; head sub-position (absorb physics, resident UpdateAbsorbState)
 102+ 6AD2 00           VDC_SlotsLen:        DEFB 0   ; chain length (win/absorb logic in resident)
 103+ 6AD3 00           VDC_KzFrame:         DEFB 0   ; skull-mouth frame (DrawKillzone resident)
 104+ 6AD4 FF           VDC_HeadAbsorbAlpha: DEFB 255 ; head-ball fade alpha during state=1 absorb
 105+ 6AD5 03           VDC_Lives:           DEFB 3   ; lives (start 3, +1/50k, carried across levels)
 106+ 6AD6 00           VDC_DialogState:     DEFB 0   ; 0=NONE,1=RETRY,2=GAMEOVER,3=pause,4=pause-fade,5=WIN_DONE,6=WIN_FADE
 107+ 6AD7 00           VDC_PrevMouseL:      DEFB 0   ; previous LMB state for dialog edge detection
 108+ 6AD8 00           VDC_HudMenuState:    DEFB 0   ; 0=inactive,1=hover,2=pressed (HUD MENU button)
 109+ 6AD9 00           VDC_HudPointerBlock: DEFB 0   ; pointer over HUD button: suppress frog fire edge
 110+ 6ADA 00 00        VDC_GaugeScore:      DEFW 0   ; Zuma bar score this level (win condition in resident)
 111+ 6ADC 00           VDC_GaugeFull:       DEFB 0   ; 0=yellow filling, 1=green full
 112+ 6ADD              ; 24-bit cumulative adventure score (3-byte little-endian, max 16,777,215). Was
 113+ 6ADD              ; DEFW (16-bit) which overflowed past 65535 — but adventure totals reach hundreds
 114+ 6ADD              ; of thousands and the +1-life-per-50000 mechanic needs cumulative beyond 16 bits.
 115+ 6ADD              ; NextLifeScore is the next 50000 threshold; Score_Add24 grants a life and advances
 116+ 6ADD              ; it by 50000 each time the score crosses it. Both reset by Score_Reset.
 117+ 6ADD 00 00 00     VDC_PlayerScore:     DB 0,0,0 ; cumulative adventure score (HUD draw + bonus in resident)
 118+ 6AE0 50 C3 00     NextLifeScore:       DB #50,#C3,#00 ; next extra-life threshold = 50000 (0x00C350 LE)
 119+ 6AE3 00 00        VDC_GameSeconds:     DEFW 0   ; elapsed gameplay seconds (HUD clock in resident)
 120+ 6AE5 00           Frog_BallColor:      DEFB 0   ; current loaded ball color (refiltered on level change, resident)
 121+ 6AE6 00           Frog_NextBallColor:  DEFB 0   ; next ball color
 122+ 6AE7              ; VDC invariant diagnostics for F12 dumps. First failure is latched until VDC_Init:
 123+ 6AE7              ;   code 1: SlotsLen > VDC_MAX_SLOTS
 124+ 6AE7              ;   code 2: HSA > TrackNumSlots
 125+ 6AE7              ;   code 3: Slots[i] is neither color nor GAP marker
 126+ 6AE7              ;   code 4: Offsets[i] outside [-CELL_SIZE..CELL_SIZE]
 127+ 6AE7              ;   code 5: ExplodeFrame[i] has invalid ExplodeMarker
 128+ 6AE7              ;   code 6: Shot2[i] is not 0/1
 129+ 6AE7 00           VDC_AssertCode:      DEFB 0
 130+ 6AE8 00           VDC_AssertCtx:       DEFB 0
 131+ 6AE9 00           VDC_AssertLen:       DEFB 0
 132+ 6AEA 00           VDC_AssertHSA:       DEFB 0
 133+ 6AEB 00           VDC_AssertValue:     DEFB 0
 134+ 6AEC 00 00        VDC_AssertFrame:     DEFW 0
 135+ 6AEE              ; LevelSelectPreviewFrogAngle: written/read by the resident preview-frog renderer
 136+ 6AEE              ; (LevelSelectPreviewSlot0). The renderer maps the gameplay overlay (#04) for the
 137+ 6AEE              ; frog/DL emit code; this one byte must stay reachable across that swap, so it is
 138+ 6AEE              ; resident rather than on the UI overlay (#41) where LevelSelect.asm used to keep it.
 139+ 6AEE 40           LevelSelectPreviewFrogAngle: DEFB 64
