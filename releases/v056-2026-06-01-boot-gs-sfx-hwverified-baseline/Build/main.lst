 498+ C302                              ; the RTC baseline so the paused/fading seconds are not counted.
 499+ C302 CD 94 C2                     CALL ReadRTCSeconds
 500+ C305 32 65 D4                     LD   (VDC_RtcLastSecond), A
 501+ C308 AF                           XOR  A
 502+ C309 32 66 D4                     LD   (VDC_RtcNoTickFrames), A
