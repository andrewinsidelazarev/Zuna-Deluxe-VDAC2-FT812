1277+ F65F CB 3F          SRL A
1277+ F661 CB 3F          SRL A                  ; A = bucket (0..31)
1278+ F663 5F                           LD   E, A
1278+ F664 16 00          LD D, 0
1279+ F666 21 00 00                     LD   HL, 0
1280+ F669 19                           ADD  HL, DE
1281+ F66A 29                           ADD  HL, HL
1281+ F66B 29             ADD HL, HL
1281+ F66C 29             ADD HL, HL   ; ×8
1282+ F66D 44                           LD   B, H
1282+ F66E 4D             LD C, L
1283+ F66F 29                           ADD  HL, HL                             ; ×16
1284+ F670 09                           ADD  HL, BC                             ; ×24
1285+ F671 11 5B F3                     LD   DE, ZL_ChainMatrixLUT
1286+ F674 19                           ADD  HL, DE
1287+ F675 ED 5B 35 14                  LD   DE, (FT.Coprocessor.BufferPtr)
1288+ F679 01 18 00                     LD   BC, ZL_CHAIN_MATRIX_LUT_STRIDE
1289+ F67C ED B0                        LDIR
1290+ F67E ED 53 35 14                  LD   (FT.Coprocessor.BufferPtr), DE
