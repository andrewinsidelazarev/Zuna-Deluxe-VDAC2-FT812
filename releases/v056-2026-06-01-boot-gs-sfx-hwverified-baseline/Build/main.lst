   5+ E7F9              ; ============================================================================
   6+ E7F9              ; MainLoop — главный игровой цикл Zuma VDAC2 (640×480 через FT812)
   7+ E7F9              ; ----------------------------------------------------------------------------
   8+ E7F9              ; Каркас: на этом этапе DL содержит только тёмный фон + анимированную точку
   9+ E7F9              ; (proof-of-life). По мере добавления game-state'а сюда подключатся:
  10+ E7F9              ;   • VDC engine update (move_chain, animate_chain, try_spawn, scan_match…)
  11+ E7F9              ;   • Background bitmap из RAM_G
  12+ E7F9              ;   • Цикл по slots[] → BITMAP cells шаров (FT_Vertex2ii)
  13+ E7F9              ;   • Frog с rotation matrix к курсору
  14+ E7F9              ;   • Cursor + score
  15+ E7F9              ;
  16+ E7F9              ; Зависимости подключаются ровно те же что для Init_Video.asm
  17+ E7F9              ; (TSConf + Video + FT/81x Const + DL + 812 Macro + module FT 812 Func + Coprocessor).
  18+ E7F9              ;
  19+ E7F9              ; Контракт: MainLoop вызывается из EntryPoint после Init_Video и не возвращается.
  20+ E7F9              ; ============================================================================
  21+ E7F9
  22+ E7F9              ; --- Константы кадра (всё в subpixel'ах: VertexFormat=4 → 1/16 px) ----------
  23+ E7F9              ZL_SCR_W        EQU 640
  24+ E7F9              ZL_SCR_H        EQU 480
  25+ E7F9              ZL_SUB          EQU 16                                ; subpixel множитель
  26+ E7F9              ZL_CMD_WARN_BYTES EQU #0E00                           ; warn before RAM_CMD FIFO pressure (4096 bytes)
  27+ E7F9              ZL_FT_CMD_DMA_ENABLED EQU 1                           ; 1=send frame CMD buffer to FT812 via TS-Config DMA_RAM_SPI
  28+ E7F9              ZL_PROFILER_ENABLED EQU 0                             ; 1=show FT812 timing overlay
  29+ E7F9              ZL_FROG_DRAW_ENABLED EQU 1                            ; canary master: isolate frog tearing source
  30+ E7F9              ZL_FROG_DRAW_PLATE   EQU 1                            ; no rotation
  31+ E7F9              ZL_FROG_DRAW_BODY    EQU 1                            ; rotated main body
  32+ E7F9              ZL_FROG_DRAW_TONGUE  EQU 1                            ; rotated tongue
  33+ E7F9              ZL_FROG_DRAW_BALL_NOW  EQU 1                          ; ball on tongue / in mouth
  34+ E7F9              ZL_FROG_DRAW_NEXT_BALL EQU 1                          ; next ball on frog back
  35+ E7F9              ZL_FROG_DRAW_OVERLAY EQU 1                            ; rotated face overlay
  36+ E7F9
