 650+ C423              ; ============================================================================
 651+ C423              ; WIN-снимок: сэмпл ГОЛОВНОГО шара (ближайшего к килл-зоне) каждой цепочки.
 652+ C423              ; Снимается каждый PLAY-кадр ДО апдейта. keep-last-non-empty: обновляем только
 653+ C423              ; если в цепочке есть видимые шары (иначе храним прошлый кадр — к WIN цепочка
 654+ C423              ; пуста). Голова = максимальный track-сэмпл среди видимых шаров (фронт цепи).
 655+ C423              ; Свопы цепочек парные → read-only по отношению к состоянию цепочек.
 656+ C423              ; ============================================================================
 657+ C423              VDC_WinSnapAllChains:
 658+ C423 CD 44 C4                     CALL VDC_SnapshotWinChain              ; chain1 (текущий трек активен)
 659+ C426 38 03                        JR   C, .c2                            ; нет видимых шаров → храним прошлый
 660+ C428 22 EF 6A                     LD   (VDC_WinHeadS1), HL
 661+ C42B 3A 7A D4     .c2:            LD   A, (VDC_HasSecondChain)
 662+ C42E B7                           OR   A
 663+ C42F C8                           RET  Z
 664+ C430 CD DE C1                     CALL VDC_SwapChains
 665+ C433 CD 38 5F                     CALL SetSecondTrackPage
 666+ C436 CD 44 C4                     CALL VDC_SnapshotWinChain              ; chain2
 667+ C439 38 03                        JR   C, .c2_keep
 668+ C43B 22 F1 6A                     LD   (VDC_WinHeadS2), HL               ; запись в резидент — до возврата цепочки
 669+ C43E CD DE C1     .c2_keep:       CALL VDC_SwapChains
 670+ C441 C3 26 5F                     JP   SetCurrentTrackPage
 671+ C444
 672+ C444              ; VDC_SnapshotWinChain — макс. track-сэмпл видимых шаров текущей активной цепочки.
 673+ C444              ; Out: CF=0 + HL = head sample (фронт), если есть видимый шар; CF=1 если нет.
 674+ C444              ; VDC_SlotPos для каждого слота выставляет VDC_LastT (clamped sample); берём макс.
 675+ C444              VDC_SnapshotWinChain:
 676+ C444 3A D2 6A                     LD   A, (VDC_SlotsLen)
 677+ C447 B7                           OR   A
 678+ C448 28 38                        JR   Z, .none
 679+ C44A 47                           LD   B, A                              ; B = число слотов
 680+ C44B 0E 00                        LD   C, 0                              ; C = индекс слота
 681+ C44D 21 00 00                     LD   HL, 0
 682+ C450 22 F3 6A                     LD   (VDC_WinTmpMax), HL
 683+ C453 AF                           XOR  A
 684+ C454 32 F5 6A                     LD   (VDC_WinTmpFound), A
 685+ C457 C5           .snap_loop:     PUSH BC
 686+ C458 79                           LD   A, C
 687+ C459 CD E3 C4                     CALL VDC_SlotPos                       ; CF=1 gap/вне трека; иначе VDC_LastT=сэмпл
 688+ C45C 38 15                        JR   C, .snap_skip
 689+ C45E 3E 01                        LD   A, 1
 690+ C460 32 F5 6A                     LD   (VDC_WinTmpFound), A
 691+ C463 2A 78 D4                     LD   HL, (VDC_LastT)                   ; сэмпл этого шара
 692+ C466 ED 5B F3 6A                  LD   DE, (VDC_WinTmpMax)
 693+ C46A A7                           AND  A
 694+ C46B ED 52                        SBC  HL, DE                            ; sample - max
 695+ C46D 38 04                        JR   C, .snap_skip                     ; sample < max → не обновляем
 696+ C46F 19                           ADD  HL, DE                            ; восстановить sample
 697+ C470 22 F3 6A                     LD   (VDC_WinTmpMax), HL               ; новый максимум
 698+ C473 C1           .snap_skip:     POP  BC
 699+ C474 0C                           INC  C
 700+ C475 10 E0                        DJNZ .snap_loop
 701+ C477 3A F5 6A                     LD   A, (VDC_WinTmpFound)
 702+ C47A B7                           OR   A
 703+ C47B 28 05                        JR   Z, .none
 704+ C47D 2A F3 6A                     LD   HL, (VDC_WinTmpMax)
 705+ C480 A7                           AND  A                                 ; CF=0
 706+ C481 C9                           RET
 707+ C482 37           .none:          SCF
 708+ C483 C9                           RET
