4496  7568                              include "Input.asm"                   ; resident global input module (PS/2 keyboard via Mr.Gluk + Kempston + mouse); callable from any scene
# file opened: Source\ASM\Input.asm
   1+ 7568              ; ============================================================================
   2+ 7568              ; Input.asm — РЕЗИДЕНТНЫЙ глобальный модуль ВСЕГО управления. Здесь читаются ВСЕ
   3+ 7568              ; источники ввода, поэтому любая сцена-overlay (геймплей #04, UI #41) может
   4+ 7568              ; опрашивать ввод без переключения страниц.
   5+ 7568              ;
   6+ 7568              ; Источники (всё в одном месте — клавиатура + джойстик + мышь):
   7+ 7568              ;   * Расширенная PC-клавиатура ZX Evolution через Mr.Gluk Z-контроллер:
   8+ 7568              ;       OUT #EFF7,#80 = enable; OUT #DFF7,рег = выбор регистра; #BFF7 = данные.
   9+ 7568              ;       Регистр #F0 = PS/2 FIFO scancode'ов (set-2). Тот же чип, что и RTC
  10+ 7568              ;       (VDC.ReadRTCSeconds), который ГАСИТ #EFF7 после чтения — поэтому
  11+ 7568              ;       Input_Scan каждый кадр включает его заново. См. заметку памяти
  12+ 7568              ;       reference_zuma_vdac2_zxevo_ps2_keyboard.
  13+ 7568              ;   * Kempston-джойстик (TSLib Input.Kempston). KJoystick=1 направляет PC-стрелки
  14+ 7568              ;     сюда же.
  15+ 7568              ;   * Мышь (TSLib Input.Mouse) — позиция + ЛКМ.
  16+ 7568              ;
  17+ 7568              ; Схема управления: лягушка = вращение Влево/Вправо (геймплей). Глобальные UI:
  18+ 7568              ;   Up/Down — навигация меню/выбор сложности; Влево/Вправо — активная кнопка в
  19+ 7568              ;   диалогах; ESC — меню/назад; Fire = Space | Enter | Kempston-Fire | ЛКМ.
  20+ 7568              ; Клавиатурные эквиваленты направлений (классическая ZX-раскладка):
  21+ 7568              ;   Up = ↑ | Q;  Down = ↓ | A;  Влево = ← | O;  Вправо = → | P.
  22+ 7568              ;
  23+ 7568              ; Применение: Input_Init один раз на старте; Input_Scan один раз за кадр (в любой
  24+ 7568              ; сцене — он обновляет и клавиатуру, и мышь); затем опросы Input_Up/Down/Left/
  25+ 7568              ; Right/Fire/Esc (каждый возвращает NZ = активно). Edge-хелперы — для навигации.
  26+ 7568              ; ============================================================================
  27+ 7568
  28+ 7568              ; Скан-коды PS/2 set-2 (make-коды; стрелки идут с префиксом E0, но их коды
  29+ 7568              ; уникальны, поэтому при сопоставлении префикс E0 игнорируется).
  30+ 7568              INP_SC_ESC      EQU #76
  31+ 7568              INP_SC_UP       EQU #75
  32+ 7568              INP_SC_DOWN     EQU #72
  33+ 7568              INP_SC_LEFT     EQU #6B
  34+ 7568              INP_SC_RIGHT    EQU #74
  35+ 7568              INP_SC_ENTER    EQU #5A
  36+ 7568              INP_SC_SPACE    EQU #29
  37+ 7568              INP_SC_Q        EQU #15
  38+ 7568              INP_SC_A        EQU #1C
  39+ 7568              INP_SC_O        EQU #44          ; O = Влево (классическая ZX-раскладка)
  40+ 7568              INP_SC_P        EQU #4D          ; P = Вправо
  41+ 7568
  42+ 7568              ; Флаги «клавиша нажата» (1 = нажата, 0 = отпущена), обновляются Input_Scan.
  43+ 7568 00           Input_KEsc:     DEFB 0
  44+ 7569 00           Input_KUp:      DEFB 0
  45+ 756A 00           Input_KDown:    DEFB 0
  46+ 756B 00           Input_KLeft:    DEFB 0
  47+ 756C 00           Input_KRight:   DEFB 0
  48+ 756D 00           Input_KEnter:   DEFB 0
  49+ 756E 00           Input_KSpace:   DEFB 0
  50+ 756F 00           Input_KQ:       DEFB 0
