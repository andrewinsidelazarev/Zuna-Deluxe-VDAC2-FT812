1320+ F6A2 CB 3F                        SRL  A
1321+ F6A4 4F                           LD   C, A
1322+ F6A5 7D                           LD   A, L
1323+ F6A6 87                           ADD  A, A
1324+ F6A7 87                           ADD  A, A
1325+ F6A8 87                           ADD  A, A
1326+ F6A9 87                           ADD  A, A
1327+ F6AA 87                           ADD  A, A
1328+ F6AB 87                           ADD  A, A
1329+ F6AC B1                           OR   C
