 412+ E0D9              ; Frog_DrawTongue — handle 5, tight-crop sprite 32×80, на pos + tongueExpand·dir,
 413+ E0D9              ; rotation вокруг tongue centre.
 414+ E0D9              ;   tongueX = pos.x + (cos(angle) * tongueExpand) / 128
 415+ E0D9              ;   tongueY = pos.y + (sin(angle) * tongueExpand) / 128
 416+ E0D9              ;   matrix  = T(16, 40) · R(angle + 192) · T(-16, -40)
 417+ E0D9              ; Tongue native = south (tip внизу 32×80 кадра); rotation как у body.
 418+ E0D9              ; ----------------------------------------------------------------------------
 419+ E0D9              Frog_DrawTongue:
 420+ E0D9                                ; HD-style: tongue centre = pos + tongueExpand·dir (orbit).
 421+ E0D9                                ; tongueExpand=24 idle, втягивается до 0 при выстреле.
 422+ E0D9                                ;   offsetX = (cos(angle) · tongueExpand) / 128
 423+ E0D9                                ;   offsetY = (sin(angle) · tongueExpand) / 128
