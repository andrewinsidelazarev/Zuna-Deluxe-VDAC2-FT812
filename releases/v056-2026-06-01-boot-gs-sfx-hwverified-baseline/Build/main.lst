   2+ C000                              ifndef _ZUMA_VDC_
   3+ C000                              define _ZUMA_VDC_
   4+ C000
   5+ C000              ; ============================================================================
   6+ C000              ; VDC — Virtual Discrete Chain physics для Zuma VDAC2 (640x480).
   7+ C000              ; ----------------------------------------------------------------------------
   8+ C000              ; Порт vdc_visual_emulator.py 1:1. Отличия от 360x288 asm-версии:
   9+ C000              ;   - CELL_SIZE = 32 (как в 360x288). Track 640x480 = 2774 samples,
  10+ C000              ;     2774/32 ≈ 87 slots — помещается в byte, но HSA word для запаса.
  11+ C000              ;   - LastRenderPos НЕ хранится: при t<0 рендер skip. Trade-off: при cascade
  12+ C000              ;     rollback шары на спавне на 1-2 кадра становятся невидимыми. Можно добавить
  13+ C000              ;     потом как опциональный массив.
  14+ C000              ;   - Match-3 has a visual explosion phase. Slots keep their color while
  15+ C000              ;     VDC_ExplodeFrame > 0; after the timer expires the saved GAP marker is
  16+ C000              ;     committed and normal VDC gap closing continues.
  17+ C000              ;
  18+ C000              ; API:
  19+ C000              ;   VDC_Init       — обнулить все массивы, Slots[] = GAP_STOP, RNG seed.
  20+ C000              ;   VDC_Update     — TrySpawn + MoveChain + AnimateChain. Один вызов = один кадр.
  21+ C000              ;   VDC_SlotPos    — для слота A считает (X,Y) центра шара.
  22+ C000              ;                    Out: BC=X, DE=Y, CF=1 если skip (gap или t<0).
  23+ C000              ;   VDC_InsertAt   — A=target_idx, B=color. Вставить шар, проверить match.
  24+ C000              ;
  25+ C000              ; Все функции корраптят AF/BC/DE/HL.
  26+ C000              ; TrackData layout (page 6 в slot 2 #8000):
  27+ C000              ;   word LE NumSamples, затем NumSamples * (sword X, sword Y, byte tangent),
  28+ C000              ;   stride = 5 bytes per sample.
  29+ C000              ; ============================================================================
  30+ C000
  31+ C000              VDC_LEVEL_START_BALLS  EQU 35                            ; быстрая фаза: 35 шаров «поездом»
  32+ C000              VDC_FAST_ADVANCE       EQU 12                            ; MoveChain ×12 за tick в fast-фазе
  33+ C000              VDC_ABSORB_ADVANCE     EQU 8                             ; absorb chain advance: 8 px/tick (32/8=4 ticks/cell)
  34+ C000              VDC_CELL_SIZE          EQU 32                            ; sample-units на slot.
  35+ C000              VDC_DECAY_NEG          EQU 2                             ; insert head slide (neg→0) быстро.
  36+ C000              VDC_DECAY_POS          EQU 1                             ; cascade rollback (pos→0) плавно.
  37+ C000                                                                        ; track chord 1.0815 px/sample: 32×1.08 ≈ 34.6 px
  38+ C000                                                                        ; centers, ball 32 px → gap ~2.6 px на прямой.
  39+ C000                                                                        ; Используется в VDC_SlotT через ZL_Mul16x8.
  40+ C000                                                                       ; track 1.067 px/sample → 42*1.067 ≈ 45 px
  41+ C000                                                                       ; между центрами при ball=40 → 5 px gap
  42+ C000                                                                       ; (= touching, как в оригинале Zuma).
  43+ C000              VDC_MAX_SLOTS          EQU 240
  44+ C000              VDC_GAP_STOP           EQU #FE
  45+ C000              VDC_GAP_CASCADE        EQU #FD
  46+ C000              VDC_NUM_COLORS         EQU 6                             ; 6 colors (atlas already supports 6×32 cells). Pre 2026-05-18: 4.
  47+ C000              VDC_LEVEL_CHAIN_CHANCE EQU 50                            ; level setting: 50% random single, 50% random same-color chain
  48+ C000              VDC_GAP_STEP_FRAMES    EQU VDC_CELL_SIZE
  49+ C000              VDC_DM3_OFFSET_GAP_MAX EQU (VDC_CELL_SIZE / 2) + 2        ; allow fresh insert half-cell overlap, still block full gap
  50+ C000              VDC_BALLS_TARGET       EQU VDC_MAX_SLOTS                 ; legacy/debug only. Runtime spawn gate is
  51+ C000                                                                        ; VDC_GaugeFull (level target score) + GameOver.
  52+ C000              VDC_KZ_FRAMES          EQU 12
  53+ C000              VDC_EXPLOSION_FRAMES   EQU 15
  54+ C000
  55+ C000              ; VDC_GameState values
  56+ C000              VDC_STATE_PLAY     EQU 0                                  ; обычный gameplay
  57+ C000              VDC_STATE_ABSORB   EQU 1                                  ; balls движутся в killzone
  58+ C000              VDC_STATE_GAMEOVER EQU 2                                  ; GAME OVER screen
  59+ C000              VDC_STATE_INTRO    EQU 3                                  ; level intro (LEVEL 1-1 + dispname)
  60+ C000              VDC_STATE_PREVIEW  EQU 4                                  ; sparkle wave вдоль track перед спавном
  61+ C000              VDC_STATE_CLOSING  EQU 5                                  ; череп закрывается (frame 11→1)
  62+ C000              VDC_STATE_WIN      EQU 6                                  ; level clear: sparkles, bonus, next level
  63+ C000              VDC_INTRO_TICKS    EQU 240                                ; ~4 сек @ 60Hz
  64+ C000              ; VDC_DialogState values for the win flow (после win-анимации):
  65+ C000              DLG_WIN_DONE       EQU 5                                  ; «LEVEL DONE» диалог, ждём OK
  66+ C000              DLG_WIN_FADE       EQU 6                                  ; OK нажат → fade-out в чёрное, потом AdvanceToNextLevel
  67+ C000              VDC_WIN_FADE_STEP  EQU 16                                 ; FadeAlpha += step/кадр (255/16 ≈ 16 кадров ≈ 0.2с)
  68+ C000              VDC_PREVIEW_TICKS  EQU 193                                ; (NumSamples+trail)/SPEED = (2774+112)/15 ≈ 192.4 → закрытие сразу после влёта последней звезды
  69+ C000              VDC_CLOSING_TICKS  EQU 22                                 ; ~0.37 сек closing anim (2 ticks per frame)
  70+ C000              VDC_WIN_TICKS      EQU VDC_PREVIEW_TICKS                  ; fallback-таймер (когда нет аутро); при активном аутро конец = VDC_WinOutroDone
  71+ C000
  72+ C000              ; ============================================================================
  73+ C000              ; VDC_Init — обнулить state, Slots[] = GAP_STOP. Должен быть вызван 1 раз
  74+ C000              ; до любого VDC_Update / VDC_SlotPos / VDC_InsertAt.
  75+ C000              ; ============================================================================
