 364+ C3B6 3A 55 CD                     LD   A, (MenuSelection)
 365+ C3B9 FE 01                        CP   1
 366+ C3BB 30 04                        JR   NC, .highlight                        ; уже на нижней активной (More)
 367+ C3BD 3C                           INC  A
 368+ C3BE 32 55 CD                     LD   (MenuSelection), A
 369+ C3C1 CD E3 C3     .highlight:     CALL MenuHighlightSelection
 370+ C3C4                              ; огонь = выбор текущей кнопки
 371+ C3C4 CD 73 76                     CALL Input_FireKey
 372+ C3C7 21 58 CD                     LD   HL, MenuKbdFirePrev
 373+ C3CA CD 8B 76                     CALL Input_EdgeZ
