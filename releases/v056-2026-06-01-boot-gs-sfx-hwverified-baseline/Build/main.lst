2094  3391              ; ============================================================================
2095  3391              ; DrawTimeValue — нарисовать "M:SS" из VDC_GameSeconds (RTC-based).
2096  3391              ;   Раньше делили StatTimeFrames/60, но при 74Hz видеорежиме это давало
2097  3391              ;   неверное время. Теперь берём VDC_GameSeconds (уже в секундах).
2098  3391              ; ============================================================================
2099  3391              DrawTimeValue:
2100  3391                              ; HL = VDC_GameSeconds (total seconds, RTC-based, pause excluded).
2101  3391                              ; Divide by 60: HL → BC=minutes, remainder=seconds.
2102  3391 2A E3 6A                     LD   HL, (Core.VDC_GameSeconds)
2103  3394 11 3C 00                     LD   DE, 60
2104  3397 01 00 00                     LD   BC, 0
2105  339A A7           .dt_div2:       AND  A
2106  339B ED 52                        SBC  HL, DE
2107  339D 38 03                        JR   C, .dt_minutes_done
2108  339F 03                           INC  BC
2109  33A0 18 F8                        JR   .dt_div2
2110  33A2              .dt_minutes_done:
2111  33A2 19                           ADD  HL, DE                             ; восстановить HL = remainder = seconds (0..59)
2112  33A3                              ; BC = minutes, HL_low = seconds. Format "M:SS"
2113  33A3 79                           LD   A, C
2114  33A4 C6 30                        ADD  A, '0'                             ; minute digit (0..9)
2115  33A6 32 D5 33                     LD   (DrawNumBuf), A
2116  33A9 3E 3A                        LD   A, ':'                             ; cancun8 имеет colon
2117  33AB 32 D6 33                     LD   (DrawNumBuf+1), A
2118  33AE 7D                           LD   A, L                               ; seconds 0..59
2119  33AF 06 2F                        LD   B, '0' - 1
