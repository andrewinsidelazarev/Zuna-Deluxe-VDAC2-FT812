 720+ C493              ; ============================================================================
 721+ C493              ; VDC_UpdateRtcElapsed — real-time game clock from RTC seconds.
 722+ C493              ;   Adds delta seconds with 0..59 wrap. Called only during PLAY; pause refreshes
 723+ C493              ;   VDC_RtcLastSecond without accumulating, so pause time is not counted.
 724+ C493              ; ============================================================================
 725+ C493              VDC_UpdateRtcElapsed:
 726+ C493                              ; ТОЛЬКО RTC. Если sec не поменялся — RET, ничего не добавляем.
 727+ C493                              ; Frame-fallback убран (был для эмуляторов с мёртвым RTC, но
 728+ C493                              ; после #EFF7 fix RTC всегда работает).
 729+ C493 CD 94 C2                     CALL ReadRTCSeconds                    ; A = current 0..59
 730+ C496 47                           LD   B, A                              ; B = current
 731+ C497 3A 65 D4                     LD   A, (VDC_RtcLastSecond)            ; A = old
 732+ C49A B8                           CP   B
 733+ C49B C8                           RET  Z                                 ; не поменялось → выходим
 734+ C49C 4F                           LD   C, A                              ; C = old
 735+ C49D 78                           LD   A, B                              ; A = current
 736+ C49E B9                           CP   C
 737+ C49F 30 02                        JR   NC, .rte_no_wrap
 738+ C4A1 C6 3C                        ADD  A, 60                             ; wrap 59→0
 739+ C4A3 91           .rte_no_wrap:   SUB  C                                 ; A = delta 1..59
 740+ C4A4 5F                           LD   E, A
 740+ C4A5 16 00          LD D, 0
 741+ C4A7 2A E3 6A                     LD   HL, (VDC_GameSeconds)
 742+ C4AA 19                           ADD  HL, DE
 743+ C4AB 22 E3 6A                     LD   (VDC_GameSeconds), HL
 744+ C4AE 78                           LD   A, B
 745+ C4AF 32 65 D4                     LD   (VDC_RtcLastSecond), A
 746+ C4B2 C9                           RET
 747+ C4B3
 748+ C4B3              ; ============================================================================
 749+ C4B3              ; VDC_SlotT — для A=i считает t = (HSA-i)*64 + HSub + sext(offsets[i]).
 750+ C4B3              ; Out: HL = signed 16-bit t.  AF/DE clobber.
 751+ C4B3              ; ============================================================================
 752+ C4B3              VDC_SlotT:
 753+ C4B3 4F                           LD   C, A                             ; C = i
 754+ C4B4 3A 43 D4                     LD   A, (VDC_HSA)
 755+ C4B7 91                           SUB  C
 756+ C4B8 30 04                        JR   NC, .delta_ok
 757+ C4BA                              ; i > HSA — слот логически до начала цепи. В рабочей Zuma
 758+ C4BA                              ; (BcsPreClassify) это PRESERVE/skip. Возвращаем signed-negative HL
 759+ C4BA                              ; чтобы VDC_SlotPos через `BIT 7, H` сделал SCF/RET (skip render +
 760+ C4BA                              ; skip bullet collision). Раньше тут был `XOR A` → clamp 0 →
 761+ C4BA                              ; шар рисовался у спавна и зацеплялся коллизией («застрявший шар»
 762+ C4BA                              ; после match-3/cascade с HsaDec). Codex 2026-05-14 diagnose, Claude fix.
 763+ C4BA 21 00 80                     LD   HL, #8000
 764+ C4BD C9                           RET
 765+ C4BE              .delta_ok:
 766+ C4BE 26 00                        LD   H, 0
 766+ C4C0 6F             LD L, A                    ; HL = delta
 767+ C4C1                              ; VDC_CELL_SIZE=32: avoid generic ZL_Mul16x8 in the hot
 768+ C4C1                              ; VDC_SlotPos path. This is hit once per rendered/collided ball.
 769+ C4C1 29                           ADD  HL, HL
 770+ C4C2 29                           ADD  HL, HL
 771+ C4C3 29                           ADD  HL, HL
 772+ C4C4 29                           ADD  HL, HL
 773+ C4C5 29                           ADD  HL, HL                            ; HL = delta * VDC_CELL_SIZE
 774+ C4C6
 775+ C4C6                              ; + HSub (0..63 unsigned)
 776+ C4C6 3A D1 6A                     LD   A, (VDC_HSub)
 777+ C4C9 5F                           LD   E, A
 778+ C4CA 16 00                        LD   D, 0
 779+ C4CC 19                           ADD  HL, DE
 780+ C4CD
 781+ C4CD                              ; + sext(offsets[i])
 782+ C4CD 79                           LD   A, C
 783+ C4CE E5                           PUSH HL
 784+ C4CF 26 00                        LD   H, 0
 784+ C4D1 6F             LD L, A
 785+ C4D2 ED 5B 51 D9                  LD   DE, (VDC_pOffsets)
 786+ C4D6 19                           ADD  HL, DE
 787+ C4D7 7E                           LD   A, (HL)
 788+ C4D8 5F                           LD   E, A
 789+ C4D9 16 00                        LD   D, 0
 790+ C4DB CB 7F                        BIT  7, A
 791+ C4DD 28 01                        JR   Z, .off_pos
 792+ C4DF 15                           DEC  D                                ; sign-extend
 793+ C4E0              .off_pos:
 794+ C4E0 E1                           POP  HL
 795+ C4E1 19                           ADD  HL, DE
 796+ C4E2 C9                           RET
 797+ C4E3
 798+ C4E3              ; ============================================================================
 799+ C4E3              ; VDC_SlotPos — для A=i возвращает центр шара (X,Y) из TrackData[t].
 800+ C4E3              ;   Out: BC = X (signed word), DE = Y (signed word), CF = 0 если рисуем,
 801+ C4E3              ;        CF = 1 если skip (gap или t<0).
 802+ C4E3              ;   AF, HL clobber.
 803+ C4E3              ;
 804+ C4E3              ; VDC_SlotPosAllowGap — тот же расчёт но БЕЗ gap-skip. Используется для
 805+ C4E3              ; gap-bonus tracking (нужна позиция самой gap-ячейки чтобы померить distance
 806+ C4E3              ; bullet'а до пустоты в цепи).
 807+ C4E3              ; ============================================================================
 808+ C4E3              VDC_SlotPos:
 809+ C4E3                              ; --- skip if gap ---
 810+ C4E3 4F                           LD   C, A
 811+ C4E4 26 00                        LD   H, 0
 811+ C4E6 6F             LD L, A
 812+ C4E7 ED 5B 4F D9                  LD   DE, (VDC_pSlots)
 813+ C4EB 19                           ADD  HL, DE
 814+ C4EC 7E                           LD   A, (HL)
 815+ C4ED FE 06                        CP   VDC_NUM_COLORS
 816+ C4EF 38 02                        JR   C, .not_gap
 817+ C4F1 37                           SCF                                    ; CF=1, skip
 818+ C4F2 C9                           RET
 819+ C4F3              .not_gap:
 820+ C4F3 79                           LD   A, C
 821+ C4F4              VDC_SlotPosAllowGap:
 822+ C4F4                              ; entry без gap-skip. Caller обязан передать A=i.
 823+ C4F4 CD B3 C4                     CALL VDC_SlotT                         ; HL = t
 824+ C4F7                              ; t < 0 → skip
 825+ C4F7 CB 7C                        BIT  7, H
 826+ C4F9 28 02                        JR   Z, .t_nonneg
 827+ C4FB 37                           SCF
 828+ C4FC C9                           RET
 829+ C4FD              .t_nonneg:
 830+ C4FD                              ; t >= NumSamples → clamp to NumSamples-1
 831+ C4FD E5                           PUSH HL
 832+ C4FE ED 5B 00 80                  LD   DE, (TrackData)                   ; NumSamples
 833+ C502 A7                           AND  A
 834+ C503 ED 52                        SBC  HL, DE
 835+ C505 E1                           POP  HL
 836+ C506 38 04                        JR   C, .t_in
 837+ C508 2A 00 80                     LD   HL, (TrackData)
 838+ C50B 2B                           DEC  HL
 839+ C50C              .t_in:          ; HL = t (clamped). Read the sample via a Core-resident helper
 840+ C50C                              ; (2-page track split lives there) so this hot path stays tiny —
 841+ C50C                              ; Main1/slot3 is nearly full. Core is always mapped in slot 1, so
 842+ C50C                              ; the tail-call resolves at runtime. Helper: out BC=X, DE=Y, CF=0,
 843+ C50C                              ; sets VDC_LastT / VDC_LastTangent.
 844+ C50C C3 7A 6A                     JP   VDC_ReadSampleAtHL
 845+ C50F
 846+ C50F              ; ============================================================================
 847+ C50F              ; VDC_TrySpawn — спавн нового шара в хвост (если разрешено).
 848+ C50F              ;   Условия: SlotsLen<MAX, BallsSpawned<TARGET, HSA>=SlotsLen, HSub==0.
 849+ C50F              ; ============================================================================
 850+ C50F              VDC_TrySpawn:
 851+ C50F                              ; Public entry: с HSub==0 gate (sync с Python try_spawn).
 852+ C50F                              ; Fast phase обходит gate через VDC_TrySpawn_NoHsubGate.
 853+ C50F 3A D1 6A                     LD   A, (VDC_HSub)
 854+ C512 B7                           OR   A
 855+ C513 C0                           RET  NZ
 856+ C514                              ; fallthrough
 857+ C514              VDC_TrySpawn_NoHsubGate:
 858+ C514                              ; Zuma bar full → spawn gate OFF (per wiki/manual).
 859+ C514                              ; Хвост перестаёт прирастать, остаётся доедать уже спавненные шары.
 860+ C514 3A DC 6A                     LD   A, (VDC_GaugeFull)
 861+ C517 B7                           OR   A
 862+ C518 C0                           RET  NZ
 863+ C519 3A D2 6A                     LD   A, (VDC_SlotsLen)
 864+ C51C FE F0                        CP   VDC_MAX_SLOTS
 865+ C51E D0                           RET  NC
 866+ C51F
 867+ C51F                              ; HSA < SlotsLen → не спавним (хвост не достиг старта)
 868+ C51F 3A D2 6A                     LD   A, (VDC_SlotsLen)
 869+ C522 47                           LD   B, A                              ; B = SlotsLen
 870+ C523 3A 43 D4                     LD   A, (VDC_HSA)
 871+ C526 B8                           CP   B
 872+ C527 D8                           RET  C
 873+ C528
 874+ C528                              ; SlotsLen > 0 AND offsets[tail-1] != 0 → не спавним (хвост ещё двигается).
 875+ C528 78                           LD   A, B
 876+ C529 B7                           OR   A
 877+ C52A 28 0C                        JR   Z, .spawn_no_tail_check
 878+ C52C 3D                           DEC  A
 879+ C52D 26 00                        LD   H, 0
 879+ C52F 6F             LD L, A
 880+ C530 ED 5B 51 D9                  LD   DE, (VDC_pOffsets)
 881+ C534 19                           ADD  HL, DE
 882+ C535 7E                           LD   A, (HL)
 883+ C536 B7                           OR   A
 884+ C537 C0                           RET  NZ
 885+ C538              .spawn_no_tail_check:
 886+ C538                              ; --- Level RNG:
 887+ C538                              ; RTC seconds seed only at VDC_Init. Runtime uses deterministic LFSR.
 888+ C538                              ; Per level setting: 50% single random color OR 50% same-color
 889+ C538                              ; chain of random color and random length 1..VDC_NUM_COLORS-1.
 890+ C538 3A 48 D4                     LD   A, (VDC_SpawnClusterRem)
 891+ C53B B7                           OR   A
 892+ C53C 28 0A                        JR   Z, .spawn_roll_new
 893+ C53E 3D                           DEC  A
 894+ C53F 32 48 D4                     LD   (VDC_SpawnClusterRem), A
 895+ C542 3A 47 D4                     LD   A, (VDC_SpawnClusterColor)
 896+ C545 47                           LD   B, A
 897+ C546 18 28                        JR   .spawn_color_ready
 898+ C548              .spawn_roll_new:
 899+ C548 CD 28 CE                     CALL VDC_RandomColor                   ; A = gate roll 0..NUM-1
 900+ C54B CB 47                        BIT  0, A                              ; odd/even ≈ 50/50 for NUM=6
 901+ C54D 28 13                        JR   Z, .spawn_single_random           ; 50% single random ball
 902+ C54F                              ; cluster path — reroll color until != предыдущий cluster.
 903+ C54F                              ; (VDC_SpawnClusterColor) = previous color (or sentinel #FF на init).
 904+ C54F              .cluster_color_reroll:
 905+ C54F CD 28 CE                     CALL VDC_RandomColor                   ; chain color candidate
 906+ C552 21 47 D4                     LD   HL, VDC_SpawnClusterColor
 907+ C555 BE                           CP   (HL)                              ; == previous?
 908+ C556 28 F7                        JR   Z, .cluster_color_reroll          ; → reroll
 909+ C558 77                           LD   (HL), A                           ; commit color
 910+ C559 CD 48 CE                     CALL VDC_RandomClusterLength           ; A = total length 1..NUM-1
 911+ C55C                                                                     ; (NB: ZL_Mul16x8 clobs B/C —
 912+ C55C                                                                     ; читаем color из памяти ниже)
 913+ C55C 3D                           DEC  A                                 ; current spawn is first ball
 914+ C55D 32 48 D4                     LD   (VDC_SpawnClusterRem), A
 915+ C560 18 0E                        JR   .spawn_color_ready
 916+ C562              .spawn_single_random:
 917+ C562                              ; single path — тоже reroll, чтобы два соседних кластера/single
 918+ C562                              ; никогда не были одного цвета.
 919+ C562              .single_color_reroll:
 920+ C562 CD 28 CE                     CALL VDC_RandomColor
 921+ C565 21 47 D4                     LD   HL, VDC_SpawnClusterColor
 922+ C568 BE                           CP   (HL)
 923+ C569 28 F7                        JR   Z, .single_color_reroll
 924+ C56B 77                           LD   (HL), A                           ; commit color
 925+ C56C AF                           XOR  A
 926+ C56D 32 48 D4                     LD   (VDC_SpawnClusterRem), A
 927+ C570              .spawn_color_ready:
 928+ C570 3A 47 D4                     LD   A, (VDC_SpawnClusterColor)        ; re-read color from memory
 929+ C573                                                                     ; (B клобан RandomColor/Mul16x8)
 930+ C573 47                           LD   B, A
 931+ C574                              ; B = chosen color. Не режем 3+ одинаковых на spawn: в оригинальной
 932+ C574                              ; Zuma цепь может иметь длинные серии, а match запускается только
 933+ C574                              ; от выстрела или физического закрытия gap через Shot2/cascade.
 934+ C574 78                           LD   A, B
 935+ C575 32 47 D4                     LD   (VDC_SpawnClusterColor), A
 936+ C578                              ; --- Slots[SlotsLen] = candidate ---
 937+ C578 3A D2 6A                     LD   A, (VDC_SlotsLen)
 938+ C57B 26 00                        LD   H, 0
 938+ C57D 6F             LD L, A
 939+ C57E ED 5B 4F D9                  LD   DE, (VDC_pSlots)
 940+ C582 19                           ADD  HL, DE
 941+ C583 70                           LD   (HL), B
 942+ C584
 943+ C584                              ; --- offsets[SlotsLen] = (SlotsLen>0) ? offsets[SlotsLen-1] : 0 ---
 944+ C584 3A D2 6A                     LD   A, (VDC_SlotsLen)
 945+ C587 B7                           OR   A
 946+ C588 28 0C                        JR   Z, .spawn_off_zero
 947+ C58A 3D                           DEC  A
 948+ C58B 26 00                        LD   H, 0
 948+ C58D 6F             LD L, A
 949+ C58E ED 5B 51 D9                  LD   DE, (VDC_pOffsets)
 950+ C592 19                           ADD  HL, DE
 951+ C593 46                           LD   B, (HL)                           ; B = offsets[len-1]
 952+ C594 18 02                        JR   .spawn_off_set
 953+ C596              .spawn_off_zero:
 954+ C596 06 00                        LD   B, 0
 955+ C598              .spawn_off_set:
 956+ C598 3A D2 6A                     LD   A, (VDC_SlotsLen)
 957+ C59B 26 00                        LD   H, 0
 957+ C59D 6F             LD L, A
 958+ C59E ED 5B 51 D9                  LD   DE, (VDC_pOffsets)
 959+ C5A2 19                           ADD  HL, DE
 960+ C5A3 70                           LD   (HL), B
 961+ C5A4
 962+ C5A4                              ; --- Shot2[SlotsLen] = 0 ---
 963+ C5A4                              ; Не ставим Shot2 на spawn — иначе cluster RNG с 50% repeat создаёт
 964+ C5A4                              ; 3+ same color и моментально auto-match'ит → chain не растёт.
 965+ C5A4                              ; В оригинальной Zuma spawn НЕ триггерит match — match только на
 966+ C5A4                              ; player insert или DoGapStep adjacency.
 967+ C5A4 3A D2 6A                     LD   A, (VDC_SlotsLen)
 968+ C5A7 26 00                        LD   H, 0
 968+ C5A9 6F             LD L, A
 969+ C5AA ED 5B 53 D9                  LD   DE, (VDC_pShot2)
 970+ C5AE 19                           ADD  HL, DE
 971+ C5AF 36 00                        LD   (HL), 0
 972+ C5B1
 973+ C5B1                              ; --- SlotsLen++, BallsSpawned++ ---
 974+ C5B1 21 D2 6A                     LD   HL, VDC_SlotsLen
 975+ C5B4 34                           INC  (HL)
 976+ C5B5 21 46 D4                     LD   HL, VDC_BallsSpawned
 977+ C5B8 34                           INC  (HL)
 978+ C5B9 20 01                        JR   NZ, .spawn_dbg_count
 979+ C5BB 35                           DEC  (HL)                              ; saturate at 255; never wrap into fast phase
 980+ C5BC              .spawn_dbg_count:
 981+ C5BC 21 72 D4                     LD   HL, VDC_DbgSpawnCnt               ; debug 2026-05-16: source-of-truth source
 982+ C5BF 34                           INC  (HL)
 983+ C5C0 C9                           RET                                    ; single-shot per tick (= Python коллеги).
 984+ C5C1                                                                     ; Множественный spawn даёт instant chain growth = дёрганость.
 985+ C5C1
 986+ C5C1              ; ============================================================================
 987+ C5C1              ; VDC_MoveChain — HSub++ если chain не frozen; wrap → HSA++.
 988+ C5C1              ; ============================================================================
 989+ C5C1              VDC_MoveChain:
 990+ C5C1 3A 44 D4                     LD   A, (VDC_ChainFreezeCnt)
 991+ C5C4 B7                           OR   A
 992+ C5C5 28 05                        JR   Z, .mc_no_freeze
 993+ C5C7 3D                           DEC  A
 994+ C5C8 32 44 D4                     LD   (VDC_ChainFreezeCnt), A
 995+ C5CB C9                           RET
 996+ C5CC              .mc_no_freeze:
 997+ C5CC 3A D1 6A                     LD   A, (VDC_HSub)
 998+ C5CF 3C                           INC  A
