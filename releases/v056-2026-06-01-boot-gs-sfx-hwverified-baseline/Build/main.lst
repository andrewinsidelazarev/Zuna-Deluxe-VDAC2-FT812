 304+ DF8B              ; ----------------------------------------------------------------------------
 305+ DF8B              ; Frog_SignedScale_div128 — signed (B*C) / 128, range ±127.
 306+ DF8B              ;   In:  B = signed multiplier, C = unsigned (0..127, обычно 0..24)
 307+ DF8B              ;   Out: A = signed result
 308+ DF8B              ; ----------------------------------------------------------------------------
 309+ DF8B              Frog_SignedScale_div128:
 310+ DF8B 78                             LD   A, B
 311+ DF8C 1E 00                          LD   E, 0                             ; sign flag
 312+ DF8E CB 7F                          BIT  7, A
 313+ DF90 28 03                          JR   Z, .pos
 314+ DF92 1C                             INC  E
 315+ DF93 ED 44                          NEG
 316+ DF95 57           .pos:             LD   D, A                             ; D = |B|
 317+ DF96 D5                             PUSH DE
 318+ DF97 59                             LD   E, C
 319+ DF98 CD C5 DF                       CALL Frog_Mul8x8u                     ; HL = |B|*C
 320+ DF9B D1                             POP  DE
 321+ DF9C CB 25                          SLA  L
 321+ DF9E CB 14          RL  H                        ; HL <<= 1; H = HL/128
 322+ DFA0 7C                             LD   A, H
 323+ DFA1 CB 43                          BIT  0, E
 324+ DFA3 C8                             RET  Z
 325+ DFA4 ED 44                          NEG
 326+ DFA6 C9                             RET
