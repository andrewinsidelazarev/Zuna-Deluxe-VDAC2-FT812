   7+ 1020              ;   Value? - one or more (EN_0000/EN_4000/EN_8000/EN_C000)
   8+ 1020              ; Out :
   9+ 1020              ; Corrupt :
  10+ 1020              ;  HL / (BC, A)
  11+ 1020              ; Note:
  12+ 1020              ; -----------------------------------------
  13+ 1020              Cache_Setting   macro Value?
  14+ 1020 ~                            ifdef MAPPING_REGISTERS
  15+ 1020 ~                            LD HL, FMADDR_REGS + HIGH CACHECONFIG
  16+ 1020 ~                            LD (HL), Value? & 0xFF
  17+ 1020 ~                            else
  18+ 1020 ~                            LD A, Value? & 0xFF
  19+ 1020 ~                            LD BC, CACHECONFIG
  20+ 1020 ~                            OUT (C), A
  21+ 1020 ~                            endif
  22+ 1020                              endm
  23+ 1020
  24+ 1020                              endif ; ~_CACHE_MACRO_
