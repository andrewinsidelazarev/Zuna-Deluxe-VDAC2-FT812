 197++C391              ;--- SD state ---
 198++C391 00 00 00 00  sd_lba          ds      4
 199++C395 00           sd_blkt         db      0
 200++C396 00 00 00 00  sd_lba_max      ds      4               ; верхняя граница LBA тома (PartLba+TotSec32); 0=выключено
