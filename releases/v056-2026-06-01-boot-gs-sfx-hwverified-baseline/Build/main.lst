2466  3B9A              .nnc_no_flag:
2467  3B9A                              ; Exclude BallColor from mask если popcount активных цветов >= 3.
2468  3B9A                              ; Юзер: «следующий шар лягушки» не должен совпадать с предыдущим
2469  3B9A                              ; (когда в цепи 3+ цветов; иначе чередование вынужденное).
2470  3B9A 3A E5 6A                     LD   A, (Core.Frog_BallColor)
2471  3B9D 32 0B 50                     LD   (FROG_EXCLUDE_COLOR_ADDR), A
2472  3BA0 3E FF                        LD   A, #FF                            ; sentinel: force fresh
2473  3BA2 CD CB 3A                     CALL Frog_FilteredRandomColor
2474  3BA5 32 E6 6A                     LD   (Core.Frog_NextBallColor), A
2475  3BA8 C9                           RET
2476  3BA9
2477  3BA9              ; ============================================================================
2478  3BA9              ; VDC_Random8 — LFSR Galois 16-bit (poly 0xB400), 8-bit uniform 0..255.
2479  3BA9              ; Тот же LFSR step что Core.VDC_RandomColor, но без AND-mask. Используется
2480  3BA9              ; Frog_FilteredRandomColor для unbiased mod-B через (rand * B) >> 8 — это
2481  3BA9              ; нужно когда popcount(mask) не степень двойки (B=3 в основном). Старый AND 3
2482  3BA9              ; + mod B давал bias 50%/25%/25% для popcount=3 → видимый перекос колора.
2483  3BA9              ; Разделяет Core.VDC_LfsrSeed с VDC_RandomColor (оба stepper'а двигают одну
2484  3BA9              ; и ту же последовательность атомарно — без корреляции).
2485  3BA9              ; ============================================================================
2486  3BA9              VDC_Random8:
2487  3BA9 2A 75 D4                     LD   HL, (Core.VDC_LfsrSeed)
2488  3BAC 7D                           LD   A, L
2489  3BAD E6 01                        AND  1
2490  3BAF CB 3C                        SRL  H
2490  3BB1 CB 1D          RR L
2491  3BB3 30 0A                        JR   NC, .r8_no_xor
2492  3BB5 16 B4                        LD   D, #B4
2492  3BB7 1E 00          LD E, 0
2493  3BB9 7C                           LD   A, H
2493  3BBA AA             XOR D
2493  3BBB 67             LD H, A
2494  3BBC 7D                           LD   A, L
2494  3BBD AB             XOR E
2494  3BBE 6F             LD L, A
2495  3BBF              .r8_no_xor:
2496  3BBF 22 75 D4                     LD   (Core.VDC_LfsrSeed), HL
2497  3BC2 7D                           LD   A, L
2498  3BC3 AC                           XOR  H                                 ; 8-bit uniform
2499  3BC4 C9                           RET
2500  3BC5
2501  3BC5              ; ----------------------------------------------------------------------------
2502  3BC5              ; ZX7 Turbo decompressor (Einar Saukas / Urusergi). HL = compressed src,
2503  3BC5              ; DE = destination. Восстановлен из ~/Desktop/Zuma Deluxe (src/ASM,
2504  3BC5              ; zuma_new_spg.asm:4466). Размер ~62 байта. Не корраптит I, IX, IY.
2505  3BC5              ; Используется через UnpackZX7Page wrapper. На входе HL/DE должны указывать
2506  3BC5              ; в WRITABLE области (исходник можно в slot 2 ROM-like, dest в RAM).
2507  3BC5              ; ----------------------------------------------------------------------------
2508  3BC5              Dzx7Turbo:
2509  3BC5 3E 80                        LD   A, #80
2510  3BC7              .zx7_copy_byte_loop:
2511  3BC7 ED A0                        LDI
2512  3BC9              .zx7_main_loop:
2513  3BC9 87                           ADD  A, A
2514  3BCA CC 1A 3C                     CALL Z, .zx7_load_bits
2515  3BCD 30 F8                        JR   NC, .zx7_copy_byte_loop
2516  3BCF D5                           PUSH DE
2517  3BD0 01 01 00                     LD   BC, 1
2518  3BD3 50                           LD   D, B
2519  3BD4              .zx7_len_size_loop:
2520  3BD4 14                           INC  D
2521  3BD5 87                           ADD  A, A
2522  3BD6 CC 1A 3C                     CALL Z, .zx7_load_bits
2523  3BD9 30 F9                        JR   NC, .zx7_len_size_loop
2524  3BDB C3 E8 3B                     JP   .zx7_len_value_start
2525  3BDE              .zx7_len_value_loop:
2526  3BDE 87                           ADD  A, A
2527  3BDF CC 1A 3C                     CALL Z, .zx7_load_bits
2528  3BE2 CB 11                        RL   C
2529  3BE4 CB 10                        RL   B
2530  3BE6 38 2D                        JR   C, .zx7_exit
2531  3BE8              .zx7_len_value_start:
2532  3BE8 15                           DEC  D
2533  3BE9 20 F3                        JR   NZ, .zx7_len_value_loop
2534  3BEB 03                           INC  BC
2535  3BEC 5E                           LD   E, (HL)
2536  3BED 23                           INC  HL
2537  3BEE CB 33                        DB   #CB, #33                          ; SLL E / SLS E (undoc)
2538  3BF0 30 1A                        JR   NC, .zx7_offset_end
2539  3BF2 87                           ADD  A, A
2540  3BF3 CC 1A 3C                     CALL Z, .zx7_load_bits
2541  3BF6 CB 12                        RL   D
2542  3BF8 87                           ADD  A, A
2543  3BF9 CC 1A 3C                     CALL Z, .zx7_load_bits
2544  3BFC CB 12                        RL   D
2545  3BFE 87                           ADD  A, A
2546  3BFF CC 1A 3C                     CALL Z, .zx7_load_bits
2547  3C02 CB 12                        RL   D
2548  3C04 87                           ADD  A, A
2549  3C05 CC 1A 3C                     CALL Z, .zx7_load_bits
2550  3C08 3F                           CCF
2551  3C09 38 01                        JR   C, .zx7_offset_end
2552  3C0B 14                           INC  D
2553  3C0C              .zx7_offset_end:
2554  3C0C CB 1B                        RR   E
2555  3C0E E3                           EX   (SP), HL
2556  3C0F E5                           PUSH HL
2557  3C10 ED 52                        SBC  HL, DE
2558  3C12 D1                           POP  DE
2559  3C13 ED B0                        LDIR
2560  3C15              .zx7_exit:
2561  3C15 E1                           POP  HL
2562  3C16 D2 C9 3B                     JP   NC, .zx7_main_loop
2563  3C19 C9                           RET
2564  3C1A              .zx7_load_bits:
2565  3C1A 7E                           LD   A, (HL)
2566  3C1B 23                           INC  HL
2567  3C1C 17                           RLA
2568  3C1D C9                           RET
2569  3C1E
2570  3C1E              ; ----------------------------------------------------------------------------
2571  3C1E              ; SCRATCH_PAGE — свободная SPG page для decomp output. Используется
2572  3C1E              ; UnpackAndUploadPage в Initialize между bg/balls/frog uploads.
2573  3C1E              ; Page #01 не задействован ни одним Block в spgbld_vdac2.ini — безопасно.
2574  3C1E              ; ----------------------------------------------------------------------------
2575  3C1E              SCRATCH_PAGE    EQU #01
2576  3C1E
2577  3C1E              ; ----------------------------------------------------------------------------
2578  3C1E              ; UnpackAndUploadPage: расжать compressed src page A → SCRATCH_PAGE,
2579  3C1E              ; залить 16K из SCRATCH_PAGE в FT_RAM_G по адресу (Core.BgRamH:BgRamL),
2580  3C1E              ; продвинуть указатель FT_RAM_G на +#4000.
2581  3C1E              ;
2582  3C1E              ; In:  A = compressed source SPG page; Core.BgRamH/L = FT_RAM_G dest 24-bit
2583  3C1E              ; Out: Core.BgRamH/L advanced by 16K
2584  3C1E              ; Slots after RET: slot 2 = src (not restored), slot 3 = current scene overlay
2585  3C1E              ; (Core.CurrentCodePage). Restoring slot 3 here keeps dumps and any call-side code
2586  3C1E              ; from observing the transient scratch page between compressed uploads.
2587  3C1E              ; ----------------------------------------------------------------------------
2588  3C1E              ; CurrentCodePage tracks which scene overlay is mapped in slot 3: #41 (UI =
2589  3C1E              ; menu/level-select) or #04 (gameplay). The shared slot0 decompressors below use
2590  3C1E              ; slot 3 as decomp scratch, then restore it to THIS page (not a hard-coded #04),
2591  3C1E              ; so they are correct from any scene. Maintained by the resident Fade* transitions;
2592  3C1E              ; boot default = UI overlay (first scene is the menu). Resident (slot 0/TSLib region).
2593  3C1E 41           CurrentCodePage:  DB UI_OVL_PAGE
2594  3C1F              UnpackAndUploadPage:
2595  3C1F F3                           DI
2596  3C20 32 73 3C                     LD   (.uaup_src), A
2597  3C23 ED 73 74 3C                  LD   (.uaup_saved_sp), SP
2598  3C27 31 B6 3C                     LD   SP, .uaup_temp_stack_top
2599  3C2A
2600  3C2A                              ; slot 2 = compressed src
2601  3C2A 3A 73 3C                     LD   A, (.uaup_src)
2601  3C2D 01 AF 12       LD BC, PAGE2
2601  3C30 ED 79          OUT (C), A
2602  3C32                              ; slot 3 = scratch (decomp dest)
2603  3C32 3E 01                        LD   A, SCRATCH_PAGE
2603  3C34 01 AF 13       LD BC, PAGE3
2603  3C37 ED 79          OUT (C), A
2604  3C39
2605  3C39                              ; Dzx7Turbo: HL=src, DE=dst
2606  3C39 21 00 80                     LD   HL, #8000
2607  3C3C 11 00 C0                     LD   DE, #C000
2608  3C3F CD C5 3B                     CALL Dzx7Turbo
2609  3C42
2610  3C42                              ; FT.WriteMem(HL=#C000 in slot 3, BC=16384, A:DE=FT_RAM_G addr)
2611  3C42 21 00 C0                     LD   HL, #C000
2612  3C45 01 00 40                     LD   BC, 16384
2613  3C48 3A C4 66                     LD   A, (Core.BgRamH)
2614  3C4B ED 5B C2 66                  LD   DE, (Core.BgRamL)
2615  3C4F CD 6A 12                     CALL FT.WriteMem
2616  3C52
2617  3C52                              ; Advance Core.BgRamL/H by 16K
2618  3C52 2A C2 66                     LD   HL, (Core.BgRamL)
2619  3C55 11 00 40                     LD   DE, #4000
2620  3C58 19                           ADD  HL, DE
2621  3C59 22 C2 66                     LD   (Core.BgRamL), HL
2622  3C5C 30 07                        JR   NC, .uaup_no_carry
2623  3C5E 3A C4 66                     LD   A, (Core.BgRamH)
2623  3C61 3C             INC A
2623  3C62 32 C4 66       LD (Core.BgRamH), A
2624  3C65              .uaup_no_carry:
2625  3C65 3A 1E 3C                     LD   A, (CurrentCodePage)
2625  3C68 01 AF 13       LD BC, PAGE3
2625  3C6B ED 79          OUT (C), A   ; restore slot 3 = current scene overlay (#41 ui / #04 gameplay)
2626  3C6D ED 7B 74 3C                  LD   SP, (.uaup_saved_sp)
2627  3C71 FB                           EI
2628  3C72 C9                           RET
2629  3C73 00           .uaup_src:        DB 0
2630  3C74 00 00        .uaup_saved_sp:   DW 0
2631  3C76 00 00 00...  .uaup_temp_stack: DEFS 64
2632  3CB6              .uaup_temp_stack_top:
2633  3CB6
2634  3CB6              ; ----------------------------------------------------------------------------
2635  3CB6              ; UnpackZX7Page: расжать compressed page A → dest page B.
2636  3CB6              ; Source = slot 2 (#8000), dest = slot 3 (#C000). После RET слоты восстановлены:
2637  3CB6              ; slot 2 → page 6 (TrackData), slot 3 → page #04 (main1_play).
2638  3CB6              ; Stack пересажен на uzx7_temp_stack чтобы LDIR в slot 3 не зацепил наш стек.
2639  3CB6              ; ----------------------------------------------------------------------------
2640  3CB6              UnpackZX7Page:
2641  3CB6 F3                           DI
2642  3CB7 32 F3 3C                     LD   (.uzx7_src), A
2643  3CBA 78                           LD   A, B
2643  3CBB 32 F4 3C       LD (.uzx7_dst), A
2644  3CBE ED 73 F5 3C                  LD   (.uzx7_saved_sp), SP
2645  3CC2 31 37 3D                     LD   SP, .uzx7_temp_stack_top
2646  3CC5 3A F3 3C                     LD   A, (.uzx7_src)
2646  3CC8 01 AF 12       LD BC, PAGE2
2646  3CCB ED 79          OUT (C), A
2647  3CCD 3A F4 3C                     LD   A, (.uzx7_dst)
2647  3CD0 01 AF 13       LD BC, PAGE3
2647  3CD3 ED 79          OUT (C), A
2648  3CD5 21 00 80                     LD   HL, #8000
2649  3CD8 11 00 C0                     LD   DE, #C000
2650  3CDB CD C5 3B                     CALL Dzx7Turbo
2651  3CDE 3E 06                        LD   A, 6
2651  3CE0 01 AF 12       LD BC, PAGE2
2651  3CE3 ED 79          OUT (C), A   ; restore slot 2 = TrackData page
2652  3CE5 3A 1E 3C                     LD   A, (CurrentCodePage)
2652  3CE8 01 AF 13       LD BC, PAGE3
2652  3CEB ED 79          OUT (C), A   ; restore slot 3 = current scene overlay (#41 ui / #04 gameplay)
2653  3CED ED 7B F5 3C                  LD   SP, (.uzx7_saved_sp)
2654  3CF1 FB                           EI
2655  3CF2 C9                           RET
2656  3CF3 00           .uzx7_src:        DB 0
2657  3CF4 00           .uzx7_dst:        DB 0
2658  3CF5 00 00        .uzx7_saved_sp:   DW 0
2659  3CF7 00 00 00...  .uzx7_temp_stack: DEFS 64
2660  3D37              .uzx7_temp_stack_top:
2661  3D37
2662  3D37              ; ----------------------------------------------------------------------------
2663  3D37              ; SafeInflatePage2: FT812 CMD_INFLATE with compressed source mapped in PAGE2.
2664  3D37              ;
2665  3D37              ; TSLib FT.Coprocessor.Inflate maps source pages into PAGE3/#C000, which is also
2666  3D37              ; our main1_play code slot. Fresh host dumps showed CPU HALT while PAGE3 was a
2667  3D37              ; zlib preview page (#F1). This variant keeps PAGE3 untouched and streams the
2668  3D37              ; source from PAGE2/#8000 instead.
2669  3D37              ;
2670  3D37              ; In: same convention as FT.Coprocessor.Inflate for current callers:
2671  3D37              ;   A:DE = RAM_G destination, BC = compressed byte count, HL = source offset,
2672  3D37              ;   A' = source SPG page. Current assets are all <64K compressed.
2673  3D37              ; Out: CF set only if coprocessor write reports fault.
2674  3D37              ; Slots after RET: PAGE2 restored to previous value; PAGE3 unchanged.
2675  3D37              ; ----------------------------------------------------------------------------
2676  3D37              SafeInflatePage2:
2677  3D37 CD 48 14                     CALL FT.Coprocessor.WaitFlush
2678  3D3A D8                           RET  C
2679  3D3B
2680  3D3B E5                           PUSH HL
2681  3D3C D5                           PUSH DE
2682  3D3D                              FT_WR32_CMD FT_CMD_INFLATE
2682  3D3D 21 FF FF    >                LD HL, (FT_CMD_INFLATE >> 16) & 0xFFFF
2682  3D40 11 22 FF    >                LD DE, FT_CMD_INFLATE & 0xFFFF
2682  3D43 CD F6 12    >                CALL FT.Coprocessor.Write32
2683  3D46 D1                           POP  DE
2684  3D47
2685  3D47 26 00                        LD   H, #00
2686  3D49 6F                           LD   L, A
2687  3D4A CD F6 12                     CALL FT.Coprocessor.Write32
2688  3D4D D8                           RET  C
2689  3D4E
2690  3D4E                              GetPage2
2690  3D4E             >                ifdef MAPPING_REGISTERS
2690  3D4E 3A 12 04    >                LD A, (FMADDR_REGS + HIGH PAGE2)
2690  3D51             >                else
2690  3D51 ~           >                LD A, (MemoryPages + 2)
2690  3D51             >                endif
2691  3D51 32 AB 3D                     LD   (.sip2_saved_page2), A
2692  3D54 E1                           POP  HL
2693  3D55
2694  3D55                              ; Move source address from page-local #0000..#3FFF into slot2
2695  3D55                              ; address space #8000..#BFFF.
2696  3D55 7C                           LD   A, H
2697  3D56 F6 80                        OR   %10000000
2698  3D58 67                           LD   H, A
2699  3D59 08                           EX   AF, AF'
2700  3D5A 32 AC 3D                     LD   (.sip2_src_page), A
2701  3D5D 08                           EX   AF, AF'
2702  3D5E
2703  3D5E 3A AC 3D     .loop:          LD   A, (.sip2_src_page)
2704  3D61                              SetPage2_A
2704  3D61             >                ifdef MAPPING_REGISTERS
2704  3D61 32 12 04    >                LD (FMADDR_REGS + HIGH PAGE2), A
2704  3D64             >                else
2704  3D64 ~           >                LD (MemoryPages + 2), A
2704  3D64 ~           >                LD BC, PAGE2
2704  3D64 ~           >                OUT (C), A
2704  3D64             >                endif
2705  3D64
2706  3D64 E5                           PUSH HL                              ; source CPU address
2707  3D65 7C                           LD   A, H
2708  3D66 E6 3F                        AND  %00111111
2709  3D68 67                           LD   H, A
2710  3D69 EB                           EX   DE, HL                          ; DE = offset in page
2711  3D6A 21 00 40                     LD   HL, #4000
2712  3D6D B7                           OR   A
2713  3D6E ED 52                        SBC  HL, DE
2714  3D70 EB                           EX   DE, HL                          ; DE = bytes to page end
2715  3D71
2716  3D71 60                           LD   H, B
2717  3D72 69                           LD   L, C                            ; HL = remaining total
2718  3D73 B7                           OR   A
2719  3D74 ED 52                        SBC  HL, DE
2720  3D76 30 09                        JR   NC, .page_chunk
2721  3D78
2722  3D78 19                           ADD  HL, DE                          ; HL = final chunk bytes
2723  3D79 44                           LD   B, H
2724  3D7A 4D                           LD   C, L
2725  3D7B 21 00 00                     LD   HL, #0000                       ; no remainder
2726  3D7E 37                           SCF                                  ; align final packet
2727  3D7F 18 03                        JR   .write_chunk
2728  3D81
2729  3D81 42           .page_chunk:    LD   B, D
2730  3D82 4B                           LD   C, E                            ; BC = chunk bytes
2731  3D83 B7                           OR   A                               ; not final, no align
2732  3D84
2733  3D84 E3           .write_chunk:   EX   (SP), HL                         ; HL=source, stack=remainder
2734  3D85 CD 9E 12                     CALL FT.Coprocessor.Write
2735  3D88 C1                           POP  BC                              ; BC = remaining total
2736  3D89 38 18                        JR   C, .restore_error
2737  3D8B 78                           LD   A, B
2738  3D8C B1                           OR   C
2739  3D8D 28 0C                        JR   Z, .restore_ok
2740  3D8F
2741  3D8F 21 00 80                     LD   HL, #8000
2742  3D92 3A AC 3D                     LD   A, (.sip2_src_page)
2743  3D95 3C                           INC  A
2744  3D96 32 AC 3D                     LD   (.sip2_src_page), A
2745  3D99 18 C3                        JR   .loop
2746  3D9B
2747  3D9B 3A AB 3D     .restore_ok:    LD   A, (.sip2_saved_page2)
2748  3D9E                              SetPage2_A
2748  3D9E             >                ifdef MAPPING_REGISTERS
2748  3D9E 32 12 04    >                LD (FMADDR_REGS + HIGH PAGE2), A
2748  3DA1             >                else
2748  3DA1 ~           >                LD (MemoryPages + 2), A
2748  3DA1 ~           >                LD BC, PAGE2
2748  3DA1 ~           >                OUT (C), A
2748  3DA1             >                endif
2749  3DA1 B7                           OR   A
2750  3DA2 C9                           RET
2751  3DA3 3A AB 3D     .restore_error: LD   A, (.sip2_saved_page2)
2752  3DA6                              SetPage2_A
2752  3DA6             >                ifdef MAPPING_REGISTERS
2752  3DA6 32 12 04    >                LD (FMADDR_REGS + HIGH PAGE2), A
2752  3DA9             >                else
2752  3DA9 ~           >                LD (MemoryPages + 2), A
2752  3DA9 ~           >                LD BC, PAGE2
2752  3DA9 ~           >                OUT (C), A
2752  3DA9             >                endif
2753  3DA9 37                           SCF
2754  3DAA C9                           RET
2755  3DAB 00           .sip2_saved_page2: DB 0
2756  3DAC 00           .sip2_src_page:    DB 0
2757  3DAD
