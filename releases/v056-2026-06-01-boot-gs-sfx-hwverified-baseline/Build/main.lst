 264+ C2B8              MenuAdvanceSky:
 265+ C2B8                              ; pos += шаг (в 1/16 px); если pos >= W*16 — вычесть W*16 (плавный wrap
 266+ C2B8                              ; без потери остатка). Шаг << W*16, поэтому одного вычитания хватает.
 267+ C2B8 2A 42 CD                     LD   HL, (MenuSkyPos)
 268+ C2BB 11 0B 00                     LD   DE, MENU_SKY_SCROLL16
 269+ C2BE 19                           ADD  HL, DE
