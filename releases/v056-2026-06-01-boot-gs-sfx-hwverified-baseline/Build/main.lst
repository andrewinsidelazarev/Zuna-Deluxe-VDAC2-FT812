 339+ C396
 340+ C396              ; ----------------------------------------------------------------------------
 341+ C396              ; Клавиатурная навигация главного меню. Активные кнопки (порядок навигации):
 342+ C396              ;   0 = Adventure, 1 = More (Gauntlet/Options/Quit без действия — пропущены).
 343+ C396              ; Вверх/Вниз ходят по списку (по просьбе юзера ТОЛЬКО Вверх/Вниз — Влево/Вправо в
 344+ C396              ;   этом меню НЕ участвуют). Огонь = нажатие текущей кнопки (тот же Click-флаг, что
 345+ C396              ;   и мышь).
 346+ C396              ; Зовётся ПОСЛЕ MenuUpdateButtons (тот сбросил Click-флаги и проставил hover мышью).
 347+ C396              ; ----------------------------------------------------------------------------
 348+ C396              MenuKeyboardNav:
 349+ C396                              ; nav-вверх = Up
 350+ C396 CD 37 76                     CALL Input_Up
 351+ C399 21 56 CD                     LD   HL, MenuKbdUpPrev
 352+ C39C CD 8B 76                     CALL Input_EdgeZ
 353+ C39F 28 0A                        JR   Z, .chk_down
 354+ C3A1 3A 55 CD                     LD   A, (MenuSelection)
 355+ C3A4 B7                           OR   A
 356+ C3A5 28 04                        JR   Z, .chk_down                          ; уже на верхней (Adventure)
 357+ C3A7 3D                           DEC  A
 358+ C3A8 32 55 CD                     LD   (MenuSelection), A
 359+ C3AB              .chk_down:      ; nav-вниз = Down
 360+ C3AB CD 46 76                     CALL Input_Down
 361+ C3AE 21 57 CD                     LD   HL, MenuKbdDownPrev
 362+ C3B1 CD 8B 76                     CALL Input_EdgeZ
