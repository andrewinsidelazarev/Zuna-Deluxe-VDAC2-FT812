 306+ EC11
 307+ EC11                              ; ============================================================
 308+ EC11                              ; Frog composition — SKIP при показанном dialog (states 1/2/3).
 309+ EC11                              ; Draw during PLAY (0) AND during pause fade-out (4): the frog
 310+ EC11                              ; appears from the first fade frame so it is ready when the
 311+ EC11                              ; window finishes fading and PLAY resumes.
 312+ EC11                              ; ============================================================
 313+ EC11 3A D6 6A                     LD   A, (Core.VDC_DialogState)
 314+ EC14 B7                           OR   A
 315+ EC15 28 04                        JR   Z, .draw_frog
 316+ EC17 FE 04                        CP   4
 317+ EC19 20 19                        JR   NZ, .skip_frog
 318+ EC1B              .draw_frog:
 319+ EC1B                              if ZL_FROG_DRAW_ENABLED
 320+ EC1B AF                           XOR  A
 321+ EC1C CD CA 13                     CALL FT.Coprocessor.Cell
 322+ EC1F                              if ZL_FROG_DRAW_PLATE
 323+ EC1F CD D9 DF                     CALL Frog_DrawPlate
 324+ EC22                              endif
 325+ EC22                              if ZL_FROG_DRAW_BODY
 326+ EC22 CD 55 E0                     CALL Frog_DrawBody
 327+ EC25                              endif
 328+ EC25                              if ZL_FROG_DRAW_TONGUE
 329+ EC25 CD D9 E0                     CALL Frog_DrawTongue
 330+ EC28                              endif
 331+ EC28                              if ZL_FROG_DRAW_BALL_NOW
 332+ EC28 CD 9B E2                     CALL Frog_DrawBallNow                  ; в рот, на pos+ballExpand·dir
 333+ EC2B                              endif
 334+ EC2B                              if ZL_FROG_DRAW_NEXT_BALL
 335+ EC2B CD 3D E3                     CALL Frog_DrawNextBall                 ; на спине, pos-28·dir
 336+ EC2E                              endif
 337+ EC2E                              if ZL_FROG_DRAW_OVERLAY
 338+ EC2E CD CC E1                     CALL Frog_DrawFaceOverlay              ; face overlay поверх всего
 339+ EC31                              endif
 340+ EC31                              endif
 341+ EC31
 342+ EC31 CD 63 E7                     CALL Bullet_Draw                       ; flying ball, if active
 343+ EC34              .skip_frog:
 344+ EC34
 345+ EC34                              ; ============================================================
 346+ EC34                              ; Цепь шаров — PALETTED4444 dual handle (cell<128 handle 0, ≥128 handle 9).
 347+ EC34                              ; Palette ARGB4 (256 × 2 = 512 байт) в FT_RAM_G #080000.
 348+ EC34                              ; FT_PaletteSource устанавливает указатель для текущей primitive.
 349+ EC34                              ; ============================================================
 350+ EC34                              if !BALLS_ARGB4_ENABLED
 351+ EC34 ~                            FT_PaletteSource BALLS_PALETTE_RAMG
 352+ EC34 ~                            LD   A, 9
