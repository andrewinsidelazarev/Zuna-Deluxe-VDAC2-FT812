 157+ E90B              ; ----------------------------------------------------------------------------
 158+ E90B              ; Log_Init и LogEvent — в slot 0 (page 0) после TSLib (main.asm). Перенесены
 159+ E90B              ; туда из-за переполнения Core 8 KB предела. См. main.asm.
 160+ E90B              ; ----------------------------------------------------------------------------
 161+ E90B
 162+ E90B              ; ----------------------------------------------------------------------------
 163+ E90B              ; ZL_DrawFrame — собрать DL-команды текущего кадра
 164+ E90B              ; ----------------------------------------------------------------------------
 165+ E90B              ZL_BALL_DIAM_PX  EQU 32                               ; atlas cell size (BitmapLayout/Size)
 166+ E90B              ZL_BALL_VISIBLE  EQU ZL_BALL_DIAM_PX                  ; visible diameter = atlas cell (без alpha-padding)
 167+ E90B              ZL_BALL_W        EQU ZL_BALL_DIAM_PX                  ; native classic ball cell
 168+ E90B              ZL_BALL_H        EQU ZL_BALL_DIAM_PX
 169+ E90B              ZL_BALL_HALF     EQU ZL_BALL_DIAM_PX / 2              ; центр rect'а (= pivot для cmd_rotate)
 170+ E90B              ; --- Spin physics: rolling-without-slip связь между движением t и phase atlas ---
 171+ E90B              ; t — позиция шара на треке в track samples. Phase меняется ТОЛЬКО когда t движется
 172+ E90B              ; → автоматически пропорционально скорости шаров (быстрее цепь → быстрее phase).
 173+ E90B              ;
 174+ E90B              ; Формула: spin_frame = ((t * K) >> 8) & (ATLAS_PHASES-1), где
 175+ E90B              ;   K = 256 * ATLAS_PHASES / (π * D_samples)
 176+ E90B              ; t измеряется в track samples. Физически точное rolling-without-slip для D=VDC_CELL_SIZE
 177+ E90B              ; даёт K≈41, но при текущей скорости цепи это визуально слишком медленно для Zuma-feel.
 178+ E90B              ; Поэтому используем визуальный период в 2 раза короче: D_samples = VDC_CELL_SIZE/2.
 179+ E90B              ; Для CELL_SIZE=32, phases=16:
 180+ E90B              ;   K = 256*16*113/(355*16) ≈ 81.49 → 81.
 181+ E90B              ;
 182+ E90B              ; K держится в RAM (ZL_SpinK) — runtime, можно менять per-level. Default = compile-time.
 183+ E90B                              if BALLS_ARGB4_ENABLED
 184+ E90B              ZL_ATLAS_PHASES            EQU 16
 185+ E90B                              else
 186+ E90B ~            ZL_ATLAS_PHASES            EQU 32
 187+ E90B                              endif
 188+ E90B              ZL_SPIN_DIAM_SAMPLES       EQU VDC_CELL_SIZE / 2
 189+ E90B              ZL_SPIN_K_NUM              EQU 256 * ZL_ATLAS_PHASES * 113
 190+ E90B              ZL_SPIN_K_DEN              EQU 355 * ZL_SPIN_DIAM_SAMPLES
 191+ E90B              ZL_SPIN_K_DEFAULT          EQU (ZL_SPIN_K_NUM + ZL_SPIN_K_DEN / 2) / ZL_SPIN_K_DEN
 192+ E90B              ZL_SPIN_MASK               EQU ZL_ATLAS_PHASES - 1
 193+ E90B
 194+ E90B              ; --- Bucket-based tangent rotation: цепь группирована по buckets, 1 cmd_rotate per bucket.
 195+ E90B              ; ZL_BUCKETS = 8/16/32/64. Чем больше — тем плавнее rotation, но больше cmd_rotate/frame.
 196+ E90B              ; bucket = (tangent + step/2) / step mod N. step = 256/N BRAD.
 197+ E90B              ZL_BUCKETS      EQU 32                                ; (dead-code legacy; per-ball replaced bucket loop 2026-05-18)
 198+ E90B
 199+ E90B              ; --- PALETTED4444 dual handle: 6×32 = 192 cells > 128 → split в 2 handle.
 200+ E90B              ; Handle 0 source = BALLS_RAMG_ADDR (cells 0..127).
 201+ E90B              ; Handle 9 source = BALLS_RAMG_ADDR + 128 × ZL_BALL_W × ZL_BALL_H (cells 0..63 = global 128..191).
 202+ E90B              BALLS_HANDLE9_OFFSET EQU 128 * ZL_BALL_W * ZL_BALL_H        ; PALETTED = 1 byte/pixel cell
 203+ E90B              ZL_DESTROY_HANDLE EQU 10                             ; match-3 серый animBallDestroy
 204+ E90B              ZL_DESTROY_W      EQU 48
 205+ E90B              ZL_DESTROY_H      EQU 48
 206+ E90B              ZL_DESTROY_HALF_DELTA EQU ((ZL_DESTROY_W - ZL_BALL_W) / 2) * 16
 207+ E90B              ZL_DESTROY_FRAMES EQU 13                              ; match-3 destroy: 13 кадров
 208+ E90B              ; WIN-взрыв (оранжевый HD-ref animExplosion) — ОТДЕЛЬНЫЙ атлас/handle/RAM_G:
 209+ E90B              ZL_WINEXP_HANDLE  EQU 26                              ; свободный bitmap handle
 210+ E90B              ZL_WINEXP_FRAMES  EQU 17                              ; HD-ref animExplosion: 17 кадров
 211+ E90B              ZL_WINEXP_DRAW    EQU 80                              ; экранный размер взрыва (≈2.5× шара 32; оригинал scale 1.5×100)
 212+ E90B              ZL_WINEXP_XOFF    EQU 1                               ; manual screen offset from winexp_offset_tool.py
 213+ E90B              ZL_WINEXP_YOFF    EQU -2
 214+ E90B              ZL_BG_W         EQU 400                               ; native bg storage, upscaled to 640x480
 215+ E90B              ZL_BG_H         EQU 300
 216+ E90B              ZL_BG_DRAW_W    EQU 640
 217+ E90B              ZL_BG_DRAW_H    EQU 480
 218+ E90B              ZL_BG_SCALE     EQU #0001999A                         ; 1.6 in f16.16
 219+ E90B              ZL_BG_HANDLE    EQU 1
