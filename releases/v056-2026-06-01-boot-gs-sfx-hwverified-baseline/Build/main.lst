2519+ CE28              ; VDC_DivHLbyA — целочисленное деление 16-bit на 8-bit.
2520+ CE28              ;   In:  HL = dividend (unsigned), A = divisor (unsigned, > 0)
2521+ CE28              ;   Out: HL = quotient, A = remainder
2522+ CE28              ;   Clobbers BC.
2523+ CE28              ; Bit-by-bit алгоритм. ~80 t-states, ~16 байт кода.
2524+ CE28              ; ============================================================================
2525+ CE28              ; [VDC_DivHLbyA -> moved to shared_render.asm (resident; shared by gameplay #04 + level-select #41)]
2526+ CE28              VDC_RandomColor:
2527+ CE28                              ; Mul-then-shift: A = ((L XOR H) * NUM_COLORS) >> 8 = 0..NUM-1.
2528+ CE28                              ; Старый AND 7 + reject имел LFSR-bias для poly 0xB400: (L XOR H) & 7
2529+ CE28                              ; почти не выдавал значения 2 и 5 (биты коррелированы) → цвета 2 и 5
2530+ CE28                              ; не появлялись в цепи. Mul-then-shift bias ≤ 1.4% при NUM=6.
2531+ CE28                              ; Fix 2026-05-18.
