1025+ F23D              ; ----------------------------------------------------------------------------
1026+ F23D              ; ZL_Mul16x8 — unsigned 16x8 multiply, low 16 bits of result.
1027+ F23D              ;   In:  HL = multiplicand (unsigned 16-bit), A = multiplier (unsigned 8-bit)
1028+ F23D              ;   Out: HL = (HL_in * A_in) & #FFFF
1029+ F23D              ;   Scratch: BC, A, F. ~14 байт, ~155 t-states avg.
1030+ F23D              ;   Используется для runtime K в spin formula (по 1 вызову на шар цепи).
1031+ F23D              ; ----------------------------------------------------------------------------
1032+ F23D 4D           ZL_Mul16x8:     LD   C, L
1032+ F23E 44             LD B, H                   ; BC = multiplicand
1033+ F23F 21 00 00                     LD   HL, 0                             ; HL = accumulator
1034+ F242 16 08                        LD   D, 8                             ; bit counter
1035+ F244 29           .lp:            ADD  HL, HL                            ; HL <<= 1
1036+ F245 87                           ADD  A, A                             ; CF = top bit of multiplier
1037+ F246 30 01                        JR   NC, .skip
1038+ F248 09                           ADD  HL, BC                            ; if bit set → +BC
1039+ F249 15           .skip:          DEC  D
1040+ F24A 20 F8                        JR   NZ, .lp
1041+ F24C C9                           RET
1042+ F24D
1043+ F24D              ; ----------------------------------------------------------------------------
1044+ F24D              ; ZL_SpinPhase — A = ((t * ZL_SPIN_K_DEFAULT) >> 8) & ZL_SPIN_MASK.
1045+ F24D              ;   In: HL = VDC_LastT. Out: A = spin phase. Scratch: BC, DE, HL, AF.
1046+ F24D              ;   Current ARGB4 build has K=81, so avoid the 8-iteration generic multiply in
1047+ F24D              ;   the per-ball render hot path. If compile-time K changes, fall back safely.
1048+ F24D              ; ----------------------------------------------------------------------------
1049+ F24D              ZL_SpinPhase:
1050+ F24D                              if ZL_SPIN_K_DEFAULT = 81
1051+ F24D 54                           LD   D, H
1051+ F24E 5D             LD E, L                    ; DE = t
1052+ F24F 29                           ADD  HL, HL
1053+ F250 29                           ADD  HL, HL
1054+ F251 29                           ADD  HL, HL
1055+ F252 29                           ADD  HL, HL                            ; HL = t * 16
1056+ F253 44                           LD   B, H
1056+ F254 4D             LD C, L                    ; BC = t * 16
1057+ F255 29                           ADD  HL, HL
1058+ F256 29                           ADD  HL, HL                            ; HL = t * 64
1059+ F257 09                           ADD  HL, BC                            ; HL = t * 80
1060+ F258 19                           ADD  HL, DE                            ; HL = t * 81
1061+ F259 7C                           LD   A, H
1062+ F25A E6 0F                        AND  ZL_SPIN_MASK
1063+ F25C C9                           RET
1064+ F25D                              else
1065+ F25D ~                            LD   A, (ZL_SpinK)
1066+ F25D ~                            CALL ZL_Mul16x8
1067+ F25D ~                            LD   A, H
1068+ F25D ~                            AND  ZL_SPIN_MASK
1069+ F25D ~                            RET
1070+ F25D                              endif
