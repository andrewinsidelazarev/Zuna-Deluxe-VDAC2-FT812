1985  32A7 0E 2F        .fs24_digit:    LD   C, '0' - 1
1986  32A9 0C           .fs24_sub:      INC  C
1987  32AA 3A 30 33                     LD   A, (Score24Work)
1987  32AD DD 96 00       SUB (IX+0)
1987  32B0 32 30 33       LD (Score24Work), A
1988  32B3 3A 31 33                     LD   A, (Score24Work + 1)
1988  32B6 DD 9E 01       SBC A, (IX+1)
1988  32B9 32 31 33       LD (Score24Work + 1), A
1989  32BC 3A 32 33                     LD   A, (Score24Work + 2)
1989  32BF DD 9E 02       SBC A, (IX+2)
1989  32C2 32 32 33       LD (Score24Work + 2), A
1990  32C5 30 E2                        JR   NC, .fs24_sub                     ; no borrow -> subtract again
1991  32C7 3A 30 33                     LD   A, (Score24Work)
1991  32CA DD 86 00       ADD A, (IX+0)
1991  32CD 32 30 33       LD (Score24Work), A    ; add divisor back once
1992  32D0 3A 31 33                     LD   A, (Score24Work + 1)
1992  32D3 DD 8E 01       ADC A, (IX+1)
1992  32D6 32 31 33       LD (Score24Work + 1), A
1993  32D9 3A 32 33                     LD   A, (Score24Work + 2)
1993  32DC DD 8E 02       ADC A, (IX+2)
1993  32DF 32 32 33       LD (Score24Work + 2), A
1994  32E2 79                           LD   A, C
1995  32E3 2A 33 33                     LD   HL, (Score24OutPtr)
1996  32E6 77                           LD   (HL), A
1997  32E7 23                           INC  HL
1998  32E8 22 33 33                     LD   (Score24OutPtr), HL
1999  32EB DD 23                        INC  IX
1999  32ED DD 23          INC IX
1999  32EF DD 23          INC IX
2000  32F1 10 B4                        DJNZ .fs24_digit
2001  32F3 AF                           XOR  A
2002  32F4 2A 33 33                     LD   HL, (Score24OutPtr)
2003  32F7 77                           LD   (HL), A                           ; null terminate
