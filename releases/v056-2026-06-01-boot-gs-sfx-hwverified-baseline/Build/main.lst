 378+ EC9B CD DE C1                     CALL VDC_SwapChains
 379+ EC9E CD 38 5F                     CALL SetSecondTrackPage
 380+ ECA1 0E FF                        LD   C, 255
 380+ ECA3 16 FF          LD D, 255
 380+ ECA5 1E FF          LD E, 255
 381+ ECA7 CD 6E 13                     CALL FT.Coprocessor.ColorRGB
 382+ ECAA CD B6 EC                     CALL ZL_DrawActiveChain
 383+ ECAD CD DE C1                     CALL VDC_SwapChains
 384+ ECB0 CD 26 5F                     CALL SetCurrentTrackPage
 385+ ECB3 C3 8F EF                     JP   ZL_AfterChains
