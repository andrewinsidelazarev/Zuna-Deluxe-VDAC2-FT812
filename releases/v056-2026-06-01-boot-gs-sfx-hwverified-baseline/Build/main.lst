 550+ C7D1              ; MenuSinShiftHL — HL = sign-extend( MenuSunSinTable[A] >> B ).  A=индекс фазы (0..255),
 551+ C7D1              ; B=кол-во арифм. сдвигов вправо (>=1). Таблица локальная (overlay #41), т.к. меню НЕ
 552+ C7D1              ; видит gameplay-овский Frog_SinTable (#04). Клобает AF, DE, B, HL.
 553+ C7D1              MenuSinShiftHL:
 554+ C7D1 5F                           LD   E, A
 555+ C7D2 16 00                        LD   D, 0
 556+ C7D4 21 E2 C7                     LD   HL, MenuSunSinTable
 557+ C7D7 19                           ADD  HL, DE
 558+ C7D8 7E                           LD   A, (HL)
 559+ C7D9 CB 2F        .mss_shift:     SRA  A
 560+ C7DB 10 FC                        DJNZ .mss_shift
 561+ C7DD 6F                           LD   L, A                              ; младший байт
 562+ C7DE 87                           ADD  A, A                              ; CF = знак
 563+ C7DF 9F                           SBC  A, A                              ; A = #FF (отриц.) / #00 (полож.)
 564+ C7E0 67                           LD   H, A
 565+ C7E1 C9                           RET
