 531+ C343              .upd_preview:   ; tick countdown, на 0 → CLOSING
 532+ C343 3A 50 D4                     LD   A, (VDC_PreviewTick)
 533+ C346 3D                           DEC  A
 534+ C347 32 50 D4                     LD   (VDC_PreviewTick), A
 535+ C34A C0                           RET  NZ
 536+ C34B 3E 05                        LD   A, VDC_STATE_CLOSING
 537+ C34D 32 D0 6A                     LD   (VDC_GameState), A
