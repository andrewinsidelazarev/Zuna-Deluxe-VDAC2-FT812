1269+ F65B              ; ZL_EmitBallMatrixFromBRAD — LDIR matrix block в CMD буфер.
1270+ F65B              ;   In: A = BRAD (0..255), любые битья. Внутри квантуется к 8 BRAD (32 buckets).
1271+ F65B              ;   Out: matrix эмитнут в FT BufferPtr.
1272+ F65B              ;   Clobbers: AF, BC, DE, HL.
1273+ F65B              ; Reusable между chain rendering и FrogBallNow / прочими 32×32 sprites.
1274+ F65B              ; ----------------------------------------------------------------------------
1275+ F65B              ZL_EmitBallMatrixFromBRAD:
1276+ F65B E6 F0                        AND  #F0                                ; quantize to 16 BRAD (uses even entries in 8-BRAD LUT)
