 401+ ECD1 79                           LD   A, C
 402+ ECD2 16 00                        LD   D, 0
 402+ ECD4 5F             LD E, A
 403+ ECD5 E5                           PUSH HL                               ; save cache ptr (DE = i)
 404+ ECD6 2A 4F D9                     LD   HL, (VDC_pSlots)
 405+ ECD9 19                           ADD  HL, DE
