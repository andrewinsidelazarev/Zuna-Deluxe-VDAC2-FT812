1919  3238              ; ============================================================================
1920  3238              ; 24-bit cumulative score (Core.VDC_PlayerScore, 3-byte LE) + 50000 extra-life.
1921  3238              ; Resident (slot 0), so callable from gameplay (#04) and resident win/HUD code.
1922  3238              ; ----------------------------------------------------------------------------
1923  3238              ; Score_Add24 — VDC_PlayerScore += HL (16-bit delta), then award extra lives.
1924  3238              ;   In: HL = points to add. Clobbers AF, DE, HL (NOT BC).
1925  3238              ; ----------------------------------------------------------------------------
1926  3238              Score_Add24:
1927  3238 ED 5B DD 6A                  LD   DE, (Core.VDC_PlayerScore)        ; DE = low 16 bits
1928  323C 19                           ADD  HL, DE                            ; CF = carry out of low 16
1929  323D 22 DD 6A                     LD   (Core.VDC_PlayerScore), HL        ; store low 16 (LD keeps CF)
1930  3240 3A DF 6A                     LD   A, (Core.VDC_PlayerScore + 2)
1931  3243 CE 00                        ADC  A, 0                              ; += carry into byte 2
1932  3245 32 DF 6A                     LD   (Core.VDC_PlayerScore + 2), A
1933  3248                              ; fall through to extra-life check
1934  3248              ; ----------------------------------------------------------------------------
1935  3248              ; Score_CheckExtraLife — while score >= NextLifeScore: VDC_Lives++, threshold += 50000.
1936  3248              ; ----------------------------------------------------------------------------
1937  3248              Score_CheckExtraLife:
1938  3248 2A DD 6A     .cel_loop:      LD   HL, (Core.VDC_PlayerScore)        ; low 16 of score
1939  324B ED 5B E0 6A                  LD   DE, (Core.NextLifeScore)
1940  324F A7                           AND  A
1941  3250 ED 52                        SBC  HL, DE                            ; CF = borrow (low 16)
1942  3252 3A DF 6A                     LD   A, (Core.VDC_PlayerScore + 2)
1943  3255 21 E2 6A                     LD   HL, Core.NextLifeScore + 2
1944  3258 9E                           SBC  A, (HL)                           ; full 24-bit borrow in CF
1945  3259 D8                           RET  C                                 ; score < threshold -> done
1946  325A 3A D5 6A                     LD   A, (Core.VDC_Lives)
1947  325D 3C                           INC  A
1948  325E 32 D5 6A                     LD   (Core.VDC_Lives), A
1949  3261 3E 19                        LD   A, Core.SND_EXTRALIFE
1950  3263 CD 3C 6C                     CALL Core.GS_PlaySfx
1951  3266 2A E0 6A                     LD   HL, (Core.NextLifeScore)
1952  3269 11 50 C3                     LD   DE, 50000
1953  326C 19                           ADD  HL, DE
1954  326D 22 E0 6A                     LD   (Core.NextLifeScore), HL
1955  3270 3A E2 6A                     LD   A, (Core.NextLifeScore + 2)
1956  3273 CE 00                        ADC  A, 0
1957  3275 32 E2 6A                     LD   (Core.NextLifeScore + 2), A
1958  3278 18 CE                        JR   .cel_loop
1959  327A              ; ----------------------------------------------------------------------------
1960  327A              ; Score_Reset — score = 0, NextLifeScore = 50000 (new run / full restart).
1961  327A              ; ----------------------------------------------------------------------------
1962  327A              Score_Reset:
1963  327A 21 00 00                     LD   HL, 0
1964  327D 22 DD 6A                     LD   (Core.VDC_PlayerScore), HL
1965  3280 AF                           XOR  A
1966  3281 32 DF 6A                     LD   (Core.VDC_PlayerScore + 2), A
1967  3284 21 50 C3                     LD   HL, 50000
1968  3287 22 E0 6A                     LD   (Core.NextLifeScore), HL
1969  328A AF                           XOR  A
1970  328B 32 E2 6A                     LD   (Core.NextLifeScore + 2), A
1971  328E C9                           RET
