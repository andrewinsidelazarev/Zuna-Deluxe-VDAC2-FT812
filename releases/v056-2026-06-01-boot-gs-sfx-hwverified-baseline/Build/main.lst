 420+ C294              ; ============================================================================
 421+ C294              ; ReadRTCSeconds — TS-Conf GLUK CMOS RTC, регистр 0 (секунды BCD).
 422+ C294              ; Порты #DFF7 (адрес) / #BFF7 (данные). Out: A = 0..59 binary.
 423+ C294              ; ============================================================================
 424+ C294              ReadRTCSeconds:
 425+ C294                              ; Mr.Gluk activation на порт #EFF7 (за ZiFi/WC: zifi.asm:4207).
 426+ C294                              ; OUT #EFF7, #80 — enable; #00 — disable.
 427+ C294 01 F7 EF                     LD   BC, #EFF7
 428+ C297 3E 80                        LD   A, #80
 429+ C299 ED 79                        OUT  (C), A
 430+ C29B 01 F7 DF                     LD   BC, #DFF7
 431+ C29E AF                           XOR  A
 432+ C29F ED 79                        OUT  (C), A                            ; reg 0 = seconds
 433+ C2A1 01 F7 BF                     LD   BC, #BFF7
 434+ C2A4 ED 78                        IN   A, (C)                            ; A = BCD seconds
 435+ C2A6 32 0E 50                     LD   (#500E), A                        ; DEBUG: raw byte
 436+ C2A9 F5                           PUSH AF
 437+ C2AA 01 F7 EF                     LD   BC, #EFF7
 438+ C2AD AF                           XOR  A
 439+ C2AE ED 79                        OUT  (C), A                            ; deactivate Mr.Gluk
 440+ C2B0 F1                           POP  AF
 441+ C2B1 47                           LD   B, A
 442+ C2B2 E6 0F                        AND  $0F                               ; low nibble
 443+ C2B4 4F                           LD   C, A
 444+ C2B5 78                           LD   A, B
 445+ C2B6 E6 F0                        AND  $F0
 446+ C2B8 CB 3F                        SRL  A
 446+ C2BA CB 3F          SRL A
 446+ C2BC CB 3F          SRL A
 446+ C2BE CB 3F          SRL A         ; high nibble (0..5)
 447+ C2C0 47                           LD   B, A
 448+ C2C1                              ; A = high*10 + low
 449+ C2C1 87                           ADD  A, A
 449+ C2C2 87             ADD A, A
 449+ C2C3 80             ADD A, B        ; *5
 450+ C2C4 87                           ADD  A, A                              ; *10
 451+ C2C5 81                           ADD  A, C
 452+ C2C6 C9                           RET
 453+ C2C7
 454+ C2C7              ; ============================================================================
 455+ C2C7              ; ReadRTCRegister — generic, A = register index (0=sec, 2=min, 4=hour).
 456+ C2C7              ; Out: A = BCD-parsed binary value.
 457+ C2C7              ; ============================================================================
 458+ C2C7              ReadRTCRegister:
 459+ C2C7 5F                           LD   E, A                              ; E = reg index
 460+ C2C8 01 F7 EF                     LD   BC, #EFF7
 461+ C2CB 3E 80                        LD   A, #80
 462+ C2CD ED 79                        OUT  (C), A                            ; activate Mr.Gluk
 463+ C2CF 01 F7 DF                     LD   BC, #DFF7
 464+ C2D2 7B                           LD   A, E
 465+ C2D3 ED 79                        OUT  (C), A                            ; select register
 466+ C2D5 01 F7 BF                     LD   BC, #BFF7
 467+ C2D8 ED 78                        IN   A, (C)                            ; read BCD
 468+ C2DA F5                           PUSH AF
 469+ C2DB 01 F7 EF                     LD   BC, #EFF7
 470+ C2DE AF                           XOR  A
 471+ C2DF ED 79                        OUT  (C), A                            ; deactivate
 472+ C2E1 F1                           POP  AF
 473+ C2E2 47                           LD   B, A
 474+ C2E3 E6 0F                        AND  $0F
 475+ C2E5 4F                           LD   C, A
 476+ C2E6 78                           LD   A, B
 477+ C2E7 E6 F0                        AND  $F0
 478+ C2E9 CB 3F                        SRL  A
 478+ C2EB CB 3F          SRL A
 478+ C2ED CB 3F          SRL A
 478+ C2EF CB 3F          SRL A
 479+ C2F1 47                           LD   B, A
 480+ C2F2 87                           ADD  A, A
 480+ C2F3 87             ADD A, A
 480+ C2F4 80             ADD A, B        ; *5
 481+ C2F5 87                           ADD  A, A                              ; *10
 482+ C2F6 81                           ADD  A, C
 483+ C2F7 C9                           RET
