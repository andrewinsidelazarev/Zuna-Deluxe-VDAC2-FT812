 141+ 6AEF              ; ----------------------------------------------------------------------------
 142+ 6AEF              ; WIN-взрыв: «бегущая дорожка» взрывов ОТ головного шара (ближайшего к килл-зоне)
 143+ 6AEF              ; ДО килл-зоны (конца трека). Чем дальше голова была от КЗ — тем длиннее дорожка
 144+ 6AEF              ; (= больше бонус). Снимаем track-сэмпл ГОЛОВНОГО шара (макс. сэмпл = фронт цепи)
 145+ 6AEF              ; каждый PLAY-кадр, ДО очистки (keep-last-non-empty: храним последний кадр, где
 146+ 6AEF              ; шары были видимы). К WIN цепочка пуста, но трек ещё загружен → дорожку рисуем
 147+ 6AEF              ; по live-треку от сохранённого head-сэмпла. #FFFF = нет данных (не рисуем).
 148+ 6AEF              ; Резидент Core: пишется кодом VDC (slot1), читается WIN-рендером в оверлее #04.
 149+ 6AEF              ; ----------------------------------------------------------------------------
 150+ 6AEF FF FF        VDC_WinHeadS1:     DEFW #FFFF           ; chain1: сэмпл головного шара (фронт)
 151+ 6AF1 FF FF        VDC_WinHeadS2:     DEFW #FFFF           ; chain2 (дубль-уровни)
 152+ 6AF3 00 00        VDC_WinTmpMax:     DEFW 0               ; scratch: макс. сэмпл за проход цепочки
 153+ 6AF5 00           VDC_WinTmpFound:   DEFB 0               ; scratch: найден ли видимый шар
 154+ 6AF6
 155+ 6AF6              ; --- WIN-аутро «бикфорд» (точно по оригиналу Zuma Game_UpdateOutro/FX.c):
 156+ 6AF6              ; эмиттер бежит по треку head→килл-зона, роняя НЕЗАВИСИМЫЕ частицы-взрывы. ---
 157+ 6AF6              WIN_PRTCL_MAX      EQU 32
 158+ 6AF6              WINEXP_MOVE        EQU 12               ; сэмплов/кадр (скорость бегущей точки)
 159+ 6AF6              WINEXP_PAD         EQU 30               ; сэмплов между взрывами (+100 за каждый)
 160+ 6AF6              WINEXP_F2_MAX      EQU 32               ; f2 = 2×frame; >32 → частица мертва (frame 0..16)
 161+ 6AF6 00           VDC_WinOutroActive: DEFB 0              ; 1 = аутро запущено (есть head-данные)
 162+ 6AF7 FF FF        VDC_WinEmitPos1:   DEFW #FFFF           ; chain1 эмиттер: текущий сэмпл (#FFFF=дошёл)
 163+ 6AF9 00 00        VDC_WinEmitSpawn1: DEFW 0               ; сэмпл последнего спавна chain1
 164+ 6AFB FF FF        VDC_WinEmitPos2:   DEFW #FFFF           ; chain2
 165+ 6AFD 00 00        VDC_WinEmitSpawn2: DEFW 0
 166+ 6AFF 00 00 00...  VDC_WinPrtcl:      DEFS WIN_PRTCL_MAX * 5  ; на частицу: X(w),Y(w),f2(b); f2=255 мёртвая
