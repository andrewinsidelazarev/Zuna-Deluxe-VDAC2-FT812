 597+ C3C2 CD 3C 6C                     CALL GS_PlaySfx
 598+ C3C5              .upd_normal_go: ; Normal phase: per-level chain speed via Core helper (accum +=
 599+ C3C5                              ; speed_x100; ≥100 → один MoveChain = speed/100 продвижений/кадр).
 600+ C3C5                              ; Вынесено в Core — Main1/slot3 почти полон. VDC_TrySpawn gate'ится HSub==0.
 601+ C3C5 CD EA 5F                     CALL VDC_SpeedAdvance
 602+ C3C8 CD F1 C5                     CALL VDC_AnimateChain
