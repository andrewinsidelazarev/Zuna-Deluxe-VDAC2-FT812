4494  6A7A                              include "loader_resident.asm"         ; resident bits of the PAK loader (VDC_ReadSampleAtHL, cross-load vars, overlay trampolines)
# file opened: Source\ASM\loader_resident.asm
   1+ 6A7A              ; loader_resident.asm — the parts of the PAK loader that MUST stay resident in
   2+ 6A7A              ; Core (slot 1), because they are reached while the loader overlay page is NOT
   3+ 6A7A              ; mapped:
   4+ 6A7A              ;   * VDC_ReadSampleAtHL — called per-frame from VDC_SlotPos (Main1) during play;
   5+ 6A7A              ;   * adventure cross-load vars (FadeAlpha / CurrentDifficulty / CurrentLevel),
   6+ 6A7A              ;     read by gameplay/menu/level-select code at any time;
   7+ 6A7A              ;   * the overlay trampolines — the named entry points callers use; each maps the
   8+ 6A7A              ;     loader page into slot 3, calls the real OVL_* routine, then restores #04.
   9+ 6A7A              ;
  10+ 6A7A              ; The bulk of the loader (sd_zc + RawPak_* + ZiFi_* + OVL_LoadGameplay... +
  11+ 6A7A              ; OVL_LoadLevelSelectPreviewAssets) lives in ts-dos.asm, assembled into its own
  12+ 6A7A              ; SLOT 3 / PAGE #40 overlay region (see main.asm). It is dormant outside loads —
  13+ 6A7A              ; "load a level, then sleep" — so it no longer costs resident Core space.
  14+ 6A7A
  15+ 6A7A              LOADER_OVL_PAGE    EQU #40            ; SPG page holding the loader overlay (mapped into slot 3 during loads)
  16+ 6A7A              GS_PORT_DATA       EQU #00B3
  17+ 6A7A              GS_PORT_CMD        EQU #00BB
  18+ 6A7A              GS_CMD_PLAY_MODULE EQU #31
  19+ 6A7A              GS_CMD_STOP_MODULE EQU #32
  20+ 6A7A              GS_CMD_PLAY_FX     EQU #98
  21+ 6A7A              GS_SFX_NOTE        EQU 53            ; 11025 Hz payload at GS C-2-ish base (#30) needs about +5 semitones.
  22+ 6A7A              GS_WAIT_TIMEOUT    EQU #FFFF
  23+ 6A7A                                                    ; UI_OVL_PAGE (#41) is defined globally in main.asm (needed before
  24+ 6A7A                                                    ; module Core by the Fade* transitions); referenced here for the trampoline.
  25+ 6A7A
  26+ 6A7A              ; Track chunkB page: tracks longer than one 16K page (>3276 samples) are split on
  27+ 6A7A              ; a sample boundary. The active track pages are resident variables because the
  28+ 6A7A              ; two-curve boards reuse the same reader for the second path.
  29+ 6A7A              TRACK_PAGE2        EQU #0F
  30+ 6A7A              TRACK_SPLIT_SAMPLE EQU 3276        ; (16384-2)/5, first sample stored in TRACK_PAGE2
  31+ 6A7A
  32+ 6A7A              ; ----------------------------------------------------------------------------
  33+ 6A7A              ; VDC_ReadSampleAtHL — read track sample [HL] -> BC=X, DE=Y; set VDC_LastT and
  34+ 6A7A              ; VDC_LastTangent; CF=0. Core-resident (called as a tail-jump from VDC_SlotPos
  35+ 6A7A              ; in Main1, which is nearly full). Handles the 2-page track split: samples below
  36+ 6A7A              ; TRACK_SPLIT_SAMPLE sit on VDC_ActiveTrackPage1 at #8000+2+t*5; samples at/above
  37+ 6A7A              ; live on VDC_ActiveTrackPage2 at #8000+(t-split)*5 (chunkB has no count header).
  38+ 6A7A              ; Leaves slot 2 mapped to VDC_ActiveTrackPage1. Clobbers AF, HL.
  39+ 6A7A              ; ----------------------------------------------------------------------------
  40+ 6A7A              VDC_ReadSampleAtHL:
  41+ 6A7A 22 78 D4                     LD   (VDC_LastT), HL                   ; expose t
  42+ 6A7D 11 CC 0C                     LD   DE, TRACK_SPLIT_SAMPLE
  43+ 6A80 A7                           AND  A
  44+ 6A81 ED 52                        SBC  HL, DE                            ; HL = t - split; CF=1 if t<split
  45+ 6A83 38 27                        JR   C, .p1
  46+ 6A85                              ; --- page2 (#0F): HL = t2 = t - split ---
  47+ 6A85 54                           LD   D, H
  47+ 6A86 5D             LD E, L
  48+ 6A87 29                           ADD  HL, HL
  48+ 6A88 29             ADD HL, HL
  49+ 6A89 19                           ADD  HL, DE                            ; t2*5
  50+ 6A8A 11 00 80                     LD   DE, #8000
  51+ 6A8D 19                           ADD  HL, DE                            ; #8000 + t2*5
  52+ 6A8E 3A CF 6A                     LD   A, (VDC_ActiveTrackPage2)
  53+ 6A91                              SetPage2_A                             ; map #0F (clobbers A, BC)
  53+ 6A91             >                ifdef MAPPING_REGISTERS
  53+ 6A91 32 12 04    >                LD (FMADDR_REGS + HIGH PAGE2), A
  53+ 6A94             >                else
  53+ 6A94 ~           >                LD (MemoryPages + 2), A
  53+ 6A94 ~           >                LD BC, PAGE2
  53+ 6A94 ~           >                OUT (C), A
  53+ 6A94             >                endif
  54+ 6A94 5E                           LD   E, (HL)
  54+ 6A95 23             INC HL
  55+ 6A96 56                           LD   D, (HL)
  55+ 6A97 23             INC HL                  ; DE = X
  56+ 6A98 4E                           LD   C, (HL)
  56+ 6A99 23             INC HL
  57+ 6A9A 46                           LD   B, (HL)
  57+ 6A9B 23             INC HL                  ; BC = Y
  58+ 6A9C 7E                           LD   A, (HL)
  59+ 6A9D 32 77 D4                     LD   (VDC_LastTangent), A
  60+ 6AA0 C5                           PUSH BC
  60+ 6AA1 D5             PUSH DE                      ; save Y, X across page restore
  61+ 6AA2 3A CE 6A                     LD   A, (VDC_ActiveTrackPage1)
  62+ 6AA5                              SetPage2_A                             ; restore active track page for callers
  62+ 6AA5             >                ifdef MAPPING_REGISTERS
  62+ 6AA5 32 12 04    >                LD (FMADDR_REGS + HIGH PAGE2), A
  62+ 6AA8             >                else
  62+ 6AA8 ~           >                LD (MemoryPages + 2), A
  62+ 6AA8 ~           >                LD BC, PAGE2
  62+ 6AA8 ~           >                OUT (C), A
  62+ 6AA8             >                endif
  63+ 6AA8 D1                           POP  DE
  63+ 6AA9 C1             POP  BC                      ; DE = X, BC = Y
  64+ 6AAA 18 18                        JR   .rearr
  65+ 6AAC              .p1:            ; --- page1 (#06, already mapped): addr = #8000 + 2 + t*5 ---
  66+ 6AAC 2A 78 D4                     LD   HL, (VDC_LastT)
  67+ 6AAF 54                           LD   D, H
  67+ 6AB0 5D             LD E, L
  68+ 6AB1 29                           ADD  HL, HL
  68+ 6AB2 29             ADD HL, HL
  69+ 6AB3 19                           ADD  HL, DE                            ; t*5
  70+ 6AB4 11 02 80                     LD   DE, TrackData + 2
  71+ 6AB7 19                           ADD  HL, DE
  72+ 6AB8 5E                           LD   E, (HL)
  72+ 6AB9 23             INC HL
  73+ 6ABA 56                           LD   D, (HL)
  73+ 6ABB 23             INC HL                  ; DE = X
  74+ 6ABC 4E                           LD   C, (HL)
  74+ 6ABD 23             INC HL
  75+ 6ABE 46                           LD   B, (HL)
  75+ 6ABF 23             INC HL                  ; BC = Y
  76+ 6AC0 7E                           LD   A, (HL)
  77+ 6AC1 32 77 D4                     LD   (VDC_LastTangent), A
  78+ 6AC4 EB           .rearr:         EX   DE, HL                            ; HL = X
  79+ 6AC5 50                           LD   D, B
  79+ 6AC6 59             LD E, C                    ; DE = Y
  80+ 6AC7 44                           LD   B, H
  80+ 6AC8 4D             LD C, L                    ; BC = X
  81+ 6AC9 A7                           AND  A                                 ; CF = 0
  82+ 6ACA C9                           RET
