4533  DD04              LoaderOvl_End:
4534  DD04                              endmodule
4535  DD04
4536  DD04              Main0_Size       EQU Core.Main0_End - Core.Start
4537  DD04              Main1_Size       EQU Core.Main1_End - Core.Main1_Start
4538  DD04              UiOvl_Size       EQU Core.UiOvl_End - Core.UiOvl_Start
4539  DD04              LoaderOvl_Size   EQU Core.LoaderOvl_End - Core.LoaderOvl_Start
4540  DD04                              display "Main0:    \t", /A, Core.Start,        " size=", /D, Main0_Size,     " bytes (slot 1 page 5)"
4541  DD04                              display "Main1:    \t", /A, Core.Main1_Start,  " size=", /D, Main1_Size,     " bytes (slot 3 page #04, gameplay)"
4542  DD04                              display "UiOvl:    \t", /A, Core.UiOvl_Start,  " size=", /D, UiOvl_Size,     " bytes (slot 3 page #41, ui)"
4543  DD04                              display "LoaderOvl:\t", /A, Core.LoaderOvl_Start, " size=", /D, LoaderOvl_Size, " bytes (slot 3 page #40)"
4544  DD04                              ; main1_play (#04), the UI overlay (#41) and the loader overlay (#40)
4545  DD04                              ; all assemble at logical #C000 on different physical pages. Map the
4546  DD04                              ; right page into the slot before EACH SAVEBIN, else SAVEBIN dumps
4547  DD04                              ; whichever page was mapped last into the wrong .bin — corrupting it.
4548  DD04                              SLOT 1
4548  DD04                PAGE #05
4549  DD04                              SAVEBIN "Build/Core.bin",        Core.Start,       Main0_Size
4550  DD04                              SLOT 3
4550  DD04                PAGE #04
4551  DD04                              SAVEBIN "Build/main1_play.bin",  Core.Main1_Start, Main1_Size
4552  DD04                              SLOT 3
4552  DD04                PAGE UI_OVL_PAGE
4553  DD04                              SAVEBIN "Build/ui_ovl.bin",      Core.UiOvl_Start, UiOvl_Size
4554  DD04                              SLOT 3
4554  DD04                PAGE Core.LOADER_OVL_PAGE
4555  DD04                              SAVEBIN "Build/loader_ovl.bin",  Core.LoaderOvl_Start, LoaderOvl_Size
4556  DD04
