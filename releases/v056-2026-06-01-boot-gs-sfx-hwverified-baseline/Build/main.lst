4505  E505                              include "Bullet.asm"
# file opened: Source\ASM\Bullet.asm
   1+ E505              ; ============================================================================
   2+ E505              ; Bullet.asm — летящий шар (одиночный выстрел из лягушки).
   3+ E505              ;
   4+ E505              ; State: Active flag + позиция (X,Y signed 16-bit) + velocity (VX,VY signed 8-bit)
   5+ E505              ; + color (0..5).  Spawn в start-fire (Frog_HandleMouse / Frog_FireKeyboard).
   6+ E505              ; Update каждый кадр (X += VX, Y += VY).  Out-of-screen → deactivate.
   7+ E505              ; Render — handle 0 chain atlas, тот же что ball-now/next-ball/chain.
   8+ E505              ;
   9+ E505              ; Этап 1 (текущий): только полёт + render. Без collision/insert в chain.
  10+ E505              ; ============================================================================
  11+ E505
  12+ E505              BULLET_SPEED        EQU 12                            ; px/frame, ~684 px/sec @57Hz
  13+ E505              BULLET_SPRITE_HALF  EQU 16                            ; chain atlas 32×32 native classic
  14+ E505              BULLET_HIT_THR      EQU 22                            ; bbox prefilter: |dx|<THR && |dy|<THR.
  15+ E505              BULLET_HIT_MANHATTAN_THR EQU 34                       ; reject far bbox corners.
  16+ E505                                                                    ; D=32: 30/46 was too magnetic on curved chain and
  17+ E505                                                                    ; could pick a ball several slots before the aimed one.
  18+ E505                                                                    ; 22/34 keeps a small touch margin without early capture.
  19+ E505
  20+ E505
  21+ E505              ; ----------------------------------------------------------------------------
