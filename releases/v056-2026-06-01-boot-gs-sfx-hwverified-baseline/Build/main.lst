 154+ 768B              ; ----------------------------------------------------------------------------
 155+ 768B              ; Input_EdgeZ — детектор фронта нажатия (для навигации меню/диалогов: одно
 156+ 768B              ; действие на одно нажатие, без автоповтора при удержании).
 157+ 768B              ; Вход: флаг Z = состояние клавиши СЕЙЧАС (Z = отпущена, NZ = нажата),
 158+ 768B              ;       HL = адрес байта «было нажато в прошлом кадре» (0/1).
 159+ 768B              ; Выход: NZ = фронт (0->1, только что нажали), Z = фронта нет. Обновляет (HL).
 160+ 768B              ; Портит A. Вызывать СРАЗУ после Input_Up/Down/Left/Right/FireKey/Esc —
 161+ 768B              ; промежуточный «LD HL, addr» флаги не трогает, поэтому Z доходит сюда целым.
 162+ 768B              ; ----------------------------------------------------------------------------
 163+ 768B 28 06        Input_EdgeZ:    JR   Z, .released
 164+ 768D 7E                           LD   A, (HL)                               ; было нажато?
 165+ 768E 36 01                        LD   (HL), 1                               ; запомнить «нажато»
 166+ 7690 EE 01                        XOR  1                                     ; было 0 -> A=1 (фронт, NZ); было 1 -> A=0 (Z)
 167+ 7692 C9                           RET
 168+ 7693 36 00        .released:      LD   (HL), 0                               ; отпущено -> сброс
 169+ 7695 AF                           XOR  A                                     ; Z = фронта нет
 170+ 7696 C9                           RET
