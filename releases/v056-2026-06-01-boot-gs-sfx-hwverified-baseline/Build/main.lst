 787  228D              ; UpdateDialog — диалог game-over обработка click anywhere → restart.
 788  228D              ; Вызывается каждый кадр ДО Frog_Update (чтобы dialog click не триггерил bullet).
 789  228D              ; ============================================================================
 790  228D              UpdateDialog:
 791  228D 3A D6 6A                     LD   A, (Core.VDC_DialogState)
 792  2290 B7                           OR   A
 793  2291 C8                           RET  Z                                  ; диалог не показан
 794  2292 3E 01                        LD   A, 1
 795  2294 32 D9 6A                     LD   (Core.VDC_HudPointerBlock), A      ; dialog consumes LMB for this frame
 796  2297 3A D6 6A                     LD   A, (Core.VDC_DialogState)
 797  229A FE 03                        CP   3
 798  229C CA 34 67                     JP   Z, Core.UpdatePauseDialog
 799  229F FE 04                        CP   4
 800  22A1 CA D7 67                     JP   Z, Core.UpdatePauseFade            ; pause window fade-out -> PLAY
 801  22A4 FE 06                        CP   Core.DLG_WIN_FADE
 802  22A6 CA 1C 23                     JP   Z, .udlg_win_fade                  ; LEVEL DONE → OK нажат → fade-out
 803  22A9
 804  22A9                              ; --- Клавиша огня (Space|Enter|Kempston) — минуя hit-test. ЛКМ ниже. ---
 805  22A9 CD 73 76                     CALL Core.Input_FireKey
 806  22AC 20 06                        JR   NZ, .udlg_fire_check_edge         ; нажата
 807  22AE                              ; Огонь отпущен — сброс debounce
 808  22AE AF                           XOR  A
 809  22AF 32 34 23                     LD   (DialogFirePrev), A
 810  22B2 18 0E                        JR   .udlg_check_lmb
 811  22B4              .udlg_fire_check_edge:
 812  22B4 3A 34 23                     LD   A, (DialogFirePrev)
 813  22B7 B7                           OR   A
 814  22B8 20 08                        JR   NZ, .udlg_check_lmb               ; уже было pressed → no edge
 815  22BA 3E 01                        LD   A, 1
 816  22BC 32 34 23                     LD   (DialogFirePrev), A
 817  22BF C3 03 23                     JP   .udlg_action                       ; rising edge → trigger
 818  22C2
 819  22C2              .udlg_check_lmb:
 820  22C2                              ; --- Read mouse LMB state, detect falling edge (release = click) ---
 821  22C2 3E 01                        LD   A, Input.Mouse.SVK_LBUTTON
 822  22C4 CD 9E 15                     CALL Input.Mouse.KeyState               ; Z=released, NZ=pressed
 823  22C7 3E 00                        LD   A, 0
 824  22C9 28 01                        JR   Z, .udlg_lmb_set
 825  22CB 3C                           INC  A
 826  22CC 4F           .udlg_lmb_set:  LD   C, A                               ; C = current LMB (0/1)
 827  22CD 3A D7 6A                     LD   A, (Core.VDC_PrevMouseL)
 828  22D0 47                           LD   B, A                               ; B = previous LMB
 829  22D1 79                           LD   A, C
 830  22D2 32 D7 6A                     LD   (Core.VDC_PrevMouseL), A           ; save for next frame
 831  22D5                              ; Falling edge: was pressed (B=1) AND now released (C=0) → CLICK
 832  22D5 78                           LD   A, B
 833  22D6 B7                           OR   A
 834  22D7 C8                           RET  Z                                  ; не было pressed → нет клика
 835  22D8 79                           LD   A, C
 836  22D9 B7                           OR   A
 837  22DA C0                           RET  NZ                                 ; ещё pressed → нет клика
 838  22DB                              ; --- Hit-test: курсор должен быть в bounds OK button ---
 839  22DB 2A 39 16                     LD   HL, (Input.Mouse.PositionX)
 840  22DE 11 AA 00                     LD   DE, DLG_OK_X
 841  22E1 A7                           AND  A
 842  22E2 ED 52                        SBC  HL, DE
 843  22E4 D8                           RET  C
 844  22E5 2A 39 16                     LD   HL, (Input.Mouse.PositionX)
 845  22E8 11 D6 01                     LD   DE, DLG_OK_X + DIALOG_OK_W
 846  22EB A7                           AND  A
 847  22EC ED 52                        SBC  HL, DE
 848  22EE D0                           RET  NC
 849  22EF 2A 3B 16                     LD   HL, (Input.Mouse.PositionY)
 850  22F2 11 3B 01                     LD   DE, DLG_OK_Y
 851  22F5 A7                           AND  A
 852  22F6 ED 52                        SBC  HL, DE
 853  22F8 D8                           RET  C
 854  22F9 2A 3B 16                     LD   HL, (Input.Mouse.PositionY)
 855  22FC 11 5D 01                     LD   DE, DLG_OK_Y + DIALOG_OK_H
 856  22FF A7                           AND  A
 857  2300 ED 52                        SBC  HL, DE
 858  2302 D0                           RET  NC
