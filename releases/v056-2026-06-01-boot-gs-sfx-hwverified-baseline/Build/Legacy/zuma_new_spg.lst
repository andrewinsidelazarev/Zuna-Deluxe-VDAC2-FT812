3276  71F5              ; ================================================================
3277  71F5              ; CANVAS A=#10..#18, B=#20..#28. Golden=#30..#38. Учебная схема:
3278  71F5              ; full copy golden→shadow + blit chain + atomic VPAGE swap в начале vblank.
3279  71F5              ; ================================================================
3280  71F5              CANVAS_B_PAGE_BASE EQU #20
3281  71F5              GOLDEN_PAGE_BASE   EQU #30
3282  71F5
3283  71F5              ; ================================================================
3284  71F5              ; COPY GOLDEN TO SHADOW — DMA 9 страниц фона в текущий shadow buffer.
3285  71F5              ; ShadowPageBase обновляется при swap.
3286  71F5              ; ================================================================
3287  71F5              CopyGoldenToShadow:
3288  71F5 01 AF 15         LD BC, FMADDR
3288  71F8 AF             XOR A
3288  71F9 ED 79          OUT (C), A
3289  71FB 3E FF            LD A, 256-1
3289  71FD 01 AF 26       LD BC, DMALEN
3289  7200 ED 79          OUT (C), A   ; burst = 256 words = 512 byte (1 строка)
3290  7202 3E 1F            LD A, 32-1
3290  7204 01 AF 28       LD BC, DMANUM
3290  7207 ED 79          OUT (C), A   ; 32 строки = 16K = 1 страница
3291  7209
3292  7209 3E 30            LD A, GOLDEN_PAGE_BASE
3292  720B 32 66 72       LD (.cgs_src), A
