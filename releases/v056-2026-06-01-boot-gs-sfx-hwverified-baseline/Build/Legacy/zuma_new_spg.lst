2488  6D7C              ; ================================================================
2489  6D7C              ; (CompactChain удалён — в VDC модели не нужен: spacing встроен в slot index.)
2490  6D7C              ; ================================================================
2491  6D7C
2492  6D7C              ; ================================================================
2493  6D7C              ; COMPUTE APPROACH TARGET — для approach-шара вычисляет (X, Y) точки вставки.
2494  6D7C              ; Вход: A = chain target index (0..ChainLen-1)
2495  6D7C              ; Выход: TmpTargetX, TmpTargetY = top-left позиции (= TrackData[t] - 8 в каждой оси)
2496  6D7C              ;        TmpChainIdx = A (сохранён для дальнейшего использования)
2497  6D7C              ; ================================================================
2498  6D7C              ComputeApproachTarget:
2499  6D7C 32 BB 89         LD (TmpChainIdx), A
2500  6D7F
2501  6D7F                  ; t = (HSA - i) * 32 + HeadSub + SlotOffsets[i] (signed)
2502  6D7F 3A 25 8F         LD A, (Chain0_HeadSlotAbs)
2503  6D82 21 BB 89         LD HL, TmpChainIdx
2504  6D85 96               SUB (HL)
2505  6D86 30 01            JR NC, .cat_hsa_ok
2506  6D88 AF               XOR A                                 ; clamp t→0 если HSA-i<0
2507  6D89              .cat_hsa_ok:
2508  6D89 26 00            LD H, 0
2508  6D8B 6F             LD L, A
2509  6D8C 29               ADD HL, HL
2509  6D8D 29             ADD HL, HL
2509  6D8E 29             ADD HL, HL
2510  6D8F 29               ADD HL, HL
2510  6D90 29             ADD HL, HL                ; HL = (HSA-i)*32
2511  6D91
2512  6D91 3A 26 8F         LD A, (Chain0_HeadSub)
2513  6D94 5F               LD E, A
2514  6D95 16 00            LD D, 0
2515  6D97 19               ADD HL, DE                             ; + HeadSub
2516  6D98
2517  6D98 E5               PUSH HL
2518  6D99 3A BB 89         LD A, (TmpChainIdx)
2519  6D9C 26 00            LD H, 0
2519  6D9E 6F             LD L, A
2520  6D9F 11 65 8B         LD DE, Chain0_SlotOffsets
2521  6DA2 19               ADD HL, DE
2522  6DA3 7E               LD A, (HL)
2523  6DA4 5F               LD E, A
2524  6DA5 16 00            LD D, 0
2525  6DA7 CB 7F            BIT 7, A
2526  6DA9 28 01            JR Z, .cat_off_pos
2527  6DAB 15               DEC D
2528  6DAC              .cat_off_pos:
2529  6DAC E1               POP HL
2530  6DAD 19               ADD HL, DE                            ; HL = t (signed)
2531  6DAE CB 7C            BIT 7, H
2532  6DB0 28 03            JR Z, .cat_t_not_neg
2533  6DB2 21 00 00         LD HL, 0
2534  6DB5              .cat_t_not_neg:
2535  6DB5 E5               PUSH HL
2536  6DB6 11 18 0C         LD DE, TRACK_NUM_POINTS
2537  6DB9 A7               AND A
2538  6DBA ED 52            SBC HL, DE
