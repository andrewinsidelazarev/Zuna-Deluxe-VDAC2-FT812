3316  7269              ; ================================================================
3317  7269              ; BLIT CHAIN TO SHADOW — три прохода:
3318  7269              ;   PRE:   BcsPreClassify заполняет SkipFlag[i] и кэш геометрии для DRAW.
3319  7269              ;   PASS1: restore prev positions, НО только если SkipFlag != PRESERVE.
3320  7269              ;          Это сохраняет хвост в shadow при cascade roll-back (HSA-i<0 / t<0).
3321  7269              ;   PASS2: для DRAW — blit из кэша + сохранить новый prev. DESTROY — invalidate.
3322  7269              ;          PRESERVE — не трогать prev/shadow.
3323  7269              ; Двух-pass нужен чтобы не "выгрызать" outline соседним restore'ом.
3324  7269              ; ================================================================
3325  7269              BlitChainToShadow:
3326  7269 01 AF 15         LD BC, FMADDR
3326  726C AF             XOR A
3326  726D ED 79          OUT (C), A        ; FM_EN=0 для DMA
3327  726F 3E 09            LD A, DMA_BURST_WORDS-1
3327  7271 01 AF 26       LD BC, DMALEN
3327  7274 ED 79          OUT (C), A   ; 9 words burst
3328  7276                  ; DMANUM ставится индивидуально каждым blit/restore (partial-blit: переменное число строк)
3329  7276
3330  7276                  ; --- Выбор golden offset по текущему shadow buffer ---
3331  7276 3A A7 75         LD A, (ShadowPageBase)
3332  7279 FE 10            CP CANVAS_A_PAGE_BASE
3333  727B 20 07            JR NZ, .bcs_use_b
3334  727D 3E 20            LD A, #20
3334  727F 32 99 75       LD (BcsGoldenOff), A           ; canvas A → golden = +#20
3335  7282 18 05            JR .bcs_have
3336  7284              .bcs_use_b:
3337  7284 3E 10            LD A, #10
3337  7286 32 99 75       LD (BcsGoldenOff), A           ; canvas B → golden = +#10
3338  7289              .bcs_have:
3339  7289
