2545  6DC7 19               ADD HL, DE
2546  6DC8 7E               LD A, (HL)
2546  6DC9 D6 0C          SUB 12
2546  6DCB 32 D9 89       LD (TmpTargetX), A
2546  6DCE 23             INC HL          ; ball 24x24
2547  6DCF 7E               LD A, (HL)
2547  6DD0 DE 00          SBC A, 0
2547  6DD2 32 DA 89       LD (TmpTargetX+1), A
2547  6DD5 23             INC HL
2548  6DD6 CB 7F            BIT 7, A                                                    ; sign bit set?
2549  6DD8 28 07            JR Z, .cat_x_ok
2550  6DDA AF               XOR A
2550  6DDB 32 D9 89       LD (TmpTargetX), A
2550  6DDE 32 DA 89       LD (TmpTargetX+1), A          ; clamp X >= 0
2551  6DE1              .cat_x_ok:
2552  6DE1 7E               LD A, (HL)
2552  6DE2 D6 0C          SUB 12
