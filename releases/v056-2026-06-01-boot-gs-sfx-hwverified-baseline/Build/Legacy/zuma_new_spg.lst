  45  0000              DMA_BLT_8BPP_MODE     EQU #B9    ; BLT1 + SALG + DALG + ASZ (с прозрачностью src=0)
  46  0000              DMA_BLT_NOTRANSP_MODE EQU #B1    ; BLT0 + SALG + DALG (БЕЗ прозрачности — для full copy)
  47  0000
  48  0000              ; --- Геометрия DMA-шара ---
  49  0000              ; Шар BALL_PIX × BALL_PIX (18×18). Решение X×2 granularity (Слободчиков):
  50  0000              ; 2 варианта спрайта на цвет:
  51  0000              ;   even — ball на col 0..BALL_PIX-1, col BALL_PIX..BALL_PIX+1 = pad (всё равно не
  52  0000              ;          копируется DMA: burst = BALL_PIX/2 words).
  53  0000              ;   odd  — ball сдвинут на +1 px ВНУТРИ спрайта: col 0 = transparent, ball на
  54  0000              ;          col 1..BALL_PIX (для odd последний pixel ball'а орig[BALL_PIX-1] оказывается
  55  0000              ;          на col BALL_PIX и DMA не копирует его → теряем 1 px по правому краю
  56  0000              ;          шара. На circular-mask edge это обычно прозрачный пиксель).
  57  0000              ; При blit'е: dst_X = X & #FE, sprite = (X & 1) ? odd : even.
  58  0000              ; Burst = BALL_PIX/2 words (= ширина DMA-копии = BALL_PIX px). Тот же overhead
  59  0000              ; что и до X-granularity workaround.
  60  0000              BALL_PIX           EQU 20       ; DMA-burst width в px (DMA_SPRITE_HALF=10, чтобы trackX=10 не уходил в TmpChainX<0 → preserve gap)
  61  0000              DMA_SPRITE_HALF    EQU BALL_PIX / 2          ; 9 — top-left offset = X - DMA_SPRITE_HALF
  62  0000              DMA_BURST_WORDS    EQU BALL_PIX / 2          ; 9 words в burst (DMA копирует BALL_PIX px по X)
  63  0000              CANVAS_W           EQU 360
  64  0000              CANVAS_H           EQU 288
  65  0000              ; Ограничение по X: dst_X = X & #FE, DMA пишет dst_X..dst_X+BALL_PIX-1.
  66  0000              ; Условие видимости: dst_X+BALL_PIX <= CANVAS_W → X & #FE <= CANVAS_W-BALL_PIX.
  67  0000              ; X = CANVAS_W-BALL_PIX+1 даёт dst_X = CANVAS_W-BALL_PIX — допустимо.
  68  0000              DMA_X_MAX          EQU CANVAS_W - BALL_PIX + 2    ; 344 — X >= этого значит шар выходит за правый край
  69  0000
  70  0000              BALLS_DMA_EVEN_PAGE EQU #40    ; #40..#45 — even спрайты 6 цветов (col 0..17 = шар)
  71  0000              BALLS_DMA_ODD_PAGE  EQU #48    ; #48..#4D — odd спрайты (col 1..17 = шар сдвинут +1, col 18+ обрезается DMA-burst'ом)
  72  0000              CANVAS_A_PAGE_BASE EQU #10    ; visible canvas pages #10..#18 (9 pages × 16K)
  73  0000
