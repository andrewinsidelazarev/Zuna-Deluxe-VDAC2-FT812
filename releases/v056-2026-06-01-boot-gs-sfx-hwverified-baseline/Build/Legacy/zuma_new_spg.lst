 384  60FF              ; ============================================================================
 385  60FF              ; IRQ HANDLER (IM 2) — единственная задача: инкремент TickCount каждый vblank.
 386  60FF              ; Никаких DMA/блокирующих writes — иначе race с BlitChainToShadow.
 387  60FF              ; ============================================================================
 388  60FF              IRQHandler:
 389  60FF F5               PUSH AF
 390  6100 3A BD 89         LD A, (TickCount)
 391  6103 3C               INC A
 392  6104 32 BD 89         LD (TickCount), A
 393  6107 F1               POP AF
 394  6108 FB               EI
 395  6109 ED 4D            RETI
 396  610B
 397  610B              ; ================================================================
 398  610B              ; ИНИЦИАЛИЗАЦИЯ ИГРЫ
 399  610B              ; ================================================================
 400  610B              InitGame:
 401  610B                  ; Позиция лягушки — центр экрана с поправкой на canvas-сдвиг (SCR_OFFS).
 402  610B 21 64 00         LD HL, FROG_INIT_X
 402  610E 22 8B 89       LD (FrogX), HL
 403  6111 21 78 00         LD HL, FROG_INIT_Y
 403  6114 22 8D 89       LD (FrogY), HL
 404  6117 AF               XOR A
 404  6118 32 8F 89       LD (FrogAngle), A
 405  611B
 406  611B                  ; Очистка всех шаров (MAX_BALLS*8 = 256 байт через LDIR)
 407  611B 21 E5 89         LD HL, BallTable
 408  611E 36 00            LD (HL), 0
 409  6120 11 E6 89         LD DE, BallTable+1
 410  6123 01 7F 00         LD BC, MAX_BALLS*8-1
 411  6126 ED B0            LDIR
 412  6128
 413  6128                  ; Очистка SFILE: 510 байт = 85 дескрипторов × 6 байт (#0200..#03FD).
 414  6128                  ; ВАЖНО: LDIR здесь не работает — read через FM_EN отдаёт ROM, не SFILE,
 415  6128                  ; и LDIR копирует ROM в SFILE → случайные ACT bits → призраки.
 416  6128                  ; Поэтому пишем immediate-нулями через LD (HL), 0.
 417  6128 01 AF 15         LD BC, FMADDR
 417  612B 3E 10          LD A, FM_EN
 417  612D ED 79          OUT (C), A
 418  612F 21 00 02         LD HL, #0200
 419  6132 06 FF            LD B, 255
 420  6134              .is_clr1:
 421  6134 36 00            LD (HL), 0
 422  6136 23               INC HL
 423  6137 10 FB            DJNZ .is_clr1
 424  6139 06 FF            LD B, 255
 425  613B              .is_clr2:
 426  613B 36 00            LD (HL), 0
 427  613D 23               INC HL
 428  613E 10 FB            DJNZ .is_clr2                ; всего 510 байт #0200..#03FD
 429  6140 01 AF 15         LD BC, FMADDR
 429  6143 AF             XOR A
 429  6144 ED 79          OUT (C), A
 430  6146
 431  6146                  ; --- Инициализация цепочки: пусто, шары приедут «поездом» в fast-фазе
 432  6146 AF               XOR A
 433  6147 32 BF 89         LD (BallsSpawned), A
 434  614A 32 C0 89         LD (ChainStalled), A
 435  614D 32 97 89         LD (CascadeState), A
 436  6150 32 98 89         LD (CascadeIdx), A
 437  6153 32 99 89         LD (CascadeWait), A
 438  6156 32 9A 89         LD (CascadeDelay), A
 439  6159 32 9B 89         LD (StopModeTimer), A
 440  615C 32 9C 89         LD (CompactTimer), A
 441  615F 32 9D 89         LD (GapStepCounter), A
 442  6162 32 BC 89         LD (FrameCounter), A
 443  6165 3E FF            LD A, #FF
 444  6167 32 9F 89         LD (MatchScanIdx), A   ; "no scan pending"
 445  616A
 446  616A                  ; --- ВАЖНО: явно инициализируем page bases (после F12 reset значения могут
 447  616A                  ; быть corruptВанные → DMA blit в page 5 (main0 = код/данные) → memory corruption).
 448  616A 3E 10            LD A, CANVAS_A_PAGE_BASE
 449  616C 32 A6 75         LD (VisiblePageBase), A
 450  616F 3E 20            LD A, CANVAS_B_PAGE_BASE
 451  6171 32 A7 75         LD (ShadowPageBase), A
 452  6174
 453  6174                  ; --- Killzone: позиция = конец трека (TrackData[TRACK_NUM_POINTS-1])
 454  6174                  ; ВАЖНО: track data spillover в slot 2 → нужно явно убедиться что PAGE2=2.
 455  6174 01 AF 12         LD BC, PAGE2
 455  6177 3E 02          LD A, 2
 455  6179 ED 79          OUT (C), A
 456  617B 21 17 0C         LD HL, TRACK_NUM_POINTS - 1
 457  617E 29               ADD HL, HL
 457  617F 29             ADD HL, HL                 ; HL = (TRACK_NUM_POINTS-1) * 4
 458  6180 11 49 94         LD DE, TrackData
 459  6183 19               ADD HL, DE
 460  6184 7E               LD A, (HL)
 460  6185 32 A3 89       LD (KzCenterX), A
 460  6188 23             INC HL
 461  6189 7E               LD A, (HL)
 461  618A 32 A4 89       LD (KzCenterX+1), A
 461  618D 23             INC HL
 462  618E 7E               LD A, (HL)
 462  618F 32 A5 89       LD (KzCenterY), A
 462  6192 23             INC HL
 463  6193 7E               LD A, (HL)
 463  6194 32 A6 89       LD (KzCenterY+1), A
 464  6197 AF               XOR A
 465  6198 32 A1 89         LD (KzFrame), A
 466  619B 32 A2 89         LD (KzFrameWait), A
 467  619E 3E 01            LD A, 1
 468  61A0 32 A7 89         LD (KzVisible), A
 469  61A3                  ; --- Chain0 slot-state: заполнить GAP_MARKER (= GAP_STOP), offsets/Shot2/scalars обнулить.
 470  61A3 21 75 8A         LD HL, Chain0_Slots
 471  61A6 06 F0            LD B, MAX_SLOTS_PER_CHAIN
 472  61A8              .ig_c0slots_gap:
 473  61A8 36 FE            LD (HL), GAP_MARKER
 474  61AA 23               INC HL
 475  61AB 10 FB            DJNZ .ig_c0slots_gap
 476  61AD 21 65 8B         LD HL, Chain0_SlotOffsets
 477  61B0 06 F0            LD B, MAX_SLOTS_PER_CHAIN
 478  61B2              .ig_c0offs_clr:
 479  61B2 36 00            LD (HL), 0
 480  61B4 23               INC HL
 481  61B5 10 FB            DJNZ .ig_c0offs_clr
 482  61B7 21 55 8C         LD HL, Chain0_Shot2
 483  61BA 06 F0            LD B, MAX_SLOTS_PER_CHAIN
 484  61BC              .ig_c0shot2_clr:
 485  61BC 36 00            LD (HL), 0
 486  61BE 23               INC HL
 487  61BF 10 FB            DJNZ .ig_c0shot2_clr
 488  61C1 AF               XOR A
 489  61C2 32 25 8F         LD (Chain0_HeadSlotAbs), A
 490  61C5 32 26 8F         LD (Chain0_HeadSub), A
 491  61C8 32 27 8F         LD (Chain0_SlotsLen), A
 492  61CB
 493  61CB                  ; Инициализируем MouseBtnPrev = 1 — pretend "ЛКМ нажата при старте".
 494  61CB                  ; Edge detection требует release→press, поэтому первый кадр НЕ выстрелит,
 495  61CB                  ; даже если порт показывает LMB pressed (auto-fire bug).
 496  61CB 3E 01            LD A, 1
 497  61CD 32 B2 89         LD (MouseBtnPrev), A
 498  61D0
 499  61D0                  ; --- RNG seeds. BallColorSeed зарождаем от RTC секунд × константа,
 500  61D0                  ;     чтобы preview-цвет был непредсказуем уже с первого выстрела.
 501  61D0                  ;     ChainColorSeed — фиксированный (последовательность стабильна).
 502  61D0 CD B2 67         CALL ReadRTCSeconds                   ; A = 0..59
 503  61D3 B7               OR A
 504  61D4 20 02            JR NZ, .ig_seed_have
 505  61D6 3E 11            LD A, 17                              ; защита если RTC = 0
 506  61D8              .ig_seed_have:
 507  61D8 67               LD H, A
 508  61D9 2E A5            LD L, $A5                             ; ненулевой младший байт
 509  61DB 22 92 89         LD (BallColorSeed), HL
 510  61DE 21 34 12         LD HL, $1234
 511  61E1 22 94 89         LD (ChainColorSeed), HL
 512  61E4 3E 01            LD A, 1
 513  61E6 32 96 89         LD (ChainColorFirst), A               ; первый вызов RandomChainColor scramble через RTC
 514  61E9
 515  61E9                  ; Уровень: количество цветов (TODO: брать из per-level config)
 516  61E9 3E 06            LD A, NUM_BALL_COLORS
 517  61EB 32 90 89         LD (LevelNumColors), A
 518  61EE
 519  61EE                  ; Обнуляем ChainPrevValidA/B (DS не очищает память, мусор → BlitChain crash)
 520  61EE 21 68 79         LD HL, ChainPrevValidA
 521  61F1 06 F0            LD B, MAX_CHAIN_BALLS
 522  61F3              .ig_clr_va:
 523  61F3 36 00            LD (HL), 0
 523  61F5 23             INC HL
 524  61F6 10 FB            DJNZ .ig_clr_va
 525  61F8 21 18 7E         LD HL, ChainPrevValidB
 526  61FB 06 F0            LD B, MAX_CHAIN_BALLS
 527  61FD              .ig_clr_vb:
 528  61FD 36 00            LD (HL), 0
 528  61FF 23             INC HL
 529  6200 10 FB            DJNZ .ig_clr_vb
 530  6202
 531  6202                  ; Explosion state: ExplodingFrame[] / ExplodingMarker[] = 0 (без stale при reset).
 532  6202 21 45 8D         LD HL, Chain0_ExplodingFrame
 533  6205 06 F0            LD B, MAX_SLOTS_PER_CHAIN
 534  6207              .ig_clr_ef:
 535  6207 36 00            LD (HL), 0
 535  6209 23             INC HL
 536  620A 10 FB            DJNZ .ig_clr_ef
 537  620C 21 35 8E         LD HL, Chain0_ExplodingMarker
 538  620F 06 F0            LD B, MAX_SLOTS_PER_CHAIN
 539  6211              .ig_clr_em:
 540  6211 36 00            LD (HL), 0
 540  6213 23             INC HL
 541  6214 10 FB            DJNZ .ig_clr_em
 542  6216 C9               RET
 543  6217
 544  6217              ; ================================================================
 545  6217              ; ПОРОЖДЕНИЕ ШАРА
 546  6217              ; Вход: A = угол, C = скорость
 547  6217              ; Позиция = FrogCenter + 6*Dir[N] (= ~24 пикселя от центра жабы по дуге).
 548  6217              ; Так шар появляется на ободе жабы в направлении выстрела.
 549  6217              ; ================================================================
 550  6217              SpawnBall:
 551  6217                  ; В VDC-модели стрельба разрешена ВСЕГДА: GAP-cells блокируют match-scan по слот-логике,
 552  6217                  ; offsets не используются. Игрок может накладывать gaps для extending pause.
 553  6217 32 B4 89         LD (TmpAngle), A
 554  621A 79               LD A, C
 555  621B 32 B5 89         LD (TmpSpeed), A
 556  621E
 557  621E                  ; Поиск свободного слота
 558  621E DD 21 E5 89      LD IX, BallTable
 559  6222 06 10            LD B, MAX_BALLS
 560  6224              .sb_find:
 561  6224 DD 7E 06         LD A, (IX+BALL_ACTIVE)
 562  6227 B7               OR A
 563  6228 28 08            JR Z, .sb_set
 564  622A 11 08 00         LD DE, 8
 565  622D DD 19            ADD IX, DE
 566  622F 10 F3            DJNZ .sb_find
 567  6231 C9               RET                          ; нет свободных слотов
 568  6232
 569  6232              .sb_set:
 570  6232                  ; NextBallColor = цвет ТЕКУЩЕГО выстрела (preview-шарик показывает его).
 571  6232                  ; После выстрела генерим новый цвет: LFSR × RTC_seconds mod 6.
 572  6232 3A 91 89         LD A, (NextBallColor)
 573  6235 DD 77 07         LD (IX+BALL_COLOR), A
 574  6238 CD 5E 68         CALL RandomBallColor
 575  623B 32 91 89         LD (NextBallColor), A
 576  623E
 577  623E 3A B4 89         LD A, (TmpAngle)
 578  6241 DD 77 04         LD (IX+BALL_ANGLE), A
 579  6244 AF               XOR A
 580  6245 DD 77 05         LD (IX+BALL_SPEED), A                 ; 0 = норм. шар (>0 = approach counter)
 581  6248 3E 01            LD A, 1
 582  624A DD 77 06         LD (IX+BALL_ACTIVE), A
 583  624D
 584  624D                  ; Index в таблицах Dir: N = угол >> 3 (0..31)
 585  624D 3A B4 89         LD A, (TmpAngle)
 586  6250 CB 3F            SRL A
 586  6252 CB 3F          SRL A
 586  6254 CB 3F          SRL A
 587  6256 5F               LD E, A
 588  6257 16 00            LD D, 0
 589  6259
 590  6259                  ; Стартовая позиция шара 16×16 = позиция preview-шарика во рту (+2*Dir смещение
 591  6259                  ; от центра жабы). Центр шара совпадает с центром preview, шар «выходит изо рта»
 592  6259                  ; в направлении полёта. См. UpdatePreviewSprite.
 593  6259                  ; --- X = FrogX + 8 + 2*DirX[N] ---
 594  6259 21 A9 8F         LD HL, DirXTable
 595  625C 19               ADD HL, DE
 596  625D 7E               LD A, (HL)                    ; signed -4..+4
 597  625E 87               ADD A, A                      ; A = 2*Dir
 598  625F 6F               LD L, A
 599  6260 26 00            LD H, 0
 600  6262 CB 7F            BIT 7, A
 601  6264 28 01            JR Z, .sb_x_pos
 602  6266 25               DEC H
 603  6267              .sb_x_pos:
 604  6267 ED 4B 8B 89      LD BC, (FrogX)
 605  626B 09               ADD HL, BC
 606  626C 01 14 00         LD BC, 20
 607  626F 09               ADD HL, BC                    ; HL = FrogX + 20 + 2*DirX (ball 24x24 top-left = FrogCenter - 12)
 608  6270 DD 75 00         LD (IX+BALL_X), L
 609  6273 7C               LD A, H
 610  6274 DD 77 01         LD (IX+BALL_X+1), A
 611  6277
 612  6277                  ; --- Y = FrogY + 8 + 2*DirY[N] ---
 613  6277 3A B4 89         LD A, (TmpAngle)
 614  627A CB 3F            SRL A
 614  627C CB 3F          SRL A
 614  627E CB 3F          SRL A
 615  6280 5F               LD E, A
 616  6281 16 00            LD D, 0
 617  6283 21 C9 8F         LD HL, DirYTable
 618  6286 19               ADD HL, DE
 619  6287 7E               LD A, (HL)
 620  6288 87               ADD A, A
 621  6289 6F               LD L, A
 622  628A 26 00            LD H, 0
 623  628C CB 7F            BIT 7, A
 624  628E 28 01            JR Z, .sb_y_pos
 625  6290 25               DEC H
 626  6291              .sb_y_pos:
 627  6291 ED 4B 8D 89      LD BC, (FrogY)
 628  6295 09               ADD HL, BC
 629  6296 01 14 00         LD BC, 20
 630  6299 09               ADD HL, BC                    ; HL = FrogY + 20 + 2*DirY (ball 24x24)
 631  629A DD 75 02         LD (IX+BALL_Y), L
 632  629D 7C               LD A, H
 633  629E DD 77 03         LD (IX+BALL_Y+1), A
 634  62A1 C9               RET
 635  62A2
 636  62A2              ; ================================================================
 637  62A2              ; ОБРАБОТКА ВВОДА — поворот O/P, выстрел Q
 638  62A2              ; O = бит 1 порта #DFFE, P = бит 0 порта #DFFE
 639  62A2              ; ================================================================
 640  62A2              HandleInput:
 641  62A2                  ; --- Поворот клавишами O/P ---
 642  62A2 01 FE DF         LD BC, KEY_O        ; #DFFE — общий порт для O и P
 643  62A5 ED 78            IN A, (C)
 644  62A7 5F               LD E, A             ; сохранить состояние строки клавиш
 645  62A8 CB 4F            BIT 1, A            ; O нажата?
 646  62AA 20 08            JR NZ, .check_p
 647  62AC 3A 8F 89         LD A, (FrogAngle)
 648  62AF D6 04            SUB ROTATION_SPEED
 649  62B1 32 8F 89         LD (FrogAngle), A
 650  62B4              .check_p:
 651  62B4 7B               LD A, E
 652  62B5 CB 47            BIT 0, A            ; P нажата?
 653  62B7 20 08            JR NZ, .check_space
 654  62B9 3A 8F 89         LD A, (FrogAngle)
 655  62BC C6 04            ADD A, ROTATION_SPEED
 656  62BE 32 8F 89         LD (FrogAngle), A
 657  62C1
 658  62C1              .check_space:
 659  62C1                  ; Строгий 1-нажатие = 1-выстрел. KeySpacePrev: 0=ready, 1=fired.
 660  62C1 01 FE 7F         LD BC, KEY_SPACE
 661  62C4 ED 78            IN A, (C)
 662  62C6 CB 47            BIT 0, A
 663  62C8 28 05            JR Z, .ks_pressed
 664  62CA AF               XOR A
 665  62CB 32 AA 89         LD (KeySpacePrev), A          ; released → reset
 666  62CE C9               RET
 667  62CF              .ks_pressed:
 668  62CF 3A AA 89         LD A, (KeySpacePrev)
 669  62D2 B7               OR A
 670  62D3 C0               RET NZ                         ; уже стреляли — ждём release
 671  62D4 3E 01            LD A, 1
 672  62D6 32 AA 89         LD (KeySpacePrev), A
 673  62D9 C3 9A 63         JP ShootBall
 674  62DC
 675  62DC              ; ================================================================
 676  62DC              ; УГОЛ ЛЯГУШКИ К КУРСОРУ МЫШИ
 677  62DC              ; Вход: MouseAbsX, MouseAbsY; лягушка зафиксирована в FrogX/FrogY
 678  62DC              ; Выход: FrogAngle (0=вправо, 64=вниз, 128=влево, 192=вверх)
 679  62DC              ; ================================================================
 680  62DC              ComputeFrogAngle:
 681  62DC                  ; dx = (MouseAbsX + 8) - (FrogX + 32) = MouseAbsX - FrogX - 24
 682  62DC                  ; (центр курсора 16×16 относительно центра жабы 64×64)
 683  62DC 2A AD 89         LD HL, (MouseAbsX)
 684  62DF ED 5B 8B 89      LD DE, (FrogX)
 685  62E3 A7               AND A
 686  62E4 ED 52            SBC HL, DE
 687  62E6 11 18 00         LD DE, 24
 688  62E9 A7               AND A
 689  62EA ED 52            SBC HL, DE
 690  62EC
 691  62EC 06 00            LD B, 0             ; флаги: бит0=dx<0, бит1=dy<0, бит2=|dy|>|dx|
 692  62EE CB 7C            BIT 7, H
 693  62F0 28 09            JR Z, .dx_pos
 694  62F2 CB C0            SET 0, B
 695  62F4 7C               LD A, H
 695  62F5 2F             CPL
 695  62F6 67             LD H, A
 696  62F7 7D               LD A, L
 696  62F8 2F             CPL
 696  62F9 6F             LD L, A
 697  62FA 23               INC HL
 698  62FB              .dx_pos:
 699  62FB 4D               LD C, L             ; C = |dx| (≤200, в 8 бит)
 700  62FC
 701  62FC                  ; dy = (MouseAbsY + 8) - (FrogY + 32) = MouseAbsY - FrogY - 24
 702  62FC 2A AF 89         LD HL, (MouseAbsY)
 703  62FF ED 5B 8D 89      LD DE, (FrogY)
 704  6303 A7               AND A
 705  6304 ED 52            SBC HL, DE
 706  6306 11 18 00         LD DE, 24
 707  6309 A7               AND A
 708  630A ED 52            SBC HL, DE
 709  630C
 710  630C CB 7C            BIT 7, H
 711  630E 28 09            JR Z, .dy_pos
 712  6310 CB C8            SET 1, B
 713  6312 7C               LD A, H
 713  6313 2F             CPL
 713  6314 67             LD H, A
 714  6315 7D               LD A, L
 714  6316 2F             CPL
 714  6317 6F             LD L, A
 715  6318 23               INC HL
 716  6319              .dy_pos:
 717  6319 5D               LD E, L             ; E = |dy| (≤167, в 8 бит)
 718  631A
 719  631A                  ; Если |dy| > |dx| — меняем местами, запоминаем флаг октанта
 720  631A 7B               LD A, E
 721  631B B9               CP C
 722  631C 38 05            JR C, .no_swap
 723  631E CB D0            SET 2, B
 724  6320 79               LD A, C
 724  6321 4B             LD C, E
 724  6322 5F             LD E, A
 725  6323              .no_swap:
 726  6323                  ; C = max(|dx|,|dy|), E = min(|dx|,|dy|)
 727  6323 79               LD A, C
 728  6324 B7               OR A
 729  6325 28 61            JR Z, .cfa_done     ; курсор на лягушке — не менять угол
 730  6327
 731  6327                  ; t = E*128 / C → 0..128 (4× разрешение vs исходных 32, плавнее на диагоналях)
 732  6327 26 00            LD H, 0
 733  6329 6B               LD L, E
 734  632A 29               ADD HL, HL
 734  632B 29             ADD HL, HL
 734  632C 29             ADD HL, HL
 735  632D 29               ADD HL, HL
 735  632E 29             ADD HL, HL
 735  632F 29             ADD HL, HL
