1273  66B5 29               ADD HL, HL                              ; HL = 2*(C-1)
1274  66B6 19               ADD HL, DE                              ; HL = 3*(C-1)
1275  66B7 29               ADD HL, HL                              ; HL = 6*(C-1)
1276  66B8 11 7A 03         LD DE, DESC_BALL0
1277  66BB 19               ADD HL, DE                              ; HL = DESC_BALL0 + 6*(C-1)
