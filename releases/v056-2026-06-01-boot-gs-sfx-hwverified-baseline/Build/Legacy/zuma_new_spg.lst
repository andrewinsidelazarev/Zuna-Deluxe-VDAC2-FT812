2867  6F95              .dgs_casc_no_shift:
2868  6F95 21 27 8F         LD HL, Chain0_SlotsLen
2869  6F98 35               DEC (HL)
2870  6F99 21 25 8F         LD HL, Chain0_HeadSlotAbs
2871  6F9C 7E               LD A, (HL)
2872  6F9D B7               OR A
2873  6F9E 28 01            JR Z, .dgs_casc_no_hsa_dec
2874  6FA0 35               DEC (HL)
2875  6FA1              .dgs_casc_no_hsa_dec:
2876  6FA1
2877  6FA1                  ; Cascade close: HSA-- сдвигает все nominals на -CELL_SIZE. Чтобы head-side
2878  6FA1                  ; визуально остался на месте В МОМЕНТ close, а потом ПЛАВНО откатился назад
2879  6FA1                  ; за CELL_SIZE кадров — компенсируем offset += CELL_SIZE с cap'ом max +CELL_SIZE
2880  6FA1                  ; (без cap'а множественные cascade'ы аккумулируют offsets до 70+ → head зависает).
2881  6FA1 3A A0 89         LD A, (TmpGapIdx)
2882  6FA4 B7               OR A
2883  6FA5 28 13            JR Z, .dgs_casc_no_off
2884  6FA7 47               LD B, A
2885  6FA8 21 65 8B         LD HL, Chain0_SlotOffsets
2886  6FAB              .dgs_casc_off_loop:
2887  6FAB 7E               LD A, (HL)
2888  6FAC B7               OR A
2889  6FAD F2 B4 6F         JP P, .dgs_casc_off_cap                   ; A_orig >= 0 (signed) → cap
2890  6FB0 C6 20            ADD A, CELL_SIZE                          ; A_orig < 0 → add normally
2891  6FB2 18 02            JR .dgs_casc_off_store
2892  6FB4              .dgs_casc_off_cap:
2893  6FB4 3E 20            LD A, CELL_SIZE
2894  6FB6              .dgs_casc_off_store:
2895  6FB6 77               LD (HL), A
2896  6FB7 23               INC HL
2897  6FB8 10 F1            DJNZ .dgs_casc_off_loop
2898  6FBA              .dgs_casc_no_off:
2899  6FBA                  ; chain_freeze: head компенсация декаит без параллельного chain motion →
2900  6FBA                  ; head визуально откатывается на CELL_SIZE px назад за CELL_SIZE кадров (видимый rollback).
2901  6FBA 3E 20            LD A, CELL_SIZE
2902  6FBC 32 9E 89         LD (ChainFreezeCounter), A
2903  6FBF                  ; Set MatchScanIdx после КАЖДОГО CASCADE close (как и для STOP).
2904  6FBF 3A A0 89         LD A, (TmpGapIdx)
2905  6FC2 32 9F 89         LD (MatchScanIdx), A
2906  6FC5
2907  6FC5                  ; Compaction-site Shot2 (как в STOP-pass) — Phase 1 ловит cascade combos.
2908  6FC5 3A A0 89         LD A, (TmpGapIdx)
2909  6FC8 B7               OR A
2910  6FC9 28 1A            JR Z, .dgs_casc_no_left_shot2
2911  6FCB 3D               DEC A
2912  6FCC 26 00            LD H, 0
2912  6FCE 6F             LD L, A
2913  6FCF 11 75 8A         LD DE, Chain0_Slots
2914  6FD2 19               ADD HL, DE
2915  6FD3 7E               LD A, (HL)
2916  6FD4 FE 06            CP NUM_BALL_COLORS
2917  6FD6 30 0D            JR NC, .dgs_casc_no_left_shot2
2918  6FD8 3A A0 89         LD A, (TmpGapIdx)
2919  6FDB 3D               DEC A
2920  6FDC 26 00            LD H, 0
2920  6FDE 6F             LD L, A
2921  6FDF 11 55 8C         LD DE, Chain0_Shot2
2922  6FE2 19               ADD HL, DE
2923  6FE3 36 01            LD (HL), 1
2924  6FE5              .dgs_casc_no_left_shot2:
2925  6FE5 3A A0 89         LD A, (TmpGapIdx)
2926  6FE8 21 27 8F         LD HL, Chain0_SlotsLen
2927  6FEB BE               CP (HL)
2928  6FEC 30 18            JR NC, .dgs_casc_no_self_shot2
2929  6FEE 26 00            LD H, 0
2929  6FF0 6F             LD L, A
2930  6FF1 11 75 8A         LD DE, Chain0_Slots
2931  6FF4 19               ADD HL, DE
2932  6FF5 7E               LD A, (HL)
2933  6FF6 FE 06            CP NUM_BALL_COLORS
2934  6FF8 30 0C            JR NC, .dgs_casc_no_self_shot2
2935  6FFA 3A A0 89         LD A, (TmpGapIdx)
2936  6FFD 26 00            LD H, 0
2936  6FFF 6F             LD L, A
2937  7000 11 55 8C         LD DE, Chain0_Shot2
2938  7003 19               ADD HL, DE
2939  7004 36 01            LD (HL), 1
2940  7006              .dgs_casc_no_self_shot2:
2941  7006 C9               RET
2942  7007
2943  7007              ; ================================================================
2944  7007              ; SCAN FOR NEW MATCH — full-chain window-3 scan. При найденном run >= 3
2945  7007              ; устанавливает TmpMatch* и вызывает CheckMatch3 без detect (= просто apply).
2946  7007              ; Используется AnimateChain после GAP-step — обнаружение новых match'ей
2947  7007              ; которые сложились из-за движения GAP'ов или новых spawn'ов.
2948  7007              ; ================================================================
2949  7007              ScanForNewMatch:
2950  7007                  ; Persistent Shot2-scan (запускается каждый кадр из AnimateChain). Не gated на
2951  7007                  ; MatchScanIdx — проверяет Shot2 каждый раз. Shot2 НЕ очищается на failed match —
2952  7007                  ; offset gap check в DetectMatch3 может временно блокировать match (offsets=-32
2953  7007                  ; после shift), а через ~25-32 кадров offsets decay'ят и match сработает естественно.
2954  7007                  ; Shot2 очищается ТОЛЬКО при:
2955  7007                  ;  - successful match (= consumed),
2956  7007                  ;  - slot стал GAP'ом (cleanup stale),
2957  7007                  ;  - offsets полностью settled (=0) у k и соседей (= retry done, no cascade).
2958  7007 3A 27 8F         LD A, (Chain0_SlotsLen)
2959  700A B7               OR A
2960  700B C8               RET Z
2961  700C 47               LD B, A                                   ; B = SlotsLen iter counter
2962  700D 21 55 8C         LD HL, Chain0_Shot2
2963  7010 0E 00            LD C, 0
2964  7012              .snm_shot2_loop:
2965  7012 7E               LD A, (HL)
2966  7013 B7               OR A
2967  7014 CA 73 70         JP Z, .snm_shot2_next
2968  7017
2969  7017                  ; --- Cleanup: Slots[C] is GAP → clear Shot2 (stale)  ---
2970  7017 C5               PUSH BC
2971  7018 E5               PUSH HL
2972  7019 79               LD A, C
2973  701A 26 00            LD H, 0
2973  701C 6F             LD L, A
2974  701D 11 75 8A         LD DE, Chain0_Slots
2975  7020 19               ADD HL, DE
2976  7021 7E               LD A, (HL)
2977  7022 E1               POP HL
2978  7023 C1               POP BC
2979  7024 FE 06            CP NUM_BALL_COLORS
2980  7026 38 05            JR C, .snm_check_match
2981  7028 36 00            LD (HL), 0                                ; GAP slot → clear Shot2
2982  702A C3 73 70         JP .snm_shot2_next
2983  702D
2984  702D              .snm_check_match:
2985  702D C5               PUSH BC
2986  702E E5               PUSH HL
2987  702F 79               LD A, C
2988  7030 32 CA 89         LD (TmpInsertIdx), A
2989  7033 CD 8A 6A         CALL CheckMatch3
2990  7036 E1               POP HL
2991  7037 C1               POP BC
2992  7038 B7               OR A
2993  7039 C0               RET NZ                                    ; match → cascade продолжается
2994  703A
2995  703A                  ; No match. Clear Shot2 only if offsets near k полностью settled (= retry done).
2996  703A C5               PUSH BC
2997  703B E5               PUSH HL
2998  703C 79               LD A, C
2999  703D 26 00            LD H, 0
2999  703F 6F             LD L, A
3000  7040 11 65 8B         LD DE, Chain0_SlotOffsets
3001  7043 19               ADD HL, DE
3002  7044 7E               LD A, (HL)
3003  7045 B7               OR A
3004  7046 20 29            JR NZ, .snm_unsettled                     ; offset[C] != 0
3005  7048                  ; Check left neighbor
3006  7048 79               LD A, C
3007  7049 B7               OR A
3008  704A 28 0C            JR Z, .snm_check_right
3009  704C 3D               DEC A
3010  704D 26 00            LD H, 0
3010  704F 6F             LD L, A
3011  7050 11 65 8B         LD DE, Chain0_SlotOffsets
3012  7053 19               ADD HL, DE
3013  7054 7E               LD A, (HL)
3014  7055 B7               OR A
3015  7056 20 19            JR NZ, .snm_unsettled
3016  7058              .snm_check_right:
3017  7058 79               LD A, C
3018  7059 3C               INC A
3019  705A 21 27 8F         LD HL, Chain0_SlotsLen
3020  705D BE               CP (HL)
3021  705E 30 0B            JR NC, .snm_settled
3022  7060 26 00            LD H, 0
3022  7062 6F             LD L, A
3023  7063 11 65 8B         LD DE, Chain0_SlotOffsets
3024  7066 19               ADD HL, DE
3025  7067 7E               LD A, (HL)
3026  7068 B7               OR A
3027  7069 20 06            JR NZ, .snm_unsettled
3028  706B              .snm_settled:
3029  706B E1               POP HL
3030  706C C1               POP BC
3031  706D 36 00            LD (HL), 0                                ; settled → clear Shot2[C]
3032  706F 18 02            JR .snm_shot2_next
3033  7071              .snm_unsettled:
3034  7071 E1               POP HL
3035  7072 C1               POP BC
3036  7073                  ; leave Shot2[C] = 1 для retry next frame
3037  7073
3038  7073              .snm_shot2_next:
3039  7073 23               INC HL
3040  7074 0C               INC C
3041  7075 10 9B            DJNZ .snm_shot2_loop
3042  7077 C9               RET
3043  7078
3044  7078              ; ================================================================
3045  7078              ; UPDATE STALL BY GAP — ChainStalled=1 если в Slots есть GAP, иначе 0.
3046  7078              ; ================================================================
3047  7078              UpdateStallByGap:
3048  7078 3A 27 8F         LD A, (Chain0_SlotsLen)
3049  707B B7               OR A
