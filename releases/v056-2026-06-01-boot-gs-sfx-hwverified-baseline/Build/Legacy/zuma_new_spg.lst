1320  6715              ; TRY SPAWN AND COUNT — обёртка вокруг SpawnChainBall, считает фактически
1321  6715              ; добавленных шаров (ChainLen после − ChainLen до). Saturate at 255.
1322  6715              ; ================================================================
1323  6715              TrySpawnAndCount:
1324  6715 3A 27 8F         LD A, (Chain0_SlotsLen)
1325  6718 F5               PUSH AF                                ; сохраняем prev на стек
1326  6719 CD 2C 67         CALL SpawnChainBall
1327  671C D1               POP DE                                 ; D = prev SlotsLen
1328  671D 3A 27 8F         LD A, (Chain0_SlotsLen)
1329  6720 92               SUB D
1330  6721 C8               RET Z
