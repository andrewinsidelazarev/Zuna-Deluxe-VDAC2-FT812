 783  636F 28 17            JR Z, .cfa_done
 784  6371 57               LD D, A                ; D = signed diff (запомним знак)
 785  6372 CB 7F            BIT 7, A
 786  6374 28 02            JR Z, .gp_pos
 787  6376 ED 44            NEG                    ; A = |diff|
