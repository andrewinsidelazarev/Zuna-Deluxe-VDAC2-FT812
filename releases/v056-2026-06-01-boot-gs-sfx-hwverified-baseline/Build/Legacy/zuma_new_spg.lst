2556  6DF3 32 DB 89       LD (TmpTargetY), A
2556  6DF6 32 DC 89       LD (TmpTargetY+1), A          ; clamp Y >= 0
2557  6DF9              .cat_y_ok:
2558  6DF9 C9               RET
2559  6DFA
2560  6DFA              ; ================================================================
2561  6DFA              ; ANIMATE CHAIN — VDC модель. Каждый GAP_STEP_FRAMES делает GAP-step:
2562  6DFA              ;   GAP_STOP двигается вправо (к tail в массиве): SWAP с Slots[k+1].
2563  6DFA              ;   GAP_CASCADE двигается влево (к head): SWAP с Slots[k-1].
2564  6DFA              ; Exit GAP с краёв массива → SlotsLen-=1 (для STOP) или shift_left+SlotsLen-=1+HSA-=1 (для CASCADE).
2565  6DFA              ; После GAP-step → match-scan для триггера новых match'ей (cascade chain).
2566  6DFA              ; ChainStalled=1 пока в Slots есть GAP-cells.
2567  6DFA              ; ================================================================
2568  6DFA              AnimateChain:
2569  6DFA                  ; --- Explosion-анимация: increment ExplodingFrame, финализация после EXPLOSION_FRAMES ---
2570  6DFA 3A 27 8F         LD A, (Chain0_SlotsLen)
2571  6DFD B7               OR A
2572  6DFE 28 32            JR Z, .ac_after_explode
2573  6E00 47               LD B, A
2574  6E01 21 45 8D         LD HL, Chain0_ExplodingFrame
2575  6E04              .ac_explode_loop:
2576  6E04 7E               LD A, (HL)
2577  6E05 B7               OR A
2578  6E06 28 27            JR Z, .ac_explode_next
2579  6E08 3C               INC A
2580  6E09 FE 0F            CP EXPLOSION_FRAMES + 1
2581  6E0B 38 21            JR C, .ac_explode_save
2582  6E0D                  ; Frame >= EXPLOSION_FRAMES → финализация: Slots[i]=ExplodingMarker[i], ExplodingFrame[i]=0.
2583  6E0D AF               XOR A
2584  6E0E 77               LD (HL), A                                ; ExplodingFrame[i] = 0
2585  6E0F E5               PUSH HL
2586  6E10 C5               PUSH BC
2587  6E11 3A 27 8F         LD A, (Chain0_SlotsLen)
2588  6E14 90               SUB B                                     ; A = i (поскольку B уменьшается с len до 1)
2589  6E15 26 00            LD H, 0
2589  6E17 6F             LD L, A
2590  6E18 11 35 8E         LD DE, Chain0_ExplodingMarker
2591  6E1B 19               ADD HL, DE
2592  6E1C 7E               LD A, (HL)                                ; A = saved GAP_STOP/CASCADE
2593  6E1D 4F               LD C, A
2594  6E1E 3A 27 8F         LD A, (Chain0_SlotsLen)
2595  6E21 90               SUB B
2596  6E22 26 00            LD H, 0
2596  6E24 6F             LD L, A
2597  6E25 11 75 8A         LD DE, Chain0_Slots
2598  6E28 19               ADD HL, DE
2599  6E29 71               LD (HL), C                                ; Slots[i] = marker
2600  6E2A C1               POP BC
2601  6E2B E1               POP HL
2602  6E2C 18 01            JR .ac_explode_next
2603  6E2E              .ac_explode_save:
2604  6E2E 77               LD (HL), A
2605  6E2F              .ac_explode_next:
2606  6E2F 23               INC HL
2607  6E30 10 D2            DJNZ .ac_explode_loop
2608  6E32              .ac_after_explode:
2609  6E32
2610  6E32                  ; Каждый кадр decay'им offsets к 0 на 1 px (= плавное движение GAP-step через offsets).
2611  6E32 3A 27 8F         LD A, (Chain0_SlotsLen)
2612  6E35 B7               OR A
2613  6E36 28 14            JR Z, .ac_after_decay
2614  6E38 47               LD B, A
2615  6E39 21 65 8B         LD HL, Chain0_SlotOffsets
2616  6E3C              .ac_decay_loop:
2617  6E3C 7E               LD A, (HL)
2618  6E3D B7               OR A
2619  6E3E 28 09            JR Z, .ac_decay_skip
2620  6E40 CB 7F            BIT 7, A
2621  6E42 20 03            JR NZ, .ac_decay_neg
2622  6E44 3D               DEC A                                     ; positive → 0
2623  6E45 18 01            JR .ac_decay_store
2624  6E47              .ac_decay_neg:
2625  6E47 3C               INC A                                     ; negative → 0
2626  6E48              .ac_decay_store:
2627  6E48 77               LD (HL), A
2628  6E49              .ac_decay_skip:
2629  6E49 23               INC HL
2630  6E4A 10 F0            DJNZ .ac_decay_loop
2631  6E4C              .ac_after_decay:
2632  6E4C
2633  6E4C                  ; GAP step counter (full SWAP каждые GAP_STEP_FRAMES = CELL_SIZE кадров)
2634  6E4C 3A 9D 89         LD A, (GapStepCounter)
2635  6E4F 3C               INC A
2636  6E50 FE 20            CP GAP_STEP_FRAMES
2637  6E52 38 07            JR C, .ac_save_counter
2638  6E54 AF               XOR A
2639  6E55 32 9D 89         LD (GapStepCounter), A
2640  6E58 CD 65 6E         CALL DoGapStep
2641  6E5B              .ac_save_counter:
2642  6E5B 32 9D 89         LD (GapStepCounter), A
2643  6E5E                  ; Persistent scan: каждый кадр проверяем Shot2 markers (offset gap может временно
2644  6E5E                  ; блокировать match, но через ~25-32 кадра offsets decay'ят и cascade сработает).
2645  6E5E CD 07 70         CALL ScanForNewMatch
2646  6E61 CD 78 70         CALL UpdateStallByGap
2647  6E64 C9               RET
2648  6E65
2649  6E65              ; ================================================================
2650  6E65              ; DO GAP STEP — один шаг movement всех GAP-cells.
2651  6E65              ; STOP-cells: pass right→left (чтобы swap не двигал тот же cell дважды),
2652  6E65              ;             swap Slots[k] = STOP с Slots[k+1] = (color/non-STOP).
2653  6E65              ;             Если k+1 == SlotsLen → SlotsLen -= 1 (exit с tail-end).
2654  6E65              ; CASCADE-cells: pass left→right, swap Slots[k] = CASCADE с Slots[k-1].
2655  6E65              ;             Если k == 0 → shift_left + HSA -= 1 + SlotsLen -= 1.
2656  6E65              ; ================================================================
2657  6E65              DoGapStep:
2658  6E65                  ; --- Pass 1: STOP closure — last GAP_STOP from tail-side (хвост подъезжает к голове) ---
2659  6E65 3A 27 8F         LD A, (Chain0_SlotsLen)
2660  6E68 B7               OR A
2661  6E69 CA 38 6F         JP Z, .dgs_cascade_init
2662  6E6C 3D               DEC A                                     ; A = SlotsLen-1
2663  6E6D 4F               LD C, A                                   ; C = current idx (start at end)
2664  6E6E 26 00            LD H, 0
2664  6E70 6F             LD L, A
2665  6E71 11 75 8A         LD DE, Chain0_Slots
2666  6E74 19               ADD HL, DE                                ; HL = &Slots[SlotsLen-1]
2667  6E75              .dgs_stop_scan:
2668  6E75 7E               LD A, (HL)
2669  6E76 FE FE            CP GAP_STOP
2670  6E78 28 09            JR Z, .dgs_stop_found
2671  6E7A 79               LD A, C
2672  6E7B B7               OR A
2673  6E7C CA 38 6F         JP Z, .dgs_cascade_init
2674  6E7F 0D               DEC C
2675  6E80 2B               DEC HL
2676  6E81 18 F2            JR .dgs_stop_scan
2677  6E83
2678  6E83              .dgs_stop_found:
2679  6E83                  ; C = idx последнего GAP_STOP. Сохраняем для offset shift.
2680  6E83 79               LD A, C
2681  6E84 32 A0 89         LD (TmpGapIdx), A
2682  6E87
2683  6E87                  ; Удалить slot C: shift_left Slots[C+1..end] → Slots[C..end-1]
2684  6E87 3A 27 8F         LD A, (Chain0_SlotsLen)
2685  6E8A 91               SUB C
2686  6E8B 3D               DEC A                                     ; A = count = SlotsLen - C - 1
2687  6E8C 28 3D            JR Z, .dgs_stop_no_shift
2688  6E8E F5               PUSH AF                                   ; save count
2689  6E8F
2690  6E8F 79               LD A, C
2691  6E90 3C               INC A
2692  6E91 26 00            LD H, 0
2692  6E93 6F             LD L, A
2693  6E94 11 75 8A         LD DE, Chain0_Slots
2694  6E97 19               ADD HL, DE                                ; HL = &Slots[C+1]
2695  6E98 54               LD D, H
2695  6E99 5D             LD E, L
2696  6E9A 1B               DEC DE                                    ; DE = &Slots[C]
2697  6E9B F1               POP AF
2698  6E9C F5               PUSH AF
2699  6E9D 4F               LD C, A
2699  6E9E 06 00          LD B, 0
2700  6EA0 ED B0            LDIR
2701  6EA2
2702  6EA2                  ; SlotOffsets shift аналогично
2703  6EA2 3A A0 89         LD A, (TmpGapIdx)
2704  6EA5 3C               INC A
2705  6EA6 26 00            LD H, 0
2705  6EA8 6F             LD L, A
2706  6EA9 11 65 8B         LD DE, Chain0_SlotOffsets
2707  6EAC 19               ADD HL, DE
2708  6EAD 54               LD D, H
2708  6EAE 5D             LD E, L
2709  6EAF 1B               DEC DE
2710  6EB0 F1               POP AF
2711  6EB1 F5               PUSH AF
2712  6EB2 4F               LD C, A
2712  6EB3 06 00          LD B, 0
2713  6EB5 ED B0            LDIR
2714  6EB7
2715  6EB7                  ; Shot2 shift аналогично
2716  6EB7 3A A0 89         LD A, (TmpGapIdx)
2717  6EBA 3C               INC A
2718  6EBB 26 00            LD H, 0
2718  6EBD 6F             LD L, A
2719  6EBE 11 55 8C         LD DE, Chain0_Shot2
2720  6EC1 19               ADD HL, DE
2721  6EC2 54               LD D, H
2721  6EC3 5D             LD E, L
2722  6EC4 1B               DEC DE
2723  6EC5 F1               POP AF
2724  6EC6 4F               LD C, A
2724  6EC7 06 00          LD B, 0
2725  6EC9 ED B0            LDIR
2726  6ECB              .dgs_stop_no_shift:
2727  6ECB 21 27 8F         LD HL, Chain0_SlotsLen
2728  6ECE 35               DEC (HL)
2729  6ECF
2730  6ECF                  ; STOP теперь cascade-like: HSA-=1, head комп +CELL_SIZE с cap'ом. Tail НЕ
2731  6ECF                  ; компенсируем — shift idx-=1 + HSA-=1 = position preserved автоматически.
2732  6ECF 21 25 8F         LD HL, Chain0_HeadSlotAbs
2733  6ED2 7E               LD A, (HL)
2734  6ED3 B7               OR A
2735  6ED4 28 01            JR Z, .dgs_stop_no_hsa_dec
2736  6ED6 35               DEC (HL)
2737  6ED7              .dgs_stop_no_hsa_dec:
2738  6ED7                  ; offsets[0..K-1] = min(offsets[j] + CELL_SIZE, CELL_SIZE) — head компенсация с cap'ом.
2739  6ED7                  ; Equivalent: if A_orig >= 0 → CELL_SIZE; else → A_orig + CELL_SIZE.
2740  6ED7 3A A0 89         LD A, (TmpGapIdx)
2741  6EDA B7               OR A
2742  6EDB 28 13            JR Z, .dgs_stop_no_off
2743  6EDD 47               LD B, A                                   ; B = count = K
2744  6EDE 21 65 8B         LD HL, Chain0_SlotOffsets
2745  6EE1              .dgs_stop_off_loop:
2746  6EE1 7E               LD A, (HL)
2747  6EE2 B7               OR A
2748  6EE3 F2 EA 6E         JP P, .dgs_stop_off_cap                   ; A_orig >= 0 (signed) → cap
2749  6EE6 C6 20            ADD A, CELL_SIZE                          ; A_orig < 0 → add normally
2750  6EE8 18 02            JR .dgs_stop_off_store
2751  6EEA              .dgs_stop_off_cap:
2752  6EEA 3E 20            LD A, CELL_SIZE
2753  6EEC              .dgs_stop_off_store:
2754  6EEC 77               LD (HL), A
2755  6EED 23               INC HL
2756  6EEE 10 F1            DJNZ .dgs_stop_off_loop
2757  6EF0              .dgs_stop_no_off:
2758  6EF0                  ; Set MatchScanIdx после каждого STOP close — для ScanForNewMatch (Phase 1).
2759  6EF0 3A A0 89         LD A, (TmpGapIdx)
2760  6EF3 32 9F 89         LD (MatchScanIdx), A
2761  6EF6
2762  6EF6                  ; Compaction-site Shot2: на новом соседе K-1 (= балл который только что встал
2763  6EF6                  ; рядом с тем, что было K+1). Phase 1 ловит такой compaction-cascade combo
2764  6EF6                  ; без необходимости Phase 2 full-chain scan'а (= источник «ложных» match'ей).
2765  6EF6                  ; Также пометить slot K (= shifted-in ball) для симметрии.
2766  6EF6 3A A0 89         LD A, (TmpGapIdx)
2767  6EF9 B7               OR A
2768  6EFA 28 1A            JR Z, .dgs_stop_no_left_shot2          ; K=0 → нет K-1
2769  6EFC 3D               DEC A                                   ; A = K-1
2770  6EFD 26 00            LD H, 0
2770  6EFF 6F             LD L, A
2771  6F00 11 75 8A         LD DE, Chain0_Slots
2772  6F03 19               ADD HL, DE
2773  6F04 7E               LD A, (HL)
2774  6F05 FE 06            CP NUM_BALL_COLORS
2775  6F07 30 0D            JR NC, .dgs_stop_no_left_shot2          ; K-1 = GAP → не маркируем
2776  6F09 3A A0 89         LD A, (TmpGapIdx)
2777  6F0C 3D               DEC A
2778  6F0D 26 00            LD H, 0
2778  6F0F 6F             LD L, A
2779  6F10 11 55 8C         LD DE, Chain0_Shot2
2780  6F13 19               ADD HL, DE
2781  6F14 36 01            LD (HL), 1
2782  6F16              .dgs_stop_no_left_shot2:
2783  6F16 3A A0 89         LD A, (TmpGapIdx)
2784  6F19 21 27 8F         LD HL, Chain0_SlotsLen
2785  6F1C BE               CP (HL)
2786  6F1D 30 18            JR NC, .dgs_stop_no_self_shot2          ; K >= SlotsLen → нет slot K
2787  6F1F 26 00            LD H, 0
2787  6F21 6F             LD L, A
2788  6F22 11 75 8A         LD DE, Chain0_Slots
2789  6F25 19               ADD HL, DE
2790  6F26 7E               LD A, (HL)
2791  6F27 FE 06            CP NUM_BALL_COLORS
2792  6F29 30 0C            JR NC, .dgs_stop_no_self_shot2          ; slot K = GAP → не маркируем
2793  6F2B 3A A0 89         LD A, (TmpGapIdx)
2794  6F2E 26 00            LD H, 0
2794  6F30 6F             LD L, A
2795  6F31 11 55 8C         LD DE, Chain0_Shot2
2796  6F34 19               ADD HL, DE
2797  6F35 36 01            LD (HL), 1
2798  6F37              .dgs_stop_no_self_shot2:
2799  6F37 C9               RET                                       ; обработали STOP — не идём в CASCADE pass.
2800  6F38                                                            ; Иначе STOP+CASCADE в одном тике дают HSA-=2
2801  6F38                                                            ; без двойной компенсации → рывок head -32 px.
2802  6F38
2803  6F38              .dgs_cascade_init:
2804  6F38                  ; --- Pass 2: CASCADE closure — first GAP_CASCADE from head-side
2805  6F38                  ;     (голова катится к хвосту, GAP тает от head-стороны) ---
2806  6F38 3A 27 8F         LD A, (Chain0_SlotsLen)
2807  6F3B B7               OR A
2808  6F3C C8               RET Z
2809  6F3D 47               LD B, A                                   ; B = SlotsLen (DJNZ counter)
2810  6F3E 0E 00            LD C, 0                                   ; C = idx
2811  6F40 21 75 8A         LD HL, Chain0_Slots
