 359  60BE              ; ============================================================================
 360  60BE              ; RENDER FRAME — atomic swap + все DMA/TSU writes.
 361  60BE              ; Вызывается раз когда вся логика догнала тики.
 362  60BE              ; ============================================================================
 363  60BE              RenderFrame:
 364  60BE                  ; ====== СВОП BUFFER (atomic) ======
 365  60BE 3A A6 75         LD A, (VisiblePageBase)
 365  60C1 EE 30          XOR #30
 365  60C3 32 A6 75       LD (VisiblePageBase), A
 366  60C6 3A A7 75         LD A, (ShadowPageBase)
 366  60C9 EE 30          XOR #30
 366  60CB 32 A7 75       LD (ShadowPageBase), A
 367  60CE 3A A6 75         LD A, (VisiblePageBase)
 367  60D1 01 AF 01       LD BC, VPAGE
 367  60D4 ED 79          OUT (C), A
 368  60D6
 369  60D6                  ; DEBUG: пиксель (0,287) = цвет FrogAngle
 370  60D6 01 AF 13         LD BC, PAGE3
 370  60D9 3E 18          LD A, #18
 370  60DB ED 79          OUT (C), A
 371  60DD 3A 8F 89         LD A, (FrogAngle)
 372  60E0 32 00 FE         LD (#FE00), A
 373  60E3 01 AF 13         LD BC, PAGE3
 373  60E6 AF             XOR A
 373  60E7 ED 79          OUT (C), A
 374  60E9
 375  60E9 CD 37 66         CALL UpdateFrogSprite
 376  60EC CD 3C 87         CALL UpdatePreviewSprite
 377  60EF CD 97 66         CALL UpdateBallSprites
 378  60F2 CD E5 86         CALL HideChainSprites
 379  60F5 CD 98 85         CALL BlitKillzoneToShadow
 380  60F8 CD 0C 87         CALL UpdateCursorSprite
 381  60FB CD 69 72         CALL BlitChainToShadow
 382  60FE C9               RET
