2820  6F4D
2821  6F4D              .dgs_casc_found:
2822  6F4D 79               LD A, C
2823  6F4E 32 A0 89         LD (TmpGapIdx), A
2824  6F51
2825  6F51                  ; Удалить slot C: shift_left Slots[C+1..end] → Slots[C..end-1]
2826  6F51 3A 27 8F         LD A, (Chain0_SlotsLen)
2827  6F54 91               SUB C
