2379  6CBA 32 D4 89         LD (TmpHasPrev), A
2380  6CBD 3A BB 89         LD A, (TmpChainIdx)
2381  6CC0 B7               OR A
2382  6CC1 28 25            JR Z, .hem_check_next                 ; i=0 → нет prev
2383  6CC3 47               LD B, A                               ; B = i
2384  6CC4              .hem_find_prev:
2385  6CC4 05               DEC B                                  ; B = candidate idx
2386  6CC5 26 00            LD H, 0
2386  6CC7 68             LD L, B
2387  6CC8 11 75 8A         LD DE, Chain0_Slots
2388  6CCB 19               ADD HL, DE
2389  6CCC 7E               LD A, (HL)
2390  6CCD FE 06            CP NUM_BALL_COLORS
2391  6CCF 38 06            JR C, .hem_have_prev                  ; < NUM → non-GAP
2392  6CD1 78               LD A, B
2393  6CD2 B7               OR A
2394  6CD3 20 EF            JR NZ, .hem_find_prev
2395  6CD5 18 11            JR .hem_check_next
2396  6CD7              .hem_have_prev:
2397  6CD7 78               LD A, B
2398  6CD8 C5               PUSH BC
2399  6CD9 CD 3D 6B         CALL ComputeSlotXY
2400  6CDC CD 99 6B         CALL ManhattanDistToBall
2401  6CDF C1               POP BC
