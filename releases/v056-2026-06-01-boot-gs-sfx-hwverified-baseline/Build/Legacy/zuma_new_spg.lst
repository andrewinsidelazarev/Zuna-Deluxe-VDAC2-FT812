2848  6F76 19               ADD HL, DE
2849  6F77 54               LD D, H
2849  6F78 5D             LD E, L
2850  6F79 1B               DEC DE
2851  6F7A F1               POP AF
2852  6F7B F5               PUSH AF
2853  6F7C 4F               LD C, A
2853  6F7D 06 00          LD B, 0
2854  6F7F ED B0            LDIR
2855  6F81
2856  6F81                  ; Shot2 shift аналогично
2857  6F81 3A A0 89         LD A, (TmpGapIdx)
2858  6F84 3C               INC A
2859  6F85 26 00            LD H, 0
2859  6F87 6F             LD L, A
2860  6F88 11 55 8C         LD DE, Chain0_Shot2
2861  6F8B 19               ADD HL, DE
2862  6F8C 54               LD D, H
2862  6F8D 5D             LD E, L
2863  6F8E 1B               DEC DE
2864  6F8F F1               POP AF
2865  6F90 4F               LD C, A
2865  6F91 06 00          LD B, 0
