  95  0000              ; TSU SPSIZE / SPACT / SPLEAP
  96  0000              SPSIZ8   EQU #00    ; размер 8
  97  0000              SPSIZ16  EQU #02    ; размер 16
  98  0000              SPSIZ24  EQU #04    ; размер 24
  99  0000              SPSIZ32  EQU #06    ; размер 32
 100  0000              SPACT    EQU #20    ; бит ACT — спрайт включён
