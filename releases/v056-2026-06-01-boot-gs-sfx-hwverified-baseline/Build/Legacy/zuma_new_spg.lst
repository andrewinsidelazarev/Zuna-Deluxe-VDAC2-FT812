 766  635E CB 48            BIT 1, B
 767  6360 28 02            JR Z, .store        ; Q1: dx≥0, dy≥0 → A (восток..юг)
 768  6362                  ; Q4: dx≥0, dy<0 → -A mod 256 (север..восток)
 769  6362 ED 44            NEG
 770  6364              .store:
 771  6364                  ; Вход: A = новый угол; C = max(|dx|,|dy|).
 772  6364                  ; Стратегия: гибрид «быстрый/медленный»
 773  6364                  ;   |diff| >= 4  → full update (быстрое движение)
 774  6364                  ;   1 <= |diff| <= 3 → шаг на 1 unit в направлении (плавное следование без отставания)
 775  6364                  ;   |diff| == 0  → no-op
 776  6364 47               LD B, A                ; B = new
 777  6365 79               LD A, C
 778  6366 FE 05            CP 5
 779  6368 38 1E            JR C, .cfa_done        ; deadzone: курсор точно на жабе
 780  636A 78               LD A, B
 781  636B 21 8F 89         LD HL, FrogAngle
