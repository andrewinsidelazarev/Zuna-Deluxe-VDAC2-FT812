1260  66AE              ; ================================================================
1261  66AE              ; ОБНОВЛЕНИЕ СПРАЙТА ШАРА (16×16, 4bpp).
1262  66AE              ; Атлас в page 7 на TNUM 768 + COLOR*2 (от 768 до 778). SPAL = 2 + COLOR.
1263  66AE              ; Если ACTIVE=0, пишем нулевой дескриптор (ACT bit не установлен → невидимый).
1264  66AE              ; ================================================================
1265  66AE              UpdateBallSprite:
1266  66AE                  ; HL = DESC_BALL0 + (C-1)*6  (C = 1..MAX_BALLS).
1267  66AE                  ; Для C=1: HL = #020C (descriptor 2). Для C=32: HL = #02C6 (descriptor 33).
1268  66AE 79               LD A, C
1269  66AF 3D               DEC A
