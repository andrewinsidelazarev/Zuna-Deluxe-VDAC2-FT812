 738  6334 FE 81            CP 129
 739  6336 38 02            JR C, .do_lookup
 740  6338 3E 80            LD A, 128           ; clamp до 128 (последний валидный индекс)
 741  633A              .do_lookup:
 742  633A 21 28 8F         LD HL, AtanTable
 743  633D 16 00            LD D, 0
 743  633F 5F             LD E, A
 744  6340 19               ADD HL, DE
 745  6341 7E               LD A, (HL)          ; A = угол 1-го октанта (0..32 в ед. 1/256 окружности)
 746  6342
 747  6342                  ; Если был swap — зеркалим к 90°: A = 64 - A
 748  6342 CB 50            BIT 2, B
 749  6344 28 04            JR Z, .no_mirror
 750  6346 5F               LD E, A
 750  6347 3E 40          LD A, 64
 750  6349 93             SUB E
 751  634A              .no_mirror:
 752  634A                  ; A = угол в квадранте 0..64 (0°..90° от оси X)
 753  634A                  ; Применяем знаки dx/dy
 754  634A CB 40            BIT 0, B
 755  634C 28 10            JR Z, .dx_pos2
 756  634E CB 48            BIT 1, B
 757  6350 28 06            JR Z, .q2
 758  6352                  ; Q3: dx<0, dy<0 → 128 + A (запад..север)
 759  6352 5F               LD E, A
 759  6353 3E 80          LD A, 128
 759  6355 83             ADD A, E
 760  6356 18 0C            JR .store
