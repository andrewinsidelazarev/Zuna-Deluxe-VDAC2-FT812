3263  71DC              ; ================================================================
3264  71DC              ; LOAD BALLS DMA PALETTE — копирует 32 CRAM word из BallsDmaPalette
3265  71DC              ; в FM-mapped CRAM byte offset 256 (= CRAM #80..#9F).
3266  71DC              ; ================================================================
3267  71DC              LoadBallsDmaPalette:
3268  71DC 01 AF 15         LD BC, FMADDR
3268  71DF 3E 10          LD A, FM_EN
3268  71E1 ED 79          OUT (C), A
3269  71E3 21 09 94         LD HL, BallsDmaPalette
3270  71E6 11 C0 01         LD DE, #01C0                              ; CRAM #E0 word = byte offset 448 = #01C0
3271  71E9 01 40 00         LD BC, 64                                 ; 32 words × 2 byte
3272  71EC ED B0            LDIR
3273  71EE 01 AF 15         LD BC, FMADDR
3273  71F1 AF             XOR A
3273  71F2 ED 79          OUT (C), A
3274  71F4 C9               RET
