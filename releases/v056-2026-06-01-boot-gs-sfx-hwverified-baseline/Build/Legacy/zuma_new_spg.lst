3079  70A3              ; ================================================================
3080  70A3              ; MOVE CHAIN — попиксельное движение через HeadSub (0..CELL_SIZE-1).
3081  70A3              ; HeadSub++ каждый вызов; overflow → HeadSub=0, HeadSlotAbs++.
3082  70A3              ; Cascade reverse: HeadSub--, underflow → HeadSub=CELL_SIZE-1, HeadSlotAbs--.
3083  70A3              ; ChainStalled — стоп.
3084  70A3              ; ================================================================
3085  70A3              TRACK_NUM_SLOTS       EQU TRACK_NUM_POINTS / CELL_SIZE  ; 96
