1339  672C              ; ================================================================
1340  672C              ; SPAWN CHAIN BALL — добавить новый шар в tail (Slots[SlotsLen] = color).
1341  672C              ; Шар появится на t = (HSA - SlotsLen) * CELL_SIZE + HeadSub — может быть
1342  672C              ; отрицательным в начале; станет видимым по мере движения цепочки (HSA растёт).
1343  672C              ; ================================================================
1344  672C              ; Агрессивный спавн: спавним в цикле, пока есть место (= SlotsLen < MAX_SLOTS_PER_CHAIN)
1345  672C              ; и tail настроен (offset=0). Держит хвост прижатым к старту трека.
1346  672C              SpawnChainBall:
1347  672C              .scb_loop:
1348  672C                  ; Pending compaction (visible gap) — стоп.
1349  672C 3A 9C 89         LD A, (CompactTimer)
1350  672F B7               OR A
1351  6730 C0               RET NZ
1352  6731
1353  6731 3A 27 8F         LD A, (Chain0_SlotsLen)
1354  6734 FE F0            CP MAX_SLOTS_PER_CHAIN
1355  6736 D0               RET NC                               ; full → стоп
1356  6737
1357  6737                  ; Stall-animation safety: спавн разрешён только если tail-шар (SlotsLen-1)
1358  6737                  ; имеет offset=0 (= не двигается).
1359  6737 B7               OR A
1360  6738 28 0B            JR Z, .scb_check_place               ; SlotsLen=0 → нет tail-шара, OK
1361  673A 3D               DEC A
1362  673B 26 00            LD H, 0
1362  673D 6F             LD L, A
1363  673E 11 65 8B         LD DE, Chain0_SlotOffsets
1364  6741 19               ADD HL, DE
1365  6742 7E               LD A, (HL)
1366  6743 B7               OR A
1367  6744 C0               RET NZ                               ; tail offset ≠ 0 → не спавн
1368  6745              .scb_check_place:
1369  6745
1370  6745                  ; Должно быть HeadSlotAbs >= SlotsLen (иначе tail за стартом трека).
1371  6745 3A 25 8F         LD A, (Chain0_HeadSlotAbs)
1372  6748 21 27 8F         LD HL, Chain0_SlotsLen
1373  674B BE               CP (HL)
1374  674C D8               RET C                                ; HeadSlotAbs < SlotsLen → нет места
1375  674D
1376  674D                  ; Slots[SlotsLen] = NextChainColor; SlotOffsets[SlotsLen] = 0
1377  674D 3A 27 8F         LD A, (Chain0_SlotsLen)
1378  6750 26 00            LD H, 0
1378  6752 6F             LD L, A
1379  6753 11 75 8A         LD DE, Chain0_Slots
1380  6756 19               ADD HL, DE                              ; HL = &Slots[SlotsLen]
1381  6757
1382  6757                  ; Anti-3-in-row spawn-guard
1383  6757 3A C1 89         LD A, (NextChainColor)
1384  675A 47               LD B, A                                 ; B = candidate
1385  675B 3A 27 8F         LD A, (Chain0_SlotsLen)
1386  675E FE 02            CP 2
1387  6760 38 13            JR C, .scb_no_avoid                     ; SlotsLen<2 → нечему совпадать
1388  6762 E5               PUSH HL
1389  6763 2B               DEC HL                                  ; &Slots[len-1]
1390  6764 7E               LD A, (HL)
1391  6765 2B               DEC HL                                  ; &Slots[len-2]
1392  6766 BE               CP (HL)
1393  6767 20 0B            JR NZ, .scb_avoid_done
1394  6769 B8               CP B
1395  676A 20 08            JR NZ, .scb_avoid_done
1396  676C 78               LD A, B
1397  676D 3C               INC A
1398  676E FE 06            CP NUM_BALL_COLORS
1399  6770 38 01            JR C, .scb_avoid_store
1400  6772 AF               XOR A
1401  6773              .scb_avoid_store:
1402  6773 47               LD B, A
1403  6774              .scb_avoid_done:
1404  6774 E1               POP HL
1405  6775              .scb_no_avoid:
1406  6775 78               LD A, B
1407  6776 77               LD (HL), A
1408  6777
1409  6777                  ; SlotOffsets[SlotsLen] = SlotOffsets[SlotsLen-1] (или 0 если цепь пуста).
1410  6777                  ; Шар появляется 32 px позади хвоста с тем же offset → синхронный decay phase,
1411  6777                  ; ровный 32 px spacing, нет «дырок» между ним и хвостом.
1412  6777 3A 27 8F         LD A, (Chain0_SlotsLen)
1413  677A B7               OR A
1414  677B 28 0B            JR Z, .scb_off_zero
1415  677D 3D               DEC A
1416  677E 26 00            LD H, 0
1416  6780 6F             LD L, A
1417  6781 11 65 8B         LD DE, Chain0_SlotOffsets
1418  6784 19               ADD HL, DE
1419  6785 7E               LD A, (HL)                               ; A = SlotOffsets[SlotsLen-1]
1420  6786 18 01            JR .scb_off_set
1421  6788              .scb_off_zero:
1422  6788 AF               XOR A
1423  6789              .scb_off_set:
1424  6789 4F               LD C, A                                  ; C = new_offset
1425  678A 3A 27 8F         LD A, (Chain0_SlotsLen)
1426  678D 26 00            LD H, 0
1426  678F 6F             LD L, A
1427  6790 11 65 8B         LD DE, Chain0_SlotOffsets
1428  6793 19               ADD HL, DE
1429  6794 71               LD (HL), C
1430  6795
1431  6795 CD D3 67         CALL RandomChainColor
1432  6798 32 C1 89         LD (NextChainColor), A
1433  679B 3A 27 8F         LD A, (Chain0_SlotsLen)
1434  679E 3C               INC A
1435  679F 32 27 8F         LD (Chain0_SlotsLen), A
1436  67A2 18 88            JR .scb_loop
1437  67A4
1438  67A4              ; ================================================================
1439  67A4              ; LFSR16 — Galois 16-битный, polynomial $D008. Период 65535.
1440  67A4              ; Вход: HL = текущий seed (≠0). Выход: HL = новый seed.
1441  67A4              ; ================================================================
1442  67A4              LFSR16:
1443  67A4 CB 3C            SRL H
1444  67A6 CB 1D            RR L
1445  67A8 D0               RET NC
1446  67A9 7C               LD A, H
1446  67AA EE D0          XOR $D0
1446  67AC 67             LD H, A
1447  67AD 7D               LD A, L
1447  67AE EE 08          XOR $08
1447  67B0 6F             LD L, A
1448  67B1 C9               RET
1449  67B2
1450  67B2              ; ================================================================
1451  67B2              ; READ RTC SECONDS — читает регистр 0 GLUK CMOS RTC, возвращает binary 0..59.
1452  67B2              ; Порты #DFF7 (адрес) / #BFF7 (данные). Регистр 0 = секунды (BCD).
1453  67B2              ; ================================================================
1454  67B2              ReadRTCSeconds:
1455  67B2 01 F7 DF         LD BC, #DFF7
1456  67B5 AF               XOR A
1457  67B6 ED 79            OUT (C), A                            ; reg 0 = seconds
1458  67B8 01 F7 BF         LD BC, #BFF7
1459  67BB ED 78            IN A, (C)                             ; A = BCD seconds
1460  67BD 47               LD B, A
1461  67BE E6 0F            AND $0F                               ; low nibble
1462  67C0 4F               LD C, A
1463  67C1 78               LD A, B
1464  67C2 E6 F0            AND $F0
1465  67C4 CB 3F            SRL A
1465  67C6 CB 3F          SRL A
1465  67C8 CB 3F          SRL A
1465  67CA CB 3F          SRL A         ; high nibble (0..5)
1466  67CC 47               LD B, A
1467  67CD                  ; A = high*10 + low
1468  67CD 87               ADD A, A
1468  67CE 87             ADD A, A
1468  67CF 80             ADD A, B        ; *5
1469  67D0 87               ADD A, A                              ; *10
1470  67D1 81               ADD A, C                              ; +low
1471  67D2 C9               RET
1472  67D3
1473  67D3              ; ================================================================
1474  67D3              ; RANDOM CHAIN COLOR — LFSR без RTC. На ПЕРВОМ вызове seed scrambled
1475  67D3              ; через умножение low_byte(seed) на RTC секунды → разные стартовые
1476  67D3              ; последовательности per launch. Subsequent calls — чистый LFSR.
1477  67D3              ; Возвращает A в 0..5.
1478  67D3              ; ================================================================
1479  67D3              RandomChainColor:
1480  67D3 3A 96 89         LD A, (ChainColorFirst)
1481  67D6 B7               OR A
1482  67D7 28 29            JR Z, .rcc_normal
1483  67D9                  ; Первый вызов: scramble seed RTC секундами
1484  67D9 AF               XOR A
1485  67DA 32 96 89         LD (ChainColorFirst), A
1486  67DD CD B2 67         CALL ReadRTCSeconds
1487  67E0 B7               OR A
1488  67E1 20 02            JR NZ, .rcc_have_sec
1489  67E3 3E 01            LD A, 1                               ; защита от *0
1490  67E5              .rcc_have_sec:
1491  67E5 2A 94 89         LD HL, (ChainColorSeed)
1492  67E8 57               LD D, A                               ; D = RTC sec
1493  67E9 5F               LD E, A                               ; multiplier as DE
1494  67EA 7D               LD A, L                               ; A = low seed byte
1495  67EB 21 00 00         LD HL, 0
1496  67EE 06 08            LD B, 8
1497  67F0              .rcc_mul_seed:
1498  67F0 29               ADD HL, HL
1499  67F1 CB 27            SLA A
1500  67F3 30 01            JR NC, .rcc_no_add
1501  67F5 19               ADD HL, DE
1502  67F6              .rcc_no_add:
1503  67F6 10 F8            DJNZ .rcc_mul_seed
1504  67F8                  ; HL = low_seed * RTC_sec. Гарантируем не-ноль.
1505  67F8 7C               LD A, H
1505  67F9 B5             OR L
1506  67FA 20 03            JR NZ, .rcc_seed_ok
1507  67FC 21 34 12         LD HL, $1234
1508  67FF              .rcc_seed_ok:
1509  67FF 22 94 89         LD (ChainColorSeed), HL
1510  6802              .rcc_normal:
1511  6802 2A 94 89         LD HL, (ChainColorSeed)
1512  6805 CD A4 67         CALL LFSR16
1513  6808 22 94 89         LD (ChainColorSeed), HL
1514  680B                  ; mod LevelNumColors: 8x8 multiply A * E → HL, high byte = result.
1515  680B 7D               LD A, L                               ; A = random low byte
1516  680C 21 90 89         LD HL, LevelNumColors
1517  680F 5E               LD E, (HL)
1518  6810 16 00            LD D, 0
1519  6812 21 00 00         LD HL, 0
1520  6815 06 08            LD B, 8
1521  6817              .rcc_mul_n:
1522  6817 29               ADD HL, HL
1523  6818 CB 27            SLA A
1524  681A 30 01            JR NC, .rcc_mul_skip
1525  681C 19               ADD HL, DE
1526  681D              .rcc_mul_skip:
1527  681D 10 F8            DJNZ .rcc_mul_n
1528  681F 7C               LD A, H
1529  6820 C9               RET
1530  6821
1531  6821              ; ================================================================
1532  6821              ; COLOR BIT — для color N в 0..7 возвращает (1 << N).
1533  6821              ; Через таблицу, чтобы не клобберить BC. Clobbers HL/DE/A только.
1534  6821              ; ================================================================
1535  6821 01 02 04 08  ColorBitTable: DB 1, 2, 4, 8, 16, 32, 64, 128
1535  6825 10 20 40 80
1536  6829              ColorBit:
1537  6829 21 21 68         LD HL, ColorBitTable
1538  682C 16 00            LD D, 0
1539  682E 5F               LD E, A
1540  682F 19               ADD HL, DE
1541  6830 7E               LD A, (HL)
1542  6831 C9               RET
1543  6832
1544  6832              ; ================================================================
1545  6832              ; BUILD COLOR MASK — 6-бит маска цветов, присутствующих в цепочке.
1546  6832              ; Bit N = 1 если цвет N встречается в ChainColors[0..ChainLen-1].
1547  6832              ; Out: A = mask. Preserves BC, DE, HL.
1548  6832              ; ================================================================
1549  6832              BuildColorMask:
1550  6832 C5               PUSH BC
1551  6833 D5               PUSH DE
1552  6834 E5               PUSH HL
1553  6835 AF               XOR A
1554  6836 32 A8 89         LD (TmpColorMask), A
1555  6839 3A 27 8F         LD A, (Chain0_SlotsLen)
1556  683C B7               OR A
1557  683D 28 18            JR Z, .bcm_done
1558  683F 47               LD B, A
1559  6840 21 75 8A         LD HL, Chain0_Slots
1560  6843              .bcm_loop:
1561  6843 7E               LD A, (HL)
1562  6844 FE 06            CP 6
1563  6846 30 0C            JR NC, .bcm_skip                       ; цвет >=6 (включая GAP_STOP=#FE / GAP_CASCADE=#FD) → пропустить
1564  6848 C5               PUSH BC
1565  6849 E5               PUSH HL
1566  684A CD 29 68         CALL ColorBit
1567  684D 21 A8 89         LD HL, TmpColorMask
1568  6850 B6               OR (HL)
1569  6851 77               LD (HL), A
1570  6852 E1               POP HL
1571  6853 C1               POP BC
1572  6854              .bcm_skip:
1573  6854 23               INC HL
1574  6855 10 EC            DJNZ .bcm_loop
1575  6857              .bcm_done:
1576  6857 3A A8 89         LD A, (TmpColorMask)
1577  685A E1               POP HL
1578  685B D1               POP DE
1579  685C C1               POP BC
1580  685D C9               RET
1581  685E
1582  685E              ; ================================================================
1583  685E              ; RANDOM BALL COLOR — LFSR умноженный на RTC секунды + XOR FrogAngle,
1584  685E              ; mod 6. После — фильтр через BuildColorMask: если выпавший цвет
1585  685E              ; отсутствует в цепочке, циклически перебираем mod 6 до попадания.
1586  685E              ; Возвращает A в 0..5.
1587  685E              ; ================================================================
1588  685E              RandomBallColor:
1589  685E                  ; Подмешиваем FrogAngle в seed (XOR в low byte) — каждое нажатие игрока
1590  685E                  ; задаёт уникальный угол → дополнительный источник энтропии.
1591  685E 2A 92 89         LD HL, (BallColorSeed)
1592  6861 3A 8F 89         LD A, (FrogAngle)
1593  6864 AD               XOR L
1594  6865 6F               LD L, A
1595  6866 CD A4 67         CALL LFSR16
1596  6869 22 92 89         LD (BallColorSeed), HL
1597  686C 7D               LD A, L
1598  686D 57               LD D, A                               ; D = LFSR low byte
1599  686E
1600  686E CD B2 67         CALL ReadRTCSeconds
1601  6871 B7               OR A
1602  6872 20 02            JR NZ, .rbc_have_sec
1603  6874 3E 01            LD A, 1                               ; защита от *0
1604  6876              .rbc_have_sec:
1605  6876 5F               LD E, A                               ; E = seconds (1..59)
1606  6877
1607  6877                  ; HL = D * E (8x8 → 16). Старший байт игнорим, низкий идёт в mod 6.
1608  6877 7A               LD A, D
1609  6878 21 00 00         LD HL, 0
1610  687B 06 08            LD B, 8
1611  687D              .rbc_mul:
1612  687D 29               ADD HL, HL
1613  687E CB 27            SLA A
1614  6880 30 01            JR NC, .rbc_no_add
1615  6882 19               ADD HL, DE
1616  6883              .rbc_no_add:
1617  6883 10 F8            DJNZ .rbc_mul
1618  6885
1619  6885                  ; mod LevelNumColors: high(L * LevelNumColors). 8x8 multiply, A * E → HL.
1620  6885 7D               LD A, L                               ; A = random low byte
1621  6886 21 90 89         LD HL, LevelNumColors
1622  6889 5E               LD E, (HL)
1623  688A 16 00            LD D, 0
1624  688C 21 00 00         LD HL, 0
1625  688F 06 08            LD B, 8
1626  6891              .rbc_mul_n:
1627  6891 29               ADD HL, HL
1628  6892 CB 27            SLA A
1629  6894 30 01            JR NC, .rbc_mul_skip
1630  6896 19               ADD HL, DE
1631  6897              .rbc_mul_skip:
1632  6897 10 F8            DJNZ .rbc_mul_n
1633  6899 7C               LD A, H                               ; A = candidate 0..LevelNumColors-1
1634  689A
1635  689A                  ; --- фильтр по цветам цепочки ---
1636  689A 47               LD B, A                               ; B = candidate
1637  689B CD 32 68         CALL BuildColorMask                   ; A = mask, BC сохранён
1638  689E B7               OR A
1639  689F 28 18            JR Z, .rbc_done                       ; цепочка пуста → возврат как есть
1640  68A1 4F               LD C, A                               ; C = mask
1641  68A2 3A 90 89         LD A, (LevelNumColors)
1642  68A5 57               LD D, A                               ; max попыток = LevelNumColors
1643  68A6              .rbc_filter:
1644  68A6 78               LD A, B
1645  68A7 CD 29 68         CALL ColorBit
1646  68AA A1               AND C
1647  68AB 20 0C            JR NZ, .rbc_done                      ; bit B set → цвет валиден
1648  68AD 04               INC B
1649  68AE 3A 90 89         LD A, (LevelNumColors)
1650  68B1 B8               CP B
1651  68B2 20 02            JR NZ, .rbc_no_wrap
1652  68B4 06 00            LD B, 0
1653  68B6              .rbc_no_wrap:
1654  68B6 15               DEC D
1655  68B7 20 ED            JR NZ, .rbc_filter
1656  68B9              .rbc_done:
1657  68B9 78               LD A, B
1658  68BA C9               RET
