1660  68BB              ; ================================================================
1661  68BB              ; INSERT CHAIN BALL — вставка нового шара в Slots[TmpInsertIdx] с цветом
1662  68BB              ; TmpInsertColor. shift_right(Slots[idx..len-1]); Slots[idx]=color;
1663  68BB              ; SlotOffsets[idx]=0; SlotsLen += 1; HSA += 1 (head-half шары визуально сдвигаются
1664  68BB              ; на +CELL_SIZE вперёд по треку).
1665  68BB              ; BUG: при SlotsLen >= MAX_SLOTS_PER_CHAIN drop'ает tail (DEC SlotsLen),
1666  68BB              ;      это видно user'у как «ролл-бэк хвоста на 1 шарик» при выстрелах в полную
1667  68BB              ;      цепочку. См. project_zuma_full_chain_drop_tail_bug.
1668  68BB              ; ================================================================
1669  68BB              InsertChainBall:
1670  68BB                  ; VDC head-forward модель (Python-эквивалент):
1671  68BB                  ; 1. Compute new_offset = midpoint между head_neighbor и tail_neighbor.
1672  68BB                  ; 2. Shift Slots/SlotOffsets/Shot2 [idx..end] вправо на 1.
1673  68BB                  ; 3. Set Slots[idx]=color, SlotOffsets[idx]=new_offset, Shot2[idx]=1.
1674  68BB                  ; 4. SlotsLen += 1.
1675  68BB                  ; 5. HSA += 1 (с cap по track-end).
1676  68BB                  ; 6. SlotOffsets[0..idx-1] -= CELL_SIZE с cap'ом -CELL_SIZE (head компенсация).
1677  68BB                  ; 7. ChainFreezeCounter = CELL_SIZE.
1678  68BB
1679  68BB 3A 27 8F         LD A, (Chain0_SlotsLen)
1680  68BE FE F0            CP MAX_SLOTS_PER_CHAIN
1681  68C0 38 04            JR C, .icb_not_full
1682  68C2 3D               DEC A                                ; drop tail
1683  68C3 32 27 8F         LD (Chain0_SlotsLen), A
1684  68C6              .icb_not_full:
1685  68C6
1686  68C6                  ; --- Compute new_offset = -CELL_SIZE/2 + (head_off + tail_off) / 2 (signed) ---
1687  68C6                  ; head_off: SlotOffsets[idx-1] если idx>0, иначе SlotOffsets[idx].
1688  68C6                  ; tail_off: SlotOffsets[idx] если idx<SlotsLen, иначе SlotOffsets[idx-1].
1689  68C6 3A CA 89         LD A, (TmpInsertIdx)
1690  68C9 B7               OR A
1691  68CA 28 0B            JR Z, .icb_head_off_zero
1692  68CC 3D               DEC A
1693  68CD 26 00            LD H, 0
1693  68CF 6F             LD L, A
1694  68D0 11 65 8B         LD DE, Chain0_SlotOffsets
1695  68D3 19               ADD HL, DE
1696  68D4 7E               LD A, (HL)                            ; A = SlotOffsets[idx-1]
1697  68D5 18 17            JR .icb_head_off_done
1698  68D7              .icb_head_off_zero:
1699  68D7 3A CA 89         LD A, (TmpInsertIdx)
1700  68DA 21 27 8F         LD HL, Chain0_SlotsLen
1701  68DD BE               CP (HL)
1702  68DE 30 0D            JR NC, .icb_head_off_zero_set         ; idx == SlotsLen → empty chain
1703  68E0 3A CA 89         LD A, (TmpInsertIdx)
1704  68E3 26 00            LD H, 0
1704  68E5 6F             LD L, A
1705  68E6 11 65 8B         LD DE, Chain0_SlotOffsets
1706  68E9 19               ADD HL, DE
1707  68EA 7E               LD A, (HL)
1708  68EB 18 01            JR .icb_head_off_done
1709  68ED              .icb_head_off_zero_set:
1710  68ED AF               XOR A
1711  68EE              .icb_head_off_done:
1712  68EE 47               LD B, A                               ; B = head_off (signed)
1713  68EF
1714  68EF                  ; tail_off
1715  68EF 3A CA 89         LD A, (TmpInsertIdx)
1716  68F2 21 27 8F         LD HL, Chain0_SlotsLen
1717  68F5 BE               CP (HL)
1718  68F6 30 0D            JR NC, .icb_tail_off_use_idxm1        ; idx >= SlotsLen
1719  68F8 3A CA 89         LD A, (TmpInsertIdx)
1720  68FB 26 00            LD H, 0
1720  68FD 6F             LD L, A
1721  68FE 11 65 8B         LD DE, Chain0_SlotOffsets
1722  6901 19               ADD HL, DE
1723  6902 7E               LD A, (HL)                            ; tail_off = SlotOffsets[idx]
1724  6903 18 12            JR .icb_tail_off_done
1725  6905              .icb_tail_off_use_idxm1:
1726  6905 3A CA 89         LD A, (TmpInsertIdx)
1727  6908 B7               OR A
1728  6909 28 0B            JR Z, .icb_tail_off_zero
1729  690B 3D               DEC A
1730  690C 26 00            LD H, 0
1730  690E 6F             LD L, A
1731  690F 11 65 8B         LD DE, Chain0_SlotOffsets
1732  6912 19               ADD HL, DE
1733  6913 7E               LD A, (HL)
1734  6914 18 01            JR .icb_tail_off_done
1735  6916              .icb_tail_off_zero:
1736  6916 AF               XOR A
1737  6917              .icb_tail_off_done:
1738  6917                  ; (head_off + tail_off) / 2 — signed avg, sign-extend before add.
1739  6917                  ; A = tail_off, B = head_off. Compute (B+A)/2 with arithmetic shift.
1740  6917 4F               LD C, A                               ; C = tail_off
1741  6918 78               LD A, B                               ; A = head_off
1742  6919 26 00            LD H, 0
1743  691B CB 7F            BIT 7, A
1744  691D 28 01            JR Z, .icb_avg_h_pos
1745  691F 25               DEC H                                 ; H = $FF (sign extend)
1746  6920              .icb_avg_h_pos:
1747  6920 6F               LD L, A                               ; HL = head_off (signed 16)
1748  6921 79               LD A, C
1749  6922 16 00            LD D, 0
1750  6924 CB 7F            BIT 7, A
1751  6926 28 01            JR Z, .icb_avg_d_pos
1752  6928 15               DEC D                                 ; D = $FF
1753  6929              .icb_avg_d_pos:
1754  6929 5F               LD E, A                               ; DE = tail_off (signed 16)
1755  692A 19               ADD HL, DE                            ; HL = head_off + tail_off
1756  692B CB 2C            SRA H
1756  692D CB 1D          RR L                          ; HL >>= 1 (arithmetic, signed)
1757  692F                  ; new_offset = -CELL_SIZE/2 + HL.low. HL уже -16..16 для нормальных offsets.
1758  692F 7D               LD A, L
1759  6930 D6 10            SUB CELL_SIZE / 2                     ; A -= 16
1760  6932 32 D7 89         LD (TmpNewOffset), A                  ; временно сохраним
1761  6935
1762  6935                  ; --- Shift Slots/Offsets/Shot2 [idx..end] right by 1 ---
1763  6935 3A 27 8F         LD A, (Chain0_SlotsLen)
1764  6938 21 CA 89         LD HL, TmpInsertIdx
1765  693B 96               SUB (HL)
1766  693C 28 37            JR Z, .icb_no_shift
1767  693E 4F               LD C, A
1767  693F 06 00          LD B, 0
1768  6941 C5               PUSH BC
1769  6942
1770  6942                  ; shift_right Slots[idx..end]
1771  6942 3A 27 8F         LD A, (Chain0_SlotsLen)
1772  6945 3D               DEC A
1773  6946 26 00            LD H, 0
1773  6948 6F             LD L, A
1774  6949 11 75 8A         LD DE, Chain0_Slots
1775  694C 19               ADD HL, DE                            ; HL = &Slots[SlotsLen-1]
1776  694D 54               LD D, H
1776  694E 5D             LD E, L
1777  694F 13               INC DE
1778  6950 ED B8            LDDR
1779  6952
1780  6952                  ; shift_right SlotOffsets
1781  6952 C1               POP BC
1781  6953 C5             PUSH BC
1782  6954 3A 27 8F         LD A, (Chain0_SlotsLen)
1783  6957 3D               DEC A
1784  6958 26 00            LD H, 0
1784  695A 6F             LD L, A
1785  695B 11 65 8B         LD DE, Chain0_SlotOffsets
1786  695E 19               ADD HL, DE
1787  695F 54               LD D, H
1787  6960 5D             LD E, L
1788  6961 13               INC DE
1789  6962 ED B8            LDDR
1790  6964
1791  6964                  ; shift_right Shot2 (был баг — раньше не сдвигался)
1792  6964 C1               POP BC
1793  6965 3A 27 8F         LD A, (Chain0_SlotsLen)
1794  6968 3D               DEC A
1795  6969 26 00            LD H, 0
1795  696B 6F             LD L, A
1796  696C 11 55 8C         LD DE, Chain0_Shot2
1797  696F 19               ADD HL, DE
1798  6970 54               LD D, H
1798  6971 5D             LD E, L
1799  6972 13               INC DE
1800  6973 ED B8            LDDR
1801  6975
1802  6975              .icb_no_shift:
1803  6975                  ; Slots[idx] = color, SlotOffsets[idx] = new_offset, Shot2[idx] = 1
1804  6975 3A CA 89         LD A, (TmpInsertIdx)
1805  6978 26 00            LD H, 0
1805  697A 6F             LD L, A
1806  697B 11 75 8A         LD DE, Chain0_Slots
1807  697E 19               ADD HL, DE
1808  697F 3A D8 89         LD A, (TmpInsertColor)
1809  6982 77               LD (HL), A
1810  6983
1811  6983 3A CA 89         LD A, (TmpInsertIdx)
1812  6986 26 00            LD H, 0
1812  6988 6F             LD L, A
1813  6989 11 65 8B         LD DE, Chain0_SlotOffsets
1814  698C 19               ADD HL, DE
1815  698D 3A D7 89         LD A, (TmpNewOffset)
1816  6990 77               LD (HL), A
1817  6991
1818  6991 3A CA 89         LD A, (TmpInsertIdx)
1819  6994 26 00            LD H, 0
1819  6996 6F             LD L, A
1820  6997 11 55 8C         LD DE, Chain0_Shot2
1821  699A 19               ADD HL, DE
1822  699B 36 01            LD (HL), 1
1823  699D
1824  699D                  ; SlotsLen += 1
1825  699D 3A 27 8F         LD A, (Chain0_SlotsLen)
1826  69A0 3C               INC A
1827  69A1 32 27 8F         LD (Chain0_SlotsLen), A
1828  69A4
1829  69A4                  ; HSA += 1 с cap по track-end (chain продвинулся на 1 cell к killzone)
1830  69A4 3A 25 8F         LD A, (Chain0_HeadSlotAbs)
1831  69A7 FE 5F            CP TRACK_NUM_SLOTS - 1
1832  69A9 30 04            JR NC, .icb_no_hsa_inc
1833  69AB 3C               INC A
1834  69AC 32 25 8F         LD (Chain0_HeadSlotAbs), A
1835  69AF              .icb_no_hsa_inc:
1836  69AF
1837  69AF                  ; Head компенсация: SlotOffsets[0..idx-1] = max(off - CELL_SIZE, -CELL_SIZE).
1838  69AF                  ; Equivalent: if A_orig >= 0 → A_orig - CELL_SIZE; else → -CELL_SIZE.
1839  69AF 3A CA 89         LD A, (TmpInsertIdx)
1840  69B2 B7               OR A
1841  69B3 28 13            JR Z, .icb_no_head_comp
1842  69B5 47               LD B, A
1843  69B6 21 65 8B         LD HL, Chain0_SlotOffsets
1844  69B9              .icb_head_comp_loop:
1845  69B9 7E               LD A, (HL)
1846  69BA B7               OR A
1847  69BB FA C2 69         JP M, .icb_head_comp_cap               ; A_orig < 0 → cap to -CELL_SIZE
1848  69BE D6 20            SUB CELL_SIZE                          ; A_orig >= 0 → subtract CELL_SIZE
1849  69C0 18 02            JR .icb_head_comp_store
1850  69C2              .icb_head_comp_cap:
1851  69C2 3E E0            LD A, -CELL_SIZE                       ; cap at -32 = $E0
1852  69C4              .icb_head_comp_store:
1853  69C4 77               LD (HL), A
1854  69C5 23               INC HL
1855  69C6 10 F1            DJNZ .icb_head_comp_loop
1856  69C8              .icb_no_head_comp:
1857  69C8
1858  69C8                  ; ChainFreezeCounter = CELL_SIZE — chain пауза на 32 кадра пока head декаит.
1859  69C8 3E 20            LD A, CELL_SIZE
1860  69CA 32 9E 89         LD (ChainFreezeCounter), A
1861  69CD C9               RET
1862  69CE
1863  69CE              ; ================================================================
1864  69CE              ; CHECK MATCH-3 — после InsertChainBall ищет run одного цвета через точку
1865  69CE              ; вставки TmpInsertIdx. Если count >= 3 → удалить run, **симметричный pull**:
1866  69CE              ;   HeadT -= 10*count (= halfShift),
1867  69CE              ;   head-half (idx 0..L-1): offset += halfShift  → шары сдвигаются назад,
1868  69CE              ;   tail-half (new idx L..): offset = old_tail_offset - halfShift → подтягиваются вперёд.
1869  69CE              ; Обе половинки покрывают одинаковое расстояние 10*count за одно и то же время.
1870  69CE              ; Шаг между шарами на треке = 30, halfShift=10 даёт небольшой остаточный зазор,
1871  69CE              ; который доезжает естественным MoveChain (визуально незаметно).
1872  69CE              ; Без cascading combo (TODO).
1873  69CE              ; Saturation: clamp count в 12 (halfShift в 120) → fits signed byte после ADD/SUB.
1874  69CE              ; ================================================================
1875  69CE              ; ================================================================
1876  69CE              ; DETECT MATCH-3 ON SLOTS — window scan по Chain0_Slots[] вокруг TmpInsertIdx.
1877  69CE              ; Идёт влево/вправо пока цвет совпадает И нет физического gap'а с соседом
1878  69CE              ; (= Chain0_SlotOffsets[i-1] - Chain0_SlotOffsets[i] < 16, иначе разница >= 48 px).
1879  69CE              ;
1880  69CE              ; После полного перехода на slot-array delete (= set GAP_MARKER в Slots), gap
1881  69CE              ; будет встроен в массив через GAP-cells, и offset-based gap check можно убрать
1882  69CE              ; (TODO: scan просто остановится на GAP).
1883  69CE              ;
1884  69CE              ; Inputs: TmpInsertIdx, Chain0_Slots, Chain0_SlotOffsets, Chain0_SlotsLen.
1885  69CE              ; Outputs: A=1 + TmpMatchLeft/Right/Count если run >= 3, иначе A=0.
1886  69CE              ; ================================================================
1887  69CE              DetectMatch3OnSlots:
1888  69CE 3A 27 8F         LD A, (Chain0_SlotsLen)
1889  69D1 B7               OR A
1890  69D2 CA 88 6A         JP Z, .dm3_no
1891  69D5 3A CA 89         LD A, (TmpInsertIdx)
1892  69D8 21 27 8F         LD HL, Chain0_SlotsLen
1893  69DB BE               CP (HL)
1894  69DC D2 88 6A         JP NC, .dm3_no                          ; idx >= len
1895  69DF
1896  69DF                  ; color = Slots[idx] (= цвет вставленного шара)
1897  69DF 26 00            LD H, 0
1897  69E1 6F             LD L, A
1898  69E2 11 75 8A         LD DE, Chain0_Slots
1899  69E5 19               ADD HL, DE
1900  69E6 7E               LD A, (HL)
1901  69E7 FE 06            CP NUM_BALL_COLORS
1902  69E9 D2 88 6A         JP NC, .dm3_no                          ; >= NUM_BALL_COLORS = GAP-маркер → не валидный центр
1903  69EC 32 DD 89         LD (TmpMatchColor), A
1904  69EF                  ; Если slot уже exploding — не центр для нового match'а.
1905  69EF 3A CA 89         LD A, (TmpInsertIdx)
1906  69F2 26 00            LD H, 0
1906  69F4 6F             LD L, A
1907  69F5 11 45 8D         LD DE, Chain0_ExplodingFrame
1908  69F8 19               ADD HL, DE
1909  69F9 7E               LD A, (HL)
1910  69FA B7               OR A
1911  69FB C2 88 6A         JP NZ, .dm3_no
1912  69FE
1913  69FE                  ; --- Left scan: B = текущий index, спускаемся к 0 ---
1914  69FE                  ; Условия продолжения: Slots[B-1] == color И |offset[B-1] - offset[B]| < DM3_OFFSET_GAP_MAX
1915  69FE                  ; (= шары визуально коснулись).
