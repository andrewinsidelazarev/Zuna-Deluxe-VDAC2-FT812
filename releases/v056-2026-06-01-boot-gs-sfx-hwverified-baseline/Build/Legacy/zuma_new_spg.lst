 104  0000              ; Раскладка SFILE (85 descriptors × 6 байт = 510 байт #0200..#03FD).
 105  0000              ; TSU рендерит descriptors в порядке SFILE, ПОЗДНИЕ поверх ранних (z-order).
 106  0000              ; ACT=0 СТОПИТ рендеринг → следующий descriptor не нарисуется. Поэтому:
 107  0000              ;  • frog/preview всегда активны;
 108  0000              ;  • chain рисуется через DMA в canvas, TSU-слоты DESC_CHAIN0[60] просто
 109  0000              ;    держатся off-screen (Y=#2C + ACT=1) чтобы TSU дошёл до курсора;
 110  0000              ;  • для летящих шаров неактивные слоты тоже ACT=1 + offscreen.
 111  0000              ;   #0200 — лягушка (64×64)
 112  0000              ;   #0206 — mouth-preview (24×24)
 113  0000              ;   #020C — back-preview (8×8)
 114  0000              ;   #0212..#0379 — 60 chain-слотов (360 байт, off-screen для DMA-чейна)
 115  0000              ;   #037A..#03D9 — 16 летящих шаров (96 байт)
 116  0000              ;   #03DA — курсор (16×16)
 117  0000              ;   #03E0..#03FD — пусто
 118  0000              DESC_FROG         EQU #0200    ; 64×64 жаба
 119  0000              DESC_PREVIEW      EQU #0206    ; 24×24 mouth ball — текущий цвет, во рту
 120  0000              DESC_BACK_PREVIEW EQU #020C    ; 8×8 spine preview — следующий цвет, на спине
 121  0000              DESC_CHAIN0       EQU #0212    ; 60 chain-слотов (360 байт) → off-screen, реальный chain в canvas
 122  0000              DESC_BALL0        EQU #037A    ; 16 летящих шаров (96 байт)
 123  0000              DESC_CURSOR       EQU #03DA    ; 16×16 курсор
 124  0000
 125  0000              SCR_W    EQU 360
 126  0000              SCR_H    EQU 288
 127  0000              SPR_SIZE EQU 64                                  ; frog 64×64
 128  0000
 129  0000              MIN_X EQU 0
 130  0000              MAX_X EQU 296                                    ; SCR_W - SPR_SIZE
 131  0000              MIN_Y EQU 0
 132  0000              MAX_Y EQU 224                                    ; SCR_H - SPR_SIZE
 133  0000
 134  0000              ; tiltspiral 5:4 (без letterbox) — smart crop tx[26..613], ty[0..470]
 135  0000              ; gx=242 gy=248 → screen (132, 152) → top-left (100, 120)
 136  0000              FROG_INIT_X EQU 100
 137  0000              FROG_INIT_Y EQU 120
 138  0000
 139  0000              MOUSE_INIT_X EQU FROG_INIT_X + 72                ; 220 — справа от жабы → стартовый угол ~0
 140  0000              MOUSE_INIT_Y EQU FROG_INIT_Y + 32                ; 144 — центр жабы по Y (SPR_SIZE/2)
 141  0000
 142  0000              ; Cursor 16x16 in 360x288 screen — top-left limits
 143  0000              CURSOR_MIN_X EQU 0
 144  0000              CURSOR_MIN_Y EQU 0
 145  0000              CURSOR_MAX_X EQU SCR_W - 16                     ; 344
 146  0000              CURSOR_MAX_Y EQU SCR_H - 16                     ; 272
 147  0000
 148  0000              MAX_BALLS     EQU 16            ; летящих шаров (cooldown 20 frames между выстрелами хватает)
 149  0000              MAX_CHAIN_BALLS EQU 240         ; VDC chain physics limit. HD оригинал: 256. У нас 240 чтобы
 150  0000                                              ; TrackData (12386 байт) поместился в slot 2 (16K) без spillover.
 151  0000                                              ; Если перенести TrackData на свою page — можно поднять до 255.
 152  0000              TSU_CHAIN_SPRITES EQU 60        ; зарезервированных SFILE-дескрипторов для off-screen TSU-цепочки.
 153  0000                                              ; Физический chain рисуется через DMA в canvas; TSU-слоты лишь
 154  0000                                              ; держатся ACT=1+offscreen, чтобы TSU дошёл до courseur. Поэтому
 155  0000                                              ; SFILE-сторона не масштабируется с MAX_CHAIN_BALLS.
 156  0000
 157  0000              ; Параметры уровня (level1 / lvl11 в оригинальной Zuma):
 158  0000              LEVEL_START_BALLS  EQU 35       ; быстрая фаза: 35 шаров вылезают «поездом»
 159  0000              LEVEL_REPEAT_BALLS EQU 50       ; нормальная фаза: ещё 50 шаров обычной скоростью
 160  0000              LEVEL_TOTAL_BALLS  EQU LEVEL_START_BALLS + LEVEL_REPEAT_BALLS  ; 85 — после спавн прекращается
 161  0000              FAST_ADVANCE       EQU 12       ; кол-во MoveChain'ов за кадр в fast-фазе (norm = 1 за 2 кадра)
 162  0000              ; --- Размер шара и cell-spacing (см. также make_dma_balls.py: BALL_PIX) ---
 163  0000              BALL_DIAMETER      EQU 20       ; диаметр DMA-копии (= 10 words x 20 lines). Visible круг = 18-19 px (radius 9.5 в png-маске).
 164  0000              CELL_SIZE          EQU 32       ; шаг между cell-позициями (в семплах трека).
 165  0000                                              ; cell-step px = TrackLen / TRACK_NUM_SLOTS ~= 1986/96 ~= 20.7.
 166  0000                                              ; Уменьшить до 18..24 если хотим плотнее.
 167  0000              CHAIN_SPACING      EQU CELL_SIZE  ; legacy alias
 168  0000
 169  0000              ; ----- VDC (Virtual Discrete Chain) — текущая модель цепочки
 170  0000              ;
 171  0000              ; Каждый физический трек уровня имеет свой ChainStateBlock. Сейчас один (Chain0).
 172  0000              ; В оригинальной Zuma бывают уровни с двумя tracks → потребуется Chain1_*.
 173  0000              ; Slot k (целое 0..SlotsLen-1) — ячейка вдоль трека на t-позиции k*CELL_SIZE.
 174  0000              ; Координаты берутся из TrackData[t] напрямую — отдельный CellTable не нужен.
 175  0000              ;
 176  0000              ; Chain0_Slots[k] хранит цвет (0..NUM_BALL_COLORS-1) либо GAP-маркер (>= NUM_BALL_COLORS).
 177  0000              ; Chain0_SlotOffsets[k] — signed sub-cell delta (-128..+127) для smooth animation
 178  0000              ;   при match/insert/cascade compactify; общее движение — discrete по cell-grid.
 179  0000              ; Chain0_HeadSlotAbs — абсолютный track-slot для Chain0_Slots[0] (head).
 180  0000              ; Chain0_HeadSub — sub-cell (0..CELL_SIZE-1) для непрерывного движения head'а.
 181  0000              ; Chain0_SlotsLen — длина active range (head..tail включительно).
 182  0000              ;
 183  0000              ; t-позиция шара в slot k:
 184  0000              ;   t = (Chain0_HeadSlotAbs - k) * CELL_SIZE + Chain0_HeadSub + Chain0_SlotOffsets[k]
 185  0000              ;
 186  0000              ; Match-3 detect: window-3 scan по Chain0_Slots[]. s[k]==s[k+1]==s[k+2] && s[k] color → match.
 187  0000              ; Match-3 apply: Slots[lb..rb] := GAP_STOP, ChainStalled=1, GapStep начинает закрывать.
 188  0000              ; --- VDC GAP-маркеры (виртуальные цвета). Любой Slots[k] >= NUM_BALL_COLORS = GAP. ---
 189  0000              GAP_STOP            EQU #FE   ; после stop-mode match. Двигается вправо (к tail в массиве).
 190  0000              GAP_CASCADE         EQU #FD   ; после cascade-mode match. Двигается влево (к head).
 191  0000              GAP_MARKER          EQU GAP_STOP    ; legacy alias (init/render/scan не различают)
 192  0000              MAX_SLOTS_PER_CHAIN EQU MAX_CHAIN_BALLS  ; 60: совместимо с ChainPrev*[] arrays
 193  0000              NUM_BALL_COLORS     EQU 6                ; max доступных цветов (compile-time, для array sizes / GAP detect).
 194  0000                                                      ; Реальное число цветов на уровне берётся из LevelNumColors (runtime).
 195  0000              GAP_STEP_FRAMES     EQU CELL_SIZE        ; кадров на 1 cell-step (= 32 frames per cell @ 1 px/frame decay)
 196  0000              EXPLOSION_FRAMES    EQU 14               ; длительность explosion-анимации до перехода в GAP_STOP
 197  0000              EXPLOSION_HIDE_AT   EQU 6                ; с какого кадра скрывать шар (frames 1..5 видны, 6..14 скрыты)
 198  0000              DM3_OFFSET_GAP_MAX  EQU 8                ; макс. |offset diff| между соседями run'а в DetectMatch3
 199  0000                                                        ; (= визуальная зазора, при котором ещё считаем что шары
 200  0000                                                        ; «коснулись». При большем — match НЕ считается, ждём
 201  0000                                                        ; пока offset decay сведёт зазор. Полу-ball width = 9 px.)
 202  0000
 203  0000              ; BlitChainToShadow per-slot classification (заполняется в BcsPreClassify, читается PASS1/PASS2).
 204  0000              ; PRESERVE значит «оставить шар в shadow как есть» — фикс хвоста при cascade roll-back.
 205  0000              BCS_DRAW            EQU 0    ; нормальный blit (есть кэш геометрии)
 206  0000              BCS_DESTROY         EQU 1    ; шар удалён (i>=SlotsLen / GAP) → restore golden, prev → invalid
 207  0000              BCS_PRESERVE        EQU 2    ; off-track / off-canvas → shadow не трогаем, prev не invalid'им
 208  0000
 209  0000              ; Killzone (череп с лучами в конце трека) — DMA blit 64×64 на canvas.
 210  0000              ; 64x64 при stride 512 = 32K → разбит на 2 src pages: top rows 0..31, bot 32..63.
 211  0000              KILLZONE_DMA_PAGE_TOP EQU #46
 212  0000              KILLZONE_DMA_PAGE_BOT EQU #47
 213  0000              KZ_PIX             EQU 64
 214  0000              ROTATION_SPEED EQU 4
 215  0000
 216  0000              ; ================================================================
 217  0000              ; СТРУКТУРА ШАРА (8 байт) — летящий после выстрела
 218  0000              ; ================================================================
 219  0000              BALL_X      EQU 0
 220  0000              BALL_Y      EQU 2
 221  0000              BALL_ANGLE  EQU 4
 222  0000              BALL_SPEED  EQU 5
 223  0000              BALL_ACTIVE EQU 6
 224  0000              BALL_COLOR  EQU 7
 225  0000
 226  0000              ; ================================================================
 227  0000              ; ЦЕПОЧКА — VDC МОДЕЛЬ (Virtual Discrete Chain). См. полное описание выше.
 228  0000              ; Slots[k] = цвет либо GAP-маркер (>= NUM_BALL_COLORS).
 229  0000              ; t_i = (Chain0_HeadSlotAbs - i) * CELL_SIZE + Chain0_HeadSub + SlotOffsets[i]
 230  0000              ; SlotsLen — количество активных slots (head=0, tail=SlotsLen-1).
 231  0000              ; Insert: shift_right(Slots, idx) + Slots[idx]=color + SlotsLen += 1 + HSA += 1.
 232  0000              ; Spawn: Slots[SlotsLen] = color, SlotsLen += 1 (новый шар на хвостовой стороне).
 233  0000              ; Match-3: window-3 scan ставит GAP_STOP в lb..rb, GapStep сдвигает GAP'ы к концу
 234  0000              ; массива, при close SlotsLen уменьшается на 1.
 235  0000              ; ================================================================
 236  0000
 237  0000              ; ================================================================
 238  0000              ; КОД
