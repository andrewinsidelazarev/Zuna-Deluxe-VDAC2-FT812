 242  6000              Entry:
 243  6000 F3               DI
 244  6001 31 FF BF         LD SP, #BFFF
 245  6004
 246  6004                  ; ---------- ИНИЦИАЛИЗАЦИЯ ЖЕЛЕЗА ----------
 247  6004 01 AF 20         LD BC, SYSCONG
 247  6007 3E 06          LD A, %00000110
 247  6009 ED 79          OUT (C), A     ; 14 MHz + аппаратный кэш
 248  600B 01 AF 00         LD BC, VCONFIG
 248  600E 3E C2          LD A, %11000010
 248  6010 ED 79          OUT (C), A  ; 360x288, 256c, NOGFX=0 — canvas включён
 249  6012 01 AF 01         LD BC, VPAGE
 249  6015 3E 10          LD A, #10
 249  6017 ED 79          OUT (C), A  ; canvas-bitmap начинается с page 16
 250  6019
 251  6019                  ; Палитра (включая bg-canvas палитру в CRAM #0100..#01FF)
 252  6019                  ; DMA-шары используют TSU-палитру (#20..#7F) — отдельная загрузка не нужна
 253  6019 CD 4B 89         CALL InitPalette
 254  601C
 255  601C                  ; TSU — sprite-graphics в page 6/7 (уже разложены через INCBIN)
 256  601C 01 AF 19         LD BC, SGPAGE
 256  601F 3E 06          LD A, 6
 256  6021 ED 79          OUT (C), A
 257  6023 01 AF 06         LD BC, TSCONFIG
 257  6026 3E 80          LD A, %10000000
 257  6028 ED 79          OUT (C), A   ; TSU sprites вкл
 258  602A
 259  602A                  ; ---------- ИНИЦИАЛИЗАЦИЯ ИГРЫ ----------
 260  602A CD 0B 61         CALL InitGame
 261  602D
 262  602D                  ; ---------- IM 2 + frame IRQ для Fixed Timestep ----------
 263  602D                  ; ISR-handler в page 5 (наш код). I=#5E, peripheral data byte для frame IRQ
 264  602D                  ; (= INTRAME=#FF). Vector address = (#5E<<8)|#FF = #5EFF. Z80 читает word
 265  602D                  ; #5EFF/#5F00 → ISR address. Записываем эти 2 байта runtime, чтобы получить
 266  602D                  ; адрес IRQHandler в RAM (page 5 byte #1EFF/#1F00).
 267  602D 3E FF            LD A, LOW(IRQHandler)
 268  602F 32 FF 5E         LD (#5EFF), A
 269  6032 3E 60            LD A, HIGH(IRQHandler)
 270  6034 32 00 5F         LD (#5F00), A
 271  6037 3E 5E            LD A, #5E
 272  6039 ED 47            LD I, A
 273  603B ED 5E            IM 2
 274  603D 01 AF 2A         LD BC, INTMASK
 274  6040 3E 01          LD A, INTMSKF
 274  6042 ED 79          OUT (C), A    ; разрешить только frame IRQ
 275  6044 AF               XOR A
 275  6045 32 BD 89       LD (TickCount), A
 275  6048 32 BE 89       LD (ProcessedTicks), A
 276  604B FB               EI
 277  604C
 278  604C              ; ============================================================================
 279  604C              ; FIXED TIMESTEP MAIN LOOP
 280  604C              ; ISR инкрементирует TickCount каждый vblank (50 Hz). MainLoop "догоняет":
 281  604C              ; пока ProcessedTicks < TickCount → выполнить UpdateGame + INC ProcessedTicks.
 282  604C              ; Когда тики обработаны — RenderFrame (swap+sprites+DMA blit) и HALT (sleep).
 283  604C              ; Если кадр рендера затянулся (>20мс) — успело пройти 2+ IRQ → следующий цикл
 284  604C              ; выполнит UpdateGame дважды → game speed остаётся 50 Hz, рендер визуально 25.
 285  604C              ; Никаких race conditions: вся логика атомарна в MainLoop, ISR только тик.
 286  604C              ; ============================================================================
 287  604C              MainLoop:
 288  604C F3               DI
 289  604D 3A BD 89         LD A, (TickCount)
 290  6050 47               LD B, A
 291  6051 3A BE 89         LD A, (ProcessedTicks)
 292  6054 FB               EI
 293  6055 B8               CP B
 294  6056 28 09            JR Z, .ml_render
 295  6058 CD 67 60         CALL UpdateGame
 296  605B 21 BE 89         LD HL, ProcessedTicks
 297  605E 34               INC (HL)
 298  605F 18 EB            JR MainLoop
 299  6061              .ml_render:
 300  6061 CD BE 60         CALL RenderFrame
 301  6064 76               HALT                                      ; сон до следующего IRQ
 302  6065 18 E5            JR MainLoop
 303  6067
 304  6067              ; ============================================================================
 305  6067              ; UPDATE GAME — атомарный шаг логики (= 1 tick = 20 мс).
 306  6067              ; Mouse/input, motion, collisions, chain advance, spawn, cooldown.
 307  6067              ; НЕ trogает canvas / DMA / TSU спрайты — это в RenderFrame.
 308  6067              ; ============================================================================
 309  6067              UpdateGame:
 310  6067 CD 8D 88         CALL HandleMouse
 311  606A CD A2 62         CALL HandleInput
 312  606D CD AC 63         CALL UpdateBalls
 313  6070 CD B0 65         CALL CheckCollisions
 314  6073 CD C7 6B         CALL CheckBallChainCollisions
 315  6076
 316  6076 3A BC 89         LD A, (FrameCounter)
 317  6079 3C               INC A
 318  607A 32 BC 89         LD (FrameCounter), A
 319  607D
 320  607D 3A BF 89         LD A, (BallsSpawned)
 321  6080 FE 23            CP LEVEL_START_BALLS
 322  6082 38 20            JR C, .ug_fast
 323  6084
 324  6084 3A BC 89         LD A, (FrameCounter)
 325  6087 E6 01            AND 1
 326  6089 20 06            JR NZ, .ug_after_advance
 327  608B CD A3 70         CALL MoveChain
