2093  338D              ; ============================================================================
2094  338D              ; DrawTimeValue — нарисовать "M:SS" из VDC_GameSeconds (RTC-based).
2095  338D              ;   Раньше делили StatTimeFrames/60, но при 74Hz видеорежиме это давало
2096  338D              ;   неверное время. Теперь берём VDC_GameSeconds (уже в секундах).
2097  338D              ; ============================================================================
2098  338D              DrawTimeValue:
2099  338D                              ; HL = VDC_GameSeconds (total seconds, RTC-based, pause excluded).
2100  338D                              ; Divide by 60: HL → BC=minutes, remainder=seconds.
2101  338D 2A E3 6C                     LD   HL, (Core.VDC_GameSeconds)
2102  3390 11 3C 00                     LD   DE, 60
2103  3393 01 00 00                     LD   BC, 0
2104  3396 A7           .dt_div2:       AND  A
2105  3397 ED 52                        SBC  HL, DE
2106  3399 38 03                        JR   C, .dt_minutes_done
2107  339B 03                           INC  BC
2108  339C 18 F8                        JR   .dt_div2
2109  339E              .dt_minutes_done:
2110  339E 19                           ADD  HL, DE                             ; восстановить HL = remainder = seconds (0..59)
2111  339F                              ; BC = minutes, HL_low = seconds. Format "M:SS"
2112  339F 79                           LD   A, C
2113  33A0 C6 30                        ADD  A, '0'                             ; minute digit (0..9)
2114  33A2 32 D1 33                     LD   (DrawNumBuf), A
2115  33A5 3E 3A                        LD   A, ':'                             ; cancun8 имеет colon
2116  33A7 32 D2 33                     LD   (DrawNumBuf+1), A
2117  33AA 7D                           LD   A, L                               ; seconds 0..59
2118  33AB 06 2F                        LD   B, '0' - 1
2119  33AD 04           .dt_s10:        INC  B
2120  33AE D6 0A                        SUB  10
2121  33B0 30 FB                        JR   NC, .dt_s10
2122  33B2 C6 0A                        ADD  A, 10
2123  33B4 4F                           LD   C, A                                ; save units
2124  33B5 78                           LD   A, B
2125  33B6 32 D3 33                     LD   (DrawNumBuf+2), A                   ; tens digit
2126  33B9 79                           LD   A, C
2127  33BA C6 30                        ADD  A, '0'
2128  33BC 32 D4 33                     LD   (DrawNumBuf+3), A                   ; units digit
2129  33BF AF                           XOR  A
2130  33C0 32 D5 33                     LD   (DrawNumBuf+4), A                   ; null terminator
2131  33C3 21 D1 33                     LD   HL, DrawNumBuf
2132  33C6 ED 4B EA 30                  LD   BC, (DrawStr_CurX)
2133  33CA ED 5B EC 30                  LD   DE, (DrawStr_Y)
2134  33CE C3 3A 30                     JP   DrawString
2135  33D1
2136  33D1 00 00 00...  DrawNumBuf:     DEFS 10
