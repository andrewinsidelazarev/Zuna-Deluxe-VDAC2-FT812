1073+ CB98              ; ============================================================================
1074+ CB98              ; OVL_ProbeBoot (Этап 1 загрузчика Quit) — найти BOOT.$C в корне SD, прочитать
1075+ CB98              ; 1-й сектор, сложить результат в РЕЗИДЕНТНЫЕ Core-переменные для проверки по F12-
1076+ CB98              ; дампу. НИЧЕГО не запускает (это де-риск проба). Вызывается через резидентный
1077+ CB98              ; трамплин ProbeBootHobeta (slot3 = LOADER_OVL_PAGE уже выставлен).
1078+ CB98              ;   Boot_Found = 1 если найден и прочитан, иначе 0.
1079+ CB98              ;   Boot_Clus  = стартовый кластер (4 байта), Boot_Size = размер в байтах (4),
1080+ CB98              ;   Boot_Hdr   = первые 32 байта файла (HOBETA-заголовок).
1081+ CB98              ; ============================================================================
1082+ CB98              OVL_ProbeBoot:
1083+ CB98 AF                           XOR  A
1084+ CB99 32 4E 6F                     LD   (Boot_Found), A
1085+ CB9C CD 09 C4                     CALL ZiFi_Init                  ; SD init (always CF=1)
1086+ CB9F CD C8 C4                     CALL RawPak_OpenRoot            ; разобрать BPB/MBR (+найти PAK, игнор)
1087+ CBA2 D2 29 CC                     JP   NC, .pbDone                ; SD/BPB ошибка → Boot_Found=0
1088+ CBA5 21 C0 C4                     LD   HL, RAWPAK_NAME_BOOT       ; цель = "BOOT.$C"
1089+ CBA8 11 29 CE                     LD   DE, RawPak_TargetName
1090+ CBAB 7E           .pbCpy:         LD   A, (HL)
1091+ CBAC CD 5B C9                     CALL RawPak_Upcase
1092+ CBAF 12                           LD   (DE), A
1093+ CBB0 23                           INC  HL
1093+ CBB1 13             INC DE
1094+ CBB2 B7                           OR   A
1095+ CBB3 20 F6                        JR   NZ, .pbCpy
1096+ CBB5 AF                           XOR  A
1097+ CBB6 32 A9 CE                     LD   (RawPak_CheckSize), A      ; сначала найти по имени, затем проверить размер BOOT
1098+ CBB9 CD 8E C6                     CALL RawPak_FindByName          ; CF=1 найден → FileStartClus + FoundSize
1099+ CBBC D2 29 CC                     JP   NC, .pbDone
1100+ CBBF 2A AA CE                     LD   HL, (RawPak_FoundSize + 0)
1101+ CBC2 11 11 7C                     LD   DE, RAWPAK_BOOT_SIZE
1102+ CBC5 B7                           OR   A
1103+ CBC6 ED 52                        SBC  HL, DE
1104+ CBC8 C2 29 CC                     JP   NZ, .pbDone
1105+ CBCB 2A AC CE                     LD   HL, (RawPak_FoundSize + 2)
1106+ CBCE 11 00 00                     LD   DE, 0
1107+ CBD1 B7                           OR   A
1108+ CBD2 ED 52                        SBC  HL, DE
1109+ CBD4 C2 29 CC                     JP   NZ, .pbDone
1110+ CBD7 21 BF CE                     LD   HL, RawPak_FileStartClus
1111+ CBDA 11 4F 6F                     LD   DE, Boot_Clus
1112+ CBDD CD FF CD                     CALL RawPak_Copy32
1113+ CBE0 21 AA CE                     LD   HL, RawPak_FoundSize
1114+ CBE3 11 53 6F                     LD   DE, Boot_Size
1115+ CBE6 CD FF CD                     CALL RawPak_Copy32
1116+ CBE9                              ; --- прочитать 1-й сектор файла → Boot_Hdr (32 байта) ---
1117+ CBE9 21 BF CE                     LD   HL, RawPak_FileStartClus
1118+ CBEC 11 C3 CE                     LD   DE, RawPak_CurClus
1119+ CBEF CD FF CD                     CALL RawPak_Copy32
