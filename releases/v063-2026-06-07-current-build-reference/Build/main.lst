# file closed: Source\ASM\shared_render.asm
4567  7E9E                              include "Input.asm"                   ; resident global input module (PS/2 keyboard via Mr.Gluk + Kempston + mouse); callable from any scene
# file opened: Source\ASM\Input.asm
   1+ 7E9E              ; ============================================================================
   2+ 7E9E              ; Input.asm — РЕЗИДЕНТНЫЙ глобальный модуль ВСЕГО управления. Здесь читаются ВСЕ
   3+ 7E9E              ; источники ввода, поэтому любая сцена-overlay (геймплей #04, UI #41) может
   4+ 7E9E              ; опрашивать ввод без переключения страниц.
   5+ 7E9E              ;
   6+ 7E9E              ; Источники (всё в одном месте — клавиатура + джойстик + мышь):
   7+ 7E9E              ;   * Расширенная PC-клавиатура ZX Evolution через Mr.Gluk Z-контроллер:
   8+ 7E9E              ;       OUT #EFF7,#80 = enable; OUT #DFF7,рег = выбор регистра; #BFF7 = данные.
   9+ 7E9E              ;       Регистр #F0 = PS/2 FIFO scancode'ов (set-2). Тот же чип, что и RTC
  10+ 7E9E              ;       (VDC.ReadRTCSeconds), который ГАСИТ #EFF7 после чтения — поэтому
  11+ 7E9E              ;       Input_Scan каждый кадр включает его заново. См. заметку памяти
  12+ 7E9E              ;       reference_zuma_vdac2_zxevo_ps2_keyboard.
  13+ 7E9E              ;   * Kempston-джойстик (TSLib Input.Kempston). KJoystick=1 направляет PC-стрелки
  14+ 7E9E              ;     сюда же.
  15+ 7E9E              ;   * Мышь (TSLib Input.Mouse) — позиция + ЛКМ.
  16+ 7E9E              ;
  17+ 7E9E              ; Схема управления: лягушка = вращение Влево/Вправо (геймплей). Глобальные UI:
  18+ 7E9E              ;   Up/Down — навигация меню/выбор сложности; Влево/Вправо — активная кнопка в
  19+ 7E9E              ;   диалогах; ESC — меню/назад; Fire = Space | Enter | Kempston-Fire | ЛКМ.
  20+ 7E9E              ; Клавиатурные эквиваленты направлений (классическая ZX-раскладка):
  21+ 7E9E              ;   Up = ↑ | Q;  Down = ↓ | A;  Влево = ← | O;  Вправо = → | P.
  22+ 7E9E              ;
  23+ 7E9E              ; Применение: Input_Init один раз на старте; Input_Scan один раз за кадр (в любой
  24+ 7E9E              ; сцене — он обновляет и клавиатуру, и мышь); затем опросы Input_Up/Down/Left/
  25+ 7E9E              ; Right/Fire/Esc (каждый возвращает NZ = активно). Edge-хелперы — для навигации.
  26+ 7E9E              ; ============================================================================
  27+ 7E9E
  28+ 7E9E              ; Скан-коды PS/2 set-2 (make-коды; стрелки идут с префиксом E0, но их коды
  29+ 7E9E              ; уникальны, поэтому при сопоставлении префикс E0 игнорируется).
  30+ 7E9E              INP_SC_ESC      EQU #76
  31+ 7E9E              INP_SC_UP       EQU #75
  32+ 7E9E              INP_SC_DOWN     EQU #72
  33+ 7E9E              INP_SC_LEFT     EQU #6B
  34+ 7E9E              INP_SC_RIGHT    EQU #74
