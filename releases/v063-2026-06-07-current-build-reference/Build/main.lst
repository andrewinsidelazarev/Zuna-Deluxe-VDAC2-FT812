2445  3B7C 3A E6 6C                     LD   A, (Core.Frog_NextBallColor)
2446  3B7F CD C7 3A                     CALL Frog_FilteredRandomColor
2447  3B82 32 E6 6C                     LD   (Core.Frog_NextBallColor), A
2448  3B85 C9                           RET
2449  3B86
2450  3B86              ; Frog_NewNextColor — force fresh new NextBallColor (= после promote при start fire).
2451  3B86              ; Counter mod 128: каждый 128-й вызов взводит FLAG, и следующий pick в
2452  3B86              ; Frog_FilteredRandomColor XOR'ит RTC seconds в RAND BYTE (выход LFSR, не seed).
2453  3B86              ; Это сохраняет цикл LFSR неприкосновенным (Gemini совет), но добавляет точечный
2454  3B86              ; перетряс распределения раз в ~128 выстрелов.
2455  3B86              Frog_NewNextColor:
2456  3B86 21 09 50                     LD   HL, FROG_RTC_MIX_CNT_ADDR
2457  3B89 7E                           LD   A, (HL)
2458  3B8A 3C                           INC  A
2459  3B8B E6 7F                        AND  #7F                              ; counter mod 128
2460  3B8D 77                           LD   (HL), A
2461  3B8E B7                           OR   A
2462  3B8F 20 05                        JR   NZ, .nnc_no_flag                 ; cnt != 0 → no boundary
2463  3B91 3E 01                        LD   A, 1
2464  3B93 32 0A 50                     LD   (FROG_RTC_MIX_FLAG_ADDR), A      ; mark for picker to consume
2465  3B96              .nnc_no_flag:
2466  3B96                              ; Exclude BallColor from mask если popcount активных цветов >= 3.
2467  3B96                              ; Юзер: «следующий шар лягушки» не должен совпадать с предыдущим
2468  3B96                              ; (когда в цепи 3+ цветов; иначе чередование вынужденное).
2469  3B96 3A E5 6C                     LD   A, (Core.Frog_BallColor)
2470  3B99 32 0B 50                     LD   (FROG_EXCLUDE_COLOR_ADDR), A
2471  3B9C 3E FF                        LD   A, #FF                            ; sentinel: force fresh
2472  3B9E CD C7 3A                     CALL Frog_FilteredRandomColor
2473  3BA1 32 E6 6C                     LD   (Core.Frog_NextBallColor), A
2474  3BA4 C9                           RET
2475  3BA5
2476  3BA5              ; ============================================================================
2477  3BA5              ; VDC_Random8 — LFSR Galois 16-bit (poly 0xB400), 8-bit uniform 0..255.
2478  3BA5              ; Тот же LFSR step что Core.VDC_RandomColor, но без AND-mask. Используется
2479  3BA5              ; Frog_FilteredRandomColor для unbiased mod-B через (rand * B) >> 8 — это
2480  3BA5              ; нужно когда popcount(mask) не степень двойки (B=3 в основном). Старый AND 3
2481  3BA5              ; + mod B давал bias 50%/25%/25% для popcount=3 → видимый перекос колора.
2482  3BA5              ; Разделяет Core.VDC_LfsrSeed с VDC_RandomColor (оба stepper'а двигают одну
2483  3BA5              ; и ту же последовательность атомарно — без корреляции).
2484  3BA5              ; ============================================================================
2485  3BA5              VDC_Random8:
2486  3BA5 2A E3 D4                     LD   HL, (Core.VDC_LfsrSeed)
2487  3BA8 7D                           LD   A, L
2488  3BA9 E6 01                        AND  1
2489  3BAB CB 3C                        SRL  H
2489  3BAD CB 1D          RR L
2490  3BAF 30 0A                        JR   NC, .r8_no_xor
2491  3BB1 16 B4                        LD   D, #B4
2491  3BB3 1E 00          LD E, 0
2492  3BB5 7C                           LD   A, H
2492  3BB6 AA             XOR D
2492  3BB7 67             LD H, A
2493  3BB8 7D                           LD   A, L
2493  3BB9 AB             XOR E
2493  3BBA 6F             LD L, A
2494  3BBB              .r8_no_xor:
2495  3BBB 22 E3 D4                     LD   (Core.VDC_LfsrSeed), HL
2496  3BBE 7D                           LD   A, L
2497  3BBF AC                           XOR  H                                 ; 8-bit uniform
2498  3BC0 C9                           RET
2499  3BC1
2500  3BC1              ; ----------------------------------------------------------------------------
2501  3BC1              ; ZX7 Turbo decompressor (Einar Saukas / Urusergi). HL = compressed src,
2502  3BC1              ; DE = destination. Восстановлен из ~/Desktop/Zuma Deluxe (src/ASM,
2503  3BC1              ; zuma_new_spg.asm:4466). Размер ~62 байта. Не корраптит I, IX, IY.
2504  3BC1              ; Используется через UnpackZX7Page wrapper. На входе HL/DE должны указывать
2505  3BC1              ; в WRITABLE области (исходник можно в slot 2 ROM-like, dest в RAM).
2506  3BC1              ; ----------------------------------------------------------------------------
2507  3BC1              Dzx7Turbo:
2508  3BC1 3E 80                        LD   A, #80
2509  3BC3              .zx7_copy_byte_loop:
2510  3BC3 ED A0                        LDI
2511  3BC5              .zx7_main_loop:
2512  3BC5 87                           ADD  A, A
2513  3BC6 CC 16 3C                     CALL Z, .zx7_load_bits
2514  3BC9 30 F8                        JR   NC, .zx7_copy_byte_loop
2515  3BCB D5                           PUSH DE
2516  3BCC 01 01 00                     LD   BC, 1
2517  3BCF 50                           LD   D, B
2518  3BD0              .zx7_len_size_loop:
2519  3BD0 14                           INC  D
2520  3BD1 87                           ADD  A, A
2521  3BD2 CC 16 3C                     CALL Z, .zx7_load_bits
2522  3BD5 30 F9                        JR   NC, .zx7_len_size_loop
2523  3BD7 C3 E4 3B                     JP   .zx7_len_value_start
2524  3BDA              .zx7_len_value_loop:
2525  3BDA 87                           ADD  A, A
2526  3BDB CC 16 3C                     CALL Z, .zx7_load_bits
2527  3BDE CB 11                        RL   C
2528  3BE0 CB 10                        RL   B
2529  3BE2 38 2D                        JR   C, .zx7_exit
2530  3BE4              .zx7_len_value_start:
2531  3BE4 15                           DEC  D
2532  3BE5 20 F3                        JR   NZ, .zx7_len_value_loop
2533  3BE7 03                           INC  BC
2534  3BE8 5E                           LD   E, (HL)
2535  3BE9 23                           INC  HL
2536  3BEA CB 33                        DB   #CB, #33                          ; SLL E / SLS E (undoc)
2537  3BEC 30 1A                        JR   NC, .zx7_offset_end
2538  3BEE 87                           ADD  A, A
2539  3BEF CC 16 3C                     CALL Z, .zx7_load_bits
2540  3BF2 CB 12                        RL   D
2541  3BF4 87                           ADD  A, A
2542  3BF5 CC 16 3C                     CALL Z, .zx7_load_bits
2543  3BF8 CB 12                        RL   D
2544  3BFA 87                           ADD  A, A
2545  3BFB CC 16 3C                     CALL Z, .zx7_load_bits
2546  3BFE CB 12                        RL   D
2547  3C00 87                           ADD  A, A
2548  3C01 CC 16 3C                     CALL Z, .zx7_load_bits
2549  3C04 3F                           CCF
2550  3C05 38 01                        JR   C, .zx7_offset_end
2551  3C07 14                           INC  D
2552  3C08              .zx7_offset_end:
2553  3C08 CB 1B                        RR   E
2554  3C0A E3                           EX   (SP), HL
2555  3C0B E5                           PUSH HL
2556  3C0C ED 52                        SBC  HL, DE
2557  3C0E D1                           POP  DE
2558  3C0F ED B0                        LDIR
2559  3C11              .zx7_exit:
2560  3C11 E1                           POP  HL
2561  3C12 D2 C5 3B                     JP   NC, .zx7_main_loop
2562  3C15 C9                           RET
2563  3C16              .zx7_load_bits:
2564  3C16 7E                           LD   A, (HL)
2565  3C17 23                           INC  HL
2566  3C18 17                           RLA
2567  3C19 C9                           RET
2568  3C1A
2569  3C1A              ; ----------------------------------------------------------------------------
2570  3C1A              ; SCRATCH_PAGE — свободная SPG page для decomp output. Используется
2571  3C1A              ; UnpackAndUploadPage в Initialize между bg/balls/frog uploads.
2572  3C1A              ; Page #01 не задействован ни одним Block в spgbld_vdac2.ini — безопасно.
2573  3C1A              ; ----------------------------------------------------------------------------
2574  3C1A              SCRATCH_PAGE    EQU #01
2575  3C1A
2576  3C1A              ; ----------------------------------------------------------------------------
2577  3C1A              ; UnpackAndUploadPage: расжать compressed src page A → SCRATCH_PAGE,
2578  3C1A              ; залить 16K из SCRATCH_PAGE в FT_RAM_G по адресу (Core.BgRamH:BgRamL),
2579  3C1A              ; продвинуть указатель FT_RAM_G на +#4000.
2580  3C1A              ;
2581  3C1A              ; In:  A = compressed source SPG page; Core.BgRamH/L = FT_RAM_G dest 24-bit
2582  3C1A              ; Out: Core.BgRamH/L advanced by 16K
2583  3C1A              ; Slots after RET: slot 2 = src (not restored), slot 3 = current scene overlay
2584  3C1A              ; (Core.CurrentCodePage). Restoring slot 3 here keeps dumps and any call-side code
2585  3C1A              ; from observing the transient scratch page between compressed uploads.
2586  3C1A              ; ----------------------------------------------------------------------------
2587  3C1A              ; CurrentCodePage tracks which scene overlay is mapped in slot 3: #41 (UI =
2588  3C1A              ; menu/level-select) or #04 (gameplay). The shared slot0 decompressors below use
2589  3C1A              ; slot 3 as decomp scratch, then restore it to THIS page (not a hard-coded #04),
2590  3C1A              ; so they are correct from any scene. Maintained by the resident Fade* transitions;
2591  3C1A              ; boot default = UI overlay (first scene is the menu). Resident (slot 0/TSLib region).
2592  3C1A 41           CurrentCodePage:  DB UI_OVL_PAGE
2593  3C1B              UnpackAndUploadPage:
2594  3C1B F3                           DI
2595  3C1C 32 6F 3C                     LD   (.uaup_src), A
2596  3C1F ED 73 70 3C                  LD   (.uaup_saved_sp), SP
2597  3C23 31 B2 3C                     LD   SP, .uaup_temp_stack_top
2598  3C26
2599  3C26                              ; slot 2 = compressed src
2600  3C26 3A 6F 3C                     LD   A, (.uaup_src)
2600  3C29 01 AF 12       LD BC, PAGE2
2600  3C2C ED 79          OUT (C), A
2601  3C2E                              ; slot 3 = scratch (decomp dest)
2602  3C2E 3E 01                        LD   A, SCRATCH_PAGE
2602  3C30 01 AF 13       LD BC, PAGE3
2602  3C33 ED 79          OUT (C), A
2603  3C35
2604  3C35                              ; Dzx7Turbo: HL=src, DE=dst
2605  3C35 21 00 80                     LD   HL, #8000
2606  3C38 11 00 C0                     LD   DE, #C000
2607  3C3B CD C1 3B                     CALL Dzx7Turbo
2608  3C3E
2609  3C3E                              ; FT.WriteMem(HL=#C000 in slot 3, BC=16384, A:DE=FT_RAM_G addr)
2610  3C3E 21 00 C0                     LD   HL, #C000
2611  3C41 01 00 40                     LD   BC, 16384
2612  3C44 3A BA 68                     LD   A, (Core.BgRamH)
2613  3C47 ED 5B B8 68                  LD   DE, (Core.BgRamL)
2614  3C4B CD 6A 12                     CALL FT.WriteMem
2615  3C4E
2616  3C4E                              ; Advance Core.BgRamL/H by 16K
2617  3C4E 2A B8 68                     LD   HL, (Core.BgRamL)
2618  3C51 11 00 40                     LD   DE, #4000
2619  3C54 19                           ADD  HL, DE
2620  3C55 22 B8 68                     LD   (Core.BgRamL), HL
2621  3C58 30 07                        JR   NC, .uaup_no_carry
2622  3C5A 3A BA 68                     LD   A, (Core.BgRamH)
2622  3C5D 3C             INC A
2622  3C5E 32 BA 68       LD (Core.BgRamH), A
2623  3C61              .uaup_no_carry:
2624  3C61 3A 1A 3C                     LD   A, (CurrentCodePage)
2624  3C64 01 AF 13       LD BC, PAGE3
2624  3C67 ED 79          OUT (C), A   ; restore slot 3 = current scene overlay (#41 ui / #04 gameplay)
2625  3C69 ED 7B 70 3C                  LD   SP, (.uaup_saved_sp)
2626  3C6D FB                           EI
2627  3C6E C9                           RET
2628  3C6F 00           .uaup_src:        DB 0
2629  3C70 00 00        .uaup_saved_sp:   DW 0
2630  3C72 00 00 00...  .uaup_temp_stack: DEFS 64
2631  3CB2              .uaup_temp_stack_top:
2632  3CB2
2633  3CB2              ; ----------------------------------------------------------------------------
2634  3CB2              ; UnpackZX7Page: расжать compressed page A → dest page B.
2635  3CB2              ; Source = slot 2 (#8000), dest = slot 3 (#C000). После RET слоты восстановлены:
2636  3CB2              ; slot 2 → page 6 (TrackData), slot 3 → page #04 (main1_play).
2637  3CB2              ; Stack пересажен на uzx7_temp_stack чтобы LDIR в slot 3 не зацепил наш стек.
2638  3CB2              ; ----------------------------------------------------------------------------
2639  3CB2              UnpackZX7Page:
2640  3CB2 F3                           DI
2641  3CB3 32 EF 3C                     LD   (.uzx7_src), A
2642  3CB6 78                           LD   A, B
2642  3CB7 32 F0 3C       LD (.uzx7_dst), A
2643  3CBA ED 73 F1 3C                  LD   (.uzx7_saved_sp), SP
2644  3CBE 31 33 3D                     LD   SP, .uzx7_temp_stack_top
2645  3CC1 3A EF 3C                     LD   A, (.uzx7_src)
2645  3CC4 01 AF 12       LD BC, PAGE2
2645  3CC7 ED 79          OUT (C), A
2646  3CC9 3A F0 3C                     LD   A, (.uzx7_dst)
2646  3CCC 01 AF 13       LD BC, PAGE3
2646  3CCF ED 79          OUT (C), A
2647  3CD1 21 00 80                     LD   HL, #8000
2648  3CD4 11 00 C0                     LD   DE, #C000
2649  3CD7 CD C1 3B                     CALL Dzx7Turbo
2650  3CDA 3E 06                        LD   A, 6
2650  3CDC 01 AF 12       LD BC, PAGE2
2650  3CDF ED 79          OUT (C), A   ; restore slot 2 = TrackData page
2651  3CE1 3A 1A 3C                     LD   A, (CurrentCodePage)
2651  3CE4 01 AF 13       LD BC, PAGE3
2651  3CE7 ED 79          OUT (C), A   ; restore slot 3 = current scene overlay (#41 ui / #04 gameplay)
2652  3CE9 ED 7B F1 3C                  LD   SP, (.uzx7_saved_sp)
2653  3CED FB                           EI
2654  3CEE C9                           RET
2655  3CEF 00           .uzx7_src:        DB 0
2656  3CF0 00           .uzx7_dst:        DB 0
2657  3CF1 00 00        .uzx7_saved_sp:   DW 0
2658  3CF3 00 00 00...  .uzx7_temp_stack: DEFS 64
2659  3D33              .uzx7_temp_stack_top:
2660  3D33
2661  3D33              ; ----------------------------------------------------------------------------
2662  3D33              ; SafeInflatePage2: FT812 CMD_INFLATE with compressed source mapped in PAGE2.
2663  3D33              ;
2664  3D33              ; TSLib FT.Coprocessor.Inflate maps source pages into PAGE3/#C000, which is also
2665  3D33              ; our main1_play code slot. Fresh host dumps showed CPU HALT while PAGE3 was a
2666  3D33              ; zlib preview page (#F1). This variant keeps PAGE3 untouched and streams the
2667  3D33              ; source from PAGE2/#8000 instead.
2668  3D33              ;
2669  3D33              ; In: same convention as FT.Coprocessor.Inflate for current callers:
2670  3D33              ;   A:DE = RAM_G destination, BC = compressed byte count, HL = source offset,
2671  3D33              ;   A' = source SPG page. Current assets are all <64K compressed.
2672  3D33              ; Out: CF set only if coprocessor write reports fault.
2673  3D33              ; Slots after RET: PAGE2 restored to previous value; PAGE3 unchanged.
2674  3D33              ; ----------------------------------------------------------------------------
2675  3D33              SafeInflatePage2:
2676  3D33 CD 48 14                     CALL FT.Coprocessor.WaitFlush
2677  3D36 D8                           RET  C
2678  3D37
2679  3D37 E5                           PUSH HL
2680  3D38 D5                           PUSH DE
2681  3D39                              FT_WR32_CMD FT_CMD_INFLATE
2681  3D39 21 FF FF    >                LD HL, (FT_CMD_INFLATE >> 16) & 0xFFFF
2681  3D3C 11 22 FF    >                LD DE, FT_CMD_INFLATE & 0xFFFF
2681  3D3F CD F6 12    >                CALL FT.Coprocessor.Write32
2682  3D42 D1                           POP  DE
2683  3D43
2684  3D43 26 00                        LD   H, #00
2685  3D45 6F                           LD   L, A
2686  3D46 CD F6 12                     CALL FT.Coprocessor.Write32
2687  3D49 D8                           RET  C
2688  3D4A
2689  3D4A                              GetPage2
2689  3D4A             >                ifdef MAPPING_REGISTERS
2689  3D4A 3A 12 04    >                LD A, (FMADDR_REGS + HIGH PAGE2)
2689  3D4D             >                else
2689  3D4D ~           >                LD A, (MemoryPages + 2)
2689  3D4D             >                endif
2690  3D4D 32 A7 3D                     LD   (.sip2_saved_page2), A
2691  3D50 E1                           POP  HL
2692  3D51
2693  3D51                              ; Move source address from page-local #0000..#3FFF into slot2
2694  3D51                              ; address space #8000..#BFFF.
2695  3D51 7C                           LD   A, H
2696  3D52 F6 80                        OR   %10000000
2697  3D54 67                           LD   H, A
2698  3D55 08                           EX   AF, AF'
2699  3D56 32 A8 3D                     LD   (.sip2_src_page), A
2700  3D59 08                           EX   AF, AF'
2701  3D5A
2702  3D5A 3A A8 3D     .loop:          LD   A, (.sip2_src_page)
2703  3D5D                              SetPage2_A
2703  3D5D             >                ifdef MAPPING_REGISTERS
2703  3D5D 32 12 04    >                LD (FMADDR_REGS + HIGH PAGE2), A
2703  3D60             >                else
2703  3D60 ~           >                LD (MemoryPages + 2), A
2703  3D60 ~           >                LD BC, PAGE2
2703  3D60 ~           >                OUT (C), A
2703  3D60             >                endif
2704  3D60
2705  3D60 E5                           PUSH HL                              ; source CPU address
2706  3D61 7C                           LD   A, H
2707  3D62 E6 3F                        AND  %00111111
2708  3D64 67                           LD   H, A
2709  3D65 EB                           EX   DE, HL                          ; DE = offset in page
2710  3D66 21 00 40                     LD   HL, #4000
2711  3D69 B7                           OR   A
2712  3D6A ED 52                        SBC  HL, DE
2713  3D6C EB                           EX   DE, HL                          ; DE = bytes to page end
2714  3D6D
2715  3D6D 60                           LD   H, B
2716  3D6E 69                           LD   L, C                            ; HL = remaining total
2717  3D6F B7                           OR   A
2718  3D70 ED 52                        SBC  HL, DE
2719  3D72 30 09                        JR   NC, .page_chunk
2720  3D74
2721  3D74 19                           ADD  HL, DE                          ; HL = final chunk bytes
2722  3D75 44                           LD   B, H
2723  3D76 4D                           LD   C, L
2724  3D77 21 00 00                     LD   HL, #0000                       ; no remainder
2725  3D7A 37                           SCF                                  ; align final packet
2726  3D7B 18 03                        JR   .write_chunk
2727  3D7D
2728  3D7D 42           .page_chunk:    LD   B, D
2729  3D7E 4B                           LD   C, E                            ; BC = chunk bytes
2730  3D7F B7                           OR   A                               ; not final, no align
2731  3D80
2732  3D80 E3           .write_chunk:   EX   (SP), HL                         ; HL=source, stack=remainder
2733  3D81 CD 9E 12                     CALL FT.Coprocessor.Write
2734  3D84 C1                           POP  BC                              ; BC = remaining total
2735  3D85 38 18                        JR   C, .restore_error
2736  3D87 78                           LD   A, B
2737  3D88 B1                           OR   C
2738  3D89 28 0C                        JR   Z, .restore_ok
2739  3D8B
2740  3D8B 21 00 80                     LD   HL, #8000
2741  3D8E 3A A8 3D                     LD   A, (.sip2_src_page)
2742  3D91 3C                           INC  A
2743  3D92 32 A8 3D                     LD   (.sip2_src_page), A
2744  3D95 18 C3                        JR   .loop
2745  3D97
2746  3D97 3A A7 3D     .restore_ok:    LD   A, (.sip2_saved_page2)
2747  3D9A                              SetPage2_A
2747  3D9A             >                ifdef MAPPING_REGISTERS
2747  3D9A 32 12 04    >                LD (FMADDR_REGS + HIGH PAGE2), A
2747  3D9D             >                else
2747  3D9D ~           >                LD (MemoryPages + 2), A
2747  3D9D ~           >                LD BC, PAGE2
2747  3D9D ~           >                OUT (C), A
2747  3D9D             >                endif
2748  3D9D B7                           OR   A
2749  3D9E C9                           RET
2750  3D9F 3A A7 3D     .restore_error: LD   A, (.sip2_saved_page2)
2751  3DA2                              SetPage2_A
2751  3DA2             >                ifdef MAPPING_REGISTERS
2751  3DA2 32 12 04    >                LD (FMADDR_REGS + HIGH PAGE2), A
2751  3DA5             >                else
2751  3DA5 ~           >                LD (MemoryPages + 2), A
2751  3DA5 ~           >                LD BC, PAGE2
2751  3DA5 ~           >                OUT (C), A
2751  3DA5             >                endif
2752  3DA5 37                           SCF
2753  3DA6 C9                           RET
2754  3DA7 00           .sip2_saved_page2: DB 0
2755  3DA8 00           .sip2_src_page:    DB 0
2756  3DA9
2757  3DA9                              include "LevelSelectPreviewSlot0.asm"
# file opened: Source\ASM\LevelSelectPreviewSlot0.asm
   1+ 3DA9              ; Level-select thumbnail marker loader/draw helpers.
