 261+ 7E96 F0 00        ZL_SmoothY:     DEFW 240
 262+ 7E98 00 00        ZL_TmpTx:       DEFW 0                                ; ZL_EmitTranslate scratch X
 263+ 7E9A 00 00        ZL_TmpTy:       DEFW 0                                ; ZL_EmitTranslate scratch Y
 264+ 7E9C 00 00        ZL_TmpAngle:    DEFW 0                                ; ZL_EmitRotate scratch angle
