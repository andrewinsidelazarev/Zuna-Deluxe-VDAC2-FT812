 164+ 7FC3 7E                           LD   A, (HL)                               ; было нажато?
 165+ 7FC4 36 01                        LD   (HL), 1                               ; запомнить «нажато»
 166+ 7FC6 EE 01                        XOR  1                                     ; было 0 -> A=1 (фронт, NZ); было 1 -> A=0 (Z)
 167+ 7FC8 C9                           RET
 168+ 7FC9 36 00        .released:      LD   (HL), 0                               ; отпущено -> сброс
 169+ 7FCB AF                           XOR  A                                     ; Z = фронта нет
