1253+ F597              ; (ZL_StableBallBucket удалён 2026-05-18 — per-ball loop не использует buckets.)
1254+ F597
1255+ F597              ; ZL_EmitBitmapHandle: emit DL command BITMAP_HANDLE(A) runtime.
1256+ F597              ;   In:  A = handle (0..31). Out: nothing. Clobbers AF, BC, DE, HL.
1257+ F597              ZL_EmitBitmapHandle:
1258+ F597 E6 1F                        AND  #1F
1259+ F599 5F                           LD   E, A
