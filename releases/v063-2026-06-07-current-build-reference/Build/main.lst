2301  3AC7              ; ============================================================================
2302  3AC7              ; Frog_FilteredRandomColor — RandomColor с фильтром цветов цепи.
2303  3AC7              ; Out: A = color (0..3), guaranteed to be present in VDC_Slots if chain non-empty.
2304  3AC7              ; Fallback: unfiltered random AND 3 если chain пуст или все retry'ы промахнулись.
2305  3AC7              ; Preserves: BC, DE, HL (стандартные slot-0 caller-saves).
2306  3AC7              ; ============================================================================
2307  3AC7              Frog_FilteredRandomColor:                              ; in A: 0xFF=force fresh; else=check & keep if in mask
2308  3AC7 C5                           PUSH BC
2309  3AC8 D5                           PUSH DE
2310  3AC9 E5                           PUSH HL
2311  3ACA 47                           LD   B, A                              ; B = input color (0xFF=force fresh)
2312  3ACB                              ; --- Build mask in D from VDC_Slots[0..SlotsLen-1] ---
2313  3ACB 16 00                        LD   D, 0                              ; D = mask (bits 0..VDC_NUM_COLORS-1 = colors present)
2314  3ACD 3A D2 6C                     LD   A, (Core.VDC_SlotsLen)
2315  3AD0 B7                           OR   A
2316  3AD1 CA 67 3B                     JP   Z, .frc_fb_in                     ; empty chain → fallback (JP — JR диапазон превысился после exclude block)
2317  3AD4 4F                           LD   C, A
2318  3AD5 2A BE D9                     LD   HL, (Core.VDC_pSlots)
2319  3AD8 7E           .frc_ml:        LD   A, (HL)
2320  3AD9 23                           INC  HL
2321  3ADA FE 06                        CP   Core.VDC_NUM_COLORS
2322  3ADC 30 0C                        JR   NC, .frc_msk_skip                 ; GAP marker (>=NUM_COLORS) → skip
2323  3ADE 5F                           LD   E, A                              ; E = bit index
2324  3ADF 3E 01                        LD   A, 1
2325  3AE1 1C                           INC  E
2326  3AE2 1D           .frc_sh:        DEC  E
2327  3AE3 28 03                        JR   Z, .frc_sh_done
2328  3AE5 87                           ADD  A, A
2329  3AE6 18 FA                        JR   .frc_sh
2330  3AE8 B2           .frc_sh_done:   OR   D
2331  3AE9 57                           LD   D, A
2332  3AEA 0D           .frc_msk_skip:  DEC  C
2333  3AEB 20 EB                        JR   NZ, .frc_ml
2334  3AED                              ; --- Check input color B against mask D (skip if 0xFF) ---
2335  3AED 78                           LD   A, B
2336  3AEE FE 06                        CP   Core.VDC_NUM_COLORS
2337  3AF0 30 10                        JR   NC, .frc_pick_new                 ; B >= NUM_COLORS (including 0xFF) → force fresh
2338  3AF2 5F                           LD   E, A                              ; check bit B in mask
2339  3AF3 3E 01                        LD   A, 1
2340  3AF5 1C                           INC  E
2341  3AF6 1D           .frc_chsh:      DEC  E
2342  3AF7 28 03                        JR   Z, .frc_chsh_done
2343  3AF9 87                           ADD  A, A
2344  3AFA 18 FA                        JR   .frc_chsh
2345  3AFC A2           .frc_chsh_done: AND  D
2346  3AFD 28 03                        JR   Z, .frc_pick_new                  ; B not in mask → fresh
2347  3AFF 78                           LD   A, B                              ; keep input color
2348  3B00 18 6D                        JR   .frc_exit
2349  3B02              .frc_pick_new:
2350  3B02                              ; --- Popcount mask D → B (число цветов в цепи) ---
2351  3B02 06 00                        LD   B, 0
2352  3B04 1E 06                        LD   E, Core.VDC_NUM_COLORS            ; parametric (Gemini fix)
2353  3B06 7A                           LD   A, D
2354  3B07 0F           .frc_pc:        RRCA
2355  3B08 30 01                        JR   NC, .frc_pc_skip
2356  3B0A 04                           INC  B
2357  3B0B 1D           .frc_pc_skip:   DEC  E
2358  3B0C 20 F9                        JR   NZ, .frc_pc
2359  3B0E                              ; --- Exclude bit (если popcount >= 3 и FROG_EXCLUDE_COLOR_ADDR valid) ---
2360  3B0E 78                           LD   A, B
2361  3B0F FE 03                        CP   3
2362  3B11 38 1F                        JR   C, .frc_no_excl
2363  3B13 3A 0B 50                     LD   A, (FROG_EXCLUDE_COLOR_ADDR)
2364  3B16 FE 06                        CP   Core.VDC_NUM_COLORS
2365  3B18 30 13                        JR   NC, .frc_excl_reset               ; #FF / out-of-range → no excl, но reset
2366  3B1A 5F                           LD   E, A
2367  3B1B 3E 01                        LD   A, 1
2368  3B1D 1C                           INC  E
2369  3B1E 1D           .frc_xsh:       DEC  E
2370  3B1F 28 03                        JR   Z, .frc_xsh_done
2371  3B21 87                           ADD  A, A
2372  3B22 18 FA                        JR   .frc_xsh
2373  3B24 5F           .frc_xsh_done:  LD   E, A                              ; E = bit mask
2374  3B25 A2                           AND  D
2375  3B26 28 05                        JR   Z, .frc_excl_reset                ; bit not в mask → skip
2376  3B28 7B                           LD   A, E
2377  3B29 2F                           CPL
2378  3B2A A2                           AND  D
2379  3B2B 57                           LD   D, A                              ; mask -= bit
2380  3B2C 05                           DEC  B                                  ; popcount--
2381  3B2D              .frc_excl_reset:
2382  3B2D 3E FF                        LD   A, #FF
2383  3B2F 32 0B 50                     LD   (FROG_EXCLUDE_COLOR_ADDR), A      ; consume — RefilterCurrent calls должны не unaffected
2384  3B32              .frc_no_excl:
2385  3B32 78                           LD   A, B
2386  3B33 B7                           OR   A
2387  3B34 28 36                        JR   Z, .frc_fb                        ; mask empty → fallback
2388  3B36                              ; --- pick index 0..B-1 via mul-then-shift: (rand8 * B) >> 8.
2389  3B36                              ; Bias ≤ 1/(256/B) ≤ 1.6%. Старый `AND 3 + mod B` на 4-value
2390  3B36                              ; источнике давал при popcount=3 LSB-цвету маски 50% vs 25% —
2391  3B36                              ; визуально «слишком много <цвет-0-маски>» (purple bias).
2392  3B36 D5                           PUSH DE                                ; save D = mask (E irrelevant)
2393  3B37 C5                           PUSH BC                                ; save B = popcount
2394  3B38 CD A5 3B                     CALL VDC_Random8                       ; A = 0..255 uniform LFSR
2395  3B3B 57                           LD   D, A                              ; D = rand (preserve)
2396  3B3C                              ; --- Optional RTC mix into RAND BYTE (not seed!) every 128th NewNextColor ---
2397  3B3C 21 0A 50                     LD   HL, FROG_RTC_MIX_FLAG_ADDR
2398  3B3F 7E                           LD   A, (HL)
2399  3B40 B7                           OR   A
2400  3B41 28 09                        JR   Z, .frc_no_rtc_mix
2401  3B43 36 00                        LD   (HL), 0                           ; consume flag
2402  3B45 D5                           PUSH DE
2403  3B46 CD 02 C3                     CALL Core.ReadRTCSeconds               ; A = 0..59 binary
2404  3B49 D1                           POP  DE                                 ; D = rand
2405  3B4A AA                           XOR  D                                  ; rand XOR RTC
2406  3B4B 57                           LD   D, A
2407  3B4C              .frc_no_rtc_mix:
2408  3B4C C1                           POP  BC                                 ; restore B = popcount
2409  3B4D 58                           LD   E, B                              ; E = popcount
2410  3B4E CD 34 E0                     CALL Core.Frog_Mul8x8u                 ; HL = D*E (clobbers A,B,DE)
2411  3B51 D1                           POP  DE                                 ; restore D = mask
2412  3B52 4C                           LD   C, H                              ; C = (rand*B)>>8 = 0..B-1
2413  3B53                              ; --- Walk mask D LSB→MSB, return color of C-th set bit ---
2414  3B53 1E 00                        LD   E, 0                              ; E = current color index
2415  3B55 7A           .frc_walk:      LD   A, D
2416  3B56 E6 01                        AND  #01
2417  3B58 28 05                        JR   Z, .frc_walk_skip
2418  3B5A 79                           LD   A, C
2419  3B5B B7                           OR   A
2420  3B5C 28 06                        JR   Z, .frc_walk_found
2421  3B5E 0D                           DEC  C
2422  3B5F CB 3A        .frc_walk_skip: SRL  D
2423  3B61 1C                           INC  E
2424  3B62 18 F1                        JR   .frc_walk
2425  3B64              .frc_walk_found:
2426  3B64 7B                           LD   A, E
2427  3B65 18 08                        JR   .frc_exit
2428  3B67              .frc_fb_in:     ; empty chain: keep input B if valid, else random unfiltered
2429  3B67 78                           LD   A, B
2430  3B68 FE 06                        CP   Core.VDC_NUM_COLORS
2431  3B6A 38 03                        JR   C, .frc_exit                      ; B < NUM_COLORS → keep
2432  3B6C CD 96 CE     .frc_fb:        CALL Core.VDC_RandomColor              ; уже выдаёт 0..NUM_COLORS-1
2433  3B6F                              ; (убрана hardcoded AND 3 — Gemini fix; VDC_RandomColor сам маскирует)
2434  3B6F E1           .frc_exit:      POP  HL
2435  3B70 D1                           POP  DE
2436  3B71 C1                           POP  BC
2437  3B72 C9                           RET
