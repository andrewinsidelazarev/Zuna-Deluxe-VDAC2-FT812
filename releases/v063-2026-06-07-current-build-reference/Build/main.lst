 724+ C501              ; ============================================================================
 725+ C501              VDC_UpdateRtcElapsed:
 726+ C501                              ; ТОЛЬКО RTC. Если sec не поменялся — RET, ничего не добавляем.
 727+ C501                              ; Frame-fallback убран (был для эмуляторов с мёртвым RTC, но
 728+ C501                              ; после #EFF7 fix RTC всегда работает).
 729+ C501 CD 02 C3                     CALL ReadRTCSeconds                    ; A = current 0..59
 730+ C504 47                           LD   B, A                              ; B = current
 731+ C505 3A D3 D4                     LD   A, (VDC_RtcLastSecond)            ; A = old
 732+ C508 B8                           CP   B
 733+ C509 C8                           RET  Z                                 ; не поменялось → выходим
 734+ C50A 4F                           LD   C, A                              ; C = old
 735+ C50B 78                           LD   A, B                              ; A = current
 736+ C50C B9                           CP   C
 737+ C50D 30 02                        JR   NC, .rte_no_wrap
 738+ C50F C6 3C                        ADD  A, 60                             ; wrap 59→0
 739+ C511 91           .rte_no_wrap:   SUB  C                                 ; A = delta 1..59
 740+ C512 5F                           LD   E, A
 740+ C513 16 00          LD D, 0
 741+ C515 2A E3 6C                     LD   HL, (VDC_GameSeconds)
 742+ C518 19                           ADD  HL, DE
 743+ C519 22 E3 6C                     LD   (VDC_GameSeconds), HL
 744+ C51C 78                           LD   A, B
 745+ C51D 32 D3 D4                     LD   (VDC_RtcLastSecond), A
 746+ C520 C9                           RET
