 650+ C491              ; ============================================================================
 651+ C491              ; WIN-снимок: сэмпл ГОЛОВНОГО шара (ближайшего к килл-зоне) каждой цепочки.
 652+ C491              ; Снимается каждый PLAY-кадр ДО апдейта. keep-last-non-empty: обновляем только
 653+ C491              ; если в цепочке есть видимые шары (иначе храним прошлый кадр — к WIN цепочка
 654+ C491              ; пуста). Голова = максимальный track-сэмпл среди видимых шаров (фронт цепи).
 655+ C491              ; Свопы цепочек парные → read-only по отношению к состоянию цепочек.
 656+ C491              ; ============================================================================
 657+ C491              VDC_WinSnapAllChains:
 658+ C491 CD B2 C4                     CALL VDC_SnapshotWinChain              ; chain1 (текущий трек активен)
 659+ C494 38 03                        JR   C, .c2                            ; нет видимых шаров → храним прошлый
 660+ C496 22 EF 6C                     LD   (VDC_WinHeadS1), HL
 661+ C499 3A E9 D4     .c2:            LD   A, (VDC_HasSecondChain)
 662+ C49C B7                           OR   A
 663+ C49D C8                           RET  Z
 664+ C49E CD 4C C2                     CALL VDC_SwapChains
 665+ C4A1 CD 2E 5F                     CALL SetSecondTrackPage
 666+ C4A4 CD B2 C4                     CALL VDC_SnapshotWinChain              ; chain2
 667+ C4A7 38 03                        JR   C, .c2_keep
 668+ C4A9 22 F1 6C                     LD   (VDC_WinHeadS2), HL               ; запись в резидент — до возврата цепочки
 669+ C4AC CD 4C C2     .c2_keep:       CALL VDC_SwapChains
 670+ C4AF C3 1C 5F                     JP   SetCurrentTrackPage
