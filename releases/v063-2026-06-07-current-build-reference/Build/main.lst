  74+ C409
  75+ C409              ; ---------------------------------------------------------------------
  76+ C409              ; ZiFi_Init — bring up SD driver for a session of file I/O calls.
  77+ C409              ;   DI, slot 0 = #0F (driver page), DOS_SWP, DEV_INI, HDD, SETROOT.
  78+ C409              ; After Init, ZiFi entries at #2002..#2070 are directly callable.
  79+ C409              ;   CF=1 on success, CF=0 on init error. ZiFi_Done must still be called
  80+ C409              ;   after a successful init.
  81+ C409              ZiFi_Init:
  82+ C409 F3                           DI
  83+ C40A                              ; FT812 и SD на ОДНОЙ SPI-шине Z-Controller (рег #77). Перед началом
  84+ C40A                              ; SD-сессии ЯВНО снимаем CS FT812 (#77 = SPI_FT_CS_OFF = #03), иначе,
  85+ C40A                              ; если перед этим по шине работал FT812 (boot loading screen), он
  86+ C40A                              ; остаётся владельцем шины и первое SD-обращение срывается.
  87+ C40A 01 77 00                     LD   BC, #0077
  88+ C40D 3E 03                        LD   A, #03
  89+ C40F ED 79                        OUT  (C), A
  90+ C411 01 57 00                     LD   BC, #0057
  91+ C414 3E FF                        LD   A, #FF
  92+ C416 ED 79                        OUT  (C), A
  93+ C418 3E 00                        LD   A,  TSLibPage
  94+ C41A                              SetPage0_A
  94+ C41A             >                ifdef MAPPING_REGISTERS
  94+ C41A 32 10 04    >                LD (FMADDR_REGS + HIGH PAGE0), A
  94+ C41D             >                else
  94+ C41D ~           >                LD (MemoryPages + 0), A
  94+ C41D ~           >                LD BC, PAGE0
  94+ C41D ~           >                OUT (C), A
  94+ C41D             >                endif
  95+ C41D CD D9 C2                     CALL sd_init
  96+ C420 37                           SCF
  97+ C421 C9                           RET
  98+ C422 B7           .Err:           OR   A
  99+ C423 C9                           RET
 100+ C424
 101+ C424              ; ZiFi_Done — restore TSLib in slot 0, EI.
 102+ C424              ZiFi_Done:
 103+ C424 01 77 00                     LD   BC, #0077
 104+ C427 3E 03                        LD   A, #03
 105+ C429 ED 79                        OUT  (C), A
 106+ C42B 01 57 00                     LD   BC, #0057
 107+ C42E 3E FF                        LD   A, #FF
 108+ C430 ED 79                        OUT  (C), A
 109+ C432 3E 00                        LD   A,  TSLibPage
 110+ C434                              SetPage0_A
 110+ C434             >                ifdef MAPPING_REGISTERS
 110+ C434 32 10 04    >                LD (FMADDR_REGS + HIGH PAGE0), A
