4565  6C70                              include "loader_resident.asm"         ; resident bits of the PAK loader (VDC_ReadSampleAtHL, cross-load vars, overlay trampolines)
# file opened: Source\ASM\loader_resident.asm
   1+ 6C70              ; loader_resident.asm — the parts of the PAK loader that MUST stay resident in
   2+ 6C70              ; Core (slot 1), because they are reached while the loader overlay page is NOT
   3+ 6C70              ; mapped:
   4+ 6C70              ;   * VDC_ReadSampleAtHL — called per-frame from VDC_SlotPos (Main1) during play;
   5+ 6C70              ;   * adventure cross-load vars (FadeAlpha / CurrentDifficulty / CurrentLevel),
   6+ 6C70              ;     read by gameplay/menu/level-select code at any time;
   7+ 6C70              ;   * the overlay trampolines — the named entry points callers use; each maps the
   8+ 6C70              ;     loader page into slot 3, calls the real OVL_* routine, then restores #04.
   9+ 6C70              ;
  10+ 6C70              ; The bulk of the loader (sd_zc + RawPak_* + ZiFi_* + OVL_LoadGameplay... +
  11+ 6C70              ; OVL_LoadLevelSelectPreviewAssets) lives in ts-dos.asm, assembled into its own
  12+ 6C70              ; SLOT 3 / PAGE #40 overlay region (see main.asm). It is dormant outside loads —
  13+ 6C70              ; "load a level, then sleep" — so it no longer costs resident Core space.
  14+ 6C70
  15+ 6C70              LOADER_OVL_PAGE    EQU #40            ; SPG page holding the loader overlay (mapped into slot 3 during loads)
  16+ 6C70              GS_PORT_DATA       EQU #00B3
  17+ 6C70              GS_PORT_CMD        EQU #00BB
  18+ 6C70              GS_CMD_PLAY_MODULE EQU #31
  19+ 6C70              GS_CMD_STOP_MODULE EQU #32
  20+ 6C70              GS_CMD_PLAY_FX     EQU #98
  21+ 6C70              GS_SFX_NOTE        EQU 53            ; 11025 Hz payload at GS C-2-ish base (#30) needs about +5 semitones.
  22+ 6C70              GS_WAIT_TIMEOUT    EQU #FFFF
  23+ 6C70                                                    ; UI_OVL_PAGE (#41) is defined globally in main.asm (needed before
  24+ 6C70                                                    ; module Core by the Fade* transitions); referenced here for the trampoline.
  25+ 6C70
  26+ 6C70              ; Track chunkB page: tracks longer than one 16K page (>2730 samples) are split on
  27+ 6C70              ; a sample boundary. The active track pages are resident variables because the
  28+ 6C70              ; two-curve boards reuse the same reader for the second path.
  29+ 6C70              TRACK_PAGE2        EQU #0F
  30+ 6C70              TRACK_SPLIT_SAMPLE EQU 2730        ; (16384-2)/6, first sample stored in TRACK_PAGE2
  31+ 6C70
  32+ 6C70              ; ----------------------------------------------------------------------------
  33+ 6C70              ; VDC_ReadSampleAtHL — read track sample [HL] -> BC=X, DE=Y; set VDC_LastT,
  34+ 6C70              ; VDC_LastTangent and VDC_LastTrackFlags; CF=0. Core-resident (called as a tail-jump from VDC_SlotPos
  35+ 6C70              ; in Main1, which is nearly full). Handles the 2-page track split: samples below
  36+ 6C70              ; TRACK_SPLIT_SAMPLE sit on VDC_ActiveTrackPage1 at #8000+2+t*6; samples at/above
  37+ 6C70              ; live on VDC_ActiveTrackPage2 at #8000+(t-split)*6 (chunkB has no count header).
  38+ 6C70              ; Leaves slot 2 mapped to VDC_ActiveTrackPage1. Clobbers AF, HL.
  39+ 6C70              ; ----------------------------------------------------------------------------
  40+ 6C70              VDC_ReadSampleAtHL:
  41+ 6C70 22 E7 D4                     LD   (VDC_LastT), HL                   ; expose t
  42+ 6C73 11 AA 0A                     LD   DE, TRACK_SPLIT_SAMPLE
  43+ 6C76 A7                           AND  A
  44+ 6C77 ED 52                        SBC  HL, DE                            ; HL = t - split; CF=1 if t<split
  45+ 6C79 38 2C                        JR   C, .p1
  46+ 6C7B                              ; --- page2 (#0F): HL = t2 = t - split ---
  47+ 6C7B 54                           LD   D, H
  47+ 6C7C 5D             LD E, L
  48+ 6C7D 29                           ADD  HL, HL                            ; t2*2
  49+ 6C7E 19                           ADD  HL, DE                            ; t2*3
  50+ 6C7F 29                           ADD  HL, HL                            ; t2*6
  51+ 6C80 11 00 80                     LD   DE, #8000
  52+ 6C83 19                           ADD  HL, DE                            ; #8000 + t2*6
  53+ 6C84 3A CF 6C                     LD   A, (VDC_ActiveTrackPage2)
  54+ 6C87                              SetPage2_A                             ; map #0F (clobbers A, BC)
  54+ 6C87             >                ifdef MAPPING_REGISTERS
  54+ 6C87 32 12 04    >                LD (FMADDR_REGS + HIGH PAGE2), A
  54+ 6C8A             >                else
  54+ 6C8A ~           >                LD (MemoryPages + 2), A
  54+ 6C8A ~           >                LD BC, PAGE2
  54+ 6C8A ~           >                OUT (C), A
  54+ 6C8A             >                endif
  55+ 6C8A 5E                           LD   E, (HL)
  55+ 6C8B 23             INC HL
  56+ 6C8C 56                           LD   D, (HL)
  56+ 6C8D 23             INC HL                  ; DE = X
  57+ 6C8E 4E                           LD   C, (HL)
  57+ 6C8F 23             INC HL
  58+ 6C90 46                           LD   B, (HL)
  58+ 6C91 23             INC HL                  ; BC = Y
  59+ 6C92 7E                           LD   A, (HL)
  60+ 6C93 32 E5 D4                     LD   (VDC_LastTangent), A
  60+ 6C96 23             INC HL
  61+ 6C97 7E                           LD   A, (HL)
  62+ 6C98 32 E6 D4                     LD   (VDC_LastTrackFlags), A
  63+ 6C9B C5                           PUSH BC
  63+ 6C9C D5             PUSH DE                      ; save Y, X across page restore
  64+ 6C9D 3A CE 6C                     LD   A, (VDC_ActiveTrackPage1)
  65+ 6CA0                              SetPage2_A                             ; restore active track page for callers
  65+ 6CA0             >                ifdef MAPPING_REGISTERS
  65+ 6CA0 32 12 04    >                LD (FMADDR_REGS + HIGH PAGE2), A
  65+ 6CA3             >                else
  65+ 6CA3 ~           >                LD (MemoryPages + 2), A
  65+ 6CA3 ~           >                LD BC, PAGE2
  65+ 6CA3 ~           >                OUT (C), A
  65+ 6CA3             >                endif
  66+ 6CA3 D1                           POP  DE
  66+ 6CA4 C1             POP  BC                      ; DE = X, BC = Y
  67+ 6CA5 18 1D                        JR   .rearr
  68+ 6CA7              .p1:            ; --- page1 (#06, already mapped): addr = #8000 + 2 + t*6 ---
  69+ 6CA7 2A E7 D4                     LD   HL, (VDC_LastT)
  70+ 6CAA 54                           LD   D, H
  70+ 6CAB 5D             LD E, L
  71+ 6CAC 29                           ADD  HL, HL                            ; t*2
  72+ 6CAD 19                           ADD  HL, DE                            ; t*3
  73+ 6CAE 29                           ADD  HL, HL                            ; t*6
  74+ 6CAF 11 02 80                     LD   DE, TrackData + 2
  75+ 6CB2 19                           ADD  HL, DE
  76+ 6CB3 5E                           LD   E, (HL)
  76+ 6CB4 23             INC HL
