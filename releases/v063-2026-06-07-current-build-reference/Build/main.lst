1121+ CBF3 32 24 CE                     LD   (RawPak_CurSecInClus), A
1122+ CBF6 CD 28 CB                     CALL RawPak_CurrentLbaRegs      ; HL:DE = абсолютный LBA первого сектора
1123+ CBF9 22 77 6F                     LD   (Boot_StartLba + 0), HL
1124+ CBFC ED 53 79 6F                  LD   (Boot_StartLba + 2), DE
1125+ CC00 CD 8C CB                     CALL RawPak_ReadSectorBuffer    ; → #8000 (slot2), IX=#8000 (клобает HL:DE)
