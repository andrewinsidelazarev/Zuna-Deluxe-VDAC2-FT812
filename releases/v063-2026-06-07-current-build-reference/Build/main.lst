 178+ C48F
 179+ C48F              ; (Diagnostic vars ZiFi_GpDbgStep / ZiFi_DbgGamesA / ... moved to
 180+ C48F              ;  loader_resident.asm so an F12 dump — which sees slot 1 / Core, not this
 181+ C48F              ;  overlay page — can read how far the load got. The overlay writes them while
 182+ C48F              ;  slot 1 is mapped, so the writes still land.)
 183+ C48F
 184+ C48F              ; ---------------------------------------------------------------------
 185+ C48F              ; Loader-level helpers.
 186+ C48F              ;
 187+ C48F              ; ZUMALVL.PAK layout:
 188+ C48F              ;   sec 0       header  (magic ZLVP, version, count, sector_size)
 189+ C48F              ;   sec 1       TOC[22] × 20 B   (bg/pal/track/title/preview off+size)
 190+ C48F              ;   sec 2..N    data blob, per-level: bg → pal → track → title → preview
 191+ C48F
 192+ C48F              ZIFI_BUFFER_PAGE EQU #03               ; spgbld page reserved for ZiFi 512-B buffer
 193+ C48F
 194+ C48F              ; ---------------------------------------------------------------------
 195+ C48F              ; RawPak_* — self-contained FAT32 reader over direct SD CMD18.
 196+ C48F              ;
 197+ C48F              ; This path intentionally bypasses the bundled WC CORE32 LOAD512 state. It
 198+ C48F              ; supports both contiguous and fragmented files by following the FAT chain
 199+ C48F              ; between every cluster. Current host image is superfloppy FAT32 with
 200+ C48F              ; 512-byte sectors and spc=1; we validate that in RawPak_OpenRoot.
 201+ C48F              ;
 202+ C48F              ; Directory/file lookup matches by NAME, case-insensitive: it reconstructs the
 203+ C48F              ; LONG name (LFN) when present, else the 8.3 short name, and compares to these
 204+ C48F              ; targets. This is robust to whatever short alias the injector assigns (the
 205+ C48F              ; observed bug was injector writing GAMES~1 while we searched "GAMES      ").
 206+ C48F
 207+ C48F              RAWPAK_NAME_PAK:
 208+ C48F 5A 55 4D 41                  DEFB "ZUMALVL.PAK", 0
 208+ C493 4C 56 4C 2E
 208+ C497 50 41 4B 00
 209+ C49B              RAWPAK_NAME_AUDIO:
 210+ C49B 5A 55 4D 41                  DEFB "ZUMAAUD.PAK", 0
 210+ C49F 41 55 44 2E
 210+ C4A3 50 41 4B 00
 211+ C4A7              RAWPAK_NAME_SOUND:
 212+ C4A7 5A 55 4D 41                  DEFB "ZUMASND.PAK", 0
 212+ C4AB 53 4E 44 2E
 212+ C4AF 50 41 4B 00
 213+ C4B3              RAWPAK_NAME_MAIN:
 214+ C4B3 5A 55 4D 41                  DEFB "ZUMAMAIN.PAK", 0
 214+ C4B7 4D 41 49 4E
 214+ C4BB 2E 50 41 4B
 214+ C4BF 00
 215+ C4C0              RAWPAK_NAME_BOOT:                               ; HOBETA WC loader в корне SD (для Quit)
 216+ C4C0 42 4F 4F 54                  DEFB "BOOT.$C", 0
 216+ C4C4 2E 24 43 00
 217+ C4C8              RAWPAK_BOOT_SIZE EQU 31761
 218+ C4C8
 219+ C4C8              ; DBG instrumentation (read in F12 dump to bisect a failed open; addresses are
 220+ C4C8              ; resident in loader_resident.asm — ZiFi_DbgGamesA #6432, GpDbgStep #642D):
 221+ C4C8              ;   ZiFi_DbgGamesA = RawPak open granular step:
 222+ C4C8              ;       #20 entry, #21 sector0 read OK, #22 BPB valid, #26 search start, #25 PAK found;
 223+ C4C8              ;       #A1 sector0 CMD err, #A2 BPB invalid (bps!=512 / no FAT32 partition),
 224+ C4C8              ;       #A3 spc=0, #A6 PAK (name+size) not found anywhere, #A7 run-table overflow.
 225+ C4C8              ;   ZiFi_DbgGamesFound = directories visited during the recursive search.
 226+ C4C8              RawPak_OpenRoot:
 227+ C4C8 3E 20                        LD   A, #20
 228+ C4CA 32 A4 6D                     LD   (ZiFi_DbgGamesA), A
 229+ C4CD AF                           XOR  A
 230+ C4CE 32 A5 6D                     LD   (ZiFi_DbgGamesFound), A
 231+ C4D1                              ; Invalidate the FAT-sector cache (FatBufLba = #FFFFFFFF). The cache
 232+ C4D1                              ; in RawPak_FatNext skips re-reading a FAT sector already in FatBuf;
 233+ C4D1                              ; the FAT is read-only for us, so it stays valid for the whole session.
 234+ C4D1 21 FF FF                     LD   HL, #FFFF
 235+ C4D4 22 CB D0                     LD   (RawPak_FatBufLba + 0), HL
 236+ C4D7 22 CD D0                     LD   (RawPak_FatBufLba + 2), HL
 237+ C4DA                              ; --- Read sector 0 (boot sector OR MBR). LBA 0 is addressing-
 238+ C4DA                              ; agnostic (arg 0 either way), so this read works before we know
 239+ C4DA                              ; block vs byte. Then mirror ChkDsk: scan the MBR partition table;
 240+ C4DA                              ; a real card is MBR-partitioned + SDHC (block-addressed), Unreal is
 241+ C4DA                              ; a superfloppy (no table) + byte-addressed.
 242+ C4DA 21 00 00                     LD   HL, 0
 243+ C4DD 11 00 00                     LD   DE, 0
 244+ C4E0 CD 8C CB                     CALL RawPak_ReadSectorBuffer
 245+ C4E3 DA 66 C6                     JP   C, .ErrBpbRead
 246+ C4E6 3E 21                        LD   A, #21
 247+ C4E8 32 A4 6D                     LD   (ZiFi_DbgGamesA), A
 248+ C4EB AF                           XOR  A                          ; part_lba = 0 (superfloppy: sector 0 is the BPB)
 249+ C4EC 32 AF CE                     LD   (RawPak_PartLba + 0), A
 250+ C4EF 32 B0 CE                     LD   (RawPak_PartLba + 1), A
 251+ C4F2 32 B1 CE                     LD   (RawPak_PartLba + 2), A
 252+ C4F5 32 B2 CE                     LD   (RawPak_PartLba + 3), A
 253+ C4F8                              ; Is sector 0 itself a FAT32 BPB (bytes/sector == 512)? Then this is
 254+ C4F8                              ; a superfloppy (Unreal) -> use sector 0 as BPB, byte addressing.
 255+ C4F8                              ; Otherwise it is an MBR -> scan the partition table. (Checking the
 256+ C4F8                              ; BPB first avoids false-matching boot-code bytes at offset 446.)
 257+ C4F8 DD 21 00 80                  LD   IX, #8000
 258+ C4FC DD 7E 0B                     LD   A, (IX + 11)
 259+ C4FF B7                           OR   A
 260+ C500 20 07                        JR   NZ, .tryMbr
 261+ C502 DD 7E 0C                     LD   A, (IX + 12)
 262+ C505 FE 02                        CP   2
 263+ C507 28 3E                        JR   Z, .bpbReady               ; sector 0 is a 512-B/sector BPB -> superfloppy
 264+ C509 DD 21 BE 81  .tryMbr:       LD   IX, #8000 + 446            ; MBR partition table: 4 entries x 16 B
 265+ C50D 06 04                        LD   B, 4
 266+ C50F DD 7E 04     .mbrScan:      LD   A, (IX + 4)                 ; partition type
 267+ C512 FE 0B                        CP   #0B                         ; FAT32 (CHS)
 268+ C514 28 0E                        JR   Z, .havePart
 269+ C516 FE 0C                        CP   #0C                         ; FAT32 (LBA)
 270+ C518 28 0A                        JR   Z, .havePart
 271+ C51A 11 10 00                     LD   DE, 16
 272+ C51D DD 19                        ADD  IX, DE
 273+ C51F 10 EE                        DJNZ .mbrScan
 274+ C521 C3 6A C6                     JP   .ErrBps                    ; not a BPB and no FAT32 partition entry
 275+ C524 DD 7E 08     .havePart:     LD   A, (IX + 8)
 275+ C527 32 AF CE       LD (RawPak_PartLba + 0), A   ; partition start LBA
 276+ C52A DD 7E 09                     LD   A, (IX + 9)
 276+ C52D 32 B0 CE       LD (RawPak_PartLba + 1), A
 277+ C530 DD 7E 0A                     LD   A, (IX + 10)
 277+ C533 32 B1 CE       LD (RawPak_PartLba + 2), A
 278+ C536 DD 7E 0B                     LD   A, (IX + 11)
 278+ C539 32 B2 CE       LD (RawPak_PartLba + 3), A
 279+ C53C                              ; Найден MBR-раздел => это реальная SDHC-карта => блочная адресация
 280+ C53C                              ; АВТОРИТЕТНА. НЕ откатываемся на байтовую: байтовый режим на SDHC шлёт
 281+ C53C                              ; неверные адреса блоков и может вывести карту из строя (восстановление
 282+ C53C                              ; только физическим переткиванием). Откат на byte допустим лишь для
 283+ C53C                              ; настоящего superfloppy (там ветка .bpbReady достигается напрямую с
 284+ C53C                              ; sd_blkt=0). Раньше тут был откат на byte — он и кирпичил 32 ГБ карту.
 285+ C53C 3E 01                        LD   A, 1
 286+ C53E 32 04 C4                     LD   (sd_blkt), A
 287+ C541 CD 2A CC                     CALL RawPak_ReadPartBpb
 288+ C544 DA 6A C6                     JP   C, .ErrBps
 289+ C547 DD 21 00 80  .bpbReady:     LD   IX, #8000
 290+ C54B                              ; Require 512-byte sectors and a non-zero sectors/cluster value.
 291+ C54B DD 7E 0B                     LD   A, (IX + 11)
 292+ C54E B7                           OR   A
 293+ C54F C2 6A C6                     JP   NZ, .ErrBps
 294+ C552 DD 7E 0C                     LD   A, (IX + 12)
 295+ C555 FE 02                        CP   2
 296+ C557 C2 6A C6                     JP   NZ, .ErrBps
 297+ C55A DD 7E 0D                     LD   A, (IX + 13)
 298+ C55D B7                           OR   A
 299+ C55E CA 6E C6                     JP   Z, .ErrSpc
 300+ C561 32 23 CE                     LD   (RawPak_Spc), A
 301+ C564 3E 22                        LD   A, #22
 302+ C566 32 A4 6D                     LD   (ZiFi_DbgGamesA), A
 303+ C569                              ; fatstart = part_lba + reserved sectors (16-bit in BPB)
 304+ C569 21 AF CE                     LD   HL, RawPak_PartLba
 305+ C56C 11 B3 CE                     LD   DE, RawPak_FatStart
 306+ C56F CD FF CD                     CALL RawPak_Copy32
 307+ C572 DD 7E 0E                     LD   A, (IX + 14)
 307+ C575 32 C7 CE       LD (RawPak_Tmp + 0), A
 308+ C578 DD 7E 0F                     LD   A, (IX + 15)
 308+ C57B 32 C8 CE       LD (RawPak_Tmp + 1), A
 309+ C57E AF                           XOR  A
 309+ C57F 32 C9 CE       LD (RawPak_Tmp + 2), A
 309+ C582 32 CA CE       LD (RawPak_Tmp + 3), A
 310+ C585 21 C7 CE                     LD   HL, RawPak_Tmp
 311+ C588 11 B3 CE                     LD   DE, RawPak_FatStart
 312+ C58B CD 07 CE                     CALL RawPak_Add32
 313+ C58E                              ; datastart = fatstart + numFATs * FATSz32
 314+ C58E 21 B3 CE                     LD   HL, RawPak_FatStart
 315+ C591 11 B7 CE                     LD   DE, RawPak_DataStart
 316+ C594 CD FF CD                     CALL RawPak_Copy32
 317+ C597 DD 7E 10                     LD   A, (IX + 16)
 318+ C59A 47                           LD   B, A
 319+ C59B C5           .fatLoop:      PUSH BC
 320+ C59C DD 7E 24                     LD   A, (IX + 36)
 320+ C59F 32 C7 CE       LD (RawPak_Tmp + 0), A
 321+ C5A2 DD 7E 25                     LD   A, (IX + 37)
 321+ C5A5 32 C8 CE       LD (RawPak_Tmp + 1), A
 322+ C5A8 DD 7E 26                     LD   A, (IX + 38)
 322+ C5AB 32 C9 CE       LD (RawPak_Tmp + 2), A
 323+ C5AE DD 7E 27                     LD   A, (IX + 39)
 323+ C5B1 32 CA CE       LD (RawPak_Tmp + 3), A
 324+ C5B4 21 C7 CE                     LD   HL, RawPak_Tmp
 325+ C5B7 11 B7 CE                     LD   DE, RawPak_DataStart
 326+ C5BA CD 07 CE                     CALL RawPak_Add32
 327+ C5BD C1                           POP  BC
 328+ C5BE 10 DB                        DJNZ .fatLoop
 329+ C5C0                              ; root cluster
 330+ C5C0 DD 7E 2C                     LD   A, (IX + 44)
 330+ C5C3 32 BB CE       LD (RawPak_RootClus + 0), A
 331+ C5C6 DD 7E 2D                     LD   A, (IX + 45)
 331+ C5C9 32 BC CE       LD (RawPak_RootClus + 1), A
 332+ C5CC DD 7E 2E                     LD   A, (IX + 46)
 332+ C5CF 32 BD CE       LD (RawPak_RootClus + 2), A
 333+ C5D2 DD 7E 2F                     LD   A, (IX + 47)
 333+ C5D5 32 BE CE       LD (RawPak_RootClus + 3), A
 334+ C5D8                              ; --- граница тома для защиты SD: sd_lba_max = PartLba + BPB_TotSec32.
 335+ C5D8                              ; Любой LBA >= границы отбивается в sd_read_sector (CF=1), не уходя в
 336+ C5D8                              ; карту как CMD17. 0 = выключено (если TotSec32 почему-то нулевой).
 337+ C5D8 AF                           XOR  A
 338+ C5D9 32 05 C4                     LD   (sd_lba_max + 0), A
 339+ C5DC 32 06 C4                     LD   (sd_lba_max + 1), A
 340+ C5DF 32 07 C4                     LD   (sd_lba_max + 2), A
 341+ C5E2 32 08 C4                     LD   (sd_lba_max + 3), A
 342+ C5E5 DD 7E 20                     LD   A, (IX + 32)
 342+ C5E8 32 C7 CE       LD (RawPak_Tmp + 0), A
 342+ C5EB 4F             LD C, A
 343+ C5EC DD 7E 21                     LD   A, (IX + 33)
 343+ C5EF 32 C8 CE       LD (RawPak_Tmp + 1), A
 343+ C5F2 B1             OR C
 343+ C5F3 4F             LD C, A
 344+ C5F4 DD 7E 22                     LD   A, (IX + 34)
 344+ C5F7 32 C9 CE       LD (RawPak_Tmp + 2), A
 344+ C5FA B1             OR C
 344+ C5FB 4F             LD C, A
 345+ C5FC DD 7E 23                     LD   A, (IX + 35)
 345+ C5FF 32 CA CE       LD (RawPak_Tmp + 3), A
 345+ C602 B1             OR C
 346+ C603 28 12                        JR   Z, .noVolGuard                     ; TotSec32==0 -> защиту не включаем
 347+ C605 21 AF CE                     LD   HL, RawPak_PartLba
 348+ C608 11 05 C4                     LD   DE, sd_lba_max
 349+ C60B CD FF CD                     CALL RawPak_Copy32                      ; sd_lba_max = PartLba
 350+ C60E 21 C7 CE                     LD   HL, RawPak_Tmp
 351+ C611 11 05 C4                     LD   DE, sd_lba_max
 352+ C614 CD 07 CE                     CALL RawPak_Add32                       ; sd_lba_max += TotSec32
 353+ C617              .noVolGuard:
 354+ C617                              ; --- locate ZUMALVL.PAK. Fast path: reuse WC's active-panel
 355+ C617                              ; path from page #F7, then fall back to a whole-card DFS.
 356+ C617 3E 26                        LD   A, #26
 357+ C619 32 A4 6D                     LD   (ZiFi_DbgGamesA), A
 358+ C61C 3A 5A D5                     LD   A, (RawPak_CachedValid)   ; reuse the location found earlier this session
 359+ C61F B7                           OR   A
 360+ C620 28 0B                        JR   Z, .search
 361+ C622 21 5B D5                     LD   HL, RawPak_CachedPakClus
 362+ C625 11 BF CE                     LD   DE, RawPak_FileStartClus
 363+ C628 CD FF CD                     CALL RawPak_Copy32
 364+ C62B 18 25                        JR   .haveFile
 365+ C62D CD 73 C7     .search:       CALL RawPak_TryWcPath
 366+ C630 38 0F                        JR   C, .cacheFound
 367+ C632                              IF RAWPAK_WC_PATH_ONLY
 368+ C632 ~                            JP   .ErrPak
 369+ C632                              ENDIF
 370+ C632 21 BB CE                     LD   HL, RawPak_RootClus
 371+ C635 11 C3 CE                     LD   DE, RawPak_CurClus
 372+ C638 CD FF CD                     CALL RawPak_Copy32
 373+ C63B CD 79 C6                     CALL RawPak_FindPakRecursive   ; DFS whole tree -> RawPak_FileStartClus
 374+ C63E D2 72 C6                     JP   NC, .ErrPak
 375+ C641              .cacheFound:
 376+ C641 21 BF CE                     LD   HL, RawPak_FileStartClus  ; cache for subsequent opens this session
 377+ C644 11 5B D5                     LD   DE, RawPak_CachedPakClus
 378+ C647 CD FF CD                     CALL RawPak_Copy32
 379+ C64A 3E 01                        LD   A, 1
 380+ C64C 32 5A D5                     LD   (RawPak_CachedValid), A
 381+ C64F 32 4D 6F                     LD   (LevelsMapLoaded), A      ; resident flag: skip "LOADING LEVELS..." next time
 382+ C652 3E 25        .haveFile:     LD   A, #25
 383+ C654 32 A4 6D                     LD   (ZiFi_DbgGamesA), A
 384+ C657 CD 10 CA                     CALL RawPak_Seek0
 385+ C65A CD 51 CC                     CALL RawPak_BuildRunTable      ; build extent (run) table — handles fragmentation
 386+ C65D D2 62 C6                     JP   NC, .ErrRuns              ; table overflow / chain error -> fallback
 387+ C660 37                           SCF
 388+ C661 C9                           RET
 389+ C662 3E A7        .ErrRuns:      LD   A, #A7
 390+ C664 18 0E                        JR   .ErrSet
 391+ C666 3E A1        .ErrBpbRead:   LD   A, #A1
 392+ C668 18 0A                        JR   .ErrSet
 393+ C66A 3E A2        .ErrBps:       LD   A, #A2
 394+ C66C 18 06                        JR   .ErrSet
 395+ C66E 3E A3        .ErrSpc:       LD   A, #A3
 396+ C670 18 02                        JR   .ErrSet
 397+ C672 3E A6        .ErrPak:       LD   A, #A6                     ; ZUMALVL.PAK (name+size) not found anywhere
 398+ C674 32 A4 6D     .ErrSet:       LD   (ZiFi_DbgGamesA), A
 399+ C677 B7           .Err:          OR   A
 400+ C678 C9                           RET
 401+ C679
 402+ C679              ; (RawPak_FindInCurrentDir and the fixed /Games/Zuma Deluxe VDAC2/ path were
 403+ C679              ;  removed — the loader now finds ZUMALVL.PAK only via RawPak_FindPakRecursive,
 404+ C679              ;  by name + size in any folder. Single code path.)
 405+ C679
 406+ C679              ; ============================================================================
 407+ C679              ; RawPak_FindPakRecursive — depth-first search of the WHOLE FAT32 tree from the
 408+ C679              ; root for a file named "ZUMALVL.PAK" whose size == EXPECTED_PAK_SIZE. Lets the
 409+ C679              ; pack live in any folder (a real card may not use /Games/Zuma Deluxe VDAC2/).
 410+ C679              ; Out: CF=1 found (RawPak_FileStartClus set); CF=0 not found / SD error.
 411+ C679              ; Reads EVERY sector of each directory cluster (via AdvanceOne), so it is correct
 412+ C679              ; for spc>1 cards (the old per-cluster-first-sector scan missed entries at spc=64).
 413+ C679              ; Result is cached by the caller, so the (potentially slow) walk runs once/session.
 414+ C679              ; ============================================================================
 415+ C679              RawPak_FindPakRecursive:
 416+ C679 21 8F C4                     LD   HL, RAWPAK_NAME_PAK        ; target = "ZUMALVL.PAK" uppercased
 417+ C67C 11 29 CE                     LD   DE, RawPak_TargetName
 418+ C67F 7E           .cpyt:         LD   A, (HL)
 419+ C680 CD 5B C9                     CALL RawPak_Upcase
 420+ C683 12                           LD   (DE), A
 421+ C684 23                           INC  HL
 422+ C685 13                           INC  DE
 423+ C686 B7                           OR   A
 424+ C687 20 F6                        JR   NZ, .cpyt
 425+ C689 3E 01                        LD   A, 1
 426+ C68B 32 A9 CE                     LD   (RawPak_CheckSize), A      ; PAK: совпадение по имени И точному размеру
 427+ C68E              ; RawPak_FindByName — DFS дерева FAT по RawPak_TargetName (+опц. размер). Вызывающий
 428+ C68E              ; заранее ставит RawPak_TargetName (upcase, zero-term) и RawPak_CheckSize (0=только имя,
 429+ C68E              ; 1=имя+EXPECTED_PAK_SIZE). Out: CF=1 найдено (RawPak_FileStartClus + RawPak_FoundSize),
 430+ C68E              ; CF=0 нет/ошибка SD.
 431+ C68E              RawPak_FindByName:
 432+ C68E AF                           XOR  A
 433+ C68F 32 D9 D3                     LD   (RawPak_DirStackCnt), A
 434+ C692 32 A5 6D                     LD   (ZiFi_DbgGamesFound), A
 435+ C695 21 BB CE                     LD   HL, RawPak_RootClus        ; seed the DFS stack with the root dir
 436+ C698 CD 1D C9                     CALL RawPak_DirStackPush
 437+ C69B CD 3C C9     .popLoop:      CALL RawPak_DirStackPop         ; CurClus = next dir; CF=1 if stack empty
 438+ C69E DA 71 C7                     JP   C, .notFound
 439+ C6A1 3A A5 6D                     LD   A, (ZiFi_DbgGamesFound)    ; diag: count dirs visited
 440+ C6A4 3C                           INC  A
 441+ C6A5 32 A5 6D                     LD   (ZiFi_DbgGamesFound), A
 442+ C6A8 AF                           XOR  A
 443+ C6A9 32 24 CE                     LD   (RawPak_CurSecInClus), A
