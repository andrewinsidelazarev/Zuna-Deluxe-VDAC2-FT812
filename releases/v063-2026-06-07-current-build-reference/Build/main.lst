1736+ FBB6              ; ----------------------------------------------------------------------------
1737+ FBB6              ; FT812 frame profiler (diagnostic overlay).
1738+ FBB6              ; B/W/I are REG_CLOCK delta / 1024. At 60 MHz FT812 clock:
1739+ FBB6              ;   74 Hz frame ~= 792, 57 Hz frame ~= 1028.
1740+ FBB6              ; If B+W approaches frame budget and I is near zero, Z80/SPI path misses vblank.
1741+ FBB6              ; ----------------------------------------------------------------------------
1742+ FBB6              ZL_ProfileReadClock:
1743+ FBB6                              FT_RD_REG32 FT_REG_CLOCK                ; BCDE = 32-bit little-endian value
1743+ FBB6 3E 30       >                LD A, (FT_RAM_REG >> 16) & 0xFF
1743+ FBB8 11 08 20    >                LD DE, (FT_REG_CLOCK) & 0xFFFF
1743+ FBBB CD D9 11    >                CALL FT.Read32
1744+ FBBE 60                           LD   H, B
1745+ FBBF 69                           LD   L, C
1746+ FBC0 C9                           RET                                     ; HLDE = clock
1747+ FBC1
1748+ FBC1              ; In: HLDE=end clock, IXBC=start clock. Out: HL=(delta >> 10), DE=end lo, IX=end hi.
1749+ FBC1              ZL_ProfileDeltaK:
1750+ FBC1 ED 53 8A F8                  LD   (ZL_ProfileDeltaEndLo), DE
1751+ FBC5 22 8C F8                     LD   (ZL_ProfileDeltaEndHi), HL
1752+ FBC8 EB                           EX   DE, HL                             ; HL=end low, DE=end high
1753+ FBC9 A7                           AND  A
1754+ FBCA ED 42                        SBC  HL, BC                             ; HL=delta low
1755+ FBCC EB                           EX   DE, HL                             ; DE=delta low, HL=end high
1756+ FBCD DD E5                        PUSH IX
1757+ FBCF C1                           POP  BC                                 ; BC=start high
1758+ FBD0 ED 42                        SBC  HL, BC                             ; HL=delta high
1759+ FBD2                              ; Convert 32-bit delta HL:DE to 16-bit delta/1024.
1760+ FBD2                              ; result bits: low=(D>>2)|(L<<6), high=(L>>2)|((H&3)<<6)
1761+ FBD2 7A                           LD   A, D
1762+ FBD3 CB 3F                        SRL  A
1763+ FBD5 CB 3F                        SRL  A
1764+ FBD7 4F                           LD   C, A
1765+ FBD8 7D                           LD   A, L
1766+ FBD9 87                           ADD  A, A
1767+ FBDA 87                           ADD  A, A
1768+ FBDB 87                           ADD  A, A
1769+ FBDC 87                           ADD  A, A
1770+ FBDD 87                           ADD  A, A
1771+ FBDE 87                           ADD  A, A
1772+ FBDF B1                           OR   C
1773+ FBE0 5F                           LD   E, A                               ; result low byte temp
1774+ FBE1 7D                           LD   A, L
1775+ FBE2 CB 3F                        SRL  A
1776+ FBE4 CB 3F                        SRL  A
1777+ FBE6 47                           LD   B, A
1778+ FBE7 7C                           LD   A, H
1779+ FBE8 E6 03                        AND  3
1780+ FBEA 0F                           RRCA
1781+ FBEB 0F                           RRCA
1782+ FBEC B0                           OR   B
1783+ FBED 57                           LD   D, A                               ; result high byte temp
1784+ FBEE EB                           EX   DE, HL                             ; HL=result
1785+ FBEF ED 5B 8A F8                  LD   DE, (ZL_ProfileDeltaEndLo)
1786+ FBF3 DD 2A 8C F8                  LD   IX, (ZL_ProfileDeltaEndHi)
1787+ FBF7 C9                           RET
