1462+ F763              ; ZL_Mul16x8 — unsigned 16x8 multiply, low 16 bits of result.
1463+ F763              ;   In:  HL = multiplicand (unsigned 16-bit), A = multiplier (unsigned 8-bit)
1464+ F763              ;   Out: HL = (HL_in * A_in) & #FFFF
1465+ F763              ;   Scratch: BC, A, F. ~14 байт, ~155 t-states avg.
1466+ F763              ;   Используется для runtime K в spin formula (по 1 вызову на шар цепи).
