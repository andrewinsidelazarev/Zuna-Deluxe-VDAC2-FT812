2224  3A56              ; ============================================================================
2225  3A56              ; VDC_CheckKillzone — proximity-based skull animation.
2226  3A56              ; Каждый кадр вычисляет remaining_samples = (TrackNumSlots-HSA)*CS + KzEndSub-HSub.
2227  3A56              ;   rem > 2*CS (=64)  → KzFrame=1 (closed skull, idle)
2228  3A56              ;   rem in [1..64]    → KzFrame = 2 + ((64-rem) >> 3) ∈ [2..10] (opening)
2229  3A56              ;   rem <= 0          → trigger absorb (state=1, KzFrame=11)
2230  3A56              ; Rollback (match-3 cascade двигает HSA назад) → rem растёт → frame уменьшается
2231  3A56              ; обратно к 1 автоматически. Никаких отдельных rollback hook'ов.
2232  3A56              ; ============================================================================
2233  3A56              VDC_CheckKillzone:
2234  3A56 3A D2 6C                     LD   A, (Core.VDC_SlotsLen)
2235  3A59 B7                           OR   A
2236  3A5A C8                           RET  Z
2237  3A5B                              ; --- cells_to_go = TrackNumSlots - HSA ---
2238  3A5B 2A BA D4                     LD   HL, (Core.VDC_TrackNumSlots)      ; L = TNS low (TNS≈86 fits)
2239  3A5E 7D                           LD   A, L
2240  3A5F 21 B1 D4                     LD   HL, Core.VDC_HSA
2241  3A62 96                           SUB  (HL)                              ; A = TNS - HSA (signed-ish)
2242  3A63 28 1F                        JR   Z, .ck_eqcell                     ; equal cells
2243  3A65 38 4C                        JR   C, .ck_trigger                    ; HSA > TNS → past
2244  3A67                              ; --- HSA < TNS: rem = A*CS + KzEndSub - HSub ---
2245  3A67 26 00                        LD   H, 0
2246  3A69 6F                           LD   L, A
2247  3A6A 29                           ADD  HL, HL
2247  3A6B 29             ADD HL, HL
2247  3A6C 29             ADD HL, HL
2248  3A6D 29                           ADD  HL, HL
2248  3A6E 29             ADD HL, HL               ; HL = A * 32 (CELL_SIZE)
2249  3A6F 3A C1 D4                     LD   A, (Core.VDC_KzEndSub)
2250  3A72 57                           LD   D, A
2251  3A73 3A D1 6C                     LD   A, (Core.VDC_HSub)
2252  3A76 5F                           LD   E, A
2253  3A77 7A                           LD   A, D
2254  3A78 93                           SUB  E                                 ; A = KzEndSub - HSub (signed)
2255  3A79 5F                           LD   E, A
2256  3A7A 16 00                        LD   D, 0
2257  3A7C CB 7F                        BIT  7, A
2258  3A7E 28 01                        JR   Z, .ck_add_delta
2259  3A80 15                           DEC  D                                 ; sign-extend negative
2260  3A81 19           .ck_add_delta:  ADD  HL, DE                            ; HL = remaining samples
2261  3A82 18 10                        JR   .ck_set_frame
2262  3A84              .ck_eqcell:     ; HSA == TNS: rem = KzEndSub - HSub ∈ [1..CS-1] always opening range
2263  3A84 3A C1 D4                     LD   A, (Core.VDC_KzEndSub)
2264  3A87 57                           LD   D, A
2265  3A88 3A D1 6C                     LD   A, (Core.VDC_HSub)
2266  3A8B BA                           CP   D
2267  3A8C 30 25                        JR   NC, .ck_trigger                   ; HSub >= KzEndSub → past
2268  3A8E 5F                           LD   E, A                              ; HSub
2269  3A8F 7A                           LD   A, D
2270  3A90 93                           SUB  E                                 ; A = KzEndSub - HSub (1..CS-1)
2271  3A91 26 00                        LD   H, 0
2272  3A93 6F                           LD   L, A
2273  3A94              .ck_set_frame:  ; HL = remaining samples (positive)
2274  3A94 7C                           LD   A, H
2275  3A95 B7                           OR   A
2276  3A96 20 15                        JR   NZ, .ck_closed                    ; rem > 255 → > 64 → closed
2277  3A98 7D                           LD   A, L
2278  3A99 FE 41                        CP   65
2279  3A9B 30 10                        JR   NC, .ck_closed
2280  3A9D                              ; rem ∈ [1..64]: KzFrame = 2 + ((64 - rem) >> 3) ∈ [2..10]
2281  3A9D 47                           LD   B, A
2282  3A9E 3E 40                        LD   A, 64
2283  3AA0 90                           SUB  B
2284  3AA1 CB 3F                        SRL  A
2284  3AA3 CB 3F          SRL A
2284  3AA5 CB 3F          SRL A
2285  3AA7 C6 02                        ADD  A, 2
2286  3AA9 32 D3 6C                     LD   (Core.VDC_KzFrame), A
2287  3AAC C9                           RET
2288  3AAD 3E 01        .ck_closed:     LD   A, 1
2289  3AAF 32 D3 6C                     LD   (Core.VDC_KzFrame), A
2290  3AB2 C9                           RET
2291  3AB3 3E 01        .ck_trigger:    LD   A, 1
2292  3AB5 32 D0 6C                     LD   (Core.VDC_GameState), A
2293  3AB8 3E 0B                        LD   A, 11                             ; full-open at trigger (was 1; now 11 = wide-open mouth absorb)
2294  3ABA 32 D3 6C                     LD   (Core.VDC_KzFrame), A
2295  3ABD AF                           XOR  A
2296  3ABE 32 BC D4                     LD   (Core.VDC_GameOverTick), A
2297  3AC1 3E FF                        LD   A, 255
2298  3AC3 32 D4 6C                     LD   (Core.VDC_HeadAbsorbAlpha), A      ; head fade начинается с 255
2299  3AC6 C9                           RET
