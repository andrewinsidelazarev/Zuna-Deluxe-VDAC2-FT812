   1+ E574              ; ============================================================================
   2+ E574              ; Bullet.asm — летящий шар (одиночный выстрел из лягушки).
   3+ E574              ;
   4+ E574              ; State: Active flag + позиция (X,Y signed 16-bit) + velocity (VX,VY signed 8-bit)
   5+ E574              ; + color (0..5).  Spawn в start-fire (Frog_HandleMouse / Frog_FireKeyboard).
   6+ E574              ; Update каждый кадр (X += VX, Y += VY).  Out-of-screen → deactivate.
   7+ E574              ; Render — handle 0 chain atlas, тот же что ball-now/next-ball/chain.
   8+ E574              ;
   9+ E574              ; Этап 1 (текущий): только полёт + render. Без collision/insert в chain.
  10+ E574              ; ============================================================================
  11+ E574
  12+ E574              BULLET_SPEED        EQU 12                            ; px/frame, ~684 px/sec @57Hz
  13+ E574              BULLET_SPRITE_HALF  EQU 16                            ; chain atlas 32×32 native classic
  14+ E574              BULLET_HIT_THR      EQU 22                            ; bbox prefilter: |dx|<THR && |dy|<THR.
  15+ E574              BULLET_HIT_MANHATTAN_THR EQU 34                       ; reject far bbox corners.
  16+ E574                                                                    ; D=32: 30/46 was too magnetic on curved chain and
  17+ E574                                                                    ; could pick a ball several slots before the aimed one.
  18+ E574                                                                    ; 22/34 keeps a small touch margin without early capture.
  19+ E574              BULLET_TRACKF_TUNNEL EQU #01                          ; track flags bit0: hidden/tunnel, not shootable.
  20+ E574
  21+ E574
  22+ E574              ; ----------------------------------------------------------------------------
  23+ E574              ; Bullet_Init — обнулить state.
  24+ E574              ; ----------------------------------------------------------------------------
  25+ E574 AF           Bullet_Init:        XOR  A
  26+ E575 32 83 E8                         LD   (Bullet_Active), A
  27+ E578 32 8B E8                         LD   (Bullet_TunnelSeen), A
  28+ E57B C9                               RET
  29+ E57C
  30+ E57C
  31+ E57C              ; ----------------------------------------------------------------------------
  32+ E57C              ; Bullet_Spawn — вызывается из Frog start-fire (LMB или SPACE).
  33+ E57C              ; Berёт цвет из Frog_BallColor (= уже промотировано из NextBallColor),
  34+ E57C              ; angle из Frog_Angle, spawn position из Frog_PosStartX/Y (центр лягушки).
  35+ E57C              ; Velocity = BULLET_SPEED * (cos(angle), sin(angle)) / 128.
  36+ E57C              ; ----------------------------------------------------------------------------
  37+ E57C 3A D6 6C     Bullet_Spawn:       LD   A, (VDC_DialogState)
  38+ E57F B7                               OR   A
