 478+ 4000                              include "quit_loader_stub.asm"
# file opened: Source\ASM\quit_loader_stub.asm
   1++4000              ; ============================================================================
   2++4000              ; quit_loader_stub.asm — РЕЛОЦИРУЕМЫЙ загрузчик WC для кнопки Quit.
   3++4000              ; Ассемблируется в main.asm внутри DISP #4000 (метки/переходы = адреса #40xx),
   4++4000              ; но байты эмитятся в резиденте (Core). На Quit копируется в #4000 (bank5, ниже
   5++4000              ; #6011 → переживает загрузку) и запускается в СТАНДАРТНОМ 128-режиме, где
   6++4000              ; slot1=bank5 / slot2=bank2 / slot3=bank0 фиксированы → #6000..#DE00 непрерывны.
   7++4000              ;
   8++4000              ; Читает QS_Cnt последовательных секторов с QS_Lba в адресное окно WC:
