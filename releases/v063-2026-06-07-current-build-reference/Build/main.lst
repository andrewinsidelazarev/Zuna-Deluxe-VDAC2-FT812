 195+ 6DAC              ; ----------------------------------------------------------------------------
 196+ 6DAC              ; Overlay trampolines (resident). Each maps LOADER_OVL_PAGE into slot 3, calls
 197+ 6DAC              ; the real OVL_* routine in the overlay, then restores PAGE3=#04. Done under DI
 198+ 6DAC              ; so an interrupt never sees slot 3 holding the loader page. CF (load result) is
 199+ 6DAC              ; preserved across SetPage3 (it only touches HL) and the final EI.
 200+ 6DAC              ; ----------------------------------------------------------------------------
 201+ 6DAC              LoadGameplayLevelSpecificFromPack:
 202+ 6DAC F3                           DI
 203+ 6DAD                              SetPage3 LOADER_OVL_PAGE
 203+ 6DAD             >                ifdef MAPPING_REGISTERS
 203+ 6DAD 21 13 04    >                LD HL, FMADDR_REGS + HIGH PAGE3
 203+ 6DB0 36 40       >                LD (HL), LOADER_OVL_PAGE & 0xFF
 203+ 6DB2             >                else
 203+ 6DB2 ~           >                LD A, Page? & 0xFF
 203+ 6DB2 ~           >                LD (MemoryPages + 3), A
 203+ 6DB2 ~           >                LD BC, PAGE3
 203+ 6DB2 ~           >                OUT (C), A
 203+ 6DB2             >                endif
 204+ 6DB2 CD CE DD                     CALL OVL_LoadGameplayLevelSpecificFromPack
 205+ 6DB5 F3                           DI                                     ; overlay (ZiFi_Done) re-enabled IRQs; re-disable to restore slot 3 atomically
 206+ 6DB6                              SetPage3 #04
 206+ 6DB6             >                ifdef MAPPING_REGISTERS
 206+ 6DB6 21 13 04    >                LD HL, FMADDR_REGS + HIGH PAGE3
 206+ 6DB9 36 04       >                LD (HL), #04 & 0xFF
 206+ 6DBB             >                else
 206+ 6DBB ~           >                LD A, Page? & 0xFF
 206+ 6DBB ~           >                LD (MemoryPages + 3), A
 206+ 6DBB ~           >                LD BC, PAGE3
 206+ 6DBB ~           >                OUT (C), A
 206+ 6DBB             >                endif
 207+ 6DBB FB                           EI
 208+ 6DBC C9                           RET
 209+ 6DBD
 210+ 6DBD              ; Called only from level-select (LevelSelect.asm + LevelSelectApplyLevelClick),
 211+ 6DBD              ; which runs on the UI overlay (#41) — so restore #41, not #04, else the scene
 212+ 6DBD              ; code vanishes from slot 3 on return. (The gameplay trampoline above is only
 213+ 6DBD              ; reached from gameplay, so it correctly restores #04.)
 214+ 6DBD              LoadLevelSelectPreviewAssets:
