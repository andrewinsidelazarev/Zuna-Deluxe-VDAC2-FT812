 265+ C2BB              MenuAdvanceSky:
 266+ C2BB                              ; pos += шаг (в 1/16 px); если pos >= W*16 — вычесть W*16 (плавный wrap
 267+ C2BB                              ; без потери остатка). Шаг << W*16, поэтому одного вычитания хватает.
 268+ C2BB 2A 45 CD                     LD   HL, (MenuSkyPos)
 269+ C2BE 11 0B 00                     LD   DE, MENU_SKY_SCROLL16
 270+ C2C1 19                           ADD  HL, DE
 271+ C2C2 11 00 28                     LD   DE, MENU_SKY_W * 16
 272+ C2C5 A7                           AND  A
 273+ C2C6 ED 52                        SBC  HL, DE
 274+ C2C8 30 01                        JR   NC, .store                        ; >=0 -> wrapped, оставить остаток
 275+ C2CA 19                           ADD  HL, DE                            ; <0  -> не дошли до края, вернуть
 276+ C2CB 22 45 CD     .store:         LD   (MenuSkyPos), HL
 277+ C2CE                              ; две НЕЗАВИСИМЫЕ фазы с разной скоростью → масштаб солнца и пульс
 278+ C2CE                              ; свечения расходятся (асинхронно): солнце +2 (~2 с), свечение +3 (~1.3 с).
 279+ C2CE 3A 47 CD                     LD   A, (MenuSunPhase)
 280+ C2D1 C6 02                        ADD  A, 2
 281+ C2D3 32 47 CD                     LD   (MenuSunPhase), A
 282+ C2D6 3A 48 CD                     LD   A, (MenuGlowPhase)
 283+ C2D9 C6 03                        ADD  A, 3
 284+ C2DB 32 48 CD                     LD   (MenuGlowPhase), A
 285+ C2DE C9                           RET
