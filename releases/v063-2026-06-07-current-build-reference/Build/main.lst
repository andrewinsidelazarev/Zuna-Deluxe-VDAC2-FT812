2539+ CEA6 22 E3 D4                     LD   (VDC_LfsrSeed), HL
2540+ CEA9 7D                           LD   A, L
2541+ CEAA AC                           XOR  H                                 ; A = 8-bit random
2542+ CEAB 6F                           LD   L, A
2543+ CEAC 26 00                        LD   H, 0                              ; HL = rand byte (0..255)
2544+ CEAE 3A C2 D4                     LD   A, (VDC_LevelColors)              ; per-level color count (set in VDC_Init)
2545+ CEB1 CD 63 F7                     CALL ZL_Mul16x8                        ; HL = rand * N (max 6*255 = 1530)
2546+ CEB4 7C                           LD   A, H                              ; A = (rand * N) >> 8 = 0..N-1
2547+ CEB5 C9                           RET
