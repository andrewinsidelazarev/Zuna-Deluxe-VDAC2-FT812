1987  32B2 DD 9E 01       SBC A, (IX+1)
1987  32B5 32 2D 33       LD (Score24Work + 1), A
1988  32B8 3A 2E 33                     LD   A, (Score24Work + 2)
1988  32BB DD 9E 02       SBC A, (IX+2)
1988  32BE 32 2E 33       LD (Score24Work + 2), A
1989  32C1 30 E2                        JR   NC, .fs24_sub                     ; no borrow -> subtract again
1990  32C3 3A 2C 33                     LD   A, (Score24Work)
1990  32C6 DD 86 00       ADD A, (IX+0)
1990  32C9 32 2C 33       LD (Score24Work), A    ; add divisor back once
1991  32CC 3A 2D 33                     LD   A, (Score24Work + 1)
1991  32CF DD 8E 01       ADC A, (IX+1)
1991  32D2 32 2D 33       LD (Score24Work + 1), A
1992  32D5 3A 2E 33                     LD   A, (Score24Work + 2)
1992  32D8 DD 8E 02       ADC A, (IX+2)
1992  32DB 32 2E 33       LD (Score24Work + 2), A
1993  32DE 79                           LD   A, C
1994  32DF 2A 2F 33                     LD   HL, (Score24OutPtr)
1995  32E2 77                           LD   (HL), A
1996  32E3 23                           INC  HL
1997  32E4 22 2F 33                     LD   (Score24OutPtr), HL
1998  32E7 DD 23                        INC  IX
1998  32E9 DD 23          INC IX
1998  32EB DD 23          INC IX
1999  32ED 10 B4                        DJNZ .fs24_digit
