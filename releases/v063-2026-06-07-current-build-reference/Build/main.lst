1460+ C8BA              ; VDC_CheckGapBridge — для cascade/Shot2 после удаления gap проверяет, что
1461+ C8BA              ; найденный run реально пересекает закрытую границу K-1/K.
1462+ C8BA              ; Если gap был только рядом с уже готовой группой, run будет целиком слева
1463+ C8BA              ; или справа от K, и такой match нелегален.
1464+ C8BA              ; Out: A=1 если TmpML <= K-1 и TmpMR >= K, иначе A=0.
1465+ C8BA              ; ----------------------------------------------------------------------------
1466+ C8BA              VDC_CheckGapBridge:
