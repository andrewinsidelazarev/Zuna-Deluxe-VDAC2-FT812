 200+ E9A8              ; --- Bucket-based tangent rotation: цепь группирована по buckets, 1 cmd_rotate per bucket.
 201+ E9A8              ; ZL_BUCKETS = 8/16/32/64. Чем больше — тем плавнее rotation, но больше cmd_rotate/frame.
 202+ E9A8              ; bucket = (tangent + step/2) / step mod N. step = 256/N BRAD.
 203+ E9A8              ZL_BUCKETS      EQU 32                                ; (dead-code legacy; per-ball replaced bucket loop 2026-05-18)
 204+ E9A8
 205+ E9A8              ; --- PALETTED4444 dual handle: 6×32 = 192 cells > 128 → split в 2 handle.
 206+ E9A8              ; Handle 0 source = BALLS_RAMG_ADDR (cells 0..127).
 207+ E9A8              ; Handle 9 source = BALLS_RAMG_ADDR + 128 × ZL_BALL_W × ZL_BALL_H (cells 0..63 = global 128..191).
 208+ E9A8              BALLS_HANDLE9_OFFSET EQU 128 * ZL_BALL_W * ZL_BALL_H        ; PALETTED = 1 byte/pixel cell
 209+ E9A8              ZL_DESTROY_HANDLE EQU 10                             ; match-3 серый animBallDestroy
 210+ E9A8              ZL_DESTROY_W      EQU 48
 211+ E9A8              ZL_DESTROY_H      EQU 48
 212+ E9A8              ZL_DESTROY_HALF_DELTA EQU ((ZL_DESTROY_W - ZL_BALL_W) / 2) * 16
 213+ E9A8              ZL_DESTROY_FRAMES EQU 13                              ; match-3 destroy: 13 кадров
 214+ E9A8              ; WIN-взрыв (оранжевый HD-ref animExplosion) — ОТДЕЛЬНЫЙ атлас/handle/RAM_G:
 215+ E9A8              ZL_WINEXP_HANDLE  EQU 9                               ; handle шаров (в WIN-стейте шаров нет → свободен).
 216+ E9A8                                                                   ; ВАЖНО: ≤15, вне диапазона ROM-шрифтов FT812 (16..31).
 217+ E9A8                                                                   ; Раньше был 26 — совпадал с font 26 у DrawDebugClock:
 218+ E9A8                                                                   ; взрыв перенастраивал BITMAP_SOURCE(26) на свой атлас
 219+ E9A8                                                                   ; #050000, и часы (CMD_NUMBER font 26) читали глифы из
 220+ E9A8                                                                   ; атласа взрыва → мусор на месте цифр (только на железе,
 221+ E9A8                                                                   ; эмулятор залипание per-handle source не моделирует).
 222+ E9A8              ZL_WINEXP_FRAMES  EQU 17                              ; HD-ref animExplosion: 17 кадров
 223+ E9A8              ZL_WINEXP_DRAW    EQU 80                              ; экранный размер взрыва (≈2.5× шара 32; оригинал scale 1.5×100)
 224+ E9A8              ZL_WINEXP_XOFF    EQU 1                               ; manual screen offset from winexp_offset_tool.py
 225+ E9A8              ZL_WINEXP_YOFF    EQU -2
 226+ E9A8              ZL_BG_W         EQU 400                               ; native bg storage, upscaled to 640x480
 227+ E9A8              ZL_BG_H         EQU 300
 228+ E9A8              ZL_BG_DRAW_W    EQU 640
 229+ E9A8              ZL_BG_DRAW_H    EQU 480
 230+ E9A8              ZL_BG_SCALE     EQU #0001999A                         ; 1.6 in f16.16
 231+ E9A8              ZL_BG_HANDLE    EQU 1
