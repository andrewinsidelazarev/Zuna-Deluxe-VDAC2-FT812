1078+ C6AF 18 09                        JR   .ac_decay_store
1079+ C6B1 C6 02        .ac_decay_neg:  ADD  A, VDC_DECAY_NEG                  ; neg (insert head slide) → 0 быстро
1080+ C6B3 28 05                        JR   Z, .ac_decay_store
1081+ C6B5 CB 7F                        BIT  7, A
1082+ C6B7 20 01                        JR   NZ, .ac_decay_store               ; ещё отрицательный
1083+ C6B9 AF                           XOR  A                                 ; overshoot → 0
1084+ C6BA              .ac_decay_store:
1085+ C6BA 77                           LD   (HL), A
1086+ C6BB              .ac_decay_skip:
