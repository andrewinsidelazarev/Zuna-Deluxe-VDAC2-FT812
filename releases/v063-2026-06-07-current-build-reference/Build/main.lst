 846+ C57D              ; ============================================================================
 847+ C57D              ; VDC_TrySpawn — спавн нового шара в хвост (если разрешено).
 848+ C57D              ;   Условия: SlotsLen<MAX, BallsSpawned<TARGET, HSA>=SlotsLen, HSub==0.
 849+ C57D              ; ============================================================================
 850+ C57D              VDC_TrySpawn:
 851+ C57D                              ; Public entry: с HSub==0 gate (sync с Python try_spawn).
 852+ C57D                              ; Fast phase обходит gate через VDC_TrySpawn_NoHsubGate.
 853+ C57D 3A D1 6C                     LD   A, (VDC_HSub)
 854+ C580 B7                           OR   A
 855+ C581 C0                           RET  NZ
 856+ C582                              ; fallthrough
 857+ C582              VDC_TrySpawn_NoHsubGate:
 858+ C582                              ; Zuma bar full → spawn gate OFF (per wiki/manual).
 859+ C582                              ; Хвост перестаёт прирастать, остаётся доедать уже спавненные шары.
 860+ C582 3A DC 6C                     LD   A, (VDC_GaugeFull)
 861+ C585 B7                           OR   A
 862+ C586 C0                           RET  NZ
 863+ C587 3A D2 6C                     LD   A, (VDC_SlotsLen)
 864+ C58A FE F0                        CP   VDC_MAX_SLOTS
 865+ C58C D0                           RET  NC
 866+ C58D
 867+ C58D                              ; HSA < SlotsLen → не спавним (хвост не достиг старта)
 868+ C58D 3A D2 6C                     LD   A, (VDC_SlotsLen)
 869+ C590 47                           LD   B, A                              ; B = SlotsLen
 870+ C591 3A B1 D4                     LD   A, (VDC_HSA)
 871+ C594 B8                           CP   B
 872+ C595 D8                           RET  C
 873+ C596
 874+ C596                              ; SlotsLen > 0 AND offsets[tail-1] != 0 → не спавним (хвост ещё двигается).
 875+ C596 78                           LD   A, B
 876+ C597 B7                           OR   A
 877+ C598 28 0C                        JR   Z, .spawn_no_tail_check
 878+ C59A 3D                           DEC  A
 879+ C59B 26 00                        LD   H, 0
 879+ C59D 6F             LD L, A
 880+ C59E ED 5B C0 D9                  LD   DE, (VDC_pOffsets)
 881+ C5A2 19                           ADD  HL, DE
 882+ C5A3 7E                           LD   A, (HL)
 883+ C5A4 B7                           OR   A
 884+ C5A5 C0                           RET  NZ
 885+ C5A6              .spawn_no_tail_check:
 886+ C5A6                              ; --- Level RNG:
 887+ C5A6                              ; RTC seconds seed only at VDC_Init. Runtime uses deterministic LFSR.
 888+ C5A6                              ; Per level setting: 50% single random color OR 50% same-color
 889+ C5A6                              ; chain of random color and random length 1..VDC_NUM_COLORS-1.
 890+ C5A6 3A B6 D4                     LD   A, (VDC_SpawnClusterRem)
 891+ C5A9 B7                           OR   A
 892+ C5AA 28 0A                        JR   Z, .spawn_roll_new
 893+ C5AC 3D                           DEC  A
 894+ C5AD 32 B6 D4                     LD   (VDC_SpawnClusterRem), A
 895+ C5B0 3A B5 D4                     LD   A, (VDC_SpawnClusterColor)
 896+ C5B3 47                           LD   B, A
 897+ C5B4 18 28                        JR   .spawn_color_ready
 898+ C5B6              .spawn_roll_new:
 899+ C5B6 CD 96 CE                     CALL VDC_RandomColor                   ; A = gate roll 0..NUM-1
 900+ C5B9 CB 47                        BIT  0, A                              ; odd/even ≈ 50/50 for NUM=6
 901+ C5BB 28 13                        JR   Z, .spawn_single_random           ; 50% single random ball
 902+ C5BD                              ; cluster path — reroll color until != предыдущий cluster.
 903+ C5BD                              ; (VDC_SpawnClusterColor) = previous color (or sentinel #FF на init).
 904+ C5BD              .cluster_color_reroll:
 905+ C5BD CD 96 CE                     CALL VDC_RandomColor                   ; chain color candidate
 906+ C5C0 21 B5 D4                     LD   HL, VDC_SpawnClusterColor
 907+ C5C3 BE                           CP   (HL)                              ; == previous?
 908+ C5C4 28 F7                        JR   Z, .cluster_color_reroll          ; → reroll
 909+ C5C6 77                           LD   (HL), A                           ; commit color
 910+ C5C7 CD B6 CE                     CALL VDC_RandomClusterLength           ; A = total length 1..NUM-1
 911+ C5CA                                                                     ; (NB: ZL_Mul16x8 clobs B/C —
 912+ C5CA                                                                     ; читаем color из памяти ниже)
 913+ C5CA 3D                           DEC  A                                 ; current spawn is first ball
 914+ C5CB 32 B6 D4                     LD   (VDC_SpawnClusterRem), A
 915+ C5CE 18 0E                        JR   .spawn_color_ready
 916+ C5D0              .spawn_single_random:
 917+ C5D0                              ; single path — тоже reroll, чтобы два соседних кластера/single
 918+ C5D0                              ; никогда не были одного цвета.
 919+ C5D0              .single_color_reroll:
 920+ C5D0 CD 96 CE                     CALL VDC_RandomColor
 921+ C5D3 21 B5 D4                     LD   HL, VDC_SpawnClusterColor
 922+ C5D6 BE                           CP   (HL)
 923+ C5D7 28 F7                        JR   Z, .single_color_reroll
 924+ C5D9 77                           LD   (HL), A                           ; commit color
 925+ C5DA AF                           XOR  A
 926+ C5DB 32 B6 D4                     LD   (VDC_SpawnClusterRem), A
 927+ C5DE              .spawn_color_ready:
 928+ C5DE 3A B5 D4                     LD   A, (VDC_SpawnClusterColor)        ; re-read color from memory
 929+ C5E1                                                                     ; (B клобан RandomColor/Mul16x8)
 930+ C5E1 47                           LD   B, A
 931+ C5E2                              ; B = chosen color. Не режем 3+ одинаковых на spawn: в оригинальной
 932+ C5E2                              ; Zuma цепь может иметь длинные серии, а match запускается только
 933+ C5E2                              ; от выстрела или физического закрытия gap через Shot2/cascade.
 934+ C5E2 78                           LD   A, B
 935+ C5E3 32 B5 D4                     LD   (VDC_SpawnClusterColor), A
 936+ C5E6                              ; --- Slots[SlotsLen] = candidate ---
 937+ C5E6 3A D2 6C                     LD   A, (VDC_SlotsLen)
 938+ C5E9 26 00                        LD   H, 0
 938+ C5EB 6F             LD L, A
 939+ C5EC ED 5B BE D9                  LD   DE, (VDC_pSlots)
 940+ C5F0 19                           ADD  HL, DE
 941+ C5F1 70                           LD   (HL), B
 942+ C5F2
 943+ C5F2                              ; --- offsets[SlotsLen] = (SlotsLen>0) ? offsets[SlotsLen-1] : 0 ---
 944+ C5F2 3A D2 6C                     LD   A, (VDC_SlotsLen)
 945+ C5F5 B7                           OR   A
 946+ C5F6 28 0C                        JR   Z, .spawn_off_zero
 947+ C5F8 3D                           DEC  A
 948+ C5F9 26 00                        LD   H, 0
 948+ C5FB 6F             LD L, A
 949+ C5FC ED 5B C0 D9                  LD   DE, (VDC_pOffsets)
 950+ C600 19                           ADD  HL, DE
 951+ C601 46                           LD   B, (HL)                           ; B = offsets[len-1]
 952+ C602 18 02                        JR   .spawn_off_set
 953+ C604              .spawn_off_zero:
 954+ C604 06 00                        LD   B, 0
 955+ C606              .spawn_off_set:
 956+ C606 3A D2 6C                     LD   A, (VDC_SlotsLen)
 957+ C609 26 00                        LD   H, 0
 957+ C60B 6F             LD L, A
 958+ C60C ED 5B C0 D9                  LD   DE, (VDC_pOffsets)
 959+ C610 19                           ADD  HL, DE
 960+ C611 70                           LD   (HL), B
