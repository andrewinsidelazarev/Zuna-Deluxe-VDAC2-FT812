 442  177E 47                           LD   B, A                              ; pairs len-1
 443  177F 21 F1 D0                     LD   HL, Core.VDC_Offsets              ; HL = prev offset
 444  1782 7E           .co_loop:       LD   A, (HL)
 445  1783 23                           INC  HL                                ; HL = current offset
 446  1784 4F                           LD   C, A                              ; C = prev
 447  1785 7E                           LD   A, (HL)                           ; A = current
 448  1786 B7                           OR   A
 449  1787 28 0D                        JR   Z, .co_next
 450  1789 FA 96 17                     JP   M, .co_next                       ; only positive current offsets can create backward overlap
 451  178C CB 79                        BIT  7, C
 452  178E 20 05                        JR   NZ, .co_clamp                     ; prev negative, current positive -> inverted
 453  1790 B9                           CP   C
 454  1791 38 03                        JR   C, .co_next
 455  1793 28 01                        JR   Z, .co_next
 456  1795 71           .co_clamp:      LD   (HL), C
 457  1796 10 EA        .co_next:       DJNZ .co_loop
