 469+ C641              MenuDrawSun:
 470+ C641                              ; Солнце и свечение — отдельные спрайты поверх фона. Анимация по фазе
 471+ C641                              ; MenuSunPhase: солнце плавно «дышит» масштабом (cmd_scale), свечение —
 472+ C641                              ; пульс alpha. Значения считаем В ПАМЯТЬ заранее (макросы FT_Bitmap*
 473+ C641                              ; клобают BCDE).
 474+ C641                              ; alpha свечения = 150 + sin(GlowPhase)>>2 → 119..181 (своя фаза/скорость)
 475+ C641 3A 48 CD                     LD   A, (MenuGlowPhase)
 476+ C644 06 02                        LD   B, 2
 477+ C646 CD D4 C7                     CALL MenuSinShiftHL
 478+ C649 7D                           LD   A, L
 479+ C64A C6 96                        ADD  A, 150
 480+ C64C 32 4D CD                     LD   (MenuGlowAlpha), A
 481+ C64F                              ; масштаб солнца 16.16, ТОЛЬКО уменьшение: s = 1.0 + (sin-127)*8/65536
 482+ C64F                              ;   → s ∈ [0.969 .. 1.0] (±0..3.1%). Только shrink — у спрайта солнца НЕТ
 483+ C64F                              ;   прозрачных полей (лучи до краёв), при увеличении лучи бы обрезались
 484+ C64F                              ;   фиксированным BITMAP_SIZE. Уменьшение безопасно (внутри рамки, по краям
 485+ C64F                              ;   прозрачно). offset = (sin-127)*8 ≤ 0; scale = #00010000 + offset, т.е.
 486+ C64F                              ;   scaleLo = offset(как есть), scaleHi = 1 только при offset==0 иначе 0.
 487+ C64F 3A 47 CD                     LD   A, (MenuSunPhase)
 488+ C652 5F                           LD   E, A
 488+ C653 16 00          LD D, 0
 489+ C655 21 E5 C7                     LD   HL, MenuSunSinTable
 490+ C658 19                           ADD  HL, DE
 491+ C659 7E                           LD   A, (HL)                            ; A = sin(phase), signed
 492+ C65A 6F                           LD   L, A
 492+ C65B 87             ADD A, A
 492+ C65C 9F             SBC A, A
 492+ C65D 67             LD H, A   ; HL = sign-extended sin (-128..127)
 493+ C65E 11 81 FF                     LD   DE, -127
 494+ C661 19                           ADD  HL, DE                             ; HL = sin - 127  (-254..0)
 495+ C662 29                           ADD  HL, HL
 495+ C663 29             ADD HL, HL
 495+ C664 29             ADD HL, HL   ; HL = (sin-127)*8  (offset, -2032..0)
 496+ C665 22 49 CD                     LD   (MenuSunScaleLo), HL
 497+ C668 3E 01                        LD   A, 1
 498+ C66A CB 7C                        BIT  7, H
 499+ C66C 28 01                        JR   Z, .scale_hi                       ; H bit7=0 → offset==0 → Hi=1 (s=1.0)
 500+ C66E 3D                           DEC  A                                  ; offset<0 → Hi=0 (s<1.0)
 501+ C66F 6F           .scale_hi:      LD   L, A
 501+ C670 26 00          LD H, 0
 502+ C672 22 4B CD                     LD   (MenuSunScaleHi), HL
