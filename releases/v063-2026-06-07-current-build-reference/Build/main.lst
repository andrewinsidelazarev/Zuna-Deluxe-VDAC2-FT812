1590+ F80A              ; ----------------------------------------------------------------------------
1591+ F80A              ; ZL_AbsHL — HL = |HL| (16-bit signed → unsigned magnitude).
1592+ F80A              ; ----------------------------------------------------------------------------
1593+ F80A CB 7C        ZL_AbsHL:       BIT  7, H
1594+ F80C C8                           RET  Z
1595+ F80D 7C                           LD   A, H
1595+ F80E 2F             CPL
1595+ F80F 67             LD H, A
1596+ F810 7D                           LD   A, L
1596+ F811 2F             CPL
1596+ F812 6F             LD L, A
1597+ F813 23                           INC  HL
1598+ F814 C9                           RET
