 672+ C4B2              ; VDC_SnapshotWinChain — макс. track-сэмпл видимых шаров текущей активной цепочки.
 673+ C4B2              ; Out: CF=0 + HL = head sample (фронт), если есть видимый шар; CF=1 если нет.
 674+ C4B2              ; VDC_SlotPos для каждого слота выставляет VDC_LastT (clamped sample); берём макс.
 675+ C4B2              VDC_SnapshotWinChain:
 676+ C4B2 3A D2 6C                     LD   A, (VDC_SlotsLen)
 677+ C4B5 B7                           OR   A
 678+ C4B6 28 38                        JR   Z, .none
 679+ C4B8 47                           LD   B, A                              ; B = число слотов
 680+ C4B9 0E 00                        LD   C, 0                              ; C = индекс слота
 681+ C4BB 21 00 00                     LD   HL, 0
 682+ C4BE 22 F3 6C                     LD   (VDC_WinTmpMax), HL
 683+ C4C1 AF                           XOR  A
 684+ C4C2 32 F5 6C                     LD   (VDC_WinTmpFound), A
 685+ C4C5 C5           .snap_loop:     PUSH BC
 686+ C4C6 79                           LD   A, C
 687+ C4C7 CD 51 C5                     CALL VDC_SlotPos                       ; CF=1 gap/вне трека; иначе VDC_LastT=сэмпл
 688+ C4CA 38 15                        JR   C, .snap_skip
 689+ C4CC 3E 01                        LD   A, 1
 690+ C4CE 32 F5 6C                     LD   (VDC_WinTmpFound), A
 691+ C4D1 2A E7 D4                     LD   HL, (VDC_LastT)                   ; сэмпл этого шара
 692+ C4D4 ED 5B F3 6C                  LD   DE, (VDC_WinTmpMax)
 693+ C4D8 A7                           AND  A
 694+ C4D9 ED 52                        SBC  HL, DE                            ; sample - max
 695+ C4DB 38 04                        JR   C, .snap_skip                     ; sample < max → не обновляем
 696+ C4DD 19                           ADD  HL, DE                            ; восстановить sample
 697+ C4DE 22 F3 6C                     LD   (VDC_WinTmpMax), HL               ; новый максимум
 698+ C4E1 C1           .snap_skip:     POP  BC
 699+ C4E2 0C                           INC  C
 700+ C4E3 10 E0                        DJNZ .snap_loop
 701+ C4E5 3A F5 6C                     LD   A, (VDC_WinTmpFound)
 702+ C4E8 B7                           OR   A
 703+ C4E9 28 05                        JR   Z, .none
 704+ C4EB 2A F3 6C                     LD   HL, (VDC_WinTmpMax)
 705+ C4EE A7                           AND  A                                 ; CF=0
