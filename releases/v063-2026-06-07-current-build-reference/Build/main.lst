2518+ CE96              ; ============================================================================
2519+ CE96              ; VDC_DivHLbyA — целочисленное деление 16-bit на 8-bit.
2520+ CE96              ;   In:  HL = dividend (unsigned), A = divisor (unsigned, > 0)
2521+ CE96              ;   Out: HL = quotient, A = remainder
2522+ CE96              ;   Clobbers BC.
2523+ CE96              ; Bit-by-bit алгоритм. ~80 t-states, ~16 байт кода.
2524+ CE96              ; ============================================================================
2525+ CE96              ; [VDC_DivHLbyA -> moved to shared_render.asm (resident; shared by gameplay #04 + level-select #41)]
2526+ CE96              VDC_RandomColor:
2527+ CE96                              ; Mul-then-shift: A = ((L XOR H) * NUM_COLORS) >> 8 = 0..NUM-1.
2528+ CE96                              ; Старый AND 7 + reject имел LFSR-bias для poly 0xB400: (L XOR H) & 7
2529+ CE96                              ; почти не выдавал значения 2 и 5 (биты коррелированы) → цвета 2 и 5
2530+ CE96                              ; не появлялись в цепи. Mul-then-shift bias ≤ 1.4% при NUM=6.
2531+ CE96                              ; Fix 2026-05-18.
2532+ CE96 2A E3 D4                     LD   HL, (VDC_LfsrSeed)
