4280  69CD              ; UpdatePauseFade — runs each frame while VDC_DialogState=4 (pause "No" fade-out).
4281  69CD              ; Board stays frozen (not-Play: no shot, no game-time). The pause window alpha
4282  69CD              ; ramps down over PAUSE_FADE_FRAMES; when it expires -> DialogState=0 (PLAY).
4283  69CD              UpdatePauseFade:
4284  69CD 3E 01                        LD   A, 1
4285  69CF 32 D9 6C                     LD   (VDC_HudPointerBlock), A           ; eat fire edge during fade
4286  69D2 3A 53 6C                     LD   A, (PauseFadeTimer)
