1918  3234              ; ============================================================================
1919  3234              ; 24-bit cumulative score (Core.VDC_PlayerScore, 3-byte LE) + 50000 extra-life.
1920  3234              ; Resident (slot 0), so callable from gameplay (#04) and resident win/HUD code.
1921  3234              ; ----------------------------------------------------------------------------
1922  3234              ; Score_Add24 — VDC_PlayerScore += HL (16-bit delta), then award extra lives.
1923  3234              ;   In: HL = points to add. Clobbers AF, DE, HL (NOT BC).
1924  3234              ; ----------------------------------------------------------------------------
1925  3234              Score_Add24:
1926  3234 ED 5B DD 6C                  LD   DE, (Core.VDC_PlayerScore)        ; DE = low 16 bits
1927  3238 19                           ADD  HL, DE                            ; CF = carry out of low 16
1928  3239 22 DD 6C                     LD   (Core.VDC_PlayerScore), HL        ; store low 16 (LD keeps CF)
1929  323C 3A DF 6C                     LD   A, (Core.VDC_PlayerScore + 2)
1930  323F CE 00                        ADC  A, 0                              ; += carry into byte 2
1931  3241 32 DF 6C                     LD   (Core.VDC_PlayerScore + 2), A
1932  3244                              ; fall through to extra-life check
1933  3244              ; ----------------------------------------------------------------------------
1934  3244              ; Score_CheckExtraLife — while score >= NextLifeScore: VDC_Lives++, threshold += 50000.
1935  3244              ; ----------------------------------------------------------------------------
1936  3244              Score_CheckExtraLife:
1937  3244 2A DD 6C     .cel_loop:      LD   HL, (Core.VDC_PlayerScore)        ; low 16 of score
1938  3247 ED 5B E0 6C                  LD   DE, (Core.NextLifeScore)
1939  324B A7                           AND  A
1940  324C ED 52                        SBC  HL, DE                            ; CF = borrow (low 16)
1941  324E 3A DF 6C                     LD   A, (Core.VDC_PlayerScore + 2)
1942  3251 21 E2 6C                     LD   HL, Core.NextLifeScore + 2
1943  3254 9E                           SBC  A, (HL)                           ; full 24-bit borrow in CF
1944  3255 D8                           RET  C                                 ; score < threshold -> done
1945  3256 3A D5 6C                     LD   A, (Core.VDC_Lives)
1946  3259 3C                           INC  A
1947  325A 32 D5 6C                     LD   (Core.VDC_Lives), A
1948  325D 3E 19                        LD   A, Core.SND_EXTRALIFE
1949  325F CD 6B 6E                     CALL Core.GS_PlaySfx
1950  3262 2A E0 6C                     LD   HL, (Core.NextLifeScore)
1951  3265 11 50 C3                     LD   DE, 50000
1952  3268 19                           ADD  HL, DE
1953  3269 22 E0 6C                     LD   (Core.NextLifeScore), HL
1954  326C 3A E2 6C                     LD   A, (Core.NextLifeScore + 2)
1955  326F CE 00                        ADC  A, 0
1956  3271 32 E2 6C                     LD   (Core.NextLifeScore + 2), A
1957  3274 18 CE                        JR   .cel_loop
1958  3276              ; ----------------------------------------------------------------------------
1959  3276              ; Score_Reset — score = 0, NextLifeScore = 50000 (new run / full restart).
1960  3276              ; ----------------------------------------------------------------------------
1961  3276              Score_Reset:
1962  3276 21 00 00                     LD   HL, 0
1963  3279 22 DD 6C                     LD   (Core.VDC_PlayerScore), HL
1964  327C AF                           XOR  A
1965  327D 32 DF 6C                     LD   (Core.VDC_PlayerScore + 2), A
1966  3280 21 50 C3                     LD   HL, 50000
1967  3283 22 E0 6C                     LD   (Core.NextLifeScore), HL
1968  3286 AF                           XOR  A
1969  3287 32 E2 6C                     LD   (Core.NextLifeScore + 2), A
1970  328A C9                           RET
