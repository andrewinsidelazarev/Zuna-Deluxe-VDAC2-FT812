1640  303A              ; ============================================================================
1641  303A              ; DrawString — glyph-blit zero-terminated string в TEKUЩЕМ шрифте.
1642  303A              ;   In:  HL = string ptr, BC = start x*16, DE = y*16. Font state из FontPtr*.
1643  303A              ;   Out: (DrawStr_CurX) = end x*16
1644  303A              ;   Clobbers all.
1645  303A              ; ============================================================================
1646  303A              DrawString:
1647  303A 22 E8 30                     LD   (DrawStr_Ptr), HL
1648  303D ED 43 EA 30                  LD   (DrawStr_CurX), BC
1649  3041 ED 53 EC 30                  LD   (DrawStr_Y), DE
1650  3045 2A E8 30     .ds_loop:       LD   HL, (DrawStr_Ptr)
1651  3048 7E                           LD   A, (HL)
1652  3049 23                           INC  HL
1653  304A 22 E8 30                     LD   (DrawStr_Ptr), HL
1654  304D B7                           OR   A
1655  304E C8                           RET  Z                                  ; конец строки
1656  304F FE 80                        CP   128
1657  3051 30 F2                        JR   NC, .ds_loop                       ; non-ASCII skip
1658  3053
1659  3053                              ; --- Lookup glyph metadata: BC = char index (0..127) ---
1660  3053 4F                           LD   C, A
1661  3054 06 00                        LD   B, 0
1662  3056
1663  3056                              ; advance := (FontPtrAdvance)[A]
1664  3056 2A 34 30                     LD   HL, (FontPtrAdvance)
1665  3059 09                           ADD  HL, BC
1666  305A 7E                           LD   A, (HL)
1667  305B B7                           OR   A
1668  305C 28 E7                        JR   Z, .ds_loop                        ; advance=0 → неизвестный char, skip
1669  305E 32 EE 30                     LD   (DrawStr_Adv), A
1670  3061
1671  3061                              ; glyph_w := (FontPtrGlyphW)[A]
1672  3061 2A 32 30                     LD   HL, (FontPtrGlyphW)
1673  3064 09                           ADD  HL, BC
1674  3065 7E                           LD   A, (HL)
1675  3066 B7                           OR   A
1676  3067 28 62                        JR   Z, .ds_advance_only                ; w=0 (space) → только advance
1677  3069
1678  3069                              ; --- Emit BITMAP_SIZE (NEAREST/BORDER, w*scale, FontHeight*scale) ---
1679  3069 26 00                        LD   H, 0
1680  306B 6F                           LD   L, A                               ; HL = w
1681  306C 3A EF 30                     LD   A, (DrawStr_Scale)
1682  306F FE 02                        CP   2
1683  3071 38 01                        JR   C, .ds_sz_w1
1684  3073 29                           ADD  HL, HL                             ; w *= 2 (scale=2)
1685  3074 29           .ds_sz_w1:      ADD  HL, HL
1685  3075 29             ADD HL, HL
1685  3076 29             ADD HL, HL   ; <<3
1686  3077 29                           ADD  HL, HL
1686  3078 29             ADD HL, HL
1686  3079 29             ADD HL, HL   ; <<6
1687  307A 29                           ADD  HL, HL
1687  307B 29             ADD HL, HL
1687  307C 29             ADD HL, HL   ; <<9 (w << 9)
1688  307D 3A 39 30                     LD   A, (FontHeight)
1689  3080 47                           LD   B, A
1690  3081 3A EF 30                     LD   A, (DrawStr_Scale)
1691  3084 FE 02                        CP   2
1692  3086 38 02                        JR   C, .ds_sz_h1
1693  3088 CB 20                        SLA  B                                  ; FontHeight *= 2 (scale=2)
1694  308A 58           .ds_sz_h1:      LD   E, B
1694  308B 16 00          LD D, 0
1695  308D 19                           ADD  HL, DE                             ; HL = (w<<9)|H
1696  308E 06 08                        LD   B, #08
1697  3090 0E 00                        LD   C, 0
1698  3092 54                           LD   D, H
1698  3093 5D             LD E, L
1699  3094 CD EB 13                     CALL FT.Coprocessor.Command_BCDE
1700  3097
1701  3097                              ; --- Emit BITMAP_SOURCE = atlas_base + glyph_x * 2 ---
1702  3097 2A E8 30                     LD   HL, (DrawStr_Ptr)
1703  309A 2B                           DEC  HL                                  ; back to current char
1704  309B 7E                           LD   A, (HL)
1705  309C 4F                           LD   C, A
1705  309D 06 00          LD B, 0
1706  309F 2A 30 30                     LD   HL, (FontPtrGlyphX)
1707  30A2 09                           ADD  HL, BC
1707  30A3 09             ADD HL, BC                ; *2 (word table)
1708  30A4 5E                           LD   E, (HL)
1708  30A5 23             INC HL
1709  30A6 56                           LD   D, (HL)                             ; DE = glyph_x (pixels)
1710  30A7 EB                           EX   DE, HL
1711  30A8 29                           ADD  HL, HL                              ; HL = glyph_x_bytes
