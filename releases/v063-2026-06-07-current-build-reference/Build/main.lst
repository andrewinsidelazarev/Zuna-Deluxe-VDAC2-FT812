 170+ C468 10           ZiFi_DirGames:   DEFB #10
 171+ C469 47 61 6D 65                   DEFB "Games", 0
 171+ C46D 73 00
 172+ C46F
 173+ C46F 10           ZiFi_DirZuma:    DEFB #10
 174+ C470 5A 75 6D 61                   DEFB "Zuma Deluxe VDAC2", 0
 174+ C474 20 44 65 6C
 174+ C478 75 78 65 20
 174+ C47C 56 44 41 43
 174+ C480 32 00
 175+ C482
 176+ C482 00           ZiFi_FileLvlPak: DEFB #00
