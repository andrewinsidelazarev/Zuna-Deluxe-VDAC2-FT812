 748+ C521              ; ============================================================================
 749+ C521              ; VDC_SlotT — для A=i считает t = (HSA-i)*64 + HSub + sext(offsets[i]).
 750+ C521              ; Out: HL = signed 16-bit t.  AF/DE clobber.
 751+ C521              ; ============================================================================
 752+ C521              VDC_SlotT:
 753+ C521 4F                           LD   C, A                             ; C = i
 754+ C522 3A B1 D4                     LD   A, (VDC_HSA)
 755+ C525 91                           SUB  C
 756+ C526 30 04                        JR   NC, .delta_ok
 757+ C528                              ; i > HSA — слот логически до начала цепи. В рабочей Zuma
 758+ C528                              ; (BcsPreClassify) это PRESERVE/skip. Возвращаем signed-negative HL
 759+ C528                              ; чтобы VDC_SlotPos через `BIT 7, H` сделал SCF/RET (skip render +
 760+ C528                              ; skip bullet collision). Раньше тут был `XOR A` → clamp 0 →
 761+ C528                              ; шар рисовался у спавна и зацеплялся коллизией («застрявший шар»
 762+ C528                              ; после match-3/cascade с HsaDec). Codex 2026-05-14 diagnose, Claude fix.
 763+ C528 21 00 80                     LD   HL, #8000
 764+ C52B C9                           RET
 765+ C52C              .delta_ok:
 766+ C52C 26 00                        LD   H, 0
 766+ C52E 6F             LD L, A                    ; HL = delta
 767+ C52F                              ; VDC_CELL_SIZE=32: avoid generic ZL_Mul16x8 in the hot
 768+ C52F                              ; VDC_SlotPos path. This is hit once per rendered/collided ball.
 769+ C52F 29                           ADD  HL, HL
 770+ C530 29                           ADD  HL, HL
 771+ C531 29                           ADD  HL, HL
 772+ C532 29                           ADD  HL, HL
 773+ C533 29                           ADD  HL, HL                            ; HL = delta * VDC_CELL_SIZE
 774+ C534
 775+ C534                              ; + HSub (0..63 unsigned)
 776+ C534 3A D1 6C                     LD   A, (VDC_HSub)
 777+ C537 5F                           LD   E, A
 778+ C538 16 00                        LD   D, 0
 779+ C53A 19                           ADD  HL, DE
 780+ C53B
 781+ C53B                              ; + sext(offsets[i])
 782+ C53B 79                           LD   A, C
 783+ C53C E5                           PUSH HL
 784+ C53D 26 00                        LD   H, 0
 784+ C53F 6F             LD L, A
 785+ C540 ED 5B C0 D9                  LD   DE, (VDC_pOffsets)
 786+ C544 19                           ADD  HL, DE
 787+ C545 7E                           LD   A, (HL)
 788+ C546 5F                           LD   E, A
 789+ C547 16 00                        LD   D, 0
 790+ C549 CB 7F                        BIT  7, A
 791+ C54B 28 01                        JR   Z, .off_pos
 792+ C54D 15                           DEC  D                                ; sign-extend
 793+ C54E              .off_pos:
 794+ C54E E1                           POP  HL
 795+ C54F 19                           ADD  HL, DE
 796+ C550 C9                           RET
