  77+ C158                              ; --- 7. Переключить видеовыход TS-Conf → FT812 -----------
  78+ C158                              ; VID_FT812 (#04) = bit 2 FT_EN — выход через VDAC2.
  79+ C158                              ; VID_NOGFX (#20) = bit 5 NO_GFX — отключить TS-Conf gfx
  80+ C158                              ; (освобождает 448 DMA-циклов/строку для FT-передач).
  81+ C158                              Video_Setting VID_FT812 | VID_NOGFX
  81+ C158             >                ifdef MAPPING_REGISTERS
  81+ C158 21 00 04    >                LD HL, FMADDR_REGS + HIGH VCONFIG
  81+ C15B 36 24       >                LD (HL), VID_FT812 | VID_NOGFX & 0xFF
  81+ C15D             >                else
  81+ C15D ~           >                LD A, Value? & 0xFF
  81+ C15D ~           >                LD BC, VCONFIG
  81+ C15D ~           >                OUT (C), A
  81+ C15D             >                endif
  82+ C15D
  83+ C15D                              ; Успех
  84+ C15D AF                           XOR  A                                ; A=0, Z=1
  85+ C15E C9                           RET
  86+ C15F
  87+ C15F              .no_vdac2:      ; VDAC2 не обнаружен. Возвращаем NZ — пусть caller решает
  88+ C15F                              ; (fallback на оригинальный TS-Conf рендер 360×288 или Halt).
  89+ C15F 3E 01                        LD   A, 1
  90+ C161 B7                           OR   A                                ; Z=0
  91+ C162 C9                           RET
