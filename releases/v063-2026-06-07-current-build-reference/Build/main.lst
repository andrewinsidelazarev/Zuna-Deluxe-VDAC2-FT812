 213+ 7E67              ; ZL_EmitTranslate — append cmd_translate(tx, ty) в CMD буфер.
 214+ 7E67              ;   In:  HL = tx_int_px (signed 16), DE = ty_int_px (signed 16)
 215+ 7E67              ;   Параметры передаются в FT812 как fixed-point 1/65536 px:
 216+ 7E67              ;   tx_subpx = tx_px * 65536 → low_word = 0, high_word = tx_px.
