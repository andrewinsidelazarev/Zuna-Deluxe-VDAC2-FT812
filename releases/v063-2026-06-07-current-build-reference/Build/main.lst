3458  603E CD D2 61                     CALL VDC_WinOutroDone
3459  6041 B7                           OR   A
3460  6042 C8                           RET  Z                                    ; аутро ещё играет → ждём (таймер не нужен)
3461  6043 18 15                        JR   .win_show_done                       ; дорожка доиграла → диалог
3462  6045 3A BE D4     .legacy:        LD   A, (VDC_PreviewTick)
