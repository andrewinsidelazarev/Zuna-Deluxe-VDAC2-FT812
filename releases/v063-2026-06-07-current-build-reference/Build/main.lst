 412+ 6EFE D5                           PUSH DE
 413+ 6EFF 5F                           LD   E, A                       ; сохранить байт данных
 414+ 6F00 01 BB 00                     LD   BC, GS_PORT_CMD            ; #BB — статус
 415+ 6F03 21 FF FF                     LD   HL, GS_WAIT_TIMEOUT
 416+ 6F06 ED 78        .wdat:         IN   A, (C)
 417+ 6F08 07                           RLCA                            ; bit7 -> CF (1 = FIFO полон)
 418+ 6F09 30 09                        JR   NC, .datOk                 ; bit7=0 -> есть место
 419+ 6F0B 2B                           DEC  HL
 420+ 6F0C 7C                           LD   A, H
 421+ 6F0D B5                           OR   L
 422+ 6F0E 20 F6                        JR   NZ, .wdat
 423+ 6F10 D1                           POP  DE
 424+ 6F11 E1                           POP  HL
 425+ 6F12 B7                           OR   A                          ; таймаут -> CF=0
 426+ 6F13 C9                           RET
 427+ 6F14 7B           .datOk:        LD   A, E
 428+ 6F15 01 B3 00                     LD   BC, GS_PORT_DATA           ; #B3 — данные
 429+ 6F18 ED 79                        OUT  (C), A                     ; место есть -> пишем
 430+ 6F1A D1                           POP  DE
 431+ 6F1B E1                           POP  HL
 432+ 6F1C 37                           SCF
 433+ 6F1D C9                           RET
