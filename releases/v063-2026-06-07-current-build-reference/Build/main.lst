   4+ C000
   5+ C000              ; ============================================================================
   6+ C000              ; Init_Video — инициализация видеорежима 640×480 через VDAC2 / FT812
   7+ C000              ; ----------------------------------------------------------------------------
   8+ C000              ; Использует TSLib (DeadlyKom). Зависимости подключи в основном файле проекта:
   9+ C000              ;
  10+ C000              ;   include "Docs/TSLib/Include/TSConf.inc"            ; STATUS, VCONFIG, VID_*
  11+ C000              ;   include "Docs/TSLib/Include/Video/Macro.inc"       ; Video_Setting
  12+ C000              ;   include "Docs/TSLib/Include/FT/81x Const.inc"      ; FT_REG_*, VM_*, FT_INT_*
  13+ C000              ;   include "Docs/TSLib/Include/FT/812 Macro.inc"      ; FT_BOOT_UP, FT_RESOLUTION, FT_WR_REG8, FT_CMD_RESET
  14+ C000              ;   include "Docs/TSLib/Include/FT/812 Func.asm"       ; FT.WriteMem, FT.WriteDL, FT.SendCommand.Param
  15+ C000              ;   include "Docs/TSLib/Include/FT/DL  Macro.inc"      ; FT_CLEAR_COLOR_RGB, FT_CLEAR, FT_DISPLAY (DEFD-форма)
  16+ C000              ;
  17+ C000              ; Пользовательские константы (определи в Configuration.inc или Include.inc):
  18+ C000              ;   ResolutionWidthPtr   EQU <addr_word_in_RAM>   ; куда FT_RESOLUTION пишет ширину
  19+ C000              ;   ResolutionHeightPtr  EQU ResolutionWidthPtr+2 ; высоту
  20+ C000              ;
  21+ C000              ; Out:
  22+ C000              ;   A=0, Z=1   — успех (640×480 включён через FT812)
  23+ C000              ;   A=1, Z=0   — VDAC2 на этой плате не обнаружен (вызывающий выбирает fallback)
  24+ C000              ; Corrupts: AF, BC, DE, HL
  25+ C000              ; ============================================================================
  26+ C000
  27+ C000              Init_Video:     ; --- 1. Sanity-check: VDAC2 присутствует на плате? --------
  28+ C000                              ; TS-Conf STATUS [2:0] = 111 ⇒ FT812-VDAC2. Иначе плата с
  29+ C000                              ; обычным VDAC (5/4/3/2-bit) — на ней этот код работать не
  30+ C000                              ; будет, надо отдать управление обратно в TS-Config рендер.
  31+ C000 DB AF                        IN   A, (STATUS)
  32+ C002 E6 07                        AND  %00000111
  33+ C004 FE 07                        CP   %00000111
  34+ C006 C2 5F C1                     JP   NZ, .no_vdac2                    ; JP, не JR — FT_BOOT_UP большой
  35+ C009
  36+ C009                              ; --- 2. Полная boot-up последовательность FT812 ----------
  37+ C009                              ; FT_BOOT_UP (TSLib 812 Macro.inc:104):
  38+ C009                              ;   PWRDOWN_ → CLKEXT → CLKSEL #C0 → ACTIVE
  39+ C009                              ;   ждать REG_ID == 0x7C
  40+ C009                              ;   ждать REG_CPURESET == 0
  41+ C009                              ;   записать default тайминги, SWIZZLE/PCLK_POL/CSPREAD/DITHER/OUTBITS
  42+ C009                              ;   GPIOX_DIR=0xFFFF, GPIOX=0xFFFF (включить DISP)
  43+ C009                              ;   REG_PCLK = 2 (включает развёртку 60/2 = 30 МГц)
  44+ C009                              FT_BOOT_UP
  44+ C009             >                FT_SEND_COMMAND FT_CMD_PWRDOWN_
  44+ C009 06 50       >                LD B, FT_CMD_PWRDOWN_ & 0xFF
  44+ C00B CD 91 11    >                CALL FT.SendCommand
  44+ C00E             >                FT_DELAY 3
  44+ C00E 06 03       >                LD B, 3
  44+ C010 76          >                HALT
  44+ C011 10 FD       >                DJNZ $-1
  44+ C013             >
  44+ C013             >                FT_SEND_COMMAND FT_CMD_CLKEXT
  44+ C013 06 44       >                LD B, FT_CMD_CLKEXT & 0xFF
  44+ C015 CD 91 11    >                CALL FT.SendCommand
  44+ C018             >                FT_DELAY 3
  44+ C018 06 03       >                LD B, 3
  44+ C01A 76          >                HALT
  44+ C01B 10 FD       >                DJNZ $-1
  44+ C01D             >
  44+ C01D 06 61       >                LD B, FT_CMD_CLKSEL
  44+ C01F 0E C0       >                LD C, #C0
  44+ C021 CD 93 11    >                CALL FT.SendCommand.Param
  44+ C024             >
  44+ C024             >                FT_SEND_COMMAND FT_CMD_ACTIVE
  44+ C024 06 00       >                LD B, FT_CMD_ACTIVE & 0xFF
  44+ C026 CD 91 11    >                CALL FT.SendCommand
  44+ C029             >                FT_DELAY 15
  44+ C029 06 0F       >                LD B, 15
  44+ C02B 76          >                HALT
  44+ C02C 10 FD       >                DJNZ $-1
  44+ C02E             >
  44+ C02E             >.WaitIntReady   ; wait, FT812 is ready
  44+ C02E             >                FT_RD_REG8 FT_REG_ID
  44+ C02E D5          >                PUSH DE
  44+ C02F 3E 30       >                LD A, (FT_RAM_REG >> 16) & 0xFF
  44+ C031 11 00 20    >                LD DE, (FT_REG_ID) & 0xFFFF
  44+ C034 CD A5 11    >                CALL FT.Read8
  44+ C037 D1          >                POP DE
  44+ C038 FE 7C       >                CP #7C
  44+ C03A 20 F2       >                JR NZ, .WaitIntReady
  44+ C03C             >
  44+ C03C             >.WaitCPU_Reset  ; wait
  44+ C03C             >                FT_RD_REG8 FT_REG_CPURESET
  44+ C03C D5          >                PUSH DE
  44+ C03D 3E 30       >                LD A, (FT_RAM_REG >> 16) & 0xFF
