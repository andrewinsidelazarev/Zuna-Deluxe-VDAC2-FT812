1508+ F783              ; ----------------------------------------------------------------------------
1509+ F783              ; ZL_FT_CMD_Write_DMA — runtime FT_CMD_Write replacement using TS-Config DMA.
1510+ F783              ;   Sends CMD_ADDRESS_PTR..BufferPtr to FT_REG_CMDB_WRITE through DMA_RAM_SPI.
1511+ F783              ;   MainLoop calls this only after previous WaitFlush, so the FT812 command FIFO
1512+ F783              ;   should have enough free space for the whole frame buffer. Keep the legacy
1513+ F783              ;   FT_CMD_Write path behind ZL_FT_CMD_DMA_ENABLED for hardware fallback.
1514+ F783              ; ----------------------------------------------------------------------------
1515+ F783              ZL_CMD_DMA_PAGE EQU #05
1516+ F783              ZL_CMD_DMA_ADDR EQU #5010 & #3FFF
1517+ F783
1518+ F783              ZL_FT_CMD_Write_DMA:
1519+ F783                              FT_CMD_Count                            ; BC = byte count
1519+ F783 2A 35 14    >                        LD HL, (FT.Coprocessor.BufferPtr)
1519+ F786 11 F0 AF    >                        LD DE, (-#5010) & 0xFFFF
1519+ F789 19          >                        ADD HL, DE
1519+ F78A 44          >                        LD B, H
1519+ F78B 4D          >                        LD C, L
1520+ F78C 78                           LD   A, B
1521+ F78D B1                           OR   C
1522+ F78E C8                           RET  Z
1523+ F78F
1524+ F78F                              ; Convert byte count to word count for DMA registers.
1525+ F78F CB 38                        SRL  B
1526+ F791 CB 19                        RR   C
1527+ F793 78                           LD   A, B
1528+ F794 32 6D F8                     LD   (ZL_CmdDmaWordsHi), A              ; full 512-byte chunks
1529+ F797 79                           LD   A, C
1530+ F798 32 6E F8                     LD   (ZL_CmdDmaWordsLo), A              ; trailing words
1531+ F79B
1532+ F79B                              FT_ON
1532+ F79B 3E 07       >                LD A, SPI_FT_CS_ON
1532+ F79D D3 77       >                OUT (SPI_CTRL), A
1533+ F79F                              ; FT812 SPI memory-write header: 1,0,address[21:0], then payload.
1534+ F79F 3E B0                        LD   A, ((FT_REG_CMDB_WRITE >> 16) & #FF) | #80
1535+ F7A1 D3 57                        OUT  (SPI_DATA), A
1536+ F7A3 3E 25                        LD   A, (FT_REG_CMDB_WRITE >> 8) & #FF
1537+ F7A5 D3 57                        OUT  (SPI_DATA), A
1538+ F7A7 3E 78                        LD   A, FT_REG_CMDB_WRITE & #FF
1539+ F7A9 D3 57                        OUT  (SPI_DATA), A
1540+ F7AB
1541+ F7AB                              ; DMA source = CMD buffer in Core page #05, offset #1010.
1542+ F7AB 3E 10                        LD   A, LOW ZL_CMD_DMA_ADDR
1543+ F7AD 01 AF 1A                     LD   BC, DMASADDRL
1544+ F7B0 ED 79                        OUT  (C), A
1545+ F7B2 3E 10                        LD   A, HIGH ZL_CMD_DMA_ADDR
1546+ F7B4 01 AF 1B                     LD   BC, DMASADDRH
1547+ F7B7 ED 79                        OUT  (C), A
1548+ F7B9 3E 05                        LD   A, ZL_CMD_DMA_PAGE
1549+ F7BB 01 AF 1C                     LD   BC, DMASADDRX
1550+ F7BE ED 79                        OUT  (C), A
1551+ F7C0
1552+ F7C0                              ; Full 512-byte chunks: DMALEN=255 words, DMANUM=chunks-1.
1553+ F7C0 3A 6D F8                     LD   A, (ZL_CmdDmaWordsHi)
1554+ F7C3 B7                           OR   A
1555+ F7C4 28 1D                        JR   Z, .tail
1556+ F7C6 3D                           DEC  A
1557+ F7C7 01 AF 28                     LD   BC, DMANUM
1558+ F7CA ED 79                        OUT  (C), A
1559+ F7CC 3E FF                        LD   A, #FF
1560+ F7CE 01 AF 26                     LD   BC, DMALEN
1561+ F7D1 ED 79                        OUT  (C), A
1562+ F7D3 3E 82                        LD   A, DMA_RAM_SPI
1563+ F7D5 01 AF 27                     LD   BC, DMACTR
1564+ F7D8 ED 79                        OUT  (C), A
1565+ F7DA 01 AF 27     .wait_full:     LD   BC, DMASTATUS
1566+ F7DD ED 78                        IN   A, (C)
1567+ F7DF E6 80                        AND  DMA_WNR
1568+ F7E1 20 F7                        JR   NZ, .wait_full
1569+ F7E3
1570+ F7E3 3A 6E F8     .tail:          LD   A, (ZL_CmdDmaWordsLo)
1571+ F7E6 B7                           OR   A
1572+ F7E7 28 1C                        JR   Z, .done
1573+ F7E9 3D                           DEC  A
1574+ F7EA 01 AF 26                     LD   BC, DMALEN
1575+ F7ED ED 79                        OUT  (C), A
1576+ F7EF AF                           XOR  A
1577+ F7F0 01 AF 28                     LD   BC, DMANUM
1578+ F7F3 ED 79                        OUT  (C), A
1579+ F7F5 3E 82                        LD   A, DMA_RAM_SPI
1580+ F7F7 01 AF 27                     LD   BC, DMACTR
1581+ F7FA ED 79                        OUT  (C), A
1582+ F7FC 01 AF 27     .wait_tail:     LD   BC, DMASTATUS
1583+ F7FF ED 78                        IN   A, (C)
1584+ F801 E6 80                        AND  DMA_WNR
1585+ F803 20 F7                        JR   NZ, .wait_tail
1586+ F805
1587+ F805              .done:          FT_OFF
1587+ F805 3E 03       >                LD A, SPI_FT_CS_OFF
1587+ F807 D3 77       >                OUT (SPI_CTRL), A
1588+ F809 C9                           RET
