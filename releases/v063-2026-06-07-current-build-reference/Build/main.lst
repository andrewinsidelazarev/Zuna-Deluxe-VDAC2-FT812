1046+ C682 4E                           LD   C, (HL)
1047+ C683 3A D2 6C                     LD   A, (VDC_SlotsLen)
1048+ C686 90                           SUB  B
1049+ C687 26 00                        LD   H, 0
1049+ C689 6F             LD L, A
1050+ C68A ED 5B BE D9                  LD   DE, (VDC_pSlots)
1051+ C68E 19                           ADD  HL, DE
1052+ C68F 71                           LD   (HL), C
1053+ C690 C1                           POP  BC
1054+ C691 E1                           POP  HL
1055+ C692 18 01                        JR   .ac_explode_next
1056+ C694              .ac_explode_save:
1057+ C694 77                           LD   (HL), A
1058+ C695              .ac_explode_next:
1059+ C695 23                           INC  HL
1060+ C696 10 D1                        DJNZ .ac_explode
