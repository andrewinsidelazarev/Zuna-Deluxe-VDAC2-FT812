 114+ C439              ; Backwards-compat aliases (older wrappers below assume per-call swap).
 115+ C439              ; Now that we call ZiFi_Init/ZiFi_Done at session boundary, these can
 116+ C439              ; just RET — the slot-0 mapping is already #0F.
 117+ C439 C9           ZiFi_Enter:     RET
 118+ C43A C9           ZiFi_Leave:     RET
 119+ C43B
 120+ C43B              ; ---------------------------------------------------------------------
 121+ C43B              ; ZiFi_FEntry — search current dir for filename.
 122+ C43B              ;   In : HL → {flag, name, 0}
 123+ C43B              ;   Out: Z=not found; NZ=found, [DE:HL]=size; SEEK0 auto-called
 124+ C43B              ZiFi_FEntry:
 125+ C43B CD 39 C4                     CALL ZiFi_Enter
 126+ C43E CD 50 20                     CALL ZIFI_FENTRY
 127+ C441                              ; preserve result flags + DE/HL across Leave
 128+ C441 F5                           PUSH AF
 129+ C442 E5                           PUSH HL
 130+ C443 D5                           PUSH DE
 131+ C444 CD 3A C4                     CALL ZiFi_Leave
 132+ C447 D1                           POP  DE
 133+ C448 E1                           POP  HL
 134+ C449 F1                           POP  AF
 135+ C44A C9                           RET
 136+ C44B
 137+ C44B              ; ZiFi_Load512 — read B 512-byte blocks from current file into (C:HL).
 138+ C44B              ;   In : C=dest page, HL=offset (#0000..#3FFF slot-0 view), B=blocks
 139+ C44B              ;   Out: CHL advanced; A=#0F if end-of-chain
 140+ C44B              ZiFi_Load512:
 141+ C44B C3 28 CA                     JP   RawPak_ReadSectors
 142+ C44E
 143+ C44E              ; ZiFi_LoadNon — skip B sectors (seek forward).
 144+ C44E              ;   In : B=sectors
 145+ C44E              ZiFi_LoadNon:
 146+ C44E C3 1E CA                     JP   RawPak_SkipB
 147+ C451
 148+ C451              ; ZiFi_Seek0 — rewind current file to offset 0.
 149+ C451              ZiFi_Seek0:
 150+ C451 C3 10 CA                     JP   RawPak_Seek0
 151+ C454
 152+ C454              ; ZiFi_SetDir — chdir into directory found by previous FEntry.
 153+ C454              ZiFi_SetDir:
 154+ C454 CD 39 C4                     CALL ZiFi_Enter
 155+ C457 CD 5F 20                     CALL ZIFI_SETDIR
 156+ C45A CD 3A C4                     CALL ZiFi_Leave
 157+ C45D C9                           RET
