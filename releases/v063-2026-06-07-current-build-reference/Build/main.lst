   1+ DE79              ; ============================================================================
   2+ DE79              ; Frog.asm — рендер лягушки 1:1 с Zuma-Deluxe-HD/src/zuma/Frog.c.
   3+ DE79              ;
   4+ DE79              ; Композиция (Frog_Draw):
   5+ DE79              ;   • plate (no rotation) под body
   6+ DE79              ;   • body с rotation matrix вокруг центра, angle = atan2(mouse - frog).
   7+ DE79              ;     Native sprite face = south (BRAD 64), поэтому ZL_EmitRotate уже делает
   8+ DE79              ;     ADD A,192 (= -64) — передаём raw FrogAngle.
   9+ DE79              ;   • tongue с offset (tongueExpand · dir) и той же rotation matrix вокруг
  10+ DE79              ;     центра sprite. dir = (cos(angle), sin(angle)) (см. SinTable ниже).
  11+ DE79              ;
  12+ DE79              ; Recoil/fire (Frog_Update):
  13+ DE79              ;   ЛКМ rise edge → fireRecoilTick=0, isFire=1, ballExpand=0.
  14+ DE79              ;   Каждый кадр: tick += 10 BRAD (≈0.245 rad ≈ HD 0.25 rad/frame).
  15+ DE79              ;   recoil = sin(tick); пока recoil ≥ 0:
  16+ DE79              ;     tongueExpand = 24 - (recoil * 24) >> 7         ; язык втянут в рот
  17+ DE79              ;     ballExpand   = min(32, ballExpand + 2)         ; вылет шара
  18+ DE79              ;     pos.x = posStart.x - (cos(angle) * recoil) / 2048    ; ≈ -dir*recoil*8/128
  19+ DE79              ;     pos.y = posStart.y - (sin(angle) * recoil) / 2048
  20+ DE79              ;   recoil < 0 → end: tongueExpand=24, ballExpand=32, pos=posStart, isFire=0.
  21+ DE79              ;
  22+ DE79              ; FT812 BITMAP_HANDLE: 2=body, 4=plate, 5=tongue.
  23+ DE79              ; Frog layer format is selected by FROG_ARGB4_ENABLED in main.asm.
  24+ DE79              ; ============================================================================
  25+ DE79
  26+ DE79              FROG_SPR_W        EQU 122
  27+ DE79              FROG_SPR_HALF     EQU 61
  28+ DE79              FROG_SPR_HALF_NEG EQU -FROG_SPR_HALF & 0xFFFF          ; -61 в 16-bit two's-comp
  29+ DE79
  30+ DE79              ; Tongue full 122×122 ARGB4 — точный 1:1 перенос из Python visual_emulator.py.
  31+ DE79              ; Pivot UV (61, 61) = sprite centre = HD anchor (native sprite centre 81, 81 в
  32+ DE79              ; 162×162, после resize 162→122).  Screen rect совпадает со sprite size, sprite
  33+ DE79              ; circular fits в square rect при любом угле rotation, без clipping.
  34+ DE79              FROG_TONGUE_W     EQU 122                               ; sprite W в RAM_G
  35+ DE79              FROG_TONGUE_H     EQU 122                               ; sprite H в RAM_G
  36+ DE79              FROG_TONGUE_UV_HW EQU 61                                ; UV pivot = sprite centre
  37+ DE79              FROG_TONGUE_UV_HH EQU 61
  38+ DE79              FROG_TONGUE_SCR_W EQU 122
  39+ DE79              FROG_TONGUE_SCR_H EQU 122
  40+ DE79              FROG_TONGUE_SCR_HALF EQU 61
  41+ DE79              FROG_TONGUE_SCR_HALF_NEG EQU -FROG_TONGUE_SCR_HALF & 0xFFFF
  42+ DE79
  43+ DE79              ; Overlay 122×122 (= same size как body — features alignment ✓).
  44+ DE79
  45+ DE79              FROG_RECOIL_STEP  EQU 10                                ; BRAD/frame; π/0.25 ≈ 12.6 кадров полу-периода
  46+ DE79
  47+ DE79              FROG_BALL_IDLE    EQU 24                                ; HD: ballExpand idle 24 (= точное Python значение)
  48+ DE79              FROG_NEXT_OFFSET  EQU 28                                ; HD next-ball orbit (= точное Python значение)
  49+ DE79              FROG_BALL_W       EQU 32                                ; ball atlas cell native classic 32×32
  50+ DE79              FROG_BALL_DST_W   EQU 32                                ; screen size = native
  51+ DE79              FROG_BALL_DST_HALF EQU 16
  52+ DE79
  53+ DE79
  54+ DE79              ; ----------------------------------------------------------------------------
  55+ DE79              ; Frog_Init — обнулить state.  F12-reset не reload'ит RAM, поэтому всё
  56+ DE79              ; инициализируется явно.
  57+ DE79              ; ----------------------------------------------------------------------------
  58+ DE79 AF           Frog_Init:        XOR  A
  59+ DE7A 32 59 7E                       LD   (Frog_Angle), A
  60+ DE7D 32 64 E5                       LD   (Frog_RecoilTick), A
  61+ DE80 32 65 E5                       LD   (Frog_IsFire), A
  62+ DE83 32 09 50                       LD   (FROG_RTC_MIX_CNT_ADDR), A      ; slot 1 free RAM counter — F12 reset не чистит её сам
  63+ DE86 32 0A 50                       LD   (FROG_RTC_MIX_FLAG_ADDR), A     ; pending RTC mix flag
  64+ DE89 3D                             DEC  A                                ; A = #FF (was 0)
  65+ DE8A 32 0B 50                       LD   (FROG_EXCLUDE_COLOR_ADDR), A    ; exclude-color = 0xFF (none)
  66+ DE8D AF                             XOR  A                                ; restore A=0 для последующих stores
  67+ DE8E 3E 01                          LD   A, 1                            ; pre-init = pressed → no spurious
  68+ DE90 32 66 E5                       LD   (Frog_PrevMouseLeft), A         ; edge-rise на первом кадре
  69+ DE93 32 67 E5                       LD   (Frog_KeySpacePrev), A
