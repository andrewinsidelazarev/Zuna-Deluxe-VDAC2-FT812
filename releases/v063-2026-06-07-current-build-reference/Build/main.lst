 764+ 788D              ; ----------------------------------------------------------------------------
 765+ 788D              ; ClearRamGForMenu — явно стереть грязный хвост boot RAM_G перед главным меню.
 766+ 788D              ;   Вызывается в начале MenuMain (на КАЖДОМ входе в меню — после загрузки и при
 767+ 788D              ;   возврате из игры/level-select/more-games), ДО заливки ассетов меню.
 768+ 788D              ;   Зачем: реальный FT812 показал, что CMD_MEMZERO не является надёжным барьером
 769+ 788D              ;   для этого перехода. Поэтому для A/B-теста не используем копроцессор вообще:
 770+ 788D              ;   прямой SPI-записью затираем область boot progress/logo #0C8000..#0F8000.
 771+ 788D              ; ----------------------------------------------------------------------------
 772+ 788D              CLEAR_RAMG_TAIL_ADDR   EQU #0C8000
 773+ 788D              CLEAR_RAMG_TAIL_SIZE   EQU #030000
 774+ 788D              CLEAR_RAMG_CHUNK_SIZE  EQU #000400
 775+ 788D              CLEAR_RAMG_CHUNKS      EQU CLEAR_RAMG_TAIL_SIZE / CLEAR_RAMG_CHUNK_SIZE
 776+ 788D
 777+ 788D              ClearRamGForMenu:
 778+ 788D 3E 0C                        LD   A, (CLEAR_RAMG_TAIL_ADDR >> 16) & #FF
 779+ 788F 11 00 80                     LD   DE, CLEAR_RAMG_TAIL_ADDR & #FFFF
 780+ 7892 06 C0                        LD   B, CLEAR_RAMG_CHUNKS
 781+ 7894 C5           .wipe_loop:    PUSH BC
 782+ 7895 21 A2 78                     LD   HL, ClearRamGZeroBuf
 783+ 7898 01 00 04                     LD   BC, CLEAR_RAMG_CHUNK_SIZE
 784+ 789B CD 6A 12                     CALL FT.WriteMem                         ; advances A:DE by BC
 785+ 789E C1                           POP  BC
 786+ 789F 10 F3                        DJNZ .wipe_loop
 787+ 78A1 C9                           RET
 788+ 78A2
 789+ 78A2              ClearRamGZeroBuf:
 790+ 78A2 00 00 00...                  DEFS CLEAR_RAMG_CHUNK_SIZE
