   1++C2D9              ;//////////////////////////////////////////////////////////////
   2++C2D9              ;//  Self-contained SD (Z-Controller) raw sector read.
   3++C2D9              ;//  Ported from the WC device driver DSDZC.ASM read path
   4++C2D9              ;//  (via Desktop/WC/Chkdsk/src/sd_zc.a80 by the ChkDsk session).
   5++C2D9              ;//  The card is already initialised by WC before the SPG launches
   6++C2D9              ;//  (hardware state persists), so we only issue CMD17 reads.
   7++C2D9              ;//
   8++C2D9              ;//  This BYPASSES the bundled TS-DOS driver, whose FAT chain walk
   9++C2D9              ;//  drifts -128 sectors at the first FAT-sector boundary in our SPG
  10++C2D9              ;//  context. We do our own BPB/FAT walk on top of sd_read_sector.
  11++C2D9              ;//
  12++C2D9              ;//  Unreal/this host uses BYTE addressing (sd_blkt = 0): the CMD17
  13++C2D9              ;//  argument is LBA*512. (Real SDHC would use block addressing.)
  14++C2D9              ;//////////////////////////////////////////////////////////////
  15++C2D9
  16++C2D9              SD_CONF         equ     #77             ; config / chip-select port
  17++C2D9              SD_DATA         equ     #57             ; data port
  18++C2D9              SD_CMD17        equ     %01000000+17    ; single-block read
  19++C2D9              SD_CS1          equ     %00000001       ; chip select, SD1
  20++C2D9
  21++C2D9              ;--- sd_init: byte addressing (Unreal). sd_blkt = 0.
  22++C2D9              sd_init:
  23++C2D9 AF                           xor     a
  24++C2DA 32 04 C4                     ld      (sd_blkt),a
  25++C2DD CD 53 C3                     call    sd_csh
  26++C2E0 CD B0 C3                     call    sd_snb
  27++C2E3 C9                           ret
  28++C2E4
  29++C2E4              ;--- sd_read_sector: read one 512-byte sector
  30++C2E4              ;    in:  HL = LBA (low 16), DE = LBA (high 16)  [LBA is 32-bit]
  31++C2E4              ;         IX = destination buffer (512 bytes)
  32++C2E4              ;    out: CF = 1 on error, CF = 0 on success
  33++C2E4              sd_read_sector:
  34++C2E4 22 00 C4                     ld      (sd_lba+0),hl
  35++C2E7 ED 53 02 C4                  ld      (sd_lba+2),de
  36++C2EB CD CE C3                     call    sd_lba_in_range         ; защита: не слать CMD17 за пределы тома —
  37++C2EE 38 1E                        jr      c,.range                ; битый LBA иначе кирпичит реальную SDHC до переткивания
  38++C2F0 DD E5                        push    ix
  39++C2F2 E1                           pop     hl                      ; HL = buffer
  40++C2F3 CD 10 C3                     call    sd_cmd17
  41++C2F6 20 11                        jr      nz,.err                 ; R1 must be #00
  42++C2F8 CD 92 C3                     call    sd_wait_token
  43++C2FB 38 0C                        jr      c,.err
  44++C2FD CD 49 C3                     call    sd_reads                ; read 512 bytes -> (HL), HL += 512
  45++C300 DB 57                        in      a,(SD_DATA)             ; CRC16 lo (ignored)
  46++C302 DB 57                        in      a,(SD_DATA)             ; CRC16 hi (ignored)
  47++C304 CD 53 C3                     call    sd_csh
  48++C307 B7                           or      a                       ; CF=0
  49++C308 C9                           ret
  50++C309 CD 53 C3     .err            call    sd_csh
  51++C30C 37                           scf
  52++C30D C9                           ret
  53++C30E 37           .range          scf                             ; LBA вне тома — карту не трогаем вообще
  54++C30F C9                           ret
  55++C310
  56++C310              ;--- CMD17 (single-block read). Address from sd_lba.
  57++C310              ;    byte addressing (sd_blkt==0): argument = LBA*512 (byte offset).
  58++C310              ;    Preserves HL (caller's buffer pointer). Port of DSDZC CMDz.
  59++C310              sd_cmd17:
  60++C310 3E 51                        ld      a,SD_CMD17
  61++C312 CD 53 C3                     call    sd_csh
  62++C315 CD 66 C3                     call    sd_csl
  63++C318 E5                           push    hl                      ; preserve buffer pointer
  64++C319 ED 5B 00 C4                  ld      de,(sd_lba+0)           ; DE = LBA low16
  65++C31D ED 4B 02 C4                  ld      bc,(sd_lba+2)           ; BC = LBA high16
  66++C321 69                           ld      l,c
  67++C322 60                           ld      h,b                     ; HL = high16
  68++C323 4F                           ld      c,a                     ; C = command
  69++C324 3A 04 C4                     ld      a,(sd_blkt)
  70++C327 B7                           or      a
  71++C328 20 09                        jr      nz,.send                ; block addressing -> send LBA as-is
  72++C32A                              ; byte addressing: [HL:DE] = LBA*512  (x2 then x256 byte-shift)
  73++C32A EB                           ex      de,hl
  73++C32B 29             add hl,hl
  74++C32C EB                           ex      de,hl
  74++C32D ED 6A          adc hl,hl
  75++C32F 65                           ld      h,l
  75++C330 6A             ld l,d
  75++C331 53             ld d,e
  75++C332 5F             ld e,a  ; A=sd_blkt=0 here
  76++C333              .send
  77++C333 79                           ld      a,c                     ; A = command
  78++C334 01 57 00                     ld      bc,SD_DATA
  79++C337 ED 79                        out     (c),a                   ; command byte
  80++C339 ED 61                        out     (c),h
  81++C33B ED 69                        out     (c),l
  82++C33D ED 51                        out     (c),d
  83++C33F ED 59                        out     (c),e
  84++C341 3E FF                        ld      a,#FF
  85++C343 ED 79                        out     (c),a                   ; CRC (ignored)
  86++C345 E1                           pop     hl                      ; restore buffer pointer
  87++C346 C3 BB C3                     jp      sd_resp
  88++C349
  89++C349              ;--- read 512 bytes from data port into (HL); HL advances by 512
  90++C349              sd_reads:
  91++C349 C5                           push    bc
  92++C34A 01 57 00                     ld      bc,SD_DATA              ; B=0 -> 256 per INIR
  93++C34D ED B2                        inir
  94++C34F ED B2                        inir
  95++C351 C1                           pop     bc
  96++C352 C9                           ret
  97++C353
  98++C353              ;--- chip select high (deselect) + clock
  99++C353              sd_csh:
 100++C353 C5                           push    bc
 100++C354 F5             push af
 101++C355 01 77 00                     ld      bc,SD_CONF
 101++C358 3E 03          ld a,%00000011
 101++C35A ED 79          out (c),a
 102++C35C 01 57 00                     ld      bc,SD_DATA
 102++C35F 3E FF          ld a,#FF
 102++C361 ED 79          out (c),a
 103++C363 F1                           pop     af
 103++C364 C1             pop bc
 104++C365 C9                           ret
 105++C366
 106++C366              ;--- chip select low (select) + clock, then wait ready
 107++C366              sd_csl:
 108++C366 C5                           push    bc
 108++C367 F5             push af
 109++C368 01 77 00                     ld      bc,SD_CONF
 109++C36B 3E 01          ld a,SD_CS1
 109++C36D ED 79          out (c),a
 110++C36F 01 57 00                     ld      bc,SD_DATA
 110++C372 3E FF          ld a,#FF
 110++C374 ED 79          out (c),a
 111++C376 F1                           pop     af
 111++C377 C1             pop bc
 112++C378 C3 7B C3                     jp      sd_wait
 113++C37B
 114++C37B              ;--- wait until card returns #FF (ready), BOUNDED. Never spin forever: if the
 115++C37B              ;    card stays busy we give up so a read fails cleanly (-> CF=1 -> L1 fallback)
 116++C37B              ;    instead of hanging the SD/SPI bus, which would also wedge WC's next SPG load.
 117++C37B              sd_wait:
 118++C37B C5                           push    bc
 118++C37C D5             push de
 118++C37D F5             push af
 119++C37E 01 57 00                     ld      bc,SD_DATA
 120++C381 11 00 00                     ld      de,0                    ; 65536 polls then give up
 121++C384 ED 78        .w              in      a,(c)
 121++C386 3C             inc a
 121++C387 28 05          jr z,.done   ; #FF -> ready
 122++C389 1B                           dec     de
 122++C38A 7A             ld a,d
 122++C38B B3             or e
 122++C38C 20 F6          jr nz,.w
 123++C38E F1           .done           pop     af
 123++C38F D1             pop de
 123++C390 C1             pop bc
 124++C391 C9                           ret
 125++C392
 126++C392              ;--- wait for data token #FE with bounded timeout.
 127++C392              ;    out: CF=0 token received, CF=1 timeout/error token.
 128++C392              sd_wait_token:
 129++C392 C5                           push    bc
 130++C393 01 57 00                     ld      bc,SD_DATA
 131++C396 16 04                        ld      d,4
 132++C398 1E 00        .outer          ld      e,0
 133++C39A ED 78        .inner          in      a,(c)
 134++C39C FE FE                        cp      #FE
 135++C39E 28 0D                        jr      z,.ok
 136++C3A0 CB 7F                        bit     7,a
 137++C3A2 28 06                        jr      z,.err                  ; data error token (0xxxxxxx)
 138++C3A4 1D                           dec     e
 139++C3A5 20 F3                        jr      nz,.inner
 140++C3A7 15                           dec     d
 141++C3A8 20 EE                        jr      nz,.outer
 142++C3AA C1           .err            pop     bc
 143++C3AB 37                           scf
 144++C3AC C9                           ret
 145++C3AD C1           .ok             pop     bc
 146++C3AE B7                           or      a
 147++C3AF C9                           ret
 148++C3B0
 149++C3B0              ;--- 16 dummy reads
 150++C3B0              sd_snb:
 151++C3B0 C5                           push    bc
 151++C3B1 F5             push af
 152++C3B2 06 10                        ld      b,16
 153++C3B4 DB 57        .s              in      a,(SD_DATA)
 153++C3B6 10 FC          djnz .s
 154++C3B8 F1                           pop     af
 154++C3B9 C1             pop bc
 155++C3BA C9                           ret
 156++C3BB
 157++C3BB              ;--- read R1 response (bit7=0), up to 10 tries
 158++C3BB              sd_resp:
 159++C3BB D5                           push    de
 159++C3BC C5             push bc
 160++C3BD 01 57 00                     ld      bc,SD_DATA
 161++C3C0 16 0A                        ld      d,10
 162++C3C2 ED 78        .r              in      a,(c)
 162++C3C4 CB 7F          bit 7,a
 162++C3C6 28 03          jr z,.done
 163++C3C8 15                           dec     d
 163++C3C9 20 F7          jr nz,.r
 164++C3CB C1           .done           pop     bc
 164++C3CC D1             pop de
 165++C3CD C9                           ret
 166++C3CE
 167++C3CE              ;--- sd_lba_in_range: проверка sd_lba против верхней границы тома sd_lba_max.
 168++C3CE              ;    out: CF=1 — отвергнуть (sd_lba >= sd_lba_max); CF=0 — ок ИЛИ защита выключена.
 169++C3CE              ;    sd_lba_max==0 => защита выключена (до парса BPB, для bootstrap-чтений).
 170++C3CE              ;    Сохраняет HL/DE/BC; клобает A/флаги (результат — в CF).
 171++C3CE              sd_lba_in_range:
 172++C3CE E5                           push    hl
 172++C3CF D5             push de
 172++C3D0 C5             push bc
 173++C3D1 3A 05 C4                     ld      a,(sd_lba_max+0)        ; sd_lba_max == 0 ?
 174++C3D4 47                           ld      b,a
 175++C3D5 3A 06 C4                     ld      a,(sd_lba_max+1)
 175++C3D8 B0             or b
 175++C3D9 47             ld b,a
 176++C3DA 3A 07 C4                     ld      a,(sd_lba_max+2)
 176++C3DD B0             or b
 176++C3DE 47             ld b,a
 177++C3DF 3A 08 C4                     ld      a,(sd_lba_max+3)
 177++C3E2 B0             or b
 178++C3E3 28 16                        jr      z,.disabled             ; все нули -> защита выключена
 179++C3E5 21 00 C4                     ld      hl,sd_lba
 180++C3E8 11 05 C4                     ld      de,sd_lba_max
 181++C3EB B7                           or      a                       ; CF=0 перед многобайтовым вычитанием
 182++C3EC 06 04                        ld      b,4
 183++C3EE 1A           .cmp            ld      a,(de)                  ; sd_lba - sd_lba_max побайтно (LE)
 184++C3EF 4F                           ld      c,a
 185++C3F0 7E                           ld      a,(hl)
 186++C3F1 99                           sbc     a,c
 187++C3F2 23                           inc     hl
 188++C3F3 13                           inc     de
 189++C3F4 10 F8                        djnz    .cmp                    ; INC/DJNZ не трогают CF -> заём проходит насквозь
 190++C3F6 3F                           ccf                             ; заём(CF=1, sd_lba<max)->0 ок ; CF=0(>=max)->1 отвергнуть
 191++C3F7 C1                           pop     bc
 191++C3F8 D1             pop de
 191++C3F9 E1             pop hl
 192++C3FA C9                           ret
 193++C3FB C1           .disabled       pop     bc
 193++C3FC D1             pop de
 193++C3FD E1             pop hl
 194++C3FE B7                           or      a                       ; CF=0 (в диапазоне)
 195++C3FF C9                           ret
 196++C400
 197++C400              ;--- SD state ---
 198++C400 00 00 00 00  sd_lba          ds      4
 199++C404 00           sd_blkt         db      0
 200++C405 00 00 00 00  sd_lba_max      ds      4               ; верхняя граница LBA тома (PartLba+TotSec32); 0=выключено
