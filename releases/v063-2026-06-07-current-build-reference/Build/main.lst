 463  179C              ; ============================================================================
 464  179C              ; DrawKillzoneDual — dual-pass kill-zone draw: hole (cell 0) под skull (cell N).
 465  179C              ; Перенесён сюда из Core.MainLoop чтобы освободить байты Core (Core был
 466  179C              ; 8189/8192). Должен вызываться внутри активного FT_Begin FT_BITMAPS блока.
 467  179C              ;
 468  179C              ; Координаты центра kill-zone — per-level setting (KZ_DEFAULT_X/Y).  Не из
 469  179C              ; track end: track[N-1] не обязан попадать в визуальный центр sun-черепа в bg
 470  179C              ; (cell-grid CELL_SIZE=32 ≠ pixel-aligned bg art).  Для level 1 (Spiral of Doom)
 471  179C              ; центр bg-bbox золотых пикселей = (208, 217).
 472  179C              ; ============================================================================
 473  179C              KZ_DEFAULT_X       EQU 211
 474  179C              KZ_DEFAULT_Y       EQU 217
 475  179C              KZ_SPR_W           EQU 88
 476  179C              KZ_SPR_H           EQU 88
 477  179C              KZ_SPR_HALF        EQU 44
 478  179C              FROG_DEFAULT_X     EQU 327
 479  179C              FROG_DEFAULT_Y     EQU 231
 480  179C
 481  179C              ; Room transitions keep the old DL visible until it is fully covered by a
 482  179C              ; black overlay. RAM_G can then be reloaded without exposing half-written art.
 483  179C              FadeMenuToLevelSelect:
 484  179C 21 FF C3                     LD   HL, Core.MenuBuildFrame
 485  179F CD 1E 18                     CALL FadeOutRoom
 486  17A2                              ; First time only: the PAK sector map isn't built yet, so the
 487  17A2                              ; upcoming asset load runs the (slow) recursive search. Show
 488  17A2                              ; "LOADING LEVELS..." over the faded-out menu while it works.
 489  17A2                              ; Later transitions reuse the cached map -> near-instant, no message.
 490  17A2 3A 4D 6F                     LD   A, (Core.LevelsMapLoaded)
 491  17A5 B7                           OR   A
 492  17A6 20 06                        JR   NZ, .skip_loading
 493  17A8 CD B1 17                     CALL UploadLoadingText                  ; залить баннер в RAM_G #084000 (меню погашено)
 494  17AB CD CD 62                     CALL Core.DrawLoadingLevelsScreen
 495  17AE              .skip_loading:
 496  17AE C3 5C CD                     JP   Core.LevelSelect
 497  17B1
 498  17B1              ; UploadLoadingText — расжать «LOADING LEVELS...» (nativealien48 48px) в RAM_G
 499  17B1              ; #084000. Зона свободна в профиле level-select (#082658..#098000), поэтому баннер
 500  17B1              ; переживает медленный поиск PAK, пока кадр отрисован. Вызывать ДО DrawLoadingScreen.
 501  17B1              UploadLoadingText:
 502  17B1 21 00 40                     LD   HL, LOADING_TEXT_RAMG & 0xFFFF
 503  17B4 22 B8 68                     LD   (Core.BgRamL), HL
 504  17B7 3E 08                        LD   A, (LOADING_TEXT_RAMG >> 16) & 0xFF
 505  17B9 32 BA 68                     LD   (Core.BgRamH), A
 506  17BC 3E 25                        LD   A, LOADING_TEXT_PAGE_BASE
 507  17BE 06 03                        LD   B, LOADING_TEXT_NUM_PAGES
 508  17C0 C5           .ult_loop:      PUSH BC
 509  17C1 F5                           PUSH AF
 510  17C2 CD 1B 3C                     CALL UnpackAndUploadPage                ; advances RAM_G +16K
 511  17C5 F1                           POP  AF
 512  17C6 3C                           INC  A
 513  17C7 C1                           POP  BC
 514  17C8 10 F6                        DJNZ .ult_loop
 515  17CA C9                           RET
