1480+ F773              ; ZL_SpinPhase — A = ((t * ZL_SPIN_K_DEFAULT) >> 8) & ZL_SPIN_MASK.
1481+ F773              ;   In: HL = VDC_LastT. Out: A = spin phase. Scratch: BC, DE, HL, AF.
1482+ F773              ;   Current ARGB4 build has K=81, so avoid the 8-iteration generic multiply in
1483+ F773              ;   the per-ball render hot path. If compile-time K changes, fall back safely.
1484+ F773              ; ----------------------------------------------------------------------------
1485+ F773              ZL_SpinPhase:
1486+ F773                              if ZL_SPIN_K_DEFAULT = 81
1487+ F773 54                           LD   D, H
1487+ F774 5D             LD E, L                    ; DE = t
1488+ F775 29                           ADD  HL, HL
1489+ F776 29                           ADD  HL, HL
1490+ F777 29                           ADD  HL, HL
1491+ F778 29                           ADD  HL, HL                            ; HL = t * 16
1492+ F779 44                           LD   B, H
1492+ F77A 4D             LD C, L                    ; BC = t * 16
1493+ F77B 29                           ADD  HL, HL
1494+ F77C 29                           ADD  HL, HL                            ; HL = t * 64
1495+ F77D 09                           ADD  HL, BC                            ; HL = t * 80
1496+ F77E 19                           ADD  HL, DE                            ; HL = t * 81
1497+ F77F 7C                           LD   A, H
1498+ F780 E6 0F                        AND  ZL_SPIN_MASK
1499+ F782 C9                           RET
1500+ F783                              else
1501+ F783 ~                            LD   A, (ZL_SpinK)
1502+ F783 ~                            CALL ZL_Mul16x8
1503+ F783 ~                            LD   A, H
1504+ F783 ~                            AND  ZL_SPIN_MASK
1505+ F783 ~                            RET
1506+ F783                              endif
