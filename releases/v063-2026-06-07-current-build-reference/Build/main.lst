4605  E024              LoaderOvl_End:
4606  E024                              endmodule
4607  E024
4608  E024              Main0_Size       EQU Core.Main0_End - Core.Start
4609  E024              Main1_Size       EQU Core.Main1_End - Core.Main1_Start
4610  E024              UiOvl_Size       EQU Core.UiOvl_End - Core.UiOvl_Start
4611  E024              LoaderOvl_Size   EQU Core.LoaderOvl_End - Core.LoaderOvl_Start
4612  E024                              display "Main0:    \t", /A, Core.Start,        " size=", /D, Main0_Size,     " bytes (slot 1 page 5)"
4613  E024                              display "Main1:    \t", /A, Core.Main1_Start,  " size=", /D, Main1_Size,     " bytes (slot 3 page #04, gameplay)"
4614  E024                              display "UiOvl:    \t", /A, Core.UiOvl_Start,  " size=", /D, UiOvl_Size,     " bytes (slot 3 page #41, ui)"
4615  E024                              display "LoaderOvl:\t", /A, Core.LoaderOvl_Start, " size=", /D, LoaderOvl_Size, " bytes (slot 3 page #40)"
4616  E024                              ; main1_play (#04), the UI overlay (#41) and the loader overlay (#40)
4617  E024                              ; all assemble at logical #C000 on different physical pages. Map the
4618  E024                              ; right page into the slot before EACH SAVEBIN, else SAVEBIN dumps
4619  E024                              ; whichever page was mapped last into the wrong .bin — corrupting it.
4620  E024                              SLOT 1
4620  E024                PAGE #05
4621  E024                              SAVEBIN "Build/Core.bin",        Core.Start,       Main0_Size
4622  E024                              SLOT 3
4622  E024                PAGE #04
4623  E024                              SAVEBIN "Build/main1_play.bin",  Core.Main1_Start, Main1_Size
4624  E024                              SLOT 3
4624  E024                PAGE UI_OVL_PAGE
4625  E024                              SAVEBIN "Build/ui_ovl.bin",      Core.UiOvl_Start, UiOvl_Size
4626  E024                              SLOT 3
4626  E024                PAGE Core.LOADER_OVL_PAGE
4627  E024                              SAVEBIN "Build/loader_ovl.bin",  Core.LoaderOvl_Start, LoaderOvl_Size
4628  E024
4629  E024                              END EntryPoint
