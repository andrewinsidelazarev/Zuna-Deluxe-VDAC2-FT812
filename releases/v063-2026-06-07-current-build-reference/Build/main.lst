1030+ C669              .ac_explode:
1031+ C669 7E                           LD   A, (HL)
1032+ C66A B7                           OR   A
1033+ C66B 28 28                        JR   Z, .ac_explode_next
1034+ C66D 3C                           INC  A
1035+ C66E FE 10                        CP   VDC_EXPLOSION_FRAMES + 1
1036+ C670 38 22                        JR   C, .ac_explode_save
1037+ C672 AF                           XOR  A
1038+ C673 77                           LD   (HL), A
1039+ C674 E5                           PUSH HL
1040+ C675 C5                           PUSH BC
1041+ C676 3A D2 6C                     LD   A, (VDC_SlotsLen)
1042+ C679 90                           SUB  B
1043+ C67A 26 00                        LD   H, 0
1043+ C67C 6F             LD L, A
