  71+ C148                              ; --- 6. Разрешить SWAP-interrupt -------------------------
  72+ C148                              ; MainLoop ждёт этот INT_FLAG чтобы синхронизироваться
  73+ C148                              ; с vsync (см. Examples\2.HelloWorld\Core\MainLoop.asm).
  74+ C148                              FT_WR_REG8 FT_REG_INT_MASK, FT_INT_SWAP
  74+ C148 3E 01       >                LD A, FT_INT_SWAP & 0xFF
  74+ C14A 11 B0 20    >                LD DE, FT_REG_INT_MASK & 0xFFFF
  74+ C14D CD 1B 12    >                CALL FT.WriteReg8
