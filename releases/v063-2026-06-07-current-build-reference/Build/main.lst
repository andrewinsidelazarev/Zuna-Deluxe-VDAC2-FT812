 412+ E148              ; Frog_DrawTongue — handle 5, tight-crop sprite 32×80, на pos + tongueExpand·dir,
 413+ E148              ; rotation вокруг tongue centre.
 414+ E148              ;   tongueX = pos.x + (cos(angle) * tongueExpand) / 128
 415+ E148              ;   tongueY = pos.y + (sin(angle) * tongueExpand) / 128
 416+ E148              ;   matrix  = T(16, 40) · R(angle + 192) · T(-16, -40)
 417+ E148              ; Tongue native = south (tip внизу 32×80 кадра); rotation как у body.
 418+ E148              ; ----------------------------------------------------------------------------
 419+ E148              Frog_DrawTongue:
 420+ E148                                ; HD-style: tongue centre = pos + tongueExpand·dir (orbit).
 421+ E148                                ; tongueExpand=24 idle, втягивается до 0 при выстреле.
 422+ E148                                ;   offsetX = (cos(angle) · tongueExpand) / 128
 423+ E148                                ;   offsetY = (sin(angle) · tongueExpand) / 128
