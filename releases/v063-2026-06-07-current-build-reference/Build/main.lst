4288  69D6 32 53 6C                     LD   (PauseFadeTimer), A
4289  69D9 28 10                        JR   Z, .pf_done
4290  69DB                              ; VDC_PauseAlpha = min(255, timer * 4)
4291  69DB 6F                           LD   L, A
4292  69DC 26 00                        LD   H, 0
4293  69DE 29                           ADD  HL, HL
4294  69DF 29                           ADD  HL, HL                             ; HL = timer*4
4295  69E0 7C                           LD   A, H
4296  69E1 B7                           OR   A
4297  69E2 3E FF                        LD   A, 255
4298  69E4 20 01                        JR   NZ, .pf_set                        ; >=256 -> clamp
