 340+ C399
 341+ C399              ; ----------------------------------------------------------------------------
 342+ C399              ; Клавиатурная навигация главного меню. Активные кнопки (порядок навигации):
 343+ C399              ;   0 = Adventure, 1 = More (Gauntlet/Options/Quit без действия — пропущены).
 344+ C399              ; Вверх/Вниз ходят по списку (по просьбе юзера ТОЛЬКО Вверх/Вниз — Влево/Вправо в
 345+ C399              ;   этом меню НЕ участвуют). Огонь = нажатие текущей кнопки (тот же Click-флаг, что
 346+ C399              ;   и мышь).
 347+ C399              ; Зовётся ПОСЛЕ MenuUpdateButtons (тот сбросил Click-флаги и проставил hover мышью).
 348+ C399              ; ----------------------------------------------------------------------------
 349+ C399              MenuKeyboardNav:
 350+ C399                              ; nav-вверх = Up
 351+ C399 CD 6D 7F                     CALL Input_Up
 352+ C39C 21 59 CD                     LD   HL, MenuKbdUpPrev
 353+ C39F CD C1 7F                     CALL Input_EdgeZ
 354+ C3A2 28 0A                        JR   Z, .chk_down
 355+ C3A4 3A 58 CD                     LD   A, (MenuSelection)
 356+ C3A7 B7                           OR   A
 357+ C3A8 28 04                        JR   Z, .chk_down                          ; уже на верхней (Adventure)
 358+ C3AA 3D                           DEC  A
 359+ C3AB 32 58 CD                     LD   (MenuSelection), A
 360+ C3AE              .chk_down:      ; nav-вниз = Down
 361+ C3AE CD 7C 7F                     CALL Input_Down
 362+ C3B1 21 5A CD                     LD   HL, MenuKbdDownPrev
 363+ C3B4 CD C1 7F                     CALL Input_EdgeZ
 364+ C3B7 28 0B                        JR   Z, .highlight
 365+ C3B9 3A 58 CD                     LD   A, (MenuSelection)
 366+ C3BC FE 01                        CP   1
 367+ C3BE 30 04                        JR   NC, .highlight                        ; уже на нижней активной (More)
 368+ C3C0 3C                           INC  A
 369+ C3C1 32 58 CD                     LD   (MenuSelection), A
 370+ C3C4 CD E6 C3     .highlight:     CALL MenuHighlightSelection
 371+ C3C7                              ; огонь = выбор текущей кнопки
 372+ C3C7 CD A9 7F                     CALL Input_FireKey
 373+ C3CA 21 5B CD                     LD   HL, MenuKbdFirePrev
 374+ C3CD CD C1 7F                     CALL Input_EdgeZ
 375+ C3D0 C8                           RET  Z
 376+ C3D1 3A 58 CD                     LD   A, (MenuSelection)
 377+ C3D4 B7                           OR   A
 378+ C3D5 20 06                        JR   NZ, .not_adv
 379+ C3D7 3E 01                        LD   A, 1
 379+ C3D9 32 50 CD       LD (MenuAdventureClick), A
 379+ C3DC C9             RET
 380+ C3DD FE 01        .not_adv:       CP   1
 381+ C3DF C0                           RET  NZ
 382+ C3E0 3E 01                        LD   A, 1
 382+ C3E2 32 51 CD       LD (MenuMoreClick), A
 383+ C3E5 C9                           RET
