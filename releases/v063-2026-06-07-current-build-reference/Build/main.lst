 420+ C302              ; ============================================================================
 421+ C302              ; ReadRTCSeconds — TS-Conf GLUK CMOS RTC, регистр 0 (секунды BCD).
 422+ C302              ; Порты #DFF7 (адрес) / #BFF7 (данные). Out: A = 0..59 binary.
 423+ C302              ; ============================================================================
 424+ C302              ReadRTCSeconds:
 425+ C302                              ; Mr.Gluk activation на порт #EFF7 (за ZiFi/WC: zifi.asm:4207).
 426+ C302                              ; OUT #EFF7, #80 — enable; #00 — disable.
 427+ C302 01 F7 EF                     LD   BC, #EFF7
 428+ C305 3E 80                        LD   A, #80
 429+ C307 ED 79                        OUT  (C), A
 430+ C309 01 F7 DF                     LD   BC, #DFF7
 431+ C30C AF                           XOR  A
 432+ C30D ED 79                        OUT  (C), A                            ; reg 0 = seconds
 433+ C30F 01 F7 BF                     LD   BC, #BFF7
 434+ C312 ED 78                        IN   A, (C)                            ; A = BCD seconds
 435+ C314 32 0E 50                     LD   (#500E), A                        ; DEBUG: raw byte
 436+ C317 F5                           PUSH AF
 437+ C318 01 F7 EF                     LD   BC, #EFF7
 438+ C31B AF                           XOR  A
 439+ C31C ED 79                        OUT  (C), A                            ; deactivate Mr.Gluk
 440+ C31E F1                           POP  AF
 441+ C31F 47                           LD   B, A
 442+ C320 E6 0F                        AND  $0F                               ; low nibble
 443+ C322 4F                           LD   C, A
 444+ C323 78                           LD   A, B
 445+ C324 E6 F0                        AND  $F0
 446+ C326 CB 3F                        SRL  A
 446+ C328 CB 3F          SRL A
 446+ C32A CB 3F          SRL A
 446+ C32C CB 3F          SRL A         ; high nibble (0..5)
 447+ C32E 47                           LD   B, A
 448+ C32F                              ; A = high*10 + low
 449+ C32F 87                           ADD  A, A
 449+ C330 87             ADD A, A
 449+ C331 80             ADD A, B        ; *5
 450+ C332 87                           ADD  A, A                              ; *10
 451+ C333 81                           ADD  A, C
 452+ C334 C9                           RET
 453+ C335
 454+ C335              ; ============================================================================
 455+ C335              ; ReadRTCRegister — generic, A = register index (0=sec, 2=min, 4=hour).
 456+ C335              ; Out: A = BCD-parsed binary value.
 457+ C335              ; ============================================================================
 458+ C335              ReadRTCRegister:
 459+ C335 5F                           LD   E, A                              ; E = reg index
 460+ C336 01 F7 EF                     LD   BC, #EFF7
 461+ C339 3E 80                        LD   A, #80
 462+ C33B ED 79                        OUT  (C), A                            ; activate Mr.Gluk
 463+ C33D 01 F7 DF                     LD   BC, #DFF7
 464+ C340 7B                           LD   A, E
 465+ C341 ED 79                        OUT  (C), A                            ; select register
 466+ C343 01 F7 BF                     LD   BC, #BFF7
 467+ C346 ED 78                        IN   A, (C)                            ; read BCD
 468+ C348 F5                           PUSH AF
 469+ C349 01 F7 EF                     LD   BC, #EFF7
 470+ C34C AF                           XOR  A
 471+ C34D ED 79                        OUT  (C), A                            ; deactivate
 472+ C34F F1                           POP  AF
 473+ C350 47                           LD   B, A
 474+ C351 E6 0F                        AND  $0F
 475+ C353 4F                           LD   C, A
 476+ C354 78                           LD   A, B
 477+ C355 E6 F0                        AND  $F0
 478+ C357 CB 3F                        SRL  A
 478+ C359 CB 3F          SRL A
 478+ C35B CB 3F          SRL A
 478+ C35D CB 3F          SRL A
 479+ C35F 47                           LD   B, A
 480+ C360 87                           ADD  A, A
 480+ C361 87             ADD A, A
 480+ C362 80             ADD A, B        ; *5
 481+ C363 87                           ADD  A, A                              ; *10
 482+ C364 81                           ADD  A, C
 483+ C365 C9                           RET
