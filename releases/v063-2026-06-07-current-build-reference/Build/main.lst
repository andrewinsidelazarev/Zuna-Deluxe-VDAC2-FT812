   6+ 3DAD 36 41       >                LD (HL), UI_OVL_PAGE & 0xFF
   6+ 3DAF             >                else
   6+ 3DAF ~           >                LD A, Page? & 0xFF
   6+ 3DAF ~           >                LD (MemoryPages + 3), A
   6+ 3DAF ~           >                LD BC, PAGE3
   6+ 3DAF ~           >                OUT (C), A
   6+ 3DAF             >                endif
