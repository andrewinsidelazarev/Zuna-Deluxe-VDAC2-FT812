 197+ D0BA
 198+ D0BA              ; ----------------------------------------------------------------------------
 199+ D0BA              ; Клавиатурное управление выбором уровня (схема юзера):
 200+ D0BA              ;   Вверх/Вниз  — сложность ПО ЭКРАНУ. Бейджи идут сверху вниз Sun God(3) / Jaguar(2)
 201+ D0BA              ;                 / Eagle(1) / Rabbit(0) (Y = 30 / 83 / 131 / 180), поэтому Вверх =
 202+ D0BA              ;                 к верхнему бейджу (CurrentDifficulty++, clamp 3 = Sun God), Вниз =
 203+ D0BA              ;                 к нижнему (CurrentDifficulty--, clamp 0 = Rabbit). Иначе стрелки
 204+ D0BA              ;                 двигали подсветку в противоположную сторону экрана.
 205+ D0BA              ;   Влево/Вправо — уровень (как кнопки Back/Next: ставит Click-флаги, дальше их
 206+ D0BA              ;                  обработает LevelSelectApplyLevelClick — там же guard L1 и wrap);
 207+ D0BA              ;   Огонь — Play;  ESC — выход в главное меню.
 208+ D0BA              ; Зовётся в LevelSelectUpdateControls ПОСЛЕ сброса Click-флагов и hit-test'ов мыши,
 209+ D0BA              ; но ДО Apply*-рутин — поэтому выставленные тут флаги и CurrentDifficulty доедут.
 210+ D0BA              ; ----------------------------------------------------------------------------
 211+ D0BA              LevelSelectKeyboard:
 212+ D0BA                              ; Вверх — к верхнему бейджу (Sun God): CurrentDifficulty++, clamp 3
 213+ D0BA CD 6D 7F                     CALL Input_Up
 214+ D0BD 21 C0 D9                     LD   HL, LevelSelectKbdUpPrev
 215+ D0C0 CD C1 7F                     CALL Input_EdgeZ
 216+ D0C3 28 0B                        JR   Z, .chk_down
 217+ D0C5 3A CC 6C                     LD   A, (CurrentDifficulty)
 218+ D0C8 FE 03                        CP   3
 219+ D0CA 30 04                        JR   NC, .chk_down                         ; уже Sun God (3, верх)
 220+ D0CC 3C                           INC  A
 221+ D0CD 32 CC 6C                     LD   (CurrentDifficulty), A
 222+ D0D0              .chk_down:      ; Вниз — к нижнему бейджу (Rabbit): CurrentDifficulty--, clamp 0
 223+ D0D0 CD 7C 7F                     CALL Input_Down
 224+ D0D3 21 C1 D9                     LD   HL, LevelSelectKbdDownPrev
 225+ D0D6 CD C1 7F                     CALL Input_EdgeZ
 226+ D0D9 28 0A                        JR   Z, .chk_left
 227+ D0DB 3A CC 6C                     LD   A, (CurrentDifficulty)
 228+ D0DE B7                           OR   A
 229+ D0DF 28 04                        JR   Z, .chk_left                          ; уже Rabbit (0, низ)
 230+ D0E1 3D                           DEC  A
 231+ D0E2 32 CC 6C                     LD   (CurrentDifficulty), A
 232+ D0E5              .chk_left:      ; Влево — предыдущий уровень (как Back)
 233+ D0E5 CD 8B 7F                     CALL Input_Left
 234+ D0E8 21 C2 D9                     LD   HL, LevelSelectKbdLeftPrev
 235+ D0EB CD C1 7F                     CALL Input_EdgeZ
 236+ D0EE 28 05                        JR   Z, .chk_right
