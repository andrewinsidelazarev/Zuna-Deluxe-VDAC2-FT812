1727+ FBA3 09                           ADD  HL, BC                             ; ×24
1728+ FBA4 11 8E F8                     LD   DE, ZL_ChainMatrixLUT
1729+ FBA7 19                           ADD  HL, DE
1730+ FBA8 ED 5B 35 14                  LD   DE, (FT.Coprocessor.BufferPtr)
1731+ FBAC 01 18 00                     LD   BC, ZL_CHAIN_MATRIX_LUT_STRIDE
1732+ FBAF ED B0                        LDIR
1733+ FBB1 ED 53 35 14                  LD   (FT.Coprocessor.BufferPtr), DE
1734+ FBB5 C9                           RET
