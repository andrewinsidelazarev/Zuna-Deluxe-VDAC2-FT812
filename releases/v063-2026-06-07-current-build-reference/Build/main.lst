 169+ E9A8              ; ZL_DrawFrame — собрать DL-команды текущего кадра
 170+ E9A8              ; ----------------------------------------------------------------------------
 171+ E9A8              ZL_BALL_DIAM_PX  EQU 32                               ; atlas cell size (BitmapLayout/Size)
 172+ E9A8              ZL_BALL_VISIBLE  EQU ZL_BALL_DIAM_PX                  ; visible diameter = atlas cell (без alpha-padding)
 173+ E9A8              ZL_BALL_W        EQU ZL_BALL_DIAM_PX                  ; native classic ball cell
 174+ E9A8              ZL_BALL_H        EQU ZL_BALL_DIAM_PX
 175+ E9A8              ZL_BALL_HALF     EQU ZL_BALL_DIAM_PX / 2              ; центр rect'а (= pivot для cmd_rotate)
 176+ E9A8              ; --- Spin physics: rolling-without-slip связь между движением t и phase atlas ---
 177+ E9A8              ; t — позиция шара на треке в track samples. Phase меняется ТОЛЬКО когда t движется
 178+ E9A8              ; → автоматически пропорционально скорости шаров (быстрее цепь → быстрее phase).
 179+ E9A8              ;
 180+ E9A8              ; Формула: spin_frame = ((t * K) >> 8) & (ATLAS_PHASES-1), где
 181+ E9A8              ;   K = 256 * ATLAS_PHASES / (π * D_samples)
 182+ E9A8              ; t измеряется в track samples. Физически точное rolling-without-slip для D=VDC_CELL_SIZE
 183+ E9A8              ; даёт K≈41, но при текущей скорости цепи это визуально слишком медленно для Zuma-feel.
 184+ E9A8              ; Поэтому используем визуальный период в 2 раза короче: D_samples = VDC_CELL_SIZE/2.
 185+ E9A8              ; Для CELL_SIZE=32, phases=16:
 186+ E9A8              ;   K = 256*16*113/(355*16) ≈ 81.49 → 81.
 187+ E9A8              ;
 188+ E9A8              ; K держится в RAM (ZL_SpinK) — runtime, можно менять per-level. Default = compile-time.
 189+ E9A8                              if BALLS_ARGB4_ENABLED
 190+ E9A8              ZL_ATLAS_PHASES            EQU 16
 191+ E9A8                              else
 192+ E9A8 ~            ZL_ATLAS_PHASES            EQU 32
