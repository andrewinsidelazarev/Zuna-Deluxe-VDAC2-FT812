 147+ 6CEF              ; ----------------------------------------------------------------------------
 148+ 6CEF              ; WIN-взрыв: «бегущая дорожка» взрывов ОТ головного шара (ближайшего к килл-зоне)
 149+ 6CEF              ; ДО килл-зоны (конца трека). Чем дальше голова была от КЗ — тем длиннее дорожка
 150+ 6CEF              ; (= больше бонус). Снимаем track-сэмпл ГОЛОВНОГО шара (макс. сэмпл = фронт цепи)
 151+ 6CEF              ; каждый PLAY-кадр, ДО очистки (keep-last-non-empty: храним последний кадр, где
 152+ 6CEF              ; шары были видимы). К WIN цепочка пуста, но трек ещё загружен → дорожку рисуем
 153+ 6CEF              ; по live-треку от сохранённого head-сэмпла. #FFFF = нет данных (не рисуем).
 154+ 6CEF              ; Резидент Core: пишется кодом VDC (slot1), читается WIN-рендером в оверлее #04.
 155+ 6CEF              ; ----------------------------------------------------------------------------
 156+ 6CEF FF FF        VDC_WinHeadS1:     DEFW #FFFF           ; chain1: сэмпл головного шара (фронт)
 157+ 6CF1 FF FF        VDC_WinHeadS2:     DEFW #FFFF           ; chain2 (дубль-уровни)
 158+ 6CF3 00 00        VDC_WinTmpMax:     DEFW 0               ; scratch: макс. сэмпл за проход цепочки
 159+ 6CF5 00           VDC_WinTmpFound:   DEFB 0               ; scratch: найден ли видимый шар
 160+ 6CF6
 161+ 6CF6              ; --- WIN-аутро «бикфорд» (точно по оригиналу Zuma Game_UpdateOutro/FX.c):
 162+ 6CF6              ; эмиттер бежит по треку head→килл-зона, роняя НЕЗАВИСИМЫЕ частицы-взрывы. ---
 163+ 6CF6              WIN_PRTCL_MAX      EQU 32
 164+ 6CF6              WINEXP_MOVE        EQU 12               ; сэмплов/кадр (скорость бегущей точки)
 165+ 6CF6              WINEXP_PAD         EQU 30               ; сэмплов между взрывами (+100 за каждый)
 166+ 6CF6              WINEXP_F2_MAX      EQU 32               ; f2 = 2×frame; >32 → частица мертва (frame 0..16)
 167+ 6CF6 00           VDC_WinOutroActive: DEFB 0              ; 1 = аутро запущено (есть head-данные)
 168+ 6CF7 FF FF        VDC_WinEmitPos1:   DEFW #FFFF           ; chain1 эмиттер: текущий сэмпл (#FFFF=дошёл)
 169+ 6CF9 00 00        VDC_WinEmitSpawn1: DEFW 0               ; сэмпл последнего спавна chain1
 170+ 6CFB FF FF        VDC_WinEmitPos2:   DEFW #FFFF           ; chain2
 171+ 6CFD 00 00        VDC_WinEmitSpawn2: DEFW 0
 172+ 6CFF 00 00 00...  VDC_WinPrtcl:      DEFS WIN_PRTCL_MAX * 5  ; на частицу: X(w),Y(w),f2(b); f2=255 мёртвая
 173+ 6D9F
 174+ 6D9F              ; Loader diagnostics — RESIDENT so an F12 dump (which captures slot 1 = Core, not
 175+ 6D9F              ; the loader overlay page) shows how far a load got. The overlay loader writes
 176+ 6D9F              ; them while slot 1 is mapped. Read these in a dump to bisect a failed load:
 177+ 6D9F              ;   ZiFi_GpDbgStep : 0=not started, 1=Init, 2=PakOpen, 3=PakReadToc,
 178+ 6D9F              ;                    #34=bg SD done, #35=track SD done, 6=success;
 179+ 6D9F              ;                    #FF=Init err, #FE=PakOpen err, #FD=PakReadToc err.
 180+ 6D9F              ;   ZiFi_DbgGamesA : RawPak_OpenRoot granular step —
 181+ 6D9F              ;                    #20 entry, #21 BPB read OK, #22 BPB valid, #26 search start,
 182+ 6D9F              ;                    #25 PAK found; #A1 BPB CMD17 err, #A2 bps!=512, #A3 spc=0,
 183+ 6D9F              ;                    #A6 PAK not found anywhere, #A7 run-table overflow.
 184+ 6D9F              ;   ZiFi_DbgGamesFound : directories visited during the recursive search.
 185+ 6D9F 00           ZiFi_GpDbgStep:     DEFB 0
