1601+ F815              ; ----------------------------------------------------------------------------
1602+ F815              ; ZL_SmoothMouse — exponential low-pass filter (alpha = 1/4, восстановлено
1603+ F815              ; 2026-05-17 после жалобы на «желейный» прицел):
1604+ F815              ;   new = old + (raw - old) / 4 = old*3/4 + raw/4
1605+ F815              ; Latency ~3-4 кадра (~70 ms @57Hz). 1-px jitter Hyper-V подавляется т.к.
1606+ F815              ; ±1/4 в integer = 0 → Smooth не дрожит при идле raw=±1 px.
1607+ F815              ; ----------------------------------------------------------------------------
1608+ F815              ZL_SmoothMouse: ; --- X axis ---
1609+ F815 2A 94 7E                     LD   HL, (ZL_SmoothX)                 ; HL = old
1610+ F818 54                           LD   D, H
1610+ F819 5D             LD E, L                   ; DE = old
1611+ F81A ED 4B 39 16                  LD   BC, (Input.Mouse.PositionX)
1612+ F81E A7                           AND  A
1613+ F81F ED 42                        SBC  HL, BC                           ; HL = old - raw (signed)
1614+ F821 CB 2C                        SRA  H
1614+ F823 CB 1D          RR L
1615+ F825 CB 2C                        SRA  H
1615+ F827 CB 1D          RR L                         ; HL = (old-raw)/4 signed
1616+ F829 EB                           EX   DE, HL                           ; HL = old, DE = (old-raw)/4
1617+ F82A A7                           AND  A
1618+ F82B ED 52                        SBC  HL, DE                           ; HL = old - (old-raw)/4 = new
1619+ F82D 22 94 7E                     LD   (ZL_SmoothX), HL
1620+ F830
1621+ F830                              ; --- Y axis ---
1622+ F830 2A 96 7E                     LD   HL, (ZL_SmoothY)
1623+ F833 54                           LD   D, H
1623+ F834 5D             LD E, L
1624+ F835 ED 4B 3B 16                  LD   BC, (Input.Mouse.PositionY)
1625+ F839 A7                           AND  A
1626+ F83A ED 42                        SBC  HL, BC
1627+ F83C CB 2C                        SRA  H
1627+ F83E CB 1D          RR L
1628+ F840 CB 2C                        SRA  H
1628+ F842 CB 1D          RR L
1629+ F844 EB                           EX   DE, HL
1630+ F845 A7                           AND  A
1631+ F846 ED 52                        SBC  HL, DE
1632+ F848 22 96 7E                     LD   (ZL_SmoothY), HL
1633+ F84B C9                           RET
