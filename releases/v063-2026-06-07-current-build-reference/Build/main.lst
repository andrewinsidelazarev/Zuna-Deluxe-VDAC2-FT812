  52+ C122                              ; --- 4. Переключить таймминги на 640×480 @ 74 Hz ---------
  53+ C122                              ; VM_640_480_74Hz: PCLK 32 МГц (F_MUL=4), H 24/40/128/640,
  54+ C122                              ;                  V 9/3/28/480 → HCYCLE 832, VCYCLE 520.
  55+ C122                              ; 832×520 = 432 640 pclk/frame vs 800×524=419 200 на 57Hz
  56+ C122                              ; (+3.2% bandwidth для bg-rendera, помогает с tearing на реале).
  57+ C122                              ; Макрос пишет HCYCLE, HOFFSET, HSYNC0/1, HSIZE, VCYCLE,
  58+ C122                              ; VOFFSET, VSYNC0/1, VSIZE и REG_PCLK = F_MUL.
  59+ C122                              FT_RESOLUTION VM_640_480_74Hz, ResolutionWidthPtr
  59+ C122             >                if     VM_640_480_74Hz == VM_640_480_57Hz
  59+ C122 ~           >                LD HL, 640
  59+ C122 ~           >                LD (ResolutionRef? + 0), HL
  59+ C122 ~           >                LD HL, 480
  59+ C122 ~           >                LD (ResolutionRef? + 2), HL
  59+ C122             >                elseif Resolution? == VM_640_480_74Hz
  59+ C122 21 80 02    >                LD HL, 640
  59+ C125 22 F3 40    >                LD (ResolutionWidthPtr + 0), HL
  59+ C128 21 E0 01    >                LD HL, 480
  59+ C12B 22 F5 40    >                LD (ResolutionWidthPtr + 2), HL
  59+ C12E             >                elseif Resolution? == VM_640_480_76Hz
  59+ C12E ~           >                LD HL, 640
  59+ C12E ~           >                LD (ResolutionRef? + 0), HL
  59+ C12E ~           >                LD HL, 480
  59+ C12E ~           >                LD (ResolutionRef? + 2), HL
  59+ C12E             >                elseif Resolution? == VM_800_600_60Hz
  59+ C12E ~           >                LD HL, 800
  59+ C12E ~           >                LD (ResolutionRef? + 0), HL
  59+ C12E ~           >                LD HL, 600
  59+ C12E ~           >                LD (ResolutionRef? + 2), HL
  59+ C12E             >                elseif Resolution? == VM_800_600_69Hz
  59+ C12E ~           >                LD HL, 800
  59+ C12E ~           >                LD (ResolutionRef? + 0), HL
  59+ C12E ~           >                LD HL, 600
  59+ C12E ~           >                LD (ResolutionRef? + 2), HL
  59+ C12E             >                elseif Resolution? == VM_800_600_85Hz
  59+ C12E ~           >                LD HL, 800
  59+ C12E ~           >                LD (ResolutionRef? + 0), HL
  59+ C12E ~           >                LD HL, 600
  59+ C12E ~           >                LD (ResolutionRef? + 2), HL
  59+ C12E             >                elseif Resolution? == VM_1024_768_59Hz
  59+ C12E ~           >                LD HL, 1024
  59+ C12E ~           >                LD (ResolutionRef? + 0), HL
  59+ C12E ~           >                LD HL, 768
  59+ C12E ~           >                LD (ResolutionRef? + 2), HL
  59+ C12E             >                elseif Resolution? == VM_1024_768_67Hz
  59+ C12E ~           >                LD HL, 1024
  59+ C12E ~           >                LD (ResolutionRef? + 0), HL
  59+ C12E ~           >                LD HL, 768
  59+ C12E ~           >                LD (ResolutionRef? + 2), HL
  59+ C12E             >                elseif Resolution? == VM_1024_768_76Hz
  59+ C12E ~           >                LD HL, 1024
  59+ C12E ~           >                LD (ResolutionRef? + 0), HL
  59+ C12E ~           >                LD HL, 768
  59+ C12E ~           >                LD (ResolutionRef? + 2), HL
  59+ C12E             >                endif
  59+ C12E 21 35 10    >                LD HL, VM_640_480_74Hz
