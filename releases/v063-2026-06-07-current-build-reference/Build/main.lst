 790  228D              ; ============================================================================
 791  228D              ; UpdateDialog — диалог game-over обработка click anywhere → restart.
 792  228D              ; Вызывается каждый кадр ДО Frog_Update (чтобы dialog click не триггерил bullet).
 793  228D              ; ============================================================================
 794  228D              UpdateDialog:
 795  228D 3A D6 6C                     LD   A, (Core.VDC_DialogState)
 796  2290 B7                           OR   A
 797  2291 C8                           RET  Z                                  ; диалог не показан
 798  2292 3E 01                        LD   A, 1
 799  2294 32 D9 6C                     LD   (Core.VDC_HudPointerBlock), A      ; dialog consumes LMB for this frame
 800  2297 3A D6 6C                     LD   A, (Core.VDC_DialogState)
 801  229A FE 03                        CP   3
 802  229C CA 2A 69                     JP   Z, Core.UpdatePauseDialog
 803  229F FE 04                        CP   4
 804  22A1 CA CD 69                     JP   Z, Core.UpdatePauseFade            ; pause window fade-out -> PLAY
 805  22A4 FE 06                        CP   Core.DLG_WIN_FADE
 806  22A6 CA 1C 23                     JP   Z, .udlg_win_fade                  ; LEVEL DONE → OK нажат → fade-out
 807  22A9
 808  22A9                              ; --- Клавиша огня (Space|Enter|Kempston) — минуя hit-test. ЛКМ ниже. ---
 809  22A9 CD A9 7F                     CALL Core.Input_FireKey
 810  22AC 20 06                        JR   NZ, .udlg_fire_check_edge         ; нажата
 811  22AE                              ; Огонь отпущен — сброс debounce
 812  22AE AF                           XOR  A
 813  22AF 32 34 23                     LD   (DialogFirePrev), A
 814  22B2 18 0E                        JR   .udlg_check_lmb
 815  22B4              .udlg_fire_check_edge:
 816  22B4 3A 34 23                     LD   A, (DialogFirePrev)
 817  22B7 B7                           OR   A
 818  22B8 20 08                        JR   NZ, .udlg_check_lmb               ; уже было pressed → no edge
 819  22BA 3E 01                        LD   A, 1
 820  22BC 32 34 23                     LD   (DialogFirePrev), A
 821  22BF C3 03 23                     JP   .udlg_action                       ; rising edge → trigger
 822  22C2
 823  22C2              .udlg_check_lmb:
 824  22C2                              ; --- Read mouse LMB state, detect falling edge (release = click) ---
 825  22C2 3E 01                        LD   A, Input.Mouse.SVK_LBUTTON
 826  22C4 CD 9E 15                     CALL Input.Mouse.KeyState               ; Z=released, NZ=pressed
 827  22C7 3E 00                        LD   A, 0
 828  22C9 28 01                        JR   Z, .udlg_lmb_set
 829  22CB 3C                           INC  A
 830  22CC 4F           .udlg_lmb_set:  LD   C, A                               ; C = current LMB (0/1)
 831  22CD 3A D7 6C                     LD   A, (Core.VDC_PrevMouseL)
 832  22D0 47                           LD   B, A                               ; B = previous LMB
 833  22D1 79                           LD   A, C
 834  22D2 32 D7 6C                     LD   (Core.VDC_PrevMouseL), A           ; save for next frame
 835  22D5                              ; Falling edge: was pressed (B=1) AND now released (C=0) → CLICK
 836  22D5 78                           LD   A, B
 837  22D6 B7                           OR   A
 838  22D7 C8                           RET  Z                                  ; не было pressed → нет клика
 839  22D8 79                           LD   A, C
 840  22D9 B7                           OR   A
 841  22DA C0                           RET  NZ                                 ; ещё pressed → нет клика
 842  22DB                              ; --- Hit-test: курсор должен быть в bounds OK button ---
 843  22DB 2A 39 16                     LD   HL, (Input.Mouse.PositionX)
 844  22DE 11 AA 00                     LD   DE, DLG_OK_X
 845  22E1 A7                           AND  A
 846  22E2 ED 52                        SBC  HL, DE
 847  22E4 D8                           RET  C
 848  22E5 2A 39 16                     LD   HL, (Input.Mouse.PositionX)
 849  22E8 11 D6 01                     LD   DE, DLG_OK_X + DIALOG_OK_W
 850  22EB A7                           AND  A
 851  22EC ED 52                        SBC  HL, DE
 852  22EE D0                           RET  NC
 853  22EF 2A 3B 16                     LD   HL, (Input.Mouse.PositionY)
 854  22F2 11 3B 01                     LD   DE, DLG_OK_Y
 855  22F5 A7                           AND  A
 856  22F6 ED 52                        SBC  HL, DE
 857  22F8 D8                           RET  C
 858  22F9 2A 3B 16                     LD   HL, (Input.Mouse.PositionY)
 859  22FC 11 5D 01                     LD   DE, DLG_OK_Y + DIALOG_OK_H
 860  22FF A7                           AND  A
 861  2300 ED 52                        SBC  HL, DE
 862  2302 D0                           RET  NC
 863  2303
 864  2303              .udlg_action:   ; Mouse click in OK bounds OR Fire key pressed
 865  2303 3A D6 6C                     LD   A, (Core.VDC_DialogState)
 866  2306 FE 05                        CP   Core.DLG_WIN_DONE
 867  2308 28 09                        JR   Z, .udlg_winnext                   ; LEVEL DONE → OK → начать fade
 868  230A FE 03                        CP   3
