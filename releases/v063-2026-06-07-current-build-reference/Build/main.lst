 798+ C551              ; ============================================================================
 799+ C551              ; VDC_SlotPos — для A=i возвращает центр шара (X,Y) из TrackData[t].
 800+ C551              ;   Out: BC = X (signed word), DE = Y (signed word), CF = 0 если рисуем,
 801+ C551              ;        CF = 1 если skip (gap или t<0).
 802+ C551              ;   AF, HL clobber.
 803+ C551              ;
 804+ C551              ; VDC_SlotPosAllowGap — тот же расчёт но БЕЗ gap-skip. Используется для
 805+ C551              ; gap-bonus tracking (нужна позиция самой gap-ячейки чтобы померить distance
 806+ C551              ; bullet'а до пустоты в цепи).
 807+ C551              ; ============================================================================
 808+ C551              VDC_SlotPos:
 809+ C551                              ; --- skip if gap ---
 810+ C551 4F                           LD   C, A
 811+ C552 26 00                        LD   H, 0
 811+ C554 6F             LD L, A
 812+ C555 ED 5B BE D9                  LD   DE, (VDC_pSlots)
 813+ C559 19                           ADD  HL, DE
 814+ C55A 7E                           LD   A, (HL)
 815+ C55B FE 06                        CP   VDC_NUM_COLORS
 816+ C55D 38 02                        JR   C, .not_gap
 817+ C55F 37                           SCF                                    ; CF=1, skip
 818+ C560 C9                           RET
 819+ C561              .not_gap:
 820+ C561 79                           LD   A, C
 821+ C562              VDC_SlotPosAllowGap:
 822+ C562                              ; entry без gap-skip. Caller обязан передать A=i.
 823+ C562 CD 21 C5                     CALL VDC_SlotT                         ; HL = t
 824+ C565                              ; t < 0 → skip
 825+ C565 CB 7C                        BIT  7, H
 826+ C567 28 02                        JR   Z, .t_nonneg
 827+ C569 37                           SCF
 828+ C56A C9                           RET
 829+ C56B              .t_nonneg:
 830+ C56B                              ; t >= NumSamples → clamp to NumSamples-1
 831+ C56B E5                           PUSH HL
 832+ C56C ED 5B 00 80                  LD   DE, (TrackData)                   ; NumSamples
 833+ C570 A7                           AND  A
 834+ C571 ED 52                        SBC  HL, DE
 835+ C573 E1                           POP  HL
 836+ C574 38 04                        JR   C, .t_in
 837+ C576 2A 00 80                     LD   HL, (TrackData)
 838+ C579 2B                           DEC  HL
 839+ C57A              .t_in:          ; HL = t (clamped). Read the sample via a Core-resident helper
 840+ C57A                              ; (2-page track split lives there) so this hot path stays tiny —
 841+ C57A                              ; Main1/slot3 is nearly full. Core is always mapped in slot 1, so
 842+ C57A                              ; the tail-call resolves at runtime. Helper: out BC=X, DE=Y, CF=0,
 843+ C57A                              ; sets VDC_LastT / VDC_LastTangent.
 844+ C57A C3 70 6C                     JP   VDC_ReadSampleAtHL
