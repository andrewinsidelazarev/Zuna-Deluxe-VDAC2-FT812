  99+ 6CD0              ; --- Hoisted gameplay/UI state (originally in VDC.asm / Frog.asm) -----------
 100+ 6CD0              ; Moved to resident Core so the resident transition + HUD/dialog/absorb/win
 101+ 6CD0              ; logic in main.asm reaches them while slot 3 holds a DIFFERENT scene overlay
 102+ 6CD0              ; (UI page vs gameplay page) — and so FadeLevelSelectToGameplay can reset the
 103+ 6CD0              ; score BEFORE the gameplay page is mapped. Names unchanged (module Core) → all
 104+ 6CD0              ; existing references (qualified Core.X and in-module X) resolve untouched.
 105+ 6CD0              ; VDC_Init still initialises these by name. See typed-launching-sunset plan.
 106+ 6CD0 00           VDC_GameState:       DEFB 0   ; 0=play,1=absorb,2=gameover,3=intro,4=preview,5=closing
 107+ 6CD1 00           VDC_HSub:            DEFB 0   ; head sub-position (absorb physics, resident UpdateAbsorbState)
 108+ 6CD2 00           VDC_SlotsLen:        DEFB 0   ; chain length (win/absorb logic in resident)
 109+ 6CD3 00           VDC_KzFrame:         DEFB 0   ; skull-mouth frame (DrawKillzone resident)
 110+ 6CD4 FF           VDC_HeadAbsorbAlpha: DEFB 255 ; head-ball fade alpha during state=1 absorb
 111+ 6CD5 03           VDC_Lives:           DEFB 3   ; lives (start 3, +1/50k, carried across levels)
 112+ 6CD6 00           VDC_DialogState:     DEFB 0   ; 0=NONE,1=RETRY,2=GAMEOVER,3=pause,4=pause-fade,5=WIN_DONE,6=WIN_FADE
 113+ 6CD7 00           VDC_PrevMouseL:      DEFB 0   ; previous LMB state for dialog edge detection
 114+ 6CD8 00           VDC_HudMenuState:    DEFB 0   ; 0=inactive,1=hover,2=pressed (HUD MENU button)
 115+ 6CD9 00           VDC_HudPointerBlock: DEFB 0   ; pointer over HUD button: suppress frog fire edge
 116+ 6CDA 00 00        VDC_GaugeScore:      DEFW 0   ; Zuma bar score this level (win condition in resident)
 117+ 6CDC 00           VDC_GaugeFull:       DEFB 0   ; 0=yellow filling, 1=green full
 118+ 6CDD              ; 24-bit cumulative adventure score (3-byte little-endian, max 16,777,215). Was
 119+ 6CDD              ; DEFW (16-bit) which overflowed past 65535 — but adventure totals reach hundreds
 120+ 6CDD              ; of thousands and the +1-life-per-50000 mechanic needs cumulative beyond 16 bits.
 121+ 6CDD              ; NextLifeScore is the next 50000 threshold; Score_Add24 grants a life and advances
 122+ 6CDD              ; it by 50000 each time the score crosses it. Both reset by Score_Reset.
 123+ 6CDD 00 00 00     VDC_PlayerScore:     DB 0,0,0 ; cumulative adventure score (HUD draw + bonus in resident)
 124+ 6CE0 50 C3 00     NextLifeScore:       DB #50,#C3,#00 ; next extra-life threshold = 50000 (0x00C350 LE)
 125+ 6CE3 00 00        VDC_GameSeconds:     DEFW 0   ; elapsed gameplay seconds (HUD clock in resident)
 126+ 6CE5 00           Frog_BallColor:      DEFB 0   ; current loaded ball color (refiltered on level change, resident)
 127+ 6CE6 00           Frog_NextBallColor:  DEFB 0   ; next ball color
 128+ 6CE7              ; VDC invariant diagnostics for F12 dumps. First failure is latched until VDC_Init:
 129+ 6CE7              ;   code 1: SlotsLen > VDC_MAX_SLOTS
 130+ 6CE7              ;   code 2: HSA > TrackNumSlots
 131+ 6CE7              ;   code 3: Slots[i] is neither color nor GAP marker
 132+ 6CE7              ;   code 4: Offsets[i] outside [-CELL_SIZE..CELL_SIZE]
 133+ 6CE7              ;   code 5: ExplodeFrame[i] has invalid ExplodeMarker
 134+ 6CE7              ;   code 6: Shot2[i] is not 0/1
 135+ 6CE7 00           VDC_AssertCode:      DEFB 0
 136+ 6CE8 00           VDC_AssertCtx:       DEFB 0
 137+ 6CE9 00           VDC_AssertLen:       DEFB 0
 138+ 6CEA 00           VDC_AssertHSA:       DEFB 0
 139+ 6CEB 00           VDC_AssertValue:     DEFB 0
 140+ 6CEC 00 00        VDC_AssertFrame:     DEFW 0
