; Неизменяемые адреса входов Z80: каждая позиция содержит JP на обработчик.
; Позиции 0..30 сохраняют порядок операций CORE32; позиции 48..77 отведены
; файловым операциям с соответствующими номерами API плагинов WC.
FAT32_API_VERSION       EQU 1
FAT32_BASE              EQU #4000
FAT32_COMMAND_COUNT     EQU 128
FAT32_BIND              EQU FAT32_BASE+0*3
FAT32_DEVICE_INIT       EQU FAT32_BASE+1*3
FAT32_INFO              EQU FAT32_BASE+2*3
FAT32_MOUNT             EQU FAT32_BASE+3*3
FAT32_READ_SECTORS      EQU FAT32_BASE+4*3
FAT32_WRITE_SECTORS     EQU FAT32_BASE+5*3
FAT32_SEEK_CLUSTER      EQU FAT32_BASE+6*3
FAT32_SET_DIR_CLUSTER   EQU FAT32_BASE+10*3
FAT32_GET_DIR_CLUSTER   EQU FAT32_BASE+11*3
FAT32_FIND_FREE_CLUSTER EQU FAT32_BASE+12*3
FAT32_ALLOC_CHAIN       EQU FAT32_BASE+14*3
FAT32_REFRESH_FREE      EQU FAT32_BASE+16*3
FAT32_GET_ENTRY         EQU FAT32_BASE+17*3
FAT32_CAPTURE_ENTRY     EQU FAT32_BASE+18*3
FAT32_FREE_CHAIN        EQU FAT32_BASE+23*3
FAT32_CLUSTER_TO_SECTOR EQU FAT32_BASE+24*3
FAT32_READ_VIDEO        EQU FAT32_BASE+27*3
FAT32_SKIP_SECTORS      EQU FAT32_BASE+28*3
FAT32_NEXT_ENTRY        EQU FAT32_BASE+29*3
FAT32_NEXT_NAME         EQU FAT32_BASE+30*3
FAT32_SET_DIR          EQU FAT32_BASE+31*3
FAT32_SET_ROOT         EQU FAT32_BASE+32*3
FAT32_SEEK_START       EQU FAT32_BASE+33*3
FAT32_SYNC             EQU FAT32_BASE+34*3
FAT32_CLOSE            EQU FAT32_BASE+35*3
FAT32_MOUNT_AT         EQU FAT32_BASE+36*3
FAT32_READ             EQU FAT32_BASE+48*3
FAT32_WRITE            EQU FAT32_BASE+49*3
FAT32_FIND             EQU FAT32_BASE+59*3
FAT32_OPEN             EQU FAT32_BASE+62*3
FAT32_CREATE           EQU FAT32_BASE+72*3
FAT32_MKDIR            EQU FAT32_BASE+73*3
FAT32_RENAME           EQU FAT32_BASE+74*3
FAT32_DELETE           EQU FAT32_BASE+75*3
FAT32_APPEND           EQU FAT32_BASE+76*3
FAT32_FILEX            EQU FAT32_BASE+77*3
FAT32_RESERVED_FIRST    EQU 78
FAT32_UNSUPPORTED       EQU #FE
FAT32_NOT_MOUNTED       EQU #F0
FAT32_NO_FILE           EQU #F1
FAT32_BAD_BUFFER        EQU #F2
FAT32_BAD_ARGUMENT      EQU #F3
